# Standard library: counting
#
# How many elements a set has, factorials, and binomial coefficients.
#
# One record per item. A record begins at column 0 with its kind and name; a
# proof cites it as def:stdlib/counting/<name> or thm:stdlib/counting/<name>,
# and the prefix must match the kind. Format is described in DATABASE.md.
#
# An item's statement is written in the theorem form of SYNTAX.md: let and
# assume lines with labels, then a `then` line.
#
# Every item carries at least one of:
#   metamath    a set.mm label or labels supply it
#   open        it is cited but unproved and unbridged
#
# Other fields: target, first-used, note.


definition factorial
  then        1! = 1
  let n ∈ ℕ                                                           (H1)
  then        (n + 1)! = n!·(n + 1)
  metamath    fac1, facp1
  first-used  infinitely-many-primes
  note        Two `then` groups, as def:stdlib/sums/S.

theorem factorial-nat
  let n ∈ ℕ                                                           (H1)
  then        n! ∈ ℕ
  metamath    faccl, which states it on ℕ0
  target      faccl
  first-used  infinitely-many-primes

theorem factorial-divisible
  let n ∈ ℕ                                                           (H1)
  let m ∈ ℕ                                                           (H2)
  assume m ≤ n                                                        (H3)
  then        m divides n!
  metamath    dvdsfac, which asks m ≤ n as membership of ℤ≥m
  target      dvdsfac
  first-used  infinitely-many-primes

definition card
  let A be a set                                                      (H1)
  let n ∈ ℕ₀                                                          (H2)
  then        |A| = n ↔ there is a bijection from {i ∈ ℕ : i ≤ n} to A
  metamath    hashen, hashfz1
  first-used  subsets

theorem card-zero
  let X be a set                                                      (H1)
  assume |X| = 0                                                      (H2)
  then        X = ∅
  metamath    hasheq0
  target      hasheq0
  first-used  subsets

theorem card-singleton
  let x be an element                                                 (H1)
  then        |{x}| = 1
  metamath    hashsng
  target      hashsng
  first-used  subsets
  note        A singleton has one element only when there is an element for it
              to have: `{ x }` for a proper class x is empty, and `hashsng`
              asks for the set because of it.

theorem card-nonempty
  let X be a set                                                      (H1)
  let k ∈ ℕ₀                                                          (H2)
  assume |X| = k + 1                                                  (H3)
  then        there is a ∈ X
  metamath    hashgt0elex
  target      hashgt0elex with V := X
  first-used  subsets
  note        `hashgt0elex` asks that the size be positive where the
              hypothesis says what the size is, so the size is read as
              k + 1 through that hypothesis before `nn0p1gt0` answers.

theorem card-remove
  let X be a set                                                      (H1)
  let a ∈ X                                                           (H2)
  let k ∈ ℕ₀                                                          (H3)
  assume |X| = k + 1                                                  (H4)
  then        |X ∖ {a}| = k
  metamath    hashdifsnp1
  target      hashdifsnp1 with V := X, N := a, Y := k
  first-used  subsets
  note        `hashdifsnp1` states this item whole, hypotheses included:
              the size is given as k + 1, so nothing asks that X be finite.

theorem card-bijection
  let X be a set                                                      (H1)
  let Y be a set                                                      (H2)
  let m ∈ ℕ₀                                                          (H3)
  assume |X| = m                                                      (H4)
  assume there is a bijection from X to Y                             (H5)
  then        |Y| = m
  metamath    hashen
  target      hashen with A := X, B := Y
  first-used  subsets

theorem card-disjoint-union
  let X be a set                                                      (H1)
  let Y be a set                                                      (H2)
  let m ∈ ℕ₀                                                          (H3)
  let n ∈ ℕ₀                                                          (H4)
  assume |X| = m                                                      (H5)
  assume |Y| = n                                                      (H6)
  assume X ∩ Y = ∅                                                    (H7)
  then        |X ∪ Y| = m + n
  metamath    hashun
  target      hashun with A := X, B := Y
  first-used  subsets

definition binomial-coefficient
  let n ∈ ℕ₀                                                          (H1)
  let k ∈ {0, …, n}                                                   (H2)
  then        C(n, k) = n!/((n − k)!·k!)
  metamath    bcval2
  target      bcval2
  first-used  binomial
  note        set.mm defines C(n, k) for every integer k, as 0 outside
              0 … n, and the formula is its value inside. The binomial proof
              does not unfold this: it rests on Pascal's rule and on the
              values at the edges, which are set.mm theorems proved from it.

theorem pascal
  let n ∈ ℕ₀                                                          (H1)
  let k ∈ ℤ                                                           (H2)
  then        C(n, k) + C(n, k − 1) = C(n + 1, k)
  metamath    bcpasc
  target      bcpasc
  first-used  binomial
  note        Holds for every integer k, the ends included, because C(n, k)
              is 0 outside 0 … n.

theorem binomial-zero-index
  let n ∈ ℕ₀                                                          (H1)
  then        C(n, 0) = 1
  metamath    bcn0
  target      bcn0
  first-used  binomial

theorem binomial-above
  let n ∈ ℕ₀                                                          (H1)
  let k ∈ ℤ                                                           (H2)
  assume n < k                                                        (H3)
  then        C(n, k) = 0
  metamath    bcval4
  target      bcval4
  first-used  binomial
  note        set.mm states the two ways a coefficient is zero as one
              disjunction, k < 0 or n < k. This is the second of them, and the
              disjunction is apparatus `olc` supplies from it.

theorem binomial-below
  let n ∈ ℕ₀                                                          (H1)
  then        C(n, −1) = 0
  metamath    bcneg1
  target      bcneg1
  first-used  binomial

theorem binomial-nat0
  let n ∈ ℕ₀                                                          (H1)
  let k ∈ ℤ                                                           (H2)
  then        C(n, k) ∈ ℕ₀
  metamath    bccl
  target      bccl
  first-used  binomial
