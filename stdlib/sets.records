# Standard library: sets
#
# Subsets, sets built from a property, unions, differences and the power set.
#
# One record per item. A record begins at column 0 with its kind and name; a
# proof cites it as def:stdlib/sets/<name> or thm:stdlib/sets/<name>, and the
# prefix must match the kind. Format is described in DATABASE.md.
#
# An item's statement is written in the theorem form of SYNTAX.md: let and
# assume lines with labels, then a `then` line.
#
# Every item carries at least one of:
#   metamath    a set.mm label or labels supply it
#   open        it is cited but unproved and unbridged
#
# Other fields: target, first-used, note.


definition subset
  then        X ⊆ Y ↔ for every t ∈ X, t ∈ Y
  metamath    df-ss, ssel
  target      dfss3
  first-used  bezout

definition set-builder
  let X be a set                                                      (H1)
  let P be a property of the elements of X                            (H2)
  then        u ∈ {t ∈ X : P(t)} ↔ u ∈ X and P(u)
  metamath    rabid, elrab
  target      rabid, elrab
  first-used  bezout
  note        P(t) says the property holds of t. The line above says what P is
              a property of and never mentions t, because the braces are what
              introduce t: it does not exist until they open. See the
              `holds-of` notation for why this is not a function applied to an
              argument.

              The element is u and the braces bind t, as def:stdlib/functions/set-image writes
              them. Both were t until the conclusion check went in, and a
              statement that uses one letter for a free name and for the name
              the braces bind cannot be matched against a use of it: the free
              one binds to the element and the bound one then has to be the
              element too.

theorem set-builder-subset
  let X be a set                                                      (H1)
  let P be a property of the elements of X                            (H2)
  then        {t ∈ X : P(t)} ⊆ X
  metamath    ssrab2
  target      ssrab2
  first-used  bezout

theorem subset-transitive
  assume X ⊆ Y                                                        (H1)
  assume Y ⊆ Z                                                        (H2)
  then        X ⊆ Z
  metamath    sstr
  target      sstr
  first-used  intermediate-value

definition powerset
  let A be a set                                                      (H1)
  then        S ∈ 𝒫A ↔ S ⊆ A
  metamath    elpw, elpwg
  target      elpwg
  first-used  cantor

theorem powerset-empty
  then        𝒫∅ = {∅}
  metamath    pw0
  target      pw0
  first-used  subsets

theorem difference-set
  let X be a set                                                      (H1)
  let a be an element                                                 (H2)
  then        X ∖ {a} is a set
  metamath    difexg
  target      difexg
  first-used  subsets

theorem subset-of-difference
  let a be an element                                                 (H1)
  assume Y ⊆ X ∖ {a}                                                  (H2)
  then        a ∉ Y
  metamath    ssdifsn
  target      ssdifsn
  first-used  subsets
  note        The half of `ssdifsn` the corpus wants. Being inside X ∖ {a}
              says two things at once, and this is the second of them.

theorem difference-of-union
  let a be an element                                                 (H1)
  then        (Y ∪ {a}) ∖ {a} = Y ∖ {a}
  metamath    difun2
  target      difun2
  first-used  subsets

theorem difference-absent
  let a ∉ Y                                                           (H1)
  then        Y ∖ {a} = Y
  metamath    difsn
  target      difsn
  first-used  subsets

theorem not-in-subset
  let a ∉ Z                                                           (H1)
  assume Y ⊆ Z                                                        (H2)
  then        a ∉ Y
  metamath    ssneld
  target      ssneld
  first-used  subsets

theorem in-union-singleton
  let a be an element                                                 (H1)
  then        a ∈ Y ∪ {a}
  metamath    elun2, over the singleton snidg puts a in
  target      elun2
  first-used  subsets

theorem disjoint-empty
  assume for every s ∈ Z, s ∉ Y                                       (H1)
  then        Y ∩ Z = ∅
  metamath    disjr
  target      disjr
  first-used  subsets
  note        Two sets are disjoint when nothing in one is in the other, which
              is what a reader proves. set.mm says it twice, over the first set
              in `disj` and over the second in `disjr`, and the second is the
              one the subsets proof has: what it can run over is the part it
              built, not the part it split off.

theorem not-in-difference
  let X be a set                                                      (H1)
  let a be an element                                                 (H2)
  then        a ∉ X ∖ {a}
  metamath    neldifsn
  target      neldifsn
  first-used  subsets
  note        Added because thm:proof/subsets/add-element-bijection assumes the element it
              adds is not already there, and the subsets proof adds it back to
              X ∖ {a} without ever saying so.

theorem subset-antisymmetric
  assume X ⊆ Y                                                        (H1)
  assume Y ⊆ X                                                        (H2)
  then        X = Y
  metamath    eqss
  target      eqss
  first-used  subsets

theorem union-subset
  assume X ⊆ Z                                                        (H1)
  assume Y ⊆ Z                                                        (H2)
  then        X ∪ Y ⊆ Z
  metamath    unss
  target      unss
  first-used  subsets

theorem in-union-left
  assume u ∈ Y                                                        (H1)
  then        u ∈ Y ∪ Z
  metamath    elun1
  target      elun1
  first-used  subsets

theorem in-union-right
  assume u ∈ Z                                                        (H1)
  then        u ∈ Y ∪ Z
  metamath    elun2
  target      elun2
  first-used  subsets

theorem difference-subset
  then        X ∖ Y ⊆ X
  metamath    difss
  target      difss
  first-used  subsets

theorem difference-shrinks
  assume Y ⊆ X                                                        (H1)
  then        Y ∖ Z ⊆ X ∖ Z
  metamath    ssdif
  target      ssdif
  first-used  subsets

theorem subset-into-difference
  let a be an element                                                 (H1)
  assume Y ⊆ X                                                        (H2)
  assume a ∉ Y                                                        (H3)
  then        Y ⊆ X ∖ {a}
  metamath    ssdifsn
  target      ssdifsn
  first-used  subsets
  note        The other half of `ssdifsn` from `thm:stdlib/sets/subset-of-difference`:
              inside X and without a is inside X ∖ {a}.

theorem remove-and-restore
  let a ∈ Y                                                           (H1)
  then        (Y ∖ {a}) ∪ {a} = Y
  metamath    difsnid
  target      difsnid
  first-used  subsets

theorem singleton-subset
  let a ∈ X                                                           (H1)
  then        {a} ⊆ X
  metamath    snssi
  target      snssi
  first-used  subsets

theorem powerset-monotone
  assume Y ⊆ X                                                        (H1)
  then        𝒫Y ⊆ 𝒫X
  metamath    sspw
  target      sspw
  first-used  subsets

theorem intersection-member
  then        u ∈ Y ∩ Z ↔ u ∈ Y and u ∈ Z
  metamath    elin
  target      elin

theorem union-member
  then        u ∈ Y ∪ Z ↔ u ∈ Y or u ∈ Z
  metamath    elun
  target      elun

theorem intersection-commutes
  then        Y ∩ Z = Z ∩ Y
  metamath    incom
  target      incom

theorem union-commutes
  then        Y ∪ Z = Z ∪ Y
  metamath    uncom
  target      uncom

theorem intersection-self
  then        Y ∩ Y = Y
  metamath    inidm
  target      inidm

theorem union-self
  then        Y ∪ Y = Y
  metamath    unidm
  target      unidm

theorem union-empty
  then        Y ∪ ∅ = Y
  metamath    un0
  target      un0

theorem intersection-empty
  then        Y ∩ ∅ = ∅
  metamath    in0
  target      in0

theorem difference-self
  then        Y ∖ Y = ∅
  metamath    difid
  target      difid

theorem difference-empty
  then        Y ∖ ∅ = Y
  metamath    dif0
  target      dif0

theorem intersection-distributes
  then        X ∩ (Y ∪ Z) = (X ∩ Y) ∪ (X ∩ Z)
  metamath    indi
  target      indi

theorem subset-empty
  then        Y ⊆ ∅ ↔ Y = ∅
  metamath    ss0b
  target      ss0b
