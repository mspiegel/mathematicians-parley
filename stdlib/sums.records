# Standard library: sums
#
# Sums over a range of whole numbers, Σ(k = a to b), and the ranges
# {a, …, b} they run over.
#
# One record per item. A record begins at column 0 with its kind and name; a
# proof cites it as def:stdlib/sums/<name> or thm:stdlib/sums/<name>, and the
# prefix must match the kind. Format is described in DATABASE.md.
#
# An item's statement is written in the theorem form of SYNTAX.md: let and
# assume lines with labels, then a `then` line.
#
# Every item carries at least one of:
#   metamath    a set.mm label or labels supply it
#   open        it is cited but unproved and unbridged
#
# Other fields: target, first-used, note.


theorem sum-divisible
  let n ∈ ℕ₀                                                          (H1)
  let m ∈ ℤ                                                           (H2)
  let t : ℕ₀ → ℤ                                                      (H3)
  assume for every k ∈ ℕ₀, m divides t(k)                             (H4)
  then        m divides Σ(k = 0 to n) t(k)
  metamath    fsumdvds
  target      fsumdvds
  first-used  divisibility-by-three
  note        A number dividing every term divides the sum. set.mm asks it
              only of the terms the sum takes, k from 0 to n; asked of every
              k ∈ ℕ₀ it asks more, which is what a proof that fixes an
              arbitrary k has.

theorem sum-integer
  let n ∈ ℕ₀                                                          (H1)
  let t : ℕ₀ → ℤ                                                      (H2)
  then        Σ(k = 0 to n) t(k) ∈ ℤ
  metamath    fsumzcl
  target      fsumzcl
  first-used  divisibility-by-three

theorem sum-difference
  let n ∈ ℕ₀                                                          (H1)
  let t : ℕ₀ → ℤ                                                      (H2)
  let u : ℕ₀ → ℤ                                                      (H3)
  then        Σ(k = 0 to n) (t(k) − u(k)) = Σ(k = 0 to n) t(k) − Σ(k = 0 to n) u(k)
  metamath    fsumsub
  target      fsumsub
  first-used  divisibility-by-three

theorem sum-single
  let a ∈ ℤ                                                           (H1)
  let t : {a, …, a} → ℝ                                               (H2)
  then        Σ(k = a to a) t(k) = t(a)
  metamath    fsum1
  target      fsum1
  first-used  binomial

theorem sum-last
  let n ∈ ℕ₀                                                          (H1)
  let t : {0, …, n + 1} → ℝ                                           (H2)
  then        Σ(k = 0 to n + 1) t(k) = Σ(k = 0 to n) t(k) + t(n + 1)
  metamath    fsump1
  target      fsump1
  first-used  binomial

theorem sum-extended
  let a ∈ ℤ                                                           (H1)
  let n ∈ ℤ                                                           (H2)
  assume n ≥ a                                                        (H3)
  let t : {a, …, n + 1} → ℝ                                           (H4)
  then        Σ(k = a to n + 1) t(k) = Σ(k = a to n) t(k) + t(n + 1)
  metamath    fsump1
  target      fsump1
  first-used  sum-formula
  note        `sum-last` from a start of the proof's own choosing: the sum
              formula counts from 1, where `sum-last` counts from 0.

theorem sum-telescopes
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  assume b + 1 ≥ a                                                    (H3)
  let t : {a, …, b + 1} → ℝ                                           (H4)
  then        Σ(k = a to b) (t(k) − t(k + 1)) = t(a) − t(b + 1)
  metamath    telfsum
  target      telfsum
  first-used  triangular-reciprocals
  note        A telescoping sum: each term's second half cancels the next
              term's first, and what is left is the first and the last.

theorem sum-first
  let n ∈ ℕ₀                                                          (H1)
  let t : {0, …, n} → ℝ                                               (H2)
  then        Σ(k = 0 to n) t(k) = t(0) + Σ(k = 0 + 1 to n) t(k)
  metamath    fsum1p
  target      fsum1p
  first-used  binomial
  note        The rest of the sum starts at 0 + 1, as set.mm writes it; a
              proof that wants 1 there substitutes.

theorem sum-shift
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  let c ∈ ℤ                                                           (H3)
  let t : {a, …, b} → ℝ                                               (H4)
  then        Σ(k = a to b) t(k) = Σ(k = a + c to b + c) t(k − c)
  metamath    fsumshft
  target      fsumshft
  first-used  binomial
  note        The same terms counted from a different start: the term the
              left side takes at k, the right side takes at k + c.

theorem sum-scaled
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  let c ∈ ℝ                                                           (H3)
  let t : {a, …, b} → ℝ                                               (H4)
  then        c·(Σ(k = a to b) t(k)) = Σ(k = a to b) c·t(k)
  metamath    fsummulc2
  target      fsummulc2
  first-used  binomial

theorem sum-add
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  let t : {a, …, b} → ℝ                                               (H3)
  let u : {a, …, b} → ℝ                                               (H4)
  then        Σ(k = a to b) (t(k) + u(k)) = Σ(k = a to b) t(k) + Σ(k = a to b) u(k)
  metamath    fsumadd
  target      fsumadd
  first-used  binomial

theorem sum-termwise
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  let t : {a, …, b} → ℝ                                               (H3)
  let u : {a, …, b} → ℝ                                               (H4)
  assume for every k ∈ {a, …, b}, t(k) = u(k)                          (H5)
  then        Σ(k = a to b) t(k) = Σ(k = a to b) u(k)
  metamath    sumeq2dv
  target      sumeq2dv
  first-used  binomial
  note        Two sums over one range are equal when their terms are, index
              by index. The terms need agree only where the sum takes them,
              which is what lets a term be rewritten by a fact that holds on
              the range and nowhere else.

theorem sum-real
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  let t : {a, …, b} → ℝ                                               (H3)
  then        Σ(k = a to b) t(k) ∈ ℝ
  metamath    fsumrecl
  target      fsumrecl
  first-used  binomial

theorem range-difference
  let a ∈ ℤ                                                           (H1)
  let n ∈ ℤ                                                           (H2)
  let k ∈ {a, …, n}                                                   (H3)
  then        n − k ∈ ℕ₀
  metamath    fznn0sub
  target      fznn0sub
  first-used  binomial
  note        An index no greater than n leaves a whole number when taken
              from n, which is what lets x^(n − k) be a power with a natural
              exponent.

theorem range-integer
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  let k ∈ {a, …, b}                                                   (H3)
  then        k ∈ ℤ
  metamath    elfzelz
  target      elfzelz
  first-used  binomial

theorem range-nat0
  let n ∈ ℤ                                                           (H1)
  let k ∈ {0, …, n}                                                   (H2)
  then        k ∈ ℕ₀
  metamath    elfznn0
  target      elfznn0
  first-used  binomial

theorem range-nat
  let n ∈ ℤ                                                           (H1)
  let k ∈ {1, …, n}                                                   (H2)
  then        k ∈ ℕ
  metamath    elfznn
  target      elfznn
  note        No proof cites it: a line saying k ∈ {1, …, n} says k ∈ ℕ as
              well, and a line said of every k ∈ ℕ answers a hypothesis over
              the range (`SYNTAX.md`), both by this lemma.

theorem range-member
  let n ∈ ℤ                                                           (H1)
  then        k ∈ {1, …, n} ↔ k ∈ ℕ and k ≤ n
  metamath    fznn
  target      fznn

theorem range0-member
  let n ∈ ℕ₀                                                          (H1)
  then        k ∈ {0, …, n} ↔ k ∈ ℕ₀ and k ≤ n
  metamath    fznn0
  target      fznn0

theorem range-single
  let m ∈ ℤ                                                           (H1)
  then        {m, …, m} = {m}
  metamath    fzsn
  target      fzsn

theorem range-empty
  then        {1, …, 0} = ∅
  metamath    fz10
  target      fz10

theorem range-split
  let k ∈ {m, …, n}                                                   (H1)
  then        {m, …, n} = {m, …, k} ∪ {k + 1, …, n}
  metamath    fzsplit
  target      fzsplit
