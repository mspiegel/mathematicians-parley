# Standard library: sums
#
# Sums over a range of whole numbers, Σ(k = a to b), and the ranges
# {a, …, b} they run over.
#
# One record per item. A record begins at column 0 with its kind and name; a
# proof cites it as def:stdlib/sums/<name> or thm:stdlib/sums/<name>, and the
# prefix must match the kind. Format is described in DATABASE.md.
#
# An item's statement is written in the theorem form of SYNTAX.md: let and
# assume lines with labels, then a `then` line.
#
# Every item carries at least one of:
#   metamath    a set.mm label or labels supply it
#   open        it is cited but unproved and unbridged
#
# Other fields: target, first-used, note.


definition S
  then        S(1) = 1
  let n ∈ ℕ                                                           (H1)
  then        S(n + 1) = S(n) + (n + 1)
  metamath    fsum1, fsump1
  target      fsum1, fsump1
  first-used  sum-formula
  note        Local to the sum-formula pilot. Two `then` groups: the base
              sentence has no hypothesis and the step sentence has H1. See
              DATABASE.md on recursive definitions.

definition G
  let a ∈ ℝ                                                           (H1)
  then        G(0) = 1
  let n ∈ ℕ₀                                                          (H2)
  then        G(n + 1) = G(n) + a^(n + 1)
  metamath    Σ over 0...n with fsum1 and fsump1
  target      fsum1, fsump1
  first-used  geometric-series
  note        Local to the geometric-series pilot. Two `then` groups, as def:stdlib/sums/S.
              The same two lemmas as def:stdlib/sums/S, reached differently. fsum1 says a
              one-term sum is its summand read at the limit, which for def:stdlib/sums/S
              is 1 outright and here is a^0; the elaborator proves it at that
              value and exp0 carries it to the 1 this definition writes,
              in the theorem's scope where a is known to be real. Naming 1
              to fsum1 instead cannot work: that hypothesis has no
              antecedent, so nothing about a is available inside it.

theorem sum-divisible
  let n ∈ ℕ₀                                                          (H1)
  let m ∈ ℤ                                                           (H2)
  let t : ℕ₀ → ℤ                                                      (H3)
  assume for every k ∈ ℕ₀, m divides t(k)                             (H4)
  then        m divides Σ(k = 0 to n) t(k)
  metamath    fsumdvds
  target      fsumdvds
  first-used  divisibility-by-three
  note        A number dividing every term divides the sum. set.mm asks it
              only of the terms the sum takes, k from 0 to n; asked of every
              k ∈ ℕ₀ it asks more, which is what a proof that fixes an
              arbitrary k has.

theorem sum-integer
  let n ∈ ℕ₀                                                          (H1)
  let t : ℕ₀ → ℤ                                                      (H2)
  then        Σ(k = 0 to n) t(k) ∈ ℤ
  metamath    fsumzcl
  target      fsumzcl
  first-used  divisibility-by-three

theorem sum-difference
  let n ∈ ℕ₀                                                          (H1)
  let t : ℕ₀ → ℤ                                                      (H2)
  let u : ℕ₀ → ℤ                                                      (H3)
  then        Σ(k = 0 to n) (t(k) − u(k)) = Σ(k = 0 to n) t(k) − Σ(k = 0 to n) u(k)
  metamath    fsumsub
  target      fsumsub
  first-used  divisibility-by-three

theorem sum-single
  let a ∈ ℤ                                                           (H1)
  let t : {a, …, a} → ℝ                                               (H2)
  then        Σ(k = a to a) t(k) = t(a)
  metamath    fsum1
  target      fsum1
  first-used  binomial

theorem sum-last
  let n ∈ ℕ₀                                                          (H1)
  let t : {0, …, n + 1} → ℝ                                           (H2)
  then        Σ(k = 0 to n + 1) t(k) = Σ(k = 0 to n) t(k) + t(n + 1)
  metamath    fsump1
  target      fsump1
  first-used  binomial

theorem sum-first
  let n ∈ ℕ₀                                                          (H1)
  let t : {0, …, n} → ℝ                                               (H2)
  then        Σ(k = 0 to n) t(k) = t(0) + Σ(k = 0 + 1 to n) t(k)
  metamath    fsum1p
  target      fsum1p
  first-used  binomial
  note        The rest of the sum starts at 0 + 1, as set.mm writes it; a
              proof that wants 1 there substitutes.

theorem sum-shift
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  let c ∈ ℤ                                                           (H3)
  let t : {a, …, b} → ℝ                                               (H4)
  then        Σ(k = a to b) t(k) = Σ(k = a + c to b + c) t(k − c)
  metamath    fsumshft
  target      fsumshft
  first-used  binomial
  note        The same terms counted from a different start: the term the
              left side takes at k, the right side takes at k + c.

theorem sum-scaled
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  let c ∈ ℝ                                                           (H3)
  let t : {a, …, b} → ℝ                                               (H4)
  then        c·(Σ(k = a to b) t(k)) = Σ(k = a to b) c·t(k)
  metamath    fsummulc2
  target      fsummulc2
  first-used  binomial

theorem sum-add
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  let t : {a, …, b} → ℝ                                               (H3)
  let u : {a, …, b} → ℝ                                               (H4)
  then        Σ(k = a to b) (t(k) + u(k)) = Σ(k = a to b) t(k) + Σ(k = a to b) u(k)
  metamath    fsumadd
  target      fsumadd
  first-used  binomial

theorem sum-termwise
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  let t : {a, …, b} → ℝ                                               (H3)
  let u : {a, …, b} → ℝ                                               (H4)
  assume for every k ∈ {a, …, b}, t(k) = u(k)                          (H5)
  then        Σ(k = a to b) t(k) = Σ(k = a to b) u(k)
  metamath    sumeq2dv
  target      sumeq2dv
  first-used  binomial
  note        Two sums over one range are equal when their terms are, index
              by index. The terms need agree only where the sum takes them,
              which is what lets a term be rewritten by a fact that holds on
              the range and nowhere else.

theorem sum-real
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  let t : {a, …, b} → ℝ                                               (H3)
  then        Σ(k = a to b) t(k) ∈ ℝ
  metamath    fsumrecl
  target      fsumrecl
  first-used  binomial

theorem range-difference
  let a ∈ ℤ                                                           (H1)
  let n ∈ ℤ                                                           (H2)
  let k ∈ {a, …, n}                                                   (H3)
  then        n − k ∈ ℕ₀
  metamath    fznn0sub
  target      fznn0sub
  first-used  binomial
  note        An index no greater than n leaves a whole number when taken
              from n, which is what lets x^(n − k) be a power with a natural
              exponent.

theorem range-integer
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  let k ∈ {a, …, b}                                                   (H3)
  then        k ∈ ℤ
  metamath    elfzelz
  target      elfzelz
  first-used  binomial

theorem range-nat0
  let n ∈ ℤ                                                           (H1)
  let k ∈ {0, …, n}                                                   (H2)
  then        k ∈ ℕ₀
  metamath    elfznn0
  target      elfznn0
  first-used  binomial
