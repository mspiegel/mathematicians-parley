# Standard library: calculus
#
# Intervals of the real line, upper bounds and completeness, and continuity.
#
# One record per item. A record begins at column 0 with its kind and name; a
# proof cites it as def:stdlib/calculus/<name> or thm:stdlib/calculus/<name>,
# and the prefix must match the kind. Format is described in DATABASE.md.
#
# An item's statement is written in the theorem form of SYNTAX.md: let and
# assume lines with labels, then a `then` line.
#
# Every item carries at least one of:
#   metamath    a set.mm label or labels supply it
#   open        it is cited but unproved and unbridged
#
# Other fields: target, first-used, note.


definition interval
  let a ∈ ℝ                                                           (H1)
  let b ∈ ℝ                                                           (H2)
  then        x ∈ [a, b] ↔ x ∈ ℝ and a ≤ x and x ≤ b
  metamath    elicc2
  target      elicc2
  first-used  intermediate-value

theorem interval-real
  let a ∈ ℝ                                                           (H1)
  let b ∈ ℝ                                                           (H2)
  then        [a, b] ⊆ ℝ
  metamath    iccssre
  target      iccssre
  first-used  intermediate-value

definition continuous-on
  let f : D → ℝ                                                       (H1)
  then        f is continuous on D ↔ for every c ∈ D, for every ε ∈ ℝ with
              ε > 0, there is δ ∈ ℝ with δ > 0 and for every x ∈ D, if
              |x − c| < δ then |f(x) − f(c)| < ε
  metamath    elcncf2
  target      elcncf2
  first-used  intermediate-value
  note        `elcncf2` quantifies over ℝ⁺ where the page says ε ∈ ℝ with
              ε > 0, and `rules.STANDARD` reads the one as the other. It
              also says f : D → ℝ on its right side, where the page puts it
              in the hypothesis, and that conjunct is set aside.

definition upper-bound
  then        u is an upper bound of S ↔ for every s ∈ S, s ≤ u
  metamath    ub as in df-sup
  first-used  intermediate-value

definition least-upper-bound
  then        c is a least upper bound of S ↔ c is an upper bound of S, and for
              every u ∈ ℝ, if u is an upper bound of S then c ≤ u
  metamath    df-sup, suprub, suprleub
  first-used  intermediate-value

theorem completeness
  assume S ⊆ ℝ                                                        (H1)
  assume there is s ∈ S                                               (H2)
  assume there is u ∈ ℝ with u is an upper bound of S                 (H3)
  then        there is c ∈ ℝ with c is a least upper bound of S
  metamath    suprcl, suprub, suprleub
  target      suprcl, suprub, suprleub with c := sup S
  first-used  intermediate-value
  note        The least upper bound is set.mm's supremum, and each thing the
              page asks of it is a lemma: that it is real, that nothing in S
              is above it, and that it is at most anything nothing in S is
              above. The `with` names what the claim binds, so it is the
              witness rather than what a lemma's variable stands for.
