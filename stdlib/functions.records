# Standard library: functions
#
# Functions, their values, and the set of values a function takes.
#
# One record per item. A record begins at column 0 with its kind and name; a
# proof cites it as def:stdlib/functions/<name> or
# thm:stdlib/functions/<name>, and the prefix must match the kind. Format is
# described in DATABASE.md.
#
# An item's statement is written in the theorem form of SYNTAX.md: let and
# assume lines with labels, then a `then` line.
#
# Every item carries at least one of:
#   metamath    a set.mm label or labels supply it
#   open        it is cited but unproved and unbridged
#
# Other fields: target, note.


definition set-image
  let Y be a set                                                      (H1)
  let Z be a set                                                      (H2)
  let E : Y → Z                                                       (H3)
  then        u ∈ {E(s) : s ∈ Y} ↔ there is s ∈ Y with u = E(s)
  metamath    elrnmptg
  target      elrnmptg
  note        {E(s) : s ∈ Y} is the range of the map s ↦ E(s) on Y, and
              elrnmptg says what is in that range where every E(s) is a set,
              which a function's value always is (`fvex`).

theorem added-elements-are-new
  let Y be a set                                                      (H1)
  let a be an element                                                 (H2)
  assume for every s ∈ Y, s ∪ {a} ∉ Y                                 (H3)
  then        for every u ∈ {s ∪ {a} : s ∈ Y}, u ∉ Y
  metamath    ralrnmpt
  target      ralrnmpt
  note        Running over the sets with a added is running over the sets and
              adding a, which `ralrnmpt` says of the range of any map written
              on the spot and of any property of its members. Both are
              narrowed here to the one map the corpus writes and the one
              property it asks, because the language can name neither — the
              same gap `notation bijection` records.

definition function
  open        The Cantor pilot's row reads "f : A → B ↔ for every x ∈ A,
              f(x) ∈ B, and ..." and is truncated. No pilot cites it. The
              statement has to be written before the item exists.
  note        set.mm's df-f is the target. The Cantor proof needs f only for the
              elaborator, since no step cites it; see that pilot's findings.

theorem function-value
  let f : D → E                                                       (H1)
  let x ∈ D                                                           (H2)
  then        f(x) ∈ E
  metamath    ffvelcdm
  target      ffvelcdm
  note        The intermediate value pilot called this def:stdlib/functions/function, colliding
              with the Cantor pilot's definition of the same name. Renamed by the
              merge; that proof's three citations are renamed with it.

theorem image-of-injection
  let Y be a set                                                      (H1)
  let a be an element                                                 (H2)
  assume for every S ∈ Y, for every T ∈ Y, if S ∪ {a} = T ∪ {a}
         then S = T                                                   (H3)
  then        there is a bijection from Y to {S ∪ {a} : S ∈ Y}
  metamath    f1oeng, over the map f1mpt and f1f1orn show is one-to-one
  target      f1oeng with F := the map sending S ∈ Y to S ∪ {a}
  note        A map that sends no two things to the same place pairs its
              domain off against what comes out of it. Narrowed to the one
              map the corpus builds, as `thm:stdlib/functions/added-elements-are-new` is: the
              readable layer states the property and the `target` names the
              map, because a reader says "if S ∪ {a} = T ∪ {a} then S = T"
              and does not name a function to say it.

theorem added-element-in-image
  let Y be a set                                                      (H1)
  let a be an element                                                 (H2)
  let s ∈ Y                                                           (H3)
  then        s ∪ {a} ∈ {t ∪ {a} : t ∈ Y}
  metamath    elrnmpt1s
  target      elrnmpt1s
  note        Narrowed to the one map the corpus writes, as
              `thm:stdlib/functions/added-elements-are-new` is.

theorem added-elements-stay-inside
  let Y be a set                                                      (H1)
  let a be an element                                                 (H2)
  assume for every s ∈ Y, s ∪ {a} ∈ Z                                 (H3)
  then        {s ∪ {a} : s ∈ Y} ⊆ Z
  metamath    rnmptss
  target      rnmptss
  note        Narrowed to the one map the corpus writes, as
              `thm:stdlib/functions/added-elements-are-new` is.

definition image
  let f : X → W                                                       (H1)
  assume Y ⊆ X                                                        (H2)
  then        u ∈ f[Y] ↔ there is s ∈ Y with u = f(s)
  metamath    fvelimab, with ffn and eqcom, which this corpus proves
              together in elaboration/stdlib/proved.mm
  target      gfvelima
  note        f[Y] is everything f sends Y to, {f(s) : s ∈ Y}. It is the same
              set as `def:stdlib/functions/set-image` speaks of for a map
              written on the spot; this is the one for a function with a
              name, which a bracket can follow.

theorem image-within
  let f : X → W                                                       (H1)
  then        f[Y] ⊆ W
  metamath    fimass
  target      fimass

theorem image-monotone
  let f : X → W                                                       (H1)
  assume Y ⊆ Z                                                        (H2)
  then        f[Y] ⊆ f[Z]
  metamath    imass2
  target      imass2

theorem function-into
  let E : X → W                                                       (H1)
  assume for every x ∈ X, E(x) ∈ Y                                    (H2)
  then        E : X → Y
  metamath    fmpt, over the map itself, which this corpus proves in
              elaboration/stdlib/proved.mm
  target      gfmpt
  note        Narrowed to a function a `define` gives, which is a map: set.mm
              says it of the map and the page of the name the define gave
              it, and the elaborator reads the one as the other.

theorem value-in-image
  let f : X → W                                                       (H1)
  assume Y ⊆ X                                                        (H2)
  let s ∈ Y                                                           (H3)
  then        f(s) ∈ f[Y]
  metamath    fnfvima, with ffn, which this corpus proves together in
              elaboration/stdlib/proved.mm
  target      gfnfvima

definition one-to-one
  let f : X → Y                                                       (H1)
  then        f : X → Y is one-to-one ↔ f : X → Y and for every s ∈ X,
              for every t ∈ X, if f(s) = f(t) then s = t
  metamath    dff13
  target      dff13

theorem inverse-value
  let g : Y → X be one-to-one                                         (H1)
  let y ∈ Y                                                           (H2)
  then        g⁻¹(g(y)) = y
  metamath    f1f1orn and f1ocnvfv1, which this corpus proves together in
              elaboration/stdlib/proved.mm
  target      gf1cnvfv1

theorem onto-bijection
  let X be a set                                                      (H1)
  let f : X → Y be one-to-one                                         (H2)
  assume for every y ∈ Y, there is x ∈ X with y = f(x)                (H3)
  then        there is a bijection from X to Y
  metamath    f1f, dffo3, df-f1o and f1oeng, which this corpus proves
              together in elaboration/stdlib/proved.mm
  target      gf1foen
  note        A function that never sends two things to one place and
              reaches every point pairs its domain off against its
              codomain. set.mm calls the reaching onto and the pairing a
              one-to-one correspondence, and the page says neither word.
