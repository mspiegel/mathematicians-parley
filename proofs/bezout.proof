import axiom              stdlib/numbers/well-ordering
import theorem            stdlib/divisibility/division-algorithm
import mundane definition stdlib/divisibility/divides
import mundane theorem    stdlib/divisibility/divides-combination
import mundane theorem    stdlib/divisibility/divides-le
import mundane definition stdlib/divisibility/gcd
import mundane theorem    stdlib/numbers/pos-int-nat
import mundane definition stdlib/sets/set-builder
import mundane theorem    stdlib/sets/set-builder-subset
import mundane definition stdlib/sets/subset

theorem least-combination-divides
  let a ∈ ℕ                                                           (H1)
  let b ∈ ℕ                                                           (H2)
  let c ∈ ℕ                                                           (H3)
  let d ∈ ℕ                                                           (H4)
  let u ∈ ℤ                                                           (H5)
  let v ∈ ℤ                                                           (H6)
  let x₀ ∈ ℤ                                                          (H7)
  let y₀ ∈ ℤ                                                          (H8)
  assume c = a·u + b·v                                                (H9)
  assume d = a·x₀ + b·y₀                                              (H10)
  assume for all x, y ∈ ℤ, if a·x + b·y ∈ ℕ then d ≤ a·x + b·y        (H11)
  then d divides c

1.  q ∈ ℤ. r ∈ ℤ. c = q·d + r. 0 ≤ r. r < d.
    obtain q, r: thm:division-algorithm n := c, d := d

2.  r = a·(u − q·x₀) + b·(v − q·y₀)
    algebra, from 1, H9, H10

3.  r = 0
    contradiction
    suppose r ≠ 0                                                     (S)

    3.1.  r ∈ ℕ
          mun:pos-int-nat m := r
          requires 0 < r: inequalities, from 1, S

    3.2.  a·(u − q·x₀) + b·(v − q·y₀) ∈ ℕ
          substitute r = a·(u − q·x₀) + b·(v − q·y₀) (line 2) into line 3.1

    3.3.  d ≤ a·(u − q·x₀) + b·(v − q·y₀)
          instantiate x := u − q·x₀, y := v − q·y₀ in H11, from 3.2

    3.4.  d ≤ r
          substitute r = a·(u − q·x₀) + b·(v − q·y₀) (line 2) into line 3.3

    3.5.  not d ≤ r
          inequalities, from 1, contradicting 3.4

4.  c = q·d + 0
    substitute r = 0 (line 3) into line 1

5.  c = d·q
    algebra, from 4

6.  d divides c
    mun:divides d := d, n := c, from 5


theorem bezout
  metamath    bezout
  let a ∈ ℕ                                                           (H1)
  let b ∈ ℕ                                                           (H2)
  then there exist x, y ∈ ℤ such that a·x + b·y = gcd(a, b)

define S := {t ∈ ℕ : there are m, n ∈ ℤ with t = a·m + b·n}   (D1)
       reads the positive whole numbers that a and b can be combined into

1.  a = a·1 + b·0
    algebra

2.  a ∈ S
    mun:set-builder u := a, from D1, 1

3.  S ⊆ ℕ
    mun:set-builder-subset, from D1

4.  d ∈ S. For all s ∈ S, d ≤ s.
    obtain d: axi:well-ordering S := S, from 3, 2

5.  For all t ∈ S, t ∈ ℕ
    mun:subset, from 3

6.  d ∈ ℕ
    instantiate t := d in line 5, from 4

7.  x₀ ∈ ℤ. y₀ ∈ ℤ. d = a·x₀ + b·y₀.
    obtain x₀, y₀: mun:set-builder u := d, from D1, 4

8.  For all x, y ∈ ℤ, if a·x + b·y ∈ ℕ then d ≤ a·x + b·y.
    proof
    let x ∈ ℤ                                                         (K1)
    let y ∈ ℤ                                                         (K2)
    assume a·x + b·y ∈ ℕ                                              (K3)

    8.1.  a·x + b·y = a·x + b·y
          algebra

    8.2.  a·x + b·y ∈ S
          mun:set-builder u := a·x + b·y, from D1, K3, 8.1

    8.3.  d ≤ a·x + b·y
          instantiate s := a·x + b·y in line 4, from 8.2

9.  a = a·1 + b·0
    algebra

10. d divides a
    thm:least-combination-divides c := a, u := 1, v := 0, from 6, 7, 9, 8

11. b = a·0 + b·1
    algebra

12. d divides b
    thm:least-combination-divides c := b, u := 0, v := 1, from 6, 7, 11, 8

13. gcd(a, b) ∈ ℕ. gcd(a, b) divides a. gcd(a, b) divides b.
    For all e ∈ ℕ, if e divides a and e divides b then e ≤ gcd(a, b).
    mun:gcd a := a, b := b

14. d ≤ gcd(a, b)
    instantiate e := d in line 13, from 6, 10, 12

15. gcd(a, b) divides a·x₀ + b·y₀
    mun:divides-combination e := gcd(a, b), x := x₀, y := y₀, from 13

16. gcd(a, b) divides d
    substitute d = a·x₀ + b·y₀ (line 7) into line 15

17. gcd(a, b) ≤ d
    mun:divides-le e := gcd(a, b), m := d, from 13, 6, 16

18. d = gcd(a, b)
    inequalities, from 14, 17
    requires d ∈ ℝ: from 6
    requires gcd(a, b) ∈ ℝ: from 13

19. a·x₀ + b·y₀ = gcd(a, b)
    calculation
      a·x₀ + b·y₀ = d               7
                  = gcd(a, b)       18

20. There exist x, y ∈ ℤ such that a·x + b·y = gcd(a, b).
    exhibit, from 19
