import theorem            proofs/angle-sum/angle-sum
import theorem            stdlib/geometry/law-of-sines
import theorem            stdlib/geometry/altitude-foot
import theorem            stdlib/geometry/segment-addition
import mundane theorem    stdlib/geometry/angle-along-segment
import mundane theorem    stdlib/geometry/angle-real
import mundane theorem    stdlib/geometry/angle-symmetric
import mundane theorem    stdlib/geometry/between-symmetric
import mundane theorem    stdlib/geometry/distance-real
import mundane theorem    stdlib/geometry/distance-symmetric
import mundane theorem    stdlib/geometry/sine-positive
import mundane definition stdlib/geometry/triangle
import mundane theorem    stdlib/geometry/triangle-rotate
import mundane theorem    stdlib/geometry/triangle-swap
import mundane theorem    stdlib/numbers/multiply-cancel
import mundane definition stdlib/trigonometry/sin
import mundane theorem    stdlib/trigonometry/sin-real

theorem similar-triangles
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  let P′ be a point                                                   (H4)
  let Q′ be a point                                                   (H5)
  let R′ be a point                                                   (H6)
  assume P, Q, R form a triangle                                      (H7)
  assume P′, Q′, R′ form a triangle                                   (H8)
  assume ∠QPR = ∠Q′P′R′                                               (H9)
  assume ∠PQR = ∠P′Q′R′                                               (H10)
  then |PQ|·|P′R′| = |P′Q′|·|PR|

1.  ∠QPR + ∠PQR + ∠QRP = 180°
    thm:angle-sum A := P, B := Q, C := R, from H7

2.  ∠Q′P′R′ + ∠P′Q′R′ + ∠Q′R′P′ = 180°
    thm:angle-sum A := P′, B := Q′, C := R′, from H8

3.  ∠QPR + ∠PQR + ∠QRP = ∠Q′P′R′ + ∠P′Q′R′ + ∠Q′R′P′
    calculation
      ∠QPR + ∠PQR + ∠QRP = 180°                               1
                         = ∠Q′P′R′ + ∠P′Q′R′ + ∠Q′R′P′         2

4.  ∠QRP = ∠Q′R′P′
    algebra, from 3, H9, H10
    requires Q, R, P form a triangle: mun:triangle-rotate P := P, Q := Q, R := R, from H7
    requires R, P, Q form a triangle: mun:triangle-rotate P := Q, Q := R, R := P
    requires Q ≠ P: mun:triangle
    requires R ≠ P: mun:triangle
    requires ∠QPR ∈ ℝ: mun:angle-real P := Q, Q := P, R := R
    requires P ≠ Q: mun:triangle, from H7
    requires R ≠ Q: mun:triangle
    requires ∠PQR ∈ ℝ: mun:angle-real P := P, Q := Q, R := R
    requires Q ≠ R: mun:triangle, from H7
    requires P ≠ R: mun:triangle, from H7
    requires ∠QRP ∈ ℝ: mun:angle-real P := Q, Q := R, R := P
    requires Q′, R′, P′ form a triangle: mun:triangle-rotate P := P′, Q := Q′, R := R′, from H8
    requires R′, P′, Q′ form a triangle: mun:triangle-rotate P := Q′, Q := R′, R := P′
    requires Q′ ≠ P′: mun:triangle
    requires R′ ≠ P′: mun:triangle
    requires ∠Q′P′R′ ∈ ℝ: mun:angle-real P := Q′, Q := P′, R := R′
    requires P′ ≠ Q′: mun:triangle, from H8
    requires R′ ≠ Q′: mun:triangle
    requires ∠P′Q′R′ ∈ ℝ: mun:angle-real P := P′, Q := Q′, R := R′
    requires Q′ ≠ R′: mun:triangle, from H8
    requires P′ ≠ R′: mun:triangle, from H8
    requires ∠Q′R′P′ ∈ ℝ: mun:angle-real P := Q′, Q := R′, R := P′

5.  |PQ|·sin(∠PQR) = |PR|·sin(∠QRP)
    thm:law-of-sines P := P, Q := Q, R := R, from H7

6.  |P′Q′|·sin(∠P′Q′R′) = |P′R′|·sin(∠Q′R′P′)
    thm:law-of-sines P := P′, Q := Q′, R := R′, from H8

7.  |P′Q′|·sin(∠PQR) = |P′R′|·sin(∠Q′R′P′)
    substitute ∠PQR = ∠P′Q′R′ (H10) into line 6

8.  |P′Q′|·sin(∠PQR) = |P′R′|·sin(∠QRP)
    substitute ∠QRP = ∠Q′R′P′ (line 4) into line 7

9.  |PQ|·|P′R′|·sin(∠PQR) = |PR|·|P′R′|·sin(∠QRP)
    algebra, from 5
    requires |PQ| ∈ ℝ: mun:distance-real P := P, Q := Q
    requires |PR| ∈ ℝ: mun:distance-real P := P, Q := R
    requires |P′R′| ∈ ℝ: mun:distance-real P := P′, Q := R′
    requires Q, R, P form a triangle: mun:triangle-rotate P := P, Q := Q, R := R, from H7
    requires R, P, Q form a triangle: mun:triangle-rotate P := Q, Q := R, R := P
    requires P ≠ Q: mun:triangle, from H7
    requires R ≠ Q: mun:triangle
    requires ∠PQR ∈ ℝ: mun:angle-real P := P, Q := Q, R := R
    requires sin(∠PQR) ∈ ℝ: mun:sin-real a := ∠PQR
    requires Q ≠ R: mun:triangle, from H7
    requires P ≠ R: mun:triangle, from H7
    requires ∠QRP ∈ ℝ: mun:angle-real P := Q, Q := R, R := P
    requires sin(∠QRP) ∈ ℝ: mun:sin-real a := ∠QRP

10. |P′Q′|·|PR|·sin(∠PQR) = |PR|·|P′R′|·sin(∠QRP)
    algebra, from 8
    requires |PR| ∈ ℝ: mun:distance-real P := P, Q := R
    requires |P′Q′| ∈ ℝ: mun:distance-real P := P′, Q := Q′
    requires |P′R′| ∈ ℝ: mun:distance-real P := P′, Q := R′
    requires Q, R, P form a triangle: mun:triangle-rotate P := P, Q := Q, R := R, from H7
    requires R, P, Q form a triangle: mun:triangle-rotate P := Q, Q := R, R := P
    requires P ≠ Q: mun:triangle, from H7
    requires R ≠ Q: mun:triangle
    requires ∠PQR ∈ ℝ: mun:angle-real P := P, Q := Q, R := R
    requires sin(∠PQR) ∈ ℝ: mun:sin-real a := ∠PQR
    requires Q ≠ R: mun:triangle, from H7
    requires P ≠ R: mun:triangle, from H7
    requires ∠QRP ∈ ℝ: mun:angle-real P := Q, Q := R, R := P
    requires sin(∠QRP) ∈ ℝ: mun:sin-real a := ∠QRP

11. |PQ|·|P′R′|·sin(∠PQR) = |P′Q′|·|PR|·sin(∠PQR)
    calculation
      |PQ|·|P′R′|·sin(∠PQR) = |PR|·|P′R′|·sin(∠QRP)       9
                            = |P′Q′|·|PR|·sin(∠PQR)       10

12. |PQ|·|P′R′| = |P′Q′|·|PR|
    mun:multiply-cancel a := |PQ|·|P′R′|, b := |P′Q′|·|PR|, c := sin(∠PQR),
      from 11
    requires |PQ| ∈ ℝ: mun:distance-real P := P, Q := Q
    requires |PR| ∈ ℝ: mun:distance-real P := P, Q := R
    requires |P′Q′| ∈ ℝ: mun:distance-real P := P′, Q := Q′
    requires |P′R′| ∈ ℝ: mun:distance-real P := P′, Q := R′
    requires |PQ|·|P′R′| ∈ ℝ: membership
    requires |P′Q′|·|PR| ∈ ℝ: membership
    requires Q, R, P form a triangle: mun:triangle-rotate P := P, Q := Q, R := R, from H7
    requires R, P, Q form a triangle: mun:triangle-rotate P := Q, Q := R, R := P
    requires P ≠ Q: mun:triangle, from H7
    requires R ≠ Q: mun:triangle
    requires ∠PQR ∈ ℝ: mun:angle-real P := P, Q := Q, R := R
    requires sin(∠PQR) ∈ ℝ: mun:sin-real a := ∠PQR
    requires sin(∠PQR) > 0: mun:sine-positive P := P, Q := Q, R := R, from H7
    requires sin(∠PQR) ≠ 0: inequalities

theorem pythagoras
  metamath    pythag
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  assume A, B, C form a triangle                                      (H4)
  assume ∠ACB = 90°                                                   (H5)
  then |AB|² = |AC|² + |BC|²

1.  D ∈ 𝔼². D is between A and B. ∠ADC = 90°. ∠BDC = 90°.
    A, D, C form a triangle. B, D, C form a triangle.
    obtain D: thm:altitude-foot P := A, Q := B, R := C, from H4, H5

2.  ∠DAC = ∠BAC
    mun:angle-along-segment P := A, Q := B, R := C, S := D, from 1
    requires B, C, A form a triangle: mun:triangle-rotate P := A, Q := B, R := C, from H4
    requires C ≠ A: mun:triangle

3.  ∠BAC = ∠CAB
    mun:angle-symmetric P := B, Q := A, R := C
    requires B, C, A form a triangle: mun:triangle-rotate P := A, Q := B, R := C, from H4
    requires B ≠ A: mun:triangle
    requires C ≠ A: mun:triangle

4.  ∠DAC = ∠CAB
    calculation
      ∠DAC = ∠BAC       2
           = ∠CAB       3

5.  ∠ADC = ∠ACB
    calculation
      ∠ADC = 90°        1
           = ∠ACB       H5

6.  |AD|·|AB| = |AC|·|AC|
    thm:similar-triangles P := A, Q := D, R := C, P′ := A, Q′ := C, R′ := B,
      from 1, 4, 5
    requires A, C, B form a triangle: mun:triangle-swap P := A, Q := B, R := C, from H4

7.  D is between B and A
    mun:between-symmetric R := D, S := A, T := B, from 1

8.  ∠DBC = ∠ABC
    mun:angle-along-segment P := B, Q := A, R := C, S := D, from 7
    requires A, C, B form a triangle: mun:triangle-swap P := A, Q := B, R := C, from H4
    requires C ≠ B: mun:triangle

9.  ∠ABC = ∠CBA
    mun:angle-symmetric P := A, Q := B, R := C
    requires A ≠ B: mun:triangle, from H4
    requires A, C, B form a triangle: mun:triangle-swap P := A, Q := B, R := C, from H4
    requires C ≠ B: mun:triangle

10. ∠DBC = ∠CBA
    calculation
      ∠DBC = ∠ABC       8
           = ∠CBA       9

11. ∠BCA = ∠ACB
    mun:angle-symmetric P := B, Q := C, R := A
    requires B ≠ C: mun:triangle, from H4
    requires A ≠ C: mun:triangle, from H4

12. ∠BDC = ∠BCA
    calculation
      ∠BDC = 90°        1
           = ∠ACB       H5
           = ∠BCA       11

13. |BD|·|BA| = |BC|·|BC|
    thm:similar-triangles P := B, Q := D, R := C, P′ := B, Q′ := C, R′ := A,
      from 1, 10, 12
    requires B, C, A form a triangle: mun:triangle-rotate P := A, Q := B, R := C, from H4

14. |AD| + |DB| = |AB|
    thm:segment-addition P := A, Q := B, S := D, from 1

15. |BD| = |DB|
    mun:distance-symmetric P := B, Q := D

16. |BA| = |AB|
    mun:distance-symmetric P := B, Q := A

17. |DB|·|BA| = |BC|·|BC|
    substitute |BD| = |DB| (line 15) into line 13

18. |DB|·|AB| = |BC|·|BC|
    substitute |BA| = |AB| (line 16) into line 17

19. |AB|² = |AC|² + |BC|²
    algebra, from 6, 18, 14
    requires |AB| ∈ ℝ: mun:distance-real P := A, Q := B
    requires |AC| ∈ ℝ: mun:distance-real P := A, Q := C
    requires |BC| ∈ ℝ: mun:distance-real P := B, Q := C
    requires |AD| ∈ ℝ: mun:distance-real P := A, Q := D
    requires |DB| ∈ ℝ: mun:distance-real P := D, Q := B
