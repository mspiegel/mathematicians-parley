import mundane axiom      stdlib/reasoning/excluded-middle
import mundane definition stdlib/sets/set-builder
import mundane theorem    stdlib/sets/set-builder-subset

theorem cantor
  metamath    canth
  note        Let B be the elements of A that their own image leaves out. If B
              were some f(x), then x would be in B exactly when it is not.
  let A be a set                                                      (H1)
  let f : A → 𝒫A                                                      (H2)
  then there exists B ⊆ A such that f(x) ≠ B for all x ∈ A

define B := {x ∈ A : x ∉ f(x)}                                        (D1)
       reads the members of A that their own image leaves out

1.  B ⊆ A
    mun:set-builder-subset, from D1

2.  For all x ∈ A, f(x) ≠ B.
    proof
    let x ∈ A                                                         (K)

    2.1.  f(x) ≠ B
          contradiction
          suppose f(x) = B                                            (S)

          2.1.1.  x ∈ B or x ∉ B
                  mun:excluded-middle P := x ∈ B

          2.1.2.  x ∉ B
                  cases, from 2.1.1

                  case
                  assume x ∈ B                                        (C1)

                  2.1.2.1.  x ∉ f(x)
                            mun:set-builder, from D1, C1

                  2.1.2.2.  x ∉ B
                            substitute f(x) = B (S) into line 2.1.2.1

                  case
                  assume x ∉ B, which is the claim                    (C2)

          2.1.3.  x ∉ f(x)
                  substitute f(x) = B (S) into line 2.1.2

          2.1.4.  x ∈ B
                  mun:set-builder, from D1, K, 2.1.3, contradicting 2.1.2

3.  There exists B ⊆ A such that f(x) ≠ B for all x ∈ A.
    exhibit, from 1, 2
