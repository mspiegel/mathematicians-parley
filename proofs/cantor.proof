theorem cantor
  metamath    canth
  let A be a set                                                      (H1)
  let f : A → 𝒫A                                                      (H2)
  then there exists B ⊆ A such that f(x) ≠ B for all x ∈ A

define B := {x ∈ A : x ∉ f(x)}                                        (D1)
       reads the members of A that their own image leaves out

1.  B ⊆ A
    thm:stdlib/sets/set-builder-subset, from D1

2.  f(x) ≠ B for all x ∈ A.
    fix
    let x ∈ A                                                         (K)

    2.1.  f(x) ≠ B
          contradiction
          suppose f(x) = B                                            (S)

          2.1.1.  x ∈ B or x ∉ B
                  thm:stdlib/reasoning/excluded-middle P := x ∈ B

          2.1.2.  x ∈ B. x ∉ B.
                  cases, from 2.1.1

                  case
                  assume x ∈ B                                        (C1)

                  2.1.2.1.  x ∉ f(x)
                            def:stdlib/sets/set-builder, from C1

                  2.1.2.2.  x ∉ B
                            substitute f(x) = B (S) into line 2.1.2.1

                  2.1.2.3.  x ∈ B. x ∉ B.
                            join C1, 2.1.2.2

                  case
                  assume x ∉ B                                        (C2)

                  2.1.2.4.  x ∉ f(x)
                            substitute f(x) = B (S) into C2

                  2.1.2.5.  x ∈ B
                            def:stdlib/sets/set-builder, from K, 2.1.2.4

                  2.1.2.6.  x ∈ B. x ∉ B.
                            join 2.1.2.5, C2

3.  There exists B ⊆ A such that f(x) ≠ B for all x ∈ A.
    exhibit, from 1, 2
