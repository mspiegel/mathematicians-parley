import theorem            proofs/sqrt2-irrational/even-square
import mundane definition stdlib/divisibility/divides
import mundane theorem    stdlib/divisibility/divides-le
import theorem            stdlib/divisibility/divides-gcd
import mundane theorem    stdlib/divisibility/divides-combination
import mundane theorem    stdlib/divisibility/divides-one
import mundane theorem    stdlib/divisibility/divides-self
import mundane theorem    stdlib/divisibility/divides-transitive
import mundane definition stdlib/divisibility/gcd
import mundane theorem    stdlib/divisibility/gcd-commutes
import mundane theorem    stdlib/divisibility/coprime-product
import theorem            stdlib/divisibility/coprime-square
import mundane theorem    stdlib/divisibility/divides-sum
import mundane theorem    stdlib/divisibility/divides-difference
import mundane theorem    stdlib/divisibility/divides-multiple
import mundane theorem    stdlib/divisibility/not-both
import mundane theorem    stdlib/divisibility/divides-square
import mundane theorem    stdlib/divisibility/divides-quotient
import mundane theorem    stdlib/divisibility/gcd-quotients-coprime
import mundane theorem    stdlib/numbers/pos-int-nat
import mundane theorem    stdlib/numbers/multiply-cancel
import mundane theorem    stdlib/numbers/square-equal
import mundane theorem    stdlib/numbers/square-less
import mundane theorem    stdlib/numbers/square-positive
import mundane definition stdlib/divisibility/even
import mundane theorem    stdlib/divisibility/even-or-odd
import mundane definition stdlib/divisibility/odd
import mundane theorem    stdlib/reasoning/disjunctive-syllogism
import mundane theorem    stdlib/reasoning/or-left
import mundane theorem    stdlib/reasoning/or-right

theorem even-leg
  let a ∈ ℕ                                                           (H1)
  let b ∈ ℕ                                                           (H2)
  let c ∈ ℕ                                                           (H3)
  assume a² + b² = c²                                                 (H4)
  then a is even or b is even

1.  a is even or a is odd
    mun:even-or-odd n := a

2.  a is even or b is even
    cases, from 1

    case
    assume a is even                                                  (C1)

    2.1.  a is even or b is even
          mun:or-left, from C1

    case
    assume a is odd                                                   (C2)

    2.2.  b is not odd
          contradiction
          suppose b is odd                                            (S)

          2.2.1.  p ∈ ℤ. a = 2p + 1.
                  obtain p: mun:odd n := a, from C2

          2.2.2.  q ∈ ℤ. b = 2q + 1.
                  obtain q: mun:odd n := b, from S

          2.2.3.  (2p + 1)² + b² = c²
                  substitute a = 2p + 1 (line 2.2.1) into H4

          2.2.4.  (2p + 1)² + (2q + 1)² = c²
                  substitute b = 2q + 1 (line 2.2.2) into line 2.2.3

          2.2.5.  (2p + 1)² + (2q + 1)² = 2(2p² + 2p + 2q² + 2q + 1)
                  algebra

          2.2.6.  c² = 2(2p² + 2p + 2q² + 2q + 1)
                  calculation
                    c² = (2p + 1)² + (2q + 1)²         2.2.4
                       = 2(2p² + 2p + 2q² + 2q + 1)    2.2.5

          2.2.7.  c² is even
                  mun:even n := c², from 2.2.6

          2.2.8.  c is even
                  thm:even-square n := c, from 2.2.7

          2.2.9.  r ∈ ℤ. c = 2r.
                  obtain r: mun:even n := c, from 2.2.8

          2.2.10. (2p + 1)² + (2q + 1)² = (2r)²
                  substitute c = 2r (line 2.2.9) into line 2.2.4

          2.2.11. 2 = 4(r² − p² − p − q² − q)
                  algebra, from 2.2.10

          2.2.12. 4 divides 2
                  mun:divides d := 4, n := 2, from 2.2.11

          2.2.13. 4 ≤ 2, which is impossible
                  mun:divides-le e := 4, m := 2, from 2.2.12

    2.3.  b is even or b is odd
          mun:even-or-odd n := b

    2.4.  b is even
          mun:disjunctive-syllogism P := b is even, Q := b is odd, from 2.3, 2.2

    2.5.  a is even or b is even
          mun:or-right, from 2.4

theorem leg-hypotenuse-coprime
  let a ∈ ℕ                                                           (H1)
  let b ∈ ℕ                                                           (H2)
  let c ∈ ℕ                                                           (H3)
  assume a² + b² = c²                                                 (H4)
  assume gcd(a, b) = 1                                                (H5)
  then gcd(b, c) = 1

1.  gcd(b, c) ∈ ℕ. gcd(b, c) divides b. gcd(b, c) divides c.
    For all e ∈ ℕ, if e divides b and e divides c then e ≤ gcd(b, c).
    mun:gcd a := b, b := c

2.  gcd(b, c) divides c·c + b·(−b)
    mun:divides-combination e := gcd(b, c), a := c, b := b, x := c, y := −b, from 1

3.  c·c + b·(−b) = a·a
    algebra, from H4

4.  gcd(b, c) divides a·a
    substitute c·c + b·(−b) = a·a (line 3) into line 2

5.  gcd(gcd(b, c), a) ∈ ℕ. gcd(gcd(b, c), a) divides gcd(b, c).
    gcd(gcd(b, c), a) divides a.
    For all e ∈ ℕ, if e divides gcd(b, c) and e divides a then e ≤ gcd(gcd(b, c), a).
    mun:gcd a := gcd(b, c), b := a, from 1

6.  gcd(gcd(b, c), a) divides b
    mun:divides-transitive d := gcd(gcd(b, c), a), e := gcd(b, c), n := b, from 5, 1

7.  gcd(gcd(b, c), a) divides gcd(a, b)
    thm:divides-gcd d := gcd(gcd(b, c), a), a := a, b := b, from 5, 6

8.  gcd(gcd(b, c), a) divides 1
    substitute gcd(a, b) = 1 (H5) into line 7

9.  gcd(gcd(b, c), a) = 1
    mun:divides-one d := gcd(gcd(b, c), a), from 5, 8

10. gcd(a, gcd(b, c)) = gcd(gcd(b, c), a)
    mun:gcd-commutes a := a, b := gcd(b, c)
    requires gcd(b, c) ∈ ℤ: membership, from 1

11. gcd(a, gcd(b, c)) = 1
    calculation
      gcd(a, gcd(b, c)) = gcd(gcd(b, c), a)    10
                        = 1                    9

12. gcd(a·a, gcd(b, c)) = 1
    mun:coprime-product x := a, y := a, n := gcd(b, c), from 11, 11, 1

13. gcd(b, c) divides gcd(b, c)
    mun:divides-self n := gcd(b, c)
    requires gcd(b, c) ∈ ℤ: membership, from 1

14. gcd(b, c) divides gcd(a·a, gcd(b, c))
    thm:divides-gcd d := gcd(b, c), a := a·a, b := gcd(b, c), from 4, 13
    requires gcd(b, c) ∈ ℤ: membership, from 1

15. gcd(b, c) divides 1
    substitute gcd(a·a, gcd(b, c)) = 1 (line 12) into line 14

16. gcd(b, c) = 1
    mun:divides-one d := gcd(b, c), from 1, 15

theorem primitive-triple
  let a ∈ ℕ                                                           (H1)
  let b ∈ ℕ                                                           (H2)
  let c ∈ ℕ                                                           (H3)
  assume a² + b² = c²                                                 (H4)
  assume gcd(a, b) = 1                                                (H5)
  assume a is even                                                    (H6)
  then there are m, n ∈ ℕ with n < m, gcd(m, n) = 1, m + n is odd,
       a = 2mn, b = m² − n², and c = m² + n²

1.  w ∈ ℤ. a = 2w.
    obtain w: mun:even n := a, from H6

2.  w ∈ ℕ
    mun:pos-int-nat m := w
    requires 0 < w: inequalities, from 1, H1

3.  2 divides a
    mun:divides d := 2, n := a, from 1

4.  b is odd
    contradiction
    suppose b is not odd                                              (S1)

    4.1.  b is even or b is odd
          mun:even-or-odd n := b

    4.2.  b is even
          mun:disjunctive-syllogism P := b is even, Q := b is odd, from 4.1, S1

    4.3.  v ∈ ℤ. b = 2v.
          obtain v: mun:even n := b, from 4.2

    4.4.  2 divides b
          mun:divides d := 2, n := b, from 4.3

    4.5.  2 divides gcd(a, b)
          thm:divides-gcd d := 2, a := a, b := b, from 3, 4.4

    4.6.  2 divides 1
          substitute gcd(a, b) = 1 (H5) into line 4.5

    4.7.  2 ≤ 1, which is impossible
          mun:divides-le e := 2, m := 1, from 4.6

5.  q ∈ ℤ. b = 2q + 1.
    obtain q: mun:odd n := b, from 4

6.  (2w)² + b² = c²
    substitute a = 2w (line 1) into H4

7.  (2w)² + (2q + 1)² = c²
    substitute b = 2q + 1 (line 5) into line 6

8.  c is odd
    contradiction
    suppose c is not odd                                              (S2)

    8.1.  c is even or c is odd
          mun:even-or-odd n := c

    8.2.  c is even
          mun:disjunctive-syllogism P := c is even, Q := c is odd, from 8.1, S2

    8.3.  r ∈ ℤ. c = 2r.
          obtain r: mun:even n := c, from 8.2

    8.4.  (2w)² + (2q + 1)² = (2r)²
          substitute c = 2r (line 8.3) into line 7

    8.5.  1 = 2(2r² − 2w² − 2q² − 2q)
          algebra, from 8.4

    8.6.  2 divides 1
          mun:divides d := 2, n := 1, from 8.5

    8.7.  2 ≤ 1, which is impossible
          mun:divides-le e := 2, m := 1, from 8.6

9.  r ∈ ℤ. c = 2r + 1.
    obtain r: mun:odd n := c, from 8

10. c + b = 2(r + q + 1)
    algebra, from 9, 5

11. c + b is even
    mun:even n := c + b, from 10

12. s ∈ ℤ. c + b = 2s.
    obtain s: mun:even n := c + b, from 11

13. c − b = 2(r − q)
    algebra, from 9, 5

14. c − b is even
    mun:even n := c − b, from 13

15. t ∈ ℤ. c − b = 2t.
    obtain t: mun:even n := c − b, from 14

16. c·2 = (s + t)·2
    algebra, from 12, 15

17. c = s + t
    mun:multiply-cancel a := c, b := s + t, c := 2, from 16
    requires 2 ≠ 0: arithmetic

18. (s − t)·2 = 2s − 2t
    algebra

19. (s − t)·2 = (c + b) − 2t
    substitute c + b = 2s (line 12) into line 18

20. (s − t)·2 = (c + b) − (c − b)
    substitute c − b = 2t (line 15) into line 19

21. (c + b) − (c − b) = b·2
    algebra

22. b·2 = (s − t)·2
    calculation
      b·2 = (c + b) − (c − b)    21
          = (s − t)·2            20

23. b = s − t
    mun:multiply-cancel a := b, b := s − t, c := 2, from 22
    requires 2 ≠ 0: arithmetic

24. a² > 0
    mun:square-positive x := a, from H1

25. b² < c²
    inequalities, from H4, 24

26. b < c
    mun:square-less x := b, y := c, from 25
    requires b ≥ 0: inequalities, from H2
    requires c ≥ 0: inequalities, from H3

27. t ∈ ℕ
    mun:pos-int-nat m := t
    requires 0 < t: inequalities, from 15, 26, H2, H3

28. s ∈ ℕ
    mun:pos-int-nat m := s
    requires 0 < s: inequalities, from 12, H2, H3

29. a² = (2w)²
    substitute a = 2w (line 1)

30. c² − b² = a²
    algebra, from H4

31. (c + b)·(c − b) = c² − b²
    algebra

32. (2s)·(c − b) = c² − b²
    substitute c + b = 2s (line 12) into line 31

33. (2s)·(2t) = c² − b²
    substitute c − b = 2t (line 15) into line 32

34. w²·4 = (2w)²
    algebra

35. (2s)·(2t) = (s·t)·4
    algebra

36. w²·4 = (s·t)·4
    calculation
      w²·4 = (2w)²          34
           = a²             29
           = c² − b²        30
           = (2s)·(2t)      33
           = (s·t)·4        35

37. w² = s·t
    mun:multiply-cancel a := w², b := s·t, c := 4, from 36
    requires 4 ≠ 0: arithmetic

38. gcd(b, c) = 1
    thm:leg-hypotenuse-coprime a := a, b := b, c := c, from H4, H5

39. gcd(s, t) ∈ ℕ. gcd(s, t) divides s. gcd(s, t) divides t.
    For all e ∈ ℕ, if e divides s and e divides t then e ≤ gcd(s, t).
    mun:gcd a := s, b := t, from 28, 27

40. gcd(s, t) divides s + t
    mun:divides-sum d := gcd(s, t), a := s, b := t, from 39

41. gcd(s, t) divides c
    substitute c = s + t (line 17) into line 40

42. gcd(s, t) divides s − t
    mun:divides-difference d := gcd(s, t), a := s, b := t, from 39

43. gcd(s, t) divides b
    substitute b = s − t (line 23) into line 42

44. gcd(s, t) divides gcd(b, c)
    thm:divides-gcd d := gcd(s, t), a := b, b := c, from 43, 41
    requires gcd(s, t) ∈ ℤ: membership, from 39

45. gcd(s, t) divides 1
    substitute gcd(b, c) = 1 (line 38) into line 44

46. gcd(s, t) = 1
    mun:divides-one d := gcd(s, t), from 39, 45

47. s = gcd(s, w)². t = gcd(t, w)².
    thm:coprime-square s := s, t := t, w := w, from 28, 27, 2, 46, 37

48. gcd(s, w) ∈ ℕ. gcd(s, w) divides s. gcd(s, w) divides w.
    For all e ∈ ℕ, if e divides s and e divides w then e ≤ gcd(s, w).
    mun:gcd a := s, b := w, from 28, 2

49. There is m ∈ ℕ with s = m².
    exhibit, from 48, 47

50. m ∈ ℕ. s = m².
    obtain m from line 49

51. There is n ∈ ℕ with t = n².
    exhibit, from 47
    requires gcd(t, w) ∈ ℕ: mun:gcd a := t, b := w, from 27, 2

52. n ∈ ℕ. t = n².
    obtain n from line 51

53. w² = m²·t
    substitute s = m² (line 50) into line 37

54. w² = m²·n²
    substitute t = n² (line 52) into line 53

55. m·n ∈ ℕ
    membership

56. w² = (m·n)²
    algebra, from 54

57. w = m·n
    mun:square-equal x := w, y := m·n, from 56
    requires w ≥ 0: inequalities, from 2
    requires m·n ≥ 0: inequalities, from 55

58. a = 2(m·n)
    substitute w = m·n (line 57) into line 1

59. b = m² − t
    substitute s = m² (line 50) into line 23

60. b = m² − n²
    substitute t = n² (line 52) into line 59

61. c = m² + t
    substitute s = m² (line 50) into line 17

62. c = m² + n²
    substitute t = n² (line 52) into line 61

63. n² < m²
    inequalities, from 60, H2

64. n < m
    mun:square-less x := n, y := m, from 63
    requires n ≥ 0: inequalities, from 52
    requires m ≥ 0: inequalities, from 50

65. gcd(m, n) ∈ ℕ. gcd(m, n) divides m. gcd(m, n) divides n.
    For all e ∈ ℕ, if e divides m and e divides n then e ≤ gcd(m, n).
    mun:gcd a := m, b := n

66. gcd(m, n) divides m·m
    mun:divides-multiple e := gcd(m, n), a := m, x := m, from 65

67. m·m = s
    algebra, from 50

68. gcd(m, n) divides s
    substitute m·m = s (line 67) into line 66

69. gcd(m, n) divides n·n
    mun:divides-multiple e := gcd(m, n), a := n, x := n, from 65

70. n·n = t
    algebra, from 52

71. gcd(m, n) divides t
    substitute n·n = t (line 70) into line 69

72. gcd(m, n) divides gcd(s, t)
    thm:divides-gcd d := gcd(m, n), a := s, b := t, from 68, 71
    requires gcd(m, n) ∈ ℤ: membership, from 65

73. gcd(m, n) divides 1
    substitute gcd(s, t) = 1 (line 46) into line 72

74. gcd(m, n) = 1
    mun:divides-one d := gcd(m, n), from 65, 73

75. m + n is odd
    contradiction
    suppose m + n is not odd                                          (S3)

    75.1. m + n is even or m + n is odd
          mun:even-or-odd n := m + n

    75.2. m + n is even
          mun:disjunctive-syllogism P := m + n is even, Q := m + n is odd, from 75.1, S3

    75.3. u ∈ ℤ. m + n = 2u.
          obtain u: mun:even n := m + n, from 75.2

    75.4. m² − n² = (m + n)·(m − n)
          algebra

    75.5. m² − n² = (2u)·(m − n)
          substitute m + n = 2u (line 75.3) into line 75.4

    75.6. (2u)·(m − n) = 2(u·(m − n))
          algebra

    75.7. b = 2(u·(m − n))
          calculation
            b = m² − n²            60
              = (2u)·(m − n)       75.5
              = 2(u·(m − n))       75.6

    75.8. b is even
          mun:even n := b, from 75.7

    75.9. b is not odd
          mun:not-both n := b, from 75.8, contradicting 4

76. There are m, n ∈ ℕ with n < m, gcd(m, n) = 1, m + n is odd,
    a = 2mn, b = m² − n², and c = m² + n².
    exhibit, from 64, 74, 75, 60, 62
    requires a = 2mn: algebra, from 58, H1, 50, 52

theorem triple-scaled
  let a ∈ ℕ                                                           (H1)
  let b ∈ ℕ                                                           (H2)
  let c ∈ ℕ                                                           (H3)
  assume a² + b² = c²                                                 (H4)
  then there is k ∈ ℕ with a/k ∈ ℕ, b/k ∈ ℕ, c/k ∈ ℕ, gcd(a/k, b/k) = 1,
       and (a/k)² + (b/k)² = (c/k)²

1.  gcd(a, b) ∈ ℕ. gcd(a, b) divides a. gcd(a, b) divides b.
    For all e ∈ ℕ, if e divides a and e divides b then e ≤ gcd(a, b).
    mun:gcd a := a, b := b

2.  a/gcd(a, b) ∈ ℕ
    mun:divides-quotient n := a, d := gcd(a, b), from 1

3.  b/gcd(a, b) ∈ ℕ
    mun:divides-quotient n := b, d := gcd(a, b), from 1

4.  gcd(a, b)² divides a²
    mun:divides-square d := gcd(a, b), n := a, from 1

5.  gcd(a, b)² divides b²
    mun:divides-square d := gcd(a, b), n := b, from 1

6.  gcd(a, b)² divides a² + b²
    mun:divides-sum d := gcd(a, b)², a := a², b := b², from 4, 5
    requires gcd(a, b)² ∈ ℤ: membership, from 1

7.  gcd(a, b)² divides c²
    substitute a² + b² = c² (H4) into line 6

8.  gcd(a, b) divides c
    mun:divides-square d := gcd(a, b), n := c, from 7
    requires gcd(a, b) ∈ ℤ: membership, from 1

9.  c/gcd(a, b) ∈ ℕ
    mun:divides-quotient n := c, d := gcd(a, b), from 1, 8

10. gcd(a/gcd(a, b), b/gcd(a, b)) = 1
    mun:gcd-quotients-coprime a := a, b := b
    requires b ≠ 0: inequalities, from H2

11. (a/gcd(a, b))² + (b/gcd(a, b))² = (a² + b²)/gcd(a, b)²
    algebra
    requires gcd(a, b) ∈ ℝ: membership, from 1
    requires gcd(a, b) ≠ 0: inequalities, from 1

12. (a/gcd(a, b))² + (b/gcd(a, b))² = c²/gcd(a, b)²
    substitute a² + b² = c² (H4) into line 11

13. c²/gcd(a, b)² = (c/gcd(a, b))²
    algebra
    requires gcd(a, b) ∈ ℝ: membership, from 1
    requires gcd(a, b) ≠ 0: inequalities, from 1

14. (a/gcd(a, b))² + (b/gcd(a, b))² = (c/gcd(a, b))²
    calculation
      (a/gcd(a, b))² + (b/gcd(a, b))² = c²/gcd(a, b)²        12
                                      = (c/gcd(a, b))²       13

15. There is k ∈ ℕ with a/k ∈ ℕ, b/k ∈ ℕ, c/k ∈ ℕ, gcd(a/k, b/k) = 1,
    and (a/k)² + (b/k)² = (c/k)².
    exhibit, from 1, 2, 3, 9, 10, 14

theorem triple-from-parameters
  let a ∈ ℕ                                                           (H1)
  let b ∈ ℕ                                                           (H2)
  let c ∈ ℕ                                                           (H3)
  let k ∈ ℕ                                                           (H4)
  let m ∈ ℕ                                                           (H5)
  let n ∈ ℕ                                                           (H6)
  assume c = k(m² + n²)                                               (H7)
  assume (a = k(m² − n²) and b = 2kmn) or (a = 2kmn and b = k(m² − n²)) (H8)
  then a² + b² = c²

1.  (k(m² − n²))² + (2kmn)² = (k(m² + n²))²
    algebra

2.  a² + b² = c²
    cases, from H8

    case
    assume a = k(m² − n²) and b = 2kmn                                (C1)

    2.1.  a² + b² = (k(m² − n²))² + b²
          substitute a = k(m² − n²) (C1)

    2.2.  (k(m² − n²))² + b² = (k(m² − n²))² + (2kmn)²
          substitute b = 2kmn (C1)

    2.3.  (k(m² + n²))² = c²
          substitute c = k(m² + n²) (H7)

    2.4.  a² + b² = c²
          calculation
            a² + b² = (k(m² − n²))² + b²            2.1
                    = (k(m² − n²))² + (2kmn)²       2.2
                    = (k(m² + n²))²                 1
                    = c²                            2.3

    case
    assume a = 2kmn and b = k(m² − n²)                                (C2)

    2.5.  a² + b² = (2kmn)² + b²
          substitute a = 2kmn (C2)

    2.6.  (2kmn)² + b² = (2kmn)² + (k(m² − n²))²
          substitute b = k(m² − n²) (C2)

    2.7.  (2kmn)² + (k(m² − n²))² = (k(m² + n²))²
          algebra

    2.8.  (k(m² + n²))² = c²
          substitute c = k(m² + n²) (H7)

    2.9.  a² + b² = c²
          calculation
            a² + b² = (2kmn)² + b²                  2.5
                    = (2kmn)² + (k(m² − n²))²       2.6
                    = (k(m² + n²))²                 2.7
                    = c²                            2.8

theorem triple-parameters
  let a ∈ ℕ                                                           (H1)
  let b ∈ ℕ                                                           (H2)
  let c ∈ ℕ                                                           (H3)
  assume a² + b² = c²                                                 (H4)
  then there are k, m, n ∈ ℕ with c = k(m² + n²),
       and ((a = k(m² − n²) and b = 2kmn) or (a = 2kmn and b = k(m² − n²)))

1.  k ∈ ℕ. a/k ∈ ℕ. b/k ∈ ℕ. c/k ∈ ℕ. gcd(a/k, b/k) = 1.
    (a/k)² + (b/k)² = (c/k)².
    obtain k: thm:triple-scaled a := a, b := b, c := c, from H4

2.  a/k is even or b/k is even
    thm:even-leg a := a/k, b := b/k, c := c/k, from 1

3.  There are k, m, n ∈ ℕ with c = k(m² + n²),
    and ((a = k(m² − n²) and b = 2kmn) or (a = 2kmn and b = k(m² − n²))).
    cases, from 2

    case
    assume a/k is even                                                (C1)

    3.1.  m ∈ ℕ. n ∈ ℕ. n < m. gcd(m, n) = 1. m + n is odd.
          a/k = 2mn. b/k = m² − n². c/k = m² + n².
          obtain m, n: thm:primitive-triple a := a/k, b := b/k, c := c/k, from 1, C1

    3.2.  a = 2kmn
          algebra, from 3.1
          requires k ≠ 0: inequalities, from 1

    3.3.  b = k(m² − n²)
          algebra, from 3.1
          requires k ≠ 0: inequalities, from 1

    3.4.  c = k(m² + n²)
          algebra, from 3.1
          requires k ≠ 0: inequalities, from 1

    3.5.  a = 2kmn and b = k(m² − n²)
          join 3.2, 3.3

    3.6.  (a = k(m² − n²) and b = 2kmn) or (a = 2kmn and b = k(m² − n²))
          mun:or-right, from 3.5

    3.7.  There are k, m, n ∈ ℕ with c = k(m² + n²),
          and ((a = k(m² − n²) and b = 2kmn) or (a = 2kmn and b = k(m² − n²))).
          exhibit, from 3.4, 3.6

    case
    assume b/k is even                                                (C2)

    3.8.  gcd(b/k, a/k) = gcd(a/k, b/k)
          mun:gcd-commutes a := b/k, b := a/k
          requires b/k ∈ ℤ: membership, from 1
          requires a/k ∈ ℤ: membership, from 1

    3.9.  gcd(b/k, a/k) = 1
          calculation
            gcd(b/k, a/k) = gcd(a/k, b/k)    3.8
                          = 1                1

    3.10. (b/k)² + (a/k)² = (c/k)²
          algebra, from 1

    3.11. m ∈ ℕ. n ∈ ℕ. n < m. gcd(m, n) = 1. m + n is odd.
          b/k = 2mn. a/k = m² − n². c/k = m² + n².
          obtain m, n: thm:primitive-triple a := b/k, b := a/k, c := c/k, from 1, 3.9, 3.10, C2

    3.12. a = k(m² − n²)
          algebra, from 3.11
          requires k ≠ 0: inequalities, from 1

    3.13. b = 2kmn
          algebra, from 3.11
          requires k ≠ 0: inequalities, from 1

    3.14. c = k(m² + n²)
          algebra, from 3.11
          requires k ≠ 0: inequalities, from 1

    3.15. a = k(m² − n²) and b = 2kmn
          join 3.12, 3.13

    3.16. (a = k(m² − n²) and b = 2kmn) or (a = 2kmn and b = k(m² − n²))
          mun:or-left, from 3.15

    3.17. There are k, m, n ∈ ℕ with c = k(m² + n²),
          and ((a = k(m² − n²) and b = 2kmn) or (a = 2kmn and b = k(m² − n²))).
          exhibit, from 3.14, 3.16

theorem pythagorean-triples
  metamath    pythagtrip
  let a ∈ ℕ                                                           (H1)
  let b ∈ ℕ                                                           (H2)
  let c ∈ ℕ                                                           (H3)
  then a² + b² = c² ↔ there are k, m, n ∈ ℕ with c = k(m² + n²),
       and ((a = k(m² − n²) and b = 2kmn) or (a = 2kmn and b = k(m² − n²)))

1.  a² + b² = c² ↔ there are k, m, n ∈ ℕ with c = k(m² + n²),
    and ((a = k(m² − n²) and b = 2kmn) or (a = 2kmn and b = k(m² − n²))).
    both directions

    direction
    assume a² + b² = c²                                               (D1)

    1.1.  There are k, m, n ∈ ℕ with c = k(m² + n²),
          and ((a = k(m² − n²) and b = 2kmn) or (a = 2kmn and b = k(m² − n²))).
          thm:triple-parameters a := a, b := b, c := c, from D1

    direction
    assume there are k, m, n ∈ ℕ with c = k(m² + n²), and ((a = k(m² − n²) and b = 2kmn) or (a = 2kmn and b = k(m² − n²))) (D2)

    1.2.  k ∈ ℕ. m ∈ ℕ. n ∈ ℕ. c = k(m² + n²).
          (a = k(m² − n²) and b = 2kmn) or (a = 2kmn and b = k(m² − n²)).
          obtain k, m, n from D2

    1.3.  a² + b² = c²
          thm:triple-from-parameters a := a, b := b, c := c, k := k, m := m, n := n, from 1.2
