import theorem            stdlib/geometry/angle-side-angle
import mundane theorem    stdlib/geometry/angle-symmetric
import definition         stdlib/geometry/congruent
forbid theorem            stdlib/geometry/law-of-cosines
forbid theorem            stdlib/geometry/law-of-sines

theorem equal-angles-equal-sides
  note        Euclid I.6. Read the triangle as ABC and as BAC. The side AB is
              common, and the angles at its two ends agree, so the two are
              congruent and the sides CA and CB opposite those angles match.
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  assume A, B, C form a triangle                                      (H4)
  assume ∠CAB = ∠CBA                                                  (H5)
  then |CA| = |CB|

1.  ∠ABC = ∠BAC
    calculation
      ∠ABC = ∠CBA       mun:angle-symmetric P := A, Q := B, R := C, from H4
           = ∠CAB       H5
           = ∠BAC       mun:angle-symmetric P := C, Q := A, R := B, from H4

2.  triangle ABC ≅ triangle BAC
    thm:angle-side-angle D := B, E := A, F := C, from H4, H5, 1

3.  |CA| = |CB|
    def:congruent, from H4, 2
