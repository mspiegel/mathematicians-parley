import theorem            proofs/euclid/apollonius/apollonius
import theorem            proofs/wiedijk/pythagoras/pythagoras
import mundane definition stdlib/geometry/midpoint
import mundane theorem    stdlib/geometry/segment-addition
import mundane theorem    stdlib/geometry/distance-nonneg
import mundane theorem    stdlib/numbers/square-equal

theorem thales-converse
  note        Pythagoras at the right angle C gives |AB|² = |AC|² + |BC|²,
              and Apollonius for the median CM gives |CA|² + |CB|² =
              2·|CM|² + 2·|AM|². With |AB| = 2·|AM| this leaves
              |CM| = |AM|.
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  let M be a point                                                    (H4)
  assume A, B, C form a triangle                                      (H5)
  assume ∠ACB = 90°                                                   (H6)
  assume M is the midpoint of AB                                      (H7)
  then |MC| = |MA|

1.  M is between A and B. |AM| = |MB|.
    mun:midpoint, from H7

2.  |CA|² + |CB|² = 2·|CM|² + 2·|AM|²
    thm:apollonius A := C, B := A, C := B, from 1

3.  |AM| + |MB| = |AB|
    mun:segment-addition P := A, Q := B, S := M, from 1

4.  |AB| = 2·|AM|
    algebra, from 1, 3

5.  |AB|² = (2·|AM|)²
    substitute |AB| = 2·|AM| (line 4)

6.  |AB|² = |AC|² + |BC|²
    thm:pythagoras, from H5, H6

7.  |CM|² = |AM|²
    algebra, from 2, 5, 6

8.  |CM| ≥ 0
    mun:distance-nonneg P := C, Q := M

9.  |AM| ≥ 0
    mun:distance-nonneg P := A, Q := M

10. |CM| = |AM|
    mun:square-equal x := |CM|, y := |AM|, from 7, 8, 9
