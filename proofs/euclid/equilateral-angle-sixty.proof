import theorem            stdlib/geometry/law-of-cosines
import mundane theorem    stdlib/geometry/angle-by-cosine
import mundane axiom      stdlib/geometry/distance-positive
import mundane theorem    stdlib/geometry/triangle-angle-real
import mundane definition stdlib/geometry/triangle
import mundane definition stdlib/trigonometry/cos
import mundane theorem    stdlib/trigonometry/cos-real
import mundane theorem    stdlib/numbers/multiply-cancel
import mundane theorem    stdlib/numbers/square-positive

theorem equilateral-angle-sixty
  note        Euclid I.5, corollary. The law of cosines at B with all three
              sides equal to s gives s² = 2s² − 2s²·cos ∠ABC, so the cosine
              is 1/2, which is the cosine of 60°, and the angle is read back
              from its cosine.
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  assume A, B, C form a triangle                                      (H4)
  assume |AB| = |BC| = |CA|                                           (H5)
  then ∠ABC = 60°

1.  A ≠ B. B ≠ C.
    mun:triangle, from H4

2.  |CA|² = |AB|² + |BC|² − 2·(|AB|·|BC|·cos(∠ABC))
    thm:law-of-cosines P := A, Q := B, R := C, from 1

3.  |AB|² = |AB|² + |BC|² − 2·(|AB|·|BC|·cos(∠ABC))
    substitute |CA| = |AB| (H5) into line 2

4.  |AB|² = |AB|² + |AB|² − 2·(|AB|·|AB|·cos(∠ABC))
    substitute |BC| = |AB| (H5) into line 3

5.  cos(∠ABC)·|AB|² = (1/2)·|AB|²
    algebra, from 4
    requires ∠ABC ∈ ℝ: mun:triangle-angle-real P := A, Q := B, R := C, from H4
    requires cos(∠ABC) ∈ ℝ: mun:cos-real a := ∠ABC

6.  |AB| > 0
    mun:distance-positive P := A, Q := B, from 1

7.  |AB|² > 0
    mun:square-positive x := |AB|
    requires |AB| ≠ 0: weakening, from 6

8.  cos(∠ABC) = 1/2
    mun:multiply-cancel a := cos(∠ABC), b := 1/2, c := |AB|², from 5
    requires ∠ABC ∈ ℝ: mun:triangle-angle-real P := A, Q := B, R := C, from H4
    requires cos(∠ABC) ∈ ℝ: mun:cos-real a := ∠ABC
    requires |AB|² ≠ 0: weakening, from 7

9.  cos(∠ABC) = cos(60°)
    substitute 1/2 = cos(60°) (real arithmetic) into line 8

10. ∠ABC = 60°
    mun:angle-by-cosine P := A, Q := B, R := C, x := 60°, from 1, 9
    requires 0 ≤ 60°: real arithmetic
    requires 60° ≤ 180°: real arithmetic
