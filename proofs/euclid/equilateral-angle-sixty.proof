import theorem            stdlib/geometry/isosceles-angles
import theorem            stdlib/geometry/angle-sum
import mundane theorem    stdlib/geometry/angle-symmetric
forbid theorem            stdlib/geometry/law-of-cosines
forbid theorem            stdlib/geometry/law-of-sines

theorem equilateral-angle-sixty
  note        Euclid I.5, corollary. The triangle is isosceles with apex C, so
              the angles at A and B agree, and isosceles with apex A, so the
              angles at B and C agree. The three equal angles add to 180°,
              so each is 60°.
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  assume A, B, C form a triangle                                      (H4)
  assume |AB| = |BC| = |CA|                                           (H5)
  then ∠ABC = 60°

1.  |CA| = |CB|
    restate H5

2.  ∠CAB = ∠CBA
    thm:isosceles-angles, from H4, 1

3.  |AB| = |AC|
    calculation
      |AB| = |BC|       H5
           = |CA|       H5

4.  ∠ABC = ∠ACB
    thm:isosceles-angles A := B, B := C, C := A, from H4, 3

5.  ∠BAC + ∠ABC + ∠BCA = 180°
    thm:angle-sum, from H4

6.  ∠BAC = ∠ABC
    calculation
      ∠BAC = ∠CAB       mun:angle-symmetric P := B, Q := A, R := C, from H4
           = ∠CBA       2
           = ∠ABC       mun:angle-symmetric P := C, Q := B, R := A, from H4

7.  ∠BCA = ∠ABC
    calculation
      ∠BCA = ∠ACB       mun:angle-symmetric P := B, Q := C, R := A, from H4
           = ∠ABC       4

8.  ∠ABC = 60°
    algebra, from 5, 6, 7
