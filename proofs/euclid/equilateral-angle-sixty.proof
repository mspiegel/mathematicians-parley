import theorem            stdlib/geometry/law-of-cosines
import mundane theorem    stdlib/geometry/angle-by-cosine
import axiom              stdlib/geometry/distance-positive
import definition         stdlib/trigonometry/cos
import mundane theorem    stdlib/numbers/multiply-cancel
import mundane theorem    stdlib/numbers/square-positive

theorem equilateral-angle-sixty
  note        Euclid I.5, corollary. The law of cosines at B with all three
              sides equal to s gives s² = 2s² − 2s²·cos ∠ABC, so the cosine
              is 1/2, which is the cosine of 60°, and the angle is read back
              from its cosine.
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  assume A, B, C form a triangle                                      (H4)
  assume |AB| = |BC| = |CA|                                           (H5)
  then ∠ABC = 60°

1.  |CA|² = |AB|² + |BC|² − 2·(|AB|·|BC|·cos(∠ABC))
    thm:law-of-cosines P := A, Q := B, R := C, from H4

2.  |AB|² = |AB|² + |AB|² − 2·(|AB|·|AB|·cos(∠ABC))
    substitute
      |CA|² = |AB|² + |BC|² − 2·(|AB|·|BC|·cos(∠ABC))      1
      |AB|² = |AB|² + |BC|² − 2·(|AB|·|BC|·cos(∠ABC))      substitute H5
      |AB|² = |AB|² + |AB|² − 2·(|AB|·|AB|·cos(∠ABC))      substitute H5

3.  cos(∠ABC)·|AB|² = (1/2)·|AB|²
    algebra, from 2

4.  |AB| > 0
    axi:distance-positive P := A, Q := B, from H4

5.  |AB|² > 0
    mun:square-positive x := |AB|
    requires |AB| ≠ 0: weakening, from 4

6.  cos(∠ABC) = 1/2
    mun:multiply-cancel a := cos(∠ABC), b := 1/2, c := |AB|², from 3
    requires |AB|² ≠ 0: weakening, from 5

7.  cos(∠ABC) = cos(60°)
    substitute 1/2 = cos(60°) (real arithmetic) into line 6

8.  ∠ABC = 60°
    mun:angle-by-cosine P := A, Q := B, R := C, x := 60°, from H4, 7
    requires 0 ≤ 60°: real arithmetic
    requires 60° ≤ 180°: real arithmetic
