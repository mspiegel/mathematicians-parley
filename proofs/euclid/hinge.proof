import theorem            stdlib/geometry/law-of-cosines
import mundane theorem    stdlib/geometry/angle-order-by-cosine
import mundane theorem    stdlib/geometry/angle-real
import mundane theorem    stdlib/geometry/angle-turned
import mundane theorem    stdlib/geometry/distance-nonneg
import axiom              stdlib/geometry/distance-positive
import mundane theorem    stdlib/geometry/triangle-angle-real
import definition         stdlib/trigonometry/cos
import mundane theorem    stdlib/trigonometry/cos-real
import mundane theorem    stdlib/numbers/product-positive
import mundane theorem    stdlib/numbers/square-less

theorem hinge
  note        Euclid I.24. The law of cosines at A and at D, with the two
              sides at each vertex equal, gives |BC|² − |EF|² =
              2·|CA|·|AB|·(cos ∠FDE − cos ∠CAB). The larger angle has the
              smaller cosine, so this is positive, and so is the difference
              of the lengths.
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  let D be a point                                                    (H4)
  let E be a point                                                    (H5)
  let F be a point                                                    (H6)
  assume A, B, C form a triangle                                      (H7)
  assume D, E, F form a triangle                                      (H8)
  assume |AB| = |DE|                                                  (H9)
  assume |AC| = |DF|                                                  (H10)
  assume ∠BAC > ∠EDF                                                  (H11)
  then |BC| > |EF|

1.  ∠CAB ∈ ℝ. ∠CAB ≥ 0.
    mun:angle-real P := C, Q := A, R := B, from H7

2.  ∠FDE ∈ ℝ. ∠FDE ≥ 0.
    mun:angle-real P := F, Q := D, R := E, from H8

3.  ∠CAB = ∠BAC
    mun:angle-turned P := C, Q := A, R := B, from H7

4.  ∠FDE = ∠EDF
    mun:angle-turned P := F, Q := D, R := E, from H8

5.  ∠FDE < ∠CAB
    transitivity, from 4, H11, 3
    requires ∠EDF ∈ ℝ: mun:triangle-angle-real P := D, Q := E, R := F, from H8
    requires ∠CAB ∈ ℝ: from 1

6.  cos(∠CAB) < cos(∠FDE)
    mun:angle-order-by-cosine P := F, Q := D, R := E, P′ := C, Q′ := A, R′ := B, from H7, H8, 5

7.  |BC|² = |CA|² + |AB|² − 2·(|CA|·|AB|·cos(∠CAB))
    thm:law-of-cosines P := C, Q := A, R := B, from H7

8.  |EF|² = |FD|² + |DE|² − 2·(|FD|·|DE|·cos(∠FDE))
    thm:law-of-cosines P := F, Q := D, R := E, from H8

9.  |EF|² = |CA|² + |AB|² − 2·(|CA|·|AB|·cos(∠FDE))
    substitute
      |EF|² = |FD|² + |DE|² − 2·(|FD|·|DE|·cos(∠FDE))      8
      |EF|² = |CA|² + |DE|² − 2·(|CA|·|DE|·cos(∠FDE))      substitute H10
      |EF|² = |CA|² + |AB|² − 2·(|CA|·|AB|·cos(∠FDE))      substitute H9

10. |CA| > 0
    axi:distance-positive P := C, Q := A, from H7

11. |AB| > 0
    axi:distance-positive P := A, Q := B, from H7

12. |CA|·|AB| > 0
    mun:product-positive x := |CA|, y := |AB|, from 10, 11

13. 0 < cos(∠FDE) − cos(∠CAB)
    inequalities
      cos(∠CAB) < cos(∠FDE)                  6
      0 < cos(∠FDE) − cos(∠CAB)              adding −cos(∠CAB)
    requires cos(∠CAB) ∈ ℝ: mun:cos-real a := ∠CAB, from 1
    requires cos(∠FDE) ∈ ℝ: mun:cos-real a := ∠FDE, from 2

14. |CA|·|AB|·(cos(∠FDE) − cos(∠CAB)) > 0
    mun:product-positive x := |CA|·|AB|, y := cos(∠FDE) − cos(∠CAB), from 12, 13
    requires cos(∠CAB) ∈ ℝ: mun:cos-real a := ∠CAB, from 1
    requires cos(∠FDE) ∈ ℝ: mun:cos-real a := ∠FDE, from 2

15. |BC|² − 2·(|CA|·|AB|·(cos(∠FDE) − cos(∠CAB))) < |BC|²
    inequalities
      |CA|·|AB|·(cos(∠FDE) − cos(∠CAB)) > 0              14
      0 < |CA|·|AB|·(cos(∠FDE) − cos(∠CAB))              restate
      0 < 2·(|CA|·|AB|·(cos(∠FDE) − cos(∠CAB)))          multiplying by 2
      |BC|² − 2·(|CA|·|AB|·(cos(∠FDE) − cos(∠CAB))) < |BC|²   adding |BC|² − 2·(|CA|·|AB|·(cos(∠FDE) − cos(∠CAB)))
    requires cos(∠CAB) ∈ ℝ: mun:cos-real a := ∠CAB, from 1
    requires cos(∠FDE) ∈ ℝ: mun:cos-real a := ∠FDE, from 2

16. |EF|² < |BC|²
    calculation
      |EF|² = |BC|² − 2·(|CA|·|AB|·(cos(∠FDE) − cos(∠CAB)))     algebra, from 7, 9
            < |BC|²                                              15
    requires cos(∠CAB) ∈ ℝ: mun:cos-real a := ∠CAB, from 1
    requires cos(∠FDE) ∈ ℝ: mun:cos-real a := ∠FDE, from 2

17. |BC| > |EF|
    mun:square-less x := |EF|, y := |BC|, from 16
    requires |EF| ≥ 0: mun:distance-nonneg P := E, Q := F
    requires |BC| ≥ 0: mun:distance-nonneg P := B, Q := C
