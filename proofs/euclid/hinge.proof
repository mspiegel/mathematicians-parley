import theorem            stdlib/geometry/law-of-cosines
import mundane theorem    stdlib/geometry/angle-order-by-cosine
import mundane theorem    stdlib/geometry/angle-turned
import mundane theorem    stdlib/geometry/distance-nonneg
import axiom              stdlib/geometry/distance-positive
import definition         stdlib/trigonometry/cos
import mundane theorem    stdlib/numbers/product-positive
import mundane theorem    stdlib/numbers/square-less

theorem hinge
  note        Euclid I.24. The law of cosines at A and at D, with the two
              sides at each vertex equal, gives |BC|² − |EF|² =
              2·|CA|·|AB|·(cos ∠FDE − cos ∠CAB). The larger angle has the
              smaller cosine, so this is positive, and so is the difference
              of the lengths.
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  let D be a point                                                    (H4)
  let E be a point                                                    (H5)
  let F be a point                                                    (H6)
  assume A, B, C form a triangle                                      (H7)
  assume D, E, F form a triangle                                      (H8)
  assume |AB| = |DE|                                                  (H9)
  assume |AC| = |DF|                                                  (H10)
  assume ∠BAC > ∠EDF                                                  (H11)
  then |BC| > |EF|

1.  ∠CAB = ∠BAC
    mun:angle-turned P := C, Q := A, R := B, from H7

2.  ∠FDE = ∠EDF
    mun:angle-turned P := F, Q := D, R := E, from H8

3.  ∠FDE < ∠CAB
    transitivity, from 2, H11, 1

4.  cos(∠CAB) < cos(∠FDE)
    mun:angle-order-by-cosine P := F, Q := D, R := E, P′ := C, Q′ := A, R′ := B, from H7, H8, 3

5.  |BC|² = |CA|² + |AB|² − 2·(|CA|·|AB|·cos(∠CAB))
    thm:law-of-cosines P := C, Q := A, R := B, from H7

6.  |EF|² = |FD|² + |DE|² − 2·(|FD|·|DE|·cos(∠FDE))
    thm:law-of-cosines P := F, Q := D, R := E, from H8

7.  |EF|² = |CA|² + |AB|² − 2·(|CA|·|AB|·cos(∠FDE))
    substitute
      |EF|² = |FD|² + |DE|² − 2·(|FD|·|DE|·cos(∠FDE))      6
      |EF|² = |CA|² + |DE|² − 2·(|CA|·|DE|·cos(∠FDE))      substitute H10
      |EF|² = |CA|² + |AB|² − 2·(|CA|·|AB|·cos(∠FDE))      substitute H9

8.  |CA| > 0
    axi:distance-positive P := C, Q := A, from H7

9.  |AB| > 0
    axi:distance-positive P := A, Q := B, from H7

10. |CA|·|AB| > 0
    mun:product-positive x := |CA|, y := |AB|, from 8, 9

11. 0 < cos(∠FDE) − cos(∠CAB)
    inequalities
      cos(∠CAB) < cos(∠FDE)                  4
      0 < cos(∠FDE) − cos(∠CAB)              adding −cos(∠CAB)

12. |CA|·|AB|·(cos(∠FDE) − cos(∠CAB)) > 0
    mun:product-positive x := |CA|·|AB|, y := cos(∠FDE) − cos(∠CAB), from 10, 11

13. |BC|² − 2·(|CA|·|AB|·(cos(∠FDE) − cos(∠CAB))) < |BC|²
    inequalities
      |CA|·|AB|·(cos(∠FDE) − cos(∠CAB)) > 0              12
      0 < |CA|·|AB|·(cos(∠FDE) − cos(∠CAB))              restate
      0 < 2·(|CA|·|AB|·(cos(∠FDE) − cos(∠CAB)))          multiplying by 2
      |BC|² − 2·(|CA|·|AB|·(cos(∠FDE) − cos(∠CAB))) < |BC|²   adding |BC|² − 2·(|CA|·|AB|·(cos(∠FDE) − cos(∠CAB)))

14. |EF|² < |BC|²
    calculation
      |EF|² = |BC|² − 2·(|CA|·|AB|·(cos(∠FDE) − cos(∠CAB)))     algebra, from 5, 7
            < |BC|²                                              13

15. |BC| > |EF|
    mun:square-less x := |EF|, y := |BC|, from 14
    requires |EF| ≥ 0: mun:distance-nonneg P := E, Q := F
    requires |BC| ≥ 0: mun:distance-nonneg P := B, Q := C
