import mundane theorem stdlib/geometry/distance-by-coordinates
forbid theorem stdlib/geometry/law-of-cosines
forbid theorem stdlib/geometry/law-of-sines

theorem distance-minus-four-one
  then |(−4, 1)(3, −4)| = √74

1.  |(−4, 1)(3, −4)| = √74
    calculation
      |(−4, 1)(3, −4)| = √((−4 − 3)² + (1 − (−4))²)     mun:distance-by-coordinates
                       = √74                            arithmetic
