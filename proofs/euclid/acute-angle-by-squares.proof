import theorem            stdlib/geometry/law-of-cosines
import mundane theorem    stdlib/geometry/angle-real
import mundane theorem    stdlib/geometry/angle-at-most-straight
import axiom              stdlib/geometry/distance-positive
import definition         stdlib/trigonometry/cos
import mundane theorem    stdlib/trigonometry/cos-real
import mundane theorem    stdlib/trigonometry/cos-decreasing
import definition         stdlib/calculus/interval
import mundane theorem    stdlib/numbers/product-positive
import mundane theorem    stdlib/numbers/less-scaled

theorem acute-angle-by-squares
  note        Euclid II.12 and II.13. The law of cosines at C writes |AB|²
              as |AC|² + |BC|² less 2·|AC|·|BC|·cos ∠ACB, so |AB|² falls
              short of |AC|² + |BC|² just when the cosine is positive, and on
              [0, π] the cosine is positive just when the angle is under 90°.
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  assume A, B, C form a triangle                                      (H4)
  then ∠ACB < 90° ↔ |AB|² < |AC|² + |BC|²

1.  |BA|² = |AC|² + |CB|² − 2·(|AC|·|CB|·cos(∠ACB))
    thm:law-of-cosines P := A, Q := C, R := B, from H4

2.  |AC| > 0
    axi:distance-positive P := A, Q := C, from H4

3.  |BC| > 0
    axi:distance-positive P := B, Q := C, from H4

4.  |AC|·|BC| > 0
    mun:product-positive x := |AC|, y := |BC|, from 2, 3

5.  ∠ACB ∈ ℝ. ∠ACB ≥ 0.
    mun:angle-real P := A, Q := C, R := B, from H4

6.  ∠ACB ≤ 180°
    mun:angle-at-most-straight P := A, Q := C, R := B, from H4

7.  ∠ACB ≤ π
    substitute 180° = π (real arithmetic) into line 6

8.  ∠ACB ∈ [0, π]
    def:interval x := ∠ACB, from 5, 7

9.  90° ∈ [0, π]
    def:interval x := 90°
    requires 0 ≤ 90°: real arithmetic
    requires 90° ≤ π: real arithmetic

10. ∠ACB < 90° ↔ |AB|² < |AC|² + |BC|²
    both directions

    direction
    assume ∠ACB < 90°                                                 (D1)

    10.1.  cos(90°) < cos(∠ACB)
           mun:cos-decreasing a := ∠ACB, b := 90°, from D1, 8, 9

    10.2.  0 < cos(∠ACB)
           substitute cos(90°) = 0 (real arithmetic) into line 10.1

    10.3.  0 < |AC|·|BC|·cos(∠ACB)
           mun:product-positive x := |AC|·|BC|, y := cos(∠ACB), from 4, 10.2
           requires cos(∠ACB) ∈ ℝ: mun:cos-real a := ∠ACB, from 5

    10.4.  |AC|² + |BC|² − 2·(|AC|·|BC|·cos(∠ACB)) < |AC|² + |BC|²
           inequalities
             0 < |AC|·|BC|·cos(∠ACB)                                 10.3
             0 < 2·(|AC|·|BC|·cos(∠ACB))                             multiplying by 2
             |AC|² + |BC|² − 2·(|AC|·|BC|·cos(∠ACB)) < |AC|² + |BC|²   adding |AC|² + |BC|² − 2·(|AC|·|BC|·cos(∠ACB))
           requires cos(∠ACB) ∈ ℝ: mun:cos-real a := ∠ACB, from 5

    10.5.  |AB|² < |AC|² + |BC|²
           calculation
             |AB|² = |AC|² + |BC|² − 2·(|AC|·|BC|·cos(∠ACB))        1
                   < |AC|² + |BC|²                                  10.4

    direction
    assume |AB|² < |AC|² + |BC|²                                      (D2)

    10.6.  |AC|² + |BC|² − 2·(|AC|·|BC|·cos(∠ACB)) < |AC|² + |BC|²
           calculation
             |AC|² + |BC|² − 2·(|AC|·|BC|·cos(∠ACB)) = |AB|²        1
                                                     < |AC|² + |BC|²  D2

    10.7.  |AC|·|BC|·0 < |AC|·|BC|·cos(∠ACB)
           inequalities
             |AC|² + |BC|² − 2·(|AC|·|BC|·cos(∠ACB)) < |AC|² + |BC|²   10.6
             −2·(|AC|·|BC|·cos(∠ACB)) < 0                           adding −(|AC|² + |BC|²)
             |AC|·|BC|·cos(∠ACB) > 0                                multiplying by −1/2
             0 < |AC|·|BC|·cos(∠ACB)                                restate
             |AC|·|BC|·0 < |AC|·|BC|·cos(∠ACB)                      algebra
           requires cos(∠ACB) ∈ ℝ: mun:cos-real a := ∠ACB, from 5

    10.8.  cos(90°) < cos(∠ACB)
           calculation
             cos(90°) = 0                 real arithmetic
                      < cos(∠ACB)         mun:less-scaled x := 0, y := cos(∠ACB), c := |AC|·|BC|, from 4, 10.7
           requires cos(∠ACB) ∈ ℝ: mun:cos-real a := ∠ACB, from 5

    10.9.  ∠ACB < 90°
           mun:cos-decreasing a := ∠ACB, b := 90°, from 8, 9, 10.8
