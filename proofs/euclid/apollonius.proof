import mundane theorem    stdlib/geometry/between-apart
import theorem            stdlib/geometry/law-of-cosines
import axiom              stdlib/geometry/supplementary-angles
import mundane theorem    stdlib/geometry/angle-real
import mundane theorem    stdlib/geometry/distance-zero
import mundane theorem    stdlib/trigonometry/cos-supplement
import mundane theorem    stdlib/trigonometry/cos-real
import definition         stdlib/trigonometry/cos
import axiom              stdlib/reasoning/excluded-middle

theorem apollonius
  note        The law of cosines at M in the triangles ABM and ACM. The
              angles at M are supplementary, so their cosines are opposite,
              and the terms in the cosines cancel when the two are added.
              Where A is M there are no angles at M, and |AM| = 0.
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  let M be a point                                                    (H4)
  assume M is between B and C                                         (H5)
  assume |BM| = |MC|                                                  (H6)
  then |AB|² + |AC|² = 2·|AM|² + 2·|BM|²

1.  A = M or A ≠ M
    axi:excluded-middle P := A = M

2.  |AB|² + |AC|² = 2·|AM|² + 2·|BM|²
    cases, from 1

    case
    assume A = M                                                      (C1)

    2.1.  |AM| = 0
          mun:distance-zero P := A, Q := M, from C1

    2.2.  |AB|² + |AC|² = |MB|² + |MC|²
          substitute A = M (C1)

    2.3.  |AB|² + |AC|² = |BM|² + |BM|²
          substitute |MC| = |BM| (H6) into line 2.2

    2.4.  |AB|² + |AC|² = 2·|AM|² + 2·|BM|²
          algebra, from 2.1, 2.3

    case
    assume A ≠ M                                                      (C2)

    2.5.  B ≠ M. C ≠ M.
          mun:between-apart R := M, S := B, T := C, from H5

    2.6.  |AB|² = |BM|² + |MA|² − 2·(|BM|·|MA|·cos(∠BMA))
          thm:law-of-cosines P := B, Q := M, R := A, from C2, 2.5

    2.7.  |CA|² = |AM|² + |MC|² − 2·(|AM|·|MC|·cos(∠AMC))
          thm:law-of-cosines P := A, Q := M, R := C, from C2, 2.5

    2.8.  ∠BMA + ∠AMC = 180°
          axi:supplementary-angles A := B, B := M, D := A, from C2, H5

    2.9.  ∠BMA ∈ ℝ
          mun:angle-real P := B, Q := M, R := A, from C2, 2.5

    2.10. ∠AMC ∈ ℝ
          mun:angle-real P := A, Q := M, R := C, from C2, 2.5

    2.11. ∠AMC = 180° − ∠BMA
          algebra, from 2.8
          requires ∠BMA ∈ ℝ: from 2.9
          requires ∠AMC ∈ ℝ: from 2.10

    2.12. cos(∠AMC) = −cos(∠BMA)
          calculation
            cos(∠AMC) = cos(180° − ∠BMA)      substitute line 2.11
                      = −cos(∠BMA)            mun:cos-supplement x := ∠BMA
          requires ∠BMA ∈ ℝ: from 2.9

    2.13. |AC|² = |AM|² + |BM|² − 2·(|AM|·|BM|·cos(∠AMC))
          substitute |MC| = |BM| (H6) into line 2.7

    2.14. |AC|² = |AM|² + |BM|² − 2·(|AM|·|BM|·−cos(∠BMA))
          substitute cos(∠AMC) = −cos(∠BMA) (line 2.12) into line 2.13

    2.15. |AB|² + |AC|² = 2·|AM|² + 2·|BM|²
          algebra, from 2.6, 2.14
          requires ∠BMA ∈ ℝ: from 2.9
          requires cos(∠BMA) ∈ ℝ: mun:cos-real a := ∠BMA
