import mundane theorem    stdlib/geometry/points-apart-by-coordinates
import mundane theorem    stdlib/geometry/distance-of-points-by-coordinates
import theorem            stdlib/geometry/law-of-cosines
import mundane theorem    stdlib/geometry/angle-real
import mundane theorem    stdlib/geometry/angle-turned
import mundane theorem    stdlib/geometry/angle-by-cosine
import definition         stdlib/trigonometry/cos
import mundane theorem    stdlib/trigonometry/cos-real

theorem equilateral-triangle-by-coordinates
  note        The sides are read off the coordinates and all come to 2. The
              law of cosines at A, with the sides 2, 2 and 2, leaves
              cos ∠CAB = 1/2, and 1/2 is the cosine of 60°.
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  assume A = (0, 0)                                                   (H4)
  assume B = (2, 0)                                                   (H5)
  assume C = (1, √3)                                                  (H6)
  then |AB| = 2. |BC| = 2. |CA| = 2. ∠BAC = 60°.

1.  (0, 0) ≠ (2, 0)
    arithmetic

2.  A ≠ B
    mun:points-apart-by-coordinates, from H4, H5, 1

3.  (0, 0) ≠ (1, √3)
    real arithmetic

4.  A ≠ C
    mun:points-apart-by-coordinates, from H4, H6, 3

5.  |AB| = 2
    calculation
      |AB| = √((0 − 2)² + (0 − 0)²)     mun:distance-of-points-by-coordinates, from H4, H5
           = √4                         arithmetic
           = 2                          real arithmetic

6.  |BC| = 2
    calculation
      |BC| = √((2 − 1)² + (0 − √3)²)    mun:distance-of-points-by-coordinates, from H5, H6
           = √4                         real arithmetic
           = 2                          real arithmetic

7.  |CA| = 2
    calculation
      |CA| = √((1 − 0)² + (√3 − 0)²)    mun:distance-of-points-by-coordinates, from H4, H6
           = √4                         real arithmetic
           = 2                          real arithmetic

8.  |BC|² = |CA|² + |AB|² − 2·(|CA|·|AB|·cos(∠CAB))
    thm:law-of-cosines, from 2, 4

9.  2² = 2² + 2² − 2·(2·2·cos(∠CAB))
    substitute
      |BC|² = |CA|² + |AB|² − 2·(|CA|·|AB|·cos(∠CAB))      8
      2² = |CA|² + |AB|² − 2·(|CA|·|AB|·cos(∠CAB))         substitute line 6
      2² = 2² + |AB|² − 2·(2·|AB|·cos(∠CAB))               substitute line 7
      2² = 2² + 2² − 2·(2·2·cos(∠CAB))                     substitute line 5

10. cos(∠CAB) = 1/2
    algebra, from 9
    requires (1, √3) ≠ (2, 0): real arithmetic
    requires C ≠ B: mun:points-apart-by-coordinates A := C, from H5, H6
    requires ∠CAB ∈ ℝ: mun:angle-real, from 2, 4
    requires cos(∠CAB) ∈ ℝ: mun:cos-real a := ∠CAB

11. cos(∠BAC) = 1/2
    substitute
      cos(∠CAB) = 1/2      10
      cos(∠BAC) = 1/2      mun:angle-turned, from 2, 4

12. cos(∠BAC) = cos(60°)
    calculation
      cos(∠BAC) = 1/2         11
                = cos(60°)    real arithmetic

13. ∠BAC = 60°
    mun:angle-by-cosine x := 60°, from 2, 4, 12
    requires 0 ≤ 60°: real arithmetic
    requires 60° ≤ 180°: real arithmetic

14. |AB| = 2. |BC| = 2. |CA| = 2. ∠BAC = 60°.
    join 5, 6, 7, 13
