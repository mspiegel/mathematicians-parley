import mundane theorem    stdlib/geometry/distance-of-points-by-coordinates
import theorem            proofs/euclid/equilateral-angle-sixty/equilateral-angle-sixty
forbid theorem            stdlib/geometry/law-of-cosines
forbid theorem            stdlib/geometry/law-of-sines

theorem equilateral-triangle-by-coordinates
  note        The sides are read off the coordinates and all come to 2. So
              the triangle is equilateral, and each of its angles is 60°.
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  assume A = (0, 0)                                                   (H4)
  assume B = (2, 0)                                                   (H5)
  assume C = (1, √3)                                                  (H6)
  assume B, A, C form a triangle                                      (H7)
  then |AB| = 2. |BC| = 2. |CA| = 2. ∠BAC = 60°.

1.  |AB| = 2
    calculation
      |AB| = √((0 − 2)² + (0 − 0)²)     mun:distance-of-points-by-coordinates, from H4, H5
           = √4                         arithmetic
           = 2                          real arithmetic

2.  |BC| = 2
    calculation
      |BC| = √((2 − 1)² + (0 − √3)²)    mun:distance-of-points-by-coordinates, from H5, H6
           = √4                         real arithmetic
           = 2                          real arithmetic

3.  |CA| = 2
    calculation
      |CA| = √((1 − 0)² + (√3 − 0)²)    mun:distance-of-points-by-coordinates, from H4, H6
           = √4                         real arithmetic
           = 2                          real arithmetic

4.  |BA| = |AC|
    calculation
      |BA| = 2          1
           = |AC|       3

5.  |AC| = |CB|
    calculation
      |AC| = 2          3
           = |CB|       2

6.  ∠BAC = 60°
    thm:equilateral-angle-sixty A := B, B := A, from H7, 4, 5

7.  |AB| = 2. |BC| = 2. |CA| = 2. ∠BAC = 60°.
    join 1, 2, 3, 6
