import mundane theorem    stdlib/geometry/points-apart-by-coordinates
import mundane theorem    stdlib/geometry/distance-by-coordinates
import theorem            stdlib/geometry/law-of-cosines
import mundane theorem    stdlib/geometry/angle-real
import mundane theorem    stdlib/geometry/angle-turned
import mundane theorem    stdlib/geometry/angle-by-cosine
import mundane definition stdlib/trigonometry/cos
import mundane theorem    stdlib/trigonometry/cos-real

theorem equilateral-triangle-by-coordinates
  note        The sides are read off the coordinates and all come to 2. The
              law of cosines at A, with the sides 2, 2 and 2, leaves
              cos ∠CAB = 1/2, and 1/2 is the cosine of 60°.
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  assume A = (0, 0)                                                   (H4)
  assume B = (2, 0)                                                   (H5)
  assume C = (1, √3)                                                  (H6)
  then |AB| = 2. |BC| = 2. |CA| = 2. ∠BAC = 60°.

1.  (0, 0) ≠ (2, 0)
    arithmetic

2.  A ≠ B
    mun:points-apart-by-coordinates, from H4, H5, 1

3.  (0, 0) ≠ (1, √3)
    real arithmetic

4.  A ≠ C
    mun:points-apart-by-coordinates, from H4, H6, 3

5.  |(0, 0)(2, 0)| = √((0 − 2)² + (0 − 0)²)
    mun:distance-by-coordinates

6.  |A(2, 0)| = √((0 − 2)² + (0 − 0)²)
    substitute A = (0, 0) (H4) into line 5

7.  |AB| = √((0 − 2)² + (0 − 0)²)
    substitute B = (2, 0) (H5) into line 6

8.  |AB| = 2
    calculation
      |AB| = √((0 − 2)² + (0 − 0)²)     7
           = √4                         arithmetic
           = 2                          real arithmetic

9.  |(2, 0)(1, √3)| = √((2 − 1)² + (0 − √3)²)
    mun:distance-by-coordinates

10. |B(1, √3)| = √((2 − 1)² + (0 − √3)²)
    substitute B = (2, 0) (H5) into line 9

11. |BC| = √((2 − 1)² + (0 − √3)²)
    substitute C = (1, √3) (H6) into line 10

12. |BC| = 2
    calculation
      |BC| = √((2 − 1)² + (0 − √3)²)    11
           = √4                         real arithmetic
           = 2                          real arithmetic

13. |(1, √3)(0, 0)| = √((1 − 0)² + (√3 − 0)²)
    mun:distance-by-coordinates

14. |C(0, 0)| = √((1 − 0)² + (√3 − 0)²)
    substitute C = (1, √3) (H6) into line 13

15. |CA| = √((1 − 0)² + (√3 − 0)²)
    substitute A = (0, 0) (H4) into line 14

16. |CA| = 2
    calculation
      |CA| = √((1 − 0)² + (√3 − 0)²)    15
           = √4                         real arithmetic
           = 2                          real arithmetic

17. |BC|² = |CA|² + |AB|² − 2·(|CA|·|AB|·cos(∠CAB))
    thm:law-of-cosines, from 2, 4

18. 2² = |CA|² + |AB|² − 2·(|CA|·|AB|·cos(∠CAB))
    substitute |BC| = 2 (line 12) into line 17

19. 2² = 2² + |AB|² − 2·(2·|AB|·cos(∠CAB))
    substitute |CA| = 2 (line 16) into line 18

20. 2² = 2² + 2² − 2·(2·2·cos(∠CAB))
    substitute |AB| = 2 (line 8) into line 19

21. cos(∠CAB) = 1/2
    algebra, from 20
    requires ∠CAB ∈ ℝ: mun:angle-real, from 2, 4
    requires cos(∠CAB) ∈ ℝ: mun:cos-real a := ∠CAB

22. ∠BAC = ∠CAB
    mun:angle-turned, from 2, 4

23. cos(∠BAC) = 1/2
    substitute ∠CAB = ∠BAC (line 22) into line 21

24. cos(∠BAC) = cos(60°)
    calculation
      cos(∠BAC) = 1/2         23
                = cos(60°)    real arithmetic

25. ∠BAC = 60°
    mun:angle-by-cosine x := 60°, from 2, 4, 24
    requires 0 ≤ 60°: real arithmetic
    requires 60° ≤ 180°: real arithmetic

26. |AB| = 2. |BC| = 2. |CA| = 2. ∠BAC = 60°.
    join 8, 12, 16, 25
