import mundane theorem    stdlib/geometry/points-apart-by-coordinates
import mundane theorem    stdlib/geometry/collinear-by-coordinates
import mundane theorem    stdlib/geometry/distance-of-points-by-coordinates
import mundane theorem    stdlib/reasoning/iff-not-from-right
import definition         stdlib/geometry/triangle
import theorem            proofs/euclid/converse-of-pythagoras/converse-of-pythagoras
forbid theorem            stdlib/geometry/law-of-cosines
forbid theorem            stdlib/geometry/law-of-sines

theorem right-triangle-three-four-five
  note        The sides are read off the coordinates. The triangle is a
              triangle because its vertices are apart and the cross product of
              AB and AC is not 0. The sides are 3, 4 and 5, and 3² + 4² = 5²,
              so the converse of Pythagoras makes the angle at A a right
              angle.
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  assume A = (0, 0)                                                   (H4)
  assume B = (3, 0)                                                   (H5)
  assume C = (0, 4)                                                   (H6)
  then A, B, C form a triangle. ∠BAC = 90°. |BC| = 5.

1.  (0, 0) ≠ (3, 0)
    arithmetic

2.  A ≠ B
    mun:points-apart-by-coordinates, from H4, H5, 1

3.  (0, 0) ≠ (0, 4)
    arithmetic

4.  A ≠ C
    mun:points-apart-by-coordinates, from H4, H6, 3

5.  (3, 0) ≠ (0, 4)
    arithmetic

6.  B ≠ C
    mun:points-apart-by-coordinates, from H5, H6, 5

7.  (0, 0), (3, 0), (0, 4) are collinear ↔ (3 − 0)·(4 − 0) = (0 − 0)·(0 − 0)
    mun:collinear-by-coordinates

8.  A, B, C are collinear ↔ (3 − 0)·(4 − 0) = (0 − 0)·(0 − 0)
    substitute
      (0, 0), (3, 0), (0, 4) are collinear ↔ (3 − 0)·(4 − 0) = (0 − 0)·(0 − 0)      7
      A, (3, 0), (0, 4) are collinear ↔ (3 − 0)·(4 − 0) = (0 − 0)·(0 − 0)           substitute H4
      A, B, (0, 4) are collinear ↔ (3 − 0)·(4 − 0) = (0 − 0)·(0 − 0)                substitute H5
      A, B, C are collinear ↔ (3 − 0)·(4 − 0) = (0 − 0)·(0 − 0)                     substitute H6

9.  (3 − 0)·(4 − 0) ≠ (0 − 0)·(0 − 0)
    arithmetic

10. not (A, B, C are collinear)
    mun:iff-not-from-right, from 8, 9

11. A, B, C form a triangle
    def:triangle, from 2, 4, 6, 10

12. |BA| = 3
    calculation
      |BA| = √((3 − 0)² + (0 − 0)²)     mun:distance-of-points-by-coordinates, from H4, H5
           = √9                         arithmetic
           = 3                          real arithmetic

13. |AC| = 4
    calculation
      |AC| = √((0 − 0)² + (0 − 4)²)     mun:distance-of-points-by-coordinates, from H4, H6
           = √16                        arithmetic
           = 4                          real arithmetic

14. |BC| = 5
    calculation
      |BC| = √((3 − 0)² + (0 − 4)²)     mun:distance-of-points-by-coordinates, from H5, H6
           = √25                        arithmetic
           = 5                          real arithmetic

15. |BC|² = |BA|² + |CA|²
    calculation
      |BC|² = 5²                substitute line 14
            = 3² + 4²           arithmetic
            = |BA|² + 4²        substitute line 12
            = |BA|² + |CA|²     substitute line 13

16. ∠BAC = 90°
    thm:converse-of-pythagoras A := B, B := C, C := A, from 11, 15

17. A, B, C form a triangle. ∠BAC = 90°. |BC| = 5.
    join 11, 16, 14
