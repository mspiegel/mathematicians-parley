import mundane theorem    stdlib/geometry/points-apart-by-coordinates
import mundane theorem    stdlib/geometry/collinear-by-coordinates
import mundane theorem    stdlib/geometry/distance-by-coordinates
import mundane theorem    stdlib/reasoning/iff-not-from-right
import mundane definition stdlib/geometry/triangle
import mundane theorem    stdlib/geometry/distance-symmetric
import theorem            stdlib/geometry/law-of-cosines
import mundane theorem    stdlib/geometry/triangle-angle-real
import mundane theorem    stdlib/geometry/right-angle-by-cosine
import mundane definition stdlib/trigonometry/cos
import mundane theorem    stdlib/trigonometry/cos-real

theorem right-triangle-three-four-five
  note        The sides are read off the coordinates. The triangle is a
              triangle because its vertices are apart and the cross product of
              AB and AC is not 0. The law of cosines at A, with the sides 3, 4
              and 5, leaves cos ∠BAC = 0, which is a right angle.
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  assume A = (0, 0)                                                   (H4)
  assume B = (3, 0)                                                   (H5)
  assume C = (0, 4)                                                   (H6)
  then A, B, C form a triangle. ∠BAC = 90°. |BC| = 5.

1.  (0, 0) ≠ (3, 0)
    arithmetic

2.  A ≠ B
    mun:points-apart-by-coordinates, from H4, H5, 1

3.  (0, 0) ≠ (0, 4)
    arithmetic

4.  A ≠ C
    mun:points-apart-by-coordinates, from H4, H6, 3

5.  (3, 0) ≠ (0, 4)
    arithmetic

6.  B ≠ C
    mun:points-apart-by-coordinates, from H5, H6, 5

7.  (0, 0), (3, 0), (0, 4) are collinear ↔ (3 − 0)·(4 − 0) = (0 − 0)·(0 − 0)
    mun:collinear-by-coordinates

8.  A, (3, 0), (0, 4) are collinear ↔ (3 − 0)·(4 − 0) = (0 − 0)·(0 − 0)
    substitute A = (0, 0) (H4) into line 7

9.  A, B, (0, 4) are collinear ↔ (3 − 0)·(4 − 0) = (0 − 0)·(0 − 0)
    substitute B = (3, 0) (H5) into line 8

10. A, B, C are collinear ↔ (3 − 0)·(4 − 0) = (0 − 0)·(0 − 0)
    substitute C = (0, 4) (H6) into line 9

11. (3 − 0)·(4 − 0) ≠ (0 − 0)·(0 − 0)
    arithmetic

12. not (A, B, C are collinear)
    mun:iff-not-from-right, from 10, 11

13. A, B, C form a triangle
    mun:triangle, from 2, 4, 6, 12

14. |(3, 0)(0, 0)| = √((3 − 0)² + (0 − 0)²)
    mun:distance-by-coordinates

15. |B(0, 0)| = √((3 − 0)² + (0 − 0)²)
    substitute B = (3, 0) (H5) into line 14

16. |BA| = √((3 − 0)² + (0 − 0)²)
    substitute A = (0, 0) (H4) into line 15

17. |BA| = 3
    calculation
      |BA| = √((3 − 0)² + (0 − 0)²)     16
           = √9                         arithmetic
           = 3                          real arithmetic

18. |(0, 0)(0, 4)| = √((0 − 0)² + (0 − 4)²)
    mun:distance-by-coordinates

19. |A(0, 4)| = √((0 − 0)² + (0 − 4)²)
    substitute A = (0, 0) (H4) into line 18

20. |AC| = √((0 − 0)² + (0 − 4)²)
    substitute C = (0, 4) (H6) into line 19

21. |AC| = 4
    calculation
      |AC| = √((0 − 0)² + (0 − 4)²)     20
           = √16                        arithmetic
           = 4                          real arithmetic

22. |(3, 0)(0, 4)| = √((3 − 0)² + (0 − 4)²)
    mun:distance-by-coordinates

23. |B(0, 4)| = √((3 − 0)² + (0 − 4)²)
    substitute B = (3, 0) (H5) into line 22

24. |BC| = √((3 − 0)² + (0 − 4)²)
    substitute C = (0, 4) (H6) into line 23

25. |BC| = 5
    calculation
      |BC| = √((3 − 0)² + (0 − 4)²)     24
           = √25                        arithmetic
           = 5                          real arithmetic

26. |CB|² = |BA|² + |AC|² − 2·(|BA|·|AC|·cos(∠BAC))
    thm:law-of-cosines, from 2, 4

27. |CB| = |BC|
    mun:distance-symmetric

28. |BC|² = |BA|² + |AC|² − 2·(|BA|·|AC|·cos(∠BAC))
    substitute |CB| = |BC| (line 27) into line 26

29. 5² = |BA|² + |AC|² − 2·(|BA|·|AC|·cos(∠BAC))
    substitute |BC| = 5 (line 25) into line 28

30. 5² = 3² + |AC|² − 2·(3·|AC|·cos(∠BAC))
    substitute |BA| = 3 (line 17) into line 29

31. 5² = 3² + 4² − 2·(3·4·cos(∠BAC))
    substitute |AC| = 4 (line 21) into line 30

32. cos(∠BAC) = 0
    algebra, from 31
    requires ∠BAC ∈ ℝ: mun:triangle-angle-real, from 13
    requires cos(∠BAC) ∈ ℝ: mun:cos-real a := ∠BAC

33. ∠BAC = 90°
    mun:right-angle-by-cosine, from 2, 4, 32

34. A, B, C form a triangle. ∠BAC = 90°. |BC| = 5.
    join 13, 33, 25
