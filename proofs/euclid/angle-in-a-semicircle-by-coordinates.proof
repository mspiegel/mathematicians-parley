import mundane theorem    stdlib/geometry/distance-of-points-by-coordinates
import theorem            proofs/euclid/converse-of-pythagoras/converse-of-pythagoras
forbid theorem            stdlib/geometry/law-of-cosines
forbid theorem            stdlib/geometry/law-of-sines

theorem angle-in-a-semicircle-by-coordinates
  note        C is at distance 5 from the centre O of the circle through A and
              B. The sides of the triangle are √80, √20 and 10, and
              80 + 20 = 10², so the converse of Pythagoras makes the angle at
              C a right angle.
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  let O be a point                                                    (H4)
  assume A = (−5, 0)                                                  (H5)
  assume B = (5, 0)                                                   (H6)
  assume C = (3, 4)                                                   (H7)
  assume O = (0, 0)                                                   (H8)
  assume A, C, B form a triangle                                      (H9)
  then |OC| = 5. ∠ACB = 90°.

1.  |OC| = 5
    calculation
      |OC| = √((0 − 3)² + (0 − 4)²)     mun:distance-of-points-by-coordinates, from H7, H8
           = √25                        arithmetic
           = 5                          real arithmetic

2.  |AC| = √80
    calculation
      |AC| = √((−5 − 3)² + (0 − 4)²)     mun:distance-of-points-by-coordinates, from H5, H7
           = √80                         arithmetic

3.  |CB| = √20
    calculation
      |CB| = √((3 − 5)² + (4 − 0)²)      mun:distance-of-points-by-coordinates, from H6, H7
           = √20                         arithmetic

4.  |BA| = 10
    calculation
      |BA| = √((5 − (−5))² + (0 − 0)²)   mun:distance-of-points-by-coordinates, from H5, H6
           = √100                        arithmetic
           = 10                          real arithmetic

5.  |AB|² = |AC|² + |BC|²
    calculation
      |AB|² = 10²                  substitute line 4
            = 80 + 20              arithmetic
            = (√80)² + (√20)²      real arithmetic
            = |AC|² + (√20)²       substitute line 2
            = |AC|² + |BC|²        substitute line 3

6.  ∠ACB = 90°
    thm:converse-of-pythagoras, from H9, 5

7.  |OC| = 5. ∠ACB = 90°.
    join 1, 6
