import mundane theorem    stdlib/geometry/points-apart-by-coordinates
import mundane theorem    stdlib/geometry/distance-of-points-by-coordinates
import theorem            stdlib/geometry/law-of-cosines
import mundane theorem    stdlib/geometry/angle-real
import mundane theorem    stdlib/geometry/right-angle-by-cosine
import mundane definition stdlib/trigonometry/cos
import mundane theorem    stdlib/trigonometry/cos-real

theorem angle-in-a-semicircle-by-coordinates
  note        C is at distance 5 from the centre O of the circle through A and
              B. The law of cosines at C, with the sides √80, √20 and 10,
              leaves cos ∠ACB = 0, which is a right angle.
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  let O be a point                                                    (H4)
  assume A = (−5, 0)                                                  (H5)
  assume B = (5, 0)                                                   (H6)
  assume C = (3, 4)                                                   (H7)
  assume O = (0, 0)                                                   (H8)
  then |OC| = 5. ∠ACB = 90°.

1.  (−5, 0) ≠ (3, 4)
    arithmetic

2.  A ≠ C
    mun:points-apart-by-coordinates, from H5, H7, 1

3.  (5, 0) ≠ (3, 4)
    arithmetic

4.  B ≠ C
    mun:points-apart-by-coordinates, from H6, H7, 3

5.  |OC| = √((0 − 3)² + (0 − 4)²)
    mun:distance-of-points-by-coordinates, from H7, H8

6.  |OC| = 5
    calculation
      |OC| = √((0 − 3)² + (0 − 4)²)     5
           = √25                        arithmetic
           = 5                          real arithmetic

7.  |AC| = √((−5 − 3)² + (0 − 4)²)
    mun:distance-of-points-by-coordinates, from H5, H7

8.  |AC| = √80
    calculation
      |AC| = √((−5 − 3)² + (0 − 4)²)     7
           = √80                         arithmetic

9.  |CB| = √((3 − 5)² + (4 − 0)²)
    mun:distance-of-points-by-coordinates, from H6, H7

10. |CB| = √20
    calculation
      |CB| = √((3 − 5)² + (4 − 0)²)      9
           = √20                         arithmetic

11. |BA| = √((5 − (−5))² + (0 − 0)²)
    mun:distance-of-points-by-coordinates, from H5, H6

12. |BA| = 10
    calculation
      |BA| = √((5 − (−5))² + (0 − 0)²)   11
           = √100                        arithmetic
           = 10                          real arithmetic

13. |BA|² = |AC|² + |CB|² − 2·(|AC|·|CB|·cos(∠ACB))
    thm:law-of-cosines, from 2, 4

14. 10² = |AC|² + |CB|² − 2·(|AC|·|CB|·cos(∠ACB))
    substitute |BA| = 10 (line 12) into line 13

15. 10² = (√80)² + |CB|² − 2·(√80·|CB|·cos(∠ACB))
    substitute |AC| = √80 (line 8) into line 14

16. 10² = (√80)² + (√20)² − 2·(√80·√20·cos(∠ACB))
    substitute |CB| = √20 (line 10) into line 15

17. 10² = 80 + (√20)² − 2·(√80·√20·cos(∠ACB))
    substitute (√80)² = 80 (real arithmetic) into line 16

18. 10² = 80 + 20 − 2·(√80·√20·cos(∠ACB))
    substitute (√20)² = 20 (real arithmetic) into line 17

19. 10² = 80 + 20 − 2·(40·cos(∠ACB))
    substitute √80·√20 = 40 (real arithmetic) into line 18

20. cos(∠ACB) = 0
    algebra, from 19
    requires ∠ACB ∈ ℝ: mun:angle-real, from 2, 4
    requires cos(∠ACB) ∈ ℝ: mun:cos-real a := ∠ACB

21. ∠ACB = 90°
    mun:right-angle-by-cosine, from 2, 4, 20

22. |OC| = 5. ∠ACB = 90°.
    join 6, 21
