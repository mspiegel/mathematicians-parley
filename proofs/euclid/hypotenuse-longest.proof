import theorem            proofs/wiedijk/pythagoras/pythagoras
import mundane theorem    stdlib/geometry/distance-nonneg
import axiom              stdlib/geometry/distance-positive
import mundane theorem    stdlib/numbers/square-positive
import mundane theorem    stdlib/numbers/square-less

theorem hypotenuse-longest
  note        Pythagoras gives |AB|² = |AC|² + |BC|², and |BC|² is
              positive, so |AC|² < |AB|² and the lengths compare the same
              way.
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  assume A, B, C form a triangle                                      (H4)
  assume ∠ACB = 90°                                                   (H5)
  then |AC| < |AB|

1.  |BC| > 0
    axi:distance-positive P := B, Q := C, from H4

2.  |BC|² > 0
    mun:square-positive x := |BC|
    requires |BC| ≠ 0: weakening, from 1

3.  |AC|² < |AC|² + |BC|²
    inequalities
      |BC|² > 0                    2
      0 < |BC|²                    restate
      |AC|² < |AC|² + |BC|²        adding |AC|²

4.  |AC|² < |AB|²
    calculation
      |AC|² < |AC|² + |BC|²        3
            = |AB|²                thm:pythagoras, from H4, H5

5.  |AC| < |AB|
    mun:square-less x := |AC|, y := |AB|, from 4
    requires |AC| ≥ 0: mun:distance-nonneg P := A, Q := C
    requires |AB| ≥ 0: mun:distance-nonneg P := A, Q := B
