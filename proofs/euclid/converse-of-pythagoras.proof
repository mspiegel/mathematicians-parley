import axiom              stdlib/geometry/angle-construction
import mundane theorem    stdlib/geometry/ray-point
import mundane theorem    stdlib/geometry/same-side-off-line
import mundane theorem    stdlib/geometry/triangle-off-line
import mundane theorem    stdlib/geometry/angle-same-ray
import mundane theorem    stdlib/geometry/angle-turned
import axiom              stdlib/geometry/distance-positive
import mundane theorem    stdlib/geometry/distance-nonneg
import theorem            stdlib/geometry/pythagoras
import theorem            stdlib/geometry/side-side-side
import definition         stdlib/geometry/congruent
import mundane theorem    stdlib/numbers/square-equal
forbid theorem            stdlib/geometry/law-of-cosines
forbid theorem            stdlib/geometry/law-of-sines

theorem converse-of-pythagoras
  note        Euclid I.48. Draw from C the line at right angles to CB, and
              mark D on it with |CD| = |CA|. Pythagoras in the right
              triangle DCB gives |DB|² = |CA|² + |CB|², which is |AB|², so
              |DB| = |AB|. The triangles ACB and DCB then have their three
              sides equal, and so the angle at C is the right angle ∠DCB.
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  assume A, B, C form a triangle                                      (H4)
  assume |AB|² = |AC|² + |BC|²                                        (H5)
  then ∠ACB = 90°

1.  E ∈ 𝔼². E and A are on the same side of line CB. ∠BCE = 90°.
    obtain E: axi:angle-construction A := C, C := A, x := 90°, from H4
    requires 90° > 0°: real arithmetic
    requires 90° < 180°: real arithmetic

2.  not (E is on line CB)
    mun:same-side-off-line A := C, P := E, Q := A, from 1

3.  E, C, B form a triangle.
    mun:triangle-off-line P := E, Q := C, R := B, from H4, 2

4.  |CA| > 0
    axi:distance-positive P := C, Q := A, from H4

5.  D ∈ 𝔼². D is on line CE. D and E are on the same side of line CB.
    |CD| = |CA|.
    obtain D: mun:ray-point A := C, B := E, C := B, r := |CA|, from 3, 4

6.  not (D is on line CB)
    mun:same-side-off-line A := C, P := D, Q := E, from 5

7.  D, C, B form a triangle.
    mun:triangle-off-line P := D, Q := C, R := B, from H4, 6

8.  ∠DCB = 90°
    calculation
      ∠DCB = ∠BCD       mun:angle-turned P := D, Q := C, R := B, from 7
           = ∠BCE       mun:angle-same-ray R := B, P := C, Q := E, X := D, from 5
           = 90°        1

9.  |DB|² = |DC|² + |BC|²
    thm:pythagoras A := D, from 7, 8

10. |DB|² = |AB|²
    algebra, from H5, 5, 9

11. |DB| = |AB|
    mun:square-equal x := |DB|, y := |AB|, from 10
    requires |DB| ≥ 0: mun:distance-nonneg P := D, Q := B
    requires |AB| ≥ 0: mun:distance-nonneg P := A, Q := B

12. triangle ACB ≅ triangle DCB
    thm:side-side-side B := C, C := B, E := C, F := B,
      from H4, 5, 7, 11

13. ∠ACB = ∠DCB
    def:congruent P := A, Q := C, R := B, P′ := D, Q′ := C, R′ := B,
      from H4, 7, 12

14. ∠ACB = 90°
    transitivity, from 13, 8
