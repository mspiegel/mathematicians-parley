import theorem            stdlib/geometry/law-of-cosines
import mundane theorem    stdlib/geometry/right-angle-by-cosine
import mundane theorem    stdlib/geometry/distance-positive
import mundane theorem    stdlib/geometry/distance-symmetric
import mundane theorem    stdlib/geometry/triangle-angle-real
import mundane definition stdlib/geometry/triangle
import mundane definition stdlib/trigonometry/cos
import mundane theorem    stdlib/trigonometry/cos-real
import mundane theorem    stdlib/numbers/multiply-cancel
import mundane theorem    stdlib/numbers/product-positive

theorem converse-of-pythagoras
  note        Euclid I.48. The law of cosines at C gives |AB|² =
              |AC|² + |BC|² − 2·|AC|·|BC|·cos ∠ACB. The hypothesis says the
              last term is 0, and the two sides are not, so the cosine is 0,
              and an angle whose cosine is 0 is a right angle.
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  assume A, B, C form a triangle                                      (H4)
  assume |AB|² = |AC|² + |BC|²                                        (H5)
  then ∠ACB = 90°

1.  A ≠ C. B ≠ C.
    mun:triangle, from H4

2.  |BA|² = |AC|² + |CB|² − 2·(|AC|·|CB|·cos(∠ACB))
    thm:law-of-cosines P := A, Q := C, R := B, from 1

3.  |BA| = |AB|
    mun:distance-symmetric P := B, Q := A

4.  |CB| = |BC|
    mun:distance-symmetric P := C, Q := B

5.  |AB|² = |AC|² + |CB|² − 2·(|AC|·|CB|·cos(∠ACB))
    substitute |BA| = |AB| (line 3) into line 2

6.  |AB|² = |AC|² + |BC|² − 2·(|AC|·|BC|·cos(∠ACB))
    substitute |CB| = |BC| (line 4) into line 5

7.  |AC|² + |BC|² = |AC|² + |BC|² − 2·(|AC|·|BC|·cos(∠ACB))
    substitute |AB|² = |AC|² + |BC|² (H5) into line 6

8.  cos(∠ACB)·(|AC|·|BC|) = 0·(|AC|·|BC|)
    algebra, from 7
    requires ∠ACB ∈ ℝ: mun:triangle-angle-real P := A, Q := C, R := B, from H4
    requires cos(∠ACB) ∈ ℝ: mun:cos-real a := ∠ACB

9.  |AC| > 0
    mun:distance-positive P := A, Q := C, from 1

10. |BC| > 0
    mun:distance-positive P := B, Q := C, from 1

11. |AC|·|BC| > 0
    mun:product-positive x := |AC|, y := |BC|, from 9, 10

12. cos(∠ACB) = 0
    mun:multiply-cancel a := cos(∠ACB), b := 0, c := |AC|·|BC|, from 8
    requires ∠ACB ∈ ℝ: mun:triangle-angle-real P := A, Q := C, R := B, from H4
    requires cos(∠ACB) ∈ ℝ: mun:cos-real a := ∠ACB
    requires |AC|·|BC| ≠ 0: weakening, from 11

13. ∠ACB = 90°
    mun:right-angle-by-cosine P := A, Q := C, R := B, from 1, 12
