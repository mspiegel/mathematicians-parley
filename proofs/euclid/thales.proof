import theorem            proofs/euclid/apollonius/apollonius
import mundane theorem    stdlib/geometry/segment-addition
import theorem            stdlib/geometry/law-of-cosines
import mundane theorem    stdlib/geometry/right-angle-by-cosine
import mundane theorem    stdlib/geometry/angle-real
import axiom              stdlib/geometry/distance-positive
import mundane theorem    stdlib/numbers/product-positive
import mundane theorem    stdlib/numbers/multiply-cancel
import mundane theorem    stdlib/trigonometry/cos-real
import definition         stdlib/trigonometry/cos

theorem thales
  note        M is half way along AB and as far from C as from A and B. The
              median CM of triangle CAB then gives |CA|² + |CB|² = |AB|²
              (Apollonius), and the law of cosines at C turns that into
              cos(∠ACB) = 0.
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  let M be a point                                                    (H4)
  assume A, B, C form a triangle                                      (H5)
  assume M is between A and B                                         (H6)
  assume |MA| = |MC| = |MB|                                           (H7)
  then ∠ACB = 90°

1.  |AM| = |MB|
    calculation
      |AM| = |MC|      H7
           = |MB|      H7

2.  |CA|² + |CB|² = 2·|CM|² + 2·|AM|²
    thm:apollonius A := C, B := A, C := B, from H6, 1

3.  |CM| = |AM|
    restate H7

4.  |CA|² + |CB|² = 2·|AM|² + 2·|AM|²
    substitute |CM| = |AM| (line 3) into line 2

5.  |AM| + |MB| = |AB|
    mun:segment-addition P := A, Q := B, S := M, from H6

6.  |AB| = 2·|AM|
    algebra, from 1, 5

7.  |AB|² = (2·|AM|)²
    substitute |AB| = 2·|AM| (line 6)

8.  |AB|² = |CA|² + |CB|²
    algebra, from 4, 7

9.  |BA|² = |AC|² + |CB|² − 2·(|AC|·|CB|·cos(∠ACB))
    thm:law-of-cosines P := A, Q := C, R := B, from H5

10. ∠ACB ∈ ℝ
    mun:angle-real P := A, Q := C, R := B, from H5

11. cos(∠ACB)·(|CA|·|CB|) = 0·(|CA|·|CB|)
    algebra, from 8, 9
    requires ∠ACB ∈ ℝ: from 10
    requires cos(∠ACB) ∈ ℝ: mun:cos-real a := ∠ACB

12. |CA| > 0
    axi:distance-positive P := C, Q := A, from H5

13. |CB| > 0
    axi:distance-positive P := C, Q := B, from H5

14. |CA|·|CB| > 0
    mun:product-positive x := |CA|, y := |CB|, from 12, 13

15. cos(∠ACB) = 0
    mun:multiply-cancel a := cos(∠ACB), b := 0, c := |CA|·|CB|, from 11
    requires |CA|·|CB| ≠ 0: weakening, from 14
    requires ∠ACB ∈ ℝ: from 10
    requires cos(∠ACB) ∈ ℝ: mun:cos-real a := ∠ACB

16. ∠ACB = 90°
    mun:right-angle-by-cosine P := A, Q := C, R := B, from H5, 15
