import mundane theorem    stdlib/geometry/triangle-on-side
import theorem            stdlib/geometry/isosceles-angles
import mundane theorem    stdlib/geometry/angle-addition
import mundane theorem    stdlib/geometry/angle-along-segment
import mundane theorem    stdlib/geometry/angle-symmetric
import theorem            stdlib/geometry/angle-sum
forbid theorem            stdlib/geometry/law-of-cosines
forbid theorem            stdlib/geometry/law-of-sines

theorem thales
  note        M is as far from C as from A and B, so the triangles MAC and
              MCB are isosceles, and the angle at A equals ∠MCA and the angle
              at B equals ∠MCB. These two make up the angle at C, so the
              three angles of ABC add to twice the angle at C, and that is
              180°.
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  let M be a point                                                    (H4)
  assume A, B, C form a triangle                                      (H5)
  assume M is between A and B                                         (H6)
  assume |MA| = |MC| = |MB|                                           (H7)
  then ∠ACB = 90°

1.  C, A, M form a triangle.
    mun:triangle-on-side P := C, Q := A, R := B, S := M, from H5, H6

2.  C, B, M form a triangle.
    mun:triangle-on-side P := C, Q := B, R := A, S := M, from H5, H6

3.  ∠MAC = ∠MCA
    thm:isosceles-angles B := C, C := M, from H7, 1

4.  ∠MCB = ∠MBC
    thm:isosceles-angles A := C, C := M, from H7, 2

5.  ∠ACM + ∠MCB = ∠ACB
    mun:angle-addition, from H5, H6, 1

6.  ∠BAC + ∠ABC + ∠BCA = 180°
    thm:angle-sum, from H5

7.  ∠MAC = ∠BAC
    mun:angle-along-segment P := A, Q := B, R := C, S := M, from H5, H6, 1

8.  ∠MBC = ∠ABC
    mun:angle-along-segment P := B, Q := A, R := C, S := M, from H5, H6, 2

9.  ∠MCA = ∠ACM
    mun:angle-symmetric P := M, Q := C, R := A, from 1

10. ∠BCA = ∠ACB
    mun:angle-symmetric P := B, Q := C, R := A, from H5

11. ∠BAC + ∠ABC + ∠BCA = ∠ACB + ∠ACB
    calculation
      ∠BAC + ∠ABC + ∠BCA = ∠MAC + ∠ABC + ∠BCA      substitute line 7
                         = ∠MCA + ∠ABC + ∠BCA      substitute line 3
                         = ∠ACM + ∠ABC + ∠BCA      substitute line 9
                         = ∠ACM + ∠MBC + ∠BCA      substitute line 8
                         = ∠ACM + ∠MCB + ∠BCA      substitute line 4
                         = ∠ACB + ∠BCA             substitute line 5
                         = ∠ACB + ∠ACB             substitute line 10

12. ∠ACB = 90°
    algebra, from 6, 11
