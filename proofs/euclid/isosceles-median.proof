import theorem            proofs/euclid/sss-congruence/angle-from-sides
import definition         stdlib/geometry/midpoint
import definition         stdlib/geometry/triangle
import mundane theorem    stdlib/geometry/between-apart
import mundane theorem    stdlib/geometry/between-collinear
import mundane theorem    stdlib/geometry/between-symmetric
import theorem            stdlib/geometry/law-of-cosines
import axiom              stdlib/geometry/supplementary-angles
import mundane theorem    stdlib/geometry/angle-real
import mundane theorem    stdlib/geometry/angle-turned
import mundane theorem    stdlib/geometry/right-angle-by-cosine
import axiom              stdlib/geometry/distance-positive
import mundane theorem    stdlib/trigonometry/cos-supplement
import mundane theorem    stdlib/trigonometry/cos-real
import definition         stdlib/trigonometry/cos
import mundane theorem    stdlib/numbers/multiply-cancel
import mundane theorem    stdlib/numbers/product-positive

theorem isosceles-median
  note        The law of cosines at M in the triangles ABM and ACM, whose
              angles at M are supplementary, gives cos(∠AMB) = 0. The
              triangles ABM and ACM have their three sides equal, so the
              angles at A are equal.
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  let M be a point                                                    (H4)
  assume A, B, C form a triangle                                      (H5)
  assume |AB| = |AC|                                                  (H6)
  assume M is the midpoint of BC                                      (H7)
  then ∠AMB = 90°. ∠BAM = ∠MAC.

1.  M is between B and C. |BM| = |MC|.
    def:midpoint A := B, B := C, from H7

2.  B ≠ M. C ≠ M.
    mun:between-apart R := M, S := B, T := C, from 1

3.  C, M, B are collinear
    mun:between-collinear R := M, S := B, T := C, from 1

4.  A ≠ M
    contradiction
    suppose A = M                                                     (S)

    4.1.  C, A, B are collinear
          substitute M = A (S) into line 3

    4.2.  not (A, B, C are collinear)
          def:triangle P := A, Q := B, R := C, from H5, contradicting 4.1

5.  A ≠ B. A ≠ C.
    def:triangle P := A, Q := B, R := C, from H5

6.  M is between C and B
    mun:between-symmetric R := M, S := B, T := C, from 1

7.  |BA|² = |AM|² + |MB|² − 2·(|AM|·|MB|·cos(∠AMB))
    thm:law-of-cosines P := A, Q := M, R := B, from 2, 4

8.  |AC|² = |CM|² + |MA|² − 2·(|CM|·|MA|·cos(∠CMA))
    thm:law-of-cosines P := C, Q := M, R := A, from 2, 4

9.  ∠CMA + ∠AMB = 180°
    axi:supplementary-angles A := C, B := M, C := B, D := A, from 4, 6

10. ∠AMB ∈ ℝ
    mun:angle-real P := A, Q := M, R := B, from 2, 4

11. ∠CMA ∈ ℝ
    mun:angle-real P := C, Q := M, R := A, from 2, 4

12. ∠CMA = 180° − ∠AMB
    algebra, from 9
    requires ∠AMB ∈ ℝ: from 10
    requires ∠CMA ∈ ℝ: from 11

13. cos(∠CMA) = cos(180° − ∠AMB)
    substitute ∠CMA = 180° − ∠AMB (line 12)

14. cos(180° − ∠AMB) = −cos(∠AMB)
    mun:cos-supplement x := ∠AMB
    requires ∠AMB ∈ ℝ: from 10

15. cos(∠CMA) = −cos(∠AMB)
    calculation
      cos(∠CMA) = cos(180° − ∠AMB)      13
                = −cos(∠AMB)            14

16. |AC|² = |AM|² + |MB|² − 2·(|AM|·|MB|·cos(∠AMB))
    substitute |AB| = |AC| (H6) into line 7

17. |AC|² = |BM|² + |AM|² − 2·(|BM|·|AM|·cos(∠CMA))
    substitute |CM| = |BM| (line 1) into line 8

18. |AC|² = |BM|² + |AM|² − 2·(|BM|·|AM|·−cos(∠AMB))
    substitute cos(∠CMA) = −cos(∠AMB) (line 15) into line 17

19. cos(∠AMB)·(|AM|·|BM|) = 0·(|AM|·|BM|)
    algebra, from 16, 18
    requires ∠AMB ∈ ℝ: from 10
    requires cos(∠AMB) ∈ ℝ: mun:cos-real a := ∠AMB

20. |AM| > 0
    axi:distance-positive P := A, Q := M, from 4

21. |BM| > 0
    axi:distance-positive P := B, Q := M, from 2

22. |AM|·|BM| > 0
    mun:product-positive x := |AM|, y := |BM|, from 20, 21

23. cos(∠AMB) = 0
    mun:multiply-cancel a := cos(∠AMB), b := 0, c := |AM|·|BM|, from 19
    requires |AM|·|BM| ≠ 0: weakening, from 22
    requires ∠AMB ∈ ℝ: from 10
    requires cos(∠AMB) ∈ ℝ: mun:cos-real a := ∠AMB

24. ∠AMB = 90°
    mun:right-angle-by-cosine P := A, Q := M, R := B, from 2, 4, 23

25. ∠BAM = ∠CAM
    thm:angle-from-sides P := B, Q := A, R := M, P′ := C, Q′ := A, R′ := M,
      from H6, 1, 4, 5

26. ∠CAM = ∠MAC
    mun:angle-turned P := C, Q := A, R := M, from 4, 5

27. ∠BAM = ∠MAC
    calculation
      ∠BAM = ∠CAM      25
           = ∠MAC      26

28. ∠AMB = 90°. ∠BAM = ∠MAC.
    join 24, 27
