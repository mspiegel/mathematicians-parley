import theorem            stdlib/geometry/side-side-side
import definition         stdlib/geometry/midpoint
import definition         stdlib/geometry/congruent
import axiom              stdlib/geometry/supplementary-angles
import mundane theorem    stdlib/geometry/angle-turned
forbid theorem            stdlib/geometry/law-of-cosines
forbid theorem            stdlib/geometry/law-of-sines

theorem isosceles-median
  note        The triangles ABM and ACM have their three sides equal: AB and
              AC by hypothesis, BM and CM since M is the midpoint, and AM is
              common. So they are congruent (side-side-side), and the angles
              at A are equal, and so are the angles at M. Those two angles at
              M together make a straight angle, so each is 90°.
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  let M be a point                                                    (H4)
  assume A, B, C form a triangle                                      (H5)
  assume |AB| = |AC|                                                  (H6)
  assume M is the midpoint of BC                                      (H7)
  assume A, M, B form a triangle                                      (H8)
  assume M, A, C form a triangle                                      (H9)
  then ∠AMB = 90°. ∠BAM = ∠MAC.

1.  M is between B and C. |BM| = |MC|.
    def:midpoint A := B, B := C, from H7

2.  |BM| = |CM|
    restate 1

3.  triangle ABM ≅ triangle ACM
    thm:side-side-side C := M, D := A, E := C, F := M, from H6, H8, H9, 2

4.  ∠BMA = ∠CMA. ∠MAB = ∠MAC.
    def:congruent P := A, Q := B, R := M, P′ := A, Q′ := C, R′ := M,
      from H8, H9, 3

5.  ∠CMA + ∠AMB = 180°
    axi:supplementary-angles A := C, B := M, C := B, D := A, from H5, H8, 1

6.  ∠AMB = ∠BMA
    mun:angle-turned P := A, Q := M, R := B, from H8

7.  ∠AMB = 90°
    algebra, from 4, 5, 6

8.  ∠BAM = ∠MAC
    calculation
      ∠BAM = ∠MAB      mun:angle-turned P := B, Q := A, R := M, from H8
           = ∠MAC      4

9.  ∠AMB = 90°. ∠BAM = ∠MAC.
    join 7, 8
