import theorem            proofs/wiedijk/pythagoras/pythagoras
import theorem            proofs/wiedijk/isosceles/isosceles
import theorem            proofs/wiedijk/angle-sum/angle-sum
import mundane theorem    stdlib/geometry/distance-nonneg
import mundane theorem    stdlib/numbers/square-equal
import mundane theorem    stdlib/numbers/product-nonneg

theorem forty-five-forty-five-ninety
  note        Pythagoras at the right angle gives |AB|² = 2·|CA|². The
              triangle is isosceles, so the angles at A and B agree, and
              the three angles add to 180°.
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  assume A, B, C form a triangle                                      (H4)
  assume ∠ACB = 90°                                                   (H5)
  assume |CA| = |CB|                                                  (H6)
  then |AB| = √2·|CA|. ∠CAB = 45°.

1.  |AB|² = |AC|² + |BC|²
    thm:pythagoras, from H4, H5

2.  |AB|² = |CA|² + |CA|²
    substitute |CB| = |CA| (H6) into line 1

3.  |AB|² = (√2·|CA|)²
    calculation
      |AB|² = 2·|CA|²               algebra, from 2
            = (√2)²·|CA|²           real arithmetic
            = (√2·|CA|)²            algebra

4.  |AB| ≥ 0
    mun:distance-nonneg P := A, Q := B

5.  |CA| ≥ 0
    mun:distance-nonneg P := C, Q := A

6.  √2·|CA| ≥ 0
    mun:product-nonneg x := √2, y := |CA|, from 5
    requires √2 ≥ 0: real arithmetic

7.  |AB| = √2·|CA|
    mun:square-equal x := |AB|, y := √2·|CA|, from 3, 4, 6

8.  ∠CAB = ∠CBA
    thm:isosceles, from H4, H6

9.  ∠CAB + ∠ACB + ∠CBA = 180°
    thm:angle-sum B := C, C := B, from H4

10. ∠CAB = 45°
    algebra, from H5, 8, 9

11. |AB| = √2·|CA|. ∠CAB = 45°.
    join 7, 10
