import theorem            stdlib/geometry/intersecting-chords

theorem chords-through-circle
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  let D be a point                                                    (H4)
  let P be a point                                                    (H5)
  let Q be a point                                                    (H6)
  assume |QA| = |QB| = |QC| = |QD|                                    (H7)
  assume P is between A and B                                         (H8)
  assume P is between C and D                                         (H9)
  then |PA|·|PB| = |PC|·|PD|

1.  |PA|·|PB| = |PC|·|PD|
    thm:intersecting-chords O := Q, from H7, H8, H9
