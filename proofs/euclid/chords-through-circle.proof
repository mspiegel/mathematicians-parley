import mundane theorem    stdlib/geometry/distance-symmetric
import theorem            stdlib/geometry/intersecting-chords

theorem chords-through-circle
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  let D be a point                                                    (H4)
  let P be a point                                                    (H5)
  let Q be a point                                                    (H6)
  assume |QA| = |QB| = |QC| = |QD|                                    (H7)
  assume P is between A and B                                         (H8)
  assume P is between C and D                                         (H9)
  then |PA|·|PB| = |PC|·|PD|

1.  |AQ| = |QA|
    mun:distance-symmetric

2.  |BQ| = |QB|
    mun:distance-symmetric

3.  |CQ| = |QC|
    mun:distance-symmetric

4.  |DQ| = |QD|
    mun:distance-symmetric

5.  |AQ| = |BQ|
    algebra, from H7, 1, 2

6.  |AQ| = |CQ|
    algebra, from H7, 1, 3

7.  |AQ| = |DQ|
    algebra, from H7, 1, 4

8.  |PA|·|PB| = |PC|·|PD|
    thm:intersecting-chords, from H8, H9, 5, 6, 7
