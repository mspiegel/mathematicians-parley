import theorem            stdlib/geometry/heron
import mundane definition stdlib/geometry/triangle

theorem heron-formula
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  assume A, B, C form a triangle                                      (H4)
  let s = (|BC| + |CA| + |AB|)/2                                      (D1)
      reads half the perimeter of the triangle
  then the area of △ABC = √(s·(s − |BC|)·(s − |CA|)·(s − |AB|))

1.  the area of △ABC = √(s·(s − |BC|)·((s − |AC|)·(s − |AB|)))
    thm:heron P := A, Q := B, R := C, from D1
    requires A ≠ C: mun:triangle, from H4
    requires B ≠ C: mun:triangle, from H4

2.  s·(s − |BC|)·(s − |CA|)·(s − |AB|) = s·(s − |BC|)·((s − |AC|)·(s − |AB|))
    algebra, from D1

3.  the area of △ABC = √(s·(s − |BC|)·(s − |CA|)·(s − |AB|))
    substitute s·(s − |BC|)·(s − |CA|)·(s − |AB|) = s·(s − |BC|)·((s − |AC|)·(s − |AB|)) (line 2) into line 1
