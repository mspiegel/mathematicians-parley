import mundane theorem stdlib/geometry/distance-by-coordinates

theorem midpoint-is-equidistant
  note        Both distances are worked out from the coordinates. Each is the
              square root of half of a difference squared, added to the same
              for the second coordinate, and the two sums are equal.
  let a ∈ ℝ                                                           (H1)
  let b ∈ ℝ                                                           (H2)
  let c ∈ ℝ                                                           (H3)
  let d ∈ ℝ                                                           (H4)
  let M be a point                                                    (H5)
  assume M = ((a + c)/2, (b + d)/2)                                   (H6)
  then |(a, b)M| = |M(c, d)|

1.  |(a, b)((a + c)/2, (b + d)/2)| = √((a − (a + c)/2)² + (b − (b + d)/2)²)
    mun:distance-by-coordinates

2.  |(a, b)M| = √((a − (a + c)/2)² + (b − (b + d)/2)²)
    substitute M = ((a + c)/2, (b + d)/2) (H6) into line 1

3.  |((a + c)/2, (b + d)/2)(c, d)| = √(((a + c)/2 − c)² + ((b + d)/2 − d)²)
    mun:distance-by-coordinates

4.  |M(c, d)| = √(((a + c)/2 − c)² + ((b + d)/2 − d)²)
    substitute M = ((a + c)/2, (b + d)/2) (H6) into line 3

5.  |(a, b)M| = √(((a + c)/2 − c)² + ((b + d)/2 − d)²)
    substitute
      |(a, b)M| = √((a − (a + c)/2)² + (b − (b + d)/2)²)      2
      |(a, b)M| = √(((a + c)/2 − c)² + ((b + d)/2 − d)²)      algebra

6.  |(a, b)M| = |M(c, d)|
    calculation
      |(a, b)M| = √(((a + c)/2 − c)² + ((b + d)/2 − d)²)                  5
                = |M(c, d)|                                               4
