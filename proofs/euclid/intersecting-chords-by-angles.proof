import theorem            stdlib/geometry/angle-angle-similar
import theorem            stdlib/geometry/same-arc-angles
import theorem            stdlib/geometry/vertical-angles
import mundane theorem    stdlib/geometry/angle-same-ray
import mundane theorem    stdlib/geometry/angle-symmetric
import mundane theorem    stdlib/geometry/between-collinear
import mundane theorem    stdlib/geometry/between-ends-apart
import mundane theorem    stdlib/geometry/between-symmetric
import definition         stdlib/geometry/on-line
import mundane theorem    stdlib/geometry/on-line-ends
import mundane theorem    stdlib/geometry/same-side-off-line
import mundane theorem    stdlib/geometry/same-side-same
import mundane theorem    stdlib/geometry/same-side-turned
import mundane theorem    stdlib/geometry/segment-beyond-off-line
import mundane theorem    stdlib/geometry/segment-off-line
import mundane theorem    stdlib/geometry/triangle-not-on-line
import mundane theorem    stdlib/geometry/triangle-off-line
import mundane theorem    stdlib/geometry/triangle-on-side

theorem intersecting-chords-by-angles
  note        Euclid III.35 as a school text proves it. The angles APC and
              DPB are vertical angles, and A and D see the chord CB from one
              side of it, so at one angle (same-arc-angles, Euclid III.21).
              So the triangles PAC and PDB are similar, and their sides
              about P are in proportion. The chords are two lines: C is off
              the line AB.
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  let D be a point                                                    (H4)
  let P be a point                                                    (H5)
  let O be a point                                                    (H6)
  assume P is between A and B                                         (H7)
  assume P is between C and D                                         (H8)
  assume C is not on line AB                                          (H9)
  assume |AO| = |BO|                                                  (H10)
  assume |AO| = |CO|                                                  (H11)
  assume |AO| = |DO|                                                  (H12)
  then |PA|·|PB| = |PC|·|PD|

1.  A ≠ B
    mun:between-ends-apart R := P, S := A, T := B, from H7

2.  C, A, B form a triangle
    mun:triangle-off-line P := C, Q := A, R := B, from H9, 1

3.  A is not on line CB
    mun:triangle-not-on-line P := A, Q := C, R := B, from 2

4.  B is on line CB
    mun:on-line-ends A := C

5.  C is on line CB
    mun:on-line-ends A := C

6.  P and A are on the same side of line CB
    mun:segment-off-line A := C, P := A, Q := B, X := P, from H7, 2, 3, 4

7.  P is not on line CB
    mun:same-side-off-line A := C, Q := A, from 6

8.  P is between D and C
    mun:between-symmetric R := P, S := C, T := D, from H8

9.  D and P are on the same side of line CB
    mun:segment-beyond-off-line A := C, P := D, Q := C, X := P, from 2, 5, 7, 8

10. A and P are on the same side of line CB
    mun:same-side-turned A := C, Q := A, from 6

11. P and D are on the same side of line CB
    mun:same-side-turned A := C, P := D, Q := P, from 9

12. A and D are on the same side of line CB
    mun:same-side-same A := C, P := A, Q := P, R := D, from 10, 11

13. |CO| = |BO|
    calculation
      |CO| = |AO|    H11
           = |BO|    H10

14. |CO| = |DO|
    calculation
      |CO| = |AO|    H11
           = |DO|    H12

15. D is not on line CB
    mun:same-side-off-line A := C, P := D, Q := P, from 9

16. D, C, B form a triangle
    mun:triangle-off-line P := D, Q := C, R := B, from 2, 15

17. C, A, P form a triangle
    mun:triangle-on-side P := C, Q := A, R := B, S := P, from H7, 2

18. B, D, P form a triangle
    mun:triangle-on-side P := B, Q := D, R := C, S := P, from 8, 16

19. B, P, A are collinear
    mun:between-collinear R := P, S := A, T := B, from H7

20. P is on line AB
    def:on-line, from 19

21. A is on line AC
    mun:on-line-ends B := C

22. B is not on line AC
    mun:triangle-not-on-line P := B, Q := A, R := C, from 2

23. P is between B and A
    mun:between-symmetric R := P, S := A, T := B, from H7

24. P and B are on the same side of line AC
    mun:segment-off-line B := C, P := B, Q := A, X := P, from 2, 21, 22, 23

25. C, P, D are collinear
    mun:between-collinear R := P, S := C, T := D, from H8

26. P is on line DC
    def:on-line A := D, B := C, from 25

27. D is on line DB
    mun:on-line-ends A := D

28. C is not on line DB
    mun:triangle-not-on-line P := C, Q := D, R := B, from 16

29. P and C are on the same side of line DB
    mun:segment-off-line A := D, P := C, Q := D, X := P, from H8, 16, 27, 28

30. ∠PAC = ∠PDB
    calculation
      ∠PAC = ∠CAP    mun:angle-symmetric Q := A, R := C, from 17
           = ∠CAB    mun:angle-same-ray R := C, P := A, Q := B, X := P, from 20, 24
           = ∠CDB    thm:same-arc-angles A := C, C := A, from H11, 12, 13, 14
           = ∠BDC    mun:angle-symmetric P := C, Q := D, R := B, from 16
           = ∠BDP    mun:angle-same-ray R := B, P := D, Q := C, X := P, from 26, 29
           = ∠PDB    mun:angle-symmetric P := B, Q := D, R := P, from 18

31. ∠APC = ∠DPB
    calculation
      ∠APC = ∠BPD    thm:vertical-angles B := C, C := B, O := P, from H7, H8, 17, 18
           = ∠DPB    mun:angle-symmetric P := B, Q := P, R := D, from 18

32. |PA|·|PB| = |PD|·|PC|
    thm:angle-angle-similar Q := A, R := C, P′ := P, Q′ := D, R′ := B, from 17, 18, 30, 31

33. |PA|·|PB| = |PC|·|PD|
    algebra, from 32
