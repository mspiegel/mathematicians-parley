import theorem            stdlib/geometry/angle-angle-similar
import theorem            stdlib/geometry/same-arc-angles
import theorem            stdlib/geometry/vertical-angles
import mundane theorem    stdlib/geometry/angle-same-ray
import mundane theorem    stdlib/geometry/angle-symmetric
import mundane theorem    stdlib/geometry/between-collinear
import mundane theorem    stdlib/geometry/between-ends-apart
import mundane theorem    stdlib/geometry/between-symmetric
import mundane definition stdlib/geometry/on-line
import mundane theorem    stdlib/geometry/on-line-ends
import mundane theorem    stdlib/geometry/same-side-off-line
import mundane theorem    stdlib/geometry/same-side-same
import mundane theorem    stdlib/geometry/same-side-turned
import mundane theorem    stdlib/geometry/segment-beyond-off-line
import mundane theorem    stdlib/geometry/segment-off-line
import mundane definition stdlib/geometry/triangle
import mundane theorem    stdlib/geometry/triangle-not-on-line
import mundane theorem    stdlib/geometry/triangle-off-line
import mundane theorem    stdlib/geometry/triangle-on-side

theorem intersecting-chords-by-angles
  note        Euclid III.35 as a school text proves it. The angles APC and
              DPB are vertical angles, and A and D see the chord CB from one
              side of it, so at one angle (same-arc-angles, Euclid III.21).
              So the triangles PAC and PDB are similar, and their sides
              about P are in proportion. The chords are two lines: C is off
              the line AB.
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  let D be a point                                                    (H4)
  let P be a point                                                    (H5)
  let O be a point                                                    (H6)
  assume P is between A and B                                         (H7)
  assume P is between C and D                                         (H8)
  assume not (C is on line AB)                                        (H9)
  assume |AO| = |BO|                                                  (H10)
  assume |AO| = |CO|                                                  (H11)
  assume |AO| = |DO|                                                  (H12)
  then |PA|·|PB| = |PC|·|PD|

1.  A ≠ B
    mun:between-ends-apart R := P, S := A, T := B, from H7

2.  C, A, B form a triangle
    mun:triangle-off-line P := C, Q := A, R := B, from H9, 1

3.  C ≠ B
    mun:triangle P := C, Q := A, R := B, from 2

4.  not (A is on line CB)
    mun:triangle-not-on-line P := A, Q := C, R := B, from 2

5.  B is on line CB
    mun:on-line-ends A := C

6.  C is on line CB
    mun:on-line-ends A := C

7.  P and A are on the same side of line CB
    mun:segment-off-line A := C, P := A, Q := B, X := P, from H7, 3, 4, 5

8.  not (P is on line CB)
    mun:same-side-off-line A := C, Q := A, from 7

9.  P is between D and C
    mun:between-symmetric R := P, S := C, T := D, from H8

10. D and P are on the same side of line CB
    mun:segment-beyond-off-line A := C, P := D, Q := C, X := P, from 3, 6, 8, 9

11. A and P are on the same side of line CB
    mun:same-side-turned A := C, Q := A, from 7

12. P and D are on the same side of line CB
    mun:same-side-turned A := C, P := D, Q := P, from 10

13. A and D are on the same side of line CB
    mun:same-side-same A := C, P := A, Q := P, R := D, from 11, 12

14. |CO| = |BO|
    calculation
      |CO| = |AO|    H11
           = |BO|    H10

15. |CO| = |DO|
    calculation
      |CO| = |AO|    H11
           = |DO|    H12

16. ∠CAB = ∠CDB
    thm:same-arc-angles A := C, C := A, from H11, 13, 14, 15

17. not (D is on line CB)
    mun:same-side-off-line A := C, P := D, Q := P, from 10

18. D, C, B form a triangle
    mun:triangle-off-line P := D, Q := C, R := B, from 3, 17

19. C, A, P form a triangle
    mun:triangle-on-side P := C, Q := A, R := B, S := P, from H7, 2

20. B, D, P form a triangle
    mun:triangle-on-side P := B, Q := D, R := C, S := P, from 9, 18

21. B, P, A are collinear
    mun:between-collinear R := P, S := A, T := B, from H7

22. P is on line AB
    mun:on-line, from 21

23. A ≠ C
    mun:triangle P := C, Q := A, R := B, from 2

24. A is on line AC
    mun:on-line-ends B := C

25. not (B is on line AC)
    mun:triangle-not-on-line P := B, Q := A, R := C, from 2

26. P is between B and A
    mun:between-symmetric R := P, S := A, T := B, from H7

27. P and B are on the same side of line AC
    mun:segment-off-line B := C, P := B, Q := A, X := P, from 23, 24, 25, 26

28. ∠CAP = ∠CAB
    mun:angle-same-ray R := C, P := A, Q := B, X := P, from 22, 27

29. C, P, D are collinear
    mun:between-collinear R := P, S := C, T := D, from H8

30. P is on line DC
    mun:on-line A := D, B := C, from 29

31. D ≠ B
    mun:triangle P := D, Q := C, R := B, from 18

32. D is on line DB
    mun:on-line-ends A := D

33. not (C is on line DB)
    mun:triangle-not-on-line P := C, Q := D, R := B, from 18

34. P and C are on the same side of line DB
    mun:segment-off-line A := D, P := C, Q := D, X := P, from H8, 31, 32, 33

35. ∠BDP = ∠BDC
    mun:angle-same-ray R := B, P := D, Q := C, X := P, from 30, 34

36. ∠PAC = ∠CAP
    mun:angle-symmetric Q := A, R := C, from 19

37. ∠CDB = ∠BDC
    mun:angle-symmetric P := C, Q := D, R := B, from 18

38. ∠BDP = ∠PDB
    mun:angle-symmetric P := B, Q := D, R := P, from 20

39. ∠PAC = ∠PDB
    calculation
      ∠PAC = ∠CAP    36
           = ∠CAB    28
           = ∠CDB    16
           = ∠BDC    37
           = ∠BDP    35
           = ∠PDB    38

40. ∠APC = ∠BPD
    thm:vertical-angles B := C, C := B, O := P, from H7, H8

41. ∠BPD = ∠DPB
    mun:angle-symmetric P := B, Q := P, R := D, from 20

42. ∠APC = ∠DPB
    calculation
      ∠APC = ∠BPD    40
           = ∠DPB    41

43. |PA|·|PB| = |PD|·|PC|
    thm:angle-angle-similar Q := A, R := C, P′ := P, Q′ := D, R′ := B, from 19, 20, 39, 42

44. |PA|·|PB| = |PC|·|PD|
    algebra, from 43
