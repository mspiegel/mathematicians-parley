import theorem            proofs/wiedijk/pythagoras/pythagoras
import mundane theorem    stdlib/geometry/between-apart
import mundane theorem    stdlib/geometry/right-angle-triangle
import axiom              stdlib/geometry/supplementary-angles
import mundane theorem    stdlib/geometry/segment-addition
forbid theorem            stdlib/geometry/law-of-cosines
forbid theorem            stdlib/geometry/law-of-sines

theorem altitude-mean-proportional
  note        The altitude CD cuts the right triangle ABC into two right
              triangles, ADC and BDC. Pythagoras in all three writes |AB|²,
              |AC|² and |BC|² by the sides, and with |AB| = |AD| + |DB|
              twice |CD|² is left equal to twice |AD|·|DB|.
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  let D be a point                                                    (H4)
  assume A, B, C form a triangle                                      (H5)
  assume ∠ACB = 90°                                                   (H6)
  assume D is between A and B                                         (H7)
  assume C ≠ D                                                        (H8)
  assume ∠ADC = 90°                                                   (H9)
  then |CD|² = |AD|·|DB|

1.  A ≠ D. B ≠ D.
    mun:between-apart R := D, S := A, T := B, from H7

2.  |AB|² = |AC|² + |BC|²
    thm:pythagoras, from H5, H6

3.  A, D, C form a triangle
    mun:right-angle-triangle P := A, Q := D, R := C, from H5, H8, H9, 1

4.  |AC|² = |AD|² + |CD|²
    thm:pythagoras B := C, C := D, from H9, 3

5.  ∠ADC + ∠CDB = 180°
    axi:supplementary-angles B := D, C := B, D := C, from H5, H7, H8

6.  ∠CDB = 90°
    algebra, from H9, 5

7.  C, D, B form a triangle
    mun:right-angle-triangle P := C, Q := D, R := B, from H5, H8, 1, 6

8.  |CB|² = |CD|² + |BD|²
    thm:pythagoras A := C, C := D, from 6, 7

9.  |AD| + |DB| = |AB|
    mun:segment-addition P := A, Q := B, S := D, from H7

10. 2·|CD|² = 2·(|AD|·|DB|)
    calculation
      2·|CD|² = |AC|² + |BC|² − |AD|² − |DB|²     algebra, from 4, 8
              = |AB|² − |AD|² − |DB|²             substitute line 2
              = (|AD| + |DB|)² − |AD|² − |DB|²    substitute line 9
              = 2·(|AD|·|DB|)                     algebra

11. |CD|² = |AD|·|DB|
    algebra, from 10
