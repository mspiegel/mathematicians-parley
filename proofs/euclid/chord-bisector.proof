import theorem            stdlib/geometry/chord-midpoint-right-angle
import mundane definition stdlib/geometry/midpoint
import mundane theorem    stdlib/geometry/between-symmetric
import mundane theorem    stdlib/geometry/distance-symmetric

theorem chord-bisector
  note        The record states the right angle at M on the side of B. The
              midpoint of AB is the midpoint of BA, and the same record read
              with the ends exchanged gives the angle on the side of A.
  let O be a point                                                    (H1)
  let A be a point                                                    (H2)
  let B be a point                                                    (H3)
  let M be a point                                                    (H4)
  assume |OA| = |OB|                                                  (H5)
  assume M is the midpoint of AB                                      (H6)
  assume O ≠ M                                                        (H7)
  then ∠OMA = 90°

1.  M is between A and B. |AM| = |MB|.
    mun:midpoint, from H6

2.  M is between B and A
    mun:between-symmetric R := M, S := A, T := B, from 1

3.  |AM| = |MA|
    mun:distance-symmetric P := A, Q := M

4.  |BM| = |MB|
    mun:distance-symmetric P := B, Q := M

5.  |BM| = |MA|
    calculation
      |BM| = |MB|      4
           = |AM|      1
           = |MA|      3

6.  M is the midpoint of BA
    mun:midpoint A := B, B := A, from 2, 5

7.  |OB| = |BO|
    mun:distance-symmetric P := O, Q := B

8.  |AO| = |OA|
    mun:distance-symmetric P := A, Q := O

9.  |BO| = |AO|
    calculation
      |BO| = |OB|      7
           = |OA|      H5
           = |AO|      8

10. ∠OMA = 90°
    thm:chord-midpoint-right-angle A := B, B := A, from H7, 6, 9
