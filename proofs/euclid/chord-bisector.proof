import theorem            stdlib/geometry/chord-midpoint-right-angle
forbid theorem            stdlib/geometry/law-of-cosines
forbid theorem            stdlib/geometry/law-of-sines

theorem chord-bisector
  note        The theorem on a chord's midpoint gives the right angle on
              the side of B. M is the midpoint of BA as well as of AB, so
              the same theorem with A and B exchanged gives the angle on
              the side of A.
  let O be a point                                                    (H1)
  let A be a point                                                    (H2)
  let B be a point                                                    (H3)
  let M be a point                                                    (H4)
  assume |OA| = |OB|                                                  (H5)
  assume M is the midpoint of AB                                      (H6)
  assume O ≠ M                                                        (H7)
  assume M ≠ A                                                        (H8)
  assume O ≠ A                                                        (H9)
  then ∠OMA = 90°

1.  ∠OMA = 90°
    thm:chord-midpoint-right-angle A := B, B := A, from H5, H6, H7, H8, H9
