import axiom              stdlib/geometry/supplementary-angles
import mundane theorem    stdlib/geometry/between-apart
import mundane theorem    stdlib/geometry/triangle-angle-real
import mundane theorem    stdlib/geometry/triangle-extension
import definition         stdlib/geometry/triangle

theorem vertical-angles
  note        Euclid I.15. Each of ∠AOB and ∠COD makes 180° with ∠BOC, since
              O is between A and C and between B and D.
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  let D be a point                                                    (H4)
  let O be a point                                                    (H5)
  assume O is between A and C                                         (H6)
  assume O is between B and D                                         (H7)
  assume A, B, O form a triangle                                      (H8)
  assume C, O, D form a triangle                                      (H9)
  then ∠AOB = ∠COD

1.  A ≠ O. C ≠ O.
    mun:between-apart R := O, S := A, T := C, from H6

2.  B ≠ O. D ≠ O.
    mun:between-apart R := O, S := B, T := D, from H7

3.  B, O, C form a triangle.
    mun:triangle-extension P := B, Q := O, R := A, S := C, from H6, H8

4.  ∠AOB + ∠BOC = 180°
    axi:supplementary-angles B := O, D := B, from H6, 2
    requires B ≠ A: def:triangle P := A, Q := O, R := B, from H8
    requires B ≠ C: def:triangle P := B, Q := O, R := C, from 3

5.  ∠BOC + ∠COD = 180°
    axi:supplementary-angles A := B, B := O, C := D, D := C, from H7, 1
    requires C ≠ B: def:triangle P := B, Q := O, R := C, from 3
    requires C ≠ D: def:triangle P := C, Q := O, R := D, from H9

6.  ∠AOB = ∠COD
    algebra, from 4, 5
    requires ∠AOB ∈ ℝ: mun:triangle-angle-real P := A, Q := O, R := B, from H8
    requires ∠BOC ∈ ℝ: mun:triangle-angle-real P := B, Q := O, R := C, from 3
    requires ∠COD ∈ ℝ: mun:triangle-angle-real P := C, Q := O, R := D, from H9
