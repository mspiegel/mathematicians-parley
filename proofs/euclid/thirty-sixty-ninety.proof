import axiom              stdlib/geometry/distance-positive
import mundane theorem    stdlib/geometry/segment-extension
import mundane theorem    stdlib/geometry/triangle-extension
import axiom              stdlib/geometry/supplementary-angles
import mundane theorem    stdlib/geometry/angle-symmetric
import axiom              stdlib/geometry/side-angle-side
import definition         stdlib/geometry/congruent
import theorem            stdlib/geometry/angle-sum
import mundane theorem    stdlib/geometry/between-collinear
import definition         stdlib/geometry/on-line
import mundane theorem    stdlib/geometry/between-ends-apart
import mundane theorem    stdlib/geometry/triangle-not-on-line
import mundane theorem    stdlib/geometry/off-line-along
import mundane theorem    stdlib/geometry/triangle-off-line
import mundane theorem    stdlib/geometry/angle-addition
import mundane theorem    stdlib/geometry/angle-along-segment
import theorem            stdlib/geometry/angle-side-angle
import mundane theorem    stdlib/geometry/segment-addition
forbid theorem            stdlib/geometry/law-of-cosines
forbid theorem            stdlib/geometry/law-of-sines

theorem thirty-sixty-ninety
  note        Produce BC past C to D with |CD| = |BC|. The triangles ACB and
              ACD agree in the side AC, the right angles at C and the sides
              CB and CD, so they are congruent. The angle at B is 60°, since
              the three angles of ABC add to 180°, and so the triangle ABD
              has 60° at each vertex: at A twice 30°, at D the angle at B
              again. Its sides AD and AB match with the angles at their ends,
              so |BD| = |AB|, and |BD| is twice |BC|.
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  assume A, B, C form a triangle                                      (H4)
  assume ∠ACB = 90°                                                   (H5)
  assume ∠BAC = 30°                                                   (H6)
  then |BC| = |AB|/2

1.  |BC| > 0
    axi:distance-positive P := B, Q := C, from H4

2.  D ∈ 𝔼². C is between B and D. |CD| = |BC|.
    obtain D: mun:segment-extension A := B, B := C, r := |BC|, from H4, 1

3.  A, C, D form a triangle.
    mun:triangle-extension P := A, Q := C, R := B, S := D, from H4, 2

4.  ∠BCA + ∠ACD = 180°
    axi:supplementary-angles A := B, B := C, C := D, D := A, from H4, 2, 3

5.  ∠BCA = 90°
    calculation
      ∠BCA = ∠ACB       mun:angle-symmetric P := B, Q := C, R := A, from H4
           = 90°        H5

6.  ∠ACD = 90°
    algebra, from 4, 5

7.  ∠ACB = ∠ACD
    calculation
      ∠ACB = 90°        H5
           = ∠ACD       6

8.  |CB| = |CD|
    restate 2

9.  triangle ACB ≅ triangle ACD
    axi:side-angle-side P := A, Q := C, R := B, P′ := A, Q′ := C, R′ := D,
      from H4, 3, 7, 8

10. |BA| = |DA|. ∠CBA = ∠CDA. ∠BAC = ∠DAC.
    def:congruent, from H4, 3, 9

11. ∠BAC + ∠ABC + ∠BCA = 180°
    thm:angle-sum, from H4

12. ∠ABC = 60°
    algebra, from H6, 5, 11

13. D, C, B are collinear.
    mun:between-collinear R := C, S := B, T := D, from 2

14. D is on line BC.
    def:on-line P := D, A := B, B := C, from 13

15. B ≠ D
    mun:between-ends-apart R := C, S := B, T := D, from 2

16. A is not on line BC
    mun:triangle-not-on-line P := A, Q := B, R := C, from H4

17. A is not on line BD
    mun:off-line-along A := B, B := C, X := D, P := A, from H4, 14, 15, 16

18. A, B, D form a triangle.
    mun:triangle-off-line P := A, Q := B, R := D, from 15, 17

19. ∠BAC + ∠CAD = ∠BAD
    mun:angle-addition A := B, B := D, C := A, M := C, from H4, 2, 18

20. ∠CAD = ∠BAC
    calculation
      ∠CAD = ∠DAC       mun:angle-symmetric P := C, Q := A, R := D, from 3
           = ∠BAC       10

21. ∠BAD = 60°
    algebra, from H6, 19, 20

22. ∠ADB = 60°
    calculation
      ∠ADB = ∠BDA       mun:angle-symmetric P := A, Q := D, R := B, from 18
           = ∠CDA       mun:angle-along-segment P := D, Q := B, S := C, R := A, from 2, 3, 18
           = ∠CBA       10
           = ∠ABC       mun:angle-symmetric P := C, Q := B, R := A, from H4
           = 60°        12

23. |AD| = |BA|
    restate 10

24. ∠BAD = ∠DBA
    calculation
      ∠BAD = 60°        21
           = ∠ABC       12
           = ∠CBA       mun:angle-symmetric P := A, Q := B, R := C, from H4
           = ∠DBA       mun:angle-along-segment P := B, Q := D, S := C, R := A, from H4, 2, 18

25. ∠ADB = ∠BAD
    calculation
      ∠ADB = 60°        22
           = ∠BAD       21

26. triangle ADB ≅ triangle BAD
    thm:angle-side-angle B := D, C := B, D := B, E := A, F := D,
      from 18, 23, 24, 25

27. |DB| = |AD|
    def:congruent, from 18, 26

28. |BC| + |CD| = |BD|
    mun:segment-addition P := B, Q := D, S := C, from 2

29. |AB| = 2·|BC|
    calculation
      |AB| = |AD|               23
           = |DB|               27
           = |BC| + |CD|        28
           = 2·|BC|             algebra, from 2

30. |BC| = |AB|/2
    algebra, from 29
