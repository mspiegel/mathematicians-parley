import theorem            stdlib/geometry/law-of-sines
import definition         stdlib/trigonometry/sin

theorem thirty-sixty-ninety
  note        The law of sines compares the side opposite the right angle,
              AB, with the side opposite the angle of 30°, BC. The sine of
              90° is 1 and the sine of 30° is 1/2.
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  assume A, B, C form a triangle                                      (H4)
  assume ∠ACB = 90°                                                   (H5)
  assume ∠BAC = 30°                                                   (H6)
  then |BC| = |AB|/2

1.  |BA|·sin(∠BAC) = |BC|·sin(∠ACB)
    thm:law-of-sines P := B, Q := A, R := C, from H4

2.  |BA|·sin(30°) = |BC|·sin(∠ACB)
    substitute ∠BAC = 30° (H6) into line 1

3.  |BA|·sin(30°) = |BC|·sin(90°)
    substitute ∠ACB = 90° (H5) into line 2

4.  |BA|·(1/2) = |BC|·sin(90°)
    substitute sin(30°) = 1/2 (real arithmetic) into line 3

5.  |BA|·(1/2) = |BC|·1
    substitute sin(90°) = 1 (real arithmetic) into line 4

6.  |BC| = |AB|/2
    algebra, from 5
