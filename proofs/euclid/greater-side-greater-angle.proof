import theorem            stdlib/geometry/law-of-cosines
import theorem            stdlib/geometry/triangle-inequality-strict
import mundane theorem    stdlib/geometry/angle-real
import mundane theorem    stdlib/geometry/angle-order-by-cosine
import mundane theorem    stdlib/geometry/angle-symmetric
import axiom              stdlib/geometry/distance-positive
import definition         stdlib/geometry/triangle
import definition         stdlib/trigonometry/cos
import mundane theorem    stdlib/trigonometry/cos-real
import mundane theorem    stdlib/numbers/factor-positive
import mundane theorem    stdlib/numbers/product-positive
import mundane theorem    stdlib/numbers/square-less

theorem greater-side-greater-angle
  note        Euclid I.18. Write a, b, c for |BC|, |CA|, |AB|. The law of
              cosines at A and at B, each multiplied up to 2abc times the
              cosine, gives 2abc·(cos A − cos B) = (b − a)·((b + a)² − c²).
              Here b − a is positive by hypothesis and (b + a)² − c² by the
              triangle inequality, so cos B < cos A, and the larger angle has
              the smaller cosine.
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  assume A, B, C form a triangle                                      (H4)
  assume |CA| > |CB|                                                  (H5)
  then ∠CBA > ∠CAB

1.  A ≠ B. B ≠ C. A ≠ C.
    def:triangle, from H4

2.  |AB| > 0
    axi:distance-positive P := A, Q := B, from 1

3.  |BC| > 0
    axi:distance-positive P := B, Q := C, from 1

4.  |CA| > 0
    axi:distance-positive P := C, Q := A, from 1

5.  ∠CAB ∈ ℝ. ∠CAB ≥ 0.
    mun:angle-real P := C, Q := A, R := B, from 1

6.  ∠CBA ∈ ℝ. ∠CBA ≥ 0.
    mun:angle-real P := C, Q := B, R := A, from 1

7.  |BC|² = |CA|² + |AB|² − 2·(|CA|·|AB|·cos(∠CAB))
    thm:law-of-cosines P := C, Q := A, R := B, from 1

8.  |CA|² = |AB|² + |BC|² − 2·(|AB|·|BC|·cos(∠ABC))
    thm:law-of-cosines P := A, Q := B, R := C, from 1

9.  |CA|² = |AB|² + |BC|² − 2·(|AB|·|BC|·cos(∠CBA))
    substitute
      |CA|² = |AB|² + |BC|² − 2·(|AB|·|BC|·cos(∠ABC))      8
      |CA|² = |AB|² + |BC|² − 2·(|AB|·|BC|·cos(∠CBA))      mun:angle-symmetric P := A, Q := B, R := C, from H4

10. 2·|BC|·|CA|·|AB|·cos(∠CAB) = |BC|·(|CA|² + |AB|² − |BC|²)
    algebra, from 7
    requires cos(∠CAB) ∈ ℝ: mun:cos-real a := ∠CAB, from 5

11. 2·|BC|·|CA|·|AB|·cos(∠CBA) = |CA|·(|AB|² + |BC|² − |CA|²)
    algebra, from 9
    requires cos(∠CBA) ∈ ℝ: mun:cos-real a := ∠CBA, from 6

12. |BC|·|CA|·|AB|·(cos(∠CAB) − cos(∠CBA)) = (|CA| − |BC|)·((|CA| + |BC|)² − |AB|²)/2
    algebra, from 10, 11
    requires cos(∠CAB) ∈ ℝ: mun:cos-real a := ∠CAB, from 5
    requires cos(∠CBA) ∈ ℝ: mun:cos-real a := ∠CBA, from 6

13. |CA| − |BC| > 0
    inequalities
      |CA| > |BC|              H5
      |CA| − |BC| > 0          adding −|BC|

14. |AB| < |AC| + |CB|
    thm:triangle-inequality-strict P := A, Q := C, R := B, from H4

15. |CA| + |BC| > 0
    inequalities, from 3, 4

16. |AB|² < (|CA| + |BC|)²
    mun:square-less x := |AB|, y := |CA| + |BC|, from 14
    requires |AB| ≥ 0: weakening, from 2
    requires |CA| + |BC| ≥ 0: weakening, from 15

17. 0 < (|CA| + |BC|)² − |AB|²
    inequalities
      |AB|² < (|CA| + |BC|)²              16
      0 < (|CA| + |BC|)² − |AB|²          adding −|AB|²

18. (|CA| − |BC|)·((|CA| + |BC|)² − |AB|²) > 0
    mun:product-positive x := |CA| − |BC|, y := (|CA| + |BC|)² − |AB|², from 13, 17

19. (|CA| − |BC|)·((|CA| + |BC|)² − |AB|²)/2 > 0
    inequalities
      (|CA| − |BC|)·((|CA| + |BC|)² − |AB|²) > 0          18
      (|CA| − |BC|)·((|CA| + |BC|)² − |AB|²)/2 > 0        multiplying by 1/2

20. |BC|·|CA|·|AB|·(cos(∠CAB) − cos(∠CBA)) > 0
    calculation
      |BC|·|CA|·|AB|·(cos(∠CAB) − cos(∠CBA)) = (|CA| − |BC|)·((|CA| + |BC|)² − |AB|²)/2     12
                                             > 0                                           19

21. |BC|·|CA| > 0
    mun:product-positive x := |BC|, y := |CA|, from 3, 4

22. |BC|·|CA|·|AB| > 0
    mun:product-positive x := |BC|·|CA|, y := |AB|, from 2, 21

23. cos(∠CAB) − cos(∠CBA) > 0
    mun:factor-positive a := |BC|·|CA|·|AB|, b := cos(∠CAB) − cos(∠CBA), from 20
    requires |BC|·|CA|·|AB| ≥ 0: weakening, from 22
    requires cos(∠CAB) ∈ ℝ: mun:cos-real a := ∠CAB, from 5
    requires cos(∠CBA) ∈ ℝ: mun:cos-real a := ∠CBA, from 6

24. cos(∠CBA) < cos(∠CAB)
    inequalities
      cos(∠CAB) − cos(∠CBA) > 0         23
      0 < cos(∠CAB) − cos(∠CBA)         restate
      cos(∠CBA) < cos(∠CAB)             adding cos(∠CBA)
    requires cos(∠CAB) ∈ ℝ: mun:cos-real a := ∠CAB, from 5
    requires cos(∠CBA) ∈ ℝ: mun:cos-real a := ∠CBA, from 6

25. ∠CBA > ∠CAB
    mun:angle-order-by-cosine P := C, Q := A, R := B, P′ := C, Q′ := B, R′ := A, from 1, 24
