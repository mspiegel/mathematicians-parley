import theorem            stdlib/geometry/greater-side-greater-angle as euclid-18
forbid theorem            stdlib/geometry/law-of-cosines
forbid theorem            stdlib/geometry/law-of-sines

theorem greater-side-greater-angle
  note        Euclid I.18, with the two sides meeting at C: the side CA,
              opposite B, is longer than the side CB, opposite A, so the
              angle at B is the greater. Euclid lays off CB along CA to D;
              the triangle CBD is isosceles, the angle at B is ∠CBD and more,
              and ∠CDB, outside the triangle ABD, is greater than the angle
              at A.
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  assume A, B, C form a triangle                                      (H4)
  assume |CA| > |CB|                                                  (H5)
  then ∠CBA > ∠CAB

1.  ∠CBA > ∠CAB
    thm:euclid-18 A := C, C := A, from H4, H5
