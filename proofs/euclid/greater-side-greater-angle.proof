import theorem            stdlib/geometry/law-of-cosines
import theorem            stdlib/geometry/triangle-inequality-strict
import mundane theorem    stdlib/geometry/angle-order-by-cosine
import mundane theorem    stdlib/geometry/angle-symmetric
import axiom              stdlib/geometry/distance-positive
import definition         stdlib/trigonometry/cos
import mundane theorem    stdlib/numbers/factor-positive
import mundane theorem    stdlib/numbers/product-positive
import mundane theorem    stdlib/numbers/square-less

theorem greater-side-greater-angle
  note        Euclid I.18. Write a, b, c for |BC|, |CA|, |AB|. The law of
              cosines at A and at B, each multiplied up to 2abc times the
              cosine, gives 2abc·(cos A − cos B) = (b − a)·((b + a)² − c²).
              Here b − a is positive by hypothesis and (b + a)² − c² by the
              triangle inequality, so cos B < cos A, and the larger angle has
              the smaller cosine.
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  assume A, B, C form a triangle                                      (H4)
  assume |CA| > |CB|                                                  (H5)
  then ∠CBA > ∠CAB

1.  |AB| > 0
    axi:distance-positive P := A, Q := B, from H4

2.  |BC| > 0
    axi:distance-positive P := B, Q := C, from H4

3.  |CA| > 0
    axi:distance-positive P := C, Q := A, from H4

4.  |BC|² = |CA|² + |AB|² − 2·(|CA|·|AB|·cos(∠CAB))
    thm:law-of-cosines P := C, Q := A, R := B, from H4

5.  |CA|² = |AB|² + |BC|² − 2·(|AB|·|BC|·cos(∠ABC))
    thm:law-of-cosines P := A, Q := B, R := C, from H4

6.  |CA|² = |AB|² + |BC|² − 2·(|AB|·|BC|·cos(∠CBA))
    substitute
      |CA|² = |AB|² + |BC|² − 2·(|AB|·|BC|·cos(∠ABC))      5
      |CA|² = |AB|² + |BC|² − 2·(|AB|·|BC|·cos(∠CBA))      mun:angle-symmetric P := A, Q := B, R := C, from H4

7.  2·|BC|·|CA|·|AB|·cos(∠CAB) = |BC|·(|CA|² + |AB|² − |BC|²)
    algebra, from 4

8.  2·|BC|·|CA|·|AB|·cos(∠CBA) = |CA|·(|AB|² + |BC|² − |CA|²)
    algebra, from 6

9.  |CA| − |BC| > 0
    inequalities
      |CA| > |BC|              H5
      |CA| − |BC| > 0          adding −|BC|

10. |AB| < |AC| + |CB|
    thm:triangle-inequality-strict P := A, Q := C, R := B, from H4

11. |CA| + |BC| > 0
    inequalities, from 2, 3

12. |AB|² < (|CA| + |BC|)²
    mun:square-less x := |AB|, y := |CA| + |BC|, from 10
    requires |AB| ≥ 0: weakening, from 1
    requires |CA| + |BC| ≥ 0: weakening, from 11

13. 0 < (|CA| + |BC|)² − |AB|²
    inequalities
      |AB|² < (|CA| + |BC|)²              12
      0 < (|CA| + |BC|)² − |AB|²          adding −|AB|²

14. (|CA| − |BC|)·((|CA| + |BC|)² − |AB|²) > 0
    mun:product-positive x := |CA| − |BC|, y := (|CA| + |BC|)² − |AB|², from 9, 13

15. (|CA| − |BC|)·((|CA| + |BC|)² − |AB|²)/2 > 0
    inequalities
      (|CA| − |BC|)·((|CA| + |BC|)² − |AB|²) > 0          14
      (|CA| − |BC|)·((|CA| + |BC|)² − |AB|²)/2 > 0        multiplying by 1/2

16. |BC|·|CA|·|AB|·(cos(∠CAB) − cos(∠CBA)) > 0
    calculation
      |BC|·|CA|·|AB|·(cos(∠CAB) − cos(∠CBA)) = (|CA| − |BC|)·((|CA| + |BC|)² − |AB|²)/2     algebra, from 7, 8
                                             > 0                                           15

17. |BC|·|CA| > 0
    mun:product-positive x := |BC|, y := |CA|, from 2, 3

18. |BC|·|CA|·|AB| > 0
    mun:product-positive x := |BC|·|CA|, y := |AB|, from 1, 17

19. cos(∠CAB) − cos(∠CBA) > 0
    mun:factor-positive a := |BC|·|CA|·|AB|, b := cos(∠CAB) − cos(∠CBA), from 16
    requires |BC|·|CA|·|AB| ≥ 0: weakening, from 18

20. cos(∠CBA) < cos(∠CAB)
    inequalities
      cos(∠CAB) − cos(∠CBA) > 0         19
      0 < cos(∠CAB) − cos(∠CBA)         restate
      cos(∠CBA) < cos(∠CAB)             adding cos(∠CBA)

21. ∠CBA > ∠CAB
    mun:angle-order-by-cosine P := C, Q := A, R := B, P′ := C, Q′ := B, R′ := A, from H4, 20
