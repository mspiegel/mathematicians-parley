import theorem            stdlib/geometry/law-of-cosines
import theorem            stdlib/geometry/triangle-inequality-strict
import mundane theorem    stdlib/geometry/angle-real
import mundane theorem    stdlib/geometry/angle-order-by-cosine
import mundane theorem    stdlib/geometry/angle-symmetric
import mundane theorem    stdlib/geometry/distance-positive
import mundane theorem    stdlib/geometry/distance-symmetric
import mundane definition stdlib/geometry/triangle
import mundane definition stdlib/trigonometry/cos
import mundane theorem    stdlib/trigonometry/cos-real
import mundane theorem    stdlib/numbers/factor-positive
import mundane theorem    stdlib/numbers/product-positive
import mundane theorem    stdlib/numbers/square-less

theorem greater-side-greater-angle
  note        Euclid I.18. Write a, b, c for |BC|, |CA|, |AB|. The law of
              cosines at A and at B, each multiplied up to 2abc times the
              cosine, gives 2abc·(cos A − cos B) = (b − a)·((b + a)² − c²).
              Here b − a is positive by hypothesis and (b + a)² − c² by the
              triangle inequality, so cos B < cos A, and the larger angle has
              the smaller cosine.
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  assume A, B, C form a triangle                                      (H4)
  assume |CA| > |CB|                                                  (H5)
  then ∠CBA > ∠CAB

1.  A ≠ B. B ≠ C. A ≠ C.
    mun:triangle, from H4

2.  |AB| > 0
    mun:distance-positive P := A, Q := B, from 1

3.  |BC| > 0
    mun:distance-positive P := B, Q := C, from 1

4.  |CA| > 0
    mun:distance-positive P := C, Q := A, from 1

5.  ∠CAB ∈ ℝ. ∠CAB ≥ 0.
    mun:angle-real P := C, Q := A, R := B, from 1

6.  ∠CBA ∈ ℝ. ∠CBA ≥ 0.
    mun:angle-real P := C, Q := B, R := A, from 1

7.  |BC|² = |CA|² + |AB|² − 2·(|CA|·|AB|·cos(∠CAB))
    thm:law-of-cosines P := C, Q := A, R := B, from 1

8.  |CA|² = |AB|² + |BC|² − 2·(|AB|·|BC|·cos(∠ABC))
    thm:law-of-cosines P := A, Q := B, R := C, from 1

9.  ∠ABC = ∠CBA
    mun:angle-symmetric P := A, Q := B, R := C, from H4

10. |CA|² = |AB|² + |BC|² − 2·(|AB|·|BC|·cos(∠CBA))
    substitute ∠ABC = ∠CBA (line 9) into line 8

11. 2·|BC|·|CA|·|AB|·cos(∠CAB) = |BC|·(|CA|² + |AB|² − |BC|²)
    algebra, from 7
    requires cos(∠CAB) ∈ ℝ: mun:cos-real a := ∠CAB, from 5

12. 2·|BC|·|CA|·|AB|·cos(∠CBA) = |CA|·(|AB|² + |BC|² − |CA|²)
    algebra, from 10
    requires cos(∠CBA) ∈ ℝ: mun:cos-real a := ∠CBA, from 6

13. |BC|·|CA|·|AB|·(cos(∠CAB) − cos(∠CBA)) = (|CA| − |BC|)·((|CA| + |BC|)² − |AB|²)/2
    algebra, from 11, 12
    requires cos(∠CAB) ∈ ℝ: mun:cos-real a := ∠CAB, from 5
    requires cos(∠CBA) ∈ ℝ: mun:cos-real a := ∠CBA, from 6

14. |CB| = |BC|
    mun:distance-symmetric P := C, Q := B

15. |CA| > |BC|
    substitute |CB| = |BC| (line 14) into H5

16. |CA| − |BC| > 0
    inequalities
      |CA| > |BC|              15
      |CA| − |BC| > 0          adding −|BC|

17. |AB| < |AC| + |CB|
    thm:triangle-inequality-strict P := A, Q := C, R := B, from H4

18. |CA| + |BC| > 0
    inequalities, from 3, 4

19. |AB|² < (|CA| + |BC|)²
    mun:square-less x := |AB|, y := |CA| + |BC|, from 17
    requires |AB| ≥ 0: weakening, from 2
    requires |CA| + |BC| ≥ 0: weakening, from 18

20. 0 < (|CA| + |BC|)² − |AB|²
    inequalities
      |AB|² < (|CA| + |BC|)²              19
      0 < (|CA| + |BC|)² − |AB|²          adding −|AB|²

21. (|CA| − |BC|)·((|CA| + |BC|)² − |AB|²) > 0
    mun:product-positive x := |CA| − |BC|, y := (|CA| + |BC|)² − |AB|², from 16, 20

22. (|CA| − |BC|)·((|CA| + |BC|)² − |AB|²)/2 > 0
    inequalities
      (|CA| − |BC|)·((|CA| + |BC|)² − |AB|²) > 0          21
      (|CA| − |BC|)·((|CA| + |BC|)² − |AB|²)/2 > 0        multiplying by 1/2

23. |BC|·|CA|·|AB|·(cos(∠CAB) − cos(∠CBA)) > 0
    calculation
      |BC|·|CA|·|AB|·(cos(∠CAB) − cos(∠CBA)) = (|CA| − |BC|)·((|CA| + |BC|)² − |AB|²)/2     13
                                             > 0                                           22

24. |BC|·|CA| > 0
    mun:product-positive x := |BC|, y := |CA|, from 3, 4

25. |BC|·|CA|·|AB| > 0
    mun:product-positive x := |BC|·|CA|, y := |AB|, from 2, 24

26. cos(∠CAB) − cos(∠CBA) > 0
    mun:factor-positive a := |BC|·|CA|·|AB|, b := cos(∠CAB) − cos(∠CBA), from 23
    requires |BC|·|CA|·|AB| ≥ 0: weakening, from 25
    requires cos(∠CAB) ∈ ℝ: mun:cos-real a := ∠CAB, from 5
    requires cos(∠CBA) ∈ ℝ: mun:cos-real a := ∠CBA, from 6

27. cos(∠CBA) < cos(∠CAB)
    inequalities
      cos(∠CAB) − cos(∠CBA) > 0         26
      0 < cos(∠CAB) − cos(∠CBA)         symmetry
      cos(∠CBA) < cos(∠CAB)             adding cos(∠CBA)
    requires cos(∠CAB) ∈ ℝ: mun:cos-real a := ∠CAB, from 5
    requires cos(∠CBA) ∈ ℝ: mun:cos-real a := ∠CBA, from 6

28. ∠CBA > ∠CAB
    mun:angle-order-by-cosine P := C, Q := A, R := B, P′ := C, Q′ := B, R′ := A, from 1, 27
