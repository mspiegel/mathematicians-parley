import theorem            stdlib/counting/count-functions
import theorem            stdlib/counting/count-one-to-one
import mundane theorem    stdlib/counting/card-nat0
import mundane theorem    stdlib/counting/range-size
import mundane theorem    stdlib/sums/range-finite

theorem birthday
  metamath    birthday
  note        Of the ways 23 people can have their birthdays among 365 days,
              fewer than half give no two of them the same day: the one-to-
              one functions are 365·364·…·343 of the 365^23 functions, and
              twice that product is less than 365^23.
  define S := the functions from {1, …, 23} to {1, …, 365}            (D1)
         reads the ways 23 people can have their birthdays
  define T := {f ∈ S : f : {1, …, 23} → {1, …, 365} is one-to-one}    (D2)
         reads the ways in which no two of them share one
  then |T|/|S| < 1/2

1.  {1, …, 23} is finite
    mun:range-finite a := 1, b := 23

2.  {1, …, 365} is finite
    mun:range-finite a := 1, b := 365

3.  |{1, …, 23}| = 23
    mun:range-size n := 23

4.  |{1, …, 365}| = 365
    mun:range-size n := 365

5.  |S| = |{1, …, 365}|^|{1, …, 23}|
    thm:count-functions X := {1, …, 23}, Y := {1, …, 365}, from 1, 2, D1

6.  |S| = 365^|{1, …, 23}|
    substitute |{1, …, 365}| = 365 (line 4) into line 5

7.  |S| = 365^23
    substitute |{1, …, 23}| = 23 (line 3) into line 6

8.  |{1, …, 23}| ≤ |{1, …, 365}|
    inequalities, from 3, 4
    requires |{1, …, 23}| ∈ ℕ₀: mun:card-nat0, from 1
    requires |{1, …, 365}| ∈ ℕ₀: mun:card-nat0, from 2

9.  |T| = ∏(k ∈ {0, …, |{1, …, 23}| − 1}) (|{1, …, 365}| − k)
    thm:count-one-to-one X := {1, …, 23}, Y := {1, …, 365}, from 1, 2, 8, D1, D2

10. |T| = ∏(k ∈ {0, …, 23 − 1}) (|{1, …, 365}| − k)
    substitute |{1, …, 23}| = 23 (line 3) into line 9

11. |T| = ∏(k ∈ {0, …, 22}) (|{1, …, 365}| − k)
    substitute 23 − 1 = 22 (arithmetic) into line 10

12. |T| = ∏(k ∈ {0, …, 22}) (365 − k)
    substitute |{1, …, 365}| = 365 (line 4) into line 11

13. 2·∏(k ∈ {0, …, 22}) (365 − k) < 365^23
    arithmetic

14. |T|/|S| = |T|/365^23
    substitute |S| = 365^23 (line 7)

15. |T|/365^23 = (∏(k ∈ {0, …, 22}) (365 − k))/365^23
    substitute |T| = ∏(k ∈ {0, …, 22}) (365 − k) (line 12)

16. (∏(k ∈ {0, …, 22}) (365 − k))/365^23 < 1/2
    inequalities, from 13
    requires ∏(k ∈ {0, …, 22}) (365 − k) ∈ ℝ: arithmetic

17. |T|/|S| < 1/2
    calculation
      |T|/|S| = |T|/365^23                                     14
              = (∏(k ∈ {0, …, 22}) (365 − k))/365^23           15
              < 1/2                                            16
