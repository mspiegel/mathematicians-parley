import theorem            stdlib/calculus/continuous-linear
import theorem            stdlib/calculus/continuous-sum
import theorem            stdlib/calculus/derivative-linear
import mundane theorem    stdlib/calculus/derivative-real
import theorem            stdlib/calculus/derivative-sum
import theorem            stdlib/calculus/rolle
import mundane definition stdlib/calculus/interval
import mundane theorem    stdlib/calculus/interval-real
import mundane theorem    stdlib/calculus/open-interval-open
import mundane theorem    stdlib/calculus/open-within-closed
import mundane theorem    stdlib/functions/function-into

theorem mean-value
  metamath    mvth
  note        Add to f the line through 0 whose slope is the chord's, negated.
              The result F takes one value at a and at b, so Rolle's theorem
              gives a c inside where F′(c) = 0, and there f′(c) is the
              chord's slope.
  let a ∈ ℝ                                                           (H1)
  let b ∈ ℝ                                                           (H2)
  assume a < b                                                        (H3)
  let f : [a, b] → ℝ                                                  (H4)
  assume f is continuous on [a, b]                                    (H5)
  assume f is differentiable on (a, b)                                (H6)
  then there is c ∈ (a, b) with f′(c) = (f(b) − f(a))/(b − a)

define g(x) := ((f(a) − f(b))/(b − a))·x, for x ∈ [a, b]              (D1)
       reads the line through 0 whose slope is the chord's, negated

define F(x) := f(x) + g(x), for x ∈ [a, b]                            (D2)
       reads f with the line g added, so that it takes one value at a and b

1.  a ∈ [a, b]
    mun:interval x := a
    requires a ≤ a: inequalities, from H1
    requires a ≤ b: inequalities, from H1, H2, H3

2.  b ∈ [a, b]
    mun:interval x := b
    requires a ≤ b: inequalities, from H1, H2, H3
    requires b ≤ b: inequalities, from H2

3.  [a, b] ⊆ ℝ
    mun:interval-real

4.  For all x ∈ [a, b], g(x) = ((f(a) − f(b))/(b − a))·x.
    D1

5.  For all x ∈ [a, b], F(x) = f(x) + g(x).
    D2

6.  For all x ∈ [a, b], g(x) ∈ ℝ.
    membership, from D1
    requires b − a ≠ 0: inequalities, from H1, H2, H3
    requires (f(a) − f(b))/(b − a) ∈ ℝ: membership, from H4, 1, 2, H1, H2
    requires x ∈ ℝ: mun:interval, from H1, H2

7.  g : [a, b] → ℝ
    mun:function-into, from 6
    requires g is a function on [a, b]: from D1

8.  For all x ∈ [a, b], F(x) ∈ ℝ.
    membership, from D1, D2
    requires f(x) ∈ ℝ: from H4
    requires b − a ≠ 0: inequalities, from H1, H2, H3
    requires (f(a) − f(b))/(b − a) ∈ ℝ: membership, from H4, 1, 2, H1, H2
    requires x ∈ ℝ: mun:interval, from H1, H2

9.  F : [a, b] → ℝ
    mun:function-into, from 8
    requires F is a function on [a, b]: from D2

10. g is continuous on [a, b]
    thm:continuous-linear D := [a, b], m := (f(a) − f(b))/(b − a), g := g, from 3, 4
    requires b − a ≠ 0: inequalities, from H1, H2, H3
    requires (f(a) − f(b))/(b − a) ∈ ℝ: membership, from H4, 1, 2, H1, H2
    requires g : [a, b] → ℝ: from 7

11. F is continuous on [a, b]
    thm:continuous-sum D := [a, b], F := F, f := f, g := g, from 3, 5, H5, 10
    requires F : [a, b] → ℝ: from 9
    requires g : [a, b] → ℝ: from 7

12. g is differentiable on (a, b)
    thm:derivative-linear D := [a, b], U := (a, b), m := (f(a) − f(b))/(b − a), g := g, from 3, 4
    requires b − a ≠ 0: inequalities, from H1, H2, H3
    requires (f(a) − f(b))/(b − a) ∈ ℝ: membership, from H4, 1, 2, H1, H2
    requires (a, b) ⊆ [a, b]: mun:open-within-closed
    requires (a, b) is open: mun:open-interval-open
    requires g : [a, b] → ℝ: from 7

13. For all x ∈ (a, b), g′(x) = (f(a) − f(b))/(b − a).
    thm:derivative-linear D := [a, b], U := (a, b), m := (f(a) − f(b))/(b − a), g := g, from 3, 4
    requires b − a ≠ 0: inequalities, from H1, H2, H3
    requires (f(a) − f(b))/(b − a) ∈ ℝ: membership, from H4, 1, 2, H1, H2
    requires (a, b) ⊆ [a, b]: mun:open-within-closed
    requires (a, b) is open: mun:open-interval-open
    requires g : [a, b] → ℝ: from 7

14. F is differentiable on (a, b)
    thm:derivative-sum D := [a, b], U := (a, b), F := F, f := f, g := g, from 3, 5, H6, 12
    requires (a, b) ⊆ [a, b]: mun:open-within-closed
    requires F : [a, b] → ℝ: from 9
    requires g : [a, b] → ℝ: from 7

15. For all x ∈ (a, b), F′(x) = f′(x) + g′(x).
    thm:derivative-sum D := [a, b], U := (a, b), F := F, f := f, g := g, from 3, 5, H6, 12
    requires (a, b) ⊆ [a, b]: mun:open-within-closed
    requires F : [a, b] → ℝ: from 9
    requires g : [a, b] → ℝ: from 7

16. F(a) = f(a) + g(a)
    D2, from 1

17. g(a) = ((f(a) − f(b))/(b − a))·a
    D1, from 1

18. F(b) = f(b) + g(b)
    D2, from 2

19. g(b) = ((f(a) − f(b))/(b − a))·b
    D1, from 2

20. f(a) + g(a) = f(a) + ((f(a) − f(b))/(b − a))·a
    substitute g(a) = ((f(a) − f(b))/(b − a))·a (line 17)

21. f(b) + g(b) = f(b) + ((f(a) − f(b))/(b − a))·b
    substitute g(b) = ((f(a) − f(b))/(b − a))·b (line 19)

22. f(a) + ((f(a) − f(b))/(b − a))·a = f(b) + ((f(a) − f(b))/(b − a))·b
    algebra
    requires b − a ≠ 0: inequalities, from H1, H2, H3
    requires f(a) ∈ ℝ: from H4, 1
    requires f(b) ∈ ℝ: from H4, 2

23. F(a) = F(b)
    calculation
      F(a) = f(a) + g(a)                                       16
           = f(a) + ((f(a) − f(b))/(b − a))·a                  20
           = f(b) + ((f(a) − f(b))/(b − a))·b                  22
           = f(b) + g(b)                                       21
           = F(b)                                              18

24. c ∈ (a, b). F′(c) = 0.
    obtain c: thm:rolle a := a, b := b, f := F, from H3, 11, 14, 23

25. F′(c) = f′(c) + g′(c)
    instantiate x := c in line 15, from 24

26. g′(c) = (f(a) − f(b))/(b − a)
    instantiate x := c in line 13, from 24

27. f′(c) + g′(c) = f′(c) + (f(a) − f(b))/(b − a)
    substitute g′(c) = (f(a) − f(b))/(b − a) (line 26)

28. f′(c) + (f(a) − f(b))/(b − a) = 0
    calculation
      f′(c) + (f(a) − f(b))/(b − a) = f′(c) + g′(c)            27
                                    = F′(c)                    25
                                    = 0                        24

29. f′(c) = (f(b) − f(a))/(b − a)
    algebra, from 28
    requires b − a ≠ 0: inequalities, from H1, H2, H3
    requires f′(c) ∈ ℝ: mun:derivative-real a := a, b := b, f := f, x := c, from H6, 24
    requires f(a) ∈ ℝ: from H4, 1
    requires f(b) ∈ ℝ: from H4, 2

30. There is c ∈ (a, b) with f′(c) = (f(b) − f(a))/(b − a).
    exhibit, from 24, 29
