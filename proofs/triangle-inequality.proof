import mundane definition stdlib/numbers/abs
import mundane theorem    stdlib/numbers/abs-real
import mundane theorem    stdlib/numbers/nonneg-or-neg

theorem abs-bounds
  metamath    leabs, absneg
  let x ∈ ℝ                                                           (H1)
  then x ≤ |x|. −x ≤ |x|.

1.  x ≥ 0 or x < 0
    mun:nonneg-or-neg x := x

2.  x ≤ |x|. −x ≤ |x|.
    cases, from 1

    case
    assume x ≥ 0                                                      (C1)

    2.1.  |x| = x
          mun:abs x := x, from C1

    2.2.  x ≤ |x|
          inequalities, from 2.1
          requires |x| ∈ ℝ: mun:abs-real

    2.3.  −x ≤ |x|
          inequalities, from 2.1, C1
          requires |x| ∈ ℝ: mun:abs-real

    2.4.  x ≤ |x|. −x ≤ |x|.
          join 2.2, 2.3

    case
    assume x < 0                                                      (C2)

    2.5.  |x| = −x
          mun:abs x := x, from C2

    2.6.  −x ≤ |x|
          inequalities, from 2.5
          requires |x| ∈ ℝ: mun:abs-real

    2.7.  x ≤ |x|
          inequalities, from 2.5, C2
          requires |x| ∈ ℝ: mun:abs-real

    2.8.  x ≤ |x|. −x ≤ |x|.
          join 2.6, 2.7


theorem triangle-inequality
  metamath    abstri, over ℂ
  let a ∈ ℝ                                                           (H1)
  let b ∈ ℝ                                                           (H2)
  then |a + b| ≤ |a| + |b|

1.  a + b ≥ 0 or a + b < 0
    mun:nonneg-or-neg x := a + b

2.  a ≤ |a|. −a ≤ |a|.
    thm:abs-bounds x := a

3.  b ≤ |b|. −b ≤ |b|.
    thm:abs-bounds x := b

4.  |a + b| ≤ |a| + |b|
    cases, from 1

    case
    assume a + b ≥ 0                                                  (C1)

    4.1.  |a + b| = a + b
          mun:abs x := a + b, from C1

    4.2.  a + b ≤ |a| + |b|
          inequalities, from 2, 3
          requires |a| ∈ ℝ: mun:abs-real x := a
          requires |b| ∈ ℝ: mun:abs-real x := b

    4.3.  |a + b| ≤ |a| + |b|
          calculation
            |a + b| = a + b                 4.1
                    ≤ |a| + |b|             4.2

    case
    assume a + b < 0                                                  (C2)

    4.4.  |a + b| = −(a + b)
          mun:abs x := a + b, from C2

    4.5.  −(a + b) = −a + −b
          algebra

    4.6.  −a + −b ≤ |a| + |b|
          inequalities, from 2, 3
          requires |a| ∈ ℝ: mun:abs-real x := a
          requires |b| ∈ ℝ: mun:abs-real x := b

    4.7.  |a + b| ≤ |a| + |b|
          calculation
            |a + b| = −(a + b)              4.4
                    = −a + −b               4.5
                    ≤ |a| + |b|             4.6
