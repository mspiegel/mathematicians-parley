import definition         stdlib/functions/image
import mundane theorem    stdlib/functions/value-in-image

theorem member-of-image
  note        A point is in the image of X when F sends some point of X to it.
  let A be a set                                                      (H1)
  let B be a set                                                      (H2)
  let F : A → B                                                       (H3)
  let X ⊆ A                                                           (H4)
  let y be an element                                                 (H5)
  then y ∈ F[X] ↔ there is x ∈ X with F(x) = y
  by          both directions

direction
assume y ∈ F[X]                                                       (D1)

1.  x ∈ X. y = F(x).
    obtain x: def:image u := y, from D1, H4

2.  there is x ∈ X with F(x) = y
    exhibit, from 1

direction
assume there is x ∈ X with F(x) = y                                   (D2)

3.  x ∈ X. F(x) = y.
    obtain x from D2

4.  F(x) ∈ F[X]
    mun:value-in-image Y := X, s := x, from H4, 3

5.  y ∈ F[X]
    substitute F(x) = y (line 3) into line 4
