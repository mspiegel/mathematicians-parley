import mundane theorem    stdlib/numbers/multiply-le

theorem natural-at-most-square
  note        A natural number is at least 1, so multiplying 1 ≤ n by n
              gives n ≤ n·n.
  let n ∈ ℕ                                                           (H1)
  then n ≤ n²

1.  1 ≤ n
    inequalities, from H1

2.  n·1 ≤ n·n
    mun:multiply-le x := 1, y := n, c := n, from 1
    requires n > 0: inequalities, from 1

3.  n² = n·n
    algebra

4.  n ≤ n²
    transitivity, from 2, 3
