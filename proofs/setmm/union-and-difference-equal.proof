import definition         stdlib/sets/difference
import mundane theorem    stdlib/sets/difference-subset
import mundane theorem    stdlib/sets/disjoint-member
import axiom              stdlib/reasoning/excluded-middle
import mundane theorem    stdlib/sets/in-union-left
import mundane theorem    stdlib/sets/in-union-right
import definition         stdlib/sets/subset
import mundane theorem    stdlib/sets/subset-antisymmetric
import definition         stdlib/sets/union
import mundane theorem    stdlib/sets/union-subset

theorem union-and-difference-equal
  note        Since A lies in C and A misses B, C is A together with B
              exactly when what is left of C after A is B: an element of B
              is in C and not in A, and an element of C not in A can only be
              in B.
  let A be a set                                                      (H1)
  let B be a set                                                      (H2)
  let C be a set                                                      (H3)
  assume A ⊆ C                                                        (H4)
  assume A ∩ B = ∅                                                    (H5)
  then A ∪ B = C ↔ C ∖ A = B
  by          both directions

direction
assume A ∪ B = C                                                      (D1)

1.  For all u ∈ C ∖ A, u ∈ B.
    proof
    let u ∈ C ∖ A                                                     (K1)

    1.1.  u ∈ C. u ∉ A.
          def:difference Y := C, Z := A, from K1

    1.2.  u ∈ A ∪ B
          substitute A ∪ B = C (D1) into line 1.1

    1.3.  u ∈ A or u ∈ B
          def:union Y := A, Z := B, from 1.2

    1.4.  u ∈ B
          cases, from 1.3

          case
          assume u ∈ A                                                (C1)

          1.4.1.  u ∉ A
                  restate 1.1, contradicting C1

          case
          assume u ∈ B                                                (C2)

          1.4.2.  u ∈ B
                  restate C2

2.  C ∖ A ⊆ B
    def:subset X := C ∖ A, Y := B, from 1

3.  For all u ∈ B, u ∈ C ∖ A.
    proof
    let u ∈ B                                                         (K2)

    3.1.  u ∈ A ∪ B
          mun:in-union-right Y := A, Z := B, from K2

    3.2.  u ∈ C
          substitute A ∪ B = C (D1) into line 3.1

    3.3.  u ∉ A
          contradiction
          suppose u ∈ A                                               (S)

          3.3.1.  u ∉ B
                  mun:disjoint-member Y := A, Z := B, from H5, S, contradicting K2

    3.4.  u ∈ C ∖ A
          def:difference Y := C, Z := A, from 3.2, 3.3

4.  B ⊆ C ∖ A
    def:subset X := B, Y := C ∖ A, from 3

5.  C ∖ A = B
    mun:subset-antisymmetric X := C ∖ A, Y := B, from 2, 4

direction
assume C ∖ A = B                                                      (D2)

6.  C ∖ A ⊆ C
    mun:difference-subset X := C, Y := A

7.  B ⊆ C
    substitute C ∖ A = B (D2) into line 6

8.  A ∪ B ⊆ C
    mun:union-subset X := A, Y := B, Z := C, from H4, 7

9.  For all u ∈ C, u ∈ A ∪ B.
    proof
    let u ∈ C                                                         (K3)

    9.1.  u ∈ A or u ∉ A
          axi:excluded-middle P := u ∈ A

    9.2.  u ∈ A ∪ B
          cases, from 9.1

          case
          assume u ∈ A                                                (C3)

          9.2.1.  u ∈ A ∪ B
                  mun:in-union-left Y := A, Z := B, from C3

          case
          assume u ∉ A                                                (C4)

          9.2.2.  u ∈ C ∖ A
                  def:difference Y := C, Z := A, from C4, K3

          9.2.3.  u ∈ B
                  substitute C ∖ A = B (D2) into line 9.2.2

          9.2.4.  u ∈ A ∪ B
                  mun:in-union-right Y := A, Z := B, from 9.2.3

10. C ⊆ A ∪ B
    def:subset X := C, Y := A ∪ B, from 9

11. A ∪ B = C
    mun:subset-antisymmetric X := A ∪ B, Y := C, from 8, 10
