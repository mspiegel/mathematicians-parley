import mundane theorem    stdlib/reasoning/or-left
import mundane theorem    stdlib/reasoning/or-right

theorem or-over-and
  metamath    ordi
  note        Either a = 0 holds, and it settles both alternatives, or both
              b = 0 and c = 0 hold, and each settles one. Conversely,
              given a = 0 or b = 0 and a = 0 or c = 0, either a = 0 holds
              or both b = 0 and c = 0 are left.
  let a ∈ ℝ                                                           (H1)
  let b ∈ ℝ                                                           (H2)
  let c ∈ ℝ                                                           (H3)
  then (a = 0 or (b = 0 and c = 0)) ↔ ((a = 0 or b = 0) and (a = 0 or c = 0))

1.  (a = 0 or (b = 0 and c = 0)) ↔ ((a = 0 or b = 0) and (a = 0 or c = 0))
    both directions

    direction
    assume a = 0 or (b = 0 and c = 0)                                 (D1)

    1.1.  (a = 0 or b = 0) and (a = 0 or c = 0)
          cases, from D1

          case
          assume a = 0                                                (C1)

          1.1.1.  a = 0 or b = 0
                  mun:or-left, from C1

          1.1.2.  a = 0 or c = 0
                  mun:or-left, from C1

          1.1.3.  (a = 0 or b = 0) and (a = 0 or c = 0)
                  join 1.1.1, 1.1.2

          case
          assume b = 0 and c = 0                                      (C2)

          1.1.4.  a = 0 or b = 0
                  mun:or-right, from C2

          1.1.5.  a = 0 or c = 0
                  mun:or-right, from C2

          1.1.6.  (a = 0 or b = 0) and (a = 0 or c = 0)
                  join 1.1.4, 1.1.5

    direction
    assume (a = 0 or b = 0) and (a = 0 or c = 0)                      (D2)

    1.2.  a = 0 or b = 0
          join D2

    1.3.  a = 0 or c = 0
          join D2

    1.4.  a = 0 or (b = 0 and c = 0)
          cases, from 1.2

          case
          assume a = 0                                                (C3)

          1.4.1.  a = 0 or (b = 0 and c = 0)
                  mun:or-left, from C3

          case
          assume b = 0                                                (C4)

          1.4.2.  a = 0 or (b = 0 and c = 0)
                  cases, from 1.3

                  case
                  assume a = 0                                        (C5)

                  1.4.2.1.  a = 0 or (b = 0 and c = 0)
                            mun:or-left, from C5

                  case
                  assume c = 0                                        (C6)

                  1.4.2.2.  b = 0 and c = 0
                            join C4, C6

                  1.4.2.3.  a = 0 or (b = 0 and c = 0)
                            mun:or-right, from 1.4.2.2
