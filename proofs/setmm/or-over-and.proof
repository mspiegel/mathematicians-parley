import mundane theorem    stdlib/reasoning/or-left
import mundane theorem    stdlib/reasoning/or-right
import axiom              stdlib/reasoning/excluded-middle
import mundane theorem    stdlib/reasoning/disjunctive-syllogism-left

theorem or-over-and
  metamath    ordi
  note        Either a = 0 holds, and it settles both alternatives, or both
              b = 0 and c = 0 hold, and each settles one. Conversely,
              given a = 0 or b = 0 and a = 0 or c = 0, either a = 0 holds
              or both b = 0 and c = 0 are left.
  let a ∈ ℝ                                                           (H1)
  let b ∈ ℝ                                                           (H2)
  let c ∈ ℝ                                                           (H3)
  then (a = 0 or (b = 0 and c = 0)) ↔ ((a = 0 or b = 0) and (a = 0 or c = 0))
  by          both directions

direction
assume a = 0 or (b = 0 and c = 0)                                     (D1)

1.  (a = 0 or b = 0) and (a = 0 or c = 0)
    cases, from D1

    case
    assume a = 0                                                      (C1)

    1.1.  a = 0 or b = 0
          mun:or-left, from C1

    1.2.  a = 0 or c = 0
          mun:or-left, from C1

    1.3.  (a = 0 or b = 0) and (a = 0 or c = 0)
          join 1.1, 1.2

    case
    assume b = 0 and c = 0                                            (C2)

    1.4.  a = 0 or b = 0
          mun:or-right, from C2

    1.5.  a = 0 or c = 0
          mun:or-right, from C2

    1.6.  (a = 0 or b = 0) and (a = 0 or c = 0)
          join 1.4, 1.5

direction
assume (a = 0 or b = 0) and (a = 0 or c = 0)                          (D2)

2.  a = 0 or b = 0
    restate D2

3.  a = 0 or c = 0
    restate D2

4.  a = 0 or a ≠ 0
    axi:excluded-middle P := a = 0

5.  a = 0 or (b = 0 and c = 0)
    cases, from 4

    case
    assume a = 0                                                      (C3)

    5.1.  a = 0 or (b = 0 and c = 0)
          mun:or-left, from C3

    case
    assume a ≠ 0                                                      (C4)

    5.2.  b = 0
          mun:disjunctive-syllogism-left, from C4, 2

    5.3.  c = 0
          mun:disjunctive-syllogism-left, from C4, 3

    5.4.  b = 0 and c = 0
          join 5.2, 5.3

    5.5.  a = 0 or (b = 0 and c = 0)
          mun:or-right, from 5.4
