import definition         stdlib/divisibility/divides
import definition         stdlib/divisibility/odd

theorem odd-minus-odd
  note        Odd numbers are 2a + 1 and 2b + 1, and their difference is
              2(a − b).
  let A ∈ ℤ                                                           (H1)
  let B ∈ ℤ                                                           (H2)
  assume A is odd                                                     (H3)
  assume B is odd                                                     (H4)
  then 2 divides A − B

1.  a ∈ ℤ. A = 2a + 1.
    obtain a: def:odd n := A, from H3

2.  b ∈ ℤ. B = 2b + 1.
    obtain b: def:odd n := B, from H4

3.  A − B = 2(a − b)
    algebra, from 1, 2

4.  2 divides A − B
    def:divides d := 2, n := A − B, from 3
