import mundane theorem stdlib/divisibility/mod-remainder
import mundane theorem stdlib/numbers/nat-minus-one

theorem minus-one-mod
  note        −1 is (−1)·M + (M − 1), and M − 1 is a remainder, being at
              least 0 and less than M.
  let M ∈ ℕ                                                           (H1)
  then (−1) mod M = M − 1

1.  (−1)·M + (M − 1) = −1
    algebra

2.  There is q ∈ ℤ with q·M + (M − 1) = −1.
    exhibit, from 1

3.  M − 1 ∈ ℕ₀
    mun:nat-minus-one n := M

4.  (−1) mod M = M − 1
    mun:mod-remainder a := −1, m := M, r := M − 1, from 2, 3
    requires M − 1 < M: inequalities
