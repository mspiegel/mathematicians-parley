import mundane theorem    stdlib/counting/card-nat0
import mundane theorem    stdlib/numbers/le-cases
import mundane theorem    stdlib/numbers/nat-real
import mundane theorem    stdlib/numbers/nat0-nonzero
import mundane axiom      stdlib/reasoning/excluded-middle
import mundane theorem    stdlib/reasoning/iff-from-left
import mundane theorem    stdlib/reasoning/or-left
import mundane theorem    stdlib/reasoning/or-right

theorem size-zero-one-or-more
  metamath    hashv01gt1
  note        A whole number is 0, or it is 1, or it is more than 1.
  let M be a set                                                      (H1)
  assume M is finite                                                  (H2)
  then |M| = 0 or |M| = 1 or 1 < |M|

1.  |M| ∈ ℕ₀
    mun:card-nat0, from H2

2.  |M| = 0 or not (|M| = 0)
    mun:excluded-middle P := |M| = 0

3.  |M| = 0 or |M| = 1 or 1 < |M|
    cases, from 2

    case
    assume |M| = 0                                                    (C1)

    3.1.  |M| = 0 or |M| = 1
          mun:or-left P := |M| = 0, Q := |M| = 1, from C1

    3.2.  |M| = 0 or |M| = 1 or 1 < |M|
          mun:or-left P := |M| = 0 or |M| = 1, Q := 1 < |M|, from 3.1

    case
    assume not (|M| = 0)                                              (C2)

    3.3.  |M| ∈ ℕ
          mun:nat0-nonzero m := |M|, from C2, 1

    3.4.  1 ≤ |M|
          inequalities, from 3.3

    3.5.  1 ≤ |M| ↔ 1 < |M| or 1 = |M|
          mun:le-cases x := 1, y := |M|
          requires |M| ∈ ℝ: mun:nat-real m := |M|, from 3.3

    3.6.  1 < |M| or 1 = |M|
          mun:iff-from-left P := 1 ≤ |M|, Q := 1 < |M| or 1 = |M|, from 3.4, 3.5

    3.7.  |M| = 0 or |M| = 1 or 1 < |M|
          cases, from 3.6

          case
          assume 1 < |M|                                              (C3)

          3.7.1.  |M| = 0 or |M| = 1 or 1 < |M|
                  mun:or-right P := |M| = 0 or |M| = 1, Q := 1 < |M|, from C3

          case
          assume 1 = |M|                                              (C4)

          3.7.2.  |M| = 1
                  algebra, from C4

          3.7.3.  |M| = 0 or |M| = 1
                  mun:or-right P := |M| = 0, Q := |M| = 1, from 3.7.2

          3.7.4.  |M| = 0 or |M| = 1 or 1 < |M|
                  mun:or-left P := |M| = 0 or |M| = 1, Q := 1 < |M|, from 3.7.3
