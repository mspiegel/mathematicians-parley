import mundane theorem    stdlib/counting/card-nat0
import mundane theorem    stdlib/numbers/le-cases
import mundane theorem    stdlib/numbers/nat-real
import mundane theorem    stdlib/numbers/nat0-nonzero
import mundane theorem    stdlib/reasoning/disjunctive-syllogism-left
import mundane theorem    stdlib/reasoning/iff-from-left
import mundane theorem    stdlib/reasoning/not-either

theorem size-zero-one-or-more
  note        A whole number is 0, or it is 1, or it is more than 1.
  let M be a set                                                      (H1)
  assume M is finite                                                  (H2)
  then |M| = 0 or |M| = 1 or 1 < |M|

1.  |M| ∈ ℕ₀
    mun:card-nat0, from H2

2.  |M| = 0 or |M| = 1 or 1 < |M|
    contradiction
    suppose not (|M| = 0 or |M| = 1 or 1 < |M|)                       (S)

    2.1.  not (|M| = 0 or |M| = 1). not (1 < |M|).
          mun:not-either, from S

    2.2.  not (|M| = 0). not (|M| = 1).
          mun:not-either, from 2.1

    2.3.  |M| ∈ ℕ
          mun:nat0-nonzero m := |M|, from 1, 2.2

    2.4.  1 ≤ |M|
          inequalities, from 2.3

    2.5.  1 ≤ |M| ↔ 1 < |M| or 1 = |M|
          mun:le-cases x := 1, y := |M|
          requires |M| ∈ ℝ: mun:nat-real m := |M|, from 2.3

    2.6.  1 < |M| or 1 = |M|
          mun:iff-from-left P := 1 ≤ |M|, Q := 1 < |M| or 1 = |M|, from 2.4, 2.5

    2.7.  1 = |M|
          mun:disjunctive-syllogism-left, from 2.1, 2.6, contradicting 2.2
