import mundane theorem stdlib/numbers/floor-between
import mundane theorem stdlib/numbers/less-scaled
import mundane theorem stdlib/numbers/quotient-nonneg

theorem floor-quotient-zero
  note        The floor of A/B is 0 exactly when A/B is in [0, 1). A/B is never
              negative, and it is below 1 exactly when A is below B: if A/B
              were 1 or more, multiplying by B would put B at most A, and if
              A were at least B, dividing by B would put 1 at most A/B.
  let A ∈ ℕ₀                                                          (H1)
  let B ∈ ℕ                                                           (H2)
  then A < B ↔ ⌊A/B⌋ = 0

1.  B·(A/B) = A
    algebra
    requires B ≠ 0: from H2

2.  0 ≤ A/B
    mun:quotient-nonneg x := A, y := B, from H1, H2

3.  A < B ↔ ⌊A/B⌋ = 0
    both directions

    direction
    assume A < B                                                      (C1)

    3.1.  B·(A/B) < B
          transitivity, from 1, C1
          requires B ≠ 0: from H2

    3.2.  A/B < 1
          mun:less-scaled x := A/B, y := 1, c := B, from H2, 3.1

    3.3.  ⌊A/B⌋ = 0
          mun:floor-between x := A/B, k := 0, from 2, 3.2
          requires B ≠ 0: from H2

    direction
    assume ⌊A/B⌋ = 0                                                  (C2)

    3.4.  0 ≤ A/B and A/B < 0 + 1
          mun:floor-between x := A/B, k := 0, from C2
          requires B ≠ 0: from H2

    3.5.  B·(A/B) < B
          mun:less-scaled x := A/B, y := 1, c := B, from H2, 3.4

    3.6.  A < B
          transitivity, from 1, 3.5
          requires B ≠ 0: from H2
