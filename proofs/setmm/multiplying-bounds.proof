import mundane theorem    stdlib/numbers/less-scaled
import mundane theorem    stdlib/numbers/product-nonneg

theorem multiplying-bounds
  note        A·C ≤ B·C because (B − A)·C is a product of numbers at least 0,
              and B·C < B·D because B is above 0 and C < D.
  let A ∈ ℝ                                                           (H1)
  let B ∈ ℝ                                                           (H2)
  let C ∈ ℝ                                                           (H3)
  let D ∈ ℝ                                                           (H4)
  assume 0 ≤ A                                                        (H5)
  assume A < B                                                        (H6)
  assume 0 ≤ C                                                        (H7)
  assume C < D                                                        (H8)
  then A·C < B·D

1.  B − A ≥ 0
    inequalities, from H6

2.  (B − A)·C ≥ 0
    mun:product-nonneg x := B − A, y := C, from H7, 1

3.  (B − A)·C = B·C − A·C
    algebra

4.  A·C ≤ B·C
    inequalities, from 2, 3

5.  B > 0
    inequalities, from H5, H6

6.  B·C < B·D
    mun:less-scaled x := C, y := D, c := B, from H8, 5

7.  A·C < B·D
    calculation
      A·C ≤ B·C        4
          < B·D        6


theorem square-order
  note        If A < B then A·A < B·B by multiplying-bounds. If B ≤ A
              instead, the same argument without strictness gives B·B ≤ A·A,
              which contradicts A·A < B·B.
  let A ∈ ℝ                                                           (H1)
  let B ∈ ℝ                                                           (H2)
  assume A ≥ 0                                                        (H3)
  assume B ≥ 0                                                        (H4)
  then A < B ↔ A·A < B·B

1.  A < B ↔ A·A < B·B
    both directions

    direction
    assume A < B                                                      (D1)

    1.1.  A·A < B·B
          thm:multiplying-bounds C := A, D := B, from D1, H3

    direction
    assume A·A < B·B                                                  (D2)

    1.2.  A < B
          contradiction
          suppose not A < B                                           (S)

          1.2.1.  B ≤ A
                  inequalities, from S

          1.2.2.  A − B ≥ 0
                  inequalities, from 1.2.1

          1.2.3.  (A − B)·B ≥ 0
                  mun:product-nonneg x := A − B, y := B, from H4, 1.2.2

          1.2.4.  (A − B)·A ≥ 0
                  mun:product-nonneg x := A − B, y := A, from H3, 1.2.2

          1.2.5.  (A − B)·B = A·B − B·B
                  algebra

          1.2.6.  (A − B)·A = A·A − A·B
                  algebra

          1.2.7.  B·B ≤ A·A
                  inequalities, from 1.2.3, 1.2.4, 1.2.5, 1.2.6

          1.2.8.  not A·A < B·B
                  inequalities, from 1.2.7, contradicting D2
