import mundane theorem stdlib/numbers/floor-below
import mundane theorem stdlib/numbers/floor-integer

theorem floor-below-non-integer
  note        The floor is at most A, and it is a whole number, so it equals A
              only if A is one. A is not, so the floor is below A.
  let A ∈ ℝ                                                           (H1)
  assume A ∉ ℤ                                                        (H2)
  then ⌊A⌋ < A

1.  ⌊A⌋ ≤ A
    mun:floor-below x := A

2.  ⌊A⌋ ∈ ℤ
    mun:floor-integer x := A

3.  ⌊A⌋ ≠ A
    contradiction
    suppose ⌊A⌋ = A                                                   (S)

    3.1.  A ∈ ℤ
          substitute ⌊A⌋ = A (S) into line 2, contradicting H2

4.  ⌊A⌋ < A
    inequalities, from 1, 3
    requires ⌊A⌋ ∈ ℝ: membership, from 2
