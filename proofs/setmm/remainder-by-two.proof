import definition         stdlib/divisibility/divides
import definition         stdlib/divisibility/even
import mundane theorem    stdlib/divisibility/even-or-odd
import mundane theorem    stdlib/divisibility/mod-remainder
import mundane theorem    stdlib/divisibility/not-both
import definition         stdlib/divisibility/odd
import mundane theorem    stdlib/reasoning/disjunctive-syllogism-left

theorem remainder-by-two
  note        On dividing by 2 the remainder is 1 when N is a whole number of 2's and 1, which is to say odd, and 2 divides N when N is even; an integer is one or the other, never both.
  let N ∈ ℤ                                                           (H1)
  then N mod 2 = 1 ↔ not (2 divides N)

1.  N mod 2 = 1 ↔ not (2 divides N)
    both directions

    direction
    assume N mod 2 = 1                                                (D1)

    1.1.  There is q ∈ ℤ with q·2 + 1 = N.
          mun:mod-remainder a := N, m := 2, r := 1, from D1
          requires 1 < 2: arithmetic

    1.2.  q ∈ ℤ. q·2 + 1 = N.
          obtain q from line 1.1

    1.3.  N = 2q + 1
          algebra, from 1.2

    1.4.  N is odd
          def:odd n := N, from 1.3

    1.5.  not (2 divides N)
          contradiction
          suppose 2 divides N                                         (S1)

          1.5.1.  k ∈ ℤ. N = 2·k.
                  obtain k: def:divides d := 2, n := N, from S1

          1.5.2.  N is even
                  def:even n := N, from 1.5.1

          1.5.3.  N is not odd
                  mun:not-both n := N, from 1.5.2, contradicting 1.4

    direction
    assume not (2 divides N)                                          (D2)

    1.6.  not (N is even)
          contradiction
          suppose N is even                                           (S2)

          1.6.1.  k ∈ ℤ. N = 2k.
                  obtain k: def:even n := N, from S2

          1.6.2.  2 divides N
                  def:divides d := 2, n := N, from 1.6.1, contradicting D2

    1.7.  N is even or N is odd
          mun:even-or-odd

    1.8.  N is odd
          mun:disjunctive-syllogism-left P := N is even, Q := N is odd, from 1.6, 1.7

    1.9.  k ∈ ℤ. N = 2k + 1.
          obtain k: def:odd, from 1.8

    1.10. k·2 + 1 = N
          algebra, from 1.9

    1.11. There is q ∈ ℤ with q·2 + 1 = N.
          exhibit, from 1.10

    1.12. N mod 2 = 1
          mun:mod-remainder a := N, m := 2, r := 1, from 1.11
          requires 1 < 2: arithmetic
