import definition         stdlib/sets/intersection
import definition         stdlib/sets/subset

theorem subset-of-intersection
  note        A set lies inside B and inside C exactly when each of its
              members is in both, that is, in B ∩ C.
  let A be a set                                                      (H1)
  let B be a set                                                      (H2)
  let C be a set                                                      (H3)
  then (A ⊆ B and A ⊆ C) ↔ A ⊆ B ∩ C

1.  (A ⊆ B and A ⊆ C) ↔ A ⊆ B ∩ C
    both directions

    direction
    assume A ⊆ B and A ⊆ C                                            (D1)

    1.1.  For all t ∈ A, t ∈ B.
          def:subset X := A, Y := B, from D1

    1.2.  For all t ∈ A, t ∈ C.
          def:subset X := A, Y := C, from D1

    1.3.  For all t ∈ A, t ∈ B ∩ C.
          proof
          let t ∈ A                                                   (K)

          1.3.1.  t ∈ B ∩ C
                  def:intersection u := t, from 1.1, 1.2

    1.4.  A ⊆ B ∩ C
          def:subset X := A, Y := B ∩ C, from 1.3

    direction
    assume A ⊆ B ∩ C                                                  (D2)

    1.5.  For all t ∈ A, t ∈ B ∩ C.
          def:subset X := A, Y := B ∩ C, from D2

    1.6.  For all t ∈ A, t ∈ B.
          proof
          let t ∈ A                                                   (K)

          1.6.1.  t ∈ B
                  def:intersection u := t, from 1.5

    1.7.  For all t ∈ A, t ∈ C.
          proof
          let t ∈ A                                                   (K)

          1.7.1.  t ∈ C
                  def:intersection u := t, from 1.5

    1.8.  A ⊆ B
          def:subset X := A, Y := B, from 1.6

    1.9.  A ⊆ C
          def:subset X := A, Y := C, from 1.7

    1.10. A ⊆ B and A ⊆ C
          join 1.8, 1.9
