import definition         stdlib/calculus/tends-to
import mundane definition stdlib/calculus/series-sum
import theorem            stdlib/numbers/archimedean
import mundane theorem    stdlib/numbers/abs-difference-lt
import mundane theorem    stdlib/numbers/exponent-step
import mundane theorem    stdlib/numbers/power-nat
import mundane theorem    stdlib/numbers/reciprocal-order
import mundane theorem    stdlib/numbers/reciprocal-positive
import mundane theorem    stdlib/sums/sum-extended
import mundane theorem    stdlib/sums/sum-real
import mundane theorem    stdlib/sums/sum-single

theorem power-of-two-above
  note        Going from k to k + 1 doubles 2^k, and doubling adds at least
              1 to an exponent that is at most 2^k.
  let n ∈ ℕ                                                           (H1)
  then n ≤ 2^n

1.  For all k ∈ ℕ, k ≤ 2^k.
    induction on k starting at 1

    base
    1.1.  1 ≤ 2^1
          arithmetic

    step
    let k ∈ ℕ                                                         (K)
    assume step 1 is true for k, the induction hypothesis             (IH)

    1.2.  2^k ∈ ℕ
          mun:power-nat a := 2, m := k

    1.3.  k + 1 ≤ 2^k + 2^k
          inequalities, from IH, 1.2

    1.4.  2^k + 2^k = 2^k·2
          algebra

    1.5.  2^(k + 1) = 2^k·2
          mun:exponent-step a := 2, m := k

    1.6.  k + 1 ≤ 2^(k + 1)
          calculation
            k + 1 ≤ 2^k + 2^k     1.3
                  = 2^k·2         1.4
                  = 2^(k + 1)     1.5

2.  n ≤ 2^n
    instantiate k := n in line 1

theorem halves-series
  metamath    geoihalfsum
  note        The first n terms add up to 1 − 1/2^n, by induction on n, and
              1/2^n is as small as 1/n or smaller, so the partial sums tend
              to 1.
  ε ranges over ℝ
  n ranges over ℕ
  then Σ(k = 1 to ∞) 1/2^k = 1

1.  For all k ∈ ℕ, 1/2^k ∈ ℝ.
    proof
    let k ∈ ℕ                                                         (K1)

    1.1.  1/2^k ∈ ℝ
          membership

2.  For all m ∈ ℕ, Σ(k = 1 to m) 1/2^k = 1 − 1/2^m.
    induction on m starting at 1

    base
    2.1.  Σ(k = 1 to 1) 1/2^k = 1/2^1
          mun:sum-single a := 1, from 1

    2.2.  1/2^1 = 1 − 1/2^1
          arithmetic

    2.3.  Σ(k = 1 to 1) 1/2^k = 1 − 1/2^1
          calculation
            Σ(k = 1 to 1) 1/2^k = 1/2^1       2.1
                                = 1 − 1/2^1   2.2

    step
    let m ∈ ℕ                                                         (K2)
    assume step 2 is true for m, the induction hypothesis             (IH)

    2.4.  Σ(k = 1 to m + 1) 1/2^k = Σ(k = 1 to m) 1/2^k + 1/2^(m + 1)
          mun:sum-extended a := 1, n := m, from 1
          requires m ≥ 1: inequalities, from K2

    2.5.  Σ(k = 1 to m + 1) 1/2^k = 1 − 1/2^m + 1/2^(m + 1)
          substitute Σ(k = 1 to m) 1/2^k = 1 − 1/2^m (IH) into line 2.4

    2.6.  2^(m + 1) = 2^m·2
          mun:exponent-step a := 2

    2.7.  1/2^(m + 1) = 1/(2^m·2)
          substitute 2^(m + 1) = 2^m·2 (line 2.6)

    2.8.  1 − 1/2^m + 1/(2^m·2) = 1 − 1/(2^m·2)
          algebra

    2.9.  1 − 1/2^m + 1/2^(m + 1) = 1 − 1/2^m + 1/(2^m·2)
          substitute 1/2^(m + 1) = 1/(2^m·2) (line 2.7)

    2.10. 1 − 1/(2^m·2) = 1 − 1/2^(m + 1)
          substitute 1/2^(m + 1) = 1/(2^m·2) (line 2.7)

    2.11. Σ(k = 1 to m + 1) 1/2^k = 1 − 1/2^(m + 1)
          calculation
            Σ(k = 1 to m + 1) 1/2^k = 1 − 1/2^m + 1/2^(m + 1)   2.5
                                    = 1 − 1/2^m + 1/(2^m·2)     2.9
                                    = 1 − 1/(2^m·2)             2.8
                                    = 1 − 1/2^(m + 1)           2.10

3.  For all ε > 0, there exists N ∈ ℕ such that |Σ(k = 1 to n) 1/2^k − 1| < ε for all n ≥ N.
    proof
    let ε ∈ ℝ                                                         (K3)
    assume ε > 0                                                      (A1)

    3.1.  N ∈ ℕ. 1/N < ε.
          obtain N: thm:archimedean x := ε, from A1

    3.2.  For all n ≥ N, |Σ(k = 1 to n) 1/2^k − 1| < ε.
          proof
          let n ∈ ℕ                                                   (K4)
          assume n ≥ N                                                (A2)

          3.2.1.  2^n ∈ ℕ
                  mun:power-nat a := 2, m := n

          3.2.2.  n ≤ 2^n
                  thm:power-of-two-above

          3.2.3.  N ≤ 2^n
                  transitivity, from A2, 3.2.2

          3.2.4.  1/2^n ≤ 1/N
                  mun:reciprocal-order x := N, y := 2^n, from 3.2.3
                  requires N > 0: inequalities, from 3.1
                  requires 2^n > 0: inequalities, from 3.2.1

          3.2.5.  1/2^n < ε
                  transitivity, from 3.2.4, 3.1

          3.2.6.  1/2^n > 0
                  mun:reciprocal-positive x := 2^n
                  requires 2^n > 0: inequalities, from 3.2.1

          3.2.7.  Σ(k = 1 to n) 1/2^k = 1 − 1/2^n
                  instantiate m := n in line 2

          3.2.8.  1 − ε < 1 − 1/2^n
                  inequalities
                    1/2^n < ε            3.2.5
                    −ε < −1/2^n          adding −1/2^n − ε
                    1 − ε < 1 − 1/2^n    adding 1

          3.2.9.  −1/2^n < 0
                  inequalities
                    1/2^n > 0            3.2.6
                    −1/2^n < 0           multiplying by −1

          3.2.10. −1/2^n < ε
                  transitivity, from 3.2.9, A1

          3.2.11. 1 − 1/2^n < 1 + ε
                  inequalities
                    −1/2^n < ε           3.2.10
                    1 − 1/2^n < 1 + ε    adding 1

          3.2.12. 1 − ε < 1 − 1/2^n and 1 − 1/2^n < 1 + ε
                  join 3.2.8, 3.2.11

          3.2.13. |1 − 1/2^n − 1| < ε
                  mun:abs-difference-lt x := 1 − 1/2^n, c := 1, δ := ε, from 3.2.12

          3.2.14. |Σ(k = 1 to n) 1/2^k − 1| < ε
                  substitute Σ(k = 1 to n) 1/2^k = 1 − 1/2^n (line 3.2.7) into line 3.2.13

    3.3.  There exists N ∈ ℕ such that |Σ(k = 1 to n) 1/2^k − 1| < ε for all n ≥ N.
          exhibit, from 3.2

4.  For all n ∈ ℕ, Σ(k = 1 to n) 1/2^k ∈ ℝ.
    proof
    let n ∈ ℕ                                                         (K5)

    4.1.  Σ(k = 1 to n) 1/2^k ∈ ℝ
          mun:sum-real a := 1, b := n, from 1

5.  Σ(k = 1 to n) 1/2^k → 1 as n → ∞
    def:tends-to L := 1, from 3, 4

6.  Σ(k = 1 to ∞) 1/2^k = 1
    mun:series-sum, from 1, 5
