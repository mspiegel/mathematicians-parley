import mundane definition stdlib/divisibility/even
import mundane theorem    stdlib/divisibility/even-or-odd
import mundane definition stdlib/divisibility/odd

theorem triangular-number-integer
  note        Of two consecutive integers one is even. If n = 2k then
              n(n + 1)/2 is k(2k + 1); if n = 2k + 1 then it is
              (2k + 1)(k + 1).
  let n ∈ ℤ                                                           (H1)
  then n(n + 1)/2 ∈ ℤ

1.  n is even or n is odd
    mun:even-or-odd

2.  n(n + 1)/2 ∈ ℤ
    cases, from 1

    case
    assume n is even                                                  (C1)

    2.1.  k ∈ ℤ. n = 2k.
          obtain k: mun:even, from C1

    2.2.  n(n + 1)/2 = k(2k + 1)
          algebra, from 2.1

    2.3.  n(n + 1)/2 ∈ ℤ
          membership, from 2.2

    case
    assume n is odd                                                   (C2)

    2.4.  k ∈ ℤ. n = 2k + 1.
          obtain k: mun:odd, from C2

    2.5.  n(n + 1)/2 = (2k + 1)(k + 1)
          algebra, from 2.4

    2.6.  n(n + 1)/2 ∈ ℤ
          membership, from 2.5
