import theorem        proofs/setmm/floor-basics/floor-add-integer
import mundane theorem stdlib/divisibility/mod-value
import mundane theorem stdlib/numbers/floor-between
import mundane theorem stdlib/numbers/floor-integer
import mundane theorem stdlib/numbers/less-scaled
import mundane theorem stdlib/numbers/quotient-nonneg

theorem remainder-shifts
  note        Adding K whole copies of M to X changes the whole number below X/M by K and the remainder not at all: the K·M added is exactly what the extra K takes away.
  let X ∈ ℝ                                                           (H1)
  let M ∈ ℝ                                                           (H2)
  assume M > 0                                                        (H3)
  let K ∈ ℤ                                                           (H4)
  then (X + M·K) mod M = X mod M

1.  ⌊X/M⌋ ∈ ℤ
    mun:floor-integer x := X/M
    requires M ≠ 0: weakening, from H3

2.  ⌊X/M + K⌋ = ⌊X/M⌋ + K
    thm:floor-add-integer A := X/M, N := K
    requires M ≠ 0: weakening, from H3

3.  ⌊(X + M·K)/M⌋ = ⌊X/M⌋ + K
    substitute
      ⌊X/M + K⌋ = ⌊X/M⌋ + K          2
      ⌊(X + M·K)/M⌋ = ⌊X/M⌋ + K      algebra
    requires M ≠ 0: weakening, from H3

4.  (X + M·K) mod M = X mod M
    calculation
      (X + M·K) mod M = X + M·K − M·⌊(X + M·K)/M⌋       mun:mod-value a := X + M·K, b := M, from H3
                      = X + M·K − M·(⌊X/M⌋ + K)         substitute line 3
                      = X − M·⌊X/M⌋                     algebra
                      = X mod M                         mun:mod-value a := X, b := M, from H3
    requires ⌊X/M⌋ ∈ ℝ: from 1


theorem remainder-of-small
  note        When A is at least 0 and less than B, A/B is at least 0 and less than 1, so no whole B fits below A, and the remainder is all of A.
  let A ∈ ℝ                                                           (H1)
  let B ∈ ℝ                                                           (H2)
  assume B > 0                                                        (H3)
  assume 0 ≤ A                                                        (H4)
  assume A < B                                                        (H5)
  then A mod B = A

1.  0 ≤ A/B
    mun:quotient-nonneg x := A, y := B, from H3, H4

2.  B·(A/B) = A
    algebra
    requires B ≠ 0: weakening, from H3

3.  B·(A/B) < B
    transitivity, from 2, H5
    requires B ≠ 0: weakening, from H3

4.  A/B < 1
    mun:less-scaled x := A/B, y := 1, c := B, from H3, 3

5.  ⌊A/B⌋ = 0
    mun:floor-between x := A/B, k := 0, from 1, 4
    requires B ≠ 0: weakening, from H3

6.  A mod B = A
    calculation
      A mod B = A − B·⌊A/B⌋     mun:mod-value a := A, b := B, from H3
              = A − B·0         substitute line 5
              = A               algebra
