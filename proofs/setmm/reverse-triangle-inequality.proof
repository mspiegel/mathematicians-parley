import theorem            stdlib/numbers/triangle-inequality
import definition         stdlib/numbers/abs
import mundane theorem    stdlib/numbers/abs-negative
import mundane theorem    stdlib/numbers/nonneg-or-neg

theorem abs-difference-below
  note        A is (A − B) + B, so |A| is at most |A − B| + |B| by the
              triangle inequality, and |A| − |B| is at most |A − B|.
  let A ∈ ℝ                                                           (H1)
  let B ∈ ℝ                                                           (H2)
  then |A| − |B| ≤ |A − B|

1.  |(A − B) + B| ≤ |A − B| + |B|
    thm:triangle-inequality a := A − B, b := B

2.  |A| ≤ |A − B| + |B|
    substitute
      |(A − B) + B| ≤ |A − B| + |B|      1
      |A| ≤ |A − B| + |B|                algebra

3.  |A| − |B| ≤ |A − B|
    inequalities
      |A| ≤ |A − B| + |B|      2
      |A| − |B| ≤ |A − B|      adding −|B|


theorem abs-difference-of-abs
  note        |A| − |B| is at most |A − B|, and so is |B| − |A|, since
              |B − A| is |A − B|. Whichever of the two is not negative is
              ||A| − |B||.
  let A ∈ ℝ                                                           (H1)
  let B ∈ ℝ                                                           (H2)
  then ||A| − |B|| ≤ |A − B|

1.  |A| − |B| ≤ |A − B|
    thm:abs-difference-below

2.  |B| − |A| ≤ |B − A|
    thm:abs-difference-below A := B, B := A

3.  |−(A − B)| = |A − B|
    mun:abs-negative x := A − B

4.  |B − A| = |A − B|
    substitute
      |−(A − B)| = |A − B|      3
      |B − A| = |A − B|         algebra

5.  |B| − |A| ≤ |A − B|
    substitute |B − A| = |A − B| (line 4) into line 2

6.  |A| − |B| ≥ 0 or |A| − |B| < 0
    mun:nonneg-or-neg x := |A| − |B|

7.  ||A| − |B|| ≤ |A − B|
    cases, from 6

    case
    assume |A| − |B| ≥ 0                                              (C1)

    7.1.  ||A| − |B|| = |A| − |B|
          def:abs x := |A| − |B|, from C1

    7.2.  ||A| − |B|| ≤ |A − B|
          transitivity, from 7.1, 1

    case
    assume |A| − |B| < 0                                              (C2)

    7.3.  ||A| − |B|| = −(|A| − |B|)
          def:abs x := |A| − |B|, from C2

    7.4.  −(|A| − |B|) ≤ |A − B|
          inequalities
            |B| − |A| ≤ |A − B|        5
            −(|A| − |B|) ≤ |A − B|     algebra

    7.5.  ||A| − |B|| ≤ |A − B|
          transitivity, from 7.3, 7.4
