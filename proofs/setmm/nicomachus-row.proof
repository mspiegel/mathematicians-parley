import definition           stdlib/numbers/nat0
import mundane theorem      stdlib/sums/sum-add
import mundane theorem      stdlib/sums/sum-constant
import mundane theorem      stdlib/sums/sum-first
import mundane theorem      stdlib/sums/sum-single
import theorem              proofs/setmm/odd-numbers-sum/odd-numbers-sum

theorem nicomachus-row
  metamath    nicomachus
  note        The N terms of row N are N² − N each, plus the first N odd
              numbers, which add up to N².
  let N ∈ ℕ₀                                                          (H1)
  then Σ(k = 1 to N) ((N² − N) + (2k − 1)) = N^3

1.  N ∈ ℕ or N = 0
    def:nat0 n := N

2.  Σ(k = 1 to N) ((N² − N) + (2k − 1)) = N^3
    cases, from 1

    case
    assume N ∈ ℕ                                                      (C1)

    2.1.  Σ(k = 1 to N) ((N² − N) + (2k − 1)) = Σ(k = 1 to N) (N² − N) + Σ(k = 1 to N) (2k − 1)
          mun:sum-add a := 1, b := N

    2.2.  Σ(k = 1 to N) ((N² − N) + (2k − 1)) = (N − 1 + 1)·(N² − N) + Σ(k = 1 to N) (2k − 1)
          substitute
            Σ(k = 1 to N) ((N² − N) + (2k − 1)) = Σ(k = 1 to N) (N² − N) + Σ(k = 1 to N) (2k − 1)      2.1
            Σ(k = 1 to N) ((N² − N) + (2k − 1)) = (N − 1 + 1)·(N² − N) + Σ(k = 1 to N) (2k − 1)        mun:sum-constant a := 1, b := N, c := N² − N
          requires 1 ≤ N: from C1

    2.3.  Σ(k = 1 to N) ((N² − N) + (2k − 1)) = (N − 1 + 1)·(N² − N) + N²
          substitute
            Σ(k = 1 to N) ((N² − N) + (2k − 1)) = (N − 1 + 1)·(N² − N) + Σ(k = 1 to N) (2k − 1)      2.2
            Σ(k = 1 to N) ((N² − N) + (2k − 1)) = (N − 1 + 1)·(N² − N) + N²                          thm:odd-numbers-sum

    2.4.  Σ(k = 1 to N) ((N² − N) + (2k − 1)) = N^3
          calculation
            Σ(k = 1 to N) ((N² − N) + (2k − 1)) = (N − 1 + 1)·(N² − N) + N²    2.3
                                                = N^3                          algebra

    case
    assume N = 0                                                      (C2)

    2.5.  Σ(k = 0 to 0) ((0² − 0) + (2k − 1)) = (0² − 0) + (2·0 − 1)
          mun:sum-single a := 0

    2.6.  Σ(k = 0 to 0) ((0² − 0) + (2k − 1)) = ((0² − 0) + (2·0 − 1)) + Σ(k = 0 + 1 to 0) ((0² − 0) + (2k − 1))
          mun:sum-first n := 0

    2.7.  Σ(k = 0 + 1 to 0) ((0² − 0) + (2k − 1)) = 0
          algebra, from 2.5, 2.6

    2.8.  Σ(k = 1 to 0) ((0² − 0) + (2k − 1)) = 0^3
          calculation
            Σ(k = 1 to 0) ((0² − 0) + (2k − 1)) = 0       2.7
                                                = 0^3     arithmetic

    2.9.  Σ(k = 1 to N) ((N² − N) + (2k − 1)) = N^3
          substitute N = 0 (C2) into line 2.8
