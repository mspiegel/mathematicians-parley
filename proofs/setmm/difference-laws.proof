import definition         stdlib/sets/subset
import definition         stdlib/sets/union
import definition         stdlib/sets/intersection
import definition         stdlib/sets/difference
import mundane theorem    stdlib/sets/subset-antisymmetric
import mundane theorem    stdlib/sets/in-union-left
import mundane theorem    stdlib/sets/in-union-right
import mundane theorem    stdlib/sets/union-commutes
import mundane theorem    stdlib/sets/union-difference
import axiom              stdlib/reasoning/excluded-middle

theorem intersection-with-difference
  note        What A and A ∖ B have in common is A ∖ B, since A ∖ B lies
              inside A.
  let A be a set                                                      (H1)
  let B be a set                                                      (H2)
  then A ∩ (A ∖ B) = A ∖ B

1.  For all u ∈ A ∩ (A ∖ B), u ∈ A ∖ B.
    proof
    let u ∈ A ∩ (A ∖ B)                                               (K1)

    1.1.  u ∈ A and u ∈ A ∖ B
          def:intersection, from K1

    1.2.  u ∈ A ∖ B
          restate 1.1

2.  A ∩ (A ∖ B) ⊆ A ∖ B
    def:subset, from 1

3.  For all u ∈ A ∖ B, u ∈ A ∩ (A ∖ B).
    proof
    let u ∈ A ∖ B                                                     (K2)

    3.1.  u ∈ A and u ∉ B
          def:difference, from K2

    3.2.  u ∈ A and u ∈ A ∖ B
          join K2, 3.1

    3.3.  u ∈ A ∩ (A ∖ B)
          def:intersection, from 3.2

4.  A ∖ B ⊆ A ∩ (A ∖ B)
    def:subset, from 3

5.  A ∩ (A ∖ B) = A ∖ B
    mun:subset-antisymmetric, from 2, 4


theorem difference-of-intersection
  note        Taking away what A shares with B takes away just what A has
              in B.
  let A be a set                                                      (H1)
  let B be a set                                                      (H2)
  then A ∖ (A ∩ B) = A ∖ B

1.  For all u ∈ A ∖ (A ∩ B), u ∈ A ∖ B.
    proof
    let u ∈ A ∖ (A ∩ B)                                               (K1)

    1.1.  u ∈ A and u ∉ A ∩ B
          def:difference, from K1

    1.2.  u ∉ B
          contradiction
          suppose u ∈ B                                               (S1)

          1.2.1.  u ∈ A and u ∈ B
                  join S1, 1.1

          1.2.2.  u ∈ A ∩ B
                  def:intersection, from 1.2.1, contradicting 1.1

    1.3.  u ∈ A and u ∉ B
          join 1.1, 1.2

    1.4.  u ∈ A ∖ B
          def:difference, from 1.3

2.  A ∖ (A ∩ B) ⊆ A ∖ B
    def:subset, from 1

3.  For all u ∈ A ∖ B, u ∈ A ∖ (A ∩ B).
    proof
    let u ∈ A ∖ B                                                     (K2)

    3.1.  u ∈ A and u ∉ B
          def:difference, from K2

    3.2.  u ∉ A ∩ B
          contradiction
          suppose u ∈ A ∩ B                                           (S2)

          3.2.1.  u ∈ A and u ∈ B
                  def:intersection, from S2

          3.2.2.  u ∈ B
                  restate 3.2.1, contradicting 3.1

    3.3.  u ∈ A and u ∉ A ∩ B
          join 3.1, 3.2

    3.4.  u ∈ A ∖ (A ∩ B)
          def:difference, from 3.3

4.  A ∖ B ⊆ A ∖ (A ∩ B)
    def:subset, from 3

5.  A ∖ (A ∩ B) = A ∖ B
    mun:subset-antisymmetric, from 2, 4


theorem difference-then-union
  note        Taking B away from A and putting B back gives A ∪ B, because
              B ∪ (A ∖ B) is B ∪ A.
  let A be a set                                                      (H1)
  let B be a set                                                      (H2)
  then (A ∖ B) ∪ B = A ∪ B

1.  (A ∖ B) ∪ B = B ∪ (A ∖ B)
    mun:union-commutes Y := A ∖ B, Z := B

2.  B ∪ (A ∖ B) = B ∪ A
    mun:union-difference Y := B, Z := A

3.  B ∪ A = A ∪ B
    mun:union-commutes Y := B, Z := A

4.  (A ∖ B) ∪ B = A ∪ B
    calculation
      (A ∖ B) ∪ B = B ∪ (A ∖ B)    1
                  = B ∪ A          2
                  = A ∪ B          3


theorem split-by-membership
  note        Each element of A is in B or not, and the two kinds make up A.
  let A be a set                                                      (H1)
  let B be a set                                                      (H2)
  then (A ∩ B) ∪ (A ∖ B) = A

1.  For all u ∈ (A ∩ B) ∪ (A ∖ B), u ∈ A.
    proof
    let u ∈ (A ∩ B) ∪ (A ∖ B)                                         (K1)

    1.1.  u ∈ A ∩ B or u ∈ A ∖ B
          def:union, from K1

    1.2.  u ∈ A
          cases, from 1.1

          case
          assume u ∈ A ∩ B                                            (C1)

          1.2.1.  u ∈ A and u ∈ B
                  def:intersection, from C1

          1.2.2.  u ∈ A
                  restate 1.2.1

          case
          assume u ∈ A ∖ B                                            (C2)

          1.2.3.  u ∈ A and u ∉ B
                  def:difference, from C2

          1.2.4.  u ∈ A
                  restate 1.2.3

2.  (A ∩ B) ∪ (A ∖ B) ⊆ A
    def:subset, from 1

3.  For all u ∈ A, u ∈ (A ∩ B) ∪ (A ∖ B).
    proof
    let u ∈ A                                                         (K2)

    3.1.  u ∈ B or u ∉ B
          axi:excluded-middle P := u ∈ B

    3.2.  u ∈ (A ∩ B) ∪ (A ∖ B)
          cases, from 3.1

          case
          assume u ∈ B                                                (C3)

          3.2.1.  u ∈ A and u ∈ B
                  join K2, C3

          3.2.2.  u ∈ A ∩ B
                  def:intersection, from 3.2.1

          3.2.3.  u ∈ (A ∩ B) ∪ (A ∖ B)
                  mun:in-union-left, from 3.2.2

          case
          assume u ∉ B                                                (C4)

          3.2.4.  u ∈ A and u ∉ B
                  join K2, C4

          3.2.5.  u ∈ A ∖ B
                  def:difference, from 3.2.4

          3.2.6.  u ∈ (A ∩ B) ∪ (A ∖ B)
                  mun:in-union-right, from 3.2.5

4.  A ⊆ (A ∩ B) ∪ (A ∖ B)
    def:subset, from 3

5.  (A ∩ B) ∪ (A ∖ B) = A
    mun:subset-antisymmetric, from 2, 4
