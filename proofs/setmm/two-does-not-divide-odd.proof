import definition         stdlib/divisibility/divides
import mundane theorem    stdlib/divisibility/divides-one

theorem two-does-not-divide-odd
  note        If 2 divided 2A + 1, say 2A + 1 = 2k, then 2(k − A) = 1, so 2
              would divide 1, and only 1 divides 1.
  let A ∈ ℤ                                                           (H1)
  let B = 2A + 1                                                      (D1)
      reads the odd number after the even number 2A
  then not (2 divides B)

1.  not (2 divides B)
    contradiction
    suppose 2 divides B                                               (S)

    1.1.  k ∈ ℤ. B = 2·k.
          obtain k: def:divides d := 2, n := B, from S
          requires B ∈ ℤ: membership, from D1

    1.2.  2·(k − A) = 1
          algebra, from D1, 1.1

    1.3.  2 divides 1
          def:divides d := 2, n := 1, from 1.2

    1.4.  2 = 1, which is impossible
          mun:divides-one d := 2, from 1.3
