import mundane theorem    stdlib/numbers/exponent-step
import mundane theorem    stdlib/numbers/multiply-le

theorem power-above-one
  note        A power of a number above 1 is above 1: the first power is the
              number itself, and each further power multiplies the one before
              by a number above 1, which only makes it larger.
  let A ∈ ℝ                                                           (H1)
  assume 1 < A                                                        (H2)
  let n ∈ ℕ                                                           (H3)
  then 1 < A^n

1.  For all k ∈ ℕ, 1 < A^k.
    induction on k starting at 1

    base
    1.1.  1 < A^1
          join H2

    step
    let k ∈ ℕ                                                         (K)
    assume step 1 is true for k, the induction hypothesis             (IH)

    1.2.  A^(k + 1) = A^k·A
          mun:exponent-step a := A, m := k

    1.3.  1 ≤ A^k
          inequalities
            1 < A^k                IH
            1 ≤ A^k                weakening

    1.4.  0 < A
          inequalities, from H2

    1.5.  A·1 ≤ A·A^k
          mun:multiply-le x := 1, y := A^k, c := A, from 1.3, 1.4

    1.6.  A·A^k = A^k·A
          algebra

    1.7.  A ≤ A·A^k
          inequalities
            A·1 ≤ A·A^k            1.5
            A ≤ A·A^k              algebra

    1.8.  1 < A·A^k
          transitivity, from H2, 1.7

    1.9.  1 < A^(k + 1)
          calculation
            1 < A·A^k              1.8
              = A^k·A              1.6
              = A^(k + 1)          1.2

2.  1 < A^n
    instantiate k := n in line 1
