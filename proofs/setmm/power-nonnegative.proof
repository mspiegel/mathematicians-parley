import mundane theorem    stdlib/numbers/exponent-step
import mundane theorem    stdlib/numbers/exponent-zero
import mundane theorem    stdlib/numbers/multiply-le
import mundane theorem    stdlib/numbers/power-real
import mundane axiom      stdlib/numbers/trichotomy

theorem power-nonnegative
  note        A power of a nonnegative number is nonnegative: a^0 is 1, and
              a^(m + 1) is a^m·a, a product of two nonnegative numbers.
  let a ∈ ℝ                                                           (H1)
  let n ∈ ℕ₀                                                          (H2)
  assume 0 ≤ a                                                        (H3)
  then 0 ≤ a^n

1.  For all m ∈ ℕ₀, 0 ≤ a^m.
    induction on m starting at 0

    base
    1.1.  a^0 = 1
          mun:exponent-zero

    1.2.  0 ≤ 1
          arithmetic

    1.3.  0 ≤ a^0
          transitivity, from 1.2, 1.1

    step
    let m ∈ ℕ₀                                                        (K)
    assume step 1 is true for m, the induction hypothesis             (IH)

    1.4.  a^(m + 1) = a^m·a
          mun:exponent-step

    1.5.  a^(m + 1) ∈ ℝ
          mun:power-real m := m + 1

    1.6.  a < 0 or a = 0 or 0 < a
          mun:trichotomy x := a

    1.7.  0 ≤ a^(m + 1)
          cases, from 1.6

          case
          assume a < 0                                                (C1)

          1.7.1.  not 0 ≤ a
                  inequalities, from C1, contradicting H3

          case
          assume a = 0                                                (C2)

          1.7.2.  a^m·a = 0
                  algebra, from C2

          1.7.3.  0 = a^(m + 1)
                  transitivity, from 1.7.2, 1.4

          1.7.4.  0 ≤ a^(m + 1)
                  inequalities
                    0 = a^(m + 1)        1.7.3
                    0 ≤ a^(m + 1)        weakening
                  requires a^(m + 1) ∈ ℝ: from 1.5

          case
          assume 0 < a                                                (C3)

          1.7.5.  a·0 ≤ a·a^m
                  mun:multiply-le x := 0, y := a^m, c := a, from C3, IH

          1.7.6.  0 ≤ a^m·a
                  inequalities
                    a·0 ≤ a·a^m          1.7.5
                    0 ≤ a^m·a            algebra

          1.7.7.  0 ≤ a^(m + 1)
                  transitivity, from 1.7.6, 1.4
                  requires a^(m + 1) ∈ ℝ: from 1.5

2.  0 ≤ a^n
    instantiate m := n in line 1
