import mundane theorem    stdlib/numbers/exponent-step
import mundane theorem    stdlib/numbers/exponent-zero
import mundane theorem    stdlib/numbers/multiply-le
import mundane theorem    stdlib/numbers/power-real
import mundane axiom      stdlib/numbers/trichotomy

theorem power-at-most-one
  note        A power of a number between 0 and 1 is at most 1: a^0 is 1,
              and a^(m + 1) is a·a^m, which is at most a·1 when a^m ≤ 1, and
              a ≤ 1. When a is 0 every positive power is 0.
  let a ∈ ℝ                                                           (H1)
  let n ∈ ℕ₀                                                          (H2)
  assume 0 ≤ a                                                        (H3)
  assume a ≤ 1                                                        (H4)
  then a^n ≤ 1

1.  For all m ∈ ℕ₀, a^m ≤ 1.
    induction on m starting at 0

    base
    1.1.  a^0 = 1
          mun:exponent-zero

    1.2.  a^0 ≤ 1
          inequalities, from 1.1

    step
    let m ∈ ℕ₀                                                        (K)
    assume step 1 is true for m, the induction hypothesis             (IH)

    1.3.  a^(m + 1) = a^m·a
          mun:exponent-step

    1.4.  a^m ∈ ℝ
          mun:power-real

    1.5.  a^(m + 1) ∈ ℝ
          mun:power-real m := m + 1

    1.6.  a^m·a = a·a^m
          algebra
          requires a^m ∈ ℝ: from 1.4

    1.7.  a < 0 or a = 0 or 0 < a
          mun:trichotomy x := a

    1.8.  a^(m + 1) ≤ 1
          cases, from 1.7

          case
          assume a < 0                                                (C1)

          1.8.1.  not 0 ≤ a
                  inequalities, from C1, contradicting H3

          case
          assume a = 0                                                (C2)

          1.8.2.  a·a^m = 0
                  algebra, from C2
                  requires a^m ∈ ℝ: from 1.4

          1.8.3.  a^(m + 1) ≤ 1
                  inequalities, from 1.3, 1.4, 1.5, 1.6, 1.8.2

          case
          assume 0 < a                                                (C3)

          1.8.4.  a·a^m ≤ a·1
                  mun:multiply-le x := a^m, y := 1, c := a, from C3, IH, 1.4

          1.8.5.  a^(m + 1) ≤ 1
                  inequalities, from H4, 1.3, 1.4, 1.5, 1.6, 1.8.4

2.  a^n ≤ 1
    instantiate m := n in line 1
