import mundane theorem    stdlib/numbers/exponent-step
import mundane theorem    stdlib/numbers/multiply-le
import mundane axiom      stdlib/numbers/trichotomy

theorem power-at-most-one
  note        A power of a number between 0 and 1 is at most 1: a^0 is 1,
              and a^(m + 1) is a·a^m, which is at most a·1 when a^m ≤ 1, and
              a ≤ 1. When a is 0 every positive power is 0.
  let a ∈ ℝ                                                           (H1)
  let n ∈ ℕ₀                                                          (H2)
  assume 0 ≤ a                                                        (H3)
  assume a ≤ 1                                                        (H4)
  then a^n ≤ 1

1.  For all m ∈ ℕ₀, a^m ≤ 1.
    induction on m starting at 0

    base
    1.1.  a^0 = 1
          algebra

    1.2.  a^0 ≤ 1
          inequalities
            a^0 = 1          1.1
            a^0 ≤ 1          weakening

    step
    let m ∈ ℕ₀                                                        (K)
    assume step 1 is true for m, the induction hypothesis             (IH)

    1.3.  a^(m + 1) = a^m·a
          mun:exponent-step

    1.4.  a^m·a = a·a^m
          algebra

    1.5.  a < 0 or a = 0 or 0 < a
          mun:trichotomy x := a

    1.6.  a^(m + 1) ≤ 1
          cases, from 1.5

          case
          assume a < 0                                                (C1)

          1.6.1.  not 0 ≤ a
                  inequalities, from C1, contradicting H3

          case
          assume a = 0                                                (C2)

          1.6.2.  a·a^m = 0
                  algebra, from C2

          1.6.3.  0 ≤ 1
                  arithmetic

          1.6.4.  a^(m + 1) ≤ 1
                  transitivity, from 1.3, 1.4, 1.6.2, 1.6.3

          case
          assume 0 < a                                                (C3)

          1.6.5.  a·a^m ≤ a·1
                  mun:multiply-le x := a^m, y := 1, c := a, from C3, IH

          1.6.6.  a·a^m ≤ a
                  inequalities
                    a·a^m ≤ a·1      1.6.5
                    a·a^m ≤ a        algebra

          1.6.7.  a^(m + 1) ≤ 1
                  transitivity, from 1.3, 1.4, 1.6.6, H4

2.  a^n ≤ 1
    instantiate m := n in line 1
