import mundane theorem    stdlib/counting/card-disjoint-union
import mundane theorem    stdlib/counting/card-nat0
import mundane theorem    stdlib/counting/finite-part
import axiom              stdlib/reasoning/excluded-middle
import definition         stdlib/sets/difference
import mundane theorem    stdlib/sets/difference-subset
import mundane theorem    stdlib/sets/disjoint-empty
import mundane theorem    stdlib/sets/in-union-left
import mundane theorem    stdlib/sets/in-union-right
import definition         stdlib/sets/subset
import mundane theorem    stdlib/sets/subset-antisymmetric
import mundane theorem    stdlib/sets/union-subset

theorem part-and-rest
  note        A set is a part of it together with the rest: what is in the
              part, and what is in the set but not in the part.
  let A be a set                                                      (H1)
  let B be a set                                                      (H2)
  assume B ⊆ A                                                        (H3)
  then B ∪ (A ∖ B) = A

1.  A ∖ B ⊆ A
    mun:difference-subset X := A, Y := B

2.  B ∪ (A ∖ B) ⊆ A
    mun:union-subset X := B, Y := A ∖ B, Z := A, from H3, 1

3.  For all u ∈ A, u ∈ B ∪ (A ∖ B).
    proof
    let u ∈ A                                                         (K)

    3.1.  u ∈ B or u ∉ B
          axi:excluded-middle P := u ∈ B

    3.2.  u ∈ B ∪ (A ∖ B)
          cases, from 3.1

          case
          assume u ∈ B                                                (C1)

          3.2.1.  u ∈ B ∪ (A ∖ B)
                  mun:in-union-left Y := B, Z := A ∖ B, from C1

          case
          assume u ∉ B                                                (C2)

          3.2.2.  u ∈ A ∖ B
                  def:difference Y := A, Z := B, from C2, K

          3.2.3.  u ∈ B ∪ (A ∖ B)
                  mun:in-union-right Y := B, Z := A ∖ B, from 3.2.2

4.  A ⊆ B ∪ (A ∖ B)
    def:subset X := A, Y := B ∪ (A ∖ B), from 3

5.  B ∪ (A ∖ B) = A
    mun:subset-antisymmetric X := B ∪ (A ∖ B), Y := A, from 2, 4

theorem size-of-difference
  metamath    hashssdif
  note        A is B together with A ∖ B, which have nothing in common, so
              |A| = |B| + |A ∖ B|.
  let A be a set                                                      (H1)
  let B be a set                                                      (H2)
  assume A is finite                                                  (H3)
  assume B ⊆ A                                                        (H4)
  then |A ∖ B| = |A| − |B|

1.  A ∖ B ⊆ A
    mun:difference-subset X := A, Y := B

2.  A ∖ B is finite
    mun:finite-part X := A, Y := A ∖ B, from H3, 1

3.  B is finite
    mun:finite-part X := A, Y := B, from H3, H4

4.  |B| ∈ ℕ₀
    mun:card-nat0 X := B, from 3

5.  |A ∖ B| ∈ ℕ₀
    mun:card-nat0 X := A ∖ B, from 2

6.  For all s ∈ A ∖ B, s ∉ B.
    proof
    let s ∈ A ∖ B                                                     (K)

    6.1.  s ∈ A. s ∉ B.
          def:difference Y := A, Z := B, from K

    6.2.  s ∉ B
          restate 6.1

7.  B ∩ (A ∖ B) = ∅
    mun:disjoint-empty Y := B, Z := A ∖ B, from 6

8.  |B ∪ (A ∖ B)| = |B| + |A ∖ B|
    mun:card-disjoint-union X := B, Y := A ∖ B, m := |B|, n := |A ∖ B|, from 4, 5, 7

9.  |A| = |B| + |A ∖ B|
    substitute
      |B ∪ (A ∖ B)| = |B| + |A ∖ B|      8
      |A| = |B| + |A ∖ B|                thm:part-and-rest, from H4

10. |A ∖ B| = |A| − |B|
    algebra, from 4, 5, 9
