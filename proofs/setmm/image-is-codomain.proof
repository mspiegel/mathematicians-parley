import mundane theorem    stdlib/functions/image-within
import mundane theorem    stdlib/functions/value-in-image
import mundane definition stdlib/sets/subset
import mundane theorem    stdlib/sets/subset-antisymmetric
import mundane theorem    stdlib/sets/subset-self

theorem image-is-codomain
  note        F reaches every point of B, so the image of A is all of B; it is inside B anyway.
  let A be a set                                                      (H1)
  let B be a set                                                      (H2)
  let F : A → B                                                       (H3)
  assume for all y ∈ B, there is x ∈ A with y = F(x)                  (H4)
  then F[A] = B

1.  F[A] ⊆ B
    mun:image-within f := F

2.  For all y ∈ B, y ∈ F[A].
    proof
    let y ∈ B                                                         (K1)

    2.1.  x ∈ A. y = F(x).
          obtain x from H4

    2.2.  F(x) ∈ F[A]
          mun:value-in-image Y := A, s := x, from 2.1
          requires A ⊆ A: mun:subset-self

    2.3.  y ∈ F[A]
          substitute y = F(x) (line 2.1) into line 2.2

3.  B ⊆ F[A]
    mun:subset, from 2

4.  F[A] = B
    mun:subset-antisymmetric, from 1, 3
