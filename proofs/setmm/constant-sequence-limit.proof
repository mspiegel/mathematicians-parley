import definition         stdlib/calculus/tends-to
import mundane theorem    stdlib/numbers/abs-zero
import mundane theorem    stdlib/numbers/abs-real

theorem constant-sequence-limit
  note        Every term is c, so every term is at distance 0 from c, which
              is less than any ε > 0.
  ε ranges over ℝ
  n ranges over ℕ
  let c ∈ ℝ                                                           (H1)
  let x : ℕ → ℝ                                                       (H2)
  assume for all n ∈ ℕ, x(n) = c                                     (H3)
  then x(n) → c as n → ∞

1.  For all ε > 0, there exists N ∈ ℕ such that |x(n) − c| < ε for all n ≥ N.
    proof
    let ε ∈ ℝ                                                         (K1)
    assume ε > 0                                                      (A1)

    1.1.  For all n ≥ 1, |x(n) − c| < ε.
          proof
          let n ∈ ℕ                                                   (K2)
          assume n ≥ 1                                                (A2)

          1.1.1.  x(n) = c
                  instantiate n := n in H3

          1.1.2.  x(n) − c = 0
                  algebra, from 1.1.1

          1.1.3.  |x(n) − c| = |0|
                  substitute x(n) − c = 0 (line 1.1.2)

          1.1.4.  |0| = 0
                  mun:abs-zero

          1.1.5.  |x(n) − c| = 0
                  calculation
                    |x(n) − c| = |0|     1.1.3
                               = 0       1.1.4

          1.1.6.  |x(n) − c| < ε
                  transitivity, from 1.1.5, A1
                  requires x(n) − c ∈ ℝ: membership, from H2
                  requires |x(n) − c| ∈ ℝ: mun:abs-real x := x(n) − c

    1.2.  There exists N ∈ ℕ such that |x(n) − c| < ε for all n ≥ N.
          exhibit, from 1.1

2.  x(n) → c as n → ∞
    def:tends-to L := c, from 1
