import mundane theorem    stdlib/numbers/pos-int-nat
import mundane definition stdlib/numbers/irrational
import mundane definition stdlib/numbers/rational
import mundane axiom      stdlib/numbers/trichotomy

theorem rational-sum
  note        Write A as p/q and B as r/s. Their sum is (p·s + r·q)/(q·s),
              with a whole numerator and a positive denominator.
  let A ∈ ℚ                                                           (H1)
  let B ∈ ℚ                                                           (H2)
  then A + B ∈ ℚ

1.  p ∈ ℤ. q ∈ ℕ. A = p/q.
    obtain p, q: mun:rational x := A

2.  r ∈ ℤ. s ∈ ℕ. B = r/s.
    obtain r, s: mun:rational x := B

3.  A + B = (p·s + r·q)/(q·s)
    algebra, from 1, 2

4.  There are a ∈ ℤ and b ∈ ℕ with A + B = a/b.
    exhibit, from 3

5.  A + B ∈ ℚ
    mun:rational x := A + B, from 4


theorem rational-negative
  note        Write A as p/q. Then −A is (−p)/q, with −p whole.
  let A ∈ ℚ                                                           (H1)
  then −A ∈ ℚ

1.  p ∈ ℤ. q ∈ ℕ. A = p/q.
    obtain p, q: mun:rational x := A

2.  −A = (−p)/q
    algebra, from 1

3.  There are a ∈ ℤ and b ∈ ℕ with −A = a/b.
    exhibit, from 2

4.  −A ∈ ℚ
    mun:rational x := −A, from 3


theorem rational-difference
  note        A − B is A + (−B), a sum of two rationals.
  let A ∈ ℚ                                                           (H1)
  let B ∈ ℚ                                                           (H2)
  then A − B ∈ ℚ

1.  A + −B ∈ ℚ
    thm:rational-sum B := −B

2.  A − B = A + −B
    algebra

3.  A − B ∈ ℚ
    substitute A − B = A + −B (line 2) into line 1


theorem rational-product
  note        Write A as p/q and B as r/s. The product is (p·r)/(q·s).
  let A ∈ ℚ                                                           (H1)
  let B ∈ ℚ                                                           (H2)
  then A·B ∈ ℚ

1.  p ∈ ℤ. q ∈ ℕ. A = p/q.
    obtain p, q: mun:rational x := A

2.  r ∈ ℤ. s ∈ ℕ. B = r/s.
    obtain r, s: mun:rational x := B

3.  A·B = (p/q)·B
    substitute A = p/q (line 1)

4.  (p/q)·B = (p/q)·(r/s)
    substitute B = r/s (line 2)

5.  (p/q)·(r/s) = (p·r)/(q·s)
    algebra, from 1, 2

6.  A·B = (p·r)/(q·s)
    calculation
      A·B = (p/q)·B            3
          = (p/q)·(r/s)        4
          = (p·r)/(q·s)        5

7.  There are a ∈ ℤ and b ∈ ℕ with A·B = a/b.
    exhibit, from 6

8.  A·B ∈ ℚ
    mun:rational x := A·B, from 7


theorem rational-reciprocal
  note        Write A as p/q. A is not 0, so p is not 0, and 1/A is q/p. If
              p is above 0 that is a fraction with a natural denominator; if
              p is below 0 it is (−q)/(−p), and −p is above 0.
  let A ∈ ℚ                                                           (H1)
  assume A ≠ 0                                                        (H2)
  then 1/A ∈ ℚ

1.  p ∈ ℤ. q ∈ ℕ. A = p/q.
    obtain p, q: mun:rational x := A

2.  p ≠ 0
    contradiction
    suppose p = 0                                                     (S)

    2.1.  A = 0/q
          substitute p = 0 (S) into line 1

    2.2.  0/q = 0
          algebra, from 1

    2.3.  A = 0
          calculation
            A = 0/q          2.1
              = 0            2.2

    2.4.  A ≠ 0
          join H2, contradicting 2.3

3.  p < 0 or p = 0 or 0 < p
    mun:trichotomy x := p

4.  1/A ∈ ℚ
    cases, from 3

    case
    assume p < 0                                                      (C1)

    4.1.  −p ∈ ℕ
          mun:pos-int-nat m := −p
          requires −p > 0: multiplying by −1, from C1

    4.2.  1/A = (−q)/(−p)
          algebra, from H2, 1, 4.1

    4.3.  There are a ∈ ℤ and b ∈ ℕ with 1/A = a/b.
          exhibit, from 4.1, 4.2

    4.4.  1/A ∈ ℚ
          mun:rational x := 1/A, from 4.3

    case
    assume p = 0                                                      (C2)

    4.5.  p = 0
          join C2, contradicting 2

    case
    assume 0 < p                                                      (C3)

    4.6.  p ∈ ℕ
          mun:pos-int-nat m := p, from C3

    4.7.  1/A = q/p
          algebra, from H2, 1, 2

    4.8.  There are a ∈ ℤ and b ∈ ℕ with 1/A = a/b.
          exhibit, from 4.6, 4.7

    4.9.  1/A ∈ ℚ
          mun:rational x := 1/A, from 4.8


theorem rational-quotient
  note        A/B is A·(1/B), a product of two rationals.
  let A ∈ ℚ                                                           (H1)
  let B ∈ ℚ                                                           (H2)
  assume B ≠ 0                                                        (H3)
  then A/B ∈ ℚ

1.  1/B ∈ ℚ
    thm:rational-reciprocal A := B, from H3

2.  A·(1/B) ∈ ℚ
    thm:rational-product B := 1/B, from 1

3.  A/B = A·(1/B)
    algebra, from H3

4.  A/B ∈ ℚ
    substitute A/B = A·(1/B) (line 3) into line 2


theorem irrational-sum
  note        If A + B were rational, then so would be (A + B) − B, which is
              A.
  let A ∈ ℝ                                                           (H1)
  let B ∈ ℚ                                                           (H2)
  assume A is irrational                                              (H3)
  then A + B is irrational

1.  A ∉ ℚ
    mun:irrational x := A, from H3

2.  A + B ∉ ℚ
    contradiction
    suppose A + B ∈ ℚ                                                 (S)

    2.1.  (A + B) − B ∈ ℚ
          thm:rational-difference A := A + B, from S

    2.2.  (A + B) − B = A
          algebra

    2.3.  A ∈ ℚ
          substitute (A + B) − B = A (line 2.2) into line 2.1

    2.4.  A ∉ ℚ
          join 1, contradicting 2.3

3.  A + B is irrational
    mun:irrational x := A + B, from 2


theorem irrational-product
  note        If A·B were rational, then so would be (A·B)/B, which is A.
  let A ∈ ℝ                                                           (H1)
  let B ∈ ℚ                                                           (H2)
  assume B ≠ 0                                                        (H3)
  assume A is irrational                                              (H4)
  then A·B is irrational

1.  A ∉ ℚ
    mun:irrational x := A, from H4

2.  A·B ∉ ℚ
    contradiction
    suppose A·B ∈ ℚ                                                   (S)

    2.1.  (A·B)/B ∈ ℚ
          thm:rational-quotient A := A·B, from H3, S

    2.2.  (A·B)/B = A
          algebra, from H3

    2.3.  A ∈ ℚ
          substitute (A·B)/B = A (line 2.2) into line 2.1

    2.4.  A ∉ ℚ
          join 1, contradicting 2.3

3.  A·B is irrational
    mun:irrational x := A·B, from 2
