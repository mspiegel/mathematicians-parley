import mundane definition stdlib/numbers/abs
import mundane theorem    stdlib/numbers/floor-above
import mundane theorem    stdlib/numbers/floor-below
import mundane theorem    stdlib/numbers/floor-integer
import mundane theorem    stdlib/numbers/nonneg-or-neg

theorem rounding-error
  note        Rounding A to the nearest whole number, ⌊A + 1/2⌋, is at most
              1/2 above A and less than 1/2 below it, so the error is at
              most 1/2 in size.
  let A ∈ ℝ                                                           (H1)
  then |⌊A + 1/2⌋ − A| ≤ 1/2

1.  ⌊A + 1/2⌋ ∈ ℤ
    mun:floor-integer x := A + 1/2

2.  ⌊A + 1/2⌋ ≤ A + 1/2
    mun:floor-below x := A + 1/2

3.  A + 1/2 < ⌊A + 1/2⌋ + 1
    mun:floor-above x := A + 1/2

let e = ⌊A + 1/2⌋ − A, a real number                                  (D1)
    membership, from 1
    reads the error made in rounding A to the nearest whole number

4.  ⌊A + 1/2⌋ − A ≤ 1/2
    inequalities
      ⌊A + 1/2⌋ ≤ A + 1/2          2
      ⌊A + 1/2⌋ − A ≤ 1/2          adding −A
    requires ⌊A + 1/2⌋ ∈ ℝ: from 1

5.  e ≤ 1/2
    transitivity, from D1, 4
    requires ⌊A + 1/2⌋ ∈ ℝ: from 1

6.  −1/2 < ⌊A + 1/2⌋ − A
    inequalities
      A + 1/2 < ⌊A + 1/2⌋ + 1      3
      −1/2 < ⌊A + 1/2⌋ − A         adding −A − 1
    requires ⌊A + 1/2⌋ ∈ ℝ: from 1

7.  −1/2 < e
    transitivity, from 6, D1
    requires ⌊A + 1/2⌋ ∈ ℝ: from 1

8.  −e ≤ 1/2
    inequalities
      −1/2 < e                     7
      1/2 > −e                     multiplying by −1
      1/2 ≥ −e                     weakening

9.  e ≥ 0 or e < 0
    mun:nonneg-or-neg x := e, from D1

10. |e| ≤ 1/2
    cases, from 9

    case
    assume e ≥ 0                                                      (C1)

    10.1. |e| = e
          mun:abs x := e, from C1, D1

    10.2. |e| ≤ 1/2
          transitivity, from 10.1, 5

    case
    assume e < 0                                                      (C2)

    10.3. |e| = −e
          mun:abs x := e, from C2, D1

    10.4. |e| ≤ 1/2
          transitivity, from 10.3, 8

11. |⌊A + 1/2⌋ − A| ≤ 1/2
    substitute e = ⌊A + 1/2⌋ − A (D1) into line 10
