import theorem        stdlib/numbers/triangle-inequality
import definition         stdlib/numbers/abs
import mundane theorem    stdlib/numbers/abs-negative
import mundane theorem    stdlib/numbers/abs-real
import mundane theorem    stdlib/numbers/nonneg-or-neg

theorem difference-of-magnitudes
  metamath    abs2difabs, over ℝ
  note        |A| is at most |A − B| + |B| and |B| is at most |B − A| + |A|,
              by the triangle inequality, and |B − A| is |A − B|. So |A| − |B|
              and its negative are both at most |A − B|, and the absolute
              value of |A| − |B| is one of the two.
  let A ∈ ℝ                                                           (H1)
  let B ∈ ℝ                                                           (H2)
  then ||A| − |B|| ≤ |A − B|

1.  |(A − B) + B| ≤ |A − B| + |B|
    thm:triangle-inequality a := A − B, b := B

2.  |A| ≤ |A − B| + |B|
    substitute
      |(A − B) + B| ≤ |A − B| + |B|      1
      |A| ≤ |A − B| + |B|                algebra

3.  |(B − A) + A| ≤ |B − A| + |A|
    thm:triangle-inequality a := B − A, b := A

4.  |B| ≤ |B − A| + |A|
    substitute
      |(B − A) + A| ≤ |B − A| + |A|      3
      |B| ≤ |B − A| + |A|                algebra

5.  |−(A − B)| = |A − B|
    mun:abs-negative x := A − B

6.  |B − A| = |A − B|
    substitute
      |−(A − B)| = |A − B|      5
      |B − A| = |A − B|         algebra

7.  |A| ∈ ℝ
    mun:abs-real x := A

8.  |B| ∈ ℝ
    mun:abs-real x := B

9.  |A| − |B| ≥ 0 or |A| − |B| < 0
    mun:nonneg-or-neg x := |A| − |B|
    requires |A| − |B| ∈ ℝ: membership, from 7, 8

10. ||A| − |B|| ≤ |A − B|
    cases, from 9

    case
    assume |A| − |B| ≥ 0                                              (C1)

    10.1. |A| − |B| ≤ |A − B|
          inequalities
            |A| ≤ |A − B| + |B|      2
            |A| − |B| ≤ |A − B|      adding −|B|
          requires |A| ∈ ℝ: from 7
          requires |B| ∈ ℝ: from 8
          requires |A − B| ∈ ℝ: mun:abs-real x := A − B

    10.2. ||A| − |B|| ≤ |A − B|
          calculation
            ||A| − |B|| = |A| − |B|        def:abs x := |A| − |B|, from C1
                        ≤ |A − B|          10.1
          requires |A| − |B| ∈ ℝ: membership, from 7, 8

    case
    assume |A| − |B| < 0                                               (C2)

    10.3. |B| ≤ |A − B| + |A|
          substitute |B − A| = |A − B| (line 6) into line 4

    10.4. −(|A| − |B|) ≤ |A − B|
          inequalities
            |B| ≤ |A − B| + |A|      10.3
            −(|A| − |B|) ≤ |A − B|   adding −|A|
          requires |A| ∈ ℝ: from 7
          requires |B| ∈ ℝ: from 8
          requires |A − B| ∈ ℝ: mun:abs-real x := A − B

    10.5. ||A| − |B|| ≤ |A − B|
          calculation
            ||A| − |B|| = −(|A| − |B|)     def:abs x := |A| − |B|, from C2
                        ≤ |A − B|          10.4
          requires |A| − |B| ∈ ℝ: membership, from 7, 8
