import definition         stdlib/counting/C
import definition         stdlib/counting/factorial
import mundane theorem    stdlib/counting/binomial-zero-index
import mundane theorem    stdlib/counting/factorial-nat
import definition         stdlib/numbers/nat0
import definition         stdlib/sums/range-between

theorem choose-one-less
  note        Choosing N from N + 1 leaves one out, so there are N + 1 ways.
              By the formula, C(N + 1, N) is (N + 1)! over 1!·N!, and
              (N + 1)! is N!·(N + 1). For N = 0 it is C(1, 0), which is 1.
  let N ∈ ℕ₀                                                          (H1)
  then C(N + 1, N) = N + 1

1.  N ∈ ℕ or N = 0
    def:nat0 n := N

2.  C(N + 1, N) = N + 1
    cases, from 1

    case
    assume N ∈ ℕ                                                      (C1)

    2.1.  0 ≤ N. N ≤ N + 1.
          inequalities, from H1

    2.2.  N ∈ {0, …, N + 1}
          def:range-between k := N, a := 0, b := N + 1, from 2.1

    2.3.  (N + 1) − N = 1
          algebra

    2.4.  ((N + 1) − N)! = 1
          calculation
            ((N + 1) − N)! = 1!      substitute line 2.3
                           = 1       def:factorial

    2.5.  (N + 1)! = N!·(N + 1)
          def:factorial n := N

    2.6.  N! ∈ ℕ
          mun:factorial-nat n := N

    2.7.  C(N + 1, N) = N + 1
          calculation
            C(N + 1, N) = (N + 1)!/(((N + 1) − N)!·N!)     def:C n := N + 1, k := N, from 2.2
                        = (N + 1)!/(1·N!)                  substitute line 2.4
                        = N!·(N + 1)/(1·N!)                substitute line 2.5
                        = N + 1                            algebra, from 2.6

    case
    assume N = 0                                                      (C2)

    2.8.  N + 1 = 1
          algebra, from C2

    2.9.  C(N + 1, N) = N + 1
          calculation
            C(N + 1, N) = C(1, N)     substitute line 2.8
                        = C(1, 0)     substitute C2
                        = 1           mun:binomial-zero-index n := 1
                        = N + 1       2.8
