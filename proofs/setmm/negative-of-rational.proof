import mundane definition stdlib/numbers/rational

theorem negative-of-rational
  note        If A is p/q then −A is (−p)/q, and −p is an integer.
  let A ∈ ℚ                                                           (H1)
  then −A ∈ ℚ

1.  p ∈ ℤ. q ∈ ℕ. A = p/q.
    obtain p, q: mun:rational x := A

2.  −A = −p/q
    substitute A = p/q (line 1)

3.  −p/q = (−p)/q
    algebra

4.  −A = (−p)/q
    calculation
      −A = −p/q       2
         = (−p)/q     3

5.  −A ∈ ℚ
    mun:rational x := −A, from 4
