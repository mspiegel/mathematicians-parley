import definition         stdlib/numbers/rational

theorem negative-of-rational
  note        If A is p/q then −A is (−p)/q, and −p is an integer.
  let A ∈ ℚ                                                           (H1)
  then −A ∈ ℚ

1.  p ∈ ℤ. q ∈ ℕ. A = p/q.
    obtain p, q: def:rational x := A

2.  −A = (−p)/q
    calculation
      −A = −p/q       substitute line 1
         = (−p)/q     algebra

3.  −A ∈ ℚ
    def:rational x := −A, from 2
