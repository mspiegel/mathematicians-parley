import definition         stdlib/sets/subset
import definition         stdlib/sets/intersection
import mundane theorem    stdlib/sets/in-subset

theorem subset-of-intersection
  note        A set lies inside B ∩ C exactly when it lies inside each of B
              and C.
  let A be a set                                                      (H1)
  let B be a set                                                      (H2)
  let C be a set                                                      (H3)
  then (A ⊆ B and A ⊆ C) ↔ A ⊆ B ∩ C
  by          both directions

direction
assume A ⊆ B and A ⊆ C                                                (D1)

1.  For all u ∈ A, u ∈ B ∩ C.
    proof
    let u ∈ A                                                         (K1)

    1.1.  u ∈ B
          mun:in-subset X := A, Y := B, from D1, K1

    1.2.  u ∈ C
          mun:in-subset X := A, Y := C, from D1, K1

    1.3.  u ∈ B and u ∈ C
          join 1.1, 1.2

    1.4.  u ∈ B ∩ C
          def:intersection, from 1.3

2.  A ⊆ B ∩ C
    def:subset, from 1

direction
assume A ⊆ B ∩ C                                                      (D2)

3.  For all u ∈ A, u ∈ B and u ∈ C.
    proof
    let u ∈ A                                                         (K2)

    3.1.  u ∈ B ∩ C
          mun:in-subset X := A, Y := B ∩ C, from D2, K2

    3.2.  u ∈ B and u ∈ C
          def:intersection, from 3.1

4.  For all u ∈ A, u ∈ B.
    proof
    let u ∈ A                                                         (K3)

    4.1.  u ∈ B
          restate 3

5.  For all u ∈ A, u ∈ C.
    proof
    let u ∈ A                                                         (K4)

    5.1.  u ∈ C
          restate 3

6.  A ⊆ B
    def:subset, from 4

7.  A ⊆ C
    def:subset X := A, Y := C, from 5

8.  A ⊆ B and A ⊆ C
    join 6, 7
