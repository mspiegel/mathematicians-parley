import mundane theorem stdlib/numbers/floor-above
import mundane theorem stdlib/numbers/floor-below
import mundane theorem stdlib/numbers/floor-integer
import mundane theorem stdlib/numbers/integer-step

theorem floor-is-monotone
  note        If ⌊B⌋ were below ⌊A⌋ it would be at least one short of it, and
              then B would reach ⌊B⌋ + 1 by passing through A, which it does
              not.
  let A ∈ ℝ                                                           (H1)
  let B ∈ ℝ                                                           (H2)
  assume A ≤ B                                                        (H3)
  then ⌊A⌋ ≤ ⌊B⌋

1.  ⌊A⌋ ∈ ℤ
    mun:floor-integer x := A

2.  ⌊B⌋ ∈ ℤ
    mun:floor-integer x := B

3.  ⌊A⌋ ≤ A
    mun:floor-below x := A

4.  B < ⌊B⌋ + 1
    mun:floor-above x := B

5.  ⌊A⌋ ≤ ⌊B⌋
    contradiction
    suppose not ⌊A⌋ ≤ ⌊B⌋                                             (S)

    5.1.  ⌊B⌋ < ⌊A⌋
          inequalities, from S
          requires ⌊A⌋ ∈ ℝ: from 1
          requires ⌊B⌋ ∈ ℝ: from 2

    5.2.  ⌊B⌋ + 1 ≤ ⌊A⌋
          mun:integer-step m := ⌊B⌋, n := ⌊A⌋, from 1, 2, 5.1

    5.3.  ⌊B⌋ + 1 ≤ B
          transitivity, from 5.2, 3, H3
          requires ⌊A⌋ ∈ ℝ: from 1
          requires ⌊B⌋ ∈ ℝ: from 2

    5.4.  not B < ⌊B⌋ + 1
          inequalities, from 5.3, contradicting 4
          requires ⌊B⌋ ∈ ℝ: from 2
