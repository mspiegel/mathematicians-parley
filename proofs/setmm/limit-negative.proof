import definition         stdlib/calculus/tends-to
import mundane theorem    stdlib/numbers/abs-negative

theorem limit-negative
  note        The distance from −x(n) to −L is |−(x(n) − L)|, which is the
              distance from x(n) to L, so the same N works for the same ε.
  ε ranges over ℝ
  n ranges over ℕ
  let x : ℕ → ℝ                                                       (H1)
  let L ∈ ℝ                                                           (H2)
  assume x(n) → L as n → ∞                                            (H3)
  then −x(n) → −L as n → ∞

1.  For all ε > 0, there exists N ∈ ℕ such that |−x(n) − −L| < ε for all n ≥ N.
    proof
    let ε ∈ ℝ                                                         (K1)
    assume ε > 0                                                      (A1)

    1.1.  For all ε > 0, there exists N ∈ ℕ such that |x(n) − L| < ε for all n ≥ N.
          def:tends-to, from H3

    1.2.  There exists N ∈ ℕ such that |x(n) − L| < ε for all n ≥ N.
          instantiate ε := ε in line 1.1, from A1

    1.3.  N ∈ ℕ. |x(n) − L| < ε for all n ≥ N.
          obtain N from line 1.2

    1.4.  For all n ≥ N, |−x(n) − −L| < ε.
          proof
          let n ∈ ℕ                                                   (K2)
          assume n ≥ N                                                (A2)

          1.4.1.  |x(n) − L| < ε
                  instantiate n := n in line 1.3, from A2

          1.4.2.  x(n) − L ∈ ℝ
                  membership, from H1

          1.4.3.  |−(x(n) − L)| = |x(n) − L|
                  mun:abs-negative x := x(n) − L, from 1.4.2

          1.4.4.  −x(n) − −L = −(x(n) − L)
                  algebra
                  requires x(n) ∈ ℝ: from H1

          1.4.5.  |−x(n) − −L| = |−(x(n) − L)|
                  substitute −x(n) − −L = −(x(n) − L) (line 1.4.4)

          1.4.6.  |−x(n) − −L| = |x(n) − L|
                  calculation
                    |−x(n) − −L| = |−(x(n) − L)|     1.4.5
                                 = |x(n) − L|        1.4.3

          1.4.7.  |−x(n) − −L| < ε
                  substitute |−x(n) − −L| = |x(n) − L| (line 1.4.6) into line 1.4.1

    1.5.  There exists N ∈ ℕ such that |−x(n) − −L| < ε for all n ≥ N.
          exhibit, from 1.4

2.  −x(n) → −L as n → ∞
    def:tends-to L := −L, from 1
