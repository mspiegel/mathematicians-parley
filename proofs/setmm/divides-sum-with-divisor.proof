import mundane theorem stdlib/divisibility/divides-difference
import mundane theorem stdlib/divisibility/divides-self
import mundane theorem stdlib/divisibility/divides-sum

theorem divides-sum-with-divisor
  note        M divides M, so if it divides N it divides the sum. Conversely, if
              it divides the sum it divides the sum less M, which is N.
  let M ∈ ℤ                                                           (H1)
  let N ∈ ℤ                                                           (H2)
  then M divides N ↔ M divides M + N

1.  M divides N ↔ M divides M + N
    both directions

    direction
    assume M divides N                                                (D1)

    1.1.  M divides M
          mun:divides-self n := M

    1.2.  M divides M + N
          mun:divides-sum d := M, a := M, b := N, from D1, 1.1

    direction
    assume M divides M + N                                            (D2)

    1.3.  M divides M
          mun:divides-self n := M

    1.4.  M divides M + N − M
          mun:divides-difference d := M, a := M + N, b := M, from D2, 1.3

    1.5.  M + N − M = N
          algebra

    1.6.  M divides N
          substitute M + N − M = N (line 1.5) into line 1.4
