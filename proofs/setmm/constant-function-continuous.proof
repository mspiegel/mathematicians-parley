import definition         stdlib/calculus/continuous-on
import mundane theorem    stdlib/numbers/abs-zero

theorem constant-function-continuous
  note        The values of f at any two points of D are both k, so they
              differ by 0, which is under any ε. Any δ will do; take 1.
  ε, δ range over ℝ
  let D ⊆ ℝ                                                           (H1)
  let k ∈ ℝ                                                           (H2)
  let f : D → ℝ                                                       (H3)
  assume for all x ∈ D, f(x) = k                                      (H4)
  then f is continuous on D

1.  For all a ∈ D, for all ε > 0, there exists δ > 0 such that
    |f(x) − f(a)| < ε for all x ∈ D with |x − a| < δ.
    proof
    let a ∈ D                                                         (K1)

    1.1.  For all ε > 0, there exists δ > 0 such that
          |f(x) − f(a)| < ε for all x ∈ D with |x − a| < δ.
          proof
          let ε ∈ ℝ                                                   (K2)
          assume ε > 0                                                (A1)

          1.1.1.  For all x ∈ D with |x − a| < 1, |f(x) − f(a)| < ε.
                  proof
                  let x ∈ D                                           (K3)
                  assume |x − a| < 1                                  (A2)

                  1.1.1.1.  f(x) = k
                            instantiate x := x in H4, from K3

                  1.1.1.2.  f(a) = k
                            instantiate x := a in H4, from K1

                  1.1.1.3.  f(x) − f(a) = 0
                            algebra, from 1.1.1.1, 1.1.1.2

                  1.1.1.4.  |f(x) − f(a)| < ε
                            calculation
                              |f(x) − f(a)| = |0|    substitute line 1.1.1.3
                                            = 0      mun:abs-zero
                                            < ε      A1

          1.1.2.  There exists δ > 0 such that
                  |f(x) − f(a)| < ε for all x ∈ D with |x − a| < δ.
                  exhibit, from 1.1.1
                  requires 1 > 0: arithmetic

2.  f is continuous on D
    def:continuous-on, from H1, 1
