import mundane theorem    stdlib/reasoning/double-negation
import mundane theorem    stdlib/reasoning/not-either

theorem not-both
  metamath-counterpart ianor
  note        Both fail to hold together exactly when one of them fails: if
              neither a ≠ 0 nor b ≠ 0, then a = 0 and b = 0 both hold.
  let a ∈ ℝ                                                           (H1)
  let b ∈ ℝ                                                           (H2)
  then not (a = 0 and b = 0) ↔ (a ≠ 0 or b ≠ 0)
  by          both directions

direction
assume not (a = 0 and b = 0)                                          (D1)
by          contradiction
suppose not (a ≠ 0 or b ≠ 0)                                          (S)

1.  not (a ≠ 0). not (b ≠ 0).
    mun:not-either, from S

2.  a = 0
    mun:double-negation, from 1

3.  b = 0
    mun:double-negation, from 1

4.  a = 0 and b = 0
    join 2, 3, contradicting D1

direction
assume a ≠ 0 or b ≠ 0                                                 (D2)

5.  not (a = 0 and b = 0)
    cases, from D2

    case
    assume a ≠ 0                                                      (C1)
    by          contradiction
    suppose a = 0 and b = 0                                           (S1)

    5.1.  a ≠ 0
          restate C1, contradicting S1

    case
    assume b ≠ 0                                                      (C2)
    by          contradiction
    suppose a = 0 and b = 0                                           (S2)

    5.2.  b ≠ 0
          restate C2, contradicting S2
