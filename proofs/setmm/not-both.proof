import mundane axiom      stdlib/reasoning/excluded-middle
import mundane theorem    stdlib/reasoning/or-left
import mundane theorem    stdlib/reasoning/or-right

theorem not-both
  metamath    ianor
  note        Both fail to hold together exactly when one of them fails: if
              a = 0, then b = 0 must fail, and if a = 0 fails we are done.
  let a ∈ ℝ                                                           (H1)
  let b ∈ ℝ                                                           (H2)
  then not (a = 0 and b = 0) ↔ (a ≠ 0 or b ≠ 0)

1.  not (a = 0 and b = 0) ↔ (a ≠ 0 or b ≠ 0)
    both directions

    direction
    assume not (a = 0 and b = 0)                                      (D1)

    1.1.  a = 0 or a ≠ 0
          mun:excluded-middle P := a = 0

    1.2.  a ≠ 0 or b ≠ 0
          cases, from 1.1

          case
          assume a = 0                                                (C1)

          1.2.1.  b ≠ 0
                  contradiction
                  suppose b = 0                                       (S)

                  1.2.1.1.  a = 0 and b = 0
                            join C1, S

                  1.2.1.2.  not (a = 0 and b = 0)
                            join D1, contradicting 1.2.1.1

          1.2.2.  a ≠ 0 or b ≠ 0
                  mun:or-right, from 1.2.1

          case
          assume a ≠ 0                                                (C2)

          1.2.3.  a ≠ 0 or b ≠ 0
                  mun:or-left, from C2

    direction
    assume a ≠ 0 or b ≠ 0                                             (D2)

    1.3.  not (a = 0 and b = 0)
          cases, from D2

          case
          assume a ≠ 0                                                (C3)

          1.3.1.  not (a = 0 and b = 0)
                  contradiction
                  suppose a = 0 and b = 0                             (S1)

                  1.3.1.1.  a ≠ 0
                            join C3, contradicting S1

          case
          assume b ≠ 0                                                (C4)

          1.3.2.  not (a = 0 and b = 0)
                  contradiction
                  suppose a = 0 and b = 0                             (S2)

                  1.3.2.1.  b ≠ 0
                            join C4, contradicting S2
