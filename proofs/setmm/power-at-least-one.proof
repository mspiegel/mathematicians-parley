import mundane theorem    stdlib/numbers/exponent-step
import mundane theorem    stdlib/numbers/multiply-le

theorem power-at-least-one
  note        A power of a number that is at least 1 is at least 1: a^0 is
              1, and a^(m + 1) is a^m·a, where multiplying 1 ≤ a^m by a
              gives a ≤ a·a^m, and 1 ≤ a.
  let a ∈ ℝ                                                           (H1)
  let n ∈ ℕ₀                                                          (H2)
  assume 1 ≤ a                                                        (H3)
  then 1 ≤ a^n

1.  a > 0
    inequalities, from H3

2.  For all m ∈ ℕ₀, 1 ≤ a^m.
    induction on m starting at 0

    base
    2.1.  a^0 = 1
          algebra

    2.2.  1 ≤ a^0
          inequalities
            a^0 = 1            2.1
            1 = a^0            restate
            1 ≤ a^0            weakening

    step
    let m ∈ ℕ₀                                                        (K)
    assume step 2 is true for m, the induction hypothesis             (IH)

    2.3.  a^(m + 1) = a^m·a
          mun:exponent-step

    2.4.  a·1 ≤ a·a^m
          mun:multiply-le x := 1, y := a^m, c := a, from IH, 1

    2.5.  a ≤ a^m·a
          inequalities
            a·1 ≤ a·a^m        2.4
            a ≤ a^m·a          algebra

    2.6.  1 ≤ a^(m + 1)
          transitivity, from H3, 2.5, 2.3

3.  1 ≤ a^n
    instantiate m := n in line 2
