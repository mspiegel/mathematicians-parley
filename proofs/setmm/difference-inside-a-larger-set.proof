import definition         stdlib/sets/difference
import definition         stdlib/sets/intersection
import definition         stdlib/sets/subset
import mundane theorem    stdlib/sets/in-subset
import mundane theorem    stdlib/sets/subset-antisymmetric

theorem difference-inside-a-larger-set
  note        Taking B out of A leaves what is in A and not in B; taking B
              out of C and keeping the part in A leaves the same, since A is
              inside C.
  let A be a set                                                      (H1)
  let B be a set                                                      (H2)
  let C be a set                                                      (H3)
  assume A ⊆ C                                                        (H4)
  then A ∖ B = (C ∖ B) ∩ A

1.  For all t ∈ A ∖ B, t ∈ (C ∖ B) ∩ A.
    proof
    let t ∈ A ∖ B                                                     (K1)

    1.1.  t ∈ A. t ∉ B.
          def:difference u := t, Y := A, Z := B, from K1

    1.2.  t ∈ C
          mun:in-subset X := A, Y := C, u := t, from H4, 1.1

    1.3.  t ∈ C ∖ B
          def:difference u := t, Y := C, Z := B, from 1.1, 1.2

    1.4.  t ∈ (C ∖ B) ∩ A
          def:intersection u := t, Y := C ∖ B, Z := A, from 1.1, 1.3

2.  A ∖ B ⊆ (C ∖ B) ∩ A
    def:subset, from 1

3.  For all t ∈ (C ∖ B) ∩ A, t ∈ A ∖ B.
    proof
    let t ∈ (C ∖ B) ∩ A                                               (K2)

    3.1.  t ∈ C ∖ B. t ∈ A.
          def:intersection u := t, Y := C ∖ B, Z := A, from K2

    3.2.  t ∈ C. t ∉ B.
          def:difference u := t, Y := C, Z := B, from 3.1

    3.3.  t ∈ A ∖ B
          def:difference u := t, Y := A, Z := B, from 3.1, 3.2

4.  (C ∖ B) ∩ A ⊆ A ∖ B
    def:subset, from 3

5.  A ∖ B = (C ∖ B) ∩ A
    mun:subset-antisymmetric, from 2, 4
