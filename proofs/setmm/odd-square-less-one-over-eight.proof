import definition         stdlib/divisibility/odd
import theorem            proofs/setmm/triangular-number-integer/triangular-number-integer

theorem odd-square-less-one-over-eight
  note        An odd n is 2k + 1, so n² − 1 is 4k(k + 1), and dividing by 8
              leaves k(k + 1)/2, which is an integer.
  let n ∈ ℤ                                                           (H1)
  assume n is odd                                                     (H2)
  then (n² − 1)/8 ∈ ℤ

1.  k ∈ ℤ. n = 2k + 1.
    obtain k: def:odd, from H2

2.  (n² − 1)/8 = k(k + 1)/2
    algebra, from 1

3.  k(k + 1)/2 ∈ ℤ
    thm:triangular-number-integer n := k

4.  (n² − 1)/8 ∈ ℤ
    membership, from 2, 3
