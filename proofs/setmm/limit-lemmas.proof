import theorem            proofs/wiedijk/triangle-inequality/abs-bounds
import mundane theorem    stdlib/numbers/abs-product
import mundane theorem    stdlib/numbers/abs-real
import mundane theorem    stdlib/numbers/multiply-le
import mundane theorem    stdlib/numbers/quotient-nonneg
import mundane theorem    stdlib/numbers/quotient-real
import mundane theorem    stdlib/numbers/real-closure

theorem abs-nonneg
  note        |x| is at least x and at least −x, so it is at least their
              average, 0.
  let x ∈ ℝ                                                           (H1)
  then |x| ≥ 0

1.  x ≤ |x|. −x ≤ |x|.
    thm:abs-bounds

2.  |x| ≥ 0
    inequalities, from 1
    requires |x| ∈ ℝ: mun:abs-real

theorem quotient-positive
  note        A quotient of a positive number by a positive number is at
              least 0, and it is not 0, for then the dividend would be 0.
  let x ∈ ℝ                                                           (H1)
  let y ∈ ℝ                                                           (H2)
  assume x > 0                                                        (H3)
  assume y > 0                                                        (H4)
  then x/y > 0

1.  x/y ≥ 0
    mun:quotient-nonneg, from H4
    requires x ≥ 0: inequalities, from H3

2.  x/y ≠ 0
    contradiction
    suppose x/y = 0                                                   (S)

    2.1.  x = 0
          algebra, from S
          requires y ≠ 0: inequalities, from H4

    2.2.  x ≠ 0
          inequalities, from H3, contradicting 2.1

3.  x/y > 0
    inequalities, from 1, 2
    requires y ≠ 0: inequalities, from H4

theorem scaled-small
  note        If |u| is under ε/(2d), where d = |C| + 1, then |C·u| =
              |C|·|u| is at most d·|u|, which is at most d·(ε/(2d)) = ε/2,
              and that is under ε.
  let C ∈ ℝ                                                           (H1)
  let u ∈ ℝ                                                           (H2)
  let ε ∈ ℝ                                                           (H3)
  assume ε > 0                                                        (H4)
  assume |u| < ε/(2·(|C| + 1))                                        (H5)
  then |C·u| < ε

1.  |C| ∈ ℝ
    mun:abs-real x := C

2.  |C| ≥ 0
    thm:abs-nonneg x := C

let d = |C| + 1, a real number                                        (D1)
    mun:real-closure x := |C|, y := 1, from 1
    reads one more than the size of C

3.  d > 0
    inequalities, from D1, 1, 2

4. 2·d ≠ 0
    inequalities, from 3

5.  ε/(2·d) ∈ ℝ
    mun:quotient-real x := ε, y := 2·d, from 4

6.  |u| ≤ ε/(2·d)
    inequalities, from D1, H5, 1, 4
    requires |u| ∈ ℝ: mun:abs-real x := u

7.  d·|u| ≤ d·(ε/(2·d))
    mun:multiply-le x := |u|, y := ε/(2·d), c := d, from 3, 5, 6
    requires |u| ∈ ℝ: mun:abs-real x := u

8.  d·(ε/(2·d)) = ε/2
    algebra
    requires 2·d ≠ 0: inequalities, from 3

9.  d·|u| = |C|·|u| + |u|
    algebra, from D1, 1
    requires |u| ∈ ℝ: mun:abs-real x := u

10. |u| ≥ 0
    thm:abs-nonneg x := u

11. |C|·|u| ≤ ε/2
    inequalities, from 1, 3, 7, 8, 9, 10
    requires d ≠ 0: inequalities, from 3
    requires |u| ∈ ℝ: mun:abs-real x := u

12. |C·u| = |C|·|u|
    mun:abs-product x := C, y := u

13. |C·u| < ε
    inequalities, from H4, 1, 11, 12
    requires |C·u| ∈ ℝ: mun:abs-real x := C·u
    requires |u| ∈ ℝ: mun:abs-real x := u
