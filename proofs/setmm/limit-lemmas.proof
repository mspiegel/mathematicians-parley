import theorem            proofs/wiedijk/triangle-inequality/abs-bounds
import mundane theorem    stdlib/numbers/abs-product
import mundane theorem    stdlib/numbers/abs-real
import mundane theorem    stdlib/numbers/multiply-le
import mundane theorem    stdlib/numbers/quotient-nonneg
import mundane theorem    stdlib/numbers/real-closure

theorem abs-nonneg
  note        |x| is at least x and at least −x, so it is at least their
              average, 0.
  let x ∈ ℝ                                                           (H1)
  then |x| ≥ 0

1.  x ≤ |x|. −x ≤ |x|.
    thm:abs-bounds

2.  0 ≤ 2·|x|
    inequalities, from 1
    requires |x| ∈ ℝ: mun:abs-real

3.  |x| ≥ 0
    inequalities
      0 ≤ 2·|x|        2
      0 ≤ |x|          multiplying by 1/2
      |x| ≥ 0          restate
    requires |x| ∈ ℝ: mun:abs-real

theorem quotient-positive
  note        A quotient of a positive number by a positive number is at
              least 0, and it is not 0, for then the dividend would be 0.
  let x ∈ ℝ                                                           (H1)
  let y ∈ ℝ                                                           (H2)
  assume x > 0                                                        (H3)
  assume y > 0                                                        (H4)
  then x/y > 0

1.  x/y ≥ 0
    mun:quotient-nonneg, from H4
    requires x ≥ 0: weakening, from H3

2.  x/y ≠ 0
    contradiction
    suppose x/y = 0                                                   (S)

    2.1.  x = 0
          algebra, from S
          requires y ≠ 0: weakening, from H4

    2.2.  x ≠ 0
          inequalities, contradicting 2.1
            x > 0            H3
            x ≠ 0            weakening

3.  x/y > 0
    inequalities, from 1, 2
    requires y ≠ 0: weakening, from H4

theorem scaled-small
  note        If |u| is under ε/(2d), where d = |C| + 1, then |C·u| =
              |C|·|u| is at most d·|u|, which is at most d·(ε/(2d)) = ε/2,
              and that is under ε.
  let C ∈ ℝ                                                           (H1)
  let u ∈ ℝ                                                           (H2)
  let ε ∈ ℝ                                                           (H3)
  assume ε > 0                                                        (H4)
  assume |u| < ε/(2·(|C| + 1))                                        (H5)
  then |C·u| < ε

1.  |C| ∈ ℝ
    mun:abs-real x := C

2.  |C| ≥ 0
    thm:abs-nonneg x := C

let d = |C| + 1, a real number                                        (D1)
    mun:real-closure x := |C|, y := 1, from 1
    reads one more than the size of C

3.  d > 0
    inequalities, from D1, 1, 2

4. 2·d ≠ 0
    inequalities
      d > 0            3
      2·d > 0          multiplying by 2
      2·d ≠ 0          weakening

5.  |u| < ε/(2·d)
    inequalities, from D1, H5, 1, 4
    requires |u| ∈ ℝ: mun:abs-real x := u

6.  |u| ≤ ε/(2·d)
    inequalities
      |u| < ε/(2·d)    5
      |u| ≤ ε/(2·d)    weakening
    requires d ≠ 0: weakening, from 3
    requires |u| ∈ ℝ: mun:abs-real x := u

7.  d·|u| ≤ d·(ε/(2·d))
    mun:multiply-le x := |u|, y := ε/(2·d), c := d, from 3, 6
    requires |u| ∈ ℝ: mun:abs-real x := u

8.  d·(ε/(2·d)) = ε/2
    algebra
    requires 2·d ≠ 0: from 4

9.  d·|u| = |C|·|u| + |u|
    algebra, from D1, 1
    requires |u| ∈ ℝ: mun:abs-real x := u

10. |u| ≥ 0
    thm:abs-nonneg x := u

11. |C|·|u| ≤ |C|·|u| + |u|
    inequalities
      |u| ≥ 0                      10
      |C|·|u| + |u| ≥ |C|·|u|      adding |C|·|u|
      |C|·|u| ≤ |C|·|u| + |u|      restate
    requires |C| ∈ ℝ: from 1
    requires |u| ∈ ℝ: mun:abs-real x := u

12. |C|·|u| ≤ ε/2
    transitivity, from 11, 9, 7, 8
    requires |C| ∈ ℝ: from 1
    requires d ≠ 0: weakening, from 3
    requires |u| ∈ ℝ: mun:abs-real x := u

13. |C·u| = |C|·|u|
    mun:abs-product x := C, y := u

14. ε/2 < ε
    inequalities
      ε > 0            H4
      ε/2 > 0          multiplying by 1/2
      ε > ε/2          adding ε/2
      ε/2 < ε          restate

15. |C·u| < ε
    transitivity, from 13, 12, 14
    requires |C| ∈ ℝ: from 1
    requires |u| ∈ ℝ: mun:abs-real x := u
