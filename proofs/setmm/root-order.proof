import mundane definition stdlib/numbers/sqrt
import mundane theorem    stdlib/numbers/square-less

theorem root-order
  note        The roots are nonnegative, so they compare as their squares
              do, and the squares of the roots are the numbers themselves.
  let A ∈ ℝ                                                           (H1)
  let B ∈ ℝ                                                           (H2)
  assume 0 ≤ A                                                        (H3)
  assume 0 ≤ B                                                        (H4)
  then A < B ↔ √A < √B

1.  √A ∈ ℝ. √A ≥ 0. (√A)² = A.
    mun:sqrt x := A, from H3

2.  √B ∈ ℝ. √B ≥ 0. (√B)² = B.
    mun:sqrt x := B, from H4

3.  A < B ↔ √A < √B
    both directions

    direction
    assume A < B                                                      (D1)

    3.1.  (√A)² < (√B)²
          transitivity, from 1, D1, 2

    3.2.  √A < √B
          mun:square-less x := √A, y := √B, from 3.1
          requires √A ∈ ℝ: from 1
          requires √B ∈ ℝ: from 2
          requires √A ≥ 0: from 1
          requires √B ≥ 0: from 2

    direction
    assume √A < √B                                                    (D2)

    3.3.  (√A)² < (√B)²
          mun:square-less x := √A, y := √B, from D2
          requires √A ∈ ℝ: from 1
          requires √B ∈ ℝ: from 2
          requires √A ≥ 0: from 1
          requires √B ≥ 0: from 2

    3.4.  A < B
          transitivity, from 1, 3.3, 2
