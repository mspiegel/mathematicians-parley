import mundane theorem    stdlib/reasoning/or-left
import mundane theorem    stdlib/reasoning/or-right

theorem and-over-or
  metamath    andi
  note        If a = 0 and one of b = 0, c = 0 holds, then a = 0 goes with
              whichever it is; and conversely a = 0 is common to both ways.
  let a ∈ ℝ                                                           (H1)
  let b ∈ ℝ                                                           (H2)
  let c ∈ ℝ                                                           (H3)
  then (a = 0 and (b = 0 or c = 0)) ↔ ((a = 0 and b = 0) or (a = 0 and c = 0))

1.  (a = 0 and (b = 0 or c = 0)) ↔ ((a = 0 and b = 0) or (a = 0 and c = 0))
    both directions

    direction
    assume a = 0 and (b = 0 or c = 0)                                 (D1)

    1.1.  a = 0
          join D1

    1.2.  b = 0 or c = 0
          join D1

    1.3.  (a = 0 and b = 0) or (a = 0 and c = 0)
          cases, from 1.2

          case
          assume b = 0                                                (C1)

          1.3.1.  a = 0 and b = 0
                  join 1.1, C1

          1.3.2.  (a = 0 and b = 0) or (a = 0 and c = 0)
                  mun:or-left, from 1.3.1

          case
          assume c = 0                                                (C2)

          1.3.3.  a = 0 and c = 0
                  join 1.1, C2

          1.3.4.  (a = 0 and b = 0) or (a = 0 and c = 0)
                  mun:or-right, from 1.3.3

    direction
    assume (a = 0 and b = 0) or (a = 0 and c = 0)                     (D2)

    1.4.  a = 0 and (b = 0 or c = 0)
          cases, from D2

          case
          assume a = 0 and b = 0                                      (C3)

          1.4.1.  a = 0
                  join C3

          1.4.2.  b = 0
                  join C3

          1.4.3.  b = 0 or c = 0
                  mun:or-left, from 1.4.2

          1.4.4.  a = 0 and (b = 0 or c = 0)
                  join 1.4.1, 1.4.3

          case
          assume a = 0 and c = 0                                      (C4)

          1.4.5.  a = 0
                  join C4

          1.4.6.  c = 0
                  join C4

          1.4.7.  b = 0 or c = 0
                  mun:or-right, from 1.4.6

          1.4.8.  a = 0 and (b = 0 or c = 0)
                  join 1.4.5, 1.4.7
