import definition         stdlib/divisibility/divides

theorem divides-times-common-factor
  note        If N = M·j then N·K = (M·K)·j, so M·K divides N·K.
  let M ∈ ℤ                                                           (H1)
  let N ∈ ℤ                                                           (H2)
  let K ∈ ℤ                                                           (H3)
  assume M divides N                                                  (H4)
  then M·K divides N·K

1.  j ∈ ℤ. N = M·j.
    obtain j: def:divides d := M, n := N, from H4

2.  N·K = M·j·K
    substitute N = M·j (line 1)

3.  M·j·K = (M·K)·j
    algebra

4.  N·K = (M·K)·j
    calculation
      N·K = M·j·K       2
          = (M·K)·j     3

5.  M·K divides N·K
    def:divides d := M·K, n := N·K, from 4
