import mundane theorem    stdlib/counting/card-empty
import mundane theorem    stdlib/counting/card-nat0
import mundane theorem    stdlib/counting/card-zero
import mundane theorem    stdlib/numbers/nat0-nonzero

theorem size-is-natural
  metamath    hashnncl
  note        The size of a finite set is a whole number, and it is not 0
              exactly when the set has an element.
  let A be a set                                                      (H1)
  assume A is finite                                                  (H2)
  then |A| ∈ ℕ ↔ A ≠ ∅

1.  |A| ∈ ℕ ↔ A ≠ ∅
    both directions

    direction
    assume |A| ∈ ℕ                                                    (C1)

    1.1.  A ≠ ∅
          contradiction
          suppose A = ∅                                               (S1)

          1.1.1.  |A| = 0
                  calculation
                    |A| = |∅|     substitute S1
                        = 0       mun:card-empty

          1.1.2.  0 ∉ ℕ
                  arithmetic

          1.1.3.  |A| ∉ ℕ
                  substitute |A| = 0 (line 1.1.1) into line 1.1.2, contradicting C1

    direction
    assume A ≠ ∅                                                      (C2)

    1.2.  |A| ∈ ℕ₀
          mun:card-nat0, from H2

    1.3.  |A| ≠ 0
          contradiction
          suppose |A| = 0                                             (S2)

          1.3.1.  A = ∅
                  mun:card-zero X := A, from S2

          1.3.2.  not (A = ∅)
                  restate C2, contradicting 1.3.1

    1.4.  |A| ∈ ℕ
          mun:nat0-nonzero m := |A|, from 1.2, 1.3
