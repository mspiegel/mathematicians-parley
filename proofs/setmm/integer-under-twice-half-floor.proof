import mundane theorem stdlib/numbers/floor-above
import mundane theorem stdlib/numbers/floor-integer
import mundane theorem stdlib/numbers/integer-step

theorem integer-under-twice-half-floor
  note        With k the floor of (N + 1)/2, (N + 1)/2 is under k + 1, so N
              is under 2k + 1, and between whole numbers that is N at most
              2k.
  let N ∈ ℤ                                                           (H1)
  then N ≤ 2·⌊(N + 1)/2⌋

let k = ⌊(N + 1)/2⌋, an integer                                       (D1)
    mun:floor-integer x := (N + 1)/2
    reads the whole number (N + 1)/2 rounds down to

1.  (N + 1)/2 < k + 1
    mun:floor-above x := (N + 1)/2, from D1

2.  N < 2k + 1
    inequalities, from 1

3.  N + 1 ≤ 2k + 1
    mun:integer-step m := N, n := 2k + 1, from 2

4.  N ≤ 2·⌊(N + 1)/2⌋
    inequalities, from D1, 3
