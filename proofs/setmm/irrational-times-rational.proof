import mundane definition stdlib/sets/difference
import theorem            proofs/setmm/rational-closure/rational-quotient

theorem irrational-times-rational
  note        If A·B were a fraction r/s and B the fraction p/q with p not 0,
              then A would be rq/(sp), a fraction, and A would be rational.
              The denominator sp is a natural number when p is above 0, and
              otherwise A is (−rq)/(s(−p)).
  let A be an element                                                 (H1)
  let B ∈ ℝ                                                           (H2)
  assume A ∈ ℝ ∖ ℚ                                                    (H3)
  assume B ∈ ℚ                                                        (H4)
  assume B ≠ 0                                                        (H5)
  then A·B ∈ ℝ ∖ ℚ

1.  A ∈ ℝ. A ∉ ℚ.
    mun:difference u := A, from H3

2.  A·B ∈ ℝ
    membership, from 1

3.  A·B ∉ ℚ
    contradiction
    suppose A·B ∈ ℚ                                                   (S)

    3.1.  (A·B)/B ∈ ℚ
          thm:rational-quotient A := A·B, from H4, H5, S

    3.2.  (A·B)/B = A
          algebra, from H5
          requires A ∈ ℝ: from 1

    3.3.  A ∈ ℚ
          substitute (A·B)/B = A (line 3.2) into line 3.1

    3.4.  A ∉ ℚ
          restate 1, contradicting 3.3

4.  A·B ∈ ℝ ∖ ℚ
    mun:difference u := A·B, from 2, 3
