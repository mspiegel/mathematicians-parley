import mundane definition stdlib/divisibility/divides
import mundane theorem    stdlib/divisibility/divides-self
import mundane definition stdlib/divisibility/prime
import mundane theorem    stdlib/reasoning/modus-ponens
import mundane theorem    stdlib/reasoning/or-left
import mundane theorem    stdlib/reasoning/or-right

theorem divisor-of-prime
  note        A prime has only 1 and itself as divisors, and each of those
              does divide it.
  let P ∈ ℕ                                                           (H1)
  assume P is prime                                                   (H2)
  let M ∈ ℕ                                                           (H3)
  then M divides P ↔ M = P or M = 1

1.  For all d ∈ ℕ, if d divides P then d = 1 or d = P.
    mun:prime p := P, from H2

2.  If M divides P then M = 1 or M = P.
    instantiate d := M in line 1

3.  M divides P ↔ M = P or M = 1
    both directions

    direction
    assume M divides P                                                (D1)

    3.1.  M = 1 or M = P
          mun:modus-ponens, from D1, 2

    3.2.  M = P or M = 1
          cases, from 3.1

          case
          assume M = 1                                                (C1)

          3.2.1.  M = P or M = 1
                  mun:or-right P := M = P, Q := M = 1, from C1

          case
          assume M = P                                                (C2)

          3.2.2.  M = P or M = 1
                  mun:or-left P := M = P, Q := M = 1, from C2

    direction
    assume M = P or M = 1                                             (D2)

    3.3.  M divides P
          cases, from D2

          case
          assume M = P                                                (C3)

          3.3.1.  P divides P
                  mun:divides-self n := P

          3.3.2.  M divides P
                  substitute M = P (C3) into line 3.3.1

          case
          assume M = 1                                                (C4)

          3.3.3.  1 divides P
                  mun:divides d := 1, n := P

          3.3.4.  M divides P
                  substitute M = 1 (C4) into line 3.3.3
