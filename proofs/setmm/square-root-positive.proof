import mundane definition stdlib/numbers/sqrt

theorem square-root-positive
  note        √a is not negative, and it is not 0, since then a would be its
              square, 0.
  let a ∈ ℝ                                                           (H1)
  assume 0 < a                                                        (H2)
  then 0 < √a

1.  √a ∈ ℝ. √a ≥ 0. (√a)² = a.
    mun:sqrt x := a
    requires a ≥ 0: inequalities, from H2

2.  0 < √a
    contradiction
    suppose not 0 < √a                                                (S)

    2.1.  √a ≤ 0
          inequalities, from S
          requires √a ∈ ℝ: from 1

    2.2.  √a ≥ 0
          inequalities, from 1

    2.3.  √a = 0
          antisymmetry, from 2.1, 2.2
          requires √a ∈ ℝ: from 1

    2.4.  (√a)² = 0
          algebra, from 2.3
          requires √a ∈ ℝ: from 1

    2.5.  a = 0
          algebra, from 1, 2.4

    2.6.  a ≤ 0
          inequalities
            a = 0            2.5
            a ≤ 0            weakening

    2.7.  not 0 < a
          inequalities, from 2.6, contradicting H2
