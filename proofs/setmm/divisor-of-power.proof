import mundane theorem    stdlib/divisibility/divides-multiple
import mundane theorem    stdlib/numbers/exponent-step

theorem divisor-of-power
  note        M^1 is M, and M^(m + 1) is M^m·M, so a divisor of M^m divides
              the next power as well.
  let K ∈ ℤ                                                           (H1)
  let M ∈ ℤ                                                           (H2)
  let n ∈ ℕ                                                           (H3)
  assume K divides M                                                  (H4)
  then K divides M^n

1.  For all m ∈ ℕ, K divides M^m.
    induction on m starting at 1

    base
    1.1.  K divides M^1
          restate H4

    step
    let m ∈ ℕ                                                         (K)
    assume step 1 is true for m, the induction hypothesis             (IH)

    1.2.  K divides M^m·M
          mun:divides-multiple e := K, a := M^m, x := M, from IH

    1.3.  K divides M^(m + 1)
          substitute
            K divides M^m·M          1.2
            K divides M^(m + 1)      mun:exponent-step a := M

2.  K divides M^n
    instantiate m := n in line 1
