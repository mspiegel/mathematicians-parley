import mundane definition stdlib/sets/subset
import mundane definition stdlib/sets/union
import mundane theorem    stdlib/sets/disjoint-member
import mundane theorem    stdlib/sets/in-subset
import mundane theorem    stdlib/sets/in-union-right

theorem subset-of-a-union-with-a-disjoint-set
  note        A point of A is not in B, since A and B share nothing, so if
              it lies in B ∪ C it lies in C.
  let A be a set                                                      (H1)
  let B be a set                                                      (H2)
  let C be a set                                                      (H3)
  assume A ∩ B = ∅                                                    (H4)
  then A ⊆ B ∪ C ↔ A ⊆ C

1.  A ⊆ B ∪ C ↔ A ⊆ C
    both directions

    direction
    assume A ⊆ B ∪ C                                                  (D1)

    1.1.  For all t ∈ A, t ∈ C.
          proof
          let t ∈ A                                                   (K1)

          1.1.1.  t ∉ B
                  mun:disjoint-member Y := A, Z := B, from H4, K1

          1.1.2.  t ∈ B ∪ C
                  mun:in-subset X := A, Y := B ∪ C, u := t, from D1, K1

          1.1.3.  t ∈ B or t ∈ C
                  mun:union u := t, Y := B, Z := C, from 1.1.2

          1.1.4.  t ∈ C
                  cases, from 1.1.3

          case
          assume t ∈ B                                                (C1)

          1.1.4.1.  t ∈ B
                    restate C1, contradicting 1.1.1

          case
          assume t ∈ C, which is the claim                            (C2)

    1.2.  A ⊆ C
          mun:subset, from 1.1

    direction
    assume A ⊆ C                                                      (D2)

    1.3.  For all t ∈ A, t ∈ B ∪ C.
          proof
          let t ∈ A                                                   (K2)

          1.3.1.  t ∈ C
                  mun:in-subset X := A, Y := C, u := t, from D2, K2

          1.3.2.  t ∈ B ∪ C
                  mun:in-union-right Y := B, Z := C, from 1.3.1

    1.4.  A ⊆ B ∪ C
          mun:subset, from 1.3
