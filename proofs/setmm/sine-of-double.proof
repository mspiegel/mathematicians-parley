import theorem            stdlib/trigonometry/sin-add
import mundane theorem    stdlib/trigonometry/cos-complex
import mundane theorem    stdlib/trigonometry/sin-complex
import definition         stdlib/trigonometry/cos
import definition         stdlib/trigonometry/sin

theorem sine-of-double
  metamath    sin2t
  note        Write 2A as A + A and use the addition formula for the sine.
  let A ∈ ℂ                                                           (H1)
  then sin(2·A) = 2·sin(A)·cos(A)

1.  2·A = A + A
    algebra

2.  sin(2·A) = 2·sin(A)·cos(A)
    calculation
      sin(2·A) = sin(A + A)                            substitute line 1
               = sin(A)·cos(A) + cos(A)·sin(A)         thm:sin-add a := A, b := A
               = 2·sin(A)·cos(A)                       algebra
    requires sin(A) ∈ ℂ: mun:sin-complex a := A
    requires cos(A) ∈ ℂ: mun:cos-complex a := A
