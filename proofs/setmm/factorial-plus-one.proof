import mundane theorem    stdlib/counting/factorial-divisible
import definition         stdlib/divisibility/divides
import mundane theorem    stdlib/divisibility/divides-difference
import mundane theorem    stdlib/divisibility/divides-one
import mundane theorem    stdlib/numbers/pos-int-nat

theorem factorial-plus-one
  note        N divides M! because N is at most M. If N also divided M! + 1,
              it would divide their difference, which is 1, and so N would
              be 1, but N is above 1.
  let M ∈ ℕ₀                                                          (H1)
  let N ∈ ℕ                                                           (H2)
  assume 1 < N                                                        (H3)
  assume N ≤ M                                                        (H4)
  then (M! + 1)/N ∉ ℤ
  by          contradiction

suppose (M! + 1)/N ∈ ℤ                                                (S)

1.  0 < N
    inequalities, from H2

2.  0 < M
    transitivity, from 1, H4

3.  M ∈ ℕ
    mun:pos-int-nat m := M, from 2

4.  N divides M!
    mun:factorial-divisible n := M, m := N, from H4, 3

5.  M! + 1 = N·((M! + 1)/N)
    algebra

6.  There is k ∈ ℤ with M! + 1 = N·k.
    exhibit, from S, 5

7.  N divides M! + 1
    def:divides d := N, n := M! + 1, from 6

8.  N divides (M! + 1) − M!
    mun:divides-difference d := N, a := M! + 1, b := M!, from 4, 7

9.  N divides 1
    substitute
      N divides (M! + 1) − M!      8
      N divides 1                  algebra

10. N = 1
    mun:divides-one d := N, from 9

11. N ≠ 1
    inequalities, contradicting 10
      1 < N            H3
      1 ≠ N            weakening
      N ≠ 1            restate
