import mundane definition stdlib/sets/difference
import mundane definition stdlib/sets/subset
import mundane theorem    stdlib/sets/difference-subset
import mundane theorem    stdlib/sets/in-subset
import mundane theorem    stdlib/sets/subset-antisymmetric

theorem subset-by-double-difference
  note        Taking from B what is in B and not in A leaves the part of B
              that is in A. That is all of A exactly when A lies inside B.
  let A be a set                                                      (H1)
  let B be a set                                                      (H2)
  then A ⊆ B ↔ B ∖ (B ∖ A) = A

1.  A ⊆ B ↔ B ∖ (B ∖ A) = A
    both directions

    direction
    assume A ⊆ B                                                      (D1)

    1.1.  For all t ∈ B ∖ (B ∖ A), t ∈ A.
          proof
          let t ∈ B ∖ (B ∖ A)                                         (K1)

          1.1.1.  t ∈ B. t ∉ B ∖ A.
                  mun:difference u := t, Y := B, Z := B ∖ A, from K1

          1.1.2.  t ∈ A
                  contradiction
                  suppose t ∉ A                                       (S1)

                  1.1.2.1.  t ∈ B ∖ A
                            mun:difference u := t, Y := B, Z := A, from S1, 1.1.1

                  1.1.2.2.  t ∉ B ∖ A
                            restate 1.1.1, contradicting 1.1.2.1

    1.2.  B ∖ (B ∖ A) ⊆ A
          mun:subset, from 1.1

    1.3.  For all t ∈ A, t ∈ B ∖ (B ∖ A).
          proof
          let t ∈ A                                                   (K2)

          1.3.1.  t ∈ B
                  mun:in-subset X := A, Y := B, u := t, from D1, K2

          1.3.2.  t ∉ B ∖ A
                  contradiction
                  suppose t ∈ B ∖ A                                   (S2)

                  1.3.2.1.  t ∈ B. t ∉ A.
                            mun:difference u := t, Y := B, Z := A, from S2

                  1.3.2.2.  t ∉ A
                            restate 1.3.2.1, contradicting K2

          1.3.3.  t ∈ B ∖ (B ∖ A)
                  mun:difference u := t, Y := B, Z := B ∖ A, from 1.3.1, 1.3.2

    1.4.  A ⊆ B ∖ (B ∖ A)
          mun:subset, from 1.3

    1.5.  B ∖ (B ∖ A) = A
          mun:subset-antisymmetric, from 1.2, 1.4

    direction
    assume B ∖ (B ∖ A) = A                                            (D2)

    1.6.  B ∖ (B ∖ A) ⊆ B
          mun:difference-subset X := B, Y := B ∖ A

    1.7.  A ⊆ B
          substitute B ∖ (B ∖ A) = A (D2) into line 1.6
