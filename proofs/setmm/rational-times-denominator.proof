import mundane definition stdlib/numbers/rational

theorem rational-times-denominator
  note        A rational p/q times its denominator q is the integer p.
  let A ∈ ℚ                                                           (H1)
  then there is x ∈ ℕ with A·x ∈ ℤ

1.  p ∈ ℤ. q ∈ ℕ. A = p/q.
    obtain p, q: mun:rational x := A

2.  A·q = p
    algebra, from 1

3.  A·q ∈ ℤ
    membership, from 2

4.  There is x ∈ ℕ with A·x ∈ ℤ.
    exhibit, from 3
