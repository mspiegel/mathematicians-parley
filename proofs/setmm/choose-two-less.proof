import theorem            proofs/setmm/factorial-by-predecessor/factorial-by-predecessor
import definition         stdlib/counting/C
import definition         stdlib/counting/factorial
import mundane theorem    stdlib/counting/factorial-nat
import mundane theorem    stdlib/counting/binomial-zero-index
import definition         stdlib/numbers/nat0
import mundane theorem    stdlib/numbers/nat-minus-one
import definition         stdlib/sums/range-between

theorem choose-two-less
  note        C(N + 1, N − 1) is (N + 1)! over 2!·(N − 1)!, and (N + 1)! is
              (N − 1)!·N·(N + 1), so the (N − 1)! cancels and what is left is
              (N + 1)·N over 2. For N = 0 the lower index is −1 and both
              sides are 0; for N = 1 it is C(2, 0) = 1.
  let N ∈ ℕ₀                                                          (H1)
  then C(N + 1, N − 1) = (N + 1)·N/2

1.  N ∈ ℕ or N = 0
    def:nat0 n := N

2.  C(N + 1, N − 1) = (N + 1)·N/2
    cases, from 1

    case
    assume N ∈ ℕ                                                      (C1)

    2.1.  N − 1 ∈ ℕ₀
          mun:nat-minus-one n := N, from C1

    2.2.  N − 1 ∈ ℕ or N − 1 = 0
          def:nat0 n := N − 1, from 2.1

    2.3.  C(N + 1, N − 1) = (N + 1)·N/2
          cases, from 2.2

          case
          assume N − 1 ∈ ℕ                                            (C3)

          2.3.1.  (N − 1)! ∈ ℕ
                  mun:factorial-nat n := N − 1, from C3

          2.3.2.  0 ≤ N − 1. N − 1 ≤ N + 1.
                  inequalities, from C1

          2.3.3.  N − 1 ∈ {0, …, N + 1}
                  def:range-between k := N − 1, a := 0, b := N + 1, from 2.3.2

          2.3.4.  (N + 1) − (N − 1) = 2
                  algebra

          2.3.5.  (1 + 1)! = 1!·(1 + 1)
                  def:factorial n := 1

          2.3.6.  2! = 1!·2
                  substitute 1 + 1 = 2 (arithmetic) into line 2.3.5

          2.3.7.  2! = 1·2
                  substitute
                    2! = 1!·2      2.3.6
                    2! = 1·2       def:factorial

          2.3.8.  ((N + 1) − (N − 1))! = 2
                  calculation
                    ((N + 1) − (N − 1))! = 2!      substitute line 2.3.4
                                         = 1·2     2.3.7
                                         = 2       arithmetic

          2.3.9.  N! = (N − 1)!·N
                  thm:factorial-by-predecessor, from C1

          2.3.10. (N + 1)! = (N − 1)!·N·(N + 1)
                  calculation
                    (N + 1)! = N!·(N + 1)                def:factorial n := N
                             = (N − 1)!·N·(N + 1)        substitute line 2.3.9

          2.3.11. (N − 1)!·N·(N + 1)/(2·(N − 1)!) = (N + 1)·N/2
                  algebra, from 2.3.1

          2.3.12. C(N + 1, N − 1) = (N + 1)·N/2
                  calculation
                    C(N + 1, N − 1) = (N + 1)!/(((N + 1) − (N − 1))!·(N − 1)!)   def:C n := N + 1, k := N − 1, from 2.3.3
                                    = (N + 1)!/(2·(N − 1)!)                      substitute line 2.3.8
                                    = (N − 1)!·N·(N + 1)/(2·(N − 1)!)            substitute line 2.3.10
                                    = (N + 1)·N/2                                2.3.11

          case
          assume N − 1 = 0                                            (C4)

          2.3.13. (N + 1)·N/2 = 1
                  algebra, from C4

          2.3.14. C(N + 1, N − 1) = (N + 1)·N/2
                  calculation
                    C(N + 1, N − 1) = C(N + 1, 0)    substitute C4
                                    = 1              mun:binomial-zero-index n := N + 1
                                    = (N + 1)·N/2    2.3.13

    case
    assume N = 0                                                      (C2)

    2.4.  N + 1 = 1
          algebra, from C2

    2.5.  N − 1 = −1
          algebra, from C2

    2.6.  (N + 1)·N/2 = 0
          algebra, from C2

    2.7.  C(N + 1, N − 1) = (N + 1)·N/2
          calculation
            C(N + 1, N − 1) = C(1, N − 1)    substitute line 2.4
                            = C(1, −1)       substitute line 2.5
                            = 0              def:C n := 1
                            = (N + 1)·N/2    2.6
