import mundane definition stdlib/sets/difference
import mundane theorem    stdlib/sets/disjoint-empty
import mundane theorem    stdlib/sets/disjoint-member
import mundane theorem    stdlib/sets/in-subset
import mundane theorem    stdlib/sets/intersection-commutes
import mundane definition stdlib/sets/subset

theorem disjoint-within-difference
  note        Inside C, a set misses B exactly when every one of its members
              is in C and not in B, that is, in C ∖ B.
  let A be a set                                                      (H1)
  let B be a set                                                      (H2)
  let C be a set                                                      (H3)
  assume A ⊆ C                                                        (H4)
  then A ∩ B = ∅ ↔ A ⊆ C ∖ B

1.  A ∩ B = ∅ ↔ A ⊆ C ∖ B
    both directions

    direction
    assume A ∩ B = ∅                                                  (D1)

    1.1.  For all t ∈ A, t ∈ C ∖ B.
          proof
          let t ∈ A                                                   (K)

          1.1.1.  t ∈ C
                  mun:in-subset X := A, Y := C, u := t, from H4, K

          1.1.2.  t ∉ B
                  mun:disjoint-member Y := A, Z := B, u := t, from D1, K

          1.1.3.  t ∈ C ∖ B
                  mun:difference u := t, Y := C, Z := B, from 1.1.1, 1.1.2

    1.2.  A ⊆ C ∖ B
          mun:subset X := A, Y := C ∖ B, from 1.1

    direction
    assume A ⊆ C ∖ B                                                  (D2)

    1.3.  For all t ∈ A, t ∈ C ∖ B.
          mun:subset X := A, Y := C ∖ B, from D2

    1.4.  For all s ∈ A, s ∉ B.
          proof
          let s ∈ A                                                   (K)

          1.4.1.  s ∈ C ∖ B
                  instantiate t := s in line 1.3, from K

          1.4.2.  s ∈ C and s ∉ B
                  mun:difference u := s, Y := C, Z := B, from 1.4.1

          1.4.3.  s ∉ B
                  join 1.4.2

    1.5.  B ∩ A = ∅
          mun:disjoint-empty Y := B, Z := A, from 1.4

    1.6.  A ∩ B = B ∩ A
          mun:intersection-commutes Y := A, Z := B

    1.7.  A ∩ B = ∅
          calculation
            A ∩ B = B ∩ A      1.6
                  = ∅          1.5
