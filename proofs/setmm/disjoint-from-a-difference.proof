import definition         stdlib/sets/difference
import definition         stdlib/sets/subset
import mundane theorem    stdlib/sets/disjoint-member
import mundane theorem    stdlib/sets/in-subset

theorem disjoint-from-a-difference
  note        A point of C lies in A, since C is inside A. If it were not in
              B it would be in A ∖ B, which C does not meet.
  let A be a set                                                      (H1)
  let B be a set                                                      (H2)
  let C be a set                                                      (H3)
  assume (A ∖ B) ∩ C = ∅                                              (H4)
  then C ⊆ A → C ⊆ B
  by          proof

assume C ⊆ A                                                          (K1)

1.  For all t ∈ C, t ∈ B.
    proof
    let t ∈ C                                                         (K2)
    by          contradiction
    suppose t ∉ B                                                     (S)

    1.1.  t ∈ A
          mun:in-subset X := C, Y := A, u := t, from K1, K2

    1.2.  t ∈ A ∖ B
          def:difference u := t, Y := A, Z := B, from S, 1.1

    1.3.  t ∉ C
          mun:disjoint-member Y := A ∖ B, Z := C, from H4, 1.2, contradicting K2

2.  C ⊆ B
    def:subset, from 1
