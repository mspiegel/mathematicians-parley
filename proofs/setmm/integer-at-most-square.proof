import mundane theorem    stdlib/numbers/integer-step
import mundane theorem    stdlib/numbers/multiply-le
import mundane theorem    stdlib/numbers/square-nonneg
import mundane axiom      stdlib/numbers/trichotomy

theorem integer-at-most-square
  note        An integer n is negative, 0, or at least 1. A negative number is
              below the square, which is not negative; 0 is its own square; and
              multiplying 1 ≤ n by n gives n ≤ n·n.
  let n ∈ ℤ                                                           (H1)
  then n ≤ n²

1.  n < 0 or n = 0 or 0 < n
    mun:trichotomy x := n

2.  n² ≥ 0
    mun:square-nonneg x := n

3.  n² = n·n
    algebra

4.  n ≤ n²
    cases, from 1

    case
    assume n < 0                                                      (C1)

    4.1.  n < n²
          inequalities, from C1, 2

    4.2.  n ≤ n²
          inequalities
            n < n²           4.1
            n ≤ n²           weakening

    case
    assume n = 0                                                      (C2)

    4.3.  n·n = 0
          algebra, from C2

    4.4.  n = n²
          transitivity, from C2, 4.3, 3

    4.5.  n ≤ n²
          inequalities
            n = n²           4.4
            n ≤ n²           weakening

    case
    assume 0 < n                                                      (C3)

    4.6.  0 + 1 ≤ n
          mun:integer-step m := 0, from C3

    4.7.  n·1 ≤ n·n
          mun:multiply-le x := 1, y := n, c := n, from C3, 4.6

    4.8.  n ≤ n²
          inequalities
            n·1 ≤ n·n        4.7
            n ≤ n·n          algebra
            n ≤ n²           algebra
