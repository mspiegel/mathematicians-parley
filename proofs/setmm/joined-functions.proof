import mundane theorem    stdlib/functions/function-into
import mundane theorem    stdlib/functions/function-value
import definition         stdlib/sets/union
import mundane theorem    stdlib/sets/in-union-left
import mundane theorem    stdlib/sets/in-union-right
import mundane theorem    stdlib/sets/intersection-commutes
import mundane theorem    stdlib/sets/disjoint-member

theorem joined-functions
  note        Two functions on sets with nothing in common make one function
              on the union of the sets: it acts as F on A and as G on B, so
              its values lie in the union of the codomains.
  let A be a set                                                      (H1)
  let B be a set                                                      (H2)
  let C be a set                                                      (H3)
  let D be a set                                                      (H4)
  let F : A → C                                                       (H5)
  let G : B → D                                                       (H6)
  assume A ∩ B = ∅                                                    (H7)
  let H(x) = F(x)    if x ∈ A
             G(x)    otherwise,  for x ∈ A ∪ B                        (D1)
         reads F on A and G on B
  then H : A ∪ B → C ∪ D

1.  For all x ∈ A ∪ B, H(x) ∈ C ∪ D.
    proof
    let x ∈ A ∪ B                                                     (K1)

    1.1.  x ∈ A or x ∈ B
          def:union, from K1

    1.2.  H(x) ∈ C ∪ D
          cases, from 1.1

          case
          assume x ∈ A                                                (C1)

          1.2.1.  H(x) = F(x)
                  D1, from C1, K1

          1.2.2.  F(x) ∈ C
                  mun:function-value f := F, from C1

          1.2.3.  H(x) ∈ C
                  substitute H(x) = F(x) (line 1.2.1) into line 1.2.2

          1.2.4.  H(x) ∈ C ∪ D
                  mun:in-union-left, from 1.2.3

          case
          assume x ∈ B                                                (C2)

          1.2.5.  B ∩ A = A ∩ B
                  mun:intersection-commutes

          1.2.6.  B ∩ A = ∅
                  calculation
                    B ∩ A = A ∩ B     1.2.5
                          = ∅         H7

          1.2.7.  x ∉ A
                  mun:disjoint-member, from C2, 1.2.6

          1.2.8.  H(x) = G(x)
                  D1, from K1, 1.2.7

          1.2.9.  G(x) ∈ D
                  mun:function-value f := G, from C2

          1.2.10. H(x) ∈ D
                  substitute H(x) = G(x) (line 1.2.8) into line 1.2.9

          1.2.11. H(x) ∈ C ∪ D
                  mun:in-union-right, from 1.2.10

2.  H : A ∪ B → C ∪ D
    mun:function-into, from 1
    requires H is a function on A ∪ B: from D1
