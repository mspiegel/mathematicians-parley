import mundane theorem    stdlib/counting/card-nonempty
import mundane theorem    stdlib/counting/card-pair-distinct
import mundane theorem    stdlib/counting/card-remove
import mundane theorem    stdlib/counting/card-zero
import axiom              stdlib/reasoning/excluded-middle
import mundane theorem    stdlib/reasoning/or-left
import mundane theorem    stdlib/reasoning/or-right
import definition         stdlib/sets/pair
import mundane theorem    stdlib/sets/pair-subset
import mundane theorem    stdlib/sets/remove-member
import definition         stdlib/sets/subset
import mundane theorem    stdlib/sets/subset-antisymmetric

theorem two-elements
  metamath    hash2prb
  note        A set of 2 elements has an element b, and what is left after
              taking b away has 1 element a, and then nothing is left: the
              set is {a, b}. Conversely {a, b} has 2 elements when a and b
              differ.
  let V be a set                                                      (H1)
  then |V| = 2 ↔ there are a, b ∈ V with a ≠ b and V = {a, b}
  by          both directions

direction
assume |V| = 2                                                        (C1)

1.  |V| = 1 + 1
    calculation
      |V| = 2         C1
          = 1 + 1     arithmetic

2.  b ∈ V
    obtain b: mun:card-nonempty X := V, k := 1, from 1

3.  |V ∖ {b}| = 0 + 1
    calculation
      |V ∖ {b}| = 1       mun:card-remove X := V, a := b, k := 1, from 1, 2
                = 0 + 1   arithmetic

4.  a ∈ V ∖ {b}
    obtain a: mun:card-nonempty X := V ∖ {b}, k := 0, from 3

5.  a ∈ V. a ≠ b
    mun:remove-member u := a, Y := V, a := b, from 4

6.  |(V ∖ {b}) ∖ {a}| = 0
    mun:card-remove X := V ∖ {b}, k := 0, from 3, 4

7.  For all t ∈ V, t ∈ {a, b}.
    proof
    let t ∈ V                                                         (K1)

    7.1.  t = b or t ≠ b
          axi:excluded-middle P := t = b

    7.2.  t ∈ {a, b}
          cases, from 7.1

          case
          assume t = b                                                (C2)

          7.2.1.  t = a or t = b
                  mun:or-right P := t = a, Q := t = b, from C2

          7.2.2.  t ∈ {a, b}
                  def:pair x := t, u := a, w := b, from 7.2.1

          case
          assume t ≠ b                                                (C3)

          7.2.3.  t ∈ V ∖ {b}
                  mun:remove-member u := t, Y := V, a := b, from C3, K1

          7.2.4.  t = a or t ≠ a
                  axi:excluded-middle P := t = a

          7.2.5.  t ∈ {a, b}
                  cases, from 7.2.4

                  case
                  assume t = a                                        (C4)

                  7.2.5.1.  t = a or t = b
                            mun:or-left P := t = a, Q := t = b, from C4

                  7.2.5.2.  t ∈ {a, b}
                            def:pair x := t, u := a, w := b, from 7.2.5.1

                  case
                  assume t ≠ a                                        (C5)

                  7.2.5.3.  t ∈ (V ∖ {b}) ∖ {a}
                            mun:remove-member u := t, Y := V ∖ {b}, from C5, 7.2.3

                  7.2.5.4.  t ∈ ∅
                            substitute
                              t ∈ (V ∖ {b}) ∖ {a}      7.2.5.3
                              t ∈ ∅                    mun:card-zero X := (V ∖ {b}) ∖ {a}, from 6

                  7.2.5.5.  t ∉ ∅
                            inspection, contradicting 7.2.5.4

8.  V ⊆ {a, b}
    def:subset X := V, Y := {a, b}, from 7

9.  {a, b} ⊆ V
    mun:pair-subset X := V, from 2, 5

10. V = {a, b}
    mun:subset-antisymmetric X := V, Y := {a, b}, from 8, 9

11. there are a, b ∈ V with a ≠ b and V = {a, b}
    exhibit, from 2, 5, 10

direction
assume there are a, b ∈ V with a ≠ b and V = {a, b}                   (C6)

12. c ∈ V. d ∈ V. c ≠ d. V = {c, d}
    obtain c, d from C6

13. |V| = 2
    calculation
      |V| = |{c, d}|     substitute line 12
          = 2            mun:card-pair-distinct u := c, w := d, from 12
