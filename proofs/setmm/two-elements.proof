import mundane theorem    stdlib/counting/card-nonempty
import mundane theorem    stdlib/counting/card-pair-distinct
import mundane theorem    stdlib/counting/card-remove
import mundane theorem    stdlib/counting/card-zero
import axiom              stdlib/reasoning/excluded-middle
import mundane theorem    stdlib/reasoning/or-left
import mundane theorem    stdlib/reasoning/or-right
import definition         stdlib/sets/pair
import mundane theorem    stdlib/sets/pair-subset
import mundane theorem    stdlib/sets/remove-member
import definition         stdlib/sets/subset
import mundane theorem    stdlib/sets/subset-antisymmetric

theorem two-elements
  metamath    hash2prb
  note        A set of 2 elements has an element b, and what is left after
              taking b away has 1 element a, and then nothing is left: the
              set is {a, b}. Conversely {a, b} has 2 elements when a and b
              differ.
  let V be a set                                                      (H1)
  then |V| = 2 ↔ there are a, b ∈ V with a ≠ b and V = {a, b}

1.  |V| = 2 ↔ there are a, b ∈ V with a ≠ b and V = {a, b}
    both directions

    direction
    assume |V| = 2                                                    (C1)

    1.1.  |V| = 1 + 1
          calculation
            |V| = 2         C1
                = 1 + 1     arithmetic

    1.2.  b ∈ V
          obtain b: mun:card-nonempty X := V, k := 1, from 1.1

    1.3.  |V ∖ {b}| = 0 + 1
          calculation
            |V ∖ {b}| = 1       mun:card-remove X := V, a := b, k := 1, from 1.1, 1.2
                      = 0 + 1   arithmetic

    1.4.  a ∈ V ∖ {b}
          obtain a: mun:card-nonempty X := V ∖ {b}, k := 0, from 1.3

    1.5.  a ∈ V. a ≠ b
          mun:remove-member u := a, Y := V, a := b, from 1.4

    1.6.  |(V ∖ {b}) ∖ {a}| = 0
          mun:card-remove X := V ∖ {b}, k := 0, from 1.3, 1.4

    1.7.  For all t ∈ V, t ∈ {a, b}.
          proof
          let t ∈ V                                                   (K1)

          1.7.1.  t = b or t ≠ b
                  axi:excluded-middle P := t = b

          1.7.2.  t ∈ {a, b}
                  cases, from 1.7.1

                  case
                  assume t = b                                        (C2)

                  1.7.2.1.  t = a or t = b
                            mun:or-right P := t = a, Q := t = b, from C2

                  1.7.2.2.  t ∈ {a, b}
                            def:pair x := t, u := a, w := b, from 1.7.2.1

                  case
                  assume t ≠ b                                        (C3)

                  1.7.2.3.  t ∈ V ∖ {b}
                            mun:remove-member u := t, Y := V, a := b, from C3, K1

                  1.7.2.4.  t = a or t ≠ a
                            axi:excluded-middle P := t = a

                  1.7.2.5.  t ∈ {a, b}
                            cases, from 1.7.2.4

                            case
                            assume t = a                              (C4)

                            1.7.2.5.1.  t = a or t = b
                                        mun:or-left P := t = a, Q := t = b, from C4

                            1.7.2.5.2.  t ∈ {a, b}
                                        def:pair x := t, u := a, w := b, from 1.7.2.5.1

                            case
                            assume t ≠ a                              (C5)

                            1.7.2.5.3.  t ∈ (V ∖ {b}) ∖ {a}
                                        mun:remove-member u := t, Y := V ∖ {b}, from C5, 1.7.2.3

                            1.7.2.5.4.  t ∈ ∅
                                        substitute
                                          t ∈ (V ∖ {b}) ∖ {a}      1.7.2.5.3
                                          t ∈ ∅                    mun:card-zero X := (V ∖ {b}) ∖ {a}, from 1.6

                            1.7.2.5.5.  t ∉ ∅
                                        inspection, contradicting 1.7.2.5.4

    1.8.  V ⊆ {a, b}
          def:subset X := V, Y := {a, b}, from 1.7

    1.9.  {a, b} ⊆ V
          mun:pair-subset X := V, from 1.2, 1.5

    1.10. V = {a, b}
          mun:subset-antisymmetric X := V, Y := {a, b}, from 1.8, 1.9

    1.11. there are a, b ∈ V with a ≠ b and V = {a, b}
          exhibit, from 1.2, 1.5, 1.10

    direction
    assume there are a, b ∈ V with a ≠ b and V = {a, b}               (C6)

    1.12. c ∈ V. d ∈ V. c ≠ d. V = {c, d}
          obtain c, d from C6

    1.13. |V| = 2
          calculation
            |V| = |{c, d}|     substitute line 1.12
                = 2            mun:card-pair-distinct u := c, w := d, from 1.12
