import mundane definition stdlib/functions/image
import mundane theorem    stdlib/functions/value-in-image
import mundane definition stdlib/sets/subset
import mundane theorem    stdlib/sets/subset-empty

theorem image-empty
  note        F[B] has an element exactly when B has one, since each element
              of B goes to an element of F[B].
  let A be a set                                                      (H1)
  let Y be a set                                                      (H4)
  let F : A → Y                                                       (H2)
  let B ⊆ A                                                           (H3)
  then F[B] = ∅ ↔ B = ∅

1.  F[B] = ∅ ↔ B = ∅
    both directions

    direction
    assume F[B] = ∅                                                   (D1)

    1.1.  For all t ∈ B, t ∈ ∅.
          proof
          let t ∈ B                                                   (K1)

          1.1.1.  F(t) ∈ F[B]
                  mun:value-in-image, from H3, K1

          1.1.2.  F(t) ∈ ∅
                  substitute F[B] = ∅ (D1) into line 1.1.1

          1.1.3.  F(t) ∉ ∅
                  inspection, contradicting 1.1.2

    1.2.  B ⊆ ∅
          mun:subset, from 1.1

    1.3.  B = ∅
          mun:subset-empty, from 1.2

    direction
    assume B = ∅                                                      (D2)

    1.4.  For all u ∈ F[B], u ∈ ∅.
          proof
          let u ∈ F[B]                                                (K2)

          1.4.1.  there is s ∈ B with u = F(s)
                  mun:image, from H3, K2

          1.4.2.  s ∈ B. u = F(s).
                  obtain s from line 1.4.1

          1.4.3.  s ∈ ∅
                  substitute B = ∅ (D2) into line 1.4.2

          1.4.4.  s ∉ ∅
                  inspection, contradicting 1.4.3

    1.5.  F[B] ⊆ ∅
          mun:subset, from 1.4

    1.6.  F[B] = ∅
          mun:subset-empty, from 1.5
