import mundane definition stdlib/divisibility/divides
import mundane definition stdlib/divisibility/odd

theorem odd-before-even
  note        If N = 2k + 1 then N + 1 = 2(k + 1). If N + 1 = 2j then
              N = 2(j − 1) + 1.
  let N ∈ ℤ                                                           (H1)
  then N is odd ↔ 2 divides N + 1

1.  N is odd ↔ 2 divides N + 1
    both directions

    direction
    assume N is odd                                                   (D1)

    1.1.  k ∈ ℤ. N = 2k + 1.
          obtain k: mun:odd, from D1

    1.2.  N + 1 = 2(k + 1)
          algebra, from 1.1

    1.3.  2 divides N + 1
          mun:divides d := 2, n := N + 1, from 1.2

    direction
    assume 2 divides N + 1                                            (D2)

    1.4.  j ∈ ℤ. N + 1 = 2j.
          obtain j: mun:divides d := 2, n := N + 1, from D2

    1.5.  N = 2(j − 1) + 1
          algebra, from 1.4

    1.6.  N is odd
          mun:odd n := N, from 1.5
