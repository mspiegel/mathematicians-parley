import mundane definition stdlib/functions/image
import mundane theorem    stdlib/functions/function-value
import mundane theorem    stdlib/functions/value-in-image
import mundane definition stdlib/sets/subset
import mundane definition stdlib/sets/set-builder
import mundane theorem    stdlib/sets/in-subset
import mundane theorem    stdlib/sets/subset-antisymmetric

theorem image-as-a-selection
  note        The image is the part of the codomain B that F reaches from X:
              a value F(s) for s in X lies in B, and a point of B reached
              from X is a value of F.
  let A be a set                                                      (H1)
  let B be a set                                                      (H2)
  let F : A → B                                                       (H3)
  let X ⊆ A                                                           (H4)
  then F[X] = {y ∈ B : there is x ∈ X with F(x) = y}

1.  For all u ∈ F[X], u ∈ {y ∈ B : there is x ∈ X with F(x) = y}.
    proof
    let u ∈ F[X]                                                      (K1)

    1.1.  there is s ∈ X with u = F(s)
          mun:image X := A, Y := X, from H4, K1

    1.2.  s ∈ X. u = F(s).
          obtain s from line 1.1

    1.3.  s ∈ A
          mun:in-subset, from H4, 1.2

    1.4.  F(s) ∈ B
          mun:function-value f := F, x := s, from 1.3

    1.5.  u ∈ B
          substitute u = F(s) (line 1.2) into line 1.4

    1.6.  there is x ∈ X with F(x) = u
          exhibit, from 1.2

    1.7.  u ∈ {y ∈ B : there is x ∈ X with F(x) = y}
          mun:set-builder, from 1.5, 1.6

2.  F[X] ⊆ {y ∈ B : there is x ∈ X with F(x) = y}
    mun:subset, from 1

3.  For all u ∈ {y ∈ B : there is x ∈ X with F(x) = y}, u ∈ F[X].
    proof
    let u ∈ {y ∈ B : there is x ∈ X with F(x) = y}                    (K2)

    3.1.  there is x ∈ X with F(x) = u
          mun:set-builder, from K2

    3.2.  x ∈ X. F(x) = u.
          obtain x from line 3.1

    3.3.  F(x) ∈ F[X]
          mun:value-in-image, from H4, 3.2

    3.4.  u ∈ F[X]
          substitute F(x) = u (line 3.2) into line 3.3

4.  {y ∈ B : there is x ∈ X with F(x) = y} ⊆ F[X]
    mun:subset, from 3

5.  F[X] = {y ∈ B : there is x ∈ X with F(x) = y}
    mun:subset-antisymmetric, from 2, 4
