import mundane theorem    stdlib/numbers/abs-square
import mundane theorem    stdlib/numbers/multiply-cancel
import mundane theorem    stdlib/numbers/nat0-nonzero
import definition         stdlib/divisibility/divides
import definition         stdlib/divisibility/prime
import mundane theorem    stdlib/divisibility/prime-nat
import mundane theorem    stdlib/reasoning/modus-ponens

theorem square-not-prime
  note        If A² were prime, |A| would divide it, since A² = |A|·|A|, so
              |A| would be 1 or A². Either way |A| is 1, and then A² is 1,
              which is not above 1.
  let A ∈ ℤ                                                           (H1)
  then not (A² is prime)
  by          contradiction

suppose A² is prime                                                   (S)

1.  A² ∈ ℕ
    mun:prime-nat p := A², from S

2.  A² > 1
    def:prime p := A², from S, 1

3.  |A|² = A²
    mun:abs-square x := A

4.  |A| ≠ 0
    contradiction
    suppose |A| = 0                                                   (S2)

    4.1.  0² = A²
          substitute |A| = 0 (S2) into line 3

    4.2.  0² ≥ A²
          inequalities
            0² = A²          4.1
            0² ≥ A²          weakening

    4.3.  not (A² > 1)
          inequalities, from 4.2, contradicting 2

5.  |A| ∈ ℕ
    mun:nat0-nonzero m := |A|, from 4

6.  A² = |A|·|A|
    algebra, from 3

7.  |A| divides A²
    def:divides d := |A|, n := A², from 6

8.  For all d ∈ ℕ, if d divides A² then d = 1 or d = A².
    def:prime p := A², from S, 1

9.  If |A| divides A² then |A| = 1 or |A| = A².
    instantiate d := |A| in line 8, from 5

10. |A| = 1 or |A| = A²
    mun:modus-ponens, from 7, 9

11. |A| = 1
    cases, from 10

    case
    assume |A| = 1, which is the claim                                (C1)

    case
    assume |A| = A²                                                   (C2)

    11.1. |A|·|A| = 1·|A|
          transitivity, from 6, C2

    11.2. |A| = 1
          mun:multiply-cancel a := |A|, b := 1, c := |A|, from 4, 11.1

12. 1² = A²
    substitute |A| = 1 (line 11) into line 3

13. 1² ≥ A²
    inequalities
      1² = A²          12
      1² ≥ A²          weakening

14. not (A² > 1)
    inequalities, from 13, contradicting 2
