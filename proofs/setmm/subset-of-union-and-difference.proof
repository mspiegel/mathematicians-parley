import mundane definition stdlib/sets/difference
import mundane axiom      stdlib/reasoning/excluded-middle
import mundane theorem    stdlib/reasoning/or-left
import mundane theorem    stdlib/reasoning/or-right
import mundane theorem    stdlib/sets/in-subset
import mundane definition stdlib/sets/subset
import mundane definition stdlib/sets/union

theorem subset-of-union-and-difference
  note        If A lies in B ∪ C, then what is in A and not in B must be in C.
              Conversely an element of A is in B, or else it is in A ∖ B,
              which lies in C.
  let A be a set                                                      (H1)
  let B be a set                                                      (H2)
  let C be a set                                                      (H3)
  then A ⊆ B ∪ C ↔ A ∖ B ⊆ C

1.  A ⊆ B ∪ C ↔ A ∖ B ⊆ C
    both directions

    direction
    assume A ⊆ B ∪ C                                                  (D1)

    1.1.  For all u ∈ A ∖ B, u ∈ C.
          proof
          let u ∈ A ∖ B                                               (K1)

          1.1.1.  u ∈ A. u ∉ B.
                  mun:difference Y := A, Z := B, from K1

          1.1.2.  u ∈ B ∪ C
                  mun:in-subset X := A, Y := B ∪ C, from D1, 1.1.1

          1.1.3.  u ∈ B or u ∈ C
                  mun:union Y := B, Z := C, from 1.1.2

          1.1.4.  u ∈ C
                  cases, from 1.1.3

                  case
                  assume u ∈ B                                        (C1)

                  1.1.4.1.  u ∉ B
                            restate 1.1.1, contradicting C1

                  case
                  assume u ∈ C                                        (C2)

                  1.1.4.2.  u ∈ C
                            restate C2

    1.2.  A ∖ B ⊆ C
          mun:subset X := A ∖ B, Y := C, from 1.1

    direction
    assume A ∖ B ⊆ C                                                  (D2)

    1.3.  For all u ∈ A, u ∈ B ∪ C.
          proof
          let u ∈ A                                                   (K2)

          1.3.1.  u ∈ B or u ∉ B
                  mun:excluded-middle P := u ∈ B

          1.3.2.  u ∈ B ∪ C
                  cases, from 1.3.1

                  case
                  assume u ∈ B                                        (C1)

                  1.3.2.1.  u ∈ B or u ∈ C
                            mun:or-left, from C1

                  1.3.2.2.  u ∈ B ∪ C
                            mun:union Y := B, Z := C, from 1.3.2.1

                  case
                  assume u ∉ B                                        (C2)

                  1.3.2.3.  u ∈ A ∖ B
                            mun:difference Y := A, Z := B, from C2, K2

                  1.3.2.4.  u ∈ C
                            mun:in-subset X := A ∖ B, Y := C, from D2, 1.3.2.3

                  1.3.2.5.  u ∈ B or u ∈ C
                            mun:or-right, from 1.3.2.4

                  1.3.2.6.  u ∈ B ∪ C
                            mun:union Y := B, Z := C, from 1.3.2.5

    1.4.  A ⊆ B ∪ C
          mun:subset X := A, Y := B ∪ C, from 1.3
