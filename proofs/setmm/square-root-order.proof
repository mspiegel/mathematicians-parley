import definition         stdlib/numbers/sqrt
import mundane theorem    stdlib/numbers/square-less

theorem square-root-order
  metamath    sqrtle
  note        For numbers that are not negative, squaring keeps the order
              strictly, so √A > √B would give A > B and the other way
              round.
  let A ∈ ℝ                                                           (H1)
  let B ∈ ℝ                                                           (H2)
  assume 0 ≤ A                                                        (H3)
  assume 0 ≤ B                                                        (H4)
  then A ≤ B ↔ √A ≤ √B

1.  √A ∈ ℝ. √A ≥ 0. (√A)² = A.
    def:sqrt x := A, from H3

2.  √B ∈ ℝ. √B ≥ 0. (√B)² = B.
    def:sqrt x := B, from H4

3.  A ≤ B ↔ √A ≤ √B
    both directions

    direction
    assume A ≤ B                                                      (D1)

    3.1.  √A ≤ √B
          contradiction
          suppose not √A ≤ √B                                         (S1)

          3.1.1.  √B < √A
                  inequalities, from S1
                  requires √A ∈ ℝ: from 1
                  requires √B ∈ ℝ: from 2

          3.1.2.  (√B)² < (√A)²
                  mun:square-less x := √B, y := √A, from 1, 2, 3.1.1

          3.1.3.  B < A
                  calculation
                    B = (√B)²     2
                      < (√A)²     3.1.2
                      = A         1

          3.1.4.  not A ≤ B
                  inequalities, from 3.1.3, contradicting D1

    direction
    assume √A ≤ √B                                                    (D2)

    3.2.  A ≤ B
          contradiction
          suppose not A ≤ B                                           (S2)

          3.2.1.  B < A
                  inequalities, from S2

          3.2.2.  (√B)² < (√A)²
                  calculation
                    (√B)² = B     2
                          < A     3.2.1
                          = (√A)² 1

          3.2.3.  √B < √A
                  mun:square-less x := √B, y := √A, from 1, 2, 3.2.2

          3.2.4.  not √A ≤ √B
                  inequalities, from 3.2.3, contradicting D2
                  requires √A ∈ ℝ: from 1
                  requires √B ∈ ℝ: from 2
