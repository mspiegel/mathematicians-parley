import mundane theorem    stdlib/reasoning/modus-ponens

theorem implication-and-currying
  metamath-counterpart impexp
  note        To get c = 0 from both a = 0 and b = 0, take a = 0 first and
              then b = 0, and conversely.
  let a ∈ ℝ                                                           (H1)
  let b ∈ ℝ                                                           (H2)
  let c ∈ ℝ                                                           (H3)
  then (if (a = 0 and b = 0) then c = 0) ↔ (if a = 0 then (if b = 0 then c = 0))
  by          both directions

direction
assume if (a = 0 and b = 0) then c = 0                                (D1)
by          proof
assume a = 0                                                          (K1)
assume b = 0                                                          (K2)

1.  a = 0 and b = 0
    join K1, K2

2.  c = 0
    mun:modus-ponens, from D1, 1

direction
assume if a = 0 then (if b = 0 then c = 0)                            (D2)
by          proof
assume a = 0 and b = 0                                                (K3)

3.  If b = 0 then c = 0.
    mun:modus-ponens, from D2, K3

4.  c = 0
    mun:modus-ponens, from K3, 3
