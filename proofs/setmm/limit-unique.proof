import definition         stdlib/calculus/tends-to
import mundane theorem    stdlib/numbers/abs-difference-lt

theorem limit-at-most
  note        Far enough along, x(n) is within r/2 of A and within r/2 of B,
              so A is under B + r for every r > 0. Were A above B, taking
              r = (A − B)/2 would put A under the midpoint of A and B.
  ε, r range over ℝ
  n ranges over ℕ
  let x : ℕ → ℝ                                                       (H1)
  let A ∈ ℝ                                                           (H2)
  let B ∈ ℝ                                                           (H3)
  assume x(n) → A as n → ∞                                            (H4)
  assume x(n) → B as n → ∞                                            (H5)
  then A ≤ B

1.  For all r > 0, A < B + r.
    proof
    let r ∈ ℝ                                                         (K1)
    assume r > 0                                                      (A1)

    1.1.  r/2 > 0
          inequalities
            r > 0          A1
            r/2 > 0        multiplying by 1/2

    1.2.  For all ε > 0, there exists N ∈ ℕ such that |x(n) − A| < ε for all n ≥ N.
          def:tends-to, from H4

    1.3.  For all ε > 0, there exists N ∈ ℕ such that |x(n) − B| < ε for all n ≥ N.
          def:tends-to L := B, from H5

    1.4.  There exists N ∈ ℕ such that |x(n) − A| < r/2 for all n ≥ N.
          instantiate ε := r/2 in line 1.2, from 1.1

    1.5.  There exists N ∈ ℕ such that |x(n) − B| < r/2 for all n ≥ N.
          instantiate ε := r/2 in line 1.3, from 1.1

    1.6.  P ∈ ℕ. |x(n) − A| < r/2 for all n ≥ P.
          obtain P from line 1.4

    1.7.  Q ∈ ℕ. |x(n) − B| < r/2 for all n ≥ Q.
          obtain Q from line 1.5

    1.8.  P + Q ≥ P
          inequalities, from 1.7

    1.9.  P + Q ≥ Q
          inequalities, from 1.6

    1.10. |x(P + Q) − A| < r/2
          instantiate n := P + Q in line 1.6, from 1.8

    1.11. |x(P + Q) − B| < r/2
          instantiate n := P + Q in line 1.7, from 1.9

    1.12. x(P + Q) ∈ ℝ
          membership, from H1

    1.13. A − r/2 < x(P + Q) and x(P + Q) < A + r/2
          mun:abs-difference-lt x := x(P + Q), c := A, δ := r/2, from 1.10, 1.12

    1.14. B − r/2 < x(P + Q) and x(P + Q) < B + r/2
          mun:abs-difference-lt x := x(P + Q), c := B, δ := r/2, from 1.11, 1.12

    1.15. A − r/2 < x(P + Q)
          inequalities, from 1.12, 1.13

    1.16. x(P + Q) < B + r/2
          inequalities, from 1.12, 1.14

    1.17. A − r/2 < B + r/2
          transitivity, from 1.15, 1.16
          requires x(P + Q) ∈ ℝ: from 1.12

    1.18. A < B + r
          inequalities
            A − r/2 < B + r/2     1.17
            A < B + r             adding r/2

2.  A ≤ B
    contradiction
    suppose not A ≤ B                                                 (S)

    2.1.  B < A
          inequalities, from S

    2.2.  (A − B)/2 > 0
          inequalities
            B < A                 2.1
            0 < A − B             adding −B
            0 < (A − B)/2         multiplying by 1/2
            (A − B)/2 > 0         symmetry

    2.3.  A < B + (A − B)/2
          instantiate r := (A − B)/2 in line 1, from 2.2

    2.4.  A ≤ B
          inequalities, contradicting S
            A < B + (A − B)/2     2.3
            2·A < A + B           multiplying by 2
            A < B                 adding −A
            A ≤ B                 weakening

theorem limit-unique
  note        A is at most B and B is at most A, by limit-at-most each way
              round.
  let x : ℕ → ℝ                                                       (H1)
  let A ∈ ℝ                                                           (H2)
  let B ∈ ℝ                                                           (H3)
  assume x(n) → A as n → ∞                                            (H4)
  assume x(n) → B as n → ∞                                            (H5)
  then A = B

1.  A ≤ B
    thm:limit-at-most, from H4, H5

2.  B ≤ A
    thm:limit-at-most A := B, B := A, from H4, H5

3.  A = B
    antisymmetry, from 1, 2
