import theorem        proofs/setmm/floor-basics/floor-of-integer
import mundane theorem stdlib/divisibility/mod-value
import mundane theorem stdlib/numbers/floor-integer

theorem no-remainder-is-whole-quotient
  note        With q the whole number of B's below A, the remainder is A − B·q. It is 0 exactly when A = B·q, that is when A/B is the whole number q; and when A/B is whole it is its own floor.
  let A ∈ ℝ                                                           (H1)
  let B ∈ ℝ                                                           (H2)
  assume B > 0                                                        (H3)
  then A mod B = 0 ↔ A/B ∈ ℤ

1.  B ≠ 0
    inequalities
      B > 0            H3
      B ≠ 0            weakening

let q = ⌊A/B⌋, an integer                                             (D1)
    mun:floor-integer x := A/B, from 1
    reads the whole number of B's that fit below A

2.  A mod B = A − B·q
    mun:mod-value a := A, b := B, from D1, H3

3.  A mod B = 0 ↔ A/B ∈ ℤ
    both directions

    direction
    assume A mod B = 0                                                (C1)

    3.1.  A − B·q = 0
          substitute A mod B = A − B·q (line 2) into C1

    3.2.  A/B = q
          algebra, from 3.1
          requires B ≠ 0: from 1

    3.3.  A/B ∈ ℤ
          membership, from 3.2

    direction
    assume A/B ∈ ℤ                                                    (C2)

    3.4.  q = A/B
          calculation
            q = ⌊A/B⌋     D1
              = A/B       thm:floor-of-integer A := A/B, from C2

    3.5.  A mod B = 0
          calculation
            A mod B = A − B·q     2
                    = 0           algebra, from 3.4
          requires B ≠ 0: from 1
