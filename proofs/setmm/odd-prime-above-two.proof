import mundane theorem    stdlib/numbers/integer-step
import mundane definition stdlib/divisibility/prime

theorem odd-prime-above-two
  note        A prime is above 1, so it is at least 2 as a whole number;
              if it is not 2 it is above 2.
  let P ∈ ℕ                                                           (H1)
  assume P is prime                                                   (H2)
  assume P ≠ 2                                                        (H3)
  then 2 < P

1.  P > 1
    mun:prime p := P, from H2

2.  1 + 1 ≤ P
    mun:integer-step m := 1, n := P, from 1

3.  2 < P
    inequalities, from H3, 2
