import theorem            stdlib/groups/group-cancel
import axiom              stdlib/groups/group-associative
import axiom              stdlib/groups/group-closed
import axiom              stdlib/groups/group-identity
import axiom              stdlib/groups/group-identity-closed
import axiom              stdlib/groups/group-inverse
import axiom              stdlib/groups/group-inverse-closed

theorem group-left-inverse
  note        Write b for a⁻¹ and c for b⁻¹. Then b·a = (b·a)·e = (b·a)·(b·c)
              = b·(a·(b·c)) = b·((a·b)·c) = b·(e·c) = (b·e)·c = b·c = e.
  let G be a group with operation · and identity e                    (H1)
  let a ∈ G                                                           (H2)
  then a⁻¹·a = e

1.  e ∈ G
    axi:group-identity-closed

2.  a⁻¹ ∈ G
    axi:group-inverse-closed, from H2

3.  (a⁻¹)⁻¹ ∈ G
    axi:group-inverse-closed a := a⁻¹, from 2

4.  a⁻¹·a ∈ G
    axi:group-closed a := a⁻¹, b := a, from H2, 2

5.  a⁻¹·(a⁻¹)⁻¹ ∈ G
    axi:group-closed a := a⁻¹, b := (a⁻¹)⁻¹, from 2, 3

6.  a⁻¹·(a⁻¹)⁻¹ = e
    axi:group-inverse a := a⁻¹, from 2

7.  a·a⁻¹ = e
    axi:group-inverse, from H2

8.  a·(a⁻¹·(a⁻¹)⁻¹) = e·(a⁻¹)⁻¹
    calculation
      a·(a⁻¹·(a⁻¹)⁻¹) = (a·a⁻¹)·(a⁻¹)⁻¹      axi:group-associative b := a⁻¹, c := (a⁻¹)⁻¹, from H2, 2, 3
                      = e·(a⁻¹)⁻¹             substitute line 7

9.  a⁻¹·e = a⁻¹
    axi:group-identity a := a⁻¹, from 2

10. a⁻¹·a = e
    calculation
      a⁻¹·a = (a⁻¹·a)·e                              axi:group-identity a := a⁻¹·a, from 4
            = (a⁻¹·a)·(a⁻¹·(a⁻¹)⁻¹)                  substitute line 6
            = a⁻¹·(a·(a⁻¹·(a⁻¹)⁻¹))                  axi:group-associative a := a⁻¹, b := a, c := a⁻¹·(a⁻¹)⁻¹, from H2, 2, 5
            = a⁻¹·(e·(a⁻¹)⁻¹)                        substitute line 8
            = (a⁻¹·e)·(a⁻¹)⁻¹                        axi:group-associative a := a⁻¹, b := e, c := (a⁻¹)⁻¹, from 1, 2, 3
            = a⁻¹·(a⁻¹)⁻¹                            substitute line 9
            = e                                      6


theorem group-left-identity
  note        e·a is (a·a⁻¹)·a = a·(a⁻¹·a) = a·e = a.
  let G be a group with operation · and identity e                    (H1)
  let a ∈ G                                                           (H2)
  then e·a = a

1.  a⁻¹ ∈ G
    axi:group-inverse-closed, from H2

2.  a·a⁻¹ = e
    axi:group-inverse, from H2

3.  a⁻¹·a = e
    thm:group-left-inverse, from H2

4.  e·a = a
    calculation
      e·a = (a·a⁻¹)·a      substitute line 2
          = a·(a⁻¹·a)      axi:group-associative b := a⁻¹, c := a, from H2, 1
          = a·e            substitute line 3
          = a              axi:group-identity, from H2


theorem group-inverse-of-identity
  note        e⁻¹ is e·e⁻¹ because e is a left identity, and e·e⁻¹ is e.
  let G be a group with operation · and identity e                    (H1)
  then e⁻¹ = e

1.  e ∈ G
    axi:group-identity-closed

2.  e⁻¹ ∈ G
    axi:group-inverse-closed a := e, from 1

3.  e⁻¹ = e
    calculation
      e⁻¹ = e·e⁻¹      thm:group-left-identity a := e⁻¹, from 2
          = e          axi:group-inverse a := e, from 1


theorem group-inverse-of-inverse
  note        a⁻¹ has two right inverses, a and (a⁻¹)⁻¹: a⁻¹·a = e and
              a⁻¹·(a⁻¹)⁻¹ = e, so cancelling a⁻¹ makes them equal.
  let G be a group with operation · and identity e                    (H1)
  let a ∈ G                                                           (H2)
  then (a⁻¹)⁻¹ = a

1.  a⁻¹ ∈ G
    axi:group-inverse-closed, from H2

2.  (a⁻¹)⁻¹ ∈ G
    axi:group-inverse-closed a := a⁻¹, from 1

3.  a⁻¹·(a⁻¹)⁻¹ = a⁻¹·a
    calculation
      a⁻¹·(a⁻¹)⁻¹ = e          axi:group-inverse a := a⁻¹, from 1
                  = a⁻¹·a      thm:group-left-inverse, from H2

4.  (a⁻¹)⁻¹ = a
    thm:group-cancel a := (a⁻¹)⁻¹, b := a, g := a⁻¹, from H2, 1, 2, 3


theorem group-idempotent
  note        If a·a = a then cancelling a leaves a = e, since a·e = a too.
              Conversely e·e = e.
  let G be a group with operation · and identity e                    (H1)
  let a ∈ G                                                           (H2)
  then a·a = a ↔ a = e

1.  e ∈ G
    axi:group-identity-closed

2.  a·e = a
    axi:group-identity, from H2

3.  a·a = a ↔ a = e
    both directions

    direction
    assume a·a = a                                                    (D1)

    3.1.  a·a = a·e
          calculation
            a·a = a          D1
                = a·e        2

    3.2.  a = e
          thm:group-cancel b := e, g := a, from H2, 1, 3.1

    direction
    assume a = e                                                      (D2)

    3.3.  a·a = a
          calculation
            a·a = a·e      substitute D2
                = a        2


theorem group-inverse-by-right
  note        a⁻¹ and b both multiply a to e on the right; cancelling a
              makes them equal.
  let G be a group with operation · and identity e                    (H1)
  let a ∈ G                                                           (H2)
  let b ∈ G                                                           (H3)
  then a⁻¹ = b ↔ a·b = e

1.  a⁻¹ ∈ G
    axi:group-inverse-closed, from H2

2.  a·a⁻¹ = e
    axi:group-inverse, from H2

3.  a⁻¹ = b ↔ a·b = e
    both directions

    direction
    assume a⁻¹ = b                                                    (D1)

    3.1.  a·b = e
          substitute a⁻¹ = b (D1) into line 2

    direction
    assume a·b = e                                                    (D2)

    3.2.  a·a⁻¹ = a·b
          calculation
            a·a⁻¹ = e      2
                  = a·b    D2

    3.3.  a⁻¹ = b
          thm:group-cancel a := a⁻¹, g := a, from H2, H3, 1, 3.2


theorem group-inverse-by-left
  note        b·a = e says that a is the inverse of b, so b⁻¹ = a, and
              then a⁻¹ = (b⁻¹)⁻¹ = b.
  let G be a group with operation · and identity e                    (H1)
  let a ∈ G                                                           (H2)
  let b ∈ G                                                           (H3)
  then a⁻¹ = b ↔ b·a = e

1.  a⁻¹ = b ↔ b·a = e
    both directions

    direction
    assume a⁻¹ = b                                                    (D1)

    1.1.  a⁻¹·a = e
          thm:group-left-inverse, from H2

    1.2.  b·a = e
          substitute a⁻¹ = b (D1) into line 1.1

    direction
    assume b·a = e                                                    (D2)

    1.3.  a⁻¹ ∈ G
          axi:group-inverse-closed, from H2

    1.4.  a·a⁻¹ = e
          axi:group-inverse, from H2

    1.5.  a⁻¹ = b
          calculation
            a⁻¹ = e·a⁻¹              thm:group-left-identity a := a⁻¹, from 1.3
                = (b·a)·a⁻¹          substitute D2
                = b·(a·a⁻¹)          axi:group-associative a := b, b := a, c := a⁻¹, from H2, H3, 1.3
                = b·e                substitute line 1.4
                = b                  axi:group-identity a := b, from H3


theorem group-cancel-inverse
  note        a·(a⁻¹·b) = (a·a⁻¹)·b = e·b = b.
  let G be a group with operation · and identity e                    (H1)
  let a ∈ G                                                           (H2)
  let b ∈ G                                                           (H3)
  then a·(a⁻¹·b) = b

1.  a⁻¹ ∈ G
    axi:group-inverse-closed, from H2

2.  a·a⁻¹ = e
    axi:group-inverse, from H2

3.  a·(a⁻¹·b) = b
    calculation
      a·(a⁻¹·b) = (a·a⁻¹)·b     axi:group-associative b := a⁻¹, c := b, from H2, H3, 1
                = e·b           substitute line 2
                = b             thm:group-left-identity a := b, from H3
