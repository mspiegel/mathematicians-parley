import mundane definition stdlib/sets/subset
import mundane definition stdlib/sets/intersection

theorem intersection-subset-left
  note        Whatever is in both A and B is in A.
  let A be a set                                                      (H1)
  let B be a set                                                      (H2)
  then A ∩ B ⊆ A

1.  For all u ∈ A ∩ B, u ∈ A.
    proof
    let u ∈ A ∩ B                                                     (K1)

    1.1.  u ∈ A and u ∈ B
          mun:intersection, from K1

    1.2.  u ∈ A
          restate 1.1

2.  A ∩ B ⊆ A
    mun:subset, from 1


theorem intersection-subset-right
  note        Whatever is in both A and B is in B.
  let A be a set                                                      (H1)
  let B be a set                                                      (H2)
  then A ∩ B ⊆ B

1.  For all u ∈ A ∩ B, u ∈ B.
    proof
    let u ∈ A ∩ B                                                     (K1)

    1.1.  u ∈ A and u ∈ B
          mun:intersection, from K1

    1.2.  u ∈ B
          restate 1.1

2.  A ∩ B ⊆ B
    mun:subset, from 1
