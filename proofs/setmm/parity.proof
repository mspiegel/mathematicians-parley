import definition         stdlib/divisibility/even
import mundane theorem    stdlib/divisibility/even-or-odd
import definition         stdlib/divisibility/odd
import mundane theorem    stdlib/reasoning/or-left
import mundane theorem    stdlib/reasoning/or-right

theorem odd-plus-odd
  note        Two odd numbers 2k + 1 and 2l + 1 add to 2k + 2l + 2, which is
              twice k + l + 1.
  let A ∈ ℤ                                                           (H1)
  let B ∈ ℤ                                                           (H2)
  assume A is odd                                                     (H3)
  assume B is odd                                                     (H4)
  then A + B is even

1.  k ∈ ℤ. A = 2k + 1.
    obtain k: def:odd n := A, from H3

2.  l ∈ ℤ. B = 2l + 1.
    obtain l: def:odd n := B, from H4

3.  A + B = 2(k + l + 1)
    algebra, from 1, 2

4.  A + B is even
    def:even n := A + B, from 3

theorem odd-minus-odd
  note        Two odd numbers 2k + 1 and 2l + 1 differ by 2k − 2l, which is
              twice k − l.
  let A ∈ ℤ                                                           (H1)
  let B ∈ ℤ                                                           (H2)
  assume A is odd                                                     (H3)
  assume B is odd                                                     (H4)
  then A − B is even

1.  k ∈ ℤ. A = 2k + 1.
    obtain k: def:odd n := A, from H3

2.  l ∈ ℤ. B = 2l + 1.
    obtain l: def:odd n := B, from H4

3.  A − B = 2(k − l)
    algebra, from 1, 2

4.  A − B is even
    def:even n := A − B, from 3

theorem even-plus-odd
  note        An even 2k and an odd 2l + 1 add to 2k + 2l + 1, which is twice
              k + l, plus 1.
  let A ∈ ℤ                                                           (H1)
  let B ∈ ℤ                                                           (H2)
  assume A is even                                                    (H3)
  assume B is odd                                                     (H4)
  then A + B is odd

1.  k ∈ ℤ. A = 2k.
    obtain k: def:even n := A, from H3

2.  l ∈ ℤ. B = 2l + 1.
    obtain l: def:odd n := B, from H4

3.  A + B = 2(k + l) + 1
    algebra, from 1, 2

4.  A + B is odd
    def:odd n := A + B, from 3

theorem even-minus-odd
  note        An even 2k and an odd 2l + 1 differ by 2k − 2l − 1, which is
              twice k − l − 1, plus 1.
  let A ∈ ℤ                                                           (H1)
  let B ∈ ℤ                                                           (H2)
  assume A is even                                                    (H3)
  assume B is odd                                                     (H4)
  then A − B is odd

1.  k ∈ ℤ. A = 2k.
    obtain k: def:even n := A, from H3

2.  l ∈ ℤ. B = 2l + 1.
    obtain l: def:odd n := B, from H4

3.  A − B = 2(k − l − 1) + 1
    algebra, from 1, 2

4.  A − B is odd
    def:odd n := A − B, from 3

theorem odd-half
  note        If N = 2k + 1 then (N − 1)/2 is k. Conversely if (N − 1)/2 is
              an integer then N is twice it, plus 1.
  let N ∈ ℤ                                                           (H1)
  then N is odd ↔ (N − 1)/2 ∈ ℤ

1.  N is odd ↔ (N − 1)/2 ∈ ℤ
    both directions

    direction
    assume N is odd                                                   (D1)

    1.1.  k ∈ ℤ. N = 2k + 1.
          obtain k: def:odd n := N, from D1

    1.2.  (N − 1)/2 = k
          algebra, from 1.1

    1.3.  (N − 1)/2 ∈ ℤ
          membership, from 1.2

    direction
    assume (N − 1)/2 ∈ ℤ                                              (D2)

    1.4.  N = 2·((N − 1)/2) + 1
          algebra

    1.5.  N is odd
          def:odd n := N, from D2, 1.4

theorem half-or-next-half
  note        An even N is twice N/2. An odd N is 2k + 1, and then
              (N + 1)/2 is k + 1.
  let N ∈ ℤ                                                           (H1)
  then N/2 ∈ ℤ or (N + 1)/2 ∈ ℤ

1.  N is even or N is odd
    mun:even-or-odd n := N

2.  N/2 ∈ ℤ or (N + 1)/2 ∈ ℤ
    cases, from 1

    case
    assume N is even                                                  (C1)

    2.1.  k ∈ ℤ. N = 2k.
          obtain k: def:even n := N, from C1

    2.2.  N/2 = k
          algebra, from 2.1

    2.3.  N/2 ∈ ℤ
          membership, from 2.2

    2.4.  N/2 ∈ ℤ or (N + 1)/2 ∈ ℤ
          mun:or-left P := N/2 ∈ ℤ, Q := (N + 1)/2 ∈ ℤ, from 2.3

    case
    assume N is odd                                                   (C2)

    2.5.  k ∈ ℤ. N = 2k + 1.
          obtain k: def:odd n := N, from C2

    2.6.  (N + 1)/2 = k + 1
          algebra, from 2.5

    2.7.  (N + 1)/2 ∈ ℤ
          membership, from 2.6

    2.8.  N/2 ∈ ℤ or (N + 1)/2 ∈ ℤ
          mun:or-right P := N/2 ∈ ℤ, Q := (N + 1)/2 ∈ ℤ, from 2.7

theorem odd-square-over-eight
  note        With M = 2N + 1, M² − 1 is 4N² + 4N, which is 8 times
              N(N + 1)/2.
  let N ∈ ℤ                                                           (H1)
  let M = 2N + 1                                                      (D1)
         reads the odd number with half-index N
  then (M² − 1)/8 = N·(N + 1)/2

1.  (M² − 1)/8 = ((2N + 1)² − 1)/8
    substitute M = 2N + 1 (D1)

2.  ((2N + 1)² − 1)/8 = N·(N + 1)/2
    algebra

3.  (M² − 1)/8 = N·(N + 1)/2
    calculation
      (M² − 1)/8 = ((2N + 1)² − 1)/8     1
                 = N·(N + 1)/2           2
