import definition         stdlib/counting/factorial
import definition         stdlib/numbers/nat0
import mundane theorem    stdlib/numbers/nat-minus-one

theorem factorial-by-predecessor
  note        N! is the product up to N, so it is (N − 1)! times N. For N > 1
              that is the recursive rule of the factorial at N − 1; for N = 1
              both sides are 1.
  let N ∈ ℕ                                                           (H1)
  then N! = (N − 1)!·N

1.  N − 1 ∈ ℕ₀
    mun:nat-minus-one n := N

2.  N − 1 ∈ ℕ or N − 1 = 0
    def:nat0 n := N − 1, from 1

3.  N! = (N − 1)!·N
    cases, from 2

    case
    assume N − 1 ∈ ℕ                                                  (C1)

    3.1.  ((N − 1) + 1)! = (N − 1)!·((N − 1) + 1)
          def:factorial n := N − 1, from C1

    3.2.  (N − 1) + 1 = N
          algebra

    3.3.  ((N − 1) + 1)! = N!
          substitute (N − 1) + 1 = N (line 3.2)

    3.4.  (N − 1)!·((N − 1) + 1) = (N − 1)!·N
          substitute (N − 1) + 1 = N (line 3.2)

    3.5.  N! = (N − 1)!·N
          calculation
            N! = ((N − 1) + 1)!              3.3
               = (N − 1)!·((N − 1) + 1)      3.1
               = (N − 1)!·N                  3.4

    case
    assume N − 1 = 0                                                  (C2)

    3.6.  N = 1
          algebra, from C2

    3.7.  N! = 1!
          substitute N = 1 (line 3.6)

    3.8.  1! = 1
          def:factorial

    3.9.  (N − 1)! = 0!
          substitute N − 1 = 0 (C2)

    3.10. 0! = 1
          arithmetic

    3.11. (N − 1)! = 1
          calculation
            (N − 1)! = 0!      3.9
                     = 1       3.10

    3.12. (N − 1)!·N = 1·N
          substitute (N − 1)! = 1 (line 3.11)

    3.13. 1·N = 1
          restate 3.6

    3.14. N! = (N − 1)!·N
          calculation
            N! = 1!             3.7
               = 1              3.8
               = 1·N            3.13
               = (N − 1)!·N     3.12
