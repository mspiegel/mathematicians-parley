import definition         stdlib/counting/factorial
import definition         stdlib/numbers/nat0
import mundane theorem    stdlib/numbers/nat-minus-one

theorem factorial-by-predecessor
  note        N! is the product up to N, so it is (N − 1)! times N. For N > 1
              that is the recursive rule of the factorial at N − 1; for N = 1
              both sides are 1.
  let N ∈ ℕ                                                           (H1)
  then N! = (N − 1)!·N

1.  N − 1 ∈ ℕ₀
    mun:nat-minus-one n := N

2.  N − 1 ∈ ℕ or N − 1 = 0
    def:nat0 n := N − 1, from 1

3.  N! = (N − 1)!·N
    cases, from 2

    case
    assume N − 1 ∈ ℕ                                                  (C1)

    3.1.  (N − 1) + 1 = N
          algebra

    3.2.  N! = (N − 1)!·N
          calculation
            N! = ((N − 1) + 1)!              substitute line 3.1
               = (N − 1)!·((N − 1) + 1)      def:factorial n := N − 1, from C1
               = (N − 1)!·N                  substitute line 3.1

    case
    assume N − 1 = 0                                                  (C2)

    3.3.  N = 1
          algebra, from C2

    3.4.  (N − 1)! = 1
          calculation
            (N − 1)! = 0!      substitute C2
                     = 1       arithmetic

    3.5.  1·N = 1
          restate 3.3

    3.6.  N! = (N − 1)!·N
          calculation
            N! = 1!             substitute line 3.3
               = 1              def:factorial
               = 1·N            3.5
               = (N − 1)!·N     substitute line 3.4
