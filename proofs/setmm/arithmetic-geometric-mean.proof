import mundane definition stdlib/numbers/sqrt
import mundane theorem    stdlib/numbers/product-nonneg
import mundane theorem    stdlib/numbers/square-le
import mundane theorem    stdlib/numbers/square-nonneg

theorem arithmetic-geometric-mean
  note        Both √(A·B) and (A + B)/2 are at least 0, so the first is at
              most the second when its square is at most the second's. The
              square is A·B, and ((A + B)/2)² is A·B plus the square
              ((A − B)/2)².
  let A ∈ ℝ                                                           (H1)
  let B ∈ ℝ                                                           (H2)
  assume A ≥ 0                                                        (H3)
  assume B ≥ 0                                                        (H4)
  then √(A·B) ≤ (A + B)/2

1.  A·B ≥ 0
    mun:product-nonneg x := A, y := B, from H3, H4

2.  (√(A·B))² = A·B
    mun:sqrt x := A·B, from 1

3.  √(A·B) ≥ 0
    mun:sqrt x := A·B, from 1

4.  (A + B)/2 ≥ 0
    inequalities, from H3, H4

5.  ((A + B)/2)² = A·B + ((A − B)/2)²
    algebra

6.  ((A − B)/2)² ≥ 0
    mun:square-nonneg x := (A − B)/2

7.  (√(A·B))² ≤ ((A + B)/2)²
    inequalities, from 2, 5, 6
    requires √(A·B) ∈ ℝ: mun:sqrt x := A·B, from 1

8.  √(A·B) ≤ (A + B)/2
    mun:square-le x := √(A·B), y := (A + B)/2, from 3, 4, 7
    requires √(A·B) ∈ ℝ: mun:sqrt x := A·B, from 1
