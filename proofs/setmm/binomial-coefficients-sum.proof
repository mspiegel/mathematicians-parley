import theorem            proofs/wiedijk/binomial/binomial
import definition         stdlib/counting/C
import mundane theorem    stdlib/numbers/one-power
import mundane theorem    stdlib/sums/sum-termwise

theorem binomial-coefficients-sum
  metamath    binom11
  note        The binomial theorem at x = 1 and y = 1: every power of 1 is
              1, so the terms are the coefficients, and (1 + 1)^N is 2^N.
  let N ∈ ℕ₀                                                          (H1)
  then 2^N = Σ(k = 0 to N) C(N, k)

1.  For all k ∈ {0, …, N}, C(N, k)·1^(N − k)·1^k = C(N, k).
    proof
    let k ∈ {0, …, N}                                                 (J)

    1.1.  1^(N − k) = 1
          mun:one-power m := N − k

    1.2.  1^k = 1
          mun:one-power m := k

    1.3.  C(N, k)·1^(N − k)·1^k = C(N, k)
          calculation
            C(N, k)·1^(N − k)·1^k = C(N, k)·1^k     algebra, from 1.1
                                  = C(N, k)         algebra, from 1.2

2.  1 + 1 = 2
    arithmetic

3.  2^N = Σ(k = 0 to N) C(N, k)
    calculation
      2^N = (1 + 1)^N                                  substitute line 2
          = Σ(k = 0 to N) C(N, k)·1^(N − k)·1^k        thm:binomial x := 1, y := 1, n := N
          = Σ(k = 0 to N) C(N, k)                      mun:sum-termwise a := 0, b := N, from 1
