import theorem            stdlib/groups/group-cancel
import mundane theorem    stdlib/counting/card-equal
import mundane theorem    stdlib/counting/card-nat0
import mundane theorem    stdlib/counting/finite-part
import mundane theorem    stdlib/counting/partition-count
import mundane theorem    stdlib/counting/parts-finite
import mundane definition stdlib/divisibility/divides
import mundane definition stdlib/functions/bijection
import mundane theorem    stdlib/functions/function-into
import mundane definition stdlib/functions/one-to-one
import mundane definition stdlib/groups/coset
import mundane axiom      stdlib/groups/group-associative
import mundane axiom      stdlib/groups/group-closed
import mundane axiom      stdlib/groups/group-identity
import mundane axiom      stdlib/groups/group-inverse
import mundane axiom      stdlib/groups/group-inverse-closed
import mundane theorem    stdlib/groups/subgroup-closed
import mundane theorem    stdlib/groups/subgroup-identity
import mundane theorem    stdlib/groups/subgroup-inverse
import mundane theorem    stdlib/groups/subgroup-within
import mundane theorem    stdlib/sets/in-subset
import mundane definition stdlib/sets/indexed-union
import mundane definition stdlib/sets/intersection
import mundane definition stdlib/sets/part-builder
import mundane definition stdlib/sets/subset
import mundane theorem    stdlib/sets/subset-antisymmetric
import mundane theorem    stdlib/sets/union-within

theorem lagrange
  metamath    lagsubg, which says it of the index set.mm builds from the
              relation of being in one coset, where this counts the cosets
  note        The cosets of H split G into parts, each with as many elements
              as H. So |G| is |H| times the number of cosets.
  let G be a finite group with operation · and identity e             (H1)
  assume H is a subgroup of G                                         (H2)
  then |H| divides |G|

define K := {X ⊆ G : there is g ∈ G with X = gH}                    (D1)
       reads the cosets of H: the parts of G of the form gH

1.  H ⊆ G
    mun:subgroup-within, from H2

2.  H is finite
    mun:finite-part, from H1, 1

3.  For all g ∈ G, gH ⊆ G.
    proof
    let g ∈ G                                                         (K1)

    3.1.  For all u ∈ gH, u ∈ G.
          proof
          let u ∈ gH                                                  (K2)

          3.1.1.  h ∈ H. u = g·h.
                  obtain h: mun:coset u := u, from K1, K2
                  requires H ⊆ G: from 1

          3.1.2.  h ∈ G
                  mun:in-subset, from 1, 3.1.1

          3.1.3.  g·h ∈ G
                  mun:group-closed a := g, b := h, from K1, 3.1.2

          3.1.4.  u ∈ G
                  substitute u = g·h (line 3.1.1) into line 3.1.3

    3.2.  gH ⊆ G
          mun:subset, from 3.1

4.  For all g ∈ G, g ∈ gH.
    proof
    let g ∈ G                                                         (K3)

    4.1.  e ∈ H
          mun:subgroup-identity, from H2

    4.2.  g·e = g
          mun:group-identity a := g, from K3

    4.3.  g ∈ gH
          mun:coset u := g, from K3, 4.1, 4.2
          requires H ⊆ G: from 1

5.  For all a ∈ G, for all x ∈ aH, xH ⊆ aH.
    proof
    let a ∈ G                                                         (K4)
    let x ∈ aH                                                        (K5)

    5.1.  h ∈ H. x = a·h.
          obtain h: mun:coset u := x, g := a, from K4, K5
          requires H ⊆ G: from 1

    5.2.  aH ⊆ G
          instantiate g := a in line 3, from K4

    5.3.  x ∈ G
          mun:in-subset, from 5.2, K5

    5.4.  h ∈ G
          mun:in-subset, from 1, 5.1

    5.5.  For all u ∈ xH, u ∈ aH.
          proof
          let u ∈ xH                                                  (K6)

          5.5.1.  c ∈ H. u = x·c.
                  obtain c: mun:coset u := u, g := x, from 5.3, K6
                  requires H ⊆ G: from 1

          5.5.2.  c ∈ G
                  mun:in-subset, from 1, 5.5.1

          5.5.3.  h·c ∈ H
                  mun:subgroup-closed a := h, b := c, from H2, 5.1, 5.5.1

          5.5.4.  (a·h)·c = a·(h·c)
                  mun:group-associative a := a, b := h, c := c, from K4, 5.4, 5.5.2

          5.5.5.  x·c = (a·h)·c
                  substitute x = a·h (line 5.1)

          5.5.6.  u = a·(h·c)
                  calculation
                    u = x·c              5.5.1
                      = (a·h)·c          5.5.5
                      = a·(h·c)          5.5.4

          5.5.7.  u ∈ aH
                  mun:coset u := u, g := a, from K4, 5.5.3, 5.5.6
                  requires H ⊆ G: from 1

    5.6.  xH ⊆ aH
          mun:subset, from 5.5

6.  For all a ∈ G, for all x ∈ aH, a ∈ xH.
    proof
    let a ∈ G                                                         (K7)
    let x ∈ aH                                                        (K8)

    6.1.  h ∈ H. x = a·h.
          obtain h: mun:coset u := x, g := a, from K7, K8
          requires H ⊆ G: from 1

    6.2.  h ∈ G
          mun:in-subset, from 1, 6.1

    6.3.  h⁻¹ ∈ H
          mun:subgroup-inverse a := h, from H2, 6.1

    6.4.  h⁻¹ ∈ G
          mun:group-inverse-closed a := h, from 6.2

    6.5.  (a·h)·h⁻¹ = a·(h·h⁻¹)
          mun:group-associative a := a, b := h, c := h⁻¹, from K7, 6.2, 6.4

    6.6.  h·h⁻¹ = e
          mun:group-inverse a := h, from 6.2

    6.7.  a·(h·h⁻¹) = a·e
          substitute h·h⁻¹ = e (line 6.6)

    6.8.  a·e = a
          mun:group-identity a := a, from K7

    6.9.  x·h⁻¹ = (a·h)·h⁻¹
          substitute x = a·h (line 6.1)

    6.10. a = x·h⁻¹
          calculation
            a = a·e                  6.8
              = a·(h·h⁻¹)            6.7
              = (a·h)·h⁻¹            6.5
              = x·h⁻¹                6.9

    6.11. aH ⊆ G
          instantiate g := a in line 3, from K7

    6.12. x ∈ G
          mun:in-subset, from 6.11, K8

    6.13. a ∈ xH
          mun:coset u := a, g := x, from 6.12, 6.3, 6.10
          requires H ⊆ G: from 1

7.  For all b ∈ G, for all y ∈ bH, yH = bH.
    proof
    let b ∈ G                                                         (K9)
    let y ∈ bH                                                        (K10)

    7.1.  yH ⊆ bH
          instantiate a := b, x := y in line 5, from K9, K10

    7.2.  bH ⊆ G
          instantiate g := b in line 3, from K9

    7.3.  y ∈ G
          mun:in-subset, from 7.2, K10

    7.4.  b ∈ yH
          instantiate a := b, x := y in line 6, from K9, K10

    7.5.  bH ⊆ yH
          instantiate a := y, x := b in line 5, from 7.3, 7.4

    7.6.  yH = bH
          mun:subset-antisymmetric, from 7.1, 7.5

8.  For all g ∈ G, |gH| = |H|.
    proof
    let g ∈ G                                                         (K11)

    define t(c) := g·c, for c ∈ H                                     (D2)
           reads g times c

    8.1.  For all h ∈ H, t(h) ∈ gH.
          proof
          let h ∈ H                                                   (K12)

          8.1.1.  t(h) = g·h
                  D2, from K12

          8.1.2.  t(h) ∈ gH
                  mun:coset u := t(h), from K11, K12, 8.1.1
                  requires H ⊆ G: from 1

    8.2.  t : H → gH
          mun:function-into, from 8.1
          requires t is a function on H: from D2

    8.3.  For all s, r ∈ H, if t(s) = t(r) then s = r.
          proof
          let s ∈ H                                                   (K13)
          let r ∈ H                                                   (K14)
          assume t(s) = t(r)                                          (A1)

          8.3.1.  t(s) = g·s
                  D2, from K13

          8.3.2.  t(r) = g·r
                  D2, from K14

          8.3.3.  g·s = g·r
                  calculation
                    g·s = t(s)           8.3.1
                        = t(r)           A1
                        = g·r            8.3.2

          8.3.4.  s ∈ G
                  mun:in-subset, from 1, K13

          8.3.5.  r ∈ G
                  mun:in-subset, from 1, K14

          8.3.6.  s = r
                  thm:group-cancel a := s, b := r, g := g, from 8.3.4, 8.3.5, K11, 8.3.3

    8.4.  t : H → gH is one-to-one
          mun:one-to-one, from 8.2, 8.3

    8.5.  For all u ∈ gH, there is h ∈ H with u = t(h).
          proof
          let u ∈ gH                                                  (K15)

          8.5.1.  h ∈ H. u = g·h.
                  obtain h: mun:coset u := u, from K11, K15
                  requires H ⊆ G: from 1

          8.5.2.  t(h) = g·h
                  D2, from 8.5.1

          8.5.3.  u = t(h)
                  calculation
                    u = g·h              8.5.1
                      = t(h)             8.5.2

          8.5.4.  There is h ∈ H with u = t(h).
                  exhibit, from 8.5.1, 8.5.3

    8.6.  There is a bijection from H to gH.
          mun:bijection, from 8.4, 8.5

    8.7.  |H| = |gH|
          mun:card-equal X := H, Y := gH, from 2, 8.6

9.  For all Y ∈ K, Y ⊆ G.
    mun:part-builder, from D1

10. ⋃(Y ∈ K) Y ⊆ G
    mun:union-within, from 9

11. For all g ∈ G, g ∈ ⋃(Y ∈ K) Y.
    proof
    let g ∈ G                                                         (K17)

    11.1. gH ⊆ G
          instantiate g := g in line 3, from K17

    11.2. There is a ∈ G with gH = aH.
          exhibit, from K17

    11.3. gH ∈ K
          mun:part-builder u := gH, from D1, 11.1, 11.2

    11.4. g ∈ gH
          instantiate g := g in line 4, from K17

    11.5. There is Y ∈ K with g ∈ Y.
          exhibit, from 11.3, 11.4

    11.6. g ∈ ⋃(Y ∈ K) Y
          mun:indexed-union u := g, from 11.5

12. G ⊆ ⋃(Y ∈ K) Y
    mun:subset, from 11

13. ⋃(Y ∈ K) Y = G
    mun:subset-antisymmetric, from 10, 12

14. For all Y, Z ∈ K, for all x ∈ Y ∩ Z, Y = Z.
    proof
    let Y ∈ K                                                         (K18)
    let Z ∈ K                                                         (K19)
    let x ∈ Y ∩ Z                                                     (K20)

    14.1. a ∈ G. Y = aH.
          obtain a: mun:part-builder, from D1, K18

    14.2. b ∈ G. Z = bH.
          obtain b: mun:part-builder, from D1, K19

    14.3. x ∈ Y. x ∈ Z.
          mun:intersection, from K20

    14.4. x ∈ aH
          substitute Y = aH (line 14.1) into line 14.3

    14.5. x ∈ bH
          substitute Z = bH (line 14.2) into line 14.3

    14.6. xH = aH
          instantiate b := a, y := x in line 7, from 14.1, 14.4

    14.7. xH = bH
          instantiate b := b, y := x in line 7, from 14.2, 14.5

    14.8. Y = Z
          calculation
            Y = aH                  14.1
              = xH                  14.6
              = bH                  14.7
              = Z                   14.2

15. For all Y ∈ K, |Y| = |H|.
    proof
    let Y ∈ K                                                         (K21)

    15.1. a ∈ G. Y = aH.
          obtain a: mun:part-builder, from D1, K21

    15.2. |H| = |aH|
          instantiate g := a in line 8, from 15.1

    15.3. |Y| = |aH|
          substitute Y = aH (line 15.1)

    15.4. |Y| = |H|
          calculation
            |Y| = |aH|               15.3
                = |H|                15.2

16. |G| = |K| · |H|
    mun:partition-count A := G, m := |H|, from H1, 13, 14, 15
    requires |H| ∈ ℕ₀: mun:card-nat0, from 2

17. K is finite
    mun:parts-finite A := G, from H1, 9

18. |G| = |H|·|K|
    algebra, from 16
    requires |G| ∈ ℕ₀: mun:card-nat0, from H1
    requires |K| ∈ ℕ₀: mun:card-nat0, from 17
    requires |H| ∈ ℕ₀: mun:card-nat0, from 2

19. |H| divides |G|
    mun:divides d := |H|, n := |G|, from 18
    requires |H| ∈ ℕ₀: mun:card-nat0, from 2
    requires |K| ∈ ℕ₀: mun:card-nat0, from 17
    requires |G| ∈ ℕ₀: mun:card-nat0, from H1
