import theorem            stdlib/divisibility/sigma-multiplicative
import theorem            stdlib/divisibility/sigma-prime
import theorem            stdlib/divisibility/sigma-prime-power
import theorem            proofs/geometric-series/geometric-sum
import mundane theorem    stdlib/divisibility/divides-difference
import mundane theorem    stdlib/divisibility/divides-multiple
import mundane theorem    stdlib/divisibility/divides-one
import mundane theorem    stdlib/divisibility/divides-self
import mundane definition stdlib/divisibility/gcd
import mundane theorem    stdlib/divisibility/gcd-commutes
import mundane definition stdlib/divisibility/prime
import mundane theorem    stdlib/divisibility/prime-coprime
import mundane theorem    stdlib/divisibility/prime-nat
import mundane theorem    stdlib/divisibility/two-prime
import mundane theorem    stdlib/numbers/exponent-step
import mundane theorem    stdlib/numbers/nat-closure
import mundane theorem    stdlib/numbers/nat-minus-one
import mundane theorem    stdlib/numbers/power-nat
import definition         stdlib/divisibility/perfect
import definition         stdlib/divisibility/σ

theorem euclid-perfect
  metamath    perfect1
  let p ∈ ℕ                                                           (H1)
  assume 2^p − 1 is prime                                             (H2)
  then 2^(p − 1)·(2^p − 1) is perfect

1.  2^p ∈ ℕ
    mun:power-nat a := 2, m := p, from H1
    requires 2 ∈ ℕ: arithmetic

2.  2^p − 1 ∈ ℕ
    mun:prime-nat p := 2^p − 1, from H2
    requires 2^p − 1 ∈ ℤ: membership, from 1

3.  p − 1 ∈ ℕ₀
    mun:nat-minus-one n := p, from H1

4.  2^(p − 1) ∈ ℕ
    mun:power-nat a := 2, m := p − 1, from 3
    requires 2 ∈ ℕ: arithmetic

5.  (p − 1) + 1 = p
    algebra
    requires p ∈ ℝ: from H1

6.  2^((p − 1) + 1) = 2^(p − 1)·2
    mun:exponent-step a := 2, m := p − 1, from 3
    requires 2 ∈ ℝ: arithmetic

7.  2^p = 2^(p − 1)·2
    substitute (p − 1) + 1 = p (line 5) into line 6

8.  not (2^p − 1 divides 2^(p − 1))
    contradiction
    suppose 2^p − 1 divides 2^(p − 1)                                 (S)

    8.1.  2^p − 1 divides 2^(p − 1)·2
          mun:divides-multiple e := 2^p − 1, a := 2^(p − 1), x := 2, from 2, 4, S
          requires 2 ∈ ℤ: arithmetic

    8.2.  2^p − 1 divides 2^p
          substitute 2^p = 2^(p − 1)·2 (line 7) into line 8.1

    8.3.  2^p − 1 divides 2^p − 1
          mun:divides-self n := 2^p − 1, from 2

    8.4.  2^p − 1 divides 2^p − (2^p − 1)
          mun:divides-difference d := 2^p − 1, a := 2^p, b := 2^p − 1, from 2, 1, 8.2, 8.3

    8.5.  2^p − (2^p − 1) = 1
          algebra
          requires 2^p ∈ ℝ: from 1

    8.6.  2^p − 1 divides 1
          substitute 2^p − (2^p − 1) = 1 (line 8.5) into line 8.4

    8.7.  2^p − 1 = 1
          mun:divides-one d := 2^p − 1, from 2, 8.6

    8.8.  2^p − 1 > 1
          mun:prime p := 2^p − 1, from 2, H2

    8.9.  2^p − 1 ≠ 1
          inequalities, from 8.8, contradicting 8.7
          requires 2^p ∈ ℝ: from 1

9.  gcd(2^p − 1, 2^(p − 1)) = 1
    mun:prime-coprime p := 2^p − 1, a := 2^(p − 1), from 2, H2, 4, 8

10. gcd(2^(p − 1), 2^p − 1) = gcd(2^p − 1, 2^(p − 1))
    mun:gcd-commutes a := 2^(p − 1), b := 2^p − 1, from 4, 2

11. gcd(2^(p − 1), 2^p − 1) = 1
    calculation
      gcd(2^(p − 1), 2^p − 1) = gcd(2^p − 1, 2^(p − 1))     10
                             = 1                            9

12. σ(2^(p − 1)·(2^p − 1)) = σ(2^(p − 1))·σ(2^p − 1)
    thm:sigma-multiplicative m := 2^(p − 1), n := 2^p − 1, from 4, 2, 11

13. σ(2^p − 1) = (2^p − 1) + 1
    thm:sigma-prime p := 2^p − 1, from 2, H2

14. (2^p − 1) + 1 = 2^p
    algebra
    requires 2^p ∈ ℝ: from 1

15. σ(2^p − 1) = 2^p
    calculation
      σ(2^p − 1) = (2^p − 1) + 1      13
                 = 2^p                14

16. σ(2^(p − 1)) = Σ(j = 0 to p − 1) 2^j
    thm:sigma-prime-power p := 2, k := p − 1, from 3
    requires 2 ∈ ℕ: arithmetic
    requires 2 is prime: mun:two-prime

17. Σ(j = 0 to p − 1) 2^j = (1 − 2^((p − 1) + 1))/(1 − 2)
    thm:geometric-sum a := 2, n := p − 1, from 3
    requires 2 ∈ ℝ: arithmetic
    requires 2 ≠ 1: arithmetic

18. (1 − 2^((p − 1) + 1))/(1 − 2) = (1 − 2^p)/(1 − 2)
    substitute (p − 1) + 1 = p (line 5)

19. (1 − 2^p)/(1 − 2) = 2^p − 1
    algebra
    requires 2^p ∈ ℝ: from 1

20. σ(2^(p − 1)) = 2^p − 1
    calculation
      σ(2^(p − 1)) = Σ(j = 0 to p − 1) 2^j            16
                   = (1 − 2^((p − 1) + 1))/(1 − 2)    17
                   = (1 − 2^p)/(1 − 2)                18
                   = 2^p − 1                          19

21. σ(2^(p − 1))·σ(2^p − 1) = (2^p − 1)·σ(2^p − 1)
    substitute σ(2^(p − 1)) = 2^p − 1 (line 20)

22. (2^p − 1)·σ(2^p − 1) = (2^p − 1)·2^p
    substitute σ(2^p − 1) = 2^p (line 15)

23. (2^p − 1)·2^p = 2·(2^(p − 1)·(2^p − 1))
    algebra, from 7
    requires 2^p ∈ ℝ: from 1
    requires 2^(p − 1) ∈ ℝ: from 4

24. σ(2^(p − 1)·(2^p − 1)) = 2·(2^(p − 1)·(2^p − 1))
    calculation
      σ(2^(p − 1)·(2^p − 1)) = σ(2^(p − 1))·σ(2^p − 1)      12
                             = (2^p − 1)·σ(2^p − 1)          21
                             = (2^p − 1)·2^p                 22
                             = 2·(2^(p − 1)·(2^p − 1))       23

25. 2^(p − 1)·(2^p − 1) is perfect
    def:perfect n := 2^(p − 1)·(2^p − 1), from 24
    requires 2^(p − 1)·(2^p − 1) ∈ ℕ: mun:nat-closure, from 4, 2
