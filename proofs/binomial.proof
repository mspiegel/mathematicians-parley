import theorem            stdlib/counting/pascal
import mundane theorem    stdlib/counting/binomial-nat0
import mundane theorem    stdlib/counting/binomial-zero-index
import mundane theorem    stdlib/numbers/exponent-step
import mundane theorem    stdlib/numbers/int-closure
import mundane theorem    stdlib/numbers/nat0-closure
import mundane theorem    stdlib/numbers/power-real
import mundane theorem    stdlib/numbers/real-closure
import mundane theorem    stdlib/sums/range-difference
import mundane theorem    stdlib/sums/range-integer
import mundane theorem    stdlib/sums/range-nat0
import mundane theorem    stdlib/sums/sum-add
import mundane theorem    stdlib/sums/sum-first
import mundane theorem    stdlib/sums/sum-last
import mundane theorem    stdlib/sums/sum-scaled
import mundane theorem    stdlib/sums/sum-shift
import mundane theorem    stdlib/sums/sum-real
import mundane theorem    stdlib/sums/sum-single
import mundane theorem    stdlib/sums/sum-termwise
import definition         stdlib/counting/C

theorem binomial-step
  note        The induction step's algebra, stated apart from the induction.
              Inside the step the hypothesis is in scope and names the sum's
              index, and set.mm's lemma for rewriting a sum term by term
              forbids its index in the scope; here nothing in scope names it.
  let x ∈ ℝ                                                           (H1)
  let y ∈ ℝ                                                           (H2)
  let m ∈ ℕ₀                                                          (H3)
  then (Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k)·(x + y) = Σ(k = 0 to m + 1) C(m + 1, k)·x^((m + 1) − k)·y^k

1.  (Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k)·(x + y) = x·(Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k) + y·(Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k)
    algebra
    requires x ∈ ℝ: from H1
    requires y ∈ ℝ: from H2
    requires 0 ∈ ℤ: arithmetic
    requires m ∈ ℕ₀: from H3
    requires Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k ∈ ℝ: mun:sum-real a := 0, b := m

2.  x·(Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k) = Σ(k = 0 to m) x·(C(m, k)·x^(m − k)·y^k)
    mun:sum-scaled a := 0, b := m, c := x
    requires 0 ∈ ℤ: arithmetic
    requires m ∈ ℕ₀: from H3
    requires x ∈ ℝ: from H1
    requires y ∈ ℝ: from H2

3.  For all k ∈ {0, …, m}, x·(C(m, k)·x^(m − k)·y^k) = C(m, k)·x^((m + 1) − k)·y^k.
    fix
    note each of x and y times the sum gains a zero term, so both run from 0 to m + 1
    let k ∈ {0, …, m}                                                 (J)

    3.1.  x^((m − k) + 1) = x^(m − k)·x
          mun:exponent-step a := x, m := m − k, from H1
          requires 0 ∈ ℤ: arithmetic
          requires m ∈ ℤ: from H3
          requires m − k ∈ ℕ₀: mun:range-difference a := 0, n := m, from J

    3.2.  (m − k) + 1 = (m + 1) − k
          algebra
          requires 0 ∈ ℤ: arithmetic
          requires m ∈ ℤ: from H3
          requires k ∈ ℤ: mun:range-integer a := 0, b := m, from J

    3.3.  x^((m − k) + 1) = x^((m + 1) − k)
          substitute (m − k) + 1 = (m + 1) − k (line 3.2)

    3.4.  x^(m − k)·x = x^((m + 1) − k)
          calculation
            x^(m − k)·x = x^((m − k) + 1)       3.1
                        = x^((m + 1) − k)       3.3

    3.5.  x·(C(m, k)·x^(m − k)·y^k) = C(m, k)·(x^(m − k)·x)·y^k
          algebra
          requires x ∈ ℝ: from H1
          requires 0 ∈ ℤ: arithmetic
          requires m ∈ ℤ: from H3
          requires k ∈ ℤ: mun:range-integer a := 0, b := m, from J
          requires C(m, k) ∈ ℕ₀: mun:binomial-nat0, from H3
          requires m − k ∈ ℕ₀: mun:range-difference a := 0, n := m, from J
          requires x^(m − k) ∈ ℝ: mun:power-real, from H1
          requires k ∈ ℕ₀: mun:range-nat0 n := m, from J
          requires y^k ∈ ℝ: mun:power-real, from H2

    3.6.  C(m, k)·(x^(m − k)·x)·y^k = C(m, k)·x^((m + 1) − k)·y^k
          substitute x^(m − k)·x = x^((m + 1) − k) (line 3.4)

    3.7.  x·(C(m, k)·x^(m − k)·y^k) = C(m, k)·x^((m + 1) − k)·y^k
          calculation
            x·(C(m, k)·x^(m − k)·y^k) = C(m, k)·(x^(m − k)·x)·y^k      3.5
                                      = C(m, k)·x^((m + 1) − k)·y^k    3.6

4.  Σ(k = 0 to m) x·(C(m, k)·x^(m − k)·y^k) = Σ(k = 0 to m) C(m, k)·x^((m + 1) − k)·y^k
    mun:sum-termwise a := 0, b := m, from 3
    requires 0 ∈ ℤ: arithmetic
    requires m ∈ ℤ: from H3

5.  m < m + 1
    inequalities
    requires m ∈ ℝ: from H3

6.  C(m, m + 1) = 0
    def:C n := m, k := m + 1, from H3, 5
    requires m + 1 ∈ ℕ₀: mun:nat0-closure, from H3

7.  (m + 1) − (m + 1) = 0
    algebra
    requires m ∈ ℝ: from H3

8.  C(m, m + 1)·x^((m + 1) − (m + 1))·y^(m + 1) = C(m, m + 1)·x^0·y^(m + 1)
    substitute (m + 1) − (m + 1) = 0 (line 7)

9.  C(m, m + 1)·x^0·y^(m + 1) = 0·x^0·y^(m + 1)
    substitute C(m, m + 1) = 0 (line 6)

10. 0·x^0·y^(m + 1) = 0
    algebra
    requires x ∈ ℝ: from H1
    requires m + 1 ∈ ℕ₀: mun:nat0-closure, from H3
    requires y^(m + 1) ∈ ℝ: mun:power-real a := y, m := m + 1, from H2

11. C(m, m + 1)·x^((m + 1) − (m + 1))·y^(m + 1) = 0
    calculation
      C(m, m + 1)·x^((m + 1) − (m + 1))·y^(m + 1) = C(m, m + 1)·x^0·y^(m + 1)    8
                                                  = 0·x^0·y^(m + 1)               9
                                                  = 0                             10

12. Σ(k = 0 to m + 1) C(m, k)·x^((m + 1) − k)·y^k = Σ(k = 0 to m) C(m, k)·x^((m + 1) − k)·y^k + C(m, m + 1)·x^((m + 1) − (m + 1))·y^(m + 1)
    mun:sum-last n := m, from H3
    requires x ∈ ℝ: from H1
    requires y ∈ ℝ: from H2

13. Σ(k = 0 to m + 1) C(m, k)·x^((m + 1) − k)·y^k = Σ(k = 0 to m) C(m, k)·x^((m + 1) − k)·y^k + 0
    substitute C(m, m + 1)·x^((m + 1) − (m + 1))·y^(m + 1) = 0 (line 11) into line 12

14. x·(Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k) = Σ(k = 0 to m) C(m, k)·x^((m + 1) − k)·y^k
    calculation
      x·(Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k) = Σ(k = 0 to m) x·(C(m, k)·x^(m − k)·y^k)      2
                                              = Σ(k = 0 to m) C(m, k)·x^((m + 1) − k)·y^k    4

15. Σ(k = 0 to m + 1) C(m, k)·x^((m + 1) − k)·y^k = x·(Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k) + 0
    substitute x·(Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k) = Σ(k = 0 to m) C(m, k)·x^((m + 1) − k)·y^k (line 14) into line 13

16. x·(Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k) + 0 = x·(Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k)
    algebra
    requires x ∈ ℝ: from H1
    requires y ∈ ℝ: from H2
    requires 0 ∈ ℤ: arithmetic
    requires m ∈ ℕ₀: from H3
    requires Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k ∈ ℝ: mun:sum-real a := 0, b := m

17. x·(Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k) = Σ(k = 0 to m + 1) C(m, k)·x^((m + 1) − k)·y^k
    calculation
      x·(Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k) = x·(Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k) + 0    16
                                              = Σ(k = 0 to m + 1) C(m, k)·x^((m + 1) − k)·y^k    15

18. y·(Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k) = Σ(k = 0 to m) y·(C(m, k)·x^(m − k)·y^k)
    mun:sum-scaled a := 0, b := m, c := y
    requires 0 ∈ ℤ: arithmetic
    requires m ∈ ℕ₀: from H3
    requires x ∈ ℝ: from H1
    requires y ∈ ℝ: from H2

19. For all k ∈ {0, …, m}, y·(C(m, k)·x^(m − k)·y^k) = C(m, k)·x^(m − k)·y^(k + 1).
    fix
    let k ∈ {0, …, m}                                                 (J)

    19.1.  y^(k + 1) = y^k·y
           mun:exponent-step a := y, m := k, from H2
           requires m ∈ ℤ: from H3
           requires k ∈ ℕ₀: mun:range-nat0 n := m, from J

    19.2.  y·(C(m, k)·x^(m − k)·y^k) = C(m, k)·x^(m − k)·(y^k·y)
           algebra
           requires y ∈ ℝ: from H2
           requires 0 ∈ ℤ: arithmetic
           requires m ∈ ℤ: from H3
           requires k ∈ ℤ: mun:range-integer a := 0, b := m, from J
           requires C(m, k) ∈ ℕ₀: mun:binomial-nat0, from H3
           requires m − k ∈ ℕ₀: mun:range-difference a := 0, n := m, from J
           requires x^(m − k) ∈ ℝ: mun:power-real, from H1
           requires k ∈ ℕ₀: mun:range-nat0 n := m, from J
           requires y^k ∈ ℝ: mun:power-real, from H2

    19.3.  C(m, k)·x^(m − k)·(y^k·y) = C(m, k)·x^(m − k)·y^(k + 1)
           substitute y^(k + 1) = y^k·y (line 19.1)

    19.4.  y·(C(m, k)·x^(m − k)·y^k) = C(m, k)·x^(m − k)·y^(k + 1)
           calculation
             y·(C(m, k)·x^(m − k)·y^k) = C(m, k)·x^(m − k)·(y^k·y)      19.2
                                       = C(m, k)·x^(m − k)·y^(k + 1)    19.3

20. Σ(k = 0 to m) y·(C(m, k)·x^(m − k)·y^k) = Σ(k = 0 to m) C(m, k)·x^(m − k)·y^(k + 1)
    mun:sum-termwise a := 0, b := m, from 19
    requires 0 ∈ ℤ: arithmetic
    requires m ∈ ℤ: from H3

21. Σ(k = 0 to m) C(m, k)·x^(m − k)·y^(k + 1) = Σ(k = 0 + 1 to m + 1) C(m, k − 1)·x^(m − (k − 1))·y^((k − 1) + 1)
    mun:sum-shift a := 0, b := m, c := 1
    requires 0 ∈ ℤ: arithmetic
    requires 1 ∈ ℤ: arithmetic
    requires m ∈ ℕ₀: from H3
    requires x ∈ ℝ: from H1
    requires y ∈ ℝ: from H2

22. Σ(k = 0 + 1 to m + 1) C(m, k − 1)·x^(m − (k − 1))·y^((k − 1) + 1) = Σ(k = 1 to m + 1) C(m, k − 1)·x^(m − (k − 1))·y^((k − 1) + 1)
    substitute 0 + 1 = 1 (arithmetic)

23. For all k ∈ {1, …, m + 1}, C(m, k − 1)·x^(m − (k − 1))·y^((k − 1) + 1) = C(m, k − 1)·x^((m + 1) − k)·y^k.
    fix
    let k ∈ {1, …, m + 1}                                             (J)

    23.1.  m − (k − 1) = (m + 1) − k
           algebra
           requires m ∈ ℝ: from H3
           requires 1 ∈ ℤ: arithmetic
           requires m + 1 ∈ ℤ: membership, from H3
           requires k ∈ ℤ: mun:range-integer a := 1, b := m + 1, from J

    23.2.  (k − 1) + 1 = k
           algebra
           requires 1 ∈ ℤ: arithmetic
           requires m + 1 ∈ ℤ: membership, from H3
           requires k ∈ ℤ: mun:range-integer a := 1, b := m + 1, from J

    23.3.  C(m, k − 1)·x^(m − (k − 1))·y^((k − 1) + 1) = C(m, k − 1)·x^((m + 1) − k)·y^((k − 1) + 1)
           substitute m − (k − 1) = (m + 1) − k (line 23.1)

    23.4.  C(m, k − 1)·x^((m + 1) − k)·y^((k − 1) + 1) = C(m, k − 1)·x^((m + 1) − k)·y^k
           substitute (k − 1) + 1 = k (line 23.2)

    23.5.  C(m, k − 1)·x^(m − (k − 1))·y^((k − 1) + 1) = C(m, k − 1)·x^((m + 1) − k)·y^k
           calculation
             C(m, k − 1)·x^(m − (k − 1))·y^((k − 1) + 1) = C(m, k − 1)·x^((m + 1) − k)·y^((k − 1) + 1)    23.3
                                                         = C(m, k − 1)·x^((m + 1) − k)·y^k                23.4

24. Σ(k = 1 to m + 1) C(m, k − 1)·x^(m − (k − 1))·y^((k − 1) + 1) = Σ(k = 1 to m + 1) C(m, k − 1)·x^((m + 1) − k)·y^k
    mun:sum-termwise a := 1, b := m + 1, from 23
    requires 1 ∈ ℤ: arithmetic
    requires m + 1 ∈ ℤ: membership, from H3

25. C(m, −1) = 0
    def:C n := m, from H3

26. C(m, 0 − 1) = C(m, −1)
    substitute 0 − 1 = −1 (arithmetic)

27. C(m, 0 − 1) = 0
    calculation
      C(m, 0 − 1) = C(m, −1)    26
                  = 0           25

28. (m + 1) − 0 = m + 1
    algebra
    requires m ∈ ℝ: from H3

29. C(m, 0 − 1)·x^((m + 1) − 0)·y^0 = C(m, 0 − 1)·x^(m + 1)·y^0
    substitute (m + 1) − 0 = m + 1 (line 28)

30. C(m, 0 − 1)·x^(m + 1)·y^0 = 0·x^(m + 1)·y^0
    substitute C(m, 0 − 1) = 0 (line 27)

31. 0·x^(m + 1)·y^0 = 0
    algebra
    requires m + 1 ∈ ℕ₀: mun:nat0-closure, from H3
    requires x^(m + 1) ∈ ℝ: mun:power-real a := x, m := m + 1, from H1
    requires y ∈ ℝ: from H2

32. C(m, 0 − 1)·x^((m + 1) − 0)·y^0 = 0
    calculation
      C(m, 0 − 1)·x^((m + 1) − 0)·y^0 = C(m, 0 − 1)·x^(m + 1)·y^0    29
                                      = 0·x^(m + 1)·y^0              30
                                      = 0                            31

33. Σ(k = 0 to m + 1) C(m, k − 1)·x^((m + 1) − k)·y^k = C(m, 0 − 1)·x^((m + 1) − 0)·y^0 + Σ(k = 0 + 1 to m + 1) C(m, k − 1)·x^((m + 1) − k)·y^k
    mun:sum-first n := m + 1
    requires m + 1 ∈ ℕ₀: mun:nat0-closure, from H3
    requires m ∈ ℕ₀: from H3
    requires x ∈ ℝ: from H1
    requires y ∈ ℝ: from H2

34. Σ(k = 0 to m + 1) C(m, k − 1)·x^((m + 1) − k)·y^k = 0 + Σ(k = 0 + 1 to m + 1) C(m, k − 1)·x^((m + 1) − k)·y^k
    substitute C(m, 0 − 1)·x^((m + 1) − 0)·y^0 = 0 (line 32) into line 33

35. Σ(k = 0 to m + 1) C(m, k − 1)·x^((m + 1) − k)·y^k = 0 + Σ(k = 1 to m + 1) C(m, k − 1)·x^((m + 1) − k)·y^k
    substitute 0 + 1 = 1 (arithmetic) into line 34

36. 0 + Σ(k = 1 to m + 1) C(m, k − 1)·x^((m + 1) − k)·y^k = Σ(k = 1 to m + 1) C(m, k − 1)·x^((m + 1) − k)·y^k
    algebra
    requires x ∈ ℝ: from H1
    requires y ∈ ℝ: from H2
    requires 1 ∈ ℤ: arithmetic
    requires m + 1 ∈ ℤ: membership, from H3
    requires m ∈ ℕ₀: from H3
    requires Σ(k = 1 to m + 1) C(m, k − 1)·x^((m + 1) − k)·y^k ∈ ℝ: mun:sum-real a := 1, b := m + 1

37. y·(Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k) = Σ(k = 0 to m + 1) C(m, k − 1)·x^((m + 1) − k)·y^k
    calculation
      y·(Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k) = Σ(k = 0 to m) y·(C(m, k)·x^(m − k)·y^k)                          18
                                              = Σ(k = 0 to m) C(m, k)·x^(m − k)·y^(k + 1)                          20
                                              = Σ(k = 0 + 1 to m + 1) C(m, k − 1)·x^(m − (k − 1))·y^((k − 1) + 1)  21
                                              = Σ(k = 1 to m + 1) C(m, k − 1)·x^(m − (k − 1))·y^((k − 1) + 1)      22
                                              = Σ(k = 1 to m + 1) C(m, k − 1)·x^((m + 1) − k)·y^k                  24
                                              = 0 + Σ(k = 1 to m + 1) C(m, k − 1)·x^((m + 1) − k)·y^k              36
                                              = Σ(k = 0 to m + 1) C(m, k − 1)·x^((m + 1) − k)·y^k                  35

38. Σ(k = 0 to m + 1) (C(m, k)·x^((m + 1) − k)·y^k + C(m, k − 1)·x^((m + 1) − k)·y^k) = Σ(k = 0 to m + 1) C(m, k)·x^((m + 1) − k)·y^k + Σ(k = 0 to m + 1) C(m, k − 1)·x^((m + 1) − k)·y^k
    mun:sum-add a := 0, b := m + 1
    requires 0 ∈ ℤ: arithmetic
    requires m + 1 ∈ ℤ: membership, from H3
    requires m ∈ ℕ₀: from H3
    requires x ∈ ℝ: from H1
    requires y ∈ ℝ: from H2

39. For all k ∈ {0, …, m + 1}, C(m, k)·x^((m + 1) − k)·y^k + C(m, k − 1)·x^((m + 1) − k)·y^k = C(m + 1, k)·x^((m + 1) − k)·y^k.
    fix
    note then the two sums add term by term, and Pascal's rule joins the coefficients
    let k ∈ {0, …, m + 1}                                             (J)

    39.1.  C(m, k) + C(m, k − 1) = C(m + 1, k)
           thm:pascal n := m, k := k, from H3
           requires 0 ∈ ℤ: arithmetic
           requires m + 1 ∈ ℤ: membership, from H3
           requires k ∈ ℤ: mun:range-integer a := 0, b := m + 1, from J

    39.2.  C(m, k)·x^((m + 1) − k)·y^k + C(m, k − 1)·x^((m + 1) − k)·y^k = (C(m, k) + C(m, k − 1))·x^((m + 1) − k)·y^k
           algebra
           requires 0 ∈ ℤ: arithmetic
           requires m + 1 ∈ ℤ: membership, from H3
           requires k ∈ ℤ: mun:range-integer a := 0, b := m + 1, from J
           requires C(m, k) ∈ ℕ₀: mun:binomial-nat0, from H3
           requires 1 ∈ ℤ: arithmetic
           requires k − 1 ∈ ℤ: mun:int-closure a := k, b := 1
           requires C(m, k − 1) ∈ ℕ₀: mun:binomial-nat0 k := k − 1, from H3
           requires (m + 1) − k ∈ ℕ₀: mun:range-difference a := 0, n := m + 1, from J
           requires x^((m + 1) − k) ∈ ℝ: mun:power-real, from H1
           requires k ∈ ℕ₀: mun:range-nat0 n := m + 1, from J
           requires y^k ∈ ℝ: mun:power-real, from H2

    39.3.  (C(m, k) + C(m, k − 1))·x^((m + 1) − k)·y^k = C(m + 1, k)·x^((m + 1) − k)·y^k
           substitute C(m, k) + C(m, k − 1) = C(m + 1, k) (line 39.1)

    39.4.  C(m, k)·x^((m + 1) − k)·y^k + C(m, k − 1)·x^((m + 1) − k)·y^k = C(m + 1, k)·x^((m + 1) − k)·y^k
           calculation
             C(m, k)·x^((m + 1) − k)·y^k + C(m, k − 1)·x^((m + 1) − k)·y^k = (C(m, k) + C(m, k − 1))·x^((m + 1) − k)·y^k    39.2
                                                                           = C(m + 1, k)·x^((m + 1) − k)·y^k                  39.3

40. Σ(k = 0 to m + 1) (C(m, k)·x^((m + 1) − k)·y^k + C(m, k − 1)·x^((m + 1) − k)·y^k) = Σ(k = 0 to m + 1) C(m + 1, k)·x^((m + 1) − k)·y^k
    mun:sum-termwise a := 0, b := m + 1, from 39
    requires 0 ∈ ℤ: arithmetic
    requires m + 1 ∈ ℤ: membership, from H3

41. x·(Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k) + y·(Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k) = Σ(k = 0 to m + 1) C(m, k)·x^((m + 1) − k)·y^k + y·(Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k)
    substitute x·(Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k) = Σ(k = 0 to m + 1) C(m, k)·x^((m + 1) − k)·y^k (line 17)

42. Σ(k = 0 to m + 1) C(m, k)·x^((m + 1) − k)·y^k + y·(Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k) = Σ(k = 0 to m + 1) C(m, k)·x^((m + 1) − k)·y^k + Σ(k = 0 to m + 1) C(m, k − 1)·x^((m + 1) − k)·y^k
    substitute y·(Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k) = Σ(k = 0 to m + 1) C(m, k − 1)·x^((m + 1) − k)·y^k (line 37)

43. (Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k)·(x + y) = Σ(k = 0 to m + 1) C(m + 1, k)·x^((m + 1) − k)·y^k
    calculation
      (Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k)·(x + y) = x·(Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k) + y·(Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k)                     1
                                                    = Σ(k = 0 to m + 1) C(m, k)·x^((m + 1) − k)·y^k + y·(Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k)               41
                                                    = Σ(k = 0 to m + 1) C(m, k)·x^((m + 1) − k)·y^k + Σ(k = 0 to m + 1) C(m, k − 1)·x^((m + 1) − k)·y^k     42
                                                    = Σ(k = 0 to m + 1) (C(m, k)·x^((m + 1) − k)·y^k + C(m, k − 1)·x^((m + 1) − k)·y^k)                     38
                                                    = Σ(k = 0 to m + 1) C(m + 1, k)·x^((m + 1) − k)·y^k                                                     40


theorem binomial
  metamath    binom
  let x ∈ ℝ                                                           (H1)
  let y ∈ ℝ                                                           (H2)
  let n ∈ ℕ₀                                                          (H3)
  then (x + y)^n = Σ(k = 0 to n) C(n, k)·x^(n − k)·y^k

1.  For all m ∈ ℕ₀, (x + y)^m = Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k.
    induction on m starting at 0

    base
    1.1.  Σ(k = 0 to 0) C(0, k)·x^(0 − k)·y^k = C(0, 0)·x^(0 − 0)·y^0
          mun:sum-single a := 0
          requires 0 ∈ ℤ: arithmetic
          requires x ∈ ℝ: from H1
          requires y ∈ ℝ: from H2

    1.2.  C(0, 0) = 1
          mun:binomial-zero-index n := 0
          requires 0 ∈ ℕ₀: arithmetic

    1.3.  C(0, 0)·x^(0 − 0)·y^0 = 1·x^(0 − 0)·y^0
          substitute C(0, 0) = 1 (line 1.2)

    1.4.  1·x^(0 − 0)·y^0 = 1·x^0·y^0
          substitute 0 − 0 = 0 (arithmetic)

    1.5.  1·x^0·y^0 = 1
          algebra
          requires x ∈ ℝ: from H1
          requires y ∈ ℝ: from H2

    1.6.  (x + y)^0 = 1
          algebra
          requires x ∈ ℝ: from H1
          requires y ∈ ℝ: from H2

    1.7.  (x + y)^0 = Σ(k = 0 to 0) C(0, k)·x^(0 − k)·y^k
          calculation
            (x + y)^0 = 1                                        1.6
                      = 1·x^0·y^0                                1.5
                      = 1·x^(0 − 0)·y^0                          1.4
                      = C(0, 0)·x^(0 − 0)·y^0                    1.3
                      = Σ(k = 0 to 0) C(0, k)·x^(0 − k)·y^k      1.1

    step
    let m ∈ ℕ₀                                                        (K)
    assume step 1 is true for m, the induction hypothesis             (IH)

    1.8.  (x + y)^(m + 1) = (x + y)^m·(x + y)
          mun:exponent-step a := x + y, from K
          requires x + y ∈ ℝ: mun:real-closure, from H1, H2

    1.9.  (x + y)^m·(x + y) = (Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k)·(x + y)
          substitute (x + y)^m = Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k (IH)

    1.10. (Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k)·(x + y) = Σ(k = 0 to m + 1) C(m + 1, k)·x^((m + 1) − k)·y^k
          thm:binomial-step m := m, from H1, H2, K

    1.11. (x + y)^(m + 1) = Σ(k = 0 to m + 1) C(m + 1, k)·x^((m + 1) − k)·y^k
          calculation
            (x + y)^(m + 1) = (x + y)^m·(x + y)                                          1.8
                            = (Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k)·(x + y)              1.9
                            = Σ(k = 0 to m + 1) C(m + 1, k)·x^((m + 1) − k)·y^k          1.10

2.  (x + y)^n = Σ(k = 0 to n) C(n, k)·x^(n − k)·y^k
    instantiate m := n in line 1, from H3
