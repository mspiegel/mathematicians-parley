import theorem            stdlib/divisibility/prime-factor
import mundane theorem    stdlib/counting/factorial-divisible
import mundane theorem    stdlib/counting/factorial-nat
import mundane theorem    stdlib/divisibility/divides-difference
import mundane theorem    stdlib/divisibility/divides-one
import mundane definition stdlib/divisibility/prime
import mundane theorem    stdlib/numbers/nat-closure

theorem prime-above
  metamath    infpn
  note        n! + 1 has a prime factor p. If p were at most n, it would divide
              n! as well, and so their difference, 1.
  let n ∈ ℕ                                                           (H1)
  then there exists p ∈ ℕ such that p is prime and p > n

1.  n! ∈ ℕ
    mun:factorial-nat n := n

2.  n! + 1 > 1
    inequalities, from 1

3.  p ∈ ℕ. p is prime. p divides n! + 1.
    obtain p: thm:prime-factor m := n! + 1, from 2
    requires n! + 1 ∈ ℕ: mun:nat-closure a := n!, b := 1, from 1

4.  p > 1
    mun:prime p := p, from 3

5.  p > n
    contradiction
    suppose not p > n                                                 (S)

    5.1.  p ≤ n
          inequalities, from S

    5.2.  p divides n!
          mun:factorial-divisible n := n, m := p, from 5.1

    5.3.  p divides (n! + 1) − n!
          mun:divides-difference d := p, a := n! + 1, b := n!, from 3, 5.2
          requires n! + 1 ∈ ℤ: membership, from 1
          requires n! ∈ ℤ: from 1

    5.4.  (n! + 1) − n! = 1
          algebra
          requires n! ∈ ℝ: from 1

    5.5.  p divides 1
          substitute (n! + 1) − n! = 1 (line 5.4) into line 5.3

    5.6.  p = 1
          mun:divides-one d := p, from 5.5

    5.7.  p ≠ 1
          inequalities, from 4, contradicting 5.6

6.  There exists p ∈ ℕ such that p is prime and p > n.
    exhibit, from 3, 5
