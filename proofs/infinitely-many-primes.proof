theorem prime-above
  metamath    infpn
  let n ∈ ℕ                                                           (H1)
  then there is p ∈ ℕ with p is prime and p > n

1.  n! ∈ ℕ
    thm:stdlib/counting/factorial-nat n := n, from H1

2.  n! + 1 ∈ ℕ
    thm:stdlib/numbers/nat-closure a := n!, b := 1, from 1
    requires 1 ∈ ℕ: arithmetic

3.  n! + 1 > 1
    inequalities, from 1
    requires n! ∈ ℝ: from 1

4.  p ∈ ℕ. p is prime. p divides n! + 1.
    obtain p: thm:stdlib/divisibility/prime-factor m := n! + 1, from 2, 3

5.  p > 1
    def:stdlib/divisibility/prime p := p, from 4

6.  p > n
    contradiction
    suppose not p > n                                                 (S)

    6.1.  p ≤ n
          inequalities, from S
          requires p ∈ ℝ: from 4
          requires n ∈ ℝ: from H1

    6.2.  p divides n!
          thm:stdlib/counting/factorial-divisible n := n, m := p, from H1, 4, 6.1

    6.3.  p divides (n! + 1) − n!
          thm:stdlib/divisibility/divides-difference d := p, a := n! + 1, b := n!, from 4, 6.2
          requires n! + 1 ∈ ℤ: from 2
          requires n! ∈ ℤ: from 1

    6.4.  (n! + 1) − n! = 1
          algebra
          requires n! ∈ ℝ: from 1

    6.5.  p divides 1
          substitute (n! + 1) − n! = 1 (line 6.4) into line 6.3

    6.6.  p = 1
          thm:stdlib/divisibility/divides-one d := p, from 4, 6.5

    6.7.  not p = 1
          inequalities, from 5
          requires p ∈ ℝ: from 4

    6.8.  p = 1. not p = 1.
          join 6.6, 6.7

7.  There is p ∈ ℕ with p is prime and p > n.
    exhibit, from 4, 6
