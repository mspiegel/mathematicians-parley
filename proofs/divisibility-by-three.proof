import mundane theorem    stdlib/divisibility/congruent-divides
import mundane definition stdlib/divisibility/congruent-mod
import mundane definition stdlib/divisibility/divides
import mundane theorem    stdlib/divisibility/divides-combination
import mundane theorem    stdlib/divisibility/divides-multiple
import mundane theorem    stdlib/numbers/exponent-step
import mundane theorem    stdlib/numbers/int-closure
import mundane theorem    stdlib/numbers/nat0-closure
import mundane theorem    stdlib/numbers/power-integer
import mundane theorem    stdlib/numbers/power-real
import mundane theorem    stdlib/numbers/ten-minus-one
import mundane theorem    stdlib/sums/sum-difference
import mundane theorem    stdlib/sums/sum-divisible
import mundane theorem    stdlib/sums/sum-integer

theorem ten-power-congruent
  let k ∈ ℕ₀                                                          (H1)
  then 10^k ≡ 1 (mod 3)

1.  For all m ∈ ℕ₀, 10^m ≡ 1 (mod 3).
    induction on m starting at 0

    base
    1.1.  3 divides 10^0 − 1
          mun:divides d := 3, n := 10^0 − 1
          requires 10^0 − 1 = 3·0: arithmetic
          requires 3 ∈ ℤ: arithmetic
          requires 0 ∈ ℤ: arithmetic
          requires 10^0 − 1 ∈ ℤ: arithmetic

    1.2.  10^0 ≡ 1 (mod 3)
          mun:congruent-mod, from 1.1
          requires 3 ∈ ℤ: arithmetic
          requires 10^0 ∈ ℤ: arithmetic
          requires 1 ∈ ℤ: arithmetic

    step
    let m ∈ ℕ₀                                                        (K)
    assume step 1 is true for m, the induction hypothesis             (IH)

    1.3.  3 divides 10^m − 1
          mun:congruent-mod, from IH
          requires 3 ∈ ℤ: arithmetic
          requires 10 ∈ ℤ: arithmetic
          requires 10^m ∈ ℤ: mun:power-integer a := 10, from K
          requires 1 ∈ ℤ: arithmetic

    1.4.  3 divides 9
          mun:divides d := 3, n := 9
          requires 9 = 3·3: arithmetic
          requires 3 ∈ ℤ: arithmetic
          requires 9 ∈ ℤ: arithmetic

    1.5.  10 − 1 = 9
          mun:ten-minus-one

    1.6.  3 divides 10 − 1
          substitute 10 − 1 = 9 (line 1.5) into line 1.4

    1.7.  3 divides (10^m − 1)·10 + (10 − 1)·1
          mun:divides-combination e := 3, a := 10^m − 1, b := 10 − 1,
            x := 10, y := 1, from 1.3, 1.6
          requires 3 ∈ ℤ: arithmetic
          requires 1 ∈ ℤ: arithmetic
          requires 10 ∈ ℤ: arithmetic
          requires 10^m ∈ ℤ: mun:power-integer a := 10, from K
          requires 10^m − 1 ∈ ℤ: mun:int-closure
          requires 10 − 1 ∈ ℤ: arithmetic

    1.8.  10^(m + 1) = 10^m·10
          mun:exponent-step a := 10, from K
          requires 10 ∈ ℝ: arithmetic

    1.9.  (10^m − 1)·10 + (10 − 1)·1 = 10^m·10 − 1
          algebra
          requires 10 ∈ ℝ: arithmetic
          requires 10^m ∈ ℝ: mun:power-real a := 10, m := m, from K

    1.10. 10^m·10 − 1 = 10^(m + 1) − 1
          substitute 10^(m + 1) = 10^m·10 (line 1.8)

    1.11. (10^m − 1)·10 + (10 − 1)·1 = 10^(m + 1) − 1
          calculation
            (10^m − 1)·10 + (10 − 1)·1 = 10^m·10 − 1       1.9
                                       = 10^(m + 1) − 1    1.10

    1.12. 3 divides 10^(m + 1) − 1
          substitute (10^m − 1)·10 + (10 − 1)·1 = 10^(m + 1) − 1 (line 1.11) into line 1.7

    1.13. 10^(m + 1) ≡ 1 (mod 3)
          mun:congruent-mod, from 1.12
          requires 3 ∈ ℤ: arithmetic
          requires 10 ∈ ℤ: arithmetic
          requires m + 1 ∈ ℕ₀: mun:nat0-closure, from K
          requires 10^(m + 1) ∈ ℤ: mun:power-integer a := 10, m := m + 1
          requires 1 ∈ ℤ: arithmetic

2.  10^k ≡ 1 (mod 3)
    instantiate m := k in line 1, from H1


theorem divisibility-by-three
  note        Wiedijk's 85, `3dvds` in set.mm, which states it for a digit
              function on ( 0 ... N ). The digits here are any integers d(k),
              as set.mm's are; a reader's decimal digits are the case 0 to 9.
  let n ∈ ℕ₀                                                          (H1)
  let d : ℕ₀ → ℤ                                                      (H2)
  then 3 divides Σ(k = 0 to n) d(k)·10^k ↔ 3 divides Σ(k = 0 to n) d(k)

1.  For all k ∈ ℕ₀, 3 divides d(k)·10^k − d(k).
    fix
    note each term differs from its digit by a multiple of 10^k − 1
    let k ∈ ℕ₀                                                        (K)

    1.1.  10^k ≡ 1 (mod 3)
          thm:ten-power-congruent k := k, from K

    1.2.  3 divides 10^k − 1
          mun:congruent-mod, from 1.1
          requires 3 ∈ ℤ: arithmetic
          requires 10 ∈ ℤ: arithmetic
          requires 10^k ∈ ℤ: mun:power-integer a := 10, m := k, from K
          requires 1 ∈ ℤ: arithmetic

    1.3.  3 divides (10^k − 1)·d(k)
          mun:divides-multiple e := 3, a := 10^k − 1, x := d(k), from 1.2, H2, K
          requires 3 ∈ ℤ: arithmetic
          requires 1 ∈ ℤ: arithmetic
          requires 10 ∈ ℤ: arithmetic
          requires 10^k ∈ ℤ: mun:power-integer a := 10, m := k, from K
          requires 10^k − 1 ∈ ℤ: mun:int-closure

    1.4.  (10^k − 1)·d(k) = d(k)·10^k − d(k)
          algebra
          requires d(k) ∈ ℝ: from H2, K
          requires 10 ∈ ℝ: arithmetic
          requires 10^k ∈ ℝ: mun:power-real a := 10, m := k, from K

    1.5.  3 divides d(k)·10^k − d(k)
          substitute (10^k − 1)·d(k) = d(k)·10^k − d(k) (line 1.4) into line 1.3

2.  3 divides Σ(k = 0 to n) (d(k)·10^k − d(k))
    mun:sum-divisible m := 3, from H1, 1
    requires 3 ∈ ℤ: arithmetic

3.  Σ(k = 0 to n) (d(k)·10^k − d(k)) = Σ(k = 0 to n) d(k)·10^k − Σ(k = 0 to n) d(k)
    mun:sum-difference, from H1

4.  3 divides Σ(k = 0 to n) d(k)·10^k − Σ(k = 0 to n) d(k)
    substitute Σ(k = 0 to n) (d(k)·10^k − d(k)) = Σ(k = 0 to n) d(k)·10^k − Σ(k = 0 to n) d(k) (line 3) into line 2

5.  Σ(k = 0 to n) d(k)·10^k ≡ Σ(k = 0 to n) d(k) (mod 3)
    mun:congruent-mod, from 4
    requires 3 ∈ ℤ: arithmetic
    requires Σ(k = 0 to n) d(k)·10^k ∈ ℤ: mun:sum-integer, from H1
    requires Σ(k = 0 to n) d(k) ∈ ℤ: mun:sum-integer, from H1

6.  3 divides Σ(k = 0 to n) d(k)·10^k ↔ 3 divides Σ(k = 0 to n) d(k)
    mun:congruent-divides m := 3, from 5
    requires 3 ∈ ℤ: arithmetic
    requires Σ(k = 0 to n) d(k)·10^k ∈ ℤ: mun:sum-integer, from H1
    requires Σ(k = 0 to n) d(k) ∈ ℤ: mun:sum-integer, from H1
