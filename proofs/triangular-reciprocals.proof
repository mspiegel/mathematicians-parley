import theorem            stdlib/numbers/archimedean
import theorem            stdlib/sums/sum-telescopes
import mundane definition stdlib/calculus/series-sum
import mundane theorem    stdlib/numbers/abs-difference-lt
import mundane theorem    stdlib/numbers/reciprocal-order
import mundane theorem    stdlib/numbers/reciprocal-positive
import mundane theorem    stdlib/sums/sum-termwise
import definition         stdlib/calculus/tends-to

define T(k) := k(k + 1)/2, for k ∈ ℕ                                  (D1)
       reads the k-th triangular number

theorem triangular-reciprocals
  metamath    trirecip
  note        1/T(k) = 2/k − 2/(k + 1), so the first n terms telescope to
              2 − 2/(n + 1), which tends to 2.
  ε ranges over ℝ
  n ranges over ℕ
  then Σ(k = 1 to ∞) 1/T(k) = 2

1.  For all k ∈ ℕ, 1/T(k) = 2/k − 2/(k + 1).
    proof
    let k ∈ ℕ                                                         (K1)

    1.1.  1/(k(k + 1)/2) = 2/k − 2/(k + 1)
          algebra
          requires k ≠ 0: from K1
          requires k + 1 ≠ 0: inequalities, from K1

    1.2.  1/T(k) = 2/k − 2/(k + 1)
          calculation
            1/T(k) = 1/(k(k + 1)/2)       D1
                   = 2/k − 2/(k + 1)      1.1

2.  For all n ∈ ℕ, Σ(k = 1 to n) 1/T(k) = 2 − 2/(n + 1).
    proof
    let n ∈ ℕ                                                         (K2)

    2.1.  Σ(k = 1 to n) 1/T(k) = Σ(k = 1 to n) (2/k − 2/(k + 1))
          mun:sum-termwise a := 1, b := n, from 1

    2.2.  Σ(k = 1 to n) (2/k − 2/(k + 1)) = 2/1 − 2/(n + 1)
          thm:sum-telescopes a := 1, b := n
          requires n + 1 ≥ 1: inequalities, from K2

    2.3.  Σ(k = 1 to n) 1/T(k) = 2 − 2/(n + 1)
          calculation
            Σ(k = 1 to n) 1/T(k) = Σ(k = 1 to n) (2/k − 2/(k + 1))    2.1
                                 = 2/1 − 2/(n + 1)                    2.2
                                 = 2 − 2/(n + 1)                      arithmetic

3.  For all ε > 0, there exists N ∈ ℕ such that
    |Σ(k = 1 to n) 1/T(k) − 2| < ε for all n ≥ N.
    proof
    let ε ∈ ℝ                                                         (K3)
    assume ε > 0                                                      (A1)

    3.1.  N ∈ ℕ. 1/N < ε/2.
          obtain N: thm:archimedean x := ε/2
          requires ε/2 > 0: inequalities, from A1

    3.2.  For all n ≥ N, |Σ(k = 1 to n) 1/T(k) − 2| < ε.
          proof
          let n ∈ ℕ                                                   (K4)
          assume n ≥ N                                                (A2)

          3.2.1.  Σ(k = 1 to n) 1/T(k) = 2 − 2/(n + 1)
                  instantiate n := n in line 2

          3.2.2.  N ≤ n + 1
                  inequalities, from A2

          3.2.3.  1/(n + 1) ≤ 1/N
                  mun:reciprocal-order x := N, y := n + 1, from 3.2.2
                  requires N > 0: inequalities, from 3.1
                  requires n + 1 > 0: inequalities, from K4

          3.2.4.  1/(n + 1) > 0
                  mun:reciprocal-positive x := n + 1
                  requires n + 1 > 0: inequalities, from K4

          3.2.5.  2 − ε < Σ(k = 1 to n) 1/T(k)
                  inequalities, from D1, 3.2.1, 3.2.3, 3.1
                  requires Σ(k = 1 to n) 1/T(k) ∈ ℝ: membership, from D1
                  requires n + 1 ≠ 0: inequalities, from K4

          3.2.6.  Σ(k = 1 to n) 1/T(k) < 2 + ε
                  inequalities, from D1, 3.2.1, 3.2.4, A1
                  requires Σ(k = 1 to n) 1/T(k) ∈ ℝ: membership, from D1
                  requires n + 1 ≠ 0: inequalities, from K4

          3.2.7.  |Σ(k = 1 to n) 1/T(k) − 2| < ε
                  mun:abs-difference-lt x := Σ(k = 1 to n) 1/T(k), c := 2, δ := ε, from 3.2.5, 3.2.6
                  requires Σ(k = 1 to n) 1/T(k) ∈ ℝ: membership, from D1

    3.3.  There exists N ∈ ℕ such that |Σ(k = 1 to n) 1/T(k) − 2| < ε for all n ≥ N.
          exhibit, from 3.2

4.  Σ(k = 1 to n) 1/T(k) → 2 as n → ∞
    def:tends-to L := 2, from 3
    requires for all n ∈ ℕ, Σ(k = 1 to n) 1/T(k) ∈ ℝ: membership, from D1

5.  Σ(k = 1 to ∞) 1/T(k) = 2
    mun:series-sum L := 2, from 4
    requires for all k ∈ ℕ, 1/T(k) ∈ ℝ: membership, from D1
