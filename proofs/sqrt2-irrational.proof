import theorem            stdlib/divisibility/divides-gcd
import mundane definition stdlib/divisibility/divides
import mundane theorem    stdlib/divisibility/divides-one
import mundane definition stdlib/divisibility/even
import mundane theorem    stdlib/divisibility/even-or-odd
import mundane definition stdlib/divisibility/gcd
import mundane theorem    stdlib/divisibility/not-both
import mundane definition stdlib/divisibility/odd
import mundane definition stdlib/numbers/irrational
import mundane theorem    stdlib/numbers/pos-int-nat
import mundane theorem    stdlib/numbers/rational-coprime
import mundane definition stdlib/numbers/sqrt
import mundane theorem    stdlib/reasoning/disjunctive-syllogism

theorem odd-square
  metamath    zesq covers it
  let n ∈ ℤ                                                           (H1)
  assume n is odd                                                     (H2)
  then n² is odd

1.  k ∈ ℤ. n = 2k + 1.
    obtain k: mun:odd n := n, from H2

2.  n² = (2k + 1)²
    substitute n = 2k + 1 (line 1)

3.  (2k + 1)² = 4k² + 4k + 1
    algebra

4.  4k² + 4k + 1 = 2(2k² + 2k) + 1
    algebra

5.  n² = 2(2k² + 2k) + 1
    calculation
      n² = (2k + 1)²           2
         = 4k² + 4k + 1        3
         = 2(2k² + 2k) + 1     4

6.  n² is odd
    mun:odd n := n², from 5


theorem even-square
  metamath    zesq
  let n ∈ ℤ                                                           (H1)
  assume n² is even                                                   (H2)
  then n is even

1.  n is not odd
    contradiction
    suppose n is odd                                                  (S)

    1.1.  n² is odd
          thm:odd-square n := n, from S

    1.2.  n² is not odd
          mun:not-both n := n², from H2, contradicting 1.1

2.  n is even or n is odd
    mun:even-or-odd n := n

3.  n is even
    mun:disjunctive-syllogism P := n is even, Q := n is odd, from 2, 1


theorem lowest-terms
  note        Hammack chapter 6 takes a fraction in lowest terms as given.
              set.mm has it as elq2, which says lowest terms with a gcd where
              a reader says it with divisors, and that step is the proof.
  let x ∈ ℚ                                                           (H1)
  then there exist p, q ∈ ℤ such that q > 0, x = p/q,
       and there is no d ∈ ℤ with d > 1, d divides p, and d divides q

1.  p ∈ ℤ. q ∈ ℕ. x = p/q. gcd(p, q) = 1.
    obtain p, q: mun:rational-coprime x := x

2.  q > 0
    inequalities, from 1

3.  There is no d ∈ ℤ with d > 1, d divides p, and d divides q.
    contradiction
    suppose there is d ∈ ℤ with d > 1, d divides p, and d divides q   (S)

    3.1.  d ∈ ℤ. d > 1. d divides p. d divides q.
          obtain d from S

    3.2.  d divides gcd(p, q)
          thm:divides-gcd d := d, a := p, b := q, from 3.1, 3.1, 3.1

    3.3.  d divides 1
          substitute gcd(p, q) = 1 (line 1) into line 3.2

    3.4.  d = 1
          mun:divides-one d := d, from 3.3
          requires 0 < d: inequalities, from 3.1
          requires d ∈ ℕ: mun:pos-int-nat m := d, from 3.1

    3.5.  d ≠ 1
          inequalities, from 3.1, contradicting 3.4

4.  There exist p, q ∈ ℤ such that q > 0, x = p/q,
    and there is no d ∈ ℤ with d > 1, d divides p, and d divides q.
    exhibit, from 1, 2, 3


theorem sqrt2-irrational
  metamath    sqrt2irr
  note        No pilot table carried a row for it. Added by the merge. set.mm
              proves it by descent with strong induction, so the elaborated
              kernel proof will differ.
  then √2 is irrational

1.  (√2)² = 2
    mun:sqrt x := 2
    requires 2 ≥ 0: arithmetic

2.  √2 ∉ ℚ
    contradiction
    suppose √2 ∈ ℚ                                                    (S)

    2.1.  p ∈ ℤ. q ∈ ℤ. q > 0. √2 = p/q.
          There is no d ∈ ℤ with d > 1, d divides p, and d divides q.
          obtain p, q: thm:lowest-terms x := √2, from S

    2.2.  (p/q)² = 2
          substitute √2 = p/q (line 2.1) into line 1

    2.3.  p² = 2q²
          algebra, from 2.2
          requires q ≠ 0: inequalities, from 2.1

    2.4.  p² is even
          mun:even n := p², from 2.3

    2.5.  p is even
          thm:even-square n := p, from 2.4

    2.6.  r ∈ ℤ. p = 2r.
          obtain r: mun:even n := p, from 2.5

    2.7.  p² = (2r)²
          substitute p = 2r (line 2.6)

    2.8.  (2r)² = 4r²
          algebra

    2.9.  2q² = 4r²
          calculation
            2q² = p²        2.3
                = (2r)²     2.7
                = 4r²       2.8

    2.10. q² = 2r²
          algebra, from 2.9

    2.11. q² is even
          mun:even n := q², from 2.10

    2.12. q is even
          thm:even-square n := q, from 2.11

    2.13. s ∈ ℤ. q = 2s.
          obtain s: mun:even n := q, from 2.12

    2.14. 2 divides p
          mun:divides d := 2, n := p, from 2.6

    2.15. 2 divides q
          mun:divides d := 2, n := q, from 2.13

    2.16. There is d ∈ ℤ with d > 1, d divides p, and d divides q.
          exhibit, from 2.14, 2.15, contradicting 2.1
          requires 2 > 1: arithmetic

3.  √2 is irrational
    mun:irrational x := √2, from 2
    requires 2 ≥ 0: arithmetic
    requires √2 ∈ ℝ: mun:sqrt x := 2
