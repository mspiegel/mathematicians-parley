import theorem            stdlib/numbers/archimedean-natural
import theorem            stdlib/calculus/convergent-bounded
import mundane theorem    stdlib/sums/sum-split
import mundane theorem    stdlib/sums/sum-le
import mundane theorem    stdlib/sums/sum-constant
import mundane theorem    stdlib/sums/sum-single
import mundane theorem    stdlib/sums/sum-real
import mundane theorem    stdlib/sums/range-bounds
import mundane theorem    stdlib/sums/range-integer
import mundane theorem    stdlib/numbers/exponent-step
import mundane theorem    stdlib/numbers/exponent-zero
import mundane theorem    stdlib/numbers/power-nat
import mundane theorem    stdlib/numbers/reciprocal-order

theorem harmonic-block
  note        The induction step's block, stated apart from the induction as
              binomial-step is: inside the step the hypothesis is in scope and
              names the sum's index, which set.mm's sum lemmas forbid there.
  let j ∈ ℕ₀                                                          (H1)
  then Σ(k = 1 to 2^(j + 1)) 1/k ≥ Σ(k = 1 to 2^j) 1/k + 1/2

1.  2^(j + 1) = 2^j·2
    mun:exponent-step a := 2, m := j

2.  2^j ∈ ℕ
    mun:power-nat a := 2, m := j

3.  2^j ≤ 2^(j + 1)
    inequalities, from 1, 2
    requires 2^(j + 1) ∈ ℝ: membership, from H1

4.  Σ(k = 1 to 2^(j + 1)) 1/k = Σ(k = 1 to 2^j) 1/k + Σ(k = 2^j + 1 to 2^(j + 1)) 1/k
    mun:sum-split a := 1, b := 2^j, c := 2^(j + 1), from 3
    requires 2^j ∈ ℤ: membership, from H1
    requires 2^(j + 1) ∈ ℤ: membership, from H1
    requires 1 ≤ 2^j + 1: inequalities, from 2

5.  For all k ∈ {2^j + 1, …, 2^(j + 1)}, 1/2^(j + 1) ≤ 1/k.
    proof
    let k ∈ {2^j + 1, …, 2^(j + 1)}                                   (K1)

    5.1.  2^j + 1 ≤ k. k ≤ 2^(j + 1).
          mun:range-bounds a := 2^j + 1, b := 2^(j + 1), from K1
          requires 2^j + 1 ∈ ℤ: membership, from H1
          requires 2^(j + 1) ∈ ℤ: membership, from H1

    5.2.  1/2^(j + 1) ≤ 1/k
          mun:reciprocal-order x := k, y := 2^(j + 1), from 5.1
          requires 2^j + 1 ∈ ℤ: membership, from H1
          requires 2^(j + 1) ∈ ℤ: membership, from H1
          requires k ∈ ℤ: mun:range-integer a := 2^j + 1, b := 2^(j + 1), from K1
          requires k > 0: inequalities, from 5.1, 2
          requires 2^(j + 1) > 0: inequalities, from 1, 2

6.  For all k ∈ {2^j + 1, …, 2^(j + 1)}, 1/k ∈ ℝ.
    proof
    let k ∈ {2^j + 1, …, 2^(j + 1)}                                   (K2)

    6.1.  2^j + 1 ≤ k. k ≤ 2^(j + 1).
          mun:range-bounds a := 2^j + 1, b := 2^(j + 1), from K2
          requires 2^j + 1 ∈ ℤ: membership, from H1
          requires 2^(j + 1) ∈ ℤ: membership, from H1

    6.2.  1/k ∈ ℝ
          membership
          requires 2^j + 1 ∈ ℤ: membership, from H1
          requires 2^(j + 1) ∈ ℤ: membership, from H1
          requires k ∈ ℤ: mun:range-integer a := 2^j + 1, b := 2^(j + 1), from K2
          requires k ≠ 0: inequalities, from 6.1, 2

7.  Σ(k = 2^j + 1 to 2^(j + 1)) 1/2^(j + 1) ≤ Σ(k = 2^j + 1 to 2^(j + 1)) 1/k
    mun:sum-le a := 2^j + 1, b := 2^(j + 1), from 5
    requires 2^j + 1 ∈ ℤ: membership, from H1
    requires 2^(j + 1) ∈ ℤ: membership, from H1
    requires for all k ∈ {2^j + 1, …, 2^(j + 1)}, 1/k ∈ ℝ: from 6

8.  Σ(k = 2^j + 1 to 2^(j + 1)) 1/2^(j + 1) = (2^(j + 1) − (2^j + 1) + 1)·(1/2^(j + 1))
    mun:sum-constant a := 2^j + 1, b := 2^(j + 1), c := 1/2^(j + 1)
    requires 2^j + 1 ∈ ℤ: membership, from H1
    requires 2^(j + 1) ∈ ℤ: membership, from H1
    requires 2^j + 1 ≤ 2^(j + 1): inequalities, from 1, 2
    requires 1/2^(j + 1) ∈ ℝ: membership, from H1

9.  (2^(j + 1) − (2^j + 1) + 1)·(1/2^(j + 1)) = (2^j·2 − (2^j + 1) + 1)·(1/(2^j·2))
    substitute 2^(j + 1) = 2^j·2 (line 1)

10. (2^j·2 − (2^j + 1) + 1)·(1/(2^j·2)) = 1/2
    algebra
    requires 2^j ≠ 0: inequalities, from 2

11. (2^(j + 1) − (2^j + 1) + 1)·(1/2^(j + 1)) = 1/2
    calculation
      (2^(j + 1) − (2^j + 1) + 1)·(1/2^(j + 1)) = (2^j·2 − (2^j + 1) + 1)·(1/(2^j·2))    9
                                                 = 1/2                                    10

12. Σ(k = 1 to 2^(j + 1)) 1/k ≥ Σ(k = 1 to 2^j) 1/k + 1/2
    inequalities, from 4, 7, 8, 11
    requires Σ(k = 1 to 2^(j + 1)) 1/k ∈ ℝ: membership
    requires Σ(k = 1 to 2^j) 1/k ∈ ℝ: membership
    requires 2^j + 1 ∈ ℤ: membership, from H1
    requires 2^(j + 1) ∈ ℤ: membership, from H1
    requires for all k ∈ {2^j + 1, …, 2^(j + 1)}, 1/k ∈ ℝ: from 6
    requires Σ(k = 2^j + 1 to 2^(j + 1)) 1/k ∈ ℝ: mun:sum-real a := 2^j + 1, b := 2^(j + 1)
    requires Σ(k = 2^j + 1 to 2^(j + 1)) 1/2^(j + 1) ∈ ℝ: membership, from H1
    requires 2^(j + 1) ≠ 0: inequalities, from 1, 2


theorem harmonic-unbounded
  let M ∈ ℝ                                                           (H1)
  then there is n ∈ ℕ with Σ(k = 1 to n) 1/k > M

1.  For all m ∈ ℕ₀, Σ(k = 1 to 2^m) 1/k ≥ m/2.
    induction on m starting at 0

    base
    1.1.  2^0 = 1
          mun:exponent-zero a := 2

    1.2.  Σ(k = 1 to 2^0) 1/k = Σ(k = 1 to 1) 1/k
          substitute 2^0 = 1 (line 1.1)

    1.3.  Σ(k = 1 to 1) 1/k = 1/1
          mun:sum-single a := 1

    1.4.  Σ(k = 1 to 2^0) 1/k = 1
          calculation
            Σ(k = 1 to 2^0) 1/k = Σ(k = 1 to 1) 1/k     1.2
                                = 1/1                   1.3
                                = 1                     arithmetic

    1.5.  Σ(k = 1 to 2^0) 1/k ≥ 0/2
          inequalities, from 1.4
          requires Σ(k = 1 to 2^0) 1/k ∈ ℝ: membership

    step
    let m ∈ ℕ₀                                                        (K)
    assume step 1 is true for m, the induction hypothesis             (IH)

    1.6.  Σ(k = 1 to 2^(m + 1)) 1/k ≥ Σ(k = 1 to 2^m) 1/k + 1/2
          thm:harmonic-block j := m

    1.7.  Σ(k = 1 to 2^(m + 1)) 1/k ≥ (m + 1)/2
          inequalities, from 1.6, IH
          requires Σ(k = 1 to 2^(m + 1)) 1/k ∈ ℝ: membership
          requires Σ(k = 1 to 2^m) 1/k ∈ ℝ: membership

2.  N ∈ ℕ. N > 2M.
    obtain N: thm:archimedean-natural x := 2M

3.  Σ(k = 1 to 2^N) 1/k ≥ N/2
    instantiate m := N in line 1

4.  Σ(k = 1 to 2^N) 1/k > M
    inequalities, from 3, 2
    requires Σ(k = 1 to 2^N) 1/k ∈ ℝ: membership

5.  2^N ∈ ℕ
    mun:power-nat a := 2, m := N

6.  There is n ∈ ℕ with Σ(k = 1 to n) 1/k > M.
    exhibit, from 5, 4


theorem harmonic
  metamath    harmonic
  then there is no L ∈ ℝ with Σ(k = 1 to n) 1/k → L as n → ∞

1.  There is no L ∈ ℝ with Σ(k = 1 to n) 1/k → L as n → ∞.
    contradiction
    suppose there is L ∈ ℝ with Σ(k = 1 to n) 1/k → L as n → ∞       (S)

    1.1.  L ∈ ℝ. Σ(k = 1 to n) 1/k → L as n → ∞.
          obtain L from S

    1.2.  B ∈ ℝ. For all m ∈ ℕ, Σ(k = 1 to m) 1/k ≤ B.
          obtain B: thm:convergent-bounded L := L, from 1.1

    1.3.  N ∈ ℕ. Σ(k = 1 to N) 1/k > B.
          obtain N: thm:harmonic-unbounded M := B

    1.4.  Σ(k = 1 to N) 1/k ≤ B
          instantiate m := N in line 1.2

    1.5.  not Σ(k = 1 to N) 1/k > B
          inequalities, from 1.4, contradicting 1.3
          requires Σ(k = 1 to N) 1/k ∈ ℝ: membership
