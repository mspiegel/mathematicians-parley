import axiom              stdlib/calculus/completeness
import mundane definition stdlib/calculus/least-upper-bound
import mundane definition stdlib/calculus/upper-bound
import mundane axiom      stdlib/reasoning/excluded-middle
import mundane theorem    stdlib/reasoning/or-left
import mundane theorem    stdlib/reasoning/or-right
import mundane theorem    stdlib/numbers/nat-minus-one
import mundane theorem    stdlib/numbers/nat0-as-int
import mundane theorem    stdlib/numbers/pos-int-nat
import mundane theorem    stdlib/numbers/integer-step
import mundane theorem    stdlib/numbers/floor-integer
import mundane theorem    stdlib/numbers/floor-below
import mundane theorem    stdlib/numbers/floor-above
import mundane theorem    stdlib/numbers/exponent-step
import mundane theorem    stdlib/numbers/power-nat
import mundane theorem    stdlib/numbers/multiply-le
import mundane theorem    stdlib/numbers/divide-le
import mundane theorem    stdlib/numbers/le-antisymmetric
import mundane theorem    stdlib/divisibility/mod-natural
import mundane theorem    stdlib/divisibility/mod-less
import mundane theorem    stdlib/divisibility/mod-remainder
import mundane theorem    stdlib/divisibility/mod-multiple
import mundane theorem    stdlib/divisibility/mod-congruent
import mundane definition stdlib/divisibility/congruent-mod
import mundane theorem    stdlib/divisibility/divides-sum
import mundane theorem    stdlib/functions/function-into
import mundane theorem    stdlib/functions/bijection-onto
import mundane definition stdlib/sets/set-builder
import mundane theorem    stdlib/sets/set-builder-subset

define D(r, n) := ⌊10^n·r⌋ mod 10, for r ∈ ℝ, n ∈ ℕ                   (D1)
       reads the n-th digit of r after the decimal point

define s(a) := (a + 1) mod 10, for a ∈ ℤ                            (D2)
       reads the digit after a: add 1 and keep the last digit, so 9 becomes 0

theorem digit-range
  note        A remainder on division by 10 is one of 0 to 9, so s(t) is a
              digit.
  let t ∈ ℤ                                                          (H1)
  then 0 ≤ s(t) and s(t) ≤ 9

1.  s(t) = (t + 1) mod 10
    D2

2.  (t + 1) mod 10 < 10
    mun:mod-less a := t + 1, b := 10

3.  s(t) < 10
    substitute s(t) = (t + 1) mod 10 (line 1) into line 2

4.  s(t) ∈ ℕ₀
    membership, from 1

5.  s(t) + 1 ≤ 10
    mun:integer-step m := s(t), n := 10, from 4, 3

6.  0 ≤ s(t) and s(t) ≤ 9
    inequalities, from 5, 4

theorem digit-step-divides
  note        s(t) is what t + 1 leaves on division by 10, so the two differ
              by a multiple of 10.
  let t ∈ ℤ                                                          (H1)
  then 10 divides (t + 1) − s(t)

1.  s(t) = (t + 1) mod 10
    D2

2.  t + 1 ≡ (t + 1) mod 10 (mod 10)
    mun:mod-congruent x := t + 1, n := 10

3.  10 divides (t + 1) − (t + 1) mod 10
    mun:congruent-mod n := 10, a := t + 1, b := (t + 1) mod 10, from 2
    requires (t + 1) mod 10 ∈ ℤ: membership, from H1

4.  10 divides (t + 1) − s(t)
    substitute s(t) = (t + 1) mod 10 (line 1) into line 3

theorem digit-step
  note        Changing a digit with s always changes it: if s(t) were t, 10
              would divide (t + 1) − t, which is 1.
  let t ∈ ℤ                                                          (H1)
  then s(t) ≠ t

1.  10 divides (t + 1) − s(t)
    thm:digit-step-divides t := t

2.  s(t) ≠ t
    contradiction
    suppose s(t) = t                                                  (S1)

    2.1.  10 divides (t + 1) − t
          substitute s(t) = t (S1) into line 1

    2.2.  (t + 1) − t = 1
          algebra

    2.3.  10 divides 1, which is impossible
          substitute (t + 1) − t = 1 (line 2.2) into line 2.1

theorem digit-step-twice
  note        Changing it twice does not bring it back either: if s(s(t))
              were t, 10 would divide the two steps' sum, which is 2. The
              diagonal needs this, since its decimal may round its digit up
              once more (decimal-number).
  let t ∈ ℤ                                                          (H1)
  then s(s(t)) ≠ t

1.  s(t) ∈ ℤ
    membership, from D2

2.  10 divides (t + 1) − s(t)
    thm:digit-step-divides t := t

3.  10 divides (s(t) + 1) − s(s(t))
    thm:digit-step-divides t := s(t), from 1

4.  s(s(t)) ≠ t
    contradiction
    suppose s(s(t)) = t                                               (S)

    4.1.  10 divides (s(t) + 1) − t
          substitute s(s(t)) = t (S) into line 3

    4.2.  10 divides ((t + 1) − s(t)) + ((s(t) + 1) − t)
          mun:divides-sum d := 10, a := (t + 1) − s(t), b := (s(t) + 1) − t, from 2, 4.1
          requires (t + 1) − s(t) ∈ ℤ: membership, from H1, 1
          requires (s(t) + 1) − t ∈ ℤ: membership, from H1, 1

    4.3.  ((t + 1) − s(t)) + ((s(t) + 1) − t) = 2
          algebra
          requires s(t) ∈ ℝ: membership, from 1

    4.4.  10 divides 2, which is impossible
          substitute ((t + 1) − s(t)) + ((s(t) + 1) − t) = 2 (line 4.3) into line 4.2

theorem decimal-number
  note        The digits name a real number x: the least upper bound of the
              decimals cut off after k digits, L(k). Each U(k), the same
              decimal with its last digit one higher, is an upper bound, so x
              lies between L(k) and U(k) for every k. Its n-th digit is d(n),
              except where every later digit is 9; then the digit is the next
              one up, s(d(n)), as 0.0999… is 0.1.
  let d : ℕ → ℤ                                                      (H1)
  assume for all n ∈ ℕ, 0 ≤ d(n) and d(n) ≤ 9                          (H2)
  then there is x ∈ ℝ with for all n ∈ ℕ, D(x, n) = d(n) or D(x, n) = s(d(n))

define N(0) := 0,  N(k + 1) := 10·N(k) + d(k + 1),  for k ∈ ℕ₀       (D3)
       reads the whole number whose digits are d(1), d(2), …, d(k)

define S := {y ∈ ℝ : there is k ∈ ℕ₀ with y = N(k)/10^k}              (D4)
       reads the numbers 0.d(1)…d(k), the decimal cut off after k digits

define L(k) := N(k)/10^k, for k ∈ ℕ₀                                   (D5)
       reads the lower end: the decimal cut off after k digits

define U(k) := (N(k) + 1)/10^k, for k ∈ ℕ₀                             (D6)
       reads the upper end: the same decimal with its last digit one higher

1.  N(0) = 0
    D3

2.  For all k ∈ ℕ₀, N(k) ∈ ℤ.
    induction on k starting at 0

    base
    2.1.  N(0) ∈ ℤ
          membership, from 1

    step
    let k ∈ ℕ₀                                                        (K)
    assume step 2 is true for k, the induction hypothesis             (IH)

    2.2.  N(k + 1) = 10·N(k) + d(k + 1)
          D3

    2.3.  k + 1 ∈ ℕ
          mun:pos-int-nat
          requires 0 < k + 1: inequalities, from K

    2.4.  N(k + 1) ∈ ℤ
          membership, from 2.2, IH
          requires d(k + 1) ∈ ℤ: from H1, 2.3

3.  For all k ∈ ℕ₀, L(k) ≤ L(k + 1) and U(k + 1) ≤ U(k).
    proof
    note one more digit raises the lower end and lowers the upper one, or keeps them
    let k ∈ ℕ₀                                                        (K1)

    3.1.  N(k + 1) = 10·N(k) + d(k + 1)
          D3

    3.2.  k + 1 ∈ ℕ
          mun:pos-int-nat
          requires 0 < k + 1: inequalities, from K1

    3.3.  0 ≤ d(k + 1) and d(k + 1) ≤ 9
          instantiate n := k + 1 in H2, from 3.2

    3.4.  N(k) ∈ ℤ
          instantiate k := k in line 2

    3.5.  10·N(k) ≤ N(k + 1) and N(k + 1) + 1 ≤ 10·(N(k) + 1)
          inequalities, from 3.1, 3.3
          requires N(k) ∈ ℝ: membership, from 3.4
          requires d(k + 1) ∈ ℝ: membership, from H1, 3.2
          requires N(k + 1) ∈ ℝ: membership, from 3.1, 3.4, H1, 3.2

    3.6.  10^k ∈ ℕ
          mun:power-nat a := 10, m := k

    3.7.  10^(k + 1) ∈ ℕ
          mun:power-nat a := 10, m := k + 1

    3.8.  10^(k + 1) = 10^k·10
          mun:exponent-step a := 10, m := k

    3.9.  N(k)/10^k = (10·N(k))/(10^k·10)
          algebra
          requires N(k) ∈ ℝ: membership, from 3.4
          requires 10^k ≠ 0: inequalities, from 3.6

    3.10. N(k)/10^k = (10·N(k))/10^(k + 1)
          substitute 10^(k + 1) = 10^k·10 (line 3.8) into line 3.9

    3.11. (N(k) + 1)/10^k = (10·(N(k) + 1))/(10^k·10)
          algebra
          requires N(k) ∈ ℝ: membership, from 3.4
          requires 10^k ≠ 0: inequalities, from 3.6

    3.12. (N(k) + 1)/10^k = (10·(N(k) + 1))/10^(k + 1)
          substitute 10^(k + 1) = 10^k·10 (line 3.8) into line 3.11

    3.13. (10·N(k))/10^(k + 1) ≤ N(k + 1)/10^(k + 1)
          mun:divide-le x := 10·N(k), y := N(k + 1), c := 10^(k + 1), from 3.5
          requires 10·N(k) ∈ ℝ: membership, from 3.4
          requires N(k + 1) ∈ ℝ: membership, from 3.1, 3.4, H1, 3.2
          requires 10^(k + 1) ∈ ℝ: membership, from 3.7
          requires 10^(k + 1) > 0: inequalities, from 3.7

    3.14. (N(k + 1) + 1)/10^(k + 1) ≤ (10·(N(k) + 1))/10^(k + 1)
          mun:divide-le x := N(k + 1) + 1, y := 10·(N(k) + 1), c := 10^(k + 1), from 3.5
          requires N(k + 1) + 1 ∈ ℝ: membership, from 3.1, 3.4, H1, 3.2
          requires 10·(N(k) + 1) ∈ ℝ: membership, from 3.4
          requires 10^(k + 1) ∈ ℝ: membership, from 3.7
          requires 10^(k + 1) > 0: inequalities, from 3.7

    3.15. N(k)/10^k ≤ N(k + 1)/10^(k + 1)
          substitute N(k)/10^k = (10·N(k))/10^(k + 1) (line 3.10) into line 3.13

    3.16. (N(k + 1) + 1)/10^(k + 1) ≤ (N(k) + 1)/10^k
          substitute (N(k) + 1)/10^k = (10·(N(k) + 1))/10^(k + 1) (line 3.12) into line 3.14

    3.17. L(k) ≤ L(k + 1)
          calculation
            L(k) = N(k)/10^k                     D5
                 ≤ N(k + 1)/10^(k + 1)           3.15
                 = L(k + 1)                      D5

    3.18. U(k + 1) ≤ U(k)
          calculation
            U(k + 1) = (N(k + 1) + 1)/10^(k + 1)    D6
                     ≤ (N(k) + 1)/10^k              3.16
                     = U(k)                         D6

    3.19. L(k) ≤ L(k + 1) and U(k + 1) ≤ U(k)
          join 3.17, 3.18

4.  For all k ∈ ℕ₀, L(k) ∈ ℝ and U(k) ∈ ℝ and L(k) ≤ U(k).
    proof
    note each lower end and its upper end are real, and in order
    let k ∈ ℕ₀                                                        (K2)

    4.1.  N(k) ∈ ℤ
          instantiate k := k in line 2

    4.2.  10^k ∈ ℕ
          mun:power-nat a := 10, m := k

    4.3.  L(k) ∈ ℝ
          membership, from D5, 4.1, 4.2

    4.4.  U(k) ∈ ℝ
          membership, from D6, 4.1, 4.2

    4.5.  N(k) ≤ N(k) + 1
          inequalities
          requires N(k) ∈ ℝ: membership, from 4.1

    4.6.  N(k)/10^k ≤ (N(k) + 1)/10^k
          mun:divide-le x := N(k), y := N(k) + 1, c := 10^k, from 4.5
          requires N(k) ∈ ℝ: membership, from 4.1
          requires N(k) + 1 ∈ ℝ: membership, from 4.1
          requires 10^k ∈ ℝ: membership, from 4.2
          requires 10^k > 0: inequalities, from 4.2

    4.7.  L(k) ≤ U(k)
          calculation
            L(k) = N(k)/10^k               D5
                 ≤ (N(k) + 1)/10^k         4.6
                 = U(k)                    D6

    4.8.  L(k) ∈ ℝ. U(k) ∈ ℝ. L(k) ≤ U(k).
          join 4.3, 4.4, 4.7

5.  For all g ∈ ℕ₀, for all p ∈ ℕ₀, L(p) ≤ L(p + g) and U(p + g) ≤ U(p).
    induction on g starting at 0
    note the lower ends only rise and the upper ends only fall

    base
    5.1.  For all p ∈ ℕ₀, L(p) ≤ L(p + 0) and U(p + 0) ≤ U(p).
          proof
          let p ∈ ℕ₀                                                  (P1)

          5.1.1.  L(p) ∈ ℝ. U(p) ∈ ℝ. L(p) ≤ U(p).
                  instantiate k := p in line 4

          5.1.2.  L(p) ≤ L(p) and U(p) ≤ U(p)
                  inequalities, from 5.1.1

          5.1.3.  p = p + 0
                  algebra

          5.1.4.  L(p) ≤ L(p + 0) and U(p + 0) ≤ U(p)
                  substitute p = p + 0 (line 5.1.3) into line 5.1.2

    step
    let g ∈ ℕ₀                                                        (G)
    assume step 5 is true for g, the induction hypothesis             (IH2)

    5.2.  For all p ∈ ℕ₀, L(p) ≤ L(p + (g + 1)) and U(p + (g + 1)) ≤ U(p).
          proof
          let p ∈ ℕ₀                                                  (P2)

          5.2.1.  L(p) ≤ L(p + g) and U(p + g) ≤ U(p)
                  instantiate p := p in IH2

          5.2.2.  L(p + g) ≤ L((p + g) + 1) and U((p + g) + 1) ≤ U(p + g)
                  instantiate k := p + g in line 3

          5.2.3.  L(p) ∈ ℝ. U(p) ∈ ℝ. L(p) ≤ U(p).
                  instantiate k := p in line 4

          5.2.4.  L(p + g) ∈ ℝ. U(p + g) ∈ ℝ. L(p + g) ≤ U(p + g).
                  instantiate k := p + g in line 4

          5.2.5.  L((p + g) + 1) ∈ ℝ. U((p + g) + 1) ∈ ℝ.
                  L((p + g) + 1) ≤ U((p + g) + 1).
                  instantiate k := (p + g) + 1 in line 4

          5.2.6.  L(p) ≤ L((p + g) + 1) and U((p + g) + 1) ≤ U(p)
                  inequalities, from 5.2.1, 5.2.2, 5.2.3, 5.2.4, 5.2.5

          5.2.7.  (p + g) + 1 = p + (g + 1)
                  algebra

          5.2.8.  L(p) ≤ L(p + (g + 1)) and U(p + (g + 1)) ≤ U(p)
                  substitute (p + g) + 1 = p + (g + 1) (line 5.2.7) into line 5.2.6

6.  For all j ∈ ℕ₀, for all k ∈ ℕ₀, L(j) ≤ U(k).
    proof
    note every lower end is below every upper end: compare both at the later one
    let j ∈ ℕ₀                                                        (J1)
    let k ∈ ℕ₀                                                        (K3)

    6.1.  L(j) ∈ ℝ. U(j) ∈ ℝ. L(j) ≤ U(j).
          instantiate k := j in line 4

    6.2.  L(k) ∈ ℝ. U(k) ∈ ℝ. L(k) ≤ U(k).
          instantiate k := k in line 4

    6.3.  j ≤ k or not (j ≤ k)
          mun:excluded-middle P := j ≤ k

    6.4.  L(j) ≤ U(k)
          cases, from 6.3

          case
          assume j ≤ k                                                (C5)

          6.4.1.  k − j ∈ ℕ₀
                  mun:nat0-as-int
                  requires 0 ≤ k − j: inequalities, from C5

          6.4.2.  L(j) ≤ L(j + (k − j)) and U(j + (k − j)) ≤ U(j)
                  instantiate g := k − j, p := j in line 5, from 6.4.1

          6.4.3.  j + (k − j) = k
                  algebra

          6.4.4.  L(j) ≤ L(k) and U(k) ≤ U(j)
                  substitute j + (k − j) = k (line 6.4.3) into line 6.4.2

          6.4.5.  L(j) ≤ U(k)
                  inequalities, from 6.4.4, 6.1, 6.2

          case
          assume not (j ≤ k)                                          (C6)

          6.4.6.  j − k ∈ ℕ₀
                  mun:nat0-as-int
                  requires 0 ≤ j − k: inequalities, from C6

          6.4.7.  L(k) ≤ L(k + (j − k)) and U(k + (j − k)) ≤ U(k)
                  instantiate g := j − k, p := k in line 5, from 6.4.6

          6.4.8.  k + (j − k) = j
                  algebra

          6.4.9.  L(k) ≤ L(j) and U(j) ≤ U(k)
                  substitute k + (j − k) = j (line 6.4.8) into line 6.4.7

          6.4.10. L(j) ≤ U(k)
                  inequalities, from 6.4.9, 6.1, 6.2

7.  S ⊆ ℝ
    mun:set-builder-subset, from D4

8.  For all k ∈ ℕ₀, L(k) ∈ S.
    proof
    let k ∈ ℕ₀                                                        (K8)

    8.1.  L(k) ∈ ℝ. U(k) ∈ ℝ. L(k) ≤ U(k).
          instantiate k := k in line 4

    8.2.  L(k) = N(k)/10^k
          D5

    8.3.  L(k) ∈ S
          mun:set-builder u := L(k), from D4, 8.2
          requires L(k) ∈ ℝ: from 8.1

9.  L(0) ∈ S
    instantiate k := 0 in line 8

10. For all k ∈ ℕ₀, U(k) is an upper bound of S.
    proof
    let k ∈ ℕ₀                                                        (K4)

    10.1. For all y ∈ S, y ≤ U(k).
          proof
          let y ∈ S                                                   (Y)

          10.1.1. j ∈ ℕ₀. y = N(j)/10^j.
                  obtain j: mun:set-builder u := y, from D4, Y

          10.1.2. L(j) ≤ U(k)
                  instantiate j := j, k := k in line 6

          10.1.3. y = L(j)
                  calculation
                    y = N(j)/10^j     10.1.1
                      = L(j)          D5

          10.1.4. y ≤ U(k)
                  substitute y = L(j) (line 10.1.3) into line 10.1.2

    10.2. U(k) is an upper bound of S
          mun:upper-bound, from 10.1

11. U(0) is an upper bound of S
    instantiate k := 0 in line 10

12. c ∈ ℝ. c is a least upper bound of S.
    obtain c: axi:completeness S := S, from 7, 9, 11
    requires U(0) ∈ ℝ: membership, from D6, 1

13. c is an upper bound of S.
    For all u ∈ ℝ, if u is an upper bound of S then c ≤ u.
    mun:least-upper-bound, from 12

14. For all y ∈ S, y ≤ c.
    mun:upper-bound, from 13

15. For all k ∈ ℕ₀, L(k) ≤ c and c ≤ U(k).
    proof
    note c lies between the two ends after any number of digits
    let k ∈ ℕ₀                                                        (K5)

    15.1. L(k) ∈ ℝ. U(k) ∈ ℝ. L(k) ≤ U(k).
          instantiate k := k in line 4

    15.2. L(k) ∈ S
          instantiate k := k in line 8

    15.3. L(k) ≤ c
          instantiate y := L(k) in line 14, from 15.2

    15.4. U(k) is an upper bound of S
          instantiate k := k in line 10

    15.5. c ≤ U(k)
          instantiate u := U(k) in line 13, from 15.4
          requires U(k) ∈ ℝ: from 15.1

    15.6. L(k) ≤ c and c ≤ U(k)
          join 15.3, 15.5

16. For all n ∈ ℕ, D(c, n) = d(n) or D(c, n) = s(d(n)).
    proof
    let n ∈ ℕ                                                         (K6)

    16.1. n − 1 ∈ ℕ₀
          mun:nat-minus-one

    16.2. N((n − 1) + 1) = 10·N(n − 1) + d((n − 1) + 1)
          D3
          requires n − 1 ∈ ℕ₀: from 16.1

    16.3. (n − 1) + 1 = n
          algebra

    16.4. N(n) = 10·N(n − 1) + d(n)
          substitute (n − 1) + 1 = n (line 16.3) into line 16.2

    16.5. N(n − 1) ∈ ℤ
          instantiate k := n − 1 in line 2, from 16.1

    16.6. 0 ≤ d(n) and d(n) ≤ 9
          instantiate n := n in H2

    16.7. N(n) ∈ ℤ
          membership, from 16.4, 16.5
          requires d(n) ∈ ℤ: from H1, K6

    16.8. 10^n ∈ ℕ
          mun:power-nat a := 10, m := n

    16.9. L(n) ≤ c and c ≤ U(n)
          instantiate k := n in line 15

    16.10. 10^n·(N(n)/10^n) ≤ 10^n·c
           mun:multiply-le x := N(n)/10^n, y := c, c := 10^n, from 16.9, D5
           requires N(n)/10^n ∈ ℝ: membership, from 16.7, 16.8
           requires 10^n ∈ ℝ: membership, from 16.8
           requires 10^n > 0: inequalities, from 16.8

    16.11. 10^n·c ≤ 10^n·((N(n) + 1)/10^n)
           mun:multiply-le x := c, y := (N(n) + 1)/10^n, c := 10^n, from 16.9, D6
           requires (N(n) + 1)/10^n ∈ ℝ: membership, from 16.7, 16.8
           requires 10^n ∈ ℝ: membership, from 16.8
           requires 10^n > 0: inequalities, from 16.8

    16.12. 10^n·(N(n)/10^n) = N(n)
           algebra
           requires N(n) ∈ ℝ: membership, from 16.7
           requires 10^n ≠ 0: inequalities, from 16.8

    16.13. 10^n·((N(n) + 1)/10^n) = N(n) + 1
           algebra
           requires N(n) ∈ ℝ: membership, from 16.7
           requires 10^n ≠ 0: inequalities, from 16.8

    16.14. N(n) ≤ 10^n·c and 10^n·c ≤ N(n) + 1
           inequalities, from 16.10, 16.11, 16.12, 16.13, 16.8
           requires 10^n·(N(n)/10^n) ∈ ℝ: membership, from 16.7, 16.8

    16.15. ⌊10^n·c⌋ ∈ ℤ
           mun:floor-integer x := 10^n·c
           requires 10^n·c ∈ ℝ: membership, from 12, 16.8

    16.16. ⌊10^n·c⌋ ≤ 10^n·c
           mun:floor-below x := 10^n·c
           requires 10^n·c ∈ ℝ: membership, from 12, 16.8

    16.17. 10^n·c < ⌊10^n·c⌋ + 1
           mun:floor-above x := 10^n·c
           requires 10^n·c ∈ ℝ: membership, from 12, 16.8

    16.18. N(n) < ⌊10^n·c⌋ + 1
           inequalities, from 16.14, 16.17, 16.8, 16.15
           requires N(n) ∈ ℝ: membership, from 16.7

    16.19. N(n) + 1 ≤ ⌊10^n·c⌋ + 1
           mun:integer-step m := N(n), n := ⌊10^n·c⌋ + 1, from 16.7, 16.18
           requires ⌊10^n·c⌋ + 1 ∈ ℤ: membership, from 16.15

    16.20. D(c, n) = ⌊10^n·c⌋ mod 10
           D1

    16.21. d(n) ∈ ℕ₀
           mun:nat0-as-int
           requires d(n) ∈ ℤ: from H1, K6
           requires 0 ≤ d(n): from 16.6

    16.22. d(n) + 1 ∈ ℤ
           membership, from 16.21

    16.23. ⌊10^n·c⌋ ≤ N(n) or not (⌊10^n·c⌋ ≤ N(n))
           mun:excluded-middle P := ⌊10^n·c⌋ ≤ N(n)

    16.24. D(c, n) = d(n) or D(c, n) = s(d(n))
           cases, from 16.23

           case
           assume ⌊10^n·c⌋ ≤ N(n)                                     (C7)

           16.24.1. ⌊10^n·c⌋ = N(n)
                    mun:le-antisymmetric x := ⌊10^n·c⌋, y := N(n)
                    requires ⌊10^n·c⌋ ∈ ℝ: membership, from 16.15
                    requires N(n) ∈ ℝ: membership, from 16.7
                    requires ⌊10^n·c⌋ ≤ N(n): from C7
                    requires N(n) ≤ ⌊10^n·c⌋: inequalities, from 16.19

           16.24.2. N(n − 1)·10 + d(n) = ⌊10^n·c⌋
                    algebra, from 16.4, 16.24.1
                    requires N(n − 1) ∈ ℝ: membership, from 16.5
                    requires d(n) ∈ ℝ: membership, from 16.21
                    requires N(n) ∈ ℝ: membership, from 16.7
                    requires ⌊10^n·c⌋ ∈ ℝ: membership, from 16.15

           16.24.3. There is q ∈ ℤ with q·10 + d(n) = ⌊10^n·c⌋.
                    exhibit, from 16.5, 16.24.2

           16.24.4. ⌊10^n·c⌋ mod 10 = d(n)
                    mun:mod-remainder a := ⌊10^n·c⌋, m := 10, r := d(n), from 16.15, 16.24.3
                    requires d(n) ∈ ℕ₀: from 16.21
                    requires d(n) < 10: inequalities, from 16.6

           16.24.5. D(c, n) = d(n)
                    calculation
                      D(c, n) = ⌊10^n·c⌋ mod 10    16.20
                              = d(n)               16.24.4

           16.24.6. D(c, n) = d(n) or D(c, n) = s(d(n))
                    mun:or-left, from 16.24.5

           case
           assume not (⌊10^n·c⌋ ≤ N(n))                               (C8)

           16.24.7. N(n) < ⌊10^n·c⌋
                    inequalities, from C8, 16.7, 16.15

           16.24.8. N(n) + 1 ≤ ⌊10^n·c⌋
                    mun:integer-step m := N(n), n := ⌊10^n·c⌋, from 16.7, 16.15, 16.24.7

           16.24.9. ⌊10^n·c⌋ = N(n) + 1
                    mun:le-antisymmetric x := ⌊10^n·c⌋, y := N(n) + 1
                    requires ⌊10^n·c⌋ ∈ ℝ: membership, from 16.15
                    requires N(n) ∈ ℝ: membership, from 16.7
                    requires N(n) + 1 ∈ ℝ: membership, from 16.7
                    requires ⌊10^n·c⌋ ≤ N(n) + 1: inequalities, from 16.14, 16.16
                    requires N(n) + 1 ≤ ⌊10^n·c⌋: from 16.24.8

           16.24.10. ⌊10^n·c⌋ = N(n − 1)·10 + (d(n) + 1)
                     algebra, from 16.4, 16.24.9
                     requires N(n − 1) ∈ ℝ: membership, from 16.5
                     requires d(n) ∈ ℝ: membership, from 16.21
                     requires N(n) ∈ ℝ: membership, from 16.7
                     requires ⌊10^n·c⌋ ∈ ℝ: membership, from 16.15

           16.24.11. D(c, n) = (N(n − 1)·10 + (d(n) + 1)) mod 10
                     substitute ⌊10^n·c⌋ = N(n − 1)·10 + (d(n) + 1) (line 16.24.10) into line 16.20

           16.24.12. (N(n − 1)·10 + (d(n) + 1)) mod 10 = (d(n) + 1) mod 10
                     mun:mod-multiple r := d(n) + 1, m := 10, q := N(n − 1), from 16.5
                     requires d(n) + 1 ∈ ℤ: from 16.22

           16.24.13. s(d(n)) = (d(n) + 1) mod 10
                     D2
                     requires d(n) ∈ ℤ: from H1, K6

           16.24.14. D(c, n) = s(d(n))
                     calculation
                       D(c, n) = (N(n − 1)·10 + (d(n) + 1)) mod 10    16.24.11
                               = (d(n) + 1) mod 10                    16.24.12
                               = s(d(n))                              16.24.13

           16.24.15. D(c, n) = d(n) or D(c, n) = s(d(n))
                     mun:or-right, from 16.24.14

17. There is x ∈ ℝ with for all n ∈ ℕ, D(x, n) = d(n) or D(x, n) = s(d(n)).
    exhibit, from 16

theorem sequence-misses-real
  metamath    ruclem12, the form in which a sequence misses a real; proved by
              Cantor's diagonal argument rather than set.mm's nested intervals
  note        Cantor's diagonal argument. Change the n-th digit of f(n) with s
              for every n, and let x be the real number with those digits.
              Each digit of x is the changed one or the next one up, and
              neither is f(n)'s, so x differs from every f(n) at its n-th
              digit.
  let f : ℕ → ℝ                                                      (H1)
  then there is x ∈ ℝ with for all n ∈ ℕ, f(n) ≠ x

define e(n) := s(D(f(n), n)), for n ∈ ℕ                              (D7)
       reads the diagonal changed: the n-th digit of f(n), plus one, with 9 becoming 0

1.  For all n ∈ ℕ, D(f(n), n) ∈ ℤ.
    proof
    let n ∈ ℕ                                                         (K1)

    1.1.  D(f(n), n) = ⌊10^n·f(n)⌋ mod 10
          D1
          requires f(n) ∈ ℝ: from H1, K1

    1.2.  10^n ∈ ℕ
          mun:power-nat a := 10, m := n

    1.3.  ⌊10^n·f(n)⌋ ∈ ℤ
          mun:floor-integer x := 10^n·f(n)
          requires f(n) ∈ ℝ: from H1, K1
          requires 10^n·f(n) ∈ ℝ: membership, from 1.2

    1.4.  ⌊10^n·f(n)⌋ mod 10 ∈ ℕ₀
          mun:mod-natural a := ⌊10^n·f(n)⌋, b := 10, from 1.3

    1.5.  D(f(n), n) ∈ ℕ₀
          substitute D(f(n), n) = ⌊10^n·f(n)⌋ mod 10 (line 1.1) into line 1.4

    1.6.  D(f(n), n) ∈ ℤ
          membership, from 1.5

2.  For all n ∈ ℕ, e(n) ∈ ℤ and 0 ≤ e(n) and e(n) ≤ 9
    and e(n) ≠ D(f(n), n) and s(e(n)) ≠ D(f(n), n).
    proof
    let n ∈ ℕ                                                         (K2)

    2.1.  D(f(n), n) ∈ ℤ
          instantiate n := n in line 1

    2.2.  s(D(f(n), n)) ∈ ℤ
          membership, from D2, 2.1

    2.3.  0 ≤ s(D(f(n), n)) and s(D(f(n), n)) ≤ 9
          thm:digit-range t := D(f(n), n), from 2.1

    2.4.  s(D(f(n), n)) ≠ D(f(n), n)
          thm:digit-step t := D(f(n), n), from 2.1

    2.5.  s(s(D(f(n), n))) ≠ D(f(n), n)
          thm:digit-step-twice t := D(f(n), n), from 2.1

    2.6.  s(D(f(n), n)) ∈ ℤ and 0 ≤ s(D(f(n), n)) and s(D(f(n), n)) ≤ 9
          and s(D(f(n), n)) ≠ D(f(n), n) and s(s(D(f(n), n))) ≠ D(f(n), n)
          join 2.2, 2.3, 2.4, 2.5

    2.7.  e(n) = s(D(f(n), n))
          D7

    2.8.  e(n) ∈ ℤ and 0 ≤ e(n) and e(n) ≤ 9
          and e(n) ≠ D(f(n), n) and s(e(n)) ≠ D(f(n), n)
          substitute e(n) = s(D(f(n), n)) (line 2.7) into line 2.6

3.  For all n ∈ ℕ, e(n) ∈ ℤ.
    proof
    let n ∈ ℕ                                                         (K3)

    3.1.  e(n) ∈ ℤ and 0 ≤ e(n) and e(n) ≤ 9
          and e(n) ≠ D(f(n), n) and s(e(n)) ≠ D(f(n), n)
          instantiate n := n in line 2

    3.2.  e(n) ∈ ℤ
          membership, from 3.1

4.  e : ℕ → ℤ
    mun:function-into, from 3
    requires e is a function on ℕ: from D7

5.  For all n ∈ ℕ, 0 ≤ e(n) and e(n) ≤ 9.
    proof
    let n ∈ ℕ                                                         (K4)

    5.1.  D(f(n), n) ∈ ℤ
          instantiate n := n in line 1

    5.2.  e(n) ∈ ℤ and 0 ≤ e(n) and e(n) ≤ 9
          and e(n) ≠ D(f(n), n) and s(e(n)) ≠ D(f(n), n)
          instantiate n := n in line 2

    5.3.  0 ≤ e(n) and e(n) ≤ 9
          inequalities, from 5.2, 5.1

6.  x ∈ ℝ. For all n ∈ ℕ, D(x, n) = e(n) or D(x, n) = s(e(n)).
    obtain x: thm:decimal-number d := e, from 5
    requires e : ℕ → ℤ: from 4

7.  For all n ∈ ℕ, f(n) ≠ x.
    proof
    let n ∈ ℕ                                                         (K5)

    7.1.  e(n) ∈ ℤ and 0 ≤ e(n) and e(n) ≤ 9
          and e(n) ≠ D(f(n), n) and s(e(n)) ≠ D(f(n), n)
          instantiate n := n in line 2

    7.2.  D(x, n) = e(n) or D(x, n) = s(e(n))
          instantiate n := n in line 6

    7.3.  D(x, n) ≠ D(f(n), n)
          cases, from 7.2

          case
          assume D(x, n) = e(n)                                       (C1)

          7.3.1.  D(x, n) ≠ D(f(n), n)
                  substitute D(x, n) = e(n) (C1) into line 7.1

          case
          assume D(x, n) = s(e(n))                                    (C2)

          7.3.2.  D(x, n) ≠ D(f(n), n)
                  substitute D(x, n) = s(e(n)) (C2) into line 7.1

    7.4.  f(n) ≠ x
          contradiction
          suppose f(n) = x                                            (S)

          7.4.1.  D(x, n) = D(f(n), n)
                  substitute f(n) = x (S), contradicting 7.3

8.  There is x ∈ ℝ with for all n ∈ ℕ, f(n) ≠ x.
    exhibit, from 7

theorem reals-uncountable
  metamath    ruc, which says as well that ℕ is no larger than ℝ
  note        A bijection from ℕ to ℝ would list every real as some f(n), and
              sequence-misses-real gives a real the list misses.
  then there is no bijection from ℕ to ℝ

1.  There is no bijection from ℕ to ℝ.
    contradiction
    suppose there is a bijection from ℕ to ℝ                          (S)

    1.1.  f : ℕ → ℝ. For all y ∈ ℝ, there is n ∈ ℕ with y = f(n).
          obtain f: mun:bijection-onto X := ℕ, Y := ℝ, from S

    1.2.  x ∈ ℝ. For all n ∈ ℕ, f(n) ≠ x.
          obtain x: thm:sequence-misses-real f := f

    1.3.  There is n ∈ ℕ with x = f(n).
          instantiate y := x in line 1.1

    1.4.  m ∈ ℕ. x = f(m).
          obtain m from line 1.3

    1.5.  x ≠ f(m)
          instantiate n := m in line 1.2, contradicting 1.4
