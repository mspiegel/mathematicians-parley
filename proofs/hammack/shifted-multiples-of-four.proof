import definition         stdlib/functions/set-image
import definition         stdlib/sets/subset
import mundane theorem    stdlib/sets/subset-antisymmetric

theorem shifted-multiples-of-four
  note        4m + 5 = 4(m + 1) + 1, and 4m + 1 = 4(m − 1) + 5.
  then {4k + 5 : k ∈ ℤ} = {4k + 1 : k ∈ ℤ}

1.  For all t ∈ {4k + 5 : k ∈ ℤ}, t ∈ {4k + 1 : k ∈ ℤ}.
    proof
    let t ∈ {4k + 5 : k ∈ ℤ}                                          (K1)

    1.1.  There is k ∈ ℤ with t = 4k + 5.
          def:set-image u := t, from K1

    1.2.  m ∈ ℤ. t = 4m + 5.
          obtain m from line 1.1

    1.3.  t = 4·(m + 1) + 1
          algebra, from 1.2

    1.4.  There is k ∈ ℤ with t = 4k + 1.
          exhibit, from 1.3

    1.5.  t ∈ {4k + 1 : k ∈ ℤ}
          def:set-image u := t, from 1.4

2.  {4k + 5 : k ∈ ℤ} ⊆ {4k + 1 : k ∈ ℤ}
    def:subset, from 1

3.  For all t ∈ {4k + 1 : k ∈ ℤ}, t ∈ {4k + 5 : k ∈ ℤ}.
    proof
    let t ∈ {4k + 1 : k ∈ ℤ}                                          (K2)

    3.1.  There is k ∈ ℤ with t = 4k + 1.
          def:set-image u := t, from K2

    3.2.  m ∈ ℤ. t = 4m + 1.
          obtain m from line 3.1

    3.3.  t = 4·(m − 1) + 5
          algebra, from 3.2

    3.4.  There is k ∈ ℤ with t = 4k + 5.
          exhibit, from 3.3

    3.5.  t ∈ {4k + 5 : k ∈ ℤ}
          def:set-image u := t, from 3.4

4.  {4k + 1 : k ∈ ℤ} ⊆ {4k + 5 : k ∈ ℤ}
    def:subset, from 3

5.  {4k + 5 : k ∈ ℤ} = {4k + 1 : k ∈ ℤ}
    mun:subset-antisymmetric, from 2, 4
