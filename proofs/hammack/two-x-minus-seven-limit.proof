import definition         stdlib/calculus/limit-at
import mundane theorem    stdlib/sets/subset-self
import mundane theorem    stdlib/numbers/abs-difference-lt
import mundane theorem    stdlib/functions/function-value

theorem two-x-minus-seven-limit
  note        2x − 7 is within ε of 9 wherever x is within ε/2 of 8.
  ε, δ range over ℝ
  let f : ℝ → ℝ                                                       (H1)
  assume for all x ∈ ℝ, f(x) = 2x − 7                                (H2)
  then f tends to 9 at 8

1.  For all ε > 0, there exists δ > 0 such that |f(x) − 9| < ε for all x ∈ ℝ with (x ≠ 8 and |x − 8| < δ).
    proof
    let ε ∈ ℝ                                                         (K1)
    assume ε > 0                                                      (A1)

    1.1.  ε/2 > 0
          inequalities
            ε > 0              A1
            ε/2 > 0            multiplying by 1/2

    1.2.  For all x ∈ ℝ with (x ≠ 8 and |x − 8| < ε/2), |f(x) − 9| < ε.
          proof
          let x ∈ ℝ                                                   (K2)
          assume x ≠ 8 and |x − 8| < ε/2                              (A2)

          1.2.1.  f(x) = 2x − 7
                  instantiate x := x in H2

          1.2.2.  8 − ε/2 < x and x < 8 + ε/2
                  mun:abs-difference-lt c := 8, δ := ε/2, from A2

          1.2.3.  9 − ε < 2x − 7
                  inequalities
                    8 − ε/2 < x        1.2.2
                    16 − ε < 2x        multiplying by 2
                    9 − ε < 2x − 7     adding −7

          1.2.4.  9 − ε < f(x)
                  transitivity, from 1.2.3, 1.2.1

          1.2.5.  2x − 7 < 9 + ε
                  inequalities
                    x < 8 + ε/2        1.2.2
                    2x < 16 + ε        multiplying by 2
                    2x − 7 < 9 + ε     adding −7

          1.2.6.  f(x) < 9 + ε
                  transitivity, from 1.2.1, 1.2.5

          1.2.7.  9 − ε < f(x) and f(x) < 9 + ε
                  join 1.2.4, 1.2.6

          1.2.8.  |f(x) − 9| < ε
                  mun:abs-difference-lt x := f(x), c := 9, δ := ε, from 1.2.7
                  requires f(x) ∈ ℝ: mun:function-value

    1.3.  There exists δ > 0 such that |f(x) − 9| < ε for all x ∈ ℝ with (x ≠ 8 and |x − 8| < δ).
          exhibit, from 1.1, 1.2

2.  f tends to 9 at 8
    def:limit-at D := ℝ, c := 8, L := 9, from 1
    requires ℝ ⊆ ℝ: mun:subset-self
