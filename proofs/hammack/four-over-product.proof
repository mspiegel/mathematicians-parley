import mundane theorem    stdlib/numbers/square-nonneg
import mundane theorem    stdlib/numbers/less-scaled
import mundane theorem    stdlib/numbers/divide-le

theorem four-over-product
  note        x·(4 − x) is positive and at most 4, because 4 − x·(4 − x) is
              the square (x − 2)². Dividing it by itself gives 1, and
              dividing 4 by it gives at least that.
  let x ∈ ℝ                                                           (H1)
  assume 0 < x                                                        (H2)
  assume x < 4                                                        (H3)
  then 4/(x·(4 − x)) ≥ 1

1.  0 < 4 − x
    inequalities
      x < 4            H3
      0 < 4 − x        adding −x

2.  x·0 < x·(4 − x)
    mun:less-scaled x := 0, y := 4 − x, c := x, from H2, 1

3.  0 < x·(4 − x)
    inequalities, from 2

4.  (x − 2)² ≥ 0
    mun:square-nonneg x := x − 2

5.  (x − 2)² = 4 − x·(4 − x)
    algebra

6.  0 ≤ 4 − x·(4 − x)
    transitivity, from 4, 5

7.  x·(4 − x) ≤ 4
    inequalities
      0 ≤ 4 − x·(4 − x)      6
      x·(4 − x) ≤ 4          adding x·(4 − x)

8.  x·(4 − x)/(x·(4 − x)) ≤ 4/(x·(4 − x))
    mun:divide-le x := x·(4 − x), y := 4, c := x·(4 − x), from 3, 7

9.  x·(4 − x)/(x·(4 − x)) = 1
    algebra
    requires x·(4 − x) ≠ 0: weakening, from 3

10. 4/(x·(4 − x)) ≥ 1
    transitivity, from 9, 8
    requires x·(4 − x) ≠ 0: weakening, from 3
