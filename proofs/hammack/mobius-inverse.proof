import definition         stdlib/functions/onto
import definition         stdlib/functions/one-to-one-onto
import mundane theorem    stdlib/functions/inverse-value
import mundane theorem    stdlib/sets/remove-member

theorem mobius-inverse
  note        A y is f(x) for some x, by onto; solving y = (5x + 1)/(x − 2)
              gives x = (2y + 1)/(y − 5), and f⁻¹(y) = f⁻¹(f(x)) = x.
  let f : ℝ ∖ {2} → ℝ ∖ {5} be one-to-one and onto                    (H1)
  assume for all x ∈ ℝ ∖ {2}, f(x) = (5x + 1)/(x − 2)                (H2)
  then for all y ∈ ℝ ∖ {5}, f⁻¹(y) = (2y + 1)/(y − 5)

1.  f : ℝ ∖ {2} → ℝ ∖ {5} is one-to-one
    def:one-to-one-onto, from H1

2.  f : ℝ ∖ {2} → ℝ ∖ {5} is onto
    def:one-to-one-onto, from H1

3.  For all y ∈ ℝ ∖ {5}, there is x ∈ ℝ ∖ {2} with y = f(x).
    def:onto, from 2

4.  For all y ∈ ℝ ∖ {5}, f⁻¹(y) = (2y + 1)/(y − 5).
    proof
    let y ∈ ℝ ∖ {5}                                                   (K1)

    4.1.  y ∈ ℝ. y ≠ 5.
          mun:remove-member u := y, Y := ℝ, a := 5, from K1

    4.2.  x ∈ ℝ ∖ {2}. y = f(x).
          obtain x from line 3

    4.3.  x ∈ ℝ. x ≠ 2.
          mun:remove-member u := x, Y := ℝ, a := 2, from 4.2

    4.4.  y = (5x + 1)/(x − 2)
          calculation
            y = f(x)                  4.2
              = (5x + 1)/(x − 2)      instantiate x := x in H2, from 4.2

    4.5.  x = (2y + 1)/(y − 5)
          algebra, from 4.3, 4.4
          requires x − 2 ≠ 0: inequalities, from 4.3
          requires y − 5 ≠ 0: inequalities, from 4.1

    4.6.  f⁻¹(f(x)) = x
          mun:inverse-value g := f, y := x, from 1, 4.2

    4.7.  f⁻¹(y) = x
          substitute y = f(x) (line 4.2) into line 4.6

    4.8.  f⁻¹(y) = (2y + 1)/(y − 5)
          calculation
            f⁻¹(y) = x                  4.7
                   = (2y + 1)/(y − 5)   4.5
