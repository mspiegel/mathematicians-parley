import definition         stdlib/divisibility/even
import mundane theorem    stdlib/divisibility/even-product-factor

theorem both-even-from-product-and-sum
  note        A product is even only if a factor is. If a is even, a = 2j
              and a + b = 2m, so b = 2(m − j). If b is even, b = 2j and
              a + b = 2m, so a = 2(m − j).
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  assume a·b is even                                                  (H3)
  assume a + b is even                                                (H4)
  then a is even and b is even

1.  a is even or b is even
    mun:even-product-factor, from H3

2.  m ∈ ℤ. a + b = 2m.
    obtain m: def:even n := a + b, from H4

3.  a is even and b is even
    cases, from 1

    case
    assume a is even                                                  (C1)

    3.1.  j ∈ ℤ. a = 2j.
          obtain j: def:even, from C1

    3.2.  b = 2(m − j)
          algebra, from 2, 3.1

    3.3.  b is even
          def:even n := b, from 3.2

    3.4.  a is even and b is even
          join C1, 3.3

    case
    assume b is even                                                  (C2)

    3.5.  j ∈ ℤ. b = 2j.
          obtain j: def:even, from C2

    3.6.  a = 2(m − j)
          algebra, from 2, 3.5

    3.7.  a is even
          def:even n := a, from 3.6

    3.8.  a is even and b is even
          join C2, 3.7
