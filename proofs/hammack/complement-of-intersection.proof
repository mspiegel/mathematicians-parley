import definition         stdlib/sets/difference
import definition         stdlib/sets/intersection
import definition         stdlib/sets/subset
import definition         stdlib/sets/union
import mundane theorem    stdlib/sets/in-union-left
import mundane theorem    stdlib/sets/in-union-right
import mundane theorem    stdlib/sets/subset-antisymmetric
import axiom              stdlib/reasoning/excluded-middle

theorem complement-of-intersection
  note        An element of U outside A ∩ B is outside A or outside B.
              Conversely, outside A or outside B is outside A ∩ B.
  let U be a set                                                      (H1)
  let A be a set                                                      (H2)
  let B be a set                                                      (H3)
  assume A ⊆ U                                                        (H4)
  assume B ⊆ U                                                        (H5)
  then U ∖ (A ∩ B) = (U ∖ A) ∪ (U ∖ B)

1.  For all t ∈ U ∖ (A ∩ B), t ∈ (U ∖ A) ∪ (U ∖ B).
    proof
    let t ∈ U ∖ (A ∩ B)                                               (K1)

    1.1.  t ∈ U. t ∉ A ∩ B.
          def:difference u := t, Y := U, Z := A ∩ B, from K1

    1.2.  t ∈ A or t ∉ A
          axi:excluded-middle P := t ∈ A

    1.3.  t ∈ (U ∖ A) ∪ (U ∖ B)
          cases, from 1.2

          case
          note t is in A, so it cannot be in B
          assume t ∈ A                                                (C1)

          1.3.1.  t ∉ B
                  contradiction
                  suppose t ∈ B                                       (S1)

                  1.3.1.1.  t ∈ A ∩ B
                            def:intersection u := t, Y := A, Z := B, from C1, S1, contradicting 1.1

          1.3.2.  t ∈ U ∖ B
                  def:difference u := t, Y := U, Z := B, from 1.1, 1.3.1

          1.3.3.  t ∈ (U ∖ A) ∪ (U ∖ B)
                  mun:in-union-right u := t, Y := U ∖ A, Z := U ∖ B, from 1.3.2

          case
          note t is not in A, so it is in U ∖ A
          assume t ∉ A                                                (C2)

          1.3.4.  t ∈ U ∖ A
                  def:difference u := t, Y := U, Z := A, from C2, 1.1

          1.3.5.  t ∈ (U ∖ A) ∪ (U ∖ B)
                  mun:in-union-left u := t, Y := U ∖ A, Z := U ∖ B, from 1.3.4

2.  U ∖ (A ∩ B) ⊆ (U ∖ A) ∪ (U ∖ B)
    def:subset, from 1

3.  For all t ∈ (U ∖ A) ∪ (U ∖ B), t ∈ U ∖ (A ∩ B).
    proof
    let t ∈ (U ∖ A) ∪ (U ∖ B)                                         (K2)

    3.1.  t ∈ U ∖ A or t ∈ U ∖ B
          def:union u := t, Y := U ∖ A, Z := U ∖ B, from K2

    3.2.  t ∈ U ∖ (A ∩ B)
          cases, from 3.1

          case
          note t is outside A, so outside A ∩ B
          assume t ∈ U ∖ A                                            (C3)

          3.2.1.  t ∈ U. t ∉ A.
                  def:difference u := t, Y := U, Z := A, from C3

          3.2.2.  t ∉ A ∩ B
                  contradiction
                  suppose t ∈ A ∩ B                                   (S2)

                  3.2.2.1.  t ∈ A
                            def:intersection u := t, Y := A, Z := B, from S2, contradicting 3.2.1

          3.2.3.  t ∈ U ∖ (A ∩ B)
                  def:difference u := t, Y := U, Z := A ∩ B, from 3.2.1, 3.2.2

          case
          note t is outside B, so outside A ∩ B
          assume t ∈ U ∖ B                                            (C4)

          3.2.4.  t ∈ U. t ∉ B.
                  def:difference u := t, Y := U, Z := B, from C4

          3.2.5.  t ∉ A ∩ B
                  contradiction
                  suppose t ∈ A ∩ B                                   (S3)

                  3.2.5.1.  t ∈ B
                            def:intersection u := t, Y := A, Z := B, from S3, contradicting 3.2.4

          3.2.6.  t ∈ U ∖ (A ∩ B)
                  def:difference u := t, Y := U, Z := A ∩ B, from 3.2.4, 3.2.5

4.  (U ∖ A) ∪ (U ∖ B) ⊆ U ∖ (A ∩ B)
    def:subset, from 3

5.  U ∖ (A ∩ B) = (U ∖ A) ∪ (U ∖ B)
    mun:subset-antisymmetric, from 2, 4
