import definition         stdlib/functions/set-image
import definition         stdlib/sets/subset
import mundane theorem    stdlib/sets/subset-antisymmetric

theorem rational-multiples-of-nine
  note        9n = 3(3n), and 3n = 9(n/3).
  then {9n : n ∈ ℚ} = {3n : n ∈ ℚ}

1.  For all t ∈ {9n : n ∈ ℚ}, t ∈ {3n : n ∈ ℚ}.
    proof
    let t ∈ {9n : n ∈ ℚ}                                              (K1)

    1.1.  There is n ∈ ℚ with t = 9n.
          def:set-image u := t, from K1

    1.2.  m ∈ ℚ. t = 9m.
          obtain m from line 1.1

    1.3.  t = 3·(3m)
          algebra, from 1.2

    1.4.  There is n ∈ ℚ with t = 3n.
          exhibit, from 1.3

    1.5.  t ∈ {3n : n ∈ ℚ}
          def:set-image u := t, from 1.4

2.  {9n : n ∈ ℚ} ⊆ {3n : n ∈ ℚ}
    def:subset, from 1

3.  For all t ∈ {3n : n ∈ ℚ}, t ∈ {9n : n ∈ ℚ}.
    proof
    let t ∈ {3n : n ∈ ℚ}                                              (K2)

    3.1.  There is n ∈ ℚ with t = 3n.
          def:set-image u := t, from K2

    3.2.  m ∈ ℚ. t = 3m.
          obtain m from line 3.1

    3.3.  t = 9·(m/3)
          algebra, from 3.2

    3.4.  There is n ∈ ℚ with t = 9n.
          exhibit, from 3.3

    3.5.  t ∈ {9n : n ∈ ℚ}
          def:set-image u := t, from 3.4

4.  {3n : n ∈ ℚ} ⊆ {9n : n ∈ ℚ}
    def:subset, from 3

5.  {9n : n ∈ ℚ} = {3n : n ∈ ℚ}
    mun:subset-antisymmetric, from 2, 4
