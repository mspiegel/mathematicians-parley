import mundane theorem    stdlib/sums/sum-single
import mundane theorem    stdlib/sums/sum-extended
import theorem            proofs/hammack/fibonacci-numbers/fibonacci-natural
import theorem            proofs/hammack/fibonacci-numbers/fibonacci-recurrence

theorem fibonacci-sum-of-squares
  note        By induction on n: the sum to 1 is F(1)² = 1 = F(1)·F(2), and
              adding F(n + 1)² to F(n)·F(n + 1) gives F(n + 1)·(F(n) +
              F(n + 1)), which is F(n + 1)·F(n + 2) since each Fibonacci
              number is the sum of the two before it.
  let n ∈ ℕ                                                           (H1)
  let F(0) = 0,  G(0) = 1,
      F(k + 1) = G(k),  G(k + 1) = F(k) + G(k),  for k ∈ ℕ₀           (D1)
         reads the Fibonacci numbers, F(k) the kth and G(k) the next
  then Σ(k = 1 to n) F(k)² = F(n)·F(n + 1)

1.  For all k ∈ ℕ₀, F(k) ∈ ℕ₀ and G(k) ∈ ℕ₀.
    thm:fibonacci-natural

2.  For all k ∈ ℕ₀, F(k) ∈ ℝ.
    proof
    let k ∈ ℕ₀                                                        (K1)

    2.1.  F(k) ∈ ℝ
          membership, from 1

let q(j) = F(j)², for j ∈ ℕ₀                                          (D2)
       reads the square of the jth Fibonacci number

3.  For all k ∈ ℕ₀, F(k + 2) = F(k) + F(k + 1).
    thm:fibonacci-recurrence

4.  For all m ∈ ℕ, Σ(j = 1 to m) q(j) = F(m)·F(m + 1).
    induction on m starting at 1

    base
    4.1.  For all i ∈ {1, …, 1}, q(i) ∈ ℝ.
          proof
          let i ∈ {1, …, 1}                                           (J1)

          4.1.1.  F(i) ∈ ℝ
                  instantiate k := i in line 2

          4.1.2.  q(i) ∈ ℝ
                  membership, from D2, 4.1.1

    4.2.  Σ(j = 1 to 1) q(j) = q(1)
          mun:sum-single a := 1
          requires for all i ∈ {1, …, 1}, q(i) ∈ ℝ: from 4.1

    4.3.  F(1) = G(0)
          D1

    4.4.  G(0) = 1
          D1

    4.5.  F(0) = 0
          D1

    4.6.  F(1) = 1
          calculation
            F(1) = G(0)    4.3
                 = 1       4.4

    4.7.  F(2) = F(0) + F(1)
          instantiate k := 0 in line 3

    4.8.  F(1 + 1) = 1
          calculation
            F(1 + 1) = F(2)        arithmetic
                     = 1           algebra, from 4.5, 4.6, 4.7

    4.9.  Σ(j = 1 to 1) q(j) = F(1)·F(1 + 1)
          algebra, from D2, 4.2, 4.6, 4.8

    step
    let m ∈ ℕ                                                         (K3)
    assume step 4 is true for m, the induction hypothesis             (IH2)

    4.10. For all i ∈ {1, …, m + 1}, q(i) ∈ ℝ.
          proof
          let i ∈ {1, …, m + 1}                                       (J2)

          4.10.1. F(i) ∈ ℝ
                  instantiate k := i in line 2

          4.10.2. q(i) ∈ ℝ
                  membership, from D2, 4.10.1

    4.11. Σ(j = 1 to m + 1) q(j) = Σ(j = 1 to m) q(j) + q(m + 1)
          mun:sum-extended a := 1, n := m
          requires m ≥ 1: from K3
          requires for all i ∈ {1, …, m + 1}, q(i) ∈ ℝ: from 4.10

    4.12. F(m + 2) = F(m) + F(m + 1)
          instantiate k := m in line 3

    4.13. F(m) ∈ ℝ
          instantiate k := m in line 2

    4.14. F(m + 1) ∈ ℝ
          instantiate k := m + 1 in line 2

    4.15. Σ(j = 1 to m + 1) q(j) = F(m + 1)·F(m + 2)
          algebra, from D2, IH2, 4.11, 4.12
          requires F(m) ∈ ℝ: from 4.13
          requires F(m + 1) ∈ ℝ: from 4.14

    4.16. Σ(j = 1 to m + 1) q(j) = F(m + 1)·F((m + 1) + 1)
          substitute
            Σ(j = 1 to m + 1) q(j) = F(m + 1)·F(m + 2)            4.15
            Σ(j = 1 to m + 1) q(j) = F(m + 1)·F((m + 1) + 1)      algebra

5.  Σ(k = 1 to n) F(k)² = F(n)·F(n + 1)
    instantiate m := n in line 4, from D2
