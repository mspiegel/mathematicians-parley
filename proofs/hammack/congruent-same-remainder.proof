import mundane definition stdlib/divisibility/congruent-mod
import mundane definition stdlib/divisibility/divides
import mundane theorem    stdlib/divisibility/mod-multiple

theorem congruent-same-remainder
  note        If a ≡ b (mod n) then a − b = n·k, so a = k·n + b, and a whole
              number of n's added to b changes no remainder.
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  let n ∈ ℕ                                                           (H3)
  assume a ≡ b (mod n)                                                (H4)
  then a mod n = b mod n

1.  n divides a − b
    mun:congruent-mod, from H4

2.  k ∈ ℤ. a − b = n·k.
    obtain k: mun:divides d := n, n := a − b, from 1

3.  a = k·n + b
    algebra, from 2

4.  (k·n + b) mod n = b mod n
    mun:mod-multiple r := b, m := n, q := k

5.  a mod n = b mod n
    substitute a = k·n + b (line 3) into line 4
