import definition         stdlib/calculus/tends-to
import theorem            stdlib/numbers/archimedean
import definition         stdlib/counting/factorial
import mundane theorem    stdlib/counting/factorial-nat
import mundane theorem    stdlib/counting/factorial-nonzero
import mundane theorem    stdlib/numbers/exponent-step
import mundane theorem    stdlib/numbers/multiply-le
import mundane theorem    stdlib/numbers/divide-le
import mundane theorem    stdlib/numbers/power-nat
import mundane theorem    stdlib/numbers/product-positive
import mundane theorem    stdlib/numbers/quotient-positive
import mundane theorem    stdlib/numbers/reciprocal-order
import mundane theorem    stdlib/numbers/abs-difference-lt

theorem factorial-beats-power
  note        Going from k to k + 1 doubles 2^k and multiplies k! by
              k + 1, which is at least 2. So 2^k ≤ 2·k! persists, and
              (k + 1)·2^(k + 1) is (k + 1) times twice 2^k, at most
              (k + 1) times 4·k!.
  let n ∈ ℕ                                                           (H1)
  then n·2^n ≤ 4·n!

1.  For all k ∈ ℕ, 2^k ≤ 2·k! and k·2^k ≤ 4·k!.
    induction on k starting at 1

    base
    1.1.  2^1 ≤ 2·1!
          arithmetic

    1.2.  1·2^1 ≤ 4·1!
          arithmetic

    1.3.  2^1 ≤ 2·1! and 1·2^1 ≤ 4·1!
          join 1.1, 1.2

    step
    let k ∈ ℕ                                                         (K)
    assume step 1 is true for k, the induction hypothesis             (IH)

    1.4.  k! ∈ ℕ
          mun:factorial-nat n := k

    1.5.  k! > 0
          inequalities, from 1.4

    1.6.  (k + 1)! = k!·(k + 1)
          def:factorial n := k

    1.7.  2^(k + 1) = 2^k·2
          mun:exponent-step a := 2, m := k

    1.8.  2^k·2 ≤ 2·k!·2
          inequalities
            2^k ≤ 2·k!            IH
            2^k·2 ≤ 2·k!·2        multiplying by 2
          requires k! ∈ ℝ: from 1.4

    1.9.  k ≥ 1
          inequalities, from K

    1.10. k + 1 ≥ 2
          inequalities
            k ≥ 1                 1.9
            k + 1 ≥ 2             adding 1

    1.11. 2·k! > 0
          inequalities
            k! > 0                1.5
            2·k! > 0              multiplying by 2
          requires k! ∈ ℝ: from 1.4

    1.12. 2·k!·2 ≤ 2·k!·(k + 1)
          mun:multiply-le x := 2, y := k + 1, c := 2·k!, from 1.10, 1.11
          requires k! ∈ ℝ: from 1.4

    1.13. 2·k!·(k + 1) = 2·(k + 1)!
          algebra, from 1.6
          requires k! ∈ ℝ: from 1.4

    1.14. 2^(k + 1) ≤ 2·(k + 1)!
          transitivity, from 1.7, 1.8, 1.12, 1.13
          requires k! ∈ ℝ: from 1.4
          requires (k + 1)! ∈ ℝ: membership, from 1.4, 1.6

    1.15. (k + 1)·2^(k + 1) = (k + 1)·(2^k·2)
          algebra, from 1.7

    1.16. (k + 1)·(2·k!·2) = 4·(k + 1)!
          algebra, from 1.6
          requires k! ∈ ℝ: from 1.4

    1.17. (k + 1)·2^(k + 1) ≤ 4·(k + 1)!
          calculation
            (k + 1)·2^(k + 1) = (k + 1)·(2^k·2)          1.15
                              ≤ (k + 1)·(2·k!·2)         mun:multiply-le x := 2^k·2, y := 2·k!·2, c := k + 1, from 1.8
                              = 4·(k + 1)!               1.16
          requires k + 1 > 0: inequalities, from K
          requires k! ∈ ℝ: from 1.4

    1.18. 2^(k + 1) ≤ 2·(k + 1)! and (k + 1)·2^(k + 1) ≤ 4·(k + 1)!
          join 1.14, 1.17

2.  2^n ≤ 2·n! and n·2^n ≤ 4·n!
    instantiate k := n in line 1

3.  n·2^n ≤ 4·n!
    restate 2


theorem two-power-over-factorial
  note        2^n/n! is at most 4/n (factorial-beats-power), and 4/n is
              below ε once n ≥ N with 1/N below ε/4.
  ε ranges over ℝ
  n ranges over ℕ
  let a : ℕ → ℝ                                                       (H1)
  assume for all n ∈ ℕ, a(n) = 2^n/n!                                (H2)
  then a(n) → 0 as n → ∞

1.  For all ε > 0, there exists N ∈ ℕ such that |a(n) − 0| < ε for all n ≥ N.
    proof
    let ε ∈ ℝ                                                         (K1)
    assume ε > 0                                                      (A1)

    1.1.  ε/4 > 0
          inequalities
            ε > 0              A1
            ε/4 > 0            multiplying by 1/4

    1.2.  N ∈ ℕ. 1/N < ε/4.
          obtain N: thm:archimedean x := ε/4, from 1.1

    1.3.  For all n ≥ N, |a(n) − 0| < ε.
          proof
          let n ∈ ℕ                                                   (K2)
          assume n ≥ N                                                (A2)

          1.3.1.  n! ∈ ℕ
                  mun:factorial-nat

          1.3.2.  n! ≠ 0
                  mun:factorial-nonzero

          1.3.3.  n·2^n ≤ 4·n!
                  thm:factorial-beats-power

          1.3.4.  n·n! > 0
                  mun:product-positive x := n, y := n!, from 1.3.1
                  requires n > 0: inequalities, from K2

          1.3.5.  2^n/n! ≤ 4/n
                  calculation
                    2^n/n! = n·2^n/(n·n!)        algebra
                           ≤ 4·n!/(n·n!)         mun:divide-le x := n·2^n, y := 4·n!, c := n·n!, from 1.3.3, 1.3.4
                           = 4/n                 algebra
                  requires n! ∈ ℝ: from 1.3.1
                  requires n! ≠ 0: from 1.3.2

          1.3.6.  1/n ≤ 1/N
                  mun:reciprocal-order x := N, y := n, from A2
                  requires N > 0: inequalities, from 1.2
                  requires n > 0: inequalities, from K2

          1.3.7.  4/n ≤ 4/N
                  inequalities
                    1/n ≤ 1/N          1.3.6
                    4/n ≤ 4/N          multiplying by 4

          1.3.8.  4/N < ε
                  inequalities
                    1/N < ε/4          1.2
                    4/N < ε            multiplying by 4

          1.3.9.  2^n ∈ ℕ
                  mun:power-nat a := 2, m := n

          1.3.10. 2^n/n! > 0
                  mun:quotient-positive x := 2^n, y := n!, from 1.3.1
                  requires 2^n > 0: inequalities, from 1.3.9

          1.3.11. 0 < a(n)
                  transitivity, from 1.3.10, H2
                  requires n! ∈ ℝ: from 1.3.1
                  requires n! ≠ 0: from 1.3.2

          1.3.12. 0 − ε < 0
                  inequalities
                    ε > 0              A1
                    0 − ε < 0          multiplying by −1

          1.3.13. 0 − ε < a(n)
                  transitivity, from 1.3.12, 1.3.11
                  requires a(n) ∈ ℝ: from H1

          1.3.14. a(n) < 0 + ε
                  transitivity, from H2, 1.3.5, 1.3.7, 1.3.8
                  requires n! ∈ ℝ: from 1.3.1
                  requires n! ≠ 0: from 1.3.2

          1.3.15. 0 − ε < a(n) and a(n) < 0 + ε
                  join 1.3.13, 1.3.14

          1.3.16. |a(n) − 0| < ε
                  mun:abs-difference-lt x := a(n), c := 0, δ := ε, from 1.3.15
                  requires a(n) ∈ ℝ: from H1

    1.4.  There exists N ∈ ℕ such that |a(n) − 0| < ε for all n ≥ N.
          exhibit, from 1.3

2.  a(n) → 0 as n → ∞
    def:tends-to L := 0, from 1
