import definition         stdlib/functions/set-image
import definition         stdlib/sets/intersection
import definition         stdlib/sets/subset

theorem multiples-of-twelve
  note        12n = 2(6n) and 12n = 3(4n).
  then {12n : n ∈ ℤ} ⊆ {2n : n ∈ ℤ} ∩ {3n : n ∈ ℤ}

1.  For all t ∈ {12n : n ∈ ℤ}, t ∈ {2n : n ∈ ℤ} ∩ {3n : n ∈ ℤ}.
    proof
    let t ∈ {12n : n ∈ ℤ}                                             (K1)

    1.1.  There is n ∈ ℤ with t = 12n.
          def:set-image u := t, from K1

    1.2.  m ∈ ℤ. t = 12m.
          obtain m from line 1.1

    1.3.  t = 2·(6m)
          algebra, from 1.2

    1.4.  There is n ∈ ℤ with t = 2n.
          exhibit, from 1.3

    1.5.  t ∈ {2n : n ∈ ℤ}
          def:set-image u := t, from 1.4

    1.6.  t = 3·(4m)
          algebra, from 1.2

    1.7.  There is n ∈ ℤ with t = 3n.
          exhibit, from 1.6

    1.8.  t ∈ {3n : n ∈ ℤ}
          def:set-image u := t, from 1.7

    1.9.  t ∈ {2n : n ∈ ℤ} ∩ {3n : n ∈ ℤ}
          def:intersection u := t, from 1.5, 1.8

2.  {12n : n ∈ ℤ} ⊆ {2n : n ∈ ℤ} ∩ {3n : n ∈ ℤ}
    def:subset, from 1
