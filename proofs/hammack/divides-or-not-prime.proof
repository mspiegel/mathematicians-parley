import definition         stdlib/divisibility/gcd
import definition         stdlib/divisibility/prime
import mundane theorem    stdlib/reasoning/double-negation
import mundane theorem    stdlib/reasoning/modus-ponens
import mundane theorem    stdlib/reasoning/not-either

theorem divides-or-not-prime
  note        Let d = gcd(a, b), which divides b and exceeds 1. If b is prime,
              d is 1 or b, so d is b, and b = d divides a. Hence either b
              divides a, or b is not prime.
  let a ∈ ℕ                                                           (H1)
  let b ∈ ℕ                                                           (H2)
  assume gcd(a, b) > 1                                                (H3)
  then b divides a or not (b is prime)

1.  b divides a or not (b is prime)
    contradiction
    suppose not (b divides a or not (b is prime))                     (S)

    1.1.  not (b divides a). not not (b is prime).
          mun:not-either, from S

    1.2.  b is prime
          mun:double-negation, from 1.1

    1.3.  b > 1. For all d ∈ ℕ, if d divides b then d = 1 or d = b.
          def:prime p := b, from 1.2

    1.4.  gcd(a, b) ∈ ℕ. gcd(a, b) divides b.
          def:gcd

    1.5.  If gcd(a, b) divides b then gcd(a, b) = 1 or gcd(a, b) = b.
          instantiate d := gcd(a, b) in line 1.3, from 1.4

    1.6.  gcd(a, b) = 1 or gcd(a, b) = b
          mun:modus-ponens P := gcd(a, b) divides b, from 1.4, 1.5

    1.7.  gcd(a, b) divides a
          def:gcd

    1.8.  b divides a
          cases, from 1.6, contradicting 1.1

          case
          assume gcd(a, b) = 1                                        (C1)

          1.8.1.  gcd(a, b) ≠ 1
                  inequalities, contradicting C1
                    gcd(a, b) > 1     H3
                    gcd(a, b) ≠ 1     weakening

          case
          assume gcd(a, b) = b                                        (C2)

          1.8.2.  b divides a
                  substitute gcd(a, b) = b (C2) into line 1.7
