import definition         stdlib/calculus/tends-to
import mundane theorem    stdlib/numbers/abs-difference-lt

theorem divergent-has-no-limit
  note        A limit L would put a(n) within 1 of L from some P on, and
              above L + 1 from some Q on. At n = P + Q both hold.
  ε ranges over ℝ
  n ranges over ℕ
  let a : ℕ → ℝ                                                       (H1)
  assume for all M ∈ ℝ, there exists N ∈ ℕ such that a(n) > M for all n > N   (H2)
  then there is no L ∈ ℝ with a(n) → L as n → ∞
  by          contradiction

suppose there is L ∈ ℝ with a(n) → L as n → ∞                         (S)

1.  L ∈ ℝ. a(n) → L as n → ∞.
    obtain L from S

2.  For all ε > 0, there exists N ∈ ℕ such that |a(n) − L| < ε for all n ≥ N.
    def:tends-to, from 1

3.  There exists N ∈ ℕ such that |a(n) − L| < 1 for all n ≥ N.
    instantiate ε := 1 in line 2
    requires 0 < 1: arithmetic

4.  P ∈ ℕ. |a(n) − L| < 1 for all n ≥ P.
    obtain P from line 3

5.  There exists N ∈ ℕ such that a(n) > L + 1 for all n > N.
    instantiate M := L + 1 in H2

6.  Q ∈ ℕ. a(n) > L + 1 for all n > Q.
    obtain Q from line 5

7.  Q > 0
    inequalities, from 6

8.  P + Q ≥ P
    inequalities
      Q > 0              7
      P + Q > P          adding P
      P + Q ≥ P          weakening

9.  P > 0
    inequalities, from 4

10. P + Q > Q
    inequalities
      P > 0              9
      P + Q > Q          adding Q

11. |a(P + Q) − L| < 1
    instantiate n := P + Q in line 4, from 8

12. a(P + Q) > L + 1
    instantiate n := P + Q in line 6, from 10

13. L − 1 < a(P + Q) and a(P + Q) < L + 1
    mun:abs-difference-lt x := a(P + Q), c := L, δ := 1, from 11
    requires a(P + Q) ∈ ℝ: from H1

14. a(P + Q) ≤ L + 1
    inequalities
      a(P + Q) < L + 1       13
      a(P + Q) ≤ L + 1       weakening
    requires a(P + Q) ∈ ℝ: from H1

15. not a(P + Q) > L + 1
    inequalities, from 14, contradicting 12
    requires a(P + Q) ∈ ℝ: from H1
