import theorem            proofs/wiedijk/sqrt2-irrational/sqrt2-irrational
import definition         stdlib/numbers/rational
import definition         stdlib/numbers/irrational
import definition         stdlib/numbers/sqrt
import mundane theorem    stdlib/numbers/square-less
import mundane theorem    stdlib/numbers/product-positive
import mundane theorem    stdlib/numbers/less-scaled
import mundane theorem    stdlib/numbers/pos-int-nat

theorem irrational-between-rationals
  note        Take u = r + (s − r)·((1/2)·√2). Since 0 < (1/2)·√2 < 1, u lies between
              r and s. If u were rational, solving for √2 would write it as
              a quotient of integers with positive denominator, and √2 is
              not rational.
  let r ∈ ℚ                                                           (H1)
  let s ∈ ℚ                                                           (H2)
  assume r < s                                                        (H3)
  then there exists u ∈ ℝ such that u is irrational and r < u and u < s

1.  √2 ∈ ℝ. √2 ≥ 0. (√2)² = 2.
    def:sqrt x := 2
    requires 2 ≥ 0: arithmetic

2.  √2 is irrational
    thm:sqrt2-irrational

3.  0² < (√2)²
    calculation
      0² = 0          arithmetic
         < 2          arithmetic
         = (√2)²      1

4.  0 < √2
    mun:square-less x := 0, y := √2, from 1, 3
    requires 0 ≥ 0: arithmetic

5.  (√2)² < 2²
    calculation
      (√2)² = 2       1
            < 2²      arithmetic

6.  √2 < 2
    mun:square-less x := √2, y := 2, from 1, 5
    requires 2 ≥ 0: arithmetic

7.  0 < (1/2)·√2
    mun:product-positive x := 1/2, y := √2, from 4
    requires 1/2 > 0: arithmetic

8.  (1/2)·√2 < 1
    calculation
      (1/2)·√2 < (1/2)·2      mun:less-scaled x := √2, y := 2, c := 1/2, from 6
               = 1            arithmetic
    requires 1/2 > 0: arithmetic

9.  0 < s − r
    inequalities
      r < s           H3
      0 < s − r       adding −r

let u = r + (s − r)·((1/2)·√2), a real number                             (D1)
    membership, from 1
    reads the point half of √2 of the way from r to s

10. (s − r)·((1/2)·√2) > 0
    mun:product-positive x := s − r, y := (1/2)·√2, from 7, 9

11. r + (s − r)·((1/2)·√2) > r
    inequalities
      (s − r)·((1/2)·√2) > 0          10
      r + (s − r)·((1/2)·√2) > r      adding r

12. r < u
    transitivity, from 11, D1

13. (s − r)·((1/2)·√2) < (s − r)·1
    mun:less-scaled x := (1/2)·√2, y := 1, c := s − r, from 8, 9

14. r + (s − r)·((1/2)·√2) < r + (s − r)
    inequalities
      (s − r)·((1/2)·√2) < (s − r)·1          13
      r + (s − r)·((1/2)·√2) < r + (s − r)    adding r

15. r + (s − r) = s
    algebra

16. u < s
    transitivity, from D1, 14, 15

17. u ∉ ℚ
    contradiction
    suppose u ∈ ℚ                                                     (S)

    17.1.  a ∈ ℤ. b ∈ ℕ. u = a/b.
           obtain a, b: def:rational x := u, from S

    17.2.  p ∈ ℤ. q ∈ ℕ. r = p/q.
           obtain p, q: def:rational x := r

    17.3.  c ∈ ℤ. d ∈ ℕ. s = c/d.
           obtain c, d: def:rational x := s

    17.4.  s − r = c/d − r
           substitute s = c/d (line 17.3)

    17.5.  c/d − r = c/d − p/q
           substitute r = p/q (line 17.2)

    17.6.  s − r = c/d − p/q
           transitivity, from 17.4, 17.5

    17.7.  q·d > 0
           mun:product-positive x := q, y := d, from 17.2, 17.3

    17.8.  (s − r)·(q·d) > 0
           mun:product-positive x := s − r, y := q·d, from 9, 17.7

    17.9.  (c/d − p/q)·(q·d) > 0
           substitute s − r = c/d − p/q (line 17.6) into line 17.8

    17.10. (c/d − p/q)·(q·d) = c·q − p·d
           algebra

    17.11. 0 < c·q − p·d
           transitivity, from 17.9, 17.10

    let m = c·q − p·d, a positive integer                             (D2)
           mun:pos-int-nat m := c·q − p·d, from 17.11
           reads the numerator of s − r over the common denominator q·d

    17.12. u − r = (s − r)·((1/2)·√2)
           algebra, from D1

    17.13. a/b − p/q = (c/d − p/q)·((1/2)·√2)
           substitute
             u − r = (s − r)·((1/2)·√2)              17.12
             a/b − r = (s − r)·((1/2)·√2)            substitute line 17.1
             a/b − p/q = (s − p/q)·((1/2)·√2)        substitute line 17.2
             a/b − p/q = (c/d − p/q)·((1/2)·√2)      substitute line 17.3

    17.14. (b·(c·q − p·d))·√2 = 2·d·(a·q − p·b)
           algebra, from 17.13

    17.15. (b·m)·√2 = 2·d·(a·q − p·b)
           substitute c·q − p·d = m (D2) into line 17.14

    17.16. √2 = (2·d·(a·q − p·b))/(b·m)
           algebra, from 17.15

    17.17. √2 ∈ ℚ
           def:rational x := √2, from 17.16

    17.18. √2 ∉ ℚ
           def:irrational x := √2, from 2, contradicting 17.17

18. u is irrational
    def:irrational x := u, from 17

19. there exists u ∈ ℝ such that u is irrational and r < u and u < s
    exhibit, from 12, 16, 18
