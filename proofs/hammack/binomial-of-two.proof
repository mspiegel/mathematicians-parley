import definition         stdlib/counting/C
import theorem            stdlib/counting/pascal
import theorem            proofs/hammack/binomial-of-one/binomial-of-one
import mundane theorem    stdlib/counting/binomial-nat0

theorem binomial-of-two
  note        By induction on j: C(0, 2) is 0, and Pascal's rule gives
              C(j + 1, 2) = C(j, 2) + C(j, 1) = C(j, 2) + j, so twice it is
              j·(j − 1) + 2j = (j + 1)·j.
  let m ∈ ℕ₀                                                          (H1)
  then 2·C(m, 2) = m·(m − 1)

1.  For all j ∈ ℕ₀, 2·C(j, 2) = j·(j − 1).
    induction on j starting at 0

    base
    1.1.  0 < 2
          arithmetic

    1.2.  C(0, 2) = 0
          def:C n := 0, k := 2, from 1.1

    1.3.  2·C(0, 2) = 2·0
          substitute C(0, 2) = 0 (line 1.2)

    1.4.  2·C(0, 2) = 0·(0 − 1)
          calculation
            2·C(0, 2) = 2·0         1.3
                      = 0·(0 − 1)   arithmetic

    step
    let j ∈ ℕ₀                                                        (K)
    assume step 1 is true for j, the induction hypothesis             (IH)

    1.5.  C(j, 2) + C(j, 2 − 1) = C(j + 1, 2)
          thm:pascal n := j, k := 2

    1.6.  C(j, 2) + C(j, 1) = C(j + 1, 2)
          substitute 2 − 1 = 1 (arithmetic) into line 1.5

    1.7.  C(j, 1) = j
          thm:binomial-of-one m := j

    1.8.  2·C(j + 1, 2) = (j + 1)·((j + 1) − 1)
          algebra, from IH, 1.6, 1.7
          requires C(j, 2) ∈ ℕ₀: mun:binomial-nat0 n := j, k := 2

2.  2·C(m, 2) = m·(m − 1)
    instantiate j := m in line 1
