import definition         stdlib/divisibility/divides
import mundane theorem    stdlib/divisibility/divides-combination
import mundane theorem    stdlib/divisibility/divides-one

theorem no-integer-combination
  note        3 divides 21 and 30, so it divides 21a + 30b for any integers;
              if that were 1, 3 would divide 1 and be 1.
  then there are no a, b ∈ ℤ with 21a + 30b = 1

1.  there are no a, b ∈ ℤ with 21a + 30b = 1
    contradiction
    suppose there are a, b ∈ ℤ with 21a + 30b = 1                     (S)

    1.1.  a ∈ ℤ. b ∈ ℤ. 21a + 30b = 1.
          obtain a, b from S

    1.2.  3 divides 21
          def:divides d := 3, n := 21
          requires 21 = 3·7: arithmetic

    1.3.  3 divides 30
          def:divides d := 3, n := 30
          requires 30 = 3·10: arithmetic

    1.4.  3 divides 21a + 30b
          mun:divides-combination e := 3, a := 21, b := 30, x := a, y := b, from 1.2, 1.3

    1.5.  3 divides 1
          substitute 21a + 30b = 1 (line 1.1) into line 1.4

    1.6.  3 = 1, which is impossible
          mun:divides-one d := 3, from 1.5
