import definition         stdlib/divisibility/gcd
import mundane theorem    stdlib/divisibility/mod-multiple
import theorem            stdlib/divisibility/gcd-mod

theorem gcd-minus-second-natural
  note        The exercise for b a natural number. Taking a away a whole
              number of b's changes no remainder on division by b, and the
              gcd is the gcd of the remainder and b.
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℕ                                                           (H2)
  then gcd(a, b) = gcd(a − b, b)

1.  ((−1)·b + a) mod b = a mod b
    mun:mod-multiple r := a, m := b, q := −1

2.  (a − b) mod b = a mod b
    substitute
      ((−1)·b + a) mod b = a mod b      1
      (a − b) mod b = a mod b           algebra

3.  gcd(a, b) = gcd(a − b, b)
    calculation
      gcd(a, b) = gcd(a mod b, b)           thm:gcd-mod
                = gcd((a − b) mod b, b)     substitute line 2
                = gcd(a − b, b)             thm:gcd-mod a := a − b
