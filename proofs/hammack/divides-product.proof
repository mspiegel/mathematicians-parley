import definition         stdlib/divisibility/divides

theorem divides-product
  note        With b = a·k and d = c·m, b·d is (a·c)·(k·m).
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  let c ∈ ℤ                                                           (H3)
  let d ∈ ℤ                                                           (H4)
  assume a divides b                                                  (H5)
  assume c divides d                                                  (H6)
  then a·c divides b·d

1.  k ∈ ℤ. b = a·k.
    obtain k: def:divides, from H5

2.  m ∈ ℤ. d = c·m.
    obtain m: def:divides d := c, n := d, from H6

3.  b·d = (a·c)·(k·m)
    calculation
      b·d = (a·k)·d           substitute line 1
          = (a·k)·(c·m)       substitute line 2
          = (a·c)·(k·m)       algebra

4.  a·c divides b·d
    def:divides d := a·c, n := b·d, from 3
