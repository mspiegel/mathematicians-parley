import mundane definition stdlib/divisibility/divides

theorem divides-product
  note        With b = a·k and d = c·m, b·d is (a·c)·(k·m).
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  let c ∈ ℤ                                                           (H3)
  let d ∈ ℤ                                                           (H4)
  assume a divides b                                                  (H5)
  assume c divides d                                                  (H6)
  then a·c divides b·d

1.  k ∈ ℤ. b = a·k.
    obtain k: mun:divides, from H5

2.  m ∈ ℤ. d = c·m.
    obtain m: mun:divides d := c, n := d, from H6

3.  b·d = (a·k)·d
    substitute b = a·k (line 1)

4.  (a·k)·d = (a·k)·(c·m)
    substitute d = c·m (line 2)

5.  (a·k)·(c·m) = (a·c)·(k·m)
    algebra

6.  b·d = (a·c)·(k·m)
    calculation
      b·d = (a·k)·d           3
          = (a·k)·(c·m)       4
          = (a·c)·(k·m)       5

7.  a·c divides b·d
    mun:divides d := a·c, n := b·d, from 6
