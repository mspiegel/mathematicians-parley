import theorem            proofs/wiedijk/sqrt2-irrational/even-square
import definition         stdlib/divisibility/even
import mundane theorem    stdlib/divisibility/not-both

theorem square-minus-four-b-minus-two
  note        If a² = 4b + 2 then a² is even, so a is even, a = 2k, and
              4k² = 4b + 2 makes 1 = 2(k² − b) even, which it is not.
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  then a² − 4b − 2 ≠ 0
  by          contradiction

suppose a² − 4b − 2 = 0                                               (S)

1.  a² = 4b + 2
    algebra, from S

2.  a² = 2(2b + 1)
    algebra, from 1

3.  a² is even
    def:even n := a², from 2

4.  a is even
    thm:even-square n := a, from 3

5.  k ∈ ℤ. a = 2k.
    obtain k: def:even n := a, from 4

6.  4k² = 4b + 2
    calculation
      4k² = (2k)²     algebra
          = a²        substitute line 5
          = 4b + 2    1

7.  1 = 2(k² − b)
    algebra, from 6

8.  1 is even
    def:even n := 1, from 7

9.  1 is not odd
    mun:not-both n := 1, from 8

10. 1 is odd
    arithmetic, contradicting 9
