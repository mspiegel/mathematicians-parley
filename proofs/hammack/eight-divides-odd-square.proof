import definition         stdlib/divisibility/divides
import definition         stdlib/divisibility/even
import mundane theorem    stdlib/divisibility/even-or-odd
import definition         stdlib/divisibility/odd

theorem eight-divides-odd-square
  note        Write n = 2k + 1, so n² − 1 = 4k(k + 1). Either k is even, k = 2j,
              or k is odd, k = 2j + 1; either way a second factor 2 appears.
  let n ∈ ℤ                                                           (H1)
  assume n is odd                                                     (H2)
  then 8 divides n² − 1

1.  k ∈ ℤ. n = 2k + 1.
    obtain k: def:odd, from H2

2.  n² − 1 = 4·(k·(k + 1))
    calculation
      n² − 1 = (2k + 1)² − 1       substitute line 1
             = 4·(k·(k + 1))       algebra

3.  k is even or k is odd
    mun:even-or-odd n := k

4.  8 divides n² − 1
    cases, from 3

    case
    assume k is even                                                  (C1)

    4.1.  j ∈ ℤ. k = 2j.
          obtain j: def:even n := k, from C1

    4.2.  n² − 1 = 4·(2j·(2j + 1))
          substitute k = 2j (line 4.1) into line 2

    4.3.  n² − 1 = 8·(j·(2j + 1))
          calculation
            n² − 1 = 4·(2j·(2j + 1))       4.2
                   = 8·(j·(2j + 1))        algebra

    4.4.  8 divides n² − 1
          def:divides d := 8, n := n² − 1, from 4.3

    case
    assume k is odd                                                   (C2)

    4.5.  j ∈ ℤ. k = 2j + 1.
          obtain j: def:odd n := k, from C2

    4.6.  n² − 1 = 4·((2j + 1)·((2j + 1) + 1))
          substitute k = 2j + 1 (line 4.5) into line 2

    4.7.  n² − 1 = 8·((2j + 1)·(j + 1))
          calculation
            n² − 1 = 4·((2j + 1)·((2j + 1) + 1))       4.6
                   = 8·((2j + 1)·(j + 1))              algebra

    4.8.  8 divides n² − 1
          def:divides d := 8, n := n² − 1, from 4.7
