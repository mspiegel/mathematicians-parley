import mundane definition stdlib/functions/set-image
import mundane definition stdlib/sets/intersection
import mundane definition stdlib/sets/subset
import mundane theorem    stdlib/sets/subset-antisymmetric

theorem multiples-of-six
  note        A multiple of 6 is a multiple of 2 and of 3. Conversely, if
              t = 2a and t = 3b then t = 3t − 2t = 6a − 6b = 6(a − b).
  then {6n : n ∈ ℤ} = {2n : n ∈ ℤ} ∩ {3n : n ∈ ℤ}

1.  For all t ∈ {6n : n ∈ ℤ}, t ∈ {2n : n ∈ ℤ} ∩ {3n : n ∈ ℤ}.
    proof
    let t ∈ {6n : n ∈ ℤ}                                              (K1)

    1.1.  There is n ∈ ℤ with t = 6n.
          mun:set-image u := t, from K1

    1.2.  m ∈ ℤ. t = 6m.
          obtain m from line 1.1

    1.3.  t = 2·(3m)
          algebra, from 1.2
          requires t ∈ ℝ: membership, from 1.2

    1.4.  There is n ∈ ℤ with t = 2n.
          exhibit, from 1.3

    1.5.  t ∈ {2n : n ∈ ℤ}
          mun:set-image u := t, from 1.4

    1.6.  t = 3·(2m)
          algebra, from 1.2
          requires t ∈ ℝ: membership, from 1.2

    1.7.  There is n ∈ ℤ with t = 3n.
          exhibit, from 1.6

    1.8.  t ∈ {3n : n ∈ ℤ}
          mun:set-image u := t, from 1.7

    1.9.  t ∈ {2n : n ∈ ℤ} ∩ {3n : n ∈ ℤ}
          mun:intersection u := t, from 1.5, 1.8

2.  {6n : n ∈ ℤ} ⊆ {2n : n ∈ ℤ} ∩ {3n : n ∈ ℤ}
    mun:subset, from 1

3.  For all t ∈ {2n : n ∈ ℤ} ∩ {3n : n ∈ ℤ}, t ∈ {6n : n ∈ ℤ}.
    proof
    let t ∈ {2n : n ∈ ℤ} ∩ {3n : n ∈ ℤ}                               (K2)

    3.1.  t ∈ {2n : n ∈ ℤ}
          mun:intersection u := t, from K2

    3.2.  t ∈ {3n : n ∈ ℤ}
          mun:intersection u := t, from K2

    3.3.  There is n ∈ ℤ with t = 2n.
          mun:set-image u := t, from 3.1

    3.4.  a ∈ ℤ. t = 2a.
          obtain a from line 3.3

    3.5.  There is n ∈ ℤ with t = 3n.
          mun:set-image u := t, from 3.2

    3.6.  b ∈ ℤ. t = 3b.
          obtain b from line 3.5

    3.7.  6·a = 3·t
          algebra, from 3.4
          requires t ∈ ℝ: membership, from 3.4

    3.8.  6·b = 2·t
          algebra, from 3.6
          requires t ∈ ℝ: membership, from 3.6

    3.9.  t = 3·t − 2·t
          algebra
          requires t ∈ ℝ: membership, from 3.4

    3.10. t = 6·a − 2·t
          substitute 6·a = 3·t (line 3.7) into line 3.9

    3.11. t = 6·a − 6·b
          substitute 6·b = 2·t (line 3.8) into line 3.10

    3.12. 6·a − 6·b = 6·(a − b)
          algebra

    3.13. t = 6·(a − b)
          calculation
            t = 6·a − 6·b       3.11
              = 6·(a − b)       3.12

    3.14. There is n ∈ ℤ with t = 6n.
          exhibit, from 3.13

    3.15. t ∈ {6n : n ∈ ℤ}
          mun:set-image u := t, from 3.14

4.  {2n : n ∈ ℤ} ∩ {3n : n ∈ ℤ} ⊆ {6n : n ∈ ℤ}
    mun:subset, from 3

5.  {6n : n ∈ ℤ} = {2n : n ∈ ℤ} ∩ {3n : n ∈ ℤ}
    mun:subset-antisymmetric, from 2, 4
