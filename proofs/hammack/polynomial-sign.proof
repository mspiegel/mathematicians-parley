import mundane theorem    stdlib/numbers/product-nonneg
import mundane theorem    stdlib/numbers/square-nonneg

theorem negative-powers
  note        For x below 0, −x is at least 0, and x² is at least 0, so the
              products x²·(−x) and x⁴·(−x) are at least 0; they are −x³ and
              −x⁵. And x⁴ is the square of x².
  let x ∈ ℝ                                                           (H1)
  assume x < 0                                                        (H2)
  then x² ≥ 0. x³ ≤ 0. x⁴ ≥ 0. x⁵ ≤ 0.

1.  −x ≥ 0
    inequalities
      x < 0         H2
      −x > 0        multiplying by −1
      −x ≥ 0        weakening

2.  x² ≥ 0
    mun:square-nonneg

3.  x²·(−x) ≥ 0
    mun:product-nonneg x := x², y := −x, from 1, 2

4.  x³ ≤ 0
    inequalities
      x²·(−x) ≥ 0     3
      −x³ ≥ 0         algebra
      x³ ≤ 0          multiplying by −1

5.  (x²)² ≥ 0
    mun:square-nonneg x := x²

6.  x⁴ = (x²)²
    algebra

7.  x⁴ ≥ 0
    transitivity, from 6, 5

8.  x⁴·(−x) ≥ 0
    mun:product-nonneg x := x⁴, y := −x, from 1, 7

9.  x⁵ ≤ 0
    inequalities
      x⁴·(−x) ≥ 0     8
      −x⁵ ≥ 0         algebra
      x⁵ ≤ 0          multiplying by −1

10. x² ≥ 0. x³ ≤ 0. x⁴ ≥ 0. x⁵ ≤ 0.
    join 2, 4, 7, 9

theorem quintic-five
  note        For x below 0, every term of x⁵ − 4x⁴ + 3x³ − x² + 3x − 4 is
              at most 0 and the last, −4, is below 0, so the sum is below 0.
  let x ∈ ℝ                                                           (H1)
  assume x⁵ − 4x⁴ + 3x³ − x² + 3x − 4 ≥ 0                             (H2)
  then x ≥ 0

1.  x ≥ 0
    contradiction
    suppose not x ≥ 0                                                 (S)

    1.1.  x < 0
          inequalities, from S

    1.2.  x² ≥ 0. x³ ≤ 0. x⁴ ≥ 0. x⁵ ≤ 0.
          thm:negative-powers, from 1.1

    1.3.  −4·x⁴ ≤ 0
          inequalities
            x⁴ ≥ 0          1.2
            −4·x⁴ ≤ 0       multiplying by −4

    1.4.  3·x³ ≤ 0
          inequalities
            x³ ≤ 0          1.2
            3·x³ ≤ 0        multiplying by 3

    1.5.  −x² ≤ 0
          inequalities
            x² ≥ 0          1.2
            −x² ≤ 0         multiplying by −1

    1.6.  3·x < 0
          inequalities
            x < 0           1.1
            3·x < 0         multiplying by 3

    1.7.  x⁵ − 4x⁴ + 3x³ − x² + 3x − 4 < 0
          inequalities, from 1.2, 1.3, 1.4, 1.5, 1.6

    1.8.  not x⁵ − 4x⁴ + 3x³ − x² + 3x − 4 ≥ 0
          inequalities, from 1.7, contradicting H2

theorem quintic-six
  note        For x below 0, x⁵, 7x³ and 5x are at most 0, and 5x is below
              0, so the left side is below 0; x⁴ and x² are at least 0, so
              the right side is at least 8.
  let x ∈ ℝ                                                           (H1)
  assume x⁵ + 7x³ + 5x ≥ x⁴ + x² + 8                                 (H2)
  then x ≥ 0

1.  x ≥ 0
    contradiction
    suppose not x ≥ 0                                                 (S)

    1.1.  x < 0
          inequalities, from S

    1.2.  x² ≥ 0. x³ ≤ 0. x⁴ ≥ 0. x⁵ ≤ 0.
          thm:negative-powers, from 1.1

    1.3.  7·x³ ≤ 0
          inequalities
            x³ ≤ 0          1.2
            7·x³ ≤ 0        multiplying by 7

    1.4.  5·x < 0
          inequalities
            x < 0           1.1
            5·x < 0         multiplying by 5

    1.5.  x⁵ + 7x³ + 5x < x⁴ + x² + 8
          inequalities, from 1.2, 1.3, 1.4

    1.6.  not x⁵ + 7x³ + 5x ≥ x⁴ + x² + 8
          inequalities, from 1.5, contradicting H2
