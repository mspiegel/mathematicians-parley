import definition         stdlib/sets/intersection
import definition         stdlib/sets/subset
import definition         stdlib/sets/union
import mundane theorem    stdlib/sets/in-union-left
import mundane theorem    stdlib/sets/in-union-right
import mundane theorem    stdlib/sets/subset-antisymmetric

theorem union-distributes-over-intersection
  note        An element of A ∪ (B ∩ C) is in A, or in both B and C; either
              way it is in A ∪ B and in A ∪ C. Conversely an element of both
              unions is in A, or else in B and in C.
  let A be a set                                                      (H1)
  let B be a set                                                      (H2)
  let C be a set                                                      (H3)
  then A ∪ (B ∩ C) = (A ∪ B) ∩ (A ∪ C)

1.  For all t ∈ A ∪ (B ∩ C), t ∈ (A ∪ B) ∩ (A ∪ C).
    proof
    let t ∈ A ∪ (B ∩ C)                                               (K1)

    1.1.  t ∈ A or t ∈ B ∩ C
          def:union u := t, Y := A, Z := B ∩ C, from K1

    1.2.  t ∈ (A ∪ B) ∩ (A ∪ C)
          cases, from 1.1

          case
          assume t ∈ A                                                (C1)

          1.2.1.  t ∈ A ∪ B
                  mun:in-union-left u := t, Y := A, Z := B, from C1

          1.2.2.  t ∈ A ∪ C
                  mun:in-union-left u := t, Y := A, Z := C, from C1

          1.2.3.  t ∈ (A ∪ B) ∩ (A ∪ C)
                  def:intersection u := t, Y := A ∪ B, Z := A ∪ C, from 1.2.1, 1.2.2

          case
          assume t ∈ B ∩ C                                            (C2)

          1.2.4.  t ∈ B. t ∈ C.
                  def:intersection u := t, Y := B, Z := C, from C2

          1.2.5.  t ∈ A ∪ B
                  mun:in-union-right u := t, Y := A, Z := B, from 1.2.4

          1.2.6.  t ∈ A ∪ C
                  mun:in-union-right u := t, Y := A, Z := C, from 1.2.4

          1.2.7.  t ∈ (A ∪ B) ∩ (A ∪ C)
                  def:intersection u := t, Y := A ∪ B, Z := A ∪ C, from 1.2.5, 1.2.6

2.  A ∪ (B ∩ C) ⊆ (A ∪ B) ∩ (A ∪ C)
    def:subset, from 1

3.  For all t ∈ (A ∪ B) ∩ (A ∪ C), t ∈ A ∪ (B ∩ C).
    proof
    let t ∈ (A ∪ B) ∩ (A ∪ C)                                         (K2)

    3.1.  t ∈ A ∪ B. t ∈ A ∪ C.
          def:intersection u := t, Y := A ∪ B, Z := A ∪ C, from K2

    3.2.  t ∈ A or t ∈ B
          def:union u := t, Y := A, Z := B, from 3.1

    3.3.  t ∈ A or t ∈ C
          def:union u := t, Y := A, Z := C, from 3.1

    3.4.  t ∈ A ∪ (B ∩ C)
          cases, from 3.2

          case
          assume t ∈ A                                                (C3)

          3.4.1.  t ∈ A ∪ (B ∩ C)
                  mun:in-union-left u := t, Y := A, Z := B ∩ C, from C3

          case
          assume t ∈ B                                                (C4)

          3.4.2.  t ∈ A ∪ (B ∩ C)
                  cases, from 3.3

                  case
                  assume t ∈ A                                        (C5)

                  3.4.2.1.  t ∈ A ∪ (B ∩ C)
                            mun:in-union-left u := t, Y := A, Z := B ∩ C, from C5

                  case
                  assume t ∈ C                                        (C6)

                  3.4.2.2.  t ∈ B ∩ C
                            def:intersection u := t, Y := B, Z := C, from C4, C6

                  3.4.2.3.  t ∈ A ∪ (B ∩ C)
                            mun:in-union-right u := t, Y := A, Z := B ∩ C, from 3.4.2.2

4.  (A ∪ B) ∩ (A ∪ C) ⊆ A ∪ (B ∩ C)
    def:subset, from 3

5.  A ∪ (B ∩ C) = (A ∪ B) ∩ (A ∪ C)
    mun:subset-antisymmetric, from 2, 4
