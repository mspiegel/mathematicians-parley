import definition         stdlib/functions/image
import mundane theorem    stdlib/functions/value-in-image
import definition         stdlib/sets/intersection
import definition         stdlib/sets/subset
import mundane theorem    stdlib/sets/in-subset

theorem image-of-intersection-within
  note        A point of f[W ∩ X] is f(s) for an s in both W and X, so it is
              in f[W] and in f[X].
  let A be a set                                                      (H1)
  let B be a set                                                      (H2)
  let f : A → B                                                       (H3)
  let W ⊆ A                                                           (H4)
  let X ⊆ A                                                           (H5)
  then f[W ∩ X] ⊆ f[W] ∩ f[X]

1.  For all s ∈ W ∩ X, s ∈ A.
    proof
    let s ∈ W ∩ X                                                     (K1)

    1.1.  s ∈ W. s ∈ X.
          def:intersection u := s, Y := W, Z := X, from K1

    1.2.  s ∈ A
          mun:in-subset X := W, Y := A, u := s, from H4, 1.1

2.  W ∩ X ⊆ A
    def:subset, from 1

3.  For all y ∈ f[W ∩ X], y ∈ f[W] ∩ f[X].
    proof
    let y ∈ f[W ∩ X]                                                  (K2)

    3.1.  There is s ∈ W ∩ X with y = f(s).
          def:image u := y, Y := W ∩ X, from K2, 2

    3.2.  s ∈ W ∩ X. y = f(s).
          obtain s from line 3.1

    3.3.  s ∈ W. s ∈ X.
          def:intersection u := s, Y := W, Z := X, from 3.2

    3.4.  f(s) ∈ f[W]
          mun:value-in-image Y := W, from H4, 3.3

    3.5.  f(s) ∈ f[X]
          mun:value-in-image Y := X, from H5, 3.3

    3.6.  y ∈ f[W]
          substitute y = f(s) (line 3.2) into line 3.4

    3.7.  y ∈ f[X]
          substitute y = f(s) (line 3.2) into line 3.5

    3.8.  y ∈ f[W] ∩ f[X]
          def:intersection u := y, Y := f[W], Z := f[X], from 3.6, 3.7

4.  f[W ∩ X] ⊆ f[W] ∩ f[X]
    def:subset, from 3
