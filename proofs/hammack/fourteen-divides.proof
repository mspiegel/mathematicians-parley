import definition         stdlib/divisibility/divides

theorem fourteen-divides
  note        If 14 divides a, then a = 14k = 7·(2k) = 2·(7k). Conversely,
              from a = 7m and a = 2n, a = 7a − 6a = 14n − 42m = 14(n − 3m).
  let a ∈ ℤ                                                           (H1)
  then 14 divides a ↔ 7 divides a and 2 divides a
  by          both directions

direction
assume 14 divides a                                                   (D1)

1.  k ∈ ℤ. a = 14k.
    obtain k: def:divides d := 14, n := a, from D1

2.  a = 7·(2k)
    algebra, from 1

3.  7 divides a
    def:divides d := 7, n := a, from 2

4.  a = 2·(7k)
    algebra, from 1

5.  2 divides a
    def:divides d := 2, n := a, from 4

6.  7 divides a and 2 divides a
    join 3, 5

direction
assume 7 divides a and 2 divides a                                    (D2)

7.  m ∈ ℤ. a = 7m.
    obtain m: def:divides d := 7, n := a, from D2

8.  n ∈ ℤ. a = 2n.
    obtain n: def:divides d := 2, n := a, from D2

9.  a = 14(n − 3m)
    algebra, from 7, 8

10. 14 divides a
    def:divides d := 14, n := a, from 9
