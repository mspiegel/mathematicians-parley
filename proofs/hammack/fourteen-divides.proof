import mundane definition stdlib/divisibility/divides

theorem fourteen-divides
  note        If 14 divides a, then a = 14k = 7·(2k) = 2·(7k). Conversely,
              from a = 7m and a = 2n, a = 7a − 6a = 14n − 42m = 14(n − 3m).
  let a ∈ ℤ                                                           (H1)
  then 14 divides a ↔ 7 divides a and 2 divides a

1.  14 divides a ↔ 7 divides a and 2 divides a
    both directions

    direction
    assume 14 divides a                                               (D1)

    1.1.  k ∈ ℤ. a = 14k.
          obtain k: mun:divides d := 14, n := a, from D1

    1.2.  a = 7·(2k)
          algebra, from 1.1

    1.3.  7 divides a
          mun:divides d := 7, n := a, from 1.2

    1.4.  a = 2·(7k)
          algebra, from 1.1

    1.5.  2 divides a
          mun:divides d := 2, n := a, from 1.4

    1.6.  7 divides a and 2 divides a
          join 1.3, 1.5

    direction
    assume 7 divides a and 2 divides a                                (D2)

    1.7.  m ∈ ℤ. a = 7m.
          obtain m: mun:divides d := 7, n := a, from D2

    1.8.  n ∈ ℤ. a = 2n.
          obtain n: mun:divides d := 2, n := a, from D2

    1.9.  a = 14(n − 3m)
          algebra, from 1.7, 1.8

    1.10. 14 divides a
          mun:divides d := 14, n := a, from 1.9
