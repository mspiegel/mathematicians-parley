import definition         stdlib/divisibility/divides
import mundane theorem    stdlib/divisibility/divides-multiple
import mundane theorem    stdlib/divisibility/divides-sum
import mundane theorem    stdlib/numbers/exponent-sum
import mundane theorem    stdlib/numbers/power-integer
import mundane theorem    stdlib/numbers/power-real

theorem five-power-minus-one
  note        By induction on n: 5^(2n + 2) − 1 is 25·(5^(2n) − 1) + 24, and
              3 divides both parts.
  let n ∈ ℕ₀                                                          (H1)
  then 3 divides 5^(2n) − 1

1.  For all m ∈ ℕ₀, 3 divides 5^(2m) − 1.
    induction on m starting at 0

    base
    1.1.  5^(2·0) − 1 = 3·0
          arithmetic

    1.2.  3 divides 5^(2·0) − 1
          def:divides d := 3, n := 5^(2·0) − 1, from 1.1

    step
    let m ∈ ℕ₀                                                        (K)
    assume step 1 is true for m, the induction hypothesis             (IH)

    1.3.  2(m + 1) = 2m + 2
          algebra

    1.4.  5^(2(m + 1)) = 5^(2m + 2)
          substitute 2(m + 1) = 2m + 2 (line 1.3)

    1.5.  5^(2m + 2) = 5^(2m)·5^2
          mun:exponent-sum a := 5, m := 2m, n := 2

    1.6.  5^(2(m + 1)) = 5^(2m)·5^2
          calculation
            5^(2(m + 1)) = 5^(2m + 2)      1.4
                         = 5^(2m)·5^2      1.5

    1.7.  5^(2(m + 1)) − 1 = (5^(2m) − 1)·25 + 24
          algebra, from 1.6
          requires 5^(2m) ∈ ℝ: mun:power-real a := 5, m := 2m

    1.8.  3 divides (5^(2m) − 1)·25
          mun:divides-multiple e := 3, a := 5^(2m) − 1, x := 25, from IH
          requires 5^(2m) ∈ ℤ: mun:power-integer a := 5, m := 2m

    1.9.  3 divides 24
          def:divides d := 3, n := 24
          requires 24 = 3·8: arithmetic

    1.10. 3 divides (5^(2m) − 1)·25 + 24
          mun:divides-sum d := 3, a := (5^(2m) − 1)·25, b := 24, from 1.8, 1.9
          requires 5^(2m) ∈ ℤ: mun:power-integer a := 5, m := 2m

    1.11. 3 divides 5^(2(m + 1)) − 1
          substitute 5^(2(m + 1)) − 1 = (5^(2m) − 1)·25 + 24 (line 1.7) into line 1.10

2.  3 divides 5^(2n) − 1
    instantiate m := n in line 1
