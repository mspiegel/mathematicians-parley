import mundane definition stdlib/functions/set-image
import mundane definition stdlib/sets/subset
import mundane theorem    stdlib/numbers/exponent-negative
import mundane theorem    stdlib/numbers/exponent-step
import mundane theorem    stdlib/numbers/exponent-sum-integer
import mundane theorem    stdlib/numbers/integer-step
import mundane theorem    stdlib/numbers/nat0-as-int
import mundane theorem    stdlib/numbers/nonneg-or-neg
import mundane theorem    stdlib/numbers/power-cancel
import mundane theorem    stdlib/numbers/power-positive
import mundane theorem    stdlib/numbers/power-real

theorem nine-power-from-zero
  note        By induction on n from 0: 9^(k + 1) is 9^k·9, which is
              3^k·3^k·9, and 3^(k + 1) is 3^k·3.
  let n ∈ ℕ₀                                                          (H1)
  then 9^n = 3^n·3^n

1.  For all k ∈ ℕ₀, 9^k = 3^k·3^k.
    induction on k starting at 0

    base
    1.1.  9^0 = 3^0·3^0
          arithmetic

    step
    let k ∈ ℕ₀                                                        (K)
    assume step 1 is true for k, the induction hypothesis             (IH)

    1.2.  9^(k + 1) = 9^k·9
          mun:exponent-step a := 9, m := k

    1.3.  3^(k + 1) = 3^k·3
          mun:exponent-step a := 3, m := k

    1.4.  9^(k + 1) = 3^(k + 1)·3^(k + 1)
          algebra, from IH, 1.2, 1.3

2.  9^n = 3^n·3^n
    instantiate k := n in line 1


theorem positive-power-is-real
  note        For m ≥ 0 this is the library's fact for a natural exponent.
              For m < 0 the power is the reciprocal of the power of −m, which
              is real and above zero.
  let a ∈ ℝ                                                           (H1)
  let m ∈ ℤ                                                           (H2)
  assume a > 0                                                        (H3)
  then a^m ∈ ℝ

1.  m ≥ 0 or m < 0
    mun:nonneg-or-neg x := m

2.  a^m ∈ ℝ
    cases, from 1

    case
    assume m ≥ 0                                                      (C1)

    2.1.  m ∈ ℕ₀
          mun:nat0-as-int
          requires 0 ≤ m: from C1

    2.2.  a^m ∈ ℝ
          mun:power-real, from 2.1

    case
    assume m < 0                                                      (C2)

    2.3.  −m > 0
          inequalities
            m < 0        C2
            −m > 0       multiplying by −1

    2.4.  −m ∈ ℕ₀
          mun:nat0-as-int
          requires −m ≥ 0: weakening, from 2.3

    2.5.  a^(−m) ∈ ℝ
          mun:power-real m := −m, from 2.4

    2.6.  a^(−m) > 0
          mun:power-positive m := −m, from H3

    2.7.  a^(−(−m)) = 1/a^(−m)
          mun:exponent-negative m := −m
          requires a ≠ 0: weakening, from H3

    2.8.  −(−m) = m
          algebra

    2.9.  a^m = 1/a^(−m)
          substitute −(−m) = m (line 2.8) into line 2.7

    2.10.  a^m ∈ ℝ
           membership, from 2.5, 2.6, 2.9


theorem nine-power-is-three-power
  note        For m ≥ 0 this is the lemma and 3^(m + m) = 3^m·3^m. For
              m < 0 the same holds for −m, and a negative power is the
              reciprocal of the power of −m.
  let m ∈ ℤ                                                           (H1)
  then 9^m = 3^(2m)

1.  m ≥ 0 or m < 0
    mun:nonneg-or-neg x := m

2.  3^(m + m) = 3^m·3^m
    mun:exponent-sum-integer a := 3, n := m
    requires 3 ≠ 0: arithmetic

3.  m + m = 2m
    algebra

4.  3^(2m) = 3^m·3^m
    substitute m + m = 2m (line 3) into line 2

5.  9^m = 3^m·3^m
    cases, from 1

    case
    assume m ≥ 0                                                      (C1)

    5.1.  m ∈ ℕ₀
          mun:nat0-as-int
          requires 0 ≤ m: from C1

    5.2.  9^m = 3^m·3^m
          thm:nine-power-from-zero n := m, from 5.1

    case
    assume m < 0                                                      (C2)

    5.3.  −m > 0
          inequalities
            m < 0        C2
            −m > 0       multiplying by −1

    5.4.  −m ∈ ℕ₀
          mun:nat0-as-int
          requires −m ≥ 0: weakening, from 5.3

    5.5.  9^(−m) = 3^(−m)·3^(−m)
          thm:nine-power-from-zero n := −m, from 5.4

    5.6.  9^(−m) = 1/9^m
          mun:exponent-negative a := 9
          requires 9 ≠ 0: arithmetic

    5.7.  3^(−m) = 1/3^m
          mun:exponent-negative a := 3
          requires 3 ≠ 0: arithmetic

    5.8.  9^m ∈ ℝ
          thm:positive-power-is-real a := 9
          requires 9 > 0: arithmetic

    5.9.  3^m ∈ ℝ
          thm:positive-power-is-real a := 3
          requires 3 > 0: arithmetic

    5.10.  9^m > 0
           mun:power-positive a := 9
           requires 0 < 9: arithmetic

    5.11.  3^m > 0
           mun:power-positive a := 3
           requires 0 < 3: arithmetic

    5.12.  1/9^m = 3^(−m)·3^(−m)
           substitute 9^(−m) = 1/9^m (line 5.6) into line 5.5

    5.13.  1/9^m = 1/3^m·(1/3^m)
           substitute 3^(−m) = 1/3^m (line 5.7) into line 5.12

    5.14.  9^m ≠ 0
           inequalities
             9^m > 0      5.10
             9^m ≠ 0      weakening
           requires 9^m ∈ ℝ: from 5.8

    5.15.  3^m ≠ 0
           inequalities
             3^m > 0      5.11
             3^m ≠ 0      weakening
           requires 3^m ∈ ℝ: from 5.9

    5.16.  9^m = 3^m·3^m
           algebra, from 5.8, 5.9, 5.13
           requires 9^m ≠ 0: from 5.14
           requires 3^m ≠ 0: from 5.15

6.  3^m ∈ ℝ
    thm:positive-power-is-real a := 3
    requires 3 > 0: arithmetic

7.  9^m = 3^(2m)
    algebra, from 4, 5, 6


theorem powers-of-nine-in-powers-of-three
  note        9^m is 3^(2m). And 3 is a power of 3, but 3 = 9^m would give
              1 = 2m, which no integer satisfies.
  then {9^n : n ∈ ℤ} ⊆ {3^n : n ∈ ℤ} and {9^n : n ∈ ℤ} ≠ {3^n : n ∈ ℤ}

1.  For all t ∈ {9^n : n ∈ ℤ}, t ∈ {3^n : n ∈ ℤ}.
    proof
    let t ∈ {9^n : n ∈ ℤ}                                             (K1)

    1.1.  There is n ∈ ℤ with t = 9^n.
          mun:set-image u := t, from K1

    1.2.  m ∈ ℤ. t = 9^m.
          obtain m from line 1.1

    1.3.  9^m = 3^(2m)
          thm:nine-power-is-three-power

    1.4.  t = 3^(2m)
          calculation
            t = 9^m        1.2
              = 3^(2m)     1.3

    1.5.  There is n ∈ ℤ with t = 3^n.
          exhibit, from 1.4

    1.6.  t ∈ {3^n : n ∈ ℤ}
          mun:set-image u := t, from 1.5

2.  {9^n : n ∈ ℤ} ⊆ {3^n : n ∈ ℤ}
    mun:subset, from 1

3.  3 ∉ {9^n : n ∈ ℤ}
    contradiction
    suppose 3 ∈ {9^n : n ∈ ℤ}                                         (S1)

    3.1.  There is n ∈ ℤ with 3 = 9^n.
          mun:set-image u := 3, from S1

    3.2.  m ∈ ℤ. 3 = 9^m.
          obtain m from line 3.1

    3.3.  9^m = 3^(2m)
          thm:nine-power-is-three-power

    3.4.  3^1 = 3
          arithmetic

    3.5.  3^1 = 3^(2m)
          calculation
            3^1 = 3          3.4
                = 9^m        3.2
                = 3^(2m)     3.3

    3.6.  1 = 2m
          mun:power-cancel a := 3, m := 1, n := 2m, from 3.5
          requires 3 > 1: arithmetic

    3.7.  m = 1/2
          algebra, from 3.6

    3.8.  1/2 ≤ m
          inequalities
            m = 1/2        3.7
            1/2 = m        restate
            1/2 ≤ m        weakening

    3.9.  0 < m
          inequalities, from 3.8

    3.10.  0 + 1 ≤ m
           mun:integer-step m := 0, n := m, from 3.9

    3.11.  2 ≤ 2m
           inequalities
             0 + 1 ≤ m      3.10
             1 ≤ m          algebra
             2 ≤ 2m         multiplying by 2

    3.12.  1 < 2m
           inequalities, from 3.11

    3.13.  1 ≠ 2m
           inequalities, contradicting 3.6
             1 < 2m         3.12
             1 ≠ 2m         weakening

4.  {9^n : n ∈ ℤ} ≠ {3^n : n ∈ ℤ}
    contradiction
    suppose {9^n : n ∈ ℤ} = {3^n : n ∈ ℤ}                             (S2)

    4.1.  3 = 3^1
          arithmetic

    4.2.  There is n ∈ ℤ with 3 = 3^n.
          exhibit, from 4.1

    4.3.  3 ∈ {3^n : n ∈ ℤ}
          mun:set-image u := 3, from 4.2

    4.4.  3 ∈ {9^n : n ∈ ℤ}
          substitute {9^n : n ∈ ℤ} = {3^n : n ∈ ℤ} (S2) into line 4.3, contradicting 3

5.  {9^n : n ∈ ℤ} ⊆ {3^n : n ∈ ℤ} and {9^n : n ∈ ℤ} ≠ {3^n : n ∈ ℤ}
    join 2, 4
