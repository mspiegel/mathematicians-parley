import mundane theorem    stdlib/numbers/exponent-step
import mundane theorem    stdlib/numbers/power-nat
import mundane theorem    stdlib/numbers/reciprocal-order
import mundane theorem    stdlib/numbers/reciprocal-positive
import mundane theorem    stdlib/sums/product-extended
import mundane theorem    stdlib/sums/product-real
import mundane theorem    stdlib/sums/product-single
import theorem            proofs/hammack/product-step-bound/product-step-bound

theorem power-of-two-at-least-four
  note        2^2 is 4, and each step up doubles the power.
  let m ∈ ℕ                                                           (H1)
  then 2^(m + 1) ≥ 4

1.  For all k ∈ ℕ, 2^(k + 1) ≥ 4.
    induction on k starting at 1

    base
    1.1.  2^(1 + 1) ≥ 4
          arithmetic

    step
    let k ∈ ℕ                                                         (K)
    assume step 1 is true for k, the induction hypothesis             (IH)

    1.2.  2^(k + 1 + 1) = 2^(k + 1)·2
          mun:exponent-step a := 2, m := k + 1

    1.3.  2^(k + 1) ∈ ℕ
          mun:power-nat a := 2, m := k + 1

    1.4.  2^(k + 1) ≥ 0
          inequalities, from 1.3

    1.5.  2^(k + 1) + 2^(k + 1) ≥ 4
          inequalities, from IH, 1.4
          requires 2^(k + 1) ∈ ℝ: from 1.3

    1.6.  2^(k + 1)·2 = 2^(k + 1) + 2^(k + 1)
          algebra
          requires 2^(k + 1) ∈ ℝ: from 1.3

    1.7.  2^(k + 1 + 1) ≥ 4
          calculation
            2^(k + 1 + 1) = 2^(k + 1)·2                 1.2
                          = 2^(k + 1) + 2^(k + 1)       1.6
                          ≥ 4                           1.5

2.  2^(m + 1) ≥ 4
    instantiate k := m in line 1

theorem product-of-one-minus-halves
  note        Book of Proof 10.22: (1 − 1/2)(1 − 1/4)···(1 − 1/2^n) is at
              least 1/4 + 1/2^(n + 1). By induction from 1: the next factor
              1 − t, with t = 1/2^(m + 1) at most 1/4, takes a product at
              least 1/4 + t to at least 1/4 + t/2 (product-step-bound).
  let n ∈ ℕ                                                           (H1)
  then ∏(k ∈ {1, …, n}) (1 − 1/2^k) ≥ 1/4 + 1/2^(n + 1)

1.  For all k ∈ ℕ, 1 − 1/2^k ∈ ℝ.
    proof
    let k ∈ ℕ                                                         (K1)

    1.1.  1 − 1/2^k ∈ ℝ
          membership

2.  For all m ∈ ℕ, ∏(k ∈ {1, …, m}) (1 − 1/2^k) ≥ 1/4 + 1/2^(m + 1).
    induction on m starting at 1

    base
    2.1.  ∏(k ∈ {1, …, 1}) (1 − 1/2^k) = 1 − 1/2^1
          mun:product-single a := 1, from 1

    2.2.  1 − 1/2^1 ≥ 1/4 + 1/2^(1 + 1)
          arithmetic

    2.3.  ∏(k ∈ {1, …, 1}) (1 − 1/2^k) ≥ 1/4 + 1/2^(1 + 1)
          calculation
            ∏(k ∈ {1, …, 1}) (1 − 1/2^k) = 1 − 1/2^1              2.1
                                         ≥ 1/4 + 1/2^(1 + 1)      2.2

    step
    let m ∈ ℕ                                                         (K2)
    assume step 2 is true for m, the induction hypothesis             (IH)

    2.4.  ∏(k ∈ {1, …, m + 1}) (1 − 1/2^k) = (∏(k ∈ {1, …, m}) (1 − 1/2^k))·(1 − 1/2^(m + 1))
          mun:product-extended a := 1, n := m, from 1
          requires m ≥ 1: inequalities, from K2

    2.5.  2^(m + 1) ≥ 4
          thm:power-of-two-at-least-four

    2.6.  2^(m + 1) ∈ ℕ
          mun:power-nat a := 2, m := m + 1

    2.7.  2^(m + 1) > 0
          inequalities, from 2.6

    2.8.  1/2^(m + 1) > 0
          mun:reciprocal-positive x := 2^(m + 1), from 2.7
          requires 2^(m + 1) ∈ ℝ: from 2.6

    2.9.  1/2^(m + 1) ≤ 1/4
          mun:reciprocal-order x := 4, y := 2^(m + 1), from 2.5, 2.7
          requires 4 > 0: arithmetic
          requires 2^(m + 1) ∈ ℝ: from 2.6

    2.10. ∏(k ∈ {1, …, m}) (1 − 1/2^k) ∈ ℝ
          mun:product-real a := 1, b := m, from 1

    2.11. (∏(k ∈ {1, …, m}) (1 − 1/2^k))·(1 − 1/2^(m + 1)) ≥ 1/4 + 1/2^(m + 1)/2
          thm:product-step-bound t := 1/2^(m + 1), p := ∏(k ∈ {1, …, m}) (1 − 1/2^k), from IH, 2.8, 2.9, 2.10
          requires 1/2^(m + 1) ∈ ℝ: from 2.6

    2.12. 2^(m + 1 + 1) = 2^(m + 1)·2
          mun:exponent-step a := 2, m := m + 1

    2.13. 1/4 + 1/2^(m + 1 + 1) = 1/4 + 1/(2^(m + 1)·2)
          substitute 2^(m + 1 + 1) = 2^(m + 1)·2 (line 2.12)

    2.14. 1/4 + 1/2^(m + 1)/2 = 1/4 + 1/(2^(m + 1)·2)
          algebra
          requires 2^(m + 1) ∈ ℝ: from 2.6
          requires 2^(m + 1) ≠ 0: weakening, from 2.7

    2.15. ∏(k ∈ {1, …, m + 1}) (1 − 1/2^k) ≥ 1/4 + 1/2^(m + 1 + 1)
          calculation
            ∏(k ∈ {1, …, m + 1}) (1 − 1/2^k) = (∏(k ∈ {1, …, m}) (1 − 1/2^k))·(1 − 1/2^(m + 1))    2.4
                                             ≥ 1/4 + 1/2^(m + 1)/2                                 2.11
                                             = 1/4 + 1/(2^(m + 1)·2)                               2.14
                                             = 1/4 + 1/2^(m + 1 + 1)                               2.13

3.  ∏(k ∈ {1, …, n}) (1 − 1/2^k) ≥ 1/4 + 1/2^(n + 1)
    instantiate m := n in line 2
