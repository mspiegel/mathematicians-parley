import definition         stdlib/divisibility/congruent-mod
import mundane theorem    stdlib/divisibility/divides-multiple

theorem congruent-cubes
  note        a³ − b³ factors as (a − b)(a² + ab + b²), and n divides a − b.
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  let n ∈ ℕ                                                           (H3)
  assume a ≡ b (mod n)                                                (H4)
  then a³ ≡ b³ (mod n)

1.  n divides a − b
    def:congruent-mod, from H4

2.  n divides (a − b)·(a² + a·b + b²)
    mun:divides-multiple e := n, a := a − b, x := a² + a·b + b², from 1

3.  (a − b)·(a² + a·b + b²) = a³ − b³
    algebra

4.  n divides a³ − b³
    substitute (a − b)·(a² + a·b + b²) = a³ − b³ (line 3) into line 2

5.  a³ ≡ b³ (mod n)
    def:congruent-mod, from 4
