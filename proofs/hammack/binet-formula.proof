import mundane theorem    stdlib/numbers/exponent-step

theorem power-recurrence
  note        If x² = x + 1 then x^(k + 2) = x^k·x² = x^k·(x + 1), which is
              x^(k + 1) + x^k.
  let x ∈ ℝ                                                           (H1)
  assume x² = x + 1                                                   (H2)
  let k ∈ ℕ₀                                                          (H3)
  then x^((k + 1) + 1) = x^(k + 1) + x^k

1.  x^(k + 1) = x^k·x
    mun:exponent-step a := x, m := k

2.  x^((k + 1) + 1) = x^(k + 1)·x
    mun:exponent-step a := x, m := k + 1

3.  x^((k + 1) + 1) = x^(k + 1) + x^k
    calculation
      x^((k + 1) + 1) = x^k·x·x           algebra, from 1, 2
                      = x^k·(x + 1)       algebra, from H2
                      = x^(k + 1) + x^k   algebra, from 1

theorem binet-formula
  note        By induction on j, carrying F and G together: F(j) and G(j) are
              the formula at j and j + 1. The step adds the two, and both
              roots x of x² = x + 1, namely (1 + √5)/2 and (1 − √5)/2,
              satisfy x^(j + 2) = x^(j + 1) + x^j.
  let n ∈ ℕ                                                           (H1)
  let F(0) = 0,  G(0) = 1,
      F(k + 1) = G(k),  G(k + 1) = F(k) + G(k),  for k ∈ ℕ₀           (D1)
         reads the Fibonacci numbers, F(k) the kth and G(k) the next
  then F(n) = (((1 + √5)/2)^n − ((1 − √5)/2)^n)/√5

1.  √5 ≠ 0
    real arithmetic

let φ = (1 + √5)/2, a real number                                    (D2)
    membership
    reads the root of x² = x + 1 above 1

let ψ = (1 − √5)/2, a real number                                    (D3)
    membership
    reads the root of x² = x + 1 below 0

2.  φ² = φ + 1
    calculation
      φ² = ((1 + √5)/2)²          D2
         = (1 + √5)/2 + 1         real arithmetic
         = φ + 1                  D2

3.  ψ² = ψ + 1
    calculation
      ψ² = ((1 − √5)/2)²          D3
         = (1 − √5)/2 + 1         real arithmetic
         = ψ + 1                  D3

4.  For all j ∈ ℕ₀, F(j) = (φ^j − ψ^j)/√5 and G(j) = (φ^(j + 1) − ψ^(j + 1))/√5.
    induction on j starting at 0

    base
    4.1.  F(0) = 0
          D1

    4.2.  G(0) = 1
          D1

    4.3.  F(0) = (φ^0 − ψ^0)/√5
          calculation
            F(0) = 0                        4.1
                 = (φ^0 − ψ^0)/√5           algebra, from 1

    4.4.  G(0) = (φ^(0 + 1) − ψ^(0 + 1))/√5
          calculation
            G(0) = 1                                                          4.2
                 = (((1 + √5)/2)^(0 + 1) − ((1 − √5)/2)^(0 + 1))/√5           real arithmetic
                 = (φ^(0 + 1) − ((1 − √5)/2)^(0 + 1))/√5                      D2
                 = (φ^(0 + 1) − ψ^(0 + 1))/√5                                 D3

    4.5.  F(0) = (φ^0 − ψ^0)/√5. G(0) = (φ^(0 + 1) − ψ^(0 + 1))/√5.
          join 4.3, 4.4

    step
    let j ∈ ℕ₀                                                        (K)
    assume step 4 is true for j, the induction hypothesis             (IH)

    4.6.  F(j + 1) = G(j)
          D1

    4.7.  G(j + 1) = F(j) + G(j)
          D1

    4.8.  F(j + 1) = (φ^(j + 1) − ψ^(j + 1))/√5
          substitute G(j) = (φ^(j + 1) − ψ^(j + 1))/√5 (IH) into line 4.6

    4.9.  φ^((j + 1) + 1) = φ^(j + 1) + φ^j
          thm:power-recurrence x := φ, k := j, from 2

    4.10. ψ^((j + 1) + 1) = ψ^(j + 1) + ψ^j
          thm:power-recurrence x := ψ, k := j, from 3

    4.11. G(j + 1) = (φ^((j + 1) + 1) − ψ^((j + 1) + 1))/√5
          calculation
            G(j + 1) = F(j) + G(j)                                          4.7
                     = (φ^j − ψ^j)/√5 + G(j)                                substitute IH
                     = (φ^j − ψ^j)/√5 + (φ^(j + 1) − ψ^(j + 1))/√5          substitute IH
                     = (φ^((j + 1) + 1) − ψ^((j + 1) + 1))/√5               algebra, from 4.9, 4.10
          requires √5 ≠ 0: from 1

    4.12. F(j + 1) = (φ^(j + 1) − ψ^(j + 1))/√5. G(j + 1) = (φ^((j + 1) + 1) − ψ^((j + 1) + 1))/√5.
          join 4.8, 4.11

5.  F(n) = (φ^n − ψ^n)/√5 and G(n) = (φ^(n + 1) − ψ^(n + 1))/√5
    instantiate j := n in line 4

6.  F(n) = (((1 + √5)/2)^n − ((1 − √5)/2)^n)/√5
    calculation
      F(n) = (φ^n − ψ^n)/√5                              5
           = (((1 + √5)/2)^n − ψ^n)/√5                   D2
           = (((1 + √5)/2)^n − ((1 − √5)/2)^n)/√5        D3
