import definition         stdlib/functions/preimage
import mundane theorem    stdlib/functions/value-in-image
import definition         stdlib/sets/subset
import mundane theorem    stdlib/sets/in-subset

theorem subset-of-preimage-of-image
  note        Each x in X is sent by f to f(x), which is in f[X], so x is
              among the points f sends into f[X].
  let A be a set                                                      (H1)
  let B be a set                                                      (H2)
  let f : A → B                                                       (H3)
  let X ⊆ A                                                           (H4)
  then X ⊆ f⁻¹[f[X]]

1.  For all x ∈ X, x ∈ f⁻¹[f[X]].
    proof
    let x ∈ X                                                         (K1)

    1.1.  x ∈ A
          mun:in-subset, from H4, K1

    1.2.  f(x) ∈ f[X]
          mun:value-in-image, from H4, K1

    1.3.  x ∈ f⁻¹[f[X]]
          def:preimage u := x, from 1.1, 1.2

2.  X ⊆ f⁻¹[f[X]]
    def:subset, from 1
