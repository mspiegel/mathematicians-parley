import definition         stdlib/calculus/limit-at
import mundane theorem    stdlib/sets/difference-subset
import mundane theorem    stdlib/sets/remove-member
import definition         stdlib/numbers/abs
import mundane theorem    stdlib/numbers/abs-negative
import mundane theorem    stdlib/numbers/abs-difference-lt
import mundane theorem    stdlib/functions/function-value

theorem sign-has-no-limit
  note        For ε = 1 the limit gives some p > 0. The function takes the
              value 1 at p/2 and −1 at −p/2, both within p of 0, so L is
              within 1 of both: L > 0 and L < 0.
  ε, δ range over ℝ
  let f : ℝ ∖ {0} → ℝ                                                 (H1)
  assume for all x ∈ ℝ ∖ {0}, f(x) = |x|/x                           (H2)
  then there is no L ∈ ℝ with f tends to L at 0
  by          contradiction

suppose there is L ∈ ℝ with f tends to L at 0                         (S)

1.  L ∈ ℝ. f tends to L at 0.
    obtain L from S

2.  For all ε > 0, there exists δ > 0 such that |f(x) − L| < ε for all x ∈ ℝ ∖ {0} with (x ≠ 0 and |x − 0| < δ).
    def:limit-at D := ℝ ∖ {0}, c := 0, from 1
    requires ℝ ∖ {0} ⊆ ℝ: mun:difference-subset X := ℝ, Y := {0}

3.  There exists δ > 0 such that |f(x) − L| < 1 for all x ∈ ℝ ∖ {0} with (x ≠ 0 and |x − 0| < δ).
    instantiate ε := 1 in line 2
    requires 0 < 1: arithmetic

4.  p ∈ ℝ. p > 0. For all x ∈ ℝ ∖ {0} with (x ≠ 0 and |x − 0| < p), |f(x) − L| < 1.
    obtain p from line 3

5.  p/2 > 0
    inequalities
      p > 0          4
      p/2 > 0        multiplying by 1/2

6.  p/2 ≠ 0
    inequalities
      p/2 > 0        5
      p/2 ≠ 0        weakening

7.  p/2 ∈ ℝ ∖ {0}
    mun:remove-member u := p/2, from 6

8.  |p/2| = p/2
    def:abs x := p/2
    requires p/2 ≥ 0: weakening, from 5

9.  p/2 < p
    inequalities
      p/2 > 0                5
      p/2 + p/2 > p/2        adding p/2
      p > p/2                algebra
      p/2 < p                restate

10. |p/2 − 0| < p
    transitivity, from 8, 9

11. |f(p/2) − L| < 1
    instantiate x := p/2 in line 4, from 6, 7, 10

12. f(p/2) = 1
    calculation
      f(p/2) = |p/2|/(p/2)    instantiate x := p/2 in H2, from 7
             = 1              algebra, from 8
    requires p/2 ≠ 0: from 6

13. f(p/2) < L + 1
    mun:abs-difference-lt x := f(p/2), c := L, δ := 1, from 11
    requires f(p/2) ∈ ℝ: mun:function-value, from H1, 7

14. 1 < L + 1
    transitivity, from 12, 13

15. 0 < L
    inequalities
      1 < L + 1        14
      0 < L            adding −1

16. (−p)/2 ≠ 0
    inequalities
      p/2 > 0           5
      (−p)/2 < 0        multiplying by −1
      (−p)/2 ≠ 0        weakening

17. (−p)/2 ∈ ℝ ∖ {0}
    mun:remove-member u := (−p)/2, from 16

18. |−(p/2)| = |p/2|
    mun:abs-negative x := p/2

19. |(−p)/2| = |p/2|
    substitute
      |−(p/2)| = |p/2|      18
      |(−p)/2| = |p/2|      algebra

20. |(−p)/2 − 0| < p
    transitivity, from 19, 8, 9

21. |f((−p)/2) − L| < 1
    instantiate x := (−p)/2 in line 4, from 16, 17, 20

22. f((−p)/2) = −1
    calculation
      f((−p)/2) = |(−p)/2|/((−p)/2)    instantiate x := (−p)/2 in H2, from 17
                = −1                   algebra, from 8, 19
    requires (−p)/2 ≠ 0: from 16

23. L − 1 < f((−p)/2)
    mun:abs-difference-lt x := f((−p)/2), c := L, δ := 1, from 21
    requires f((−p)/2) ∈ ℝ: mun:function-value, from H1, 17

24. L − 1 < −1
    transitivity, from 23, 22

25. L < 0
    inequalities
      L − 1 < −1       24
      L < 0            adding 1

26. L ≤ 0
    inequalities
      L < 0        25
      L ≤ 0        weakening

27. not 0 < L
    inequalities, from 26, contradicting 15
