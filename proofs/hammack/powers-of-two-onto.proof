import definition         stdlib/functions/onto
import definition         stdlib/functions/set-image

theorem powers-of-two-onto
  note        A member of {2^n : n ∈ ℤ} is 2^n for some n, and 2^n is f(n).
  let f : ℤ → {2^n : n ∈ ℤ}                                           (H1)
  assume for all n ∈ ℤ, f(n) = 2^n                                   (H2)
  then f : ℤ → {2^n : n ∈ ℤ} is onto

1.  For all y ∈ {2^n : n ∈ ℤ}, there is x ∈ ℤ with y = f(x).
    proof
    let y ∈ {2^n : n ∈ ℤ}                                             (K1)

    1.1.  m ∈ ℤ. y = 2^m.
          obtain m: def:set-image u := y, from K1

    1.2.  y = f(m)
          calculation
            y = 2^m      1.1
              = f(m)     instantiate n := m in H2

    1.3.  There is x ∈ ℤ with y = f(x).
          exhibit, from 1.2

2.  f : ℤ → {2^n : n ∈ ℤ} is onto
    def:onto, from H1, 1
