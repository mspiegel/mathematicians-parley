import definition         stdlib/counting/C
import mundane theorem    stdlib/counting/factorial-nat
import definition         stdlib/sums/range-between
import mundane theorem    stdlib/numbers/nat0-as-int

theorem choose-of-choose
  note        In factorials, C(a, b)·C(b, c) is a!/((a − b)!·b!) times
              b!/((b − c)!·c!), and C(a, b − c)·C(a − b + c, c) is
              a!/((a − b + c)!·(b − c)!) times (a − b + c)!/((a − b)!·c!).
              Both are a!/((a − b)!·(b − c)!·c!).
  let a ∈ ℕ                                                           (H1)
  let b ∈ ℕ                                                           (H2)
  let c ∈ ℕ                                                           (H3)
  assume c ≤ b                                                        (H4)
  assume b ≤ a                                                        (H5)
  then C(a, b)·C(b, c) = C(a, b − c)·C(a − b + c, c)

1.  0 ≤ b
    inequalities, from H2

2.  b ∈ {0, …, a}
    def:range-between k := b, a := 0, b := a, from H5, 1

3.  C(a, b) = a!/((a − b)!·b!)
    def:C n := a, k := b, from 2

4.  0 ≤ c
    inequalities, from H3

5.  c ∈ {0, …, b}
    def:range-between k := c, a := 0, from H4, 4

6.  C(b, c) = b!/((b − c)!·c!)
    def:C n := b, k := c, from 5

7.  0 ≤ b − c
    inequalities
      c ≤ b         H4
      0 ≤ b − c     adding −c

8.  −c ≤ 0
    inequalities
      0 ≤ c         4
      0 ≥ −c        multiplying by −1
      −c ≤ 0        restate

9.  b − c ≤ a
    inequalities, from H5, 8

10. b − c ∈ {0, …, a}
    def:range-between k := b − c, a := 0, b := a, from 7, 9

11. C(a, b − c) = a!/((a − (b − c))!·(b − c)!)
    def:C n := a, k := b − c, from 10

12. C(a, b − c) = a!/((a − b + c)!·(b − c)!)
    substitute
      C(a, b − c) = a!/((a − (b − c))!·(b − c)!)      11
      C(a, b − c) = a!/((a − b + c)!·(b − c)!)        algebra

13. 0 ≤ a − b
    inequalities
      b ≤ a         H5
      0 ≤ a − b     adding −b

14. 0 ≤ a − b + c
    inequalities, from 4, 13

15. c ≤ a − b + c
    inequalities
      0 ≤ a − b         13
      c ≤ a − b + c     adding c

16. c ∈ {0, …, a − b + c}
    def:range-between k := c, a := 0, b := a − b + c, from 4, 15

17. a − b + c ∈ ℕ₀
    mun:nat0-as-int
    requires 0 ≤ a − b + c: from 14

18. C(a − b + c, c) = (a − b + c)!/(((a − b + c) − c)!·c!)
    def:C n := a − b + c, k := c, from 16
    requires a − b + c ∈ ℕ₀: from 17

19. C(a − b + c, c) = (a − b + c)!/((a − b)!·c!)
    substitute
      C(a − b + c, c) = (a − b + c)!/(((a − b + c) − c)!·c!)      18
      C(a − b + c, c) = (a − b + c)!/((a − b)!·c!)                algebra

20. a − b ∈ ℕ₀
    mun:nat0-as-int
    requires 0 ≤ a − b: from 13

21. b − c ∈ ℕ₀
    mun:nat0-as-int
    requires 0 ≤ b − c: from 7

22. a! ∈ ℕ
    mun:factorial-nat n := a

23. b! ∈ ℕ
    mun:factorial-nat n := b

24. c! ∈ ℕ
    mun:factorial-nat n := c

25. (a − b)! ∈ ℕ
    mun:factorial-nat n := a − b, from 20

26. (b − c)! ∈ ℕ
    mun:factorial-nat n := b − c, from 21

27. (a − b + c)! ∈ ℕ
    mun:factorial-nat n := a − b + c, from 17

28. C(a, b)·C(b, c) = C(a, b − c)·C(a − b + c, c)
    calculation
      C(a, b)·C(b, c) = a!/((a − b)!·b!)·C(b, c)                                   substitute line 3
                      = a!/((a − b)!·b!)·(b!/((b − c)!·c!))                        substitute line 6
                      = a!/((a − b + c)!·(b − c)!)·((a − b + c)!/((a − b)!·c!))    algebra, from 22, 23, 24, 25, 26, 27
                      = a!/((a − b + c)!·(b − c)!)·C(a − b + c, c)                 substitute line 19
                      = C(a, b − c)·C(a − b + c, c)                                substitute line 12
