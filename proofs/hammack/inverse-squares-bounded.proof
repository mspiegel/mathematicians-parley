import mundane theorem    stdlib/numbers/product-nonneg
import mundane theorem    stdlib/numbers/product-nonzero
import mundane theorem    stdlib/numbers/reciprocal-order
import mundane theorem    stdlib/numbers/square-positive
import mundane theorem    stdlib/sums/sum-extended
import mundane theorem    stdlib/sums/sum-single

theorem inverse-squares-bounded
  note        By induction on n: adding 1/(k + 1)² to a sum at most 2 − 1/k
              gives at most 2 − 1/(k + 1), because 1/(k + 1)² is at most
              1/(k·(k + 1)), which is 1/k − 1/(k + 1).
  let n ∈ ℕ                                                           (H1)
  then Σ(k = 1 to n) 1/k² ≤ 2 − 1/n

1.  For all j ∈ ℕ, 1/j² ∈ ℝ.
    proof
    let j ∈ ℕ                                                         (J)

    1.1.  1/j² ∈ ℝ
          membership

2.  For all k ∈ ℕ, Σ(j = 1 to k) 1/j² ≤ 2 − 1/k.
    induction on k starting at 1

    base
    2.1.  Σ(j = 1 to 1) 1/j² = 1/1²
          mun:sum-single a := 1, from 1

    2.2.  Σ(j = 1 to 1) 1/j² ≤ 2 − 1/1
          calculation
            Σ(j = 1 to 1) 1/j² = 1/1²        2.1
                               ≤ 2 − 1/1     arithmetic

    step
    let k ∈ ℕ                                                         (K)
    assume step 2 is true for k, the induction hypothesis             (IH)

    2.3.  Σ(j = 1 to k + 1) 1/j² = Σ(j = 1 to k) 1/j² + 1/(k + 1)²
          mun:sum-extended a := 1, n := k, from 1
          requires k ≥ 1: from K

    2.4.  k + 1 > 0
          inequalities, from K

    2.5.  1/k − 1/(k + 1) = 1/(k·(k + 1))
          algebra

    2.6.  (k + 1)² > 0
          mun:square-positive x := k + 1
          requires k + 1 ≠ 0: weakening, from 2.4

    2.7.  k·(k + 1) ≥ 0
          mun:product-nonneg x := k, y := k + 1
          requires k ≥ 0: inequalities, from K
          requires k + 1 ≥ 0: weakening, from 2.4

    2.8.  k·(k + 1) ≠ 0
          mun:product-nonzero x := k, y := k + 1
          requires k ≠ 0: from K
          requires k + 1 ≠ 0: weakening, from 2.4

    2.9.  k·(k + 1) > 0
          inequalities, from 2.7, 2.8

    2.10. (k + 1)² = k·(k + 1) + (k + 1)
          algebra

    2.11. k·(k + 1) < k·(k + 1) + (k + 1)
          inequalities
            k + 1 > 0                                       2.4
            k·(k + 1) + (k + 1) > k·(k + 1)                 adding k·(k + 1)

    2.12. k·(k + 1) < (k + 1)²
          transitivity, from 2.11, 2.10

    2.13. k·(k + 1) ≤ (k + 1)²
          inequalities
            k·(k + 1) < (k + 1)²                            2.12
            k·(k + 1) ≤ (k + 1)²                            weakening

    2.14. 1/(k + 1)² ≤ 1/(k·(k + 1))
          mun:reciprocal-order x := k·(k + 1), y := (k + 1)², from 2.6, 2.9, 2.13

    2.15. 1/(k + 1)² ≤ 1/k − 1/(k + 1)
          transitivity, from 2.14, 2.5

    2.16. Σ(j = 1 to k) 1/j² + 1/(k + 1)² ≤ 2 − 1/k + 1/(k + 1)²
          inequalities
            Σ(j = 1 to k) 1/j² ≤ 2 − 1/k                                  IH
            Σ(j = 1 to k) 1/j² + 1/(k + 1)² ≤ 2 − 1/k + 1/(k + 1)²        adding 1/(k + 1)²

    2.17. 2 − 1/k + 1/(k + 1)² ≤ 2 − 1/(k + 1)
          inequalities
            1/(k + 1)² ≤ 1/k − 1/(k + 1)                                  2.15
            2 − 1/k + 1/(k + 1)² ≤ 2 − 1/(k + 1)                          adding 2 − 1/k

    2.18. Σ(j = 1 to k + 1) 1/j² ≤ 2 − 1/(k + 1)
          transitivity, from 2.3, 2.16, 2.17

3.  Σ(k = 1 to n) 1/k² ≤ 2 − 1/n
    instantiate k := n in line 2
