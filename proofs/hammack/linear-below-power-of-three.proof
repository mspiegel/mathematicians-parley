import mundane theorem    stdlib/numbers/exponent-step
import mundane theorem    stdlib/numbers/power-real

theorem linear-below-power-of-three
  note        By induction on n: 3^(k + 1) = 3·3^k is at least 3(2k + 1) =
              6k + 3, which is at least 2k + 3 = 2(k + 1) + 1.
  let n ∈ ℕ                                                           (H1)
  then 2n + 1 ≤ 3^n

1.  For all k ∈ ℕ, 2k + 1 ≤ 3^k.
    induction on k starting at 1

    base
    1.1.  2·1 + 1 ≤ 3^1
          arithmetic

    step
    let k ∈ ℕ                                                         (K)
    assume step 1 is true for k, the induction hypothesis             (IH)

    1.2.  3^(k + 1) = 3^k·3
          mun:exponent-step a := 3

    1.3.  2(k + 1) + 1 ≤ 3^(k + 1)
          inequalities, from IH, K, 1.2
          requires 3^k ∈ ℝ: mun:power-real a := 3, m := k
          requires 3^(k + 1) ∈ ℝ: mun:power-real a := 3, m := k + 1

2.  2n + 1 ≤ 3^n
    instantiate k := n in line 1
