import definition         stdlib/divisibility/divides
import definition         stdlib/divisibility/even
import definition         stdlib/divisibility/odd
import mundane theorem    stdlib/divisibility/even-or-odd
import definition         stdlib/divisibility/prime
import mundane theorem    stdlib/numbers/integer-step
import mundane theorem    stdlib/reasoning/modus-ponens

theorem prime-sum-odd
  note        Since p > 1 and q > p, q is at least 3. The prime q is not
              even, for then 2 divides q, so 2 is 1 or q. So q = 2k + 1 and
              2p + q² = 2(p + 2k² + 2k) + 1.
  let p ∈ ℕ                                                           (H1)
  let q ∈ ℕ                                                           (H2)
  assume p is prime                                                   (H3)
  assume q is prime                                                   (H4)
  assume p < q                                                        (H5)
  then 2p + q² is odd

1.  p > 1
    def:prime, from H3

2.  1 + 1 ≤ p
    mun:integer-step m := 1, n := p, from 1

3.  1 + 1 < q
    transitivity, from 2, H5

4.  For all d ∈ ℕ, if d divides q then d = 1 or d = q.
    def:prime p := q, from H4

5.  q is even or q is odd
    mun:even-or-odd n := q

6.  q is odd
    cases, from 5

    case
    assume q is even                                                  (C1)

    6.1.  There is k ∈ ℤ with q = 2k.
          def:even n := q, from C1

    6.2.  k ∈ ℤ. q = 2k.
          obtain k from line 6.1

    6.3.  2 divides q
          def:divides d := 2, n := q, from 6.2

    6.4.  If 2 divides q then 2 = 1 or 2 = q.
          instantiate d := 2 in line 4

    6.5.  2 = 1 or 2 = q
          mun:modus-ponens P := 2 divides q, from 6.3, 6.4

    6.6.  2 = q
          cases, from 6.5

          case
          assume 2 = 1                                                (C2)

          6.6.1.  2 ≠ 1
                  arithmetic, contradicting C2

          case
          assume 2 = q, which is the claim                            (C3)

    6.7.  2 ≠ q
          inequalities, contradicting 6.6
            1 + 1 < q           3
            2 < q               algebra
            2 ≠ q               weakening

    case
    assume q is odd, which is the claim                               (C4)

7.  There is k ∈ ℤ with q = 2k + 1.
    def:odd n := q, from 6

8.  k ∈ ℤ. q = 2k + 1.
    obtain k from line 7

9.  2p + q² = 2·(p + 2·k² + 2·k) + 1
    algebra, from 8

10. 2p + q² is odd
    def:odd n := 2p + q², from 9
