import definition         stdlib/divisibility/gcd
import mundane theorem    stdlib/divisibility/mod-multiple
import theorem            stdlib/divisibility/gcd-mod

theorem gcd-with-remainder
  note        Dividing a = q·b + r by b leaves the remainder of r, since a
              whole number of b's changes no remainder, and the gcd is the
              gcd of the remainder and b.
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℕ                                                           (H2)
  let q ∈ ℤ                                                           (H3)
  let r ∈ ℤ                                                           (H4)
  assume a = q·b + r                                                  (H5)
  then gcd(a, b) = gcd(r, b)

1.  a mod b = r mod b
    calculation
      a mod b = (q·b + r) mod b      substitute H5
              = r mod b              mun:mod-multiple

2.  gcd(a, b) = gcd(r, b)
    calculation
      gcd(a, b) = gcd(a mod b, b)       thm:gcd-mod
                = gcd(r mod b, b)       substitute line 1
                = gcd(r, b)             thm:gcd-mod a := r
