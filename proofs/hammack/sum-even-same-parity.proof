import definition         stdlib/divisibility/even
import mundane theorem    stdlib/divisibility/even-or-odd
import mundane theorem    stdlib/divisibility/not-both
import mundane theorem    stdlib/reasoning/or-left
import mundane theorem    stdlib/reasoning/or-right
import definition         stdlib/divisibility/odd

theorem sum-even-same-parity
  note        Each of x and y is even or odd. Two evens, or two odds, are
              the claim. If x = 2a and y = 2b + 1, the sum is twice a + b,
              plus 1, which is odd and so not even; if x = 2a + 1 and
              y = 2b, the same.
  let x ∈ ℤ                                                           (H1)
  let y ∈ ℤ                                                           (H2)
  assume x + y is even                                                (H3)
  then (x is even and y is even) or (x is odd and y is odd)

1.  x is even or x is odd
    mun:even-or-odd n := x

2.  y is even or y is odd
    mun:even-or-odd n := y

3.  (x is even and y is even) or (x is odd and y is odd)
    cases, from 1

    case
    assume x is even                                                  (C1)

    3.1.  a ∈ ℤ. x = 2a.
          obtain a: def:even n := x, from C1

    3.2.  (x is even and y is even) or (x is odd and y is odd)
          cases, from 2

          case
          assume y is even                                            (C2)

          3.2.1.  x is even and y is even
                  join C1, C2

          3.2.2.  (x is even and y is even) or (x is odd and y is odd)
                  mun:or-left P := x is even and y is even, Q := x is odd and y is odd, from 3.2.1

          case
          assume y is odd                                             (C3)

          3.2.3.  b ∈ ℤ. y = 2b + 1.
                  obtain b: def:odd n := y, from C3

          3.2.4.  x + y = 2(a + b) + 1
                  algebra, from 3.1, 3.2.3

          3.2.5.  x + y is odd
                  def:odd n := x + y, from 3.2.4

          3.2.6.  x + y is not odd
                  mun:not-both n := x + y, from H3, contradicting 3.2.5

    case
    assume x is odd                                                   (C4)

    3.3.  a ∈ ℤ. x = 2a + 1.
          obtain a: def:odd n := x, from C4

    3.4.  (x is even and y is even) or (x is odd and y is odd)
          cases, from 2

          case
          assume y is even                                            (C5)

          3.4.1.  b ∈ ℤ. y = 2b.
                  obtain b: def:even n := y, from C5

          3.4.2.  x + y = 2(a + b) + 1
                  algebra, from 3.3, 3.4.1

          3.4.3.  x + y is odd
                  def:odd n := x + y, from 3.4.2

          3.4.4.  x + y is not odd
                  mun:not-both n := x + y, from H3, contradicting 3.4.3

          case
          assume y is odd                                             (C6)

          3.4.5.  x is odd and y is odd
                  join C4, C6

          3.4.6.  (x is even and y is even) or (x is odd and y is odd)
                  mun:or-right P := x is even and y is even, Q := x is odd and y is odd, from 3.4.5
