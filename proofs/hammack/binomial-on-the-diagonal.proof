import definition         stdlib/counting/C
import theorem            stdlib/counting/pascal
import mundane theorem    stdlib/counting/binomial-zero-index

theorem binomial-on-the-diagonal
  note        By induction on j: C(0, 0) is 1, and Pascal's rule gives
              C(j + 1, j + 1) = C(j, j + 1) + C(j, j), where C(j, j + 1) is 0
              because j < j + 1.
  let m ∈ ℕ₀                                                          (H1)
  then C(m, m) = 1

1.  For all j ∈ ℕ₀, C(j, j) = 1.
    induction on j starting at 0

    base
    1.1.  C(0, 0) = 1
          mun:binomial-zero-index n := 0

    step
    let j ∈ ℕ₀                                                        (K)
    assume step 1 is true for j, the induction hypothesis             (IH)

    1.2.  j < j + 1
          inequalities

    1.3.  C(j, j + 1) = 0
          def:C n := j, k := j + 1, from 1.2

    1.4.  C(j, j + 1) + C(j, (j + 1) − 1) = C(j + 1, j + 1)
          thm:pascal n := j, k := j + 1

    1.5.  C(j, j + 1) + C(j, j) = C(j + 1, j + 1)
          substitute
            C(j, j + 1) + C(j, (j + 1) − 1) = C(j + 1, j + 1)      1.4
            C(j, j + 1) + C(j, j) = C(j + 1, j + 1)                algebra

    1.6.  C(j + 1, j + 1) = 1
          calculation
            C(j + 1, j + 1) = C(j, j + 1) + C(j, j)     1.5
                            = 0 + C(j, j)               substitute line 1.3
                            = 0 + 1                     substitute IH
                            = 1                         arithmetic

2.  C(m, m) = 1
    instantiate j := m in line 1
