import definition         stdlib/functions/one-to-one
import definition         stdlib/functions/onto
import definition         stdlib/functions/one-to-one-onto

theorem six-minus-n-bijection
  note        6 − s = 6 − t only where s = t, and y is 6 − (6 − y).
  let f : ℤ → ℤ                                                       (H1)
  assume for all n ∈ ℤ, f(n) = 6 − n                                  (H2)
  then f : ℤ → ℤ is one-to-one and onto

1.  For all s, t ∈ ℤ, if f(s) = f(t) then s = t.
    proof
    let s ∈ ℤ                                                         (K1)
    let t ∈ ℤ                                                         (K2)
    assume f(s) = f(t)                                                (A1)

    1.1.  6 − s = 6 − t
          calculation
            6 − s = f(s)       instantiate n := s in H2
                  = f(t)       A1
                  = 6 − t      instantiate n := t in H2

    1.2.  s = t
          algebra, from 1.1

2.  f : ℤ → ℤ is one-to-one
    def:one-to-one, from H1, 1

3.  For all y ∈ ℤ, there is x ∈ ℤ with y = f(x).
    proof
    let y ∈ ℤ                                                         (K3)

    3.1.  f(6 − y) = 6 − (6 − y)
          instantiate n := 6 − y in H2

    3.2.  y = f(6 − y)
          algebra, from 3.1

    3.3.  There is x ∈ ℤ with y = f(x).
          exhibit, from 3.2

4.  f : ℤ → ℤ is onto
    def:onto, from H1, 3

5.  f : ℤ → ℤ is one-to-one and onto
    def:one-to-one-onto, from 2, 4
