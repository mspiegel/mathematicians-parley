import definition         stdlib/divisibility/even
import mundane theorem    stdlib/divisibility/not-both

theorem no-integers-with-eighteen-a-plus-six-b-one
  note        If 18a + 6b = 1 then 1 = 2(9a + 3b) is even, and it is odd.
  then there do not exist a, b ∈ ℤ such that 18a + 6b = 1
  by          contradiction

suppose there exist a, b ∈ ℤ such that 18a + 6b = 1                   (S)

1.  a ∈ ℤ. b ∈ ℤ. 18a + 6b = 1.
    obtain a, b from S

2.  1 = 2(9a + 3b)
    algebra, from 1

3.  1 is even
    def:even n := 1, from 2

4.  1 is not odd
    mun:not-both n := 1, from 3

5.  1 is odd
    arithmetic, contradicting 4
