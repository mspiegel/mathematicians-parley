import definition         stdlib/numbers/rational
import definition         stdlib/numbers/irrational

theorem rational-times-irrational
  note        If b were rational, so would be a·b: with a = p/q and b = r/s
              it is (p·r)/(q·s), a quotient of an integer by a natural number.
  let a ∈ ℝ                                                           (H1)
  let b ∈ ℝ                                                           (H2)
  assume a ∈ ℚ                                                        (H3)
  assume a·b is irrational                                            (H4)
  then b is irrational

1.  b ∉ ℚ
    contradiction
    suppose b ∈ ℚ                                                     (S)

    1.1.  p ∈ ℤ. q ∈ ℕ. a = p/q.
          obtain p, q: def:rational x := a, from H3

    1.2.  r ∈ ℤ. s ∈ ℕ. b = r/s.
          obtain r, s: def:rational x := b, from S

    1.3.  a·b = (p·r)/(q·s)
          calculation
            a·b = (p/q)·b             substitute line 1.1
                = (p/q)·(r/s)         substitute line 1.2
                = (p·r)/(q·s)         algebra

    1.4.  a·b ∈ ℚ
          def:rational x := a·b, from 1.3

    1.5.  a·b ∈ ℝ. a·b ∉ ℚ.
          def:irrational x := a·b, from H4

    1.6.  a·b ∉ ℚ
          restate 1.5, contradicting 1.4

2.  b is irrational
    def:irrational x := b, from 1
