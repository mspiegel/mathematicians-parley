import mundane theorem    stdlib/sums/sum-single
import mundane theorem    stdlib/sums/sum-extended

theorem fibonacci-even-sum
  note        By induction on n: the sum to 1 is F(2) = 1 = F(3) − 1, and
              adding F(2n + 2) to F(2n + 1) − 1 gives F(2n + 3) − 1, since
              each Fibonacci number is the sum of the two before it.
  let n ∈ ℕ                                                           (H1)
  let F(0) = 0,  G(0) = 1,
      F(k + 1) = G(k),  G(k + 1) = F(k) + G(k),  for k ∈ ℕ₀           (D1)
         reads the Fibonacci numbers, F(k) the kth and G(k) the next
  then Σ(k = 1 to n) F(2k) = F(2n + 1) − 1

1.  For all k ∈ ℕ₀, F(k) ∈ ℕ₀ and G(k) ∈ ℕ₀.
    induction on k starting at 0

    base
    1.1.  F(0) = 0
          D1

    1.2.  G(0) = 1
          D1

    1.3.  F(0) ∈ ℕ₀
          membership, from 1.1

    1.4.  G(0) ∈ ℕ₀
          membership, from 1.2

    1.5.  F(0) ∈ ℕ₀ and G(0) ∈ ℕ₀
          join 1.3, 1.4

    step
    let k ∈ ℕ₀                                                        (K)
    assume step 1 is true for k, the induction hypothesis             (IH)

    1.6.  F(k + 1) = G(k)
          D1

    1.7.  G(k + 1) = F(k) + G(k)
          D1

    1.8.  F(k + 1) ∈ ℕ₀
          membership, from IH, 1.6

    1.9.  G(k + 1) ∈ ℕ₀
          membership, from IH, 1.7

    1.10. F(k + 1) ∈ ℕ₀ and G(k + 1) ∈ ℕ₀
          join 1.8, 1.9

2.  For all k ∈ ℕ₀, F(k) ∈ ℝ.
    proof
    let k ∈ ℕ₀                                                        (K1)

    2.1.  F(k) ∈ ℝ
          membership, from 1

let q(k) = F(2k), for k ∈ ℕ                                           (D2)
       reads the even-numbered Fibonacci number F(2k)

3.  For all k ∈ ℕ₀, F(k + 2) = F(k) + F(k + 1).
    proof
    let k ∈ ℕ₀                                                        (K2)

    3.1.  F((k + 1) + 1) = G(k + 1)
          D1

    3.2.  G(k + 1) = F(k) + G(k)
          D1

    3.3.  F(k + 1) = G(k)
          D1

    3.4.  F((k + 1) + 1) = F(k) + G(k)
          transitivity, from 3.1, 3.2

    3.5.  F((k + 1) + 1) = F(k) + F(k + 1)
          substitute F(k + 1) = G(k) (line 3.3) into line 3.4

    3.6.  F(k + 2) = F(k) + F(k + 1)
          substitute
            F((k + 1) + 1) = F(k) + F(k + 1)      3.5
            F(k + 2) = F(k) + F(k + 1)            algebra

4.  For all m ∈ ℕ, Σ(j = 1 to m) q(j) = F(2m + 1) − 1.
    induction on m starting at 1

    base
    4.1.  For all i ∈ {1, …, 1}, q(i) ∈ ℝ.
          proof
          let i ∈ {1, …, 1}                                           (J1)

          4.1.1.  F(2i) ∈ ℝ
                  instantiate k := 2i in line 2

          4.1.2.  q(i) ∈ ℝ
                  membership, from D2, 4.1.1

    4.2.  F(0 + 1) = G(0)
          D1

    4.3.  G(0) = 1
          D1

    4.4.  F(0) = 0
          D1

    4.5.  F(0 + 1) = 1
          calculation
            F(0 + 1) = G(0)    4.2
                     = 1       4.3

    4.6.  F(1) = 1
          calculation
            F(1) = F(0 + 1)    arithmetic
                 = 1           4.5

    4.7.  F(0 + 2) = F(0) + F(0 + 1)
          instantiate k := 0 in line 3

    4.8.  F(1 + 1) = 1
          calculation
            F(1 + 1) = F(0 + 2)    arithmetic
                     = 1           algebra, from 4.4, 4.5, 4.7

    4.9.  F(1 + 2) = F(1) + F(1 + 1)
          instantiate k := 1 in line 3

    4.10. F(2·1 + 1) = 2
          calculation
            F(2·1 + 1) = F(1 + 2)    arithmetic
                       = 2           algebra, from 4.6, 4.8, 4.9

    4.11. Σ(j = 1 to 1) q(j) = F(2·1 + 1) − 1
          calculation
            Σ(j = 1 to 1) q(j) = q(1)                  mun:sum-single a := 1
                               = F(2·1)                D2
                               = F(1 + 1)              arithmetic
                               = 1                     4.8
                               = 2 − 1                 arithmetic
                               = F(2·1 + 1) − 1        substitute line 4.10
          requires for all i ∈ {1, …, 1}, q(i) ∈ ℝ: from 4.1

    step
    let m ∈ ℕ                                                         (K3)
    assume step 4 is true for m, the induction hypothesis             (IH2)

    4.12. For all i ∈ {1, …, m + 1}, q(i) ∈ ℝ.
          proof
          let i ∈ {1, …, m + 1}                                       (J2)

          4.12.1. F(2i) ∈ ℝ
                  instantiate k := 2i in line 2

          4.12.2. q(i) ∈ ℝ
                  membership, from D2, 4.12.1

    4.13. q(m + 1) = F(2(m + 1))
          D2

    4.14. F((2m + 1) + 2) = F(2m + 1) + F((2m + 1) + 1)
          instantiate k := 2m + 1 in line 3

    4.15. F(2(m + 1) + 1) = F(2m + 1) + F((2m + 1) + 1)
          substitute
            F((2m + 1) + 2) = F(2m + 1) + F((2m + 1) + 1)      4.14
            F(2(m + 1) + 1) = F(2m + 1) + F((2m + 1) + 1)      algebra

    4.16. F(2(m + 1) + 1) = F(2m + 1) + F(2(m + 1))
          substitute
            F(2(m + 1) + 1) = F(2m + 1) + F((2m + 1) + 1)      4.15
            F(2(m + 1) + 1) = F(2m + 1) + F(2(m + 1))          algebra

    4.17. F(2m + 1) ∈ ℝ
          instantiate k := 2m + 1 in line 2

    4.18. F(2(m + 1)) ∈ ℝ
          instantiate k := 2(m + 1) in line 2

    4.19. Σ(j = 1 to m + 1) q(j) = F(2(m + 1) + 1) − 1
          calculation
            Σ(j = 1 to m + 1) q(j) = Σ(j = 1 to m) q(j) + q(m + 1)       mun:sum-extended a := 1, n := m
                                   = F(2m + 1) − 1 + q(m + 1)            substitute IH2
                                   = F(2m + 1) − 1 + F(2(m + 1))         substitute line 4.13
                                   = F(2(m + 1) + 1) − 1                 algebra, from 4.16
          requires m ≥ 1: from K3
          requires for all i ∈ {1, …, m + 1}, q(i) ∈ ℝ: from 4.12
          requires F(2m + 1) ∈ ℝ: from 4.17
          requires F(2(m + 1)) ∈ ℝ: from 4.18

5.  Σ(k = 1 to n) F(2k) = F(2n + 1) − 1
    instantiate m := n in line 4, from D2
