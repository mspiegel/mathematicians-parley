import definition         stdlib/calculus/limit-at
import mundane theorem    stdlib/sets/subset-self
import definition         stdlib/numbers/abs
import mundane theorem    stdlib/numbers/abs-product
import mundane theorem    stdlib/numbers/abs-difference-lt
import definition         stdlib/numbers/min
import mundane theorem    stdlib/numbers/min-real
import mundane theorem    stdlib/numbers/lt-min
import mundane theorem    stdlib/numbers/less-scaled
import mundane theorem    stdlib/numbers/multiply-le

theorem square-limit
  note        Near 3, x² − 9 = (x + 3)(x − 3) has |x + 3| below 7 once x is
              within 1 of 3, so x within min(1, ε/7) of 3 makes the product
              less than ε.
  ε, δ range over ℝ
  let f : ℝ → ℝ                                                       (H1)
  assume for all x ∈ ℝ, f(x) = x² − 2                                (H2)
  then f tends to 7 at 3

1.  For all ε > 0, there exists δ > 0 such that |f(x) − 7| < ε for all x ∈ ℝ with (x ≠ 3 and |x − 3| < δ).
    proof
    let ε ∈ ℝ                                                         (K1)
    assume ε > 0                                                      (A1)

    let m = min(1, ε/7), a real number                                (D1)
           mun:min-real x := 1, y := ε/7
           reads the smaller of 1 and ε/7

    1.1.  0 < ε/7
          inequalities
            ε > 0            A1
            ε/7 > 0          multiplying by 1/7
            0 < ε/7          restate

    1.2.  0 < min(1, ε/7)
          mun:lt-min z := 0, x := 1, y := ε/7
          requires 0 < 1: arithmetic
          requires 0 < ε/7: from 1.1

    1.3.  m > 0
          inequalities, from D1, 1.2

    1.4.  For all x ∈ ℝ with (x ≠ 3 and |x − 3| < m), |f(x) − 7| < ε.
          proof
          let x ∈ ℝ                                                   (K2)
          assume x ≠ 3 and |x − 3| < m                                (A2)

          1.4.1.  |x − 3| < 1 and |x − 3| < ε/7
                  mun:lt-min z := |x − 3|, x := 1, y := ε/7, from A2, D1

          1.4.2.  3 − 1 < x and x < 3 + 1
                  mun:abs-difference-lt c := 3, δ := 1, from 1.4.1

          1.4.3.  x + 3 > 0
                  inequalities, from 1.4.2

          1.4.4.  x + 3 ≥ 0
                  inequalities
                    x + 3 > 0        1.4.3
                    x + 3 ≥ 0        weakening

          1.4.5.  |x + 3| = x + 3
                  def:abs x := x + 3, from 1.4.4

          1.4.6.  x + 3 < 7
                  inequalities, from 1.4.2

          1.4.7.  0 < |x + 3|
                  transitivity, from 1.4.3, 1.4.5

          1.4.8.  |x + 3| < 7
                  transitivity, from 1.4.5, 1.4.6

          1.4.9.  0 < |x + 3| and |x + 3| < 7
                  join 1.4.7, 1.4.8

          1.4.10. |x + 3| ≤ 7
                  inequalities
                    |x + 3| < 7      1.4.8
                    |x + 3| ≤ 7      weakening

          1.4.11. f(x) = x² − 2
                  instantiate x := x in H2

          1.4.12. |(x + 3)·(x − 3)| = |x + 3|·|x − 3|
                  mun:abs-product x := x + 3, y := x − 3

          1.4.13. |f(x) − 7| = |x + 3|·|x − 3|
                  substitute
                    |(x + 3)·(x − 3)| = |x + 3|·|x − 3|      1.4.12
                    |f(x) − 7| = |x + 3|·|x − 3|             algebra, from 1.4.11

          1.4.14. |f(x) − 7| < ε
                  calculation
                    |f(x) − 7| = |x + 3|·|x − 3|      1.4.13
                               < |x + 3|·(ε/7)        mun:less-scaled x := |x − 3|, y := ε/7, c := |x + 3|, from 1.4.1, 1.4.9
                               = ε/7·|x + 3|          algebra
                               ≤ ε/7·7                mun:multiply-le x := |x + 3|, y := 7, c := ε/7, from 1.4.10
                               = ε                    algebra
                  requires ε/7 > 0: multiplying by 1/7, from A1

    1.5.  There exists δ > 0 such that |f(x) − 7| < ε for all x ∈ ℝ with (x ≠ 3 and |x − 3| < δ).
          exhibit, from 1.3, 1.4

2.  f tends to 7 at 3
    def:limit-at D := ℝ, c := 3, L := 7, from 1
    requires ℝ ⊆ ℝ: mun:subset-self
