import definition         stdlib/calculus/limit-at
import mundane theorem    stdlib/sets/subset-self
import mundane definition stdlib/numbers/abs
import mundane theorem    stdlib/numbers/abs-real
import mundane theorem    stdlib/numbers/abs-product
import mundane theorem    stdlib/numbers/abs-difference-lt
import mundane definition stdlib/numbers/min
import mundane theorem    stdlib/numbers/min-real
import mundane theorem    stdlib/numbers/lt-min
import mundane theorem    stdlib/numbers/less-scaled
import mundane theorem    stdlib/numbers/multiply-le
import mundane theorem    stdlib/functions/function-value

theorem square-limit
  note        Near 3, x² − 9 = (x + 3)(x − 3) has |x + 3| below 7 once x is
              within 1 of 3, so x within min(1, ε/7) of 3 makes the product
              less than ε.
  ε, δ range over ℝ
  let f : ℝ → ℝ                                                       (H1)
  assume for all x ∈ ℝ, f(x) = x² − 2                                (H2)
  then f tends to 7 at 3

1.  For all ε > 0, there exists δ > 0 such that |f(x) − 7| < ε for all x ∈ ℝ with (x ≠ 3 and |x − 3| < δ).
    proof
    let ε ∈ ℝ                                                         (K1)
    assume ε > 0                                                      (A1)

    let m = min(1, ε/7), a real number                                (D1)
           mun:min-real x := 1, y := ε/7
           reads the smaller of 1 and ε/7

    1.1.  0 < min(1, ε/7)
          mun:lt-min z := 0, x := 1, y := ε/7
          requires 0 < 1: arithmetic
          requires 0 < ε/7: inequalities, from A1

    1.2.  m > 0
          inequalities, from D1, 1.1

    1.3.  For all x ∈ ℝ with (x ≠ 3 and |x − 3| < m), |f(x) − 7| < ε.
          proof
          let x ∈ ℝ                                                   (K2)
          assume x ≠ 3 and |x − 3| < m                                (A2)

          1.3.1.  |x − 3| < 1 and |x − 3| < ε/7
                  mun:lt-min z := |x − 3|, x := 1, y := ε/7, from A2, D1
                  requires |x − 3| ∈ ℝ: mun:abs-real x := x − 3

          1.3.2.  3 − 1 < x and x < 3 + 1
                  mun:abs-difference-lt c := 3, δ := 1, from 1.3.1

          1.3.3.  x + 3 ≥ 0
                  inequalities, from 1.3.2

          1.3.4.  |x + 3| = x + 3
                  mun:abs x := x + 3, from 1.3.3

          1.3.5.  0 < |x + 3| and |x + 3| < 7
                  inequalities, from 1.3.2, 1.3.4
                  requires |x + 3| ∈ ℝ: mun:abs-real x := x + 3

          1.3.6.  |x + 3| ≤ 7
                  inequalities, from 1.3.5
                  requires |x + 3| ∈ ℝ: mun:abs-real x := x + 3

          1.3.7.  f(x) = x² − 2
                  instantiate x := x in H2

          1.3.8.  f(x) − 7 = (x + 3)·(x − 3)
                  algebra, from 1.3.7
                  requires f(x) ∈ ℝ: mun:function-value

          1.3.9.  |(x + 3)·(x − 3)| = |x + 3|·|x − 3|
                  mun:abs-product x := x + 3, y := x − 3

          1.3.10. |f(x) − 7| = |x + 3|·|x − 3|
                  substitute f(x) − 7 = (x + 3)·(x − 3) (line 1.3.8) into line 1.3.9

          1.3.11. |x + 3|·|x − 3| < |x + 3|·(ε/7)
                  mun:less-scaled x := |x − 3|, y := ε/7, c := |x + 3|, from 1.3.1, 1.3.5
                  requires |x − 3| ∈ ℝ: mun:abs-real x := x − 3
                  requires |x + 3| ∈ ℝ: mun:abs-real x := x + 3

          1.3.12. ε/7·|x + 3| ≤ ε/7·7
                  mun:multiply-le x := |x + 3|, y := 7, c := ε/7, from 1.3.6
                  requires |x + 3| ∈ ℝ: mun:abs-real x := x + 3
                  requires ε/7 > 0: inequalities, from A1

          1.3.13. |x + 3|·(ε/7) = ε/7·|x + 3|
                  algebra
                  requires |x + 3| ∈ ℝ: mun:abs-real x := x + 3

          1.3.14. ε/7·7 = ε
                  algebra

          1.3.15. |f(x) − 7| < ε
                  calculation
                    |f(x) − 7| = |x + 3|·|x − 3|      1.3.10
                               < |x + 3|·(ε/7)        1.3.11
                               = ε/7·|x + 3|          1.3.13
                               ≤ ε/7·7                1.3.12
                               = ε                    1.3.14

    1.4.  There exists δ > 0 such that |f(x) − 7| < ε for all x ∈ ℝ with (x ≠ 3 and |x − 3| < δ).
          exhibit, from 1.2, 1.3

2.  f tends to 7 at 3
    def:limit-at D := ℝ, c := 3, L := 7, from 1
    requires ℝ ⊆ ℝ: mun:subset-self
