import mundane definition stdlib/divisibility/congruent-mod
import mundane theorem    stdlib/divisibility/divides-multiple

theorem square-congruent-one-mod-five
  note        a² − 1 factors as (a − 1)(a + 1), and 5 divides a − 1.
  let a ∈ ℤ                                                           (H1)
  assume a ≡ 1 (mod 5)                                                 (H2)
  then a² ≡ 1 (mod 5)

1.  5 divides a − 1
    mun:congruent-mod, from H2

2.  5 divides (a − 1)·(a + 1)
    mun:divides-multiple e := 5, a := a − 1, x := a + 1, from 1

3.  (a − 1)·(a + 1) = a² − 1
    algebra

4.  5 divides a² − 1
    substitute (a − 1)·(a + 1) = a² − 1 (line 3) into line 2

5.  a² ≡ 1 (mod 5)
    mun:congruent-mod, from 4
