import mundane definition stdlib/divisibility/divides
import mundane theorem    stdlib/divisibility/divides-sum
import mundane definition stdlib/divisibility/even
import mundane theorem    stdlib/divisibility/even-or-odd
import mundane definition stdlib/divisibility/odd

theorem six-divides-three-consecutive
  note        One of k and k + 1 is even, so 3k(k + 1) is 3 times 2 times
              an integer.
  let k ∈ ℕ₀                                                          (H1)
  then 6 divides 3·k·(k + 1)

1.  k is even or k is odd
    mun:even-or-odd n := k

2.  6 divides 3·k·(k + 1)
    cases, from 1

    case
    assume k is even                                                  (C1)

    2.1.  m ∈ ℤ. k = 2m.
          obtain m: mun:even n := k, from C1

    2.2.  3·k·(k + 1) = 3·(2m)·((2m) + 1)
          substitute k = 2m (line 2.1)

    2.3.  3·(2m)·((2m) + 1) = 6·(m·(2m + 1))
          algebra

    2.4.  3·k·(k + 1) = 6·(m·(2m + 1))
          calculation
            3·k·(k + 1) = 3·(2m)·((2m) + 1)      2.2
                        = 6·(m·(2m + 1))         2.3

    2.5.  6 divides 3·k·(k + 1)
          mun:divides d := 6, n := 3·k·(k + 1), from 2.4

    case
    assume k is odd                                                   (C2)

    2.6.  m ∈ ℤ. k = 2m + 1.
          obtain m: mun:odd n := k, from C2

    2.7.  3·k·(k + 1) = 3·(2m + 1)·((2m + 1) + 1)
          substitute k = 2m + 1 (line 2.6)

    2.8.  3·(2m + 1)·((2m + 1) + 1) = 6·((2m + 1)·(m + 1))
          algebra

    2.9.  3·k·(k + 1) = 6·((2m + 1)·(m + 1))
          calculation
            3·k·(k + 1) = 3·(2m + 1)·((2m + 1) + 1)     2.7
                        = 6·((2m + 1)·(m + 1))          2.8

    2.10. 6 divides 3·k·(k + 1)
          mun:divides d := 6, n := 3·k·(k + 1), from 2.9

theorem cube-minus-self-divisible-by-six
  note        By induction on n: (n + 1)³ − (n + 1) is n³ − n plus
              3n(n + 1), and 6 divides both parts.
  let n ∈ ℕ₀                                                          (H1)
  then 6 divides n³ − n

1.  For all k ∈ ℕ₀, 6 divides k³ − k.
    induction on k starting at 0

    base
    1.1.  6 divides 0³ − 0
          arithmetic

    step
    let k ∈ ℕ₀                                                        (K)
    assume step 1 is true for k, the induction hypothesis             (IH)

    1.2.  6 divides 3·k·(k + 1)
          thm:six-divides-three-consecutive

    1.3.  6 divides (k³ − k) + 3·k·(k + 1)
          mun:divides-sum d := 6, a := k³ − k, b := 3·k·(k + 1), from IH, 1.2

    1.4.  (k³ − k) + 3·k·(k + 1) = (k + 1)³ − (k + 1)
          algebra

    1.5.  6 divides (k + 1)³ − (k + 1)
          substitute (k³ − k) + 3·k·(k + 1) = (k + 1)³ − (k + 1) (line 1.4) into line 1.3

2.  6 divides n³ − n
    instantiate k := n in line 1
