import mundane definition stdlib/divisibility/divides

theorem seven-divides-four-times
  note        If 4a = 7k then a = 8a − 7a = 14k − 7a = 7(2k − a).
  let a ∈ ℤ                                                           (H1)
  assume 7 divides 4a                                                 (H2)
  then 7 divides a

1.  k ∈ ℤ. 4a = 7k.
    obtain k: mun:divides d := 7, n := 4a, from H2

2.  a = 7·(2k − a)
    algebra, from 1

3.  7 divides a
    mun:divides d := 7, n := a, from 2
