import definition         stdlib/divisibility/even
import definition         stdlib/divisibility/odd
import mundane theorem    stdlib/divisibility/even-or-odd
import mundane theorem    stdlib/divisibility/not-both

theorem square-minus-four-b-minus-three
  note        If a² = 4b + 3, split on a even or odd. Either way 1 is twice
              an integer, so 1 is even, which it is not.
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  then a² − 4b − 3 ≠ 0

1.  a² − 4b − 3 ≠ 0
    contradiction
    suppose a² − 4b − 3 = 0                                           (S)

    1.1.  a² = 4b + 3
          algebra, from S

    1.2.  a is even or a is odd
          mun:even-or-odd n := a

    1.3.  1 is even
          cases, from 1.2

          case
          assume a is even                                            (C1)

          1.3.1.  k ∈ ℤ. a = 2k.
                  obtain k: def:even n := a, from C1

          1.3.2.  4k² = 4b + 3
                  calculation
                    4k² = (2k)²     algebra
                        = a²        substitute line 1.3.1
                        = 4b + 3    1.1

          1.3.3.  1 = 2(2k² − 2b − 1)
                  algebra, from 1.3.2

          1.3.4.  1 is even
                  def:even n := 1, from 1.3.3

          case
          assume a is odd                                             (C2)

          1.3.5.  k ∈ ℤ. a = 2k + 1.
                  obtain k: def:odd n := a, from C2

          1.3.6.  4k² + 4k + 1 = 4b + 3
                  calculation
                    4k² + 4k + 1 = (2k + 1)²    algebra
                                 = a²           substitute line 1.3.5
                                 = 4b + 3       1.1

          1.3.7.  1 = 2(k² + k − b)
                  algebra, from 1.3.6

          1.3.8.  1 is even
                  def:even n := 1, from 1.3.7

    1.4.  1 is not odd
          mun:not-both n := 1, from 1.3

    1.5.  1 is odd
          arithmetic, contradicting 1.4
