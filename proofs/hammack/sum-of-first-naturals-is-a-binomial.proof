import definition         stdlib/counting/C
import theorem            stdlib/counting/pascal
import theorem            proofs/hammack/binomial-of-one/binomial-of-one
import mundane theorem    stdlib/sums/sum-extended
import mundane theorem    stdlib/sums/sum-single

theorem sum-of-first-naturals-is-a-binomial
  note        By induction on n: C(2, 2) is C(1, 2) + C(1, 1) = 1, and adding
              k + 1 = C(k + 1, 1) to C(k + 1, 2) gives C(k + 2, 2), by
              Pascal's rule.
  let n ∈ ℕ                                                           (H1)
  then Σ(k = 1 to n) k = C(n + 1, 2)

let S(m) = Σ(j = 1 to m) j, for m ∈ ℕ                                 (D1)
       reads the sum of the first m natural numbers

1.  For all k ∈ ℕ, S(k) = C(k + 1, 2).
    induction on k starting at 1

    base
    1.1.  Σ(j = 1 to 1) j = 1
          mun:sum-single a := 1

    1.2.  1 < 2
          arithmetic

    1.3.  C(1, 2) = 0
          def:C n := 1, k := 2, from 1.2

    1.4.  C(1, 2) + C(1, 2 − 1) = C(1 + 1, 2)
          thm:pascal n := 1, k := 2

    1.5.  C(1, 2) + C(1, 1) = C(1 + 1, 2)
          substitute 2 − 1 = 1 (arithmetic) into line 1.4

    1.6.  C(1, 1) = 1
          thm:binomial-of-one m := 1

    1.7.  C(1, 2) + C(1, 1) = 0 + C(1, 1)
          substitute C(1, 2) = 0 (line 1.3)

    1.8.  0 + C(1, 1) = 0 + 1
          substitute C(1, 1) = 1 (line 1.6)

    1.9.  S(1) = C(1 + 1, 2)
          calculation
            S(1) = Σ(j = 1 to 1) j       D1
                 = 1                     1.1
                 = 0 + 1                 arithmetic
                 = 0 + C(1, 1)           1.8
                 = C(1, 2) + C(1, 1)     1.7
                 = C(1 + 1, 2)           1.5

    step
    let k ∈ ℕ                                                         (K)
    assume step 1 is true for k, the induction hypothesis             (IH)

    1.10. Σ(j = 1 to k + 1) j = Σ(j = 1 to k) j + (k + 1)
          mun:sum-extended a := 1, n := k
          requires k ≥ 1: from K

    1.11. S(k + 1) = S(k) + (k + 1)
          calculation
            S(k + 1) = Σ(j = 1 to k + 1) j          D1
                     = Σ(j = 1 to k) j + (k + 1)    1.10
                     = S(k) + (k + 1)               D1

    1.12. S(k) + (k + 1) = C(k + 1, 2) + (k + 1)
          substitute S(k) = C(k + 1, 2) (IH)

    1.13. C(k + 1, 1) = k + 1
          thm:binomial-of-one m := k + 1

    1.14. C(k + 1, 2) + C(k + 1, 2 − 1) = C((k + 1) + 1, 2)
          thm:pascal n := k + 1, k := 2

    1.15. C(k + 1, 2) + C(k + 1, 1) = C((k + 1) + 1, 2)
          substitute 2 − 1 = 1 (arithmetic) into line 1.14

    1.16. C(k + 1, 2) + C(k + 1, 1) = C(k + 1, 2) + (k + 1)
          substitute C(k + 1, 1) = k + 1 (line 1.13)

    1.17. S(k + 1) = C((k + 1) + 1, 2)
          calculation
            S(k + 1) = S(k) + (k + 1)                  1.11
                     = C(k + 1, 2) + (k + 1)           1.12
                     = C(k + 1, 2) + C(k + 1, 1)       1.16
                     = C((k + 1) + 1, 2)               1.15

2.  S(n) = C(n + 1, 2)
    instantiate k := n in line 1

3.  Σ(k = 1 to n) k = C(n + 1, 2)
    calculation
      Σ(k = 1 to n) k = S(n)               D1
                      = C(n + 1, 2)        2
