import mundane theorem    stdlib/numbers/exponent-step
import mundane theorem    stdlib/numbers/power-real
import mundane theorem    stdlib/sums/sum-extended
import mundane theorem    stdlib/sums/sum-single

theorem geometric-sum-base-three
  note        By induction on n: adding 3^(k + 1) to (3^(k + 1) − 3)/2 gives
              (3^(k + 2) − 3)/2, since 3^(k + 2) is 3^(k + 1)·3.
  let n ∈ ℕ                                                           (H1)
  then Σ(k = 1 to n) 3^k = (3^(n + 1) − 3)/2

let S(m) = Σ(j = 1 to m) 3^j, for m ∈ ℕ                               (D1)
       reads the sum of the first m powers of 3

1.  For all k ∈ ℕ, S(k) = (3^(k + 1) − 3)/2.
    induction on k starting at 1

    base
    1.1.  S(1) = (3^(1 + 1) − 3)/2
          calculation
            S(1) = Σ(j = 1 to 1) 3^j    D1
                 = 3^1                  mun:sum-single a := 1
                 = (3^(1 + 1) − 3)/2    arithmetic

    step
    let k ∈ ℕ                                                         (K)
    assume step 1 is true for k, the induction hypothesis             (IH)

    1.2.  S(k + 1) = S(k) + 3^(k + 1)
          calculation
            S(k + 1) = Σ(j = 1 to k + 1) 3^j              D1
                     = Σ(j = 1 to k) 3^j + 3^(k + 1)      mun:sum-extended a := 1, n := k
                     = S(k) + 3^(k + 1)                   D1
          requires k ≥ 1: from K

    1.3.  3^((k + 1) + 1) = 3^(k + 1)·3
          mun:exponent-step a := 3, m := k + 1

    1.4.  S(k + 1) = (3^((k + 1) + 1) − 3)/2
          calculation
            S(k + 1) = S(k) + 3^(k + 1)                    1.2
                     = (3^(k + 1) − 3)/2 + 3^(k + 1)       substitute IH
                     = (3^(k + 1)·3 − 3)/2                 algebra
                     = (3^((k + 1) + 1) − 3)/2             substitute line 1.3
          requires 3^(k + 1) ∈ ℝ: mun:power-real a := 3, m := k + 1

2.  Σ(k = 1 to n) 3^k = (3^(n + 1) − 3)/2
    calculation
      Σ(k = 1 to n) 3^k = S(n)                  D1
                        = (3^(n + 1) − 3)/2     instantiate k := n in line 1
