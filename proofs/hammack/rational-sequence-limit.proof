import definition         stdlib/calculus/tends-to
import theorem            stdlib/numbers/archimedean
import mundane theorem    stdlib/numbers/abs-difference-lt
import mundane theorem    stdlib/numbers/reciprocal-order
import mundane theorem    stdlib/numbers/reciprocal-positive

theorem rational-sequence-limit
  note        a(n) − 2/3 is 5/(9n − 3), which is positive and at most 1/n
              because 5n ≤ 9n − 3. So from N on, with 1/N below ε, a(n)
              is within ε of 2/3.
  ε ranges over ℝ
  n ranges over ℕ
  let a : ℕ → ℝ                                                       (H1)
  assume for all n ∈ ℕ, a(n) = (2n + 1)/(3n − 1)                     (H2)
  then a(n) → 2/3 as n → ∞

1.  For all ε > 0, there exists N ∈ ℕ such that |a(n) − 2/3| < ε for all n ≥ N.
    proof
    let ε ∈ ℝ                                                         (K1)
    assume ε > 0                                                      (A1)

    1.1.  N ∈ ℕ. 1/N < ε.
          obtain N: thm:archimedean x := ε, from A1

    1.2.  For all n ≥ N, |a(n) − 2/3| < ε.
          proof
          let n ∈ ℕ                                                   (K2)
          assume n ≥ N                                                (A2)

          1.2.1.  n ≥ 1
                  inequalities, from K2

          1.2.2.  n > 0
                  inequalities, from K2

          1.2.3.  3n − 1 ≥ 2
                  inequalities
                    n ≥ 1              1.2.1
                    3n ≥ 3             multiplying by 3
                    3n − 1 ≥ 2         adding −1

          1.2.4.  3n − 1 > 0
                  inequalities, from 1.2.3

          1.2.5.  9n − 3 ≥ 5n + 1
                  inequalities
                    n ≥ 1              1.2.1
                    4n ≥ 4             multiplying by 4
                    9n ≥ 5n + 4        adding 5n
                    9n − 3 ≥ 5n + 1    adding −3

          1.2.6.  5n ≤ 9n − 3
                  inequalities, from 1.2.5

          1.2.7.  5n > 0
                  inequalities
                    n > 0              1.2.2
                    5n > 0             multiplying by 5

          1.2.8.  9n − 3 > 0
                  transitivity, from 1.2.7, 1.2.6

          1.2.9.  9n − 3 ≠ 0
                  inequalities
                    9n − 3 > 0         1.2.8
                    9n − 3 ≠ 0         weakening

          1.2.10. a(n) = (2n + 1)/(3n − 1)
                  instantiate n := n in H2

          1.2.11. a(n) − 2/3 = 5·(1/(9n − 3))
                  algebra, from 1.2.10
                  requires 3n − 1 ≠ 0: weakening, from 1.2.4
                  requires 9n − 3 ≠ 0: from 1.2.9

          1.2.12. 1/(9n − 3) > 0
                  mun:reciprocal-positive x := 9n − 3, from 1.2.8

          1.2.13. 5·(1/(9n − 3)) > 0
                  inequalities
                    1/(9n − 3) > 0           1.2.12
                    5·(1/(9n − 3)) > 0       multiplying by 5
                  requires 9n − 3 ≠ 0: from 1.2.9

          1.2.14. a(n) − 2/3 > 0
                  transitivity, from 1.2.13, 1.2.11
                  requires 9n − 3 ≠ 0: from 1.2.9
                  requires a(n) ∈ ℝ: from H1

          1.2.15. a(n) > 2/3
                  inequalities
                    a(n) − 2/3 > 0     1.2.14
                    a(n) > 2/3         adding 2/3
                  requires a(n) ∈ ℝ: from H1

          1.2.16. 2/3 − ε < 2/3
                  inequalities
                    ε > 0              A1
                    −ε < 0             multiplying by −1
                    2/3 − ε < 2/3      adding 2/3

          1.2.17. 2/3 − ε < a(n)
                  transitivity, from 1.2.16, 1.2.15
                  requires a(n) ∈ ℝ: from H1

          1.2.18. 1/(9n − 3) ≤ 1/(5n)
                  mun:reciprocal-order x := 5n, y := 9n − 3, from 1.2.6
                  requires 5n > 0: from 1.2.7
                  requires 9n − 3 > 0: from 1.2.8

          1.2.19. 5·(1/(9n − 3)) ≤ 5·(1/(5n))
                  inequalities
                    1/(9n − 3) ≤ 1/(5n)              1.2.18
                    5·(1/(9n − 3)) ≤ 5·(1/(5n))      multiplying by 5
                  requires 9n − 3 ≠ 0: from 1.2.9

          1.2.20. 5·(1/(5n)) = 1/n
                  algebra

          1.2.21. 1/n ≤ 1/N
                  mun:reciprocal-order x := N, y := n, from A2
                  requires N > 0: inequalities, from 1.1
                  requires n > 0: from 1.2.2

          1.2.22. a(n) − 2/3 < ε
                  transitivity, from 1.2.11, 1.2.19, 1.2.20, 1.2.21, 1.1
                  requires 9n − 3 ≠ 0: from 1.2.9
                  requires a(n) ∈ ℝ: from H1

          1.2.23. a(n) < 2/3 + ε
                  inequalities
                    a(n) − 2/3 < ε          1.2.22
                    a(n) < 2/3 + ε          adding 2/3
                  requires a(n) ∈ ℝ: from H1

          1.2.24. 2/3 − ε < a(n) and a(n) < 2/3 + ε
                  join 1.2.17, 1.2.23

          1.2.25. |a(n) − 2/3| < ε
                  mun:abs-difference-lt x := a(n), c := 2/3, δ := ε, from 1.2.24
                  requires a(n) ∈ ℝ: from H1

    1.3.  There exists N ∈ ℕ such that |a(n) − 2/3| < ε for all n ≥ N.
          exhibit, from 1.2

2.  a(n) → 2/3 as n → ∞
    def:tends-to L := 2/3, from 1
