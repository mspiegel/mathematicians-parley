import mundane theorem    stdlib/numbers/pos-int-nat
import mundane theorem    stdlib/sums/sum-single
import mundane theorem    stdlib/sums/sum-extended
import theorem            proofs/hammack/fibonacci-numbers/fibonacci-natural
import theorem            proofs/hammack/fibonacci-numbers/fibonacci-recurrence

theorem fibonacci-odd-sum
  note        By induction on n: the sum to 1 is F(1) = 1 = F(2), and adding
              F(2n + 1) to F(2n) gives F(2n + 2), since each Fibonacci
              number is the sum of the two before it.
  let n ∈ ℕ                                                           (H1)
  let F(0) = 0,  G(0) = 1,
      F(k + 1) = G(k),  G(k + 1) = F(k) + G(k),  for k ∈ ℕ₀           (D1)
         reads the Fibonacci numbers, F(k) the kth and G(k) the next
  then Σ(k = 1 to n) F(2k − 1) = F(2n)

1.  For all k ∈ ℕ₀, F(k) ∈ ℕ₀ and G(k) ∈ ℕ₀.
    thm:fibonacci-natural

2.  For all k ∈ ℕ₀, F(k) ∈ ℝ.
    proof
    let k ∈ ℕ₀                                                        (K1)

    2.1.  F(k) ∈ ℝ
          membership, from 1

3.  For all k ∈ ℕ, 2k − 1 ∈ ℕ.
    proof
    let k ∈ ℕ                                                         (K2)

    3.1.  0 < 2k − 1
          inequalities, from K2

    3.2.  2k − 1 ∈ ℕ
          mun:pos-int-nat m := 2k − 1, from 3.1

let q(k) = F(2k − 1), for k ∈ ℕ                                       (D2)
       reads the odd-numbered Fibonacci number F(2k − 1)

4.  For all k ∈ ℕ₀, F(k + 2) = F(k) + F(k + 1).
    thm:fibonacci-recurrence

5.  For all m ∈ ℕ, Σ(j = 1 to m) q(j) = F(2m).
    induction on m starting at 1

    base
    5.1.  For all i ∈ {1, …, 1}, q(i) ∈ ℝ.
          proof
          let i ∈ {1, …, 1}                                           (J1)

          5.1.1.  2i − 1 ∈ ℕ
                  instantiate k := i in line 3

          5.1.2.  F(2i − 1) ∈ ℝ
                  instantiate k := 2i − 1 in line 2, from 5.1.1

          5.1.3.  q(i) ∈ ℝ
                  membership, from D2, 5.1.2

    5.2.  F(0 + 1) = G(0)
          D1

    5.3.  G(0) = 1
          D1

    5.4.  F(0) = 0
          D1

    5.5.  F(0 + 1) = 1
          calculation
            F(0 + 1) = G(0)    5.2
                     = 1       5.3

    5.6.  F(1) = 1
          calculation
            F(1) = F(0 + 1)    arithmetic
                 = 1           5.5

    5.7.  F(0 + 2) = F(0) + F(0 + 1)
          instantiate k := 0 in line 4

    5.8.  F(1 + 1) = 1
          calculation
            F(1 + 1) = F(0 + 2)    arithmetic
                     = 1           algebra, from 5.4, 5.5, 5.7

    5.9.  Σ(j = 1 to 1) q(j) = F(2·1)
          calculation
            Σ(j = 1 to 1) q(j) = q(1)           mun:sum-single a := 1
                               = F(2·1 − 1)     D2
                               = F(1)           arithmetic
                               = 1              5.6
                               = F(1 + 1)       5.8
                               = F(2·1)         arithmetic
          requires for all i ∈ {1, …, 1}, q(i) ∈ ℝ: from 5.1

    step
    let m ∈ ℕ                                                         (K4)
    assume step 5 is true for m, the induction hypothesis             (IH2)

    5.10. For all i ∈ {1, …, m + 1}, q(i) ∈ ℝ.
          proof
          let i ∈ {1, …, m + 1}                                       (J2)

          5.10.1. 2i − 1 ∈ ℕ
                  instantiate k := i in line 3

          5.10.2. F(2i − 1) ∈ ℝ
                  instantiate k := 2i − 1 in line 2, from 5.10.1

          5.10.3. q(i) ∈ ℝ
                  membership, from D2, 5.10.2

    5.11. q(m + 1) = F(2(m + 1) − 1)
          D2

    5.12. q(m + 1) = F(2m + 1)
          substitute
            q(m + 1) = F(2(m + 1) − 1)      5.11
            q(m + 1) = F(2m + 1)            algebra

    5.13. F(2m + 2) = F(2m) + F(2m + 1)
          instantiate k := 2m in line 4

    5.14. F(2(m + 1)) = F(2m) + F(2m + 1)
          substitute
            F(2m + 2) = F(2m) + F(2m + 1)        5.13
            F(2(m + 1)) = F(2m) + F(2m + 1)      algebra

    5.15. Σ(j = 1 to m + 1) q(j) = F(2(m + 1))
          calculation
            Σ(j = 1 to m + 1) q(j) = Σ(j = 1 to m) q(j) + q(m + 1)    mun:sum-extended a := 1, n := m
                                   = F(2m) + q(m + 1)                 substitute IH2
                                   = F(2m) + F(2m + 1)                substitute line 5.12
                                   = F(2(m + 1))                      5.14
          requires m ≥ 1: from K4
          requires for all i ∈ {1, …, m + 1}, q(i) ∈ ℝ: from 5.10

6.  Σ(k = 1 to n) F(2k − 1) = F(2n)
    instantiate m := n in line 5, from D2
