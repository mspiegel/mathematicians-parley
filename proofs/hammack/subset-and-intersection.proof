import mundane definition stdlib/sets/intersection
import mundane definition stdlib/sets/subset
import mundane theorem    stdlib/sets/in-subset
import mundane theorem    stdlib/sets/subset-antisymmetric

theorem subset-iff-intersection
  note        If A is inside B then intersecting with B removes nothing from
              A. Conversely, if A ∩ B is all of A then every element of A is
              in B.
  let A be a set                                                      (H1)
  let B be a set                                                      (H2)
  then A ⊆ B ↔ A ∩ B = A

1.  A ⊆ B ↔ A ∩ B = A
    both directions

    direction
    assume A ⊆ B                                                      (D1)

    1.1.  For all t ∈ A ∩ B, t ∈ A.
          proof
          let t ∈ A ∩ B                                               (K1)

          1.1.1.  t ∈ A
                  mun:intersection u := t, Y := A, Z := B, from K1

    1.2.  A ∩ B ⊆ A
          mun:subset, from 1.1

    1.3.  For all t ∈ A, t ∈ A ∩ B.
          proof
          let t ∈ A                                                   (K2)

          1.3.1.  t ∈ B
                  mun:in-subset X := A, Y := B, u := t, from D1, K2

          1.3.2.  t ∈ A ∩ B
                  mun:intersection u := t, Y := A, Z := B, from K2, 1.3.1

    1.4.  A ⊆ A ∩ B
          mun:subset, from 1.3

    1.5.  A ∩ B = A
          mun:subset-antisymmetric, from 1.2, 1.4

    direction
    assume A ∩ B = A                                                  (D2)

    1.6.  For all t ∈ A, t ∈ B.
          proof
          let t ∈ A                                                   (K3)

          1.6.1.  t ∈ A ∩ B
                  substitute A ∩ B = A (D2) into K3

          1.6.2.  t ∈ B
                  mun:intersection u := t, Y := A, Z := B, from 1.6.1

    1.7.  A ⊆ B
          mun:subset, from 1.6
