import definition         stdlib/sets/intersection
import definition         stdlib/sets/subset
import mundane theorem    stdlib/sets/in-subset
import mundane theorem    stdlib/sets/subset-antisymmetric

theorem subset-iff-intersection
  note        If A is inside B then intersecting with B removes nothing from
              A. Conversely, if A ∩ B is all of A then every element of A is
              in B.
  let A be a set                                                      (H1)
  let B be a set                                                      (H2)
  then A ⊆ B ↔ A ∩ B = A
  by          both directions

direction
assume A ⊆ B                                                          (D1)

1.  For all t ∈ A ∩ B, t ∈ A.
    proof
    let t ∈ A ∩ B                                                     (K1)

    1.1.  t ∈ A
          def:intersection u := t, Y := A, Z := B, from K1

2.  A ∩ B ⊆ A
    def:subset, from 1

3.  For all t ∈ A, t ∈ A ∩ B.
    proof
    let t ∈ A                                                         (K2)

    3.1.  t ∈ B
          mun:in-subset X := A, Y := B, u := t, from D1, K2

    3.2.  t ∈ A ∩ B
          def:intersection u := t, Y := A, Z := B, from K2, 3.1

4.  A ⊆ A ∩ B
    def:subset, from 3

5.  A ∩ B = A
    mun:subset-antisymmetric, from 2, 4

direction
assume A ∩ B = A                                                      (D2)

6.  For all t ∈ A, t ∈ B.
    proof
    let t ∈ A                                                         (K3)

    6.1.  t ∈ A ∩ B
          substitute A ∩ B = A (D2) into K3

    6.2.  t ∈ B
          def:intersection u := t, Y := A, Z := B, from 6.1

7.  A ⊆ B
    def:subset, from 6
