import mundane definition stdlib/divisibility/divides
import mundane definition stdlib/divisibility/congruent-mod

theorem cube-of-sum-mod-three
  note        The difference (a + b)³ − (a³ + b³) is 3a²b + 3ab², which is
              3 times a whole number.
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  then (a + b)³ ≡ a³ + b³ (mod 3)

1.  (a + b)³ − (a³ + b³) = 3·(a²·b + a·b²)
    algebra

2.  3 divides (a + b)³ − (a³ + b³)
    mun:divides d := 3, n := (a + b)³ − (a³ + b³), from 1

3.  (a + b)³ ≡ a³ + b³ (mod 3)
    mun:congruent-mod n := 3, from 2
