import mundane definition stdlib/sets/difference
import mundane definition stdlib/sets/intersection
import mundane definition stdlib/sets/subset
import mundane theorem    stdlib/sets/subset-antisymmetric

theorem intersection-then-difference
  note        Taking C from A ∩ B takes it from each of A and B, and what is
              in both A and B and outside C is in both A ∖ C and B ∖ C.
  let A be a set                                                      (H1)
  let B be a set                                                      (H2)
  let C be a set                                                      (H3)
  then (A ∩ B) ∖ C = (A ∖ C) ∩ (B ∖ C)

1.  For all t ∈ (A ∩ B) ∖ C, t ∈ (A ∖ C) ∩ (B ∖ C).
    proof
    let t ∈ (A ∩ B) ∖ C                                               (K1)

    1.1.  t ∈ A ∩ B. t ∉ C.
          mun:difference u := t, Y := A ∩ B, Z := C, from K1

    1.2.  t ∈ A. t ∈ B.
          mun:intersection u := t, Y := A, Z := B, from 1.1

    1.3.  t ∈ A ∖ C
          mun:difference u := t, Y := A, Z := C, from 1.1, 1.2

    1.4.  t ∈ B ∖ C
          mun:difference u := t, Y := B, Z := C, from 1.1, 1.2

    1.5.  t ∈ (A ∖ C) ∩ (B ∖ C)
          mun:intersection u := t, Y := A ∖ C, Z := B ∖ C, from 1.3, 1.4

2.  (A ∩ B) ∖ C ⊆ (A ∖ C) ∩ (B ∖ C)
    mun:subset, from 1

3.  For all t ∈ (A ∖ C) ∩ (B ∖ C), t ∈ (A ∩ B) ∖ C.
    proof
    let t ∈ (A ∖ C) ∩ (B ∖ C)                                         (K2)

    3.1.  t ∈ A ∖ C. t ∈ B ∖ C.
          mun:intersection u := t, Y := A ∖ C, Z := B ∖ C, from K2

    3.2.  t ∈ A. t ∉ C.
          mun:difference u := t, Y := A, Z := C, from 3.1

    3.3.  t ∈ B
          mun:difference u := t, Y := B, Z := C, from 3.1

    3.4.  t ∈ A ∩ B
          mun:intersection u := t, Y := A, Z := B, from 3.2, 3.3

    3.5.  t ∈ (A ∩ B) ∖ C
          mun:difference u := t, Y := A ∩ B, Z := C, from 3.2, 3.4

4.  (A ∖ C) ∩ (B ∖ C) ⊆ (A ∩ B) ∖ C
    mun:subset, from 3

5.  (A ∩ B) ∖ C = (A ∖ C) ∩ (B ∖ C)
    mun:subset-antisymmetric, from 2, 4
