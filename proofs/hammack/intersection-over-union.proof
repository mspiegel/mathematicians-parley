import definition         stdlib/sets/intersection
import definition         stdlib/sets/subset
import definition         stdlib/sets/union
import mundane theorem    stdlib/sets/in-union-left
import mundane theorem    stdlib/sets/in-union-right
import mundane theorem    stdlib/sets/subset-antisymmetric

theorem intersection-over-union
  note        An element of A and of B ∪ C is in A and in B, or in A and in C.
              Conversely, being in A ∩ B or in A ∩ C puts it in A and in B ∪ C.
  let A be a set                                                      (H1)
  let B be a set                                                      (H2)
  let C be a set                                                      (H3)
  then A ∩ (B ∪ C) = (A ∩ B) ∪ (A ∩ C)

1.  For all t ∈ A ∩ (B ∪ C), t ∈ (A ∩ B) ∪ (A ∩ C).
    proof
    let t ∈ A ∩ (B ∪ C)                                               (K1)

    1.1.  t ∈ A. t ∈ B ∪ C.
          def:intersection u := t, Y := A, Z := B ∪ C, from K1

    1.2.  t ∈ B or t ∈ C
          def:union u := t, Y := B, Z := C, from 1.1

    1.3.  t ∈ (A ∩ B) ∪ (A ∩ C)
          cases, from 1.2

          case
          assume t ∈ B                                                (C1)

          1.3.1.  t ∈ A ∩ B
                  def:intersection u := t, Y := A, Z := B, from C1, 1.1

          1.3.2.  t ∈ (A ∩ B) ∪ (A ∩ C)
                  mun:in-union-left u := t, Y := A ∩ B, Z := A ∩ C, from 1.3.1

          case
          assume t ∈ C                                                (C2)

          1.3.3.  t ∈ A ∩ C
                  def:intersection u := t, Y := A, Z := C, from C2, 1.1

          1.3.4.  t ∈ (A ∩ B) ∪ (A ∩ C)
                  mun:in-union-right u := t, Y := A ∩ B, Z := A ∩ C, from 1.3.3

2.  A ∩ (B ∪ C) ⊆ (A ∩ B) ∪ (A ∩ C)
    def:subset, from 1

3.  For all t ∈ (A ∩ B) ∪ (A ∩ C), t ∈ A ∩ (B ∪ C).
    proof
    let t ∈ (A ∩ B) ∪ (A ∩ C)                                         (K2)

    3.1.  t ∈ A ∩ B or t ∈ A ∩ C
          def:union u := t, Y := A ∩ B, Z := A ∩ C, from K2

    3.2.  t ∈ A ∩ (B ∪ C)
          cases, from 3.1

          case
          assume t ∈ A ∩ B                                            (C3)

          3.2.1.  t ∈ A. t ∈ B.
                  def:intersection u := t, Y := A, Z := B, from C3

          3.2.2.  t ∈ B ∪ C
                  mun:in-union-left u := t, Y := B, Z := C, from 3.2.1

          3.2.3.  t ∈ A ∩ (B ∪ C)
                  def:intersection u := t, Y := A, Z := B ∪ C, from 3.2.1, 3.2.2

          case
          assume t ∈ A ∩ C                                            (C4)

          3.2.4.  t ∈ A. t ∈ C.
                  def:intersection u := t, Y := A, Z := C, from C4

          3.2.5.  t ∈ B ∪ C
                  mun:in-union-right u := t, Y := B, Z := C, from 3.2.4

          3.2.6.  t ∈ A ∩ (B ∪ C)
                  def:intersection u := t, Y := A, Z := B ∪ C, from 3.2.4, 3.2.5

4.  (A ∩ B) ∪ (A ∩ C) ⊆ A ∩ (B ∪ C)
    def:subset, from 3

5.  A ∩ (B ∪ C) = (A ∩ B) ∪ (A ∩ C)
    mun:subset-antisymmetric, from 2, 4
