import definition         stdlib/counting/C
import theorem            stdlib/counting/pascal
import mundane theorem    stdlib/counting/binomial-nat0
import mundane theorem    stdlib/sums/sum-extended
import mundane theorem    stdlib/sums/sum-single

theorem weighted-binomial-column-sum
  note        By induction on n, from 0: adding (n + 1)·C(m + n + 1, m) to
              n·C(m + n + 1, m + 1) − C(m + n + 1, m + 2) and applying
              Pascal's rule to C(m + n + 2, m + 1) and C(m + n + 2, m + 2)
              gives (n + 1)·C(m + n + 2, m + 1) − C(m + n + 2, m + 2).
  let m ∈ ℕ                                                           (H1)
  let n ∈ ℕ                                                           (H2)
  then Σ(k = 0 to n) k·C(m + k, m) = n·C(m + n + 1, m + 1) − C(m + n + 1, m + 2)

1.  For all j ∈ ℕ₀, Σ(k = 0 to j) k·C(m + k, m) = j·C(m + j + 1, m + 1) − C(m + j + 1, m + 2).
    induction on j starting at 0

    base
    1.1.  Σ(k = 0 to 0) k·C(m + k, m) = 0·C(m + 0, m)
          mun:sum-single a := 0

    1.2.  m + 0 + 1 < m + 2
          inequalities

    1.3.  C(m + 0 + 1, m + 2) = 0
          def:C n := m + 0 + 1, k := m + 2, from 1.2

    1.4.  Σ(k = 0 to 0) k·C(m + k, m) = 0·C(m + 0 + 1, m + 1) − C(m + 0 + 1, m + 2)
          algebra, from 1.1, 1.3
          requires C(m + 0, m) ∈ ℕ₀: mun:binomial-nat0
          requires C(m + 0 + 1, m + 1) ∈ ℕ₀: mun:binomial-nat0

    step
    let j ∈ ℕ₀                                                        (K)
    assume step 1 is true for j, the induction hypothesis             (IH)

    1.5.  Σ(k = 0 to j + 1) k·C(m + k, m) = Σ(k = 0 to j) k·C(m + k, m) + (j + 1)·C(m + (j + 1), m)
          mun:sum-extended a := 0, n := j
          requires j ≥ 0: from K

    1.6.  m + (j + 1) = m + j + 1
          algebra

    1.7.  Σ(k = 0 to j + 1) k·C(m + k, m) = Σ(k = 0 to j) k·C(m + k, m) + (j + 1)·C(m + j + 1, m)
          substitute m + (j + 1) = m + j + 1 (line 1.6) into line 1.5

    1.8.  C(m + j + 1, m + 1) + C(m + j + 1, (m + 1) − 1) = C((m + j + 1) + 1, m + 1)
          thm:pascal n := m + j + 1, k := m + 1

    1.9.  (m + 1) − 1 = m
          algebra

    1.10. C(m + j + 1, m + 1) + C(m + j + 1, m) = C((m + j + 1) + 1, m + 1)
          substitute (m + 1) − 1 = m (line 1.9) into line 1.8

    1.11. C(m + j + 1, m + 2) + C(m + j + 1, (m + 2) − 1) = C((m + j + 1) + 1, m + 2)
          thm:pascal n := m + j + 1, k := m + 2

    1.12. (m + 2) − 1 = m + 1
          algebra

    1.13. C(m + j + 1, m + 2) + C(m + j + 1, m + 1) = C((m + j + 1) + 1, m + 2)
          substitute (m + 2) − 1 = m + 1 (line 1.12) into line 1.11

    1.14. Σ(k = 0 to j + 1) k·C(m + k, m) = (j + 1)·C((m + j + 1) + 1, m + 1) − C((m + j + 1) + 1, m + 2)
          algebra, from IH, 1.7, 1.10, 1.13
          requires C(m + j + 1, m) ∈ ℕ₀: mun:binomial-nat0
          requires C(m + j + 1, m + 1) ∈ ℕ₀: mun:binomial-nat0
          requires C(m + j + 1, m + 2) ∈ ℕ₀: mun:binomial-nat0

    1.15. (m + j + 1) + 1 = m + (j + 1) + 1
          algebra

    1.16. Σ(k = 0 to j + 1) k·C(m + k, m) = (j + 1)·C(m + (j + 1) + 1, m + 1) − C(m + (j + 1) + 1, m + 2)
          substitute (m + j + 1) + 1 = m + (j + 1) + 1 (line 1.15) into line 1.14

2.  Σ(k = 0 to n) k·C(m + k, m) = n·C(m + n + 1, m + 1) − C(m + n + 1, m + 2)
    instantiate j := n in line 1
