import definition         stdlib/calculus/limit-at
import mundane theorem    stdlib/sets/subset-self
import mundane theorem    stdlib/numbers/abs-difference-lt
import mundane theorem    stdlib/functions/function-value

theorem four-x-plus-six-limit
  note        4x + 6 is within ε of 2 wherever x is within ε/4 of −1.
  ε, δ range over ℝ
  let f : ℝ → ℝ                                                       (H1)
  assume for all x ∈ ℝ, f(x) = 4x + 6                                (H2)
  then f tends to 2 at −1

1.  For all ε > 0, there exists δ > 0 such that |f(x) − 2| < ε for all x ∈ ℝ with (x ≠ −1 and |x − (−1)| < δ).
    proof
    let ε ∈ ℝ                                                         (K1)
    assume ε > 0                                                      (A1)

    1.1.  ε/4 > 0
          inequalities
            ε > 0              A1
            ε/4 > 0            multiplying by 1/4

    1.2.  For all x ∈ ℝ with (x ≠ −1 and |x − (−1)| < ε/4), |f(x) − 2| < ε.
          proof
          let x ∈ ℝ                                                   (K2)
          assume x ≠ −1 and |x − (−1)| < ε/4                          (A2)

          1.2.1.  f(x) = 4x + 6
                  instantiate x := x in H2

          1.2.2.  −1 − ε/4 < x and x < −1 + ε/4
                  mun:abs-difference-lt c := −1, δ := ε/4, from A2

          1.2.3.  2 − ε < 4x + 6
                  inequalities
                    −1 − ε/4 < x       1.2.2
                    −4 − ε < 4x        multiplying by 4
                    2 − ε < 4x + 6     adding 6

          1.2.4.  2 − ε < f(x)
                  transitivity, from 1.2.3, 1.2.1

          1.2.5.  4x + 6 < 2 + ε
                  inequalities
                    x < −1 + ε/4       1.2.2
                    4x < −4 + ε        multiplying by 4
                    4x + 6 < 2 + ε     adding 6

          1.2.6.  f(x) < 2 + ε
                  transitivity, from 1.2.1, 1.2.5

          1.2.7.  2 − ε < f(x) and f(x) < 2 + ε
                  join 1.2.4, 1.2.6

          1.2.8.  |f(x) − 2| < ε
                  mun:abs-difference-lt x := f(x), c := 2, δ := ε, from 1.2.7
                  requires f(x) ∈ ℝ: mun:function-value

    1.3.  There exists δ > 0 such that |f(x) − 2| < ε for all x ∈ ℝ with (x ≠ −1 and |x − (−1)| < δ).
          exhibit, from 1.1, 1.2

2.  f tends to 2 at −1
    def:limit-at D := ℝ, c := −1, L := 2, from 1
    requires ℝ ⊆ ℝ: mun:subset-self
