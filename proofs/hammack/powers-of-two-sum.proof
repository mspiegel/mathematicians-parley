import mundane theorem    stdlib/numbers/exponent-step
import mundane theorem    stdlib/sums/sum-extended
import mundane theorem    stdlib/sums/sum-single

theorem powers-of-two-sum
  note        By induction on n: adding 2^(k + 1) to 2^(k + 1) − 2 gives
              2·2^(k + 1) − 2, which is 2^(k + 2) − 2.
  let n ∈ ℕ                                                           (H1)
  then Σ(k = 1 to n) 2^k = 2^(n + 1) − 2

let S(m) = Σ(j = 1 to m) 2^j, for m ∈ ℕ                               (D1)
       reads the sum of the first m powers of 2

1.  For all k ∈ ℕ, S(k) = 2^(k + 1) − 2.
    induction on k starting at 1

    base
    1.1.  S(1) = 2^(1 + 1) − 2
          calculation
            S(1) = Σ(j = 1 to 1) 2^j     D1
                 = 2^1                   mun:sum-single a := 1
                 = 2^(1 + 1) − 2         arithmetic

    step
    let k ∈ ℕ                                                         (K)
    assume step 1 is true for k, the induction hypothesis             (IH)

    1.2.  S(k + 1) = S(k) + 2^(k + 1)
          calculation
            S(k + 1) = Σ(j = 1 to k + 1) 2^j              D1
                     = Σ(j = 1 to k) 2^j + 2^(k + 1)      mun:sum-extended a := 1, n := k
                     = S(k) + 2^(k + 1)                   D1
          requires k ≥ 1: from K

    1.3.  2^((k + 1) + 1) = 2^(k + 1)·2
          mun:exponent-step m := k + 1

    1.4.  S(k + 1) = 2^((k + 1) + 1) − 2
          calculation
            S(k + 1) = S(k) + 2^(k + 1)                   1.2
                     = 2^(k + 1) − 2 + 2^(k + 1)          substitute IH
                     = 2^(k + 1)·2 − 2                    algebra
                     = 2^((k + 1) + 1) − 2                substitute line 1.3

2.  Σ(k = 1 to n) 2^k = 2^(n + 1) − 2
    calculation
      Σ(k = 1 to n) 2^k = S(n)              D1
                        = 2^(n + 1) − 2     instantiate k := n in line 1
