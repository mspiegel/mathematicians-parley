import mundane definition stdlib/logarithms/ln
import mundane theorem    stdlib/logarithms/ln-power
import mundane theorem    stdlib/logarithms/exp-ln
import mundane definition stdlib/logarithms/exp
import mundane definition stdlib/divisibility/even
import mundane definition stdlib/divisibility/odd
import mundane theorem    stdlib/divisibility/odd-not-even
import mundane definition stdlib/numbers/irrational
import mundane definition stdlib/numbers/rational
import mundane theorem    stdlib/numbers/exponent-step
import mundane theorem    stdlib/numbers/nat-minus-one
import mundane theorem    stdlib/numbers/power-integer
import mundane theorem    stdlib/numbers/power-real
import mundane theorem    stdlib/numbers/quotient-real
import mundane theorem    stdlib/numbers/power-positive
import mundane theorem    stdlib/numbers/pos-int-nat
import mundane theorem    stdlib/numbers/product-positive
import mundane theorem    stdlib/numbers/quotient-positive

theorem power-of-three-odd
  note        3^0 is 1, and 3^(j + 1) is 3·3^j, which is 2(3k + 1) + 1 when
              3^j is 2k + 1.
  let n ∈ ℕ₀                                                          (H1)
  then 3^n is odd

1.  For all j ∈ ℕ₀, 3^j is odd.
    induction on j starting at 0

    base
    1.1.  3^0 = 2·0 + 1
          arithmetic

    1.2.  3^0 is odd
          mun:odd n := 3^0, from 1.1

    step
    let j ∈ ℕ₀                                                        (K)
    assume step 1 is true for j, the induction hypothesis             (IH)

    1.3.  k ∈ ℤ. 3^j = 2k + 1.
          obtain k: mun:odd n := 3^j, from IH

    1.4.  3^(j + 1) = 3^j·3
          mun:exponent-step a := 3, m := j

    1.5.  3^j·3 = (2k + 1)·3
          substitute 3^j = 2k + 1 (line 1.3)

    1.6.  (2k + 1)·3 = 2(3k + 1) + 1
          algebra

    1.7.  3^(j + 1) = 2(3k + 1) + 1
          calculation
            3^(j + 1) = 3^j·3              1.4
                      = (2k + 1)·3         1.5
                      = 2(3k + 1) + 1      1.6

    1.8.  3^(j + 1) is odd
          mun:odd n := 3^(j + 1), from 1.7
          requires 3^(j + 1) ∈ ℤ: mun:power-integer a := 3, m := j + 1

2.  3^n is odd
    instantiate j := n in line 1


theorem power-of-two-even
  note        2^n is 2^(n − 1)·2, since n − 1 is a whole number and
              (n − 1) + 1 is n.
  let n ∈ ℕ                                                           (H1)
  then 2^n is even

1.  n − 1 ∈ ℕ₀
    mun:nat-minus-one

2.  2^((n − 1) + 1) = 2^(n − 1)·2
    mun:exponent-step a := 2, m := n − 1, from 1

3.  (n − 1) + 1 = n
    algebra

4.  2^n = 2^(n − 1)·2
    substitute (n − 1) + 1 = n (line 3) into line 2

5.  2^n = 2·2^(n − 1)
    algebra, from 4
    requires 2^(n − 1) ∈ ℝ: mun:power-real a := 2, m := n − 1, from 1

6.  2^(n − 1) ∈ ℤ
    mun:power-integer a := 2, m := n − 1, from 1

7.  2^n is even
    mun:even n := 2^n, from 5, 6


theorem log-three-over-two-irrational
  note        If ln(3)/ln(2) were p/q then q·ln(3) = p·ln(2), so ln(3^q) is
              ln(2^p) and 3^q is 2^p, which is odd on one side and even on
              the other.
  then ln(3)/ln(2) is irrational

1.  ln(3)/ln(2) > 0
    mun:quotient-positive x := ln(3), y := ln(2)
    requires ln(3) > 0: real arithmetic
    requires ln(2) > 0: real arithmetic

2.  ln(3)/ln(2) ∉ ℚ
    contradiction
    suppose ln(3)/ln(2) ∈ ℚ                                           (S)

    2.1.  p ∈ ℤ. q ∈ ℕ. ln(3)/ln(2) = p/q.
          obtain p, q: mun:rational x := ln(3)/ln(2), from S

    2.2.  p = (ln(3)/ln(2))·q
          algebra, from 2.1
          requires ln(2) ≠ 0: real arithmetic

    2.3.  (ln(3)/ln(2))·q > 0
          mun:product-positive x := ln(3)/ln(2), y := q, from 1, 2.1
          requires ln(2) ≠ 0: real arithmetic

    2.4.  p > 0
          substitute (ln(3)/ln(2))·q = p (line 2.2) into line 2.3

    2.5.  p ∈ ℕ
          mun:pos-int-nat m := p, from 2.4

    2.6.  q·ln(3) = p·ln(2)
          algebra, from 2.1
          requires ln(2) ≠ 0: real arithmetic

    2.7.  ln(3^q) = q·ln(3)
          mun:ln-power x := 3, n := q
          requires 3 > 0: arithmetic

    2.8.  ln(2^p) = p·ln(2)
          mun:ln-power x := 2, n := p
          requires 2 > 0: arithmetic

    2.9.  ln(3^q) = ln(2^p)
          calculation
            ln(3^q) = q·ln(3)    2.7
                    = p·ln(2)    2.6
                    = ln(2^p)    2.8

    2.10. 3^q > 0
          mun:power-positive a := 3, m := q
          requires 3 > 0: arithmetic

    2.11. 2^p > 0
          mun:power-positive a := 2, m := p
          requires 2 > 0: arithmetic

    2.12. exp(ln(3^q)) = 3^q
          mun:exp-ln x := 3^q, from 2.10

    2.13. exp(ln(2^p)) = 2^p
          mun:exp-ln x := 2^p, from 2.5, 2.11

    2.14. exp(ln(3^q)) = exp(ln(2^p))
          substitute ln(3^q) = ln(2^p) (line 2.9)

    2.15. 3^q = 2^p
          calculation
            3^q = exp(ln(3^q))    2.12
                = exp(ln(2^p))    2.14
                = 2^p             2.13

    2.16. 3^q is odd
          thm:power-of-three-odd n := q

    2.17. 2^p is even
          thm:power-of-two-even n := p, from 2.5

    2.18. 3^q is even
          substitute 2^p = 3^q (line 2.15) into line 2.17

    2.19. not (3^q is even)
          mun:odd-not-even n := 3^q, from 2.16, contradicting 2.18

3.  ln(3)/ln(2) ∈ ℝ
    mun:quotient-real x := ln(3), y := ln(2)
    requires ln(2) ≠ 0: real arithmetic

4.  ln(3)/ln(2) is irrational
    mun:irrational x := ln(3)/ln(2), from 2, 3
