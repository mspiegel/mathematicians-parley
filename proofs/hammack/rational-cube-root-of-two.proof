import theorem            proofs/wiedijk/sqrt2-irrational/lowest-terms
import mundane definition stdlib/divisibility/divides
import mundane definition stdlib/divisibility/even
import mundane definition stdlib/divisibility/odd
import mundane theorem    stdlib/divisibility/even-or-odd
import mundane theorem    stdlib/divisibility/not-both
import mundane theorem    stdlib/reasoning/disjunctive-syllogism

theorem odd-cube
  note        An odd number is 2k + 1, and its cube 8k³ + 12k² + 6k + 1 is
              twice 4k³ + 6k² + 3k, plus 1.
  let n ∈ ℤ                                                           (H1)
  assume n is odd                                                     (H2)
  then n³ is odd

1.  k ∈ ℤ. n = 2k + 1.
    obtain k: mun:odd, from H2

2.  n³ = (2k + 1)³
    substitute n = 2k + 1 (line 1)

3.  (2k + 1)³ = 2(4k³ + 6k² + 3k) + 1
    algebra

4.  n³ = 2(4k³ + 6k² + 3k) + 1
    transitivity, from 2, 3

5.  n³ is odd
    mun:odd n := n³, from 4


theorem even-cube
  note        If n were odd, its cube would be odd by odd-cube, and n³ is
              even. Every integer is even or odd, so n is even.
  let n ∈ ℤ                                                           (H1)
  assume n³ is even                                                   (H2)
  then n is even

1.  n is not odd
    contradiction
    suppose n is odd                                                  (S)

    1.1.  n³ is odd
          thm:odd-cube, from S

    1.2.  n³ is not odd
          mun:not-both n := n³, from H2, contradicting 1.1

2.  n is even or n is odd
    mun:even-or-odd

3.  n is even
    mun:disjunctive-syllogism P := n is even, Q := n is odd, from 1, 2


theorem rational-cube-root-of-two
  note        Suppose x³ = 2 with x = p/q in lowest terms. Then p³ = 2q³,
              so p is even, p = 2r, and q³ = 4r³ makes q even too, so 2
              divides both p and q, which lowest terms rules out.
  then not (there is x ∈ ℚ with x³ = 2)

1.  not (there is x ∈ ℚ with x³ = 2)
    contradiction
    suppose there is x ∈ ℚ with x³ = 2                                (S)

    1.1.  x ∈ ℚ. x³ = 2.
          obtain x from S

    1.2.  p ∈ ℤ. q ∈ ℤ. q > 0. x = p/q.
          There is no d ∈ ℤ with d > 1, d divides p, and d divides q.
          obtain p, q: thm:lowest-terms x := x

    1.3.  (p/q)³ = 2
          substitute x = p/q (line 1.2) into line 1.1

    1.4.  p³ = 2q³
          algebra, from 1.3
          requires q ≠ 0: weakening, from 1.2

    1.5.  p³ is even
          mun:even n := p³, from 1.4

    1.6.  p is even
          thm:even-cube n := p, from 1.5

    1.7.  r ∈ ℤ. p = 2r.
          obtain r: mun:even n := p, from 1.6

    1.8.  (2r)³ = 2q³
          substitute p = 2r (line 1.7) into line 1.4

    1.9.  q³ = 2(2r³)
          algebra, from 1.8

    1.10. q³ is even
          mun:even n := q³, from 1.9

    1.11. q is even
          thm:even-cube n := q, from 1.10

    1.12. s ∈ ℤ. q = 2s.
          obtain s: mun:even n := q, from 1.11

    1.13. 2 divides p
          mun:divides d := 2, n := p, from 1.7

    1.14. 2 divides q
          mun:divides d := 2, n := q, from 1.12

    1.15. There is d ∈ ℤ with d > 1, d divides p, and d divides q.
          exhibit, from 1.13, 1.14, contradicting 1.2
          requires 2 > 1: arithmetic
