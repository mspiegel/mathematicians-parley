import definition         stdlib/sets/difference
import mundane theorem    stdlib/sets/disjoint-empty

theorem set-meets-what-it-lacks-in-nothing
  note        Nothing in B ∖ A is in A.
  let A be a set                                                      (H1)
  let B be a set                                                      (H2)
  then A ∩ (B ∖ A) = ∅

1.  For all s ∈ B ∖ A, s ∉ A.
    proof
    let s ∈ B ∖ A                                                     (K1)

    1.1.  s ∉ A
          def:difference u := s, Y := B, Z := A, from K1

2.  A ∩ (B ∖ A) = ∅
    mun:disjoint-empty Y := A, Z := B ∖ A, from 1
