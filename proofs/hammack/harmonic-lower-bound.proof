import mundane theorem    stdlib/sums/sum-split
import mundane theorem    stdlib/sums/sum-le
import mundane theorem    stdlib/sums/sum-constant
import mundane theorem    stdlib/sums/sum-single
import mundane theorem    stdlib/sums/sum-extended
import mundane theorem    stdlib/sums/sum-real
import mundane theorem    stdlib/sums/range-bounds
import mundane theorem    stdlib/numbers/exponent-step
import mundane theorem    stdlib/numbers/power-nat
import mundane theorem    stdlib/numbers/reciprocal-order

theorem harmonic-doubling
  note        Doubling the number of terms from 2^j to 2^(j + 1) adds 2^j
              terms, each at least 1/2^(j + 1), so the sum grows by at
              least 1/2.
  let j ∈ ℕ₀                                                          (H1)
  then Σ(k = 1 to 2^(j + 1)) 1/k ≥ Σ(k = 1 to 2^j) 1/k + 1/2

1.  2^(j + 1) = 2^j·2
    mun:exponent-step a := 2, m := j

2.  2^j ∈ ℕ
    mun:power-nat a := 2, m := j

3.  2^(j + 1) ∈ ℕ
    mun:power-nat a := 2, m := j + 1

4.  2^j ≤ 2^j·2
    inequalities, from 2

5.  2^j ≤ 2^(j + 1)
    transitivity, from 4, 1

6.  For all k ∈ ℕ, 1/k ∈ ℝ.
    proof
    let k ∈ ℕ                                                         (K1)

    6.1.  1/k ∈ ℝ
          membership

7.  Σ(k = 1 to 2^(j + 1)) 1/k = Σ(k = 1 to 2^j) 1/k + Σ(k = 2^j + 1 to 2^(j + 1)) 1/k
    mun:sum-split a := 1, b := 2^j, c := 2^(j + 1), from 5, 6
    requires 2^(j + 1) ∈ ℤ: membership, from H1
    requires 1 ≤ 2^j + 1: inequalities, from 2

8.  0 < 2^j + 1
    inequalities, from 2

9.  For all k ∈ {2^j + 1, …, 2^(j + 1)}, 1/2^(j + 1) ≤ 1/k.
    proof
    let k ∈ {2^j + 1, …, 2^(j + 1)}                                   (K2)

    9.1.  2^j + 1 ≤ k. k ≤ 2^(j + 1).
          mun:range-bounds a := 2^j + 1, b := 2^(j + 1), from K2
          requires 2^(j + 1) ∈ ℤ: membership, from H1

    9.2.  k > 0
          transitivity, from 8, 9.1

    9.3.  1/2^(j + 1) ≤ 1/k
          mun:reciprocal-order x := k, y := 2^(j + 1), from 9.1
          requires 2^(j + 1) ∈ ℤ: membership, from H1
          requires k > 0: from 9.2
          requires 2^(j + 1) > 0: inequalities, from 3

10. For all k ∈ {2^j + 1, …, 2^(j + 1)}, 1/k ∈ ℝ.
    proof
    let k ∈ {2^j + 1, …, 2^(j + 1)}                                   (K3)

    10.1. 2^j + 1 ≤ k. k ≤ 2^(j + 1).
          mun:range-bounds a := 2^j + 1, b := 2^(j + 1), from K3
          requires 2^(j + 1) ∈ ℤ: membership, from H1

    10.2. k > 0
          transitivity, from 8, 10.1

    10.3. 1/k ∈ ℝ
          membership
          requires k ≠ 0: weakening, from 10.2

11. Σ(k = 2^j + 1 to 2^(j + 1)) 1/2^(j + 1) ≤ Σ(k = 2^j + 1 to 2^(j + 1)) 1/k
    mun:sum-le a := 2^j + 1, b := 2^(j + 1), from 9
    requires 2^(j + 1) ∈ ℤ: membership, from H1
    requires for all k ∈ {2^j + 1, …, 2^(j + 1)}, 1/k ∈ ℝ: from 10

12. 2^j + 1 ≤ 2^j·2
    inequalities, from 2

13. 2^j + 1 ≤ 2^(j + 1)
    transitivity, from 12, 1

14. Σ(k = 2^j + 1 to 2^(j + 1)) 1/2^(j + 1) = (2^(j + 1) − (2^j + 1) + 1)·(1/2^(j + 1))
    mun:sum-constant a := 2^j + 1, b := 2^(j + 1), c := 1/2^(j + 1)
    requires 2^(j + 1) ∈ ℤ: membership, from H1
    requires 2^j + 1 ≤ 2^(j + 1): from 13
    requires 2^(j + 1) ≠ 0: inequalities, from 3

15. (2^(j + 1) − (2^j + 1) + 1)·(1/2^(j + 1)) = 1/2
    calculation
      (2^(j + 1) − (2^j + 1) + 1)·(1/2^(j + 1)) = (2^j·2 − (2^j + 1) + 1)·(1/(2^j·2))    substitute line 1
                                                 = 1/2                                    algebra

16. 1/2 ≤ Σ(k = 2^j + 1 to 2^(j + 1)) 1/k
    transitivity, from 15, 14, 11
    requires 2^(j + 1) ≠ 0: inequalities, from 3
    requires 2^(j + 1) ∈ ℤ: membership, from H1
    requires for all k ∈ {2^j + 1, …, 2^(j + 1)}, 1/k ∈ ℝ: from 10
    requires Σ(k = 2^j + 1 to 2^(j + 1)) 1/k ∈ ℝ: mun:sum-real a := 2^j + 1, b := 2^(j + 1)

17. Σ(k = 1 to 2^j) 1/k + 1/2 ≤ Σ(k = 1 to 2^j) 1/k + Σ(k = 2^j + 1 to 2^(j + 1)) 1/k
    inequalities
      1/2 ≤ Σ(k = 2^j + 1 to 2^(j + 1)) 1/k                                          16
      Σ(k = 1 to 2^j) 1/k + 1/2 ≤ Σ(k = 1 to 2^j) 1/k + Σ(k = 2^j + 1 to 2^(j + 1)) 1/k   adding Σ(k = 1 to 2^j) 1/k
    requires 2^(j + 1) ∈ ℤ: membership, from H1
    requires for all k ∈ {2^j + 1, …, 2^(j + 1)}, 1/k ∈ ℝ: from 10
    requires Σ(k = 2^j + 1 to 2^(j + 1)) 1/k ∈ ℝ: mun:sum-real a := 2^j + 1, b := 2^(j + 1)

18. Σ(k = 1 to 2^(j + 1)) 1/k ≥ Σ(k = 1 to 2^j) 1/k + 1/2
    transitivity, from 17, 7
    requires 2^(j + 1) ∈ ℤ: membership, from H1
    requires for all k ∈ {2^j + 1, …, 2^(j + 1)}, 1/k ∈ ℝ: from 10
    requires Σ(k = 2^j + 1 to 2^(j + 1)) 1/k ∈ ℝ: mun:sum-real a := 2^j + 1, b := 2^(j + 1)


theorem harmonic-lower-bound
  note        By induction on n: the sum to 2^1 is 1 + 1/2, and doubling the
              number of terms adds at least 1/2 (harmonic-doubling), which is
              what going from n to n + 1 adds to 1 + n/2.
  let n ∈ ℕ                                                           (H1)
  then Σ(k = 1 to 2^n) 1/k ≥ 1 + n/2

1.  For all k ∈ ℕ, 1/k ∈ ℝ.
    proof
    let k ∈ ℕ                                                         (K1)

    1.1.  1/k ∈ ℝ
          membership

2.  For all m ∈ ℕ, Σ(j = 1 to 2^m) 1/j ≥ 1 + m/2.
    induction on m starting at 1

    base
    2.1.  Σ(j = 1 to 1) 1/j = 1/1
          mun:sum-single a := 1, from 1

    2.2.  Σ(j = 1 to 2^1) 1/j ≥ 1 + 1/2
          calculation
            Σ(j = 1 to 2^1) 1/j = Σ(j = 1 to 1 + 1) 1/j               arithmetic
                                = Σ(j = 1 to 1) 1/j + 1/(1 + 1)       mun:sum-extended a := 1, n := 1, from 1
                                = 1/1 + 1/(1 + 1)                     substitute line 2.1
                                ≥ 1 + 1/2                             arithmetic
          requires 1 ≥ 1: arithmetic

    step
    let m ∈ ℕ                                                         (K)
    assume step 2 is true for m, the induction hypothesis             (IH)

    2.3.  Σ(j = 1 to 2^(m + 1)) 1/j ≥ Σ(j = 1 to 2^m) 1/j + 1/2
          thm:harmonic-doubling j := m

    2.4.  Σ(j = 1 to 2^m) 1/j + 1/2 ≥ 1 + (m + 1)/2
          inequalities
            Σ(j = 1 to 2^m) 1/j ≥ 1 + m/2                     IH
            Σ(j = 1 to 2^m) 1/j + 1/2 ≥ 1 + (m + 1)/2         adding 1/2

    2.5.  Σ(j = 1 to 2^(m + 1)) 1/j ≥ 1 + (m + 1)/2
          transitivity, from 2.3, 2.4

3.  Σ(k = 1 to 2^n) 1/k ≥ 1 + n/2
    instantiate m := n in line 2
