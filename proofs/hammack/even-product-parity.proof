import definition         stdlib/divisibility/even
import mundane theorem    stdlib/divisibility/even-or-odd
import mundane theorem    stdlib/divisibility/not-both
import definition         stdlib/divisibility/odd
import mundane theorem    stdlib/reasoning/or-left
import mundane theorem    stdlib/reasoning/or-right

theorem even-product-parity
  note        An integer is even or odd, and so is y. If x is even, or y is
              odd, the claim holds. If x is odd and y even, write x = 2a + 1
              and y = 2b: then x²·(y + 3) is twice
              4a²b + 6a² + 4ab + 6a + b + 1, plus 1, which is odd and so not
              even.
  let x ∈ ℤ                                                           (H1)
  let y ∈ ℤ                                                           (H2)
  assume x²·(y + 3) is even                                           (H3)
  then x is even or y is odd

1.  x is even or x is odd
    mun:even-or-odd n := x

2.  x is even or y is odd
    cases, from 1

    case
    assume x is even                                                  (C1)

    2.1.  x is even or y is odd
          mun:or-left P := x is even, Q := y is odd, from C1

    case
    assume x is odd                                                   (C2)

    2.2.  y is even or y is odd
          mun:even-or-odd n := y

    2.3.  x is even or y is odd
          cases, from 2.2

          case
          assume y is even                                            (C3)

          2.3.1.  a ∈ ℤ. x = 2a + 1.
                  obtain a: def:odd n := x, from C2

          2.3.2.  b ∈ ℤ. y = 2b.
                  obtain b: def:even n := y, from C3

          2.3.3.  x²·(y + 3) = 2(4a²b + 6a² + 4ab + 6a + b + 1) + 1
                  calculation
                    x²·(y + 3) = (2a + 1)²·(y + 3)                              substitute line 2.3.1
                               = (2a + 1)²·(2b + 3)                             substitute line 2.3.2
                               = 2(4a²b + 6a² + 4ab + 6a + b + 1) + 1           algebra

          2.3.4.  x²·(y + 3) is odd
                  def:odd n := x²·(y + 3), from 2.3.3

          2.3.5.  x²·(y + 3) is not odd
                  mun:not-both n := x²·(y + 3), from H3, contradicting 2.3.4

          case
          assume y is odd                                             (C4)

          2.3.6.  x is even or y is odd
                  mun:or-right P := x is even, Q := y is odd, from C4
