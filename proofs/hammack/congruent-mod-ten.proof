import definition         stdlib/divisibility/congruent-mod
import definition         stdlib/divisibility/divides

theorem congruent-mod-ten
  note        If 10 divides a − b then so do 2 and 5. Conversely, if
              a − b = 2s and a − b = 5t, then a − b = 5(a − b) − 4(a − b)
              = 10s − 20t = 10(s − 2t).
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  then a ≡ b (mod 10) ↔ a ≡ b (mod 2) and a ≡ b (mod 5)
  by          both directions

direction
assume a ≡ b (mod 10)                                                 (D1)

1.  10 divides a − b
    def:congruent-mod, from D1

2.  k ∈ ℤ. a − b = 10·k.
    obtain k: def:divides, from 1

3.  a − b = 2·(5·k)
    algebra, from 2

4.  2 divides a − b
    def:divides d := 2, n := a − b, from 3

5.  a ≡ b (mod 2)
    def:congruent-mod, from 4

6.  a − b = 5·(2·k)
    algebra, from 2

7.  5 divides a − b
    def:divides d := 5, n := a − b, from 6

8.  a ≡ b (mod 5)
    def:congruent-mod, from 7

9.  a ≡ b (mod 2) and a ≡ b (mod 5)
    join 5, 8

direction
assume a ≡ b (mod 2) and a ≡ b (mod 5)                                (D2)

10. 2 divides a − b
    def:congruent-mod, from D2

11. 5 divides a − b
    def:congruent-mod, from D2

12. s ∈ ℤ. a − b = 2·s.
    obtain s: def:divides, from 10

13. t ∈ ℤ. a − b = 5·t.
    obtain t: def:divides, from 11

14. 5·(a − b) = 10·s
    algebra, from 12

15. 4·(a − b) = 20·t
    algebra, from 13

16. a − b = 10·(s − 2·t)
    algebra, from 14, 15

17. 10 divides a − b
    def:divides d := 10, n := a − b, from 16

18. a ≡ b (mod 10)
    def:congruent-mod, from 17
