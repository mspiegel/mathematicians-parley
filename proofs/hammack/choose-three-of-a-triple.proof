import definition         stdlib/counting/C
import theorem            proofs/hammack/binomial-of-three/binomial-of-three
import theorem            proofs/hammack/binomial-of-two/binomial-of-two

theorem choose-three-of-a-triple
  note        Six times C(m, 3) is m·(m − 1)·(m − 2) and twice C(m, 2) is
              m·(m − 1). At m = 3n and at m = n these make the claim an
              identity once multiplied out.
  let n ∈ ℕ₀                                                          (H1)
  then C(3n, 3) = 3·C(n, 3) + 6n·C(n, 2) + n³

1.  6·C(3n, 3) = 3n·(3n − 1)·(3n − 2)
    thm:binomial-of-three m := 3n

2.  6·C(n, 3) = n·(n − 1)·(n − 2)
    thm:binomial-of-three m := n

3.  2·C(n, 2) = n·(n − 1)
    thm:binomial-of-two m := n

4.  C(3n, 3) = 3·C(n, 3) + 6n·C(n, 2) + n³
    algebra, from 1, 2, 3
