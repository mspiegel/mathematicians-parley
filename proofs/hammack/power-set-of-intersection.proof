import mundane definition stdlib/sets/intersection
import mundane definition stdlib/sets/powerset
import mundane definition stdlib/sets/subset
import mundane theorem    stdlib/sets/in-subset
import mundane theorem    stdlib/sets/subset-antisymmetric

theorem power-set-of-intersection
  note        A part of both A and B has all its elements in both, so it is a
              part of A ∩ B. Conversely, a part of A ∩ B has its elements in A
              and in B.
  let A be a set                                                      (H1)
  let B be a set                                                      (H2)
  then 𝒫A ∩ 𝒫B = 𝒫(A ∩ B)

1.  For all t ∈ 𝒫A ∩ 𝒫B, t ∈ 𝒫(A ∩ B).
    proof
    let t ∈ 𝒫A ∩ 𝒫B                                                   (K1)

    1.1.  t ∈ 𝒫A. t ∈ 𝒫B.
          mun:intersection u := t, Y := 𝒫A, Z := 𝒫B, from K1

    1.2.  t ⊆ A
          mun:powerset S := t, from 1.1

    1.3.  t ⊆ B
          mun:powerset S := t, A := B, from 1.1

    1.4.  For all x ∈ t, x ∈ A ∩ B.
          proof
          let x ∈ t                                                   (K2)

          1.4.1.  x ∈ A
                  mun:in-subset X := t, Y := A, u := x, from K2, 1.2

          1.4.2.  x ∈ B
                  mun:in-subset X := t, Y := B, u := x, from K2, 1.3

          1.4.3.  x ∈ A ∩ B
                  mun:intersection u := x, Y := A, Z := B, from 1.4.1, 1.4.2

    1.5.  t ⊆ A ∩ B
          mun:subset, from 1.4

    1.6.  t ∈ 𝒫(A ∩ B)
          mun:powerset S := t, A := A ∩ B, from 1.5

2.  𝒫A ∩ 𝒫B ⊆ 𝒫(A ∩ B)
    mun:subset, from 1

3.  For all t ∈ 𝒫(A ∩ B), t ∈ 𝒫A ∩ 𝒫B.
    proof
    let t ∈ 𝒫(A ∩ B)                                                  (K3)

    3.1.  t ⊆ A ∩ B
          mun:powerset S := t, A := A ∩ B, from K3

    3.2.  For all x ∈ t, x ∈ A.
          proof
          let x ∈ t                                                   (K4)

          3.2.1.  x ∈ A ∩ B
                  mun:in-subset X := t, Y := A ∩ B, u := x, from K4, 3.1

          3.2.2.  x ∈ A
                  mun:intersection u := x, Y := A, Z := B, from 3.2.1

    3.3.  For all x ∈ t, x ∈ B.
          proof
          let x ∈ t                                                   (K5)

          3.3.1.  x ∈ A ∩ B
                  mun:in-subset X := t, Y := A ∩ B, u := x, from K5, 3.1

          3.3.2.  x ∈ B
                  mun:intersection u := x, Y := A, Z := B, from 3.3.1

    3.4.  t ⊆ A
          mun:subset, from 3.2

    3.5.  t ⊆ B
          mun:subset, from 3.3

    3.6.  t ∈ 𝒫A
          mun:powerset S := t, from 3.4

    3.7.  t ∈ 𝒫B
          mun:powerset S := t, A := B, from 3.5

    3.8.  t ∈ 𝒫A ∩ 𝒫B
          mun:intersection u := t, Y := 𝒫A, Z := 𝒫B, from 3.6, 3.7

4.  𝒫(A ∩ B) ⊆ 𝒫A ∩ 𝒫B
    mun:subset, from 3

5.  𝒫A ∩ 𝒫B = 𝒫(A ∩ B)
    mun:subset-antisymmetric, from 2, 4
