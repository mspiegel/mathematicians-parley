import definition         stdlib/functions/one-to-one

theorem odd-line-one-to-one
  note        2s + 1 = 2t + 1 only where s = t, so no two integers go to one
              place.
  let f : ℤ → ℤ                                                       (H1)
  assume for all n ∈ ℤ, f(n) = 2n + 1                                 (H2)
  then f : ℤ → ℤ is one-to-one

1.  For all s, t ∈ ℤ, if f(s) = f(t) then s = t.
    proof
    let s ∈ ℤ                                                         (K1)
    let t ∈ ℤ                                                         (K2)
    assume f(s) = f(t)                                                (A1)

    1.1.  2s + 1 = 2t + 1
          calculation
            2s + 1 = f(s)       instantiate n := s in H2
                   = f(t)       A1
                   = 2t + 1     instantiate n := t in H2

    1.2.  s = t
          algebra, from 1.1

2.  f : ℤ → ℤ is one-to-one
    def:one-to-one, from H1, 1
