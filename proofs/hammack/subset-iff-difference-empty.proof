import mundane definition stdlib/sets/difference
import mundane definition stdlib/sets/subset
import mundane theorem    stdlib/sets/in-subset
import mundane theorem    stdlib/sets/subset-empty

theorem subset-iff-difference-empty
  note        If A is inside B nothing of A is left outside B. Conversely, an
              element of A outside B would be in A ∖ B, which has none.
  let A be a set                                                      (H1)
  let B be a set                                                      (H2)
  then A ⊆ B ↔ A ∖ B = ∅

1.  A ⊆ B ↔ A ∖ B = ∅
    both directions

    direction
    assume A ⊆ B                                                      (D1)

    1.1.  For all t ∈ A ∖ B, t ∈ ∅.
          proof
          let t ∈ A ∖ B                                               (K1)

          1.1.1.  t ∈ A. t ∉ B.
                  mun:difference u := t, Y := A, Z := B, from K1

          1.1.2.  t ∈ B
                  mun:in-subset X := A, Y := B, u := t, from D1, 1.1.1, contradicting 1.1.1

    1.2.  A ∖ B ⊆ ∅
          mun:subset, from 1.1

    1.3.  A ∖ B = ∅
          mun:subset-empty Y := A ∖ B, from 1.2

    direction
    assume A ∖ B = ∅                                                  (D2)

    1.4.  For all t ∈ A, t ∈ B.
          proof
          let t ∈ A                                                   (K2)

          1.4.1.  t ∈ B
                  contradiction
                  suppose t ∉ B                                       (S)

                  1.4.1.1.  t ∈ A ∖ B
                            mun:difference u := t, Y := A, Z := B, from K2, S

                  1.4.1.2.  t ∈ ∅
                            substitute A ∖ B = ∅ (D2) into line 1.4.1.1

                  1.4.1.3.  t ∉ ∅
                            inspection, contradicting 1.4.1.2

    1.5.  A ⊆ B
          mun:subset, from 1.4
