import definition         stdlib/divisibility/divides
import definition         stdlib/sets/intersection
import definition         stdlib/sets/set-builder
import definition         stdlib/sets/subset

theorem multiples-of-a-product
  note        If t = m·n·c then t = m·(n·c) and t = n·(m·c).
  let m ∈ ℤ                                                           (H1)
  let n ∈ ℤ                                                           (H2)
  then {x ∈ ℤ : m·n divides x} ⊆ {x ∈ ℤ : m divides x} ∩ {x ∈ ℤ : n divides x}

1.  For all t ∈ {x ∈ ℤ : m·n divides x}, t ∈ {x ∈ ℤ : m divides x} ∩ {x ∈ ℤ : n divides x}.
    proof
    let t ∈ {x ∈ ℤ : m·n divides x}                                   (K1)

    1.1.  t ∈ ℤ. m·n divides t.
          def:set-builder, from K1

    1.2.  c ∈ ℤ. t = (m·n)·c
          obtain c: def:divides d := m·n, n := t, from 1.1

    1.3.  t = m·(n·c)
          algebra, from 1.2

    1.4.  m divides t
          def:divides d := m, n := t, from 1.1, 1.3

    1.5.  t ∈ {x ∈ ℤ : m divides x}
          def:set-builder, from 1.1, 1.4

    1.6.  t = n·(m·c)
          algebra, from 1.2

    1.7.  n divides t
          def:divides d := n, n := t, from 1.1, 1.6

    1.8.  t ∈ {x ∈ ℤ : n divides x}
          def:set-builder, from 1.1, 1.7

    1.9.  t ∈ {x ∈ ℤ : m divides x} ∩ {x ∈ ℤ : n divides x}
          def:intersection u := t, from 1.5, 1.8

2.  {x ∈ ℤ : m·n divides x} ⊆ {x ∈ ℤ : m divides x} ∩ {x ∈ ℤ : n divides x}
    def:subset, from 1
