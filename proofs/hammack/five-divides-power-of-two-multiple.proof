import mundane theorem    stdlib/divisibility/divides-combination
import mundane theorem    stdlib/divisibility/divides-self
import mundane theorem    stdlib/numbers/exponent-step

theorem five-divides-half
  note        5 divides 2b, and 5 divides 5, so it divides
              (2b)·(−2) + 5·b, which is b.
  let b ∈ ℤ                                                           (H1)
  assume 5 divides 2·b                                                (H2)
  then 5 divides b

1.  5 divides 5
    mun:divides-self n := 5

2.  5 divides (2·b)·(−2) + 5·b
    mun:divides-combination e := 5, a := 2·b, b := 5, x := −2, y := b, from H2, 1

3.  5 divides b
    substitute
      5 divides (2·b)·(−2) + 5·b      2
      5 divides b                     algebra

theorem five-divides-power-of-two-multiple
  note        By induction on n from 0: 2^(k + 1)·c is 2^k·(2c), so by the
              hypothesis for 2c, 5 divides 2c, and then 5 divides c.
  let a ∈ ℤ                                                           (H1)
  let n ∈ ℕ                                                           (H2)
  assume 5 divides 2^n·a                                              (H3)
  then 5 divides a

1.  For all k ∈ ℕ₀, for all c ∈ ℤ, if 5 divides 2^k·c then 5 divides c.
    induction on k starting at 0

    base
    1.1.  For all c ∈ ℤ, if 5 divides 2^0·c then 5 divides c.
          proof
          let c ∈ ℤ                                                   (C)
          assume 5 divides 2^0·c                                      (A)

          1.1.1.  2^0 = 1
                  arithmetic

          1.1.2.  5 divides 1·c
                  substitute 2^0 = 1 (line 1.1.1) into A

          1.1.3.  5 divides c
                  restate 1.1.2

    step
    let k ∈ ℕ₀                                                        (K)
    assume step 1 is true for k, the induction hypothesis             (IH)

    1.2.  For all c ∈ ℤ, if 5 divides 2^(k + 1)·c then 5 divides c.
          proof
          let c ∈ ℤ                                                   (C)
          assume 5 divides 2^(k + 1)·c                                (A)

          1.2.1.  2^(k + 1) = 2^k·2
                  mun:exponent-step a := 2, m := k

          1.2.2.  2^(k + 1)·c = 2^k·(2·c)
                  algebra, from 1.2.1
          1.2.3.  5 divides 2^k·(2·c)
                  substitute 2^(k + 1)·c = 2^k·(2·c) (line 1.2.2) into A

          1.2.4.  5 divides 2·c
                  instantiate c := 2·c in IH, from 1.2.3

          1.2.5.  5 divides c
                  thm:five-divides-half b := c, from 1.2.4

2.  5 divides a
    instantiate k := n, c := a in line 1, from H3
