import theorem            proofs/hammack/preimage-of-image/subset-of-preimage-of-image
import definition         stdlib/functions/image
import definition         stdlib/functions/preimage
import definition         stdlib/functions/one-to-one
import mundane theorem    stdlib/functions/value-in-image
import definition         stdlib/sets/subset
import definition         stdlib/sets/singleton
import mundane theorem    stdlib/sets/singleton-subset
import mundane theorem    stdlib/sets/in-subset
import mundane theorem    stdlib/sets/subset-antisymmetric

theorem one-to-one-preimage-of-image
  note        If f is one-to-one, a point sent into f[X] was sent there by a
              point of X and no other. If f sends s and t to one place,
              then s is in f⁻¹[f[{t}]] = {t}.
  let A be a set                                                      (H1)
  let B be a set                                                      (H2)
  let f : A → B                                                       (H3)
  then f : A → B is one-to-one ↔ for all X ⊆ A, f⁻¹[f[X]] = X

1.  f : A → B is one-to-one ↔ for all X ⊆ A, f⁻¹[f[X]] = X
    both directions

    direction
    assume f : A → B is one-to-one                                    (D1)

    1.1.  For all s, t ∈ A, if f(s) = f(t) then s = t.
          def:one-to-one, from D1

    1.2.  For all X ⊆ A, f⁻¹[f[X]] = X.
          proof
          let X ⊆ A                                                   (K1)

          1.2.1.  For all u ∈ f⁻¹[f[X]], u ∈ X.
                  proof
                  let u ∈ f⁻¹[f[X]]                                   (K2)

                  1.2.1.1.  u ∈ A. f(u) ∈ f[X].
                            def:preimage Z := f[X], from K2

                  1.2.1.2.  There is s ∈ X with f(u) = f(s).
                            def:image u := f(u), Y := X, from K1, 1.2.1.1

                  1.2.1.3.  s ∈ X. f(u) = f(s).
                            obtain s from line 1.2.1.2

                  1.2.1.4.  s ∈ A
                            mun:in-subset Y := A, u := s, from K1, 1.2.1.3

                  1.2.1.5.  u = s
                            instantiate s := u, t := s in line 1.1, from 1.2.1.1, 1.2.1.3, 1.2.1.4

                  1.2.1.6.  u ∈ X
                            substitute u = s (line 1.2.1.5) into line 1.2.1.3

          1.2.2.  f⁻¹[f[X]] ⊆ X
                  def:subset, from 1.2.1

          1.2.3.  X ⊆ f⁻¹[f[X]]
                  thm:subset-of-preimage-of-image, from K1

          1.2.4.  f⁻¹[f[X]] = X
                  mun:subset-antisymmetric, from 1.2.2, 1.2.3

    direction
    assume for all X ⊆ A, f⁻¹[f[X]] = X                              (D2)

    1.3.  For all s, t ∈ A, if f(s) = f(t) then s = t.
          proof
          let s ∈ A                                                   (K3)
          let t ∈ A                                                   (K4)
          assume f(s) = f(t)                                          (A1)

          1.3.1.  {t} ⊆ A
                  mun:singleton-subset a := t, X := A, from K4

          1.3.2.  f⁻¹[f[{t}]] = {t}
                  instantiate X := {t} in D2, from 1.3.1

          1.3.3.  t ∈ {t}
                  def:singleton x := t, a := t

          1.3.4.  f(t) ∈ f[{t}]
                  mun:value-in-image Y := {t}, s := t, from 1.3.1, 1.3.3

          1.3.5.  f(s) ∈ f[{t}]
                  substitute f(s) = f(t) (A1) into line 1.3.4

          1.3.6.  s ∈ f⁻¹[f[{t}]]
                  def:preimage Z := f[{t}], from K3, 1.3.5

          1.3.7.  s ∈ {t}
                  substitute f⁻¹[f[{t}]] = {t} (line 1.3.2) into line 1.3.6

          1.3.8.  s = t
                  def:singleton x := s, a := t, from 1.3.7

    1.4.  f : A → B is one-to-one
          def:one-to-one, from H3, 1.3
