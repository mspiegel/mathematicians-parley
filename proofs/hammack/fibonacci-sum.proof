import mundane theorem    stdlib/sums/sum-single
import mundane theorem    stdlib/sums/sum-extended

theorem fibonacci-sum
  note        By induction on n: the sum to 1 is F(1) = 1 = F(3) − 1, and
              adding F(n + 1) to F(n + 2) − 1 gives F(n + 2) + F(n + 1) − 1,
              which is F(n + 3) − 1 since each Fibonacci number is the sum
              of the two before it.
  let n ∈ ℕ                                                           (H1)
  let F(0) = 0,  G(0) = 1,
      F(k + 1) = G(k),  G(k + 1) = F(k) + G(k),  for k ∈ ℕ₀           (D1)
         reads the Fibonacci numbers, F(k) the kth and G(k) the next
  then Σ(k = 1 to n) F(k) = F(n + 2) − 1

1.  For all k ∈ ℕ₀, F(k) ∈ ℕ₀ and G(k) ∈ ℕ₀.
    induction on k starting at 0

    base
    1.1.  F(0) = 0
          D1

    1.2.  G(0) = 1
          D1

    1.3.  F(0) ∈ ℕ₀
          membership, from 1.1

    1.4.  G(0) ∈ ℕ₀
          membership, from 1.2

    1.5.  F(0) ∈ ℕ₀ and G(0) ∈ ℕ₀
          join 1.3, 1.4

    step
    let k ∈ ℕ₀                                                        (K)
    assume step 1 is true for k, the induction hypothesis             (IH)

    1.6.  F(k + 1) = G(k)
          D1

    1.7.  G(k + 1) = F(k) + G(k)
          D1

    1.8.  F(k + 1) ∈ ℕ₀
          membership, from IH, 1.6

    1.9.  G(k + 1) ∈ ℕ₀
          membership, from IH, 1.7

    1.10. F(k + 1) ∈ ℕ₀ and G(k + 1) ∈ ℕ₀
          join 1.8, 1.9

2.  For all k ∈ ℕ₀, F(k) ∈ ℝ.
    proof
    let k ∈ ℕ₀                                                        (K1)

    2.1.  F(k) ∈ ℝ
          membership, from 1

3.  For all k ∈ ℕ₀, F(k + 2) = F(k) + F(k + 1).
    proof
    let k ∈ ℕ₀                                                        (K2)

    3.1.  k + 2 = (k + 1) + 1
          algebra

    3.2.  F((k + 1) + 1) = G(k + 1)
          D1

    3.3.  G(k + 1) = F(k) + G(k)
          D1

    3.4.  F(k + 1) = G(k)
          D1

    3.5.  F((k + 1) + 1) = F(k) + G(k)
          transitivity, from 3.2, 3.3

    3.6.  F((k + 1) + 1) = F(k) + F(k + 1)
          substitute F(k + 1) = G(k) (line 3.4) into line 3.5

    3.7.  F(k + 2) = F(k) + F(k + 1)
          substitute k + 2 = (k + 1) + 1 (line 3.1) into line 3.6

4.  For all m ∈ ℕ, Σ(j = 1 to m) F(j) = F(m + 2) − 1.
    induction on m starting at 1

    base
    4.1.  For all j ∈ {1, …, 1}, F(j) ∈ ℝ.
          proof
          let j ∈ {1, …, 1}                                           (J1)

          4.1.1.  F(j) ∈ ℝ
                  instantiate k := j in line 2

    4.2.  Σ(j = 1 to 1) F(j) = F(1)
          mun:sum-single a := 1
          requires for all j ∈ {1, …, 1}, F(j) ∈ ℝ: from 4.1

    4.3.  F(0 + 1) = G(0)
          D1

    4.4.  G(0) = 1
          D1

    4.5.  F(0) = 0
          D1

    4.6.  F(0 + 1) = 1
          calculation
            F(0 + 1) = G(0)    4.3
                     = 1       4.4

    4.7.  F(1) = 1
          calculation
            F(1) = F(0 + 1)    arithmetic
                 = 1           4.6

    4.8.  F(0 + 2) = F(0) + F(0 + 1)
          instantiate k := 0 in line 3

    4.9.  F(0 + 2) = 1
          algebra, from 4.5, 4.6, 4.8

    4.10. F(1 + 1) = 1
          calculation
            F(1 + 1) = F(0 + 2)    arithmetic
                     = 1           4.9

    4.11. F(1 + 2) = F(1) + F(1 + 1)
          instantiate k := 1 in line 3

    4.12. F(1 + 2) = 2
          algebra, from 4.7, 4.10, 4.11

    4.13. Σ(j = 1 to 1) F(j) = F(1 + 2) − 1
          algebra, from 4.2, 4.7, 4.12

    step
    let m ∈ ℕ                                                         (K3)
    assume step 4 is true for m, the induction hypothesis             (IH2)

    4.14. For all j ∈ {1, …, m + 1}, F(j) ∈ ℝ.
          proof
          let j ∈ {1, …, m + 1}                                       (J2)

          4.14.1. F(j) ∈ ℝ
                  instantiate k := j in line 2

    4.15. Σ(j = 1 to m + 1) F(j) = Σ(j = 1 to m) F(j) + F(m + 1)
          mun:sum-extended a := 1, n := m
          requires m ≥ 1: from K3
          requires for all j ∈ {1, …, m + 1}, F(j) ∈ ℝ: from 4.14

    4.16. F((m + 1) + 2) = F(m + 1) + F((m + 1) + 1)
          instantiate k := m + 1 in line 3

    4.17. (m + 1) + 1 = m + 2
          algebra

    4.18. F((m + 1) + 2) = F(m + 1) + F(m + 2)
          substitute (m + 1) + 1 = m + 2 (line 4.17) into line 4.16

    4.19. F(m + 2) ∈ ℝ
          instantiate k := m + 2 in line 2

    4.20. F(m + 1) ∈ ℝ
          instantiate k := m + 1 in line 2

    4.21. Σ(j = 1 to m + 1) F(j) = F((m + 1) + 2) − 1
          algebra, from IH2, 4.15, 4.18
          requires F(m + 2) ∈ ℝ: from 4.19
          requires F(m + 1) ∈ ℝ: from 4.20

5.  Σ(k = 1 to n) F(k) = F(n + 2) − 1
    instantiate m := n in line 4
