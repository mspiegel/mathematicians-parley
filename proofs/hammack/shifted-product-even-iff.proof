import mundane definition stdlib/divisibility/even
import mundane theorem    stdlib/divisibility/even-or-odd
import mundane theorem    stdlib/divisibility/even-product
import mundane theorem    stdlib/divisibility/even-product-factor
import mundane theorem    stdlib/divisibility/not-both
import mundane definition stdlib/divisibility/odd
import mundane theorem    stdlib/reasoning/or-left
import mundane theorem    stdlib/reasoning/or-right

theorem shifted-product-even-iff
  note        A product is even exactly when a factor is. If a − 3 is even,
              a − 3 = 2k and a = 2(k + 1) + 1 is odd. If b² is even, so is b,
              as b² is b·b. Conversely, if a = 2k + 1, then a − 3 = 2(k − 1)
              is even and so is its product with b². If b is even, b² is
              b·b and even, and so is its product with a − 3.
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  then (a − 3)·b² is even ↔ a is odd or b is even

1.  (a − 3)·b² is even ↔ a is odd or b is even
    both directions

    direction
    assume (a − 3)·b² is even                                         (D1)

    1.1.  a − 3 is even or b² is even
          mun:even-product-factor n := a − 3, from D1

    1.2.  a is odd or b is even
          cases, from 1.1

          case
          assume a − 3 is even                                        (C1)

          1.2.1.  k ∈ ℤ. a − 3 = 2k.
                  obtain k: mun:even n := a − 3, from C1

          1.2.2.  a = 2(k + 1) + 1
                  algebra, from 1.2.1

          1.2.3.  a is odd
                  mun:odd n := a, from 1.2.2

          1.2.4.  a is odd or b is even
                  mun:or-left P := a is odd, Q := b is even, from 1.2.3

          case
          assume b² is even                                           (C2)

          1.2.5.  b is even or b is odd
                  mun:even-or-odd n := b

          1.2.6.  b is even
                  cases, from 1.2.5

                  case
                  assume b is even, which is the claim                (C3)

                  case
                  assume b is odd                                     (C4)

                  1.2.6.1.  k ∈ ℤ. b = 2k + 1.
                            obtain k: mun:odd n := b, from C4

                  1.2.6.2.  b² = 2(2k² + 2k) + 1
                            algebra, from 1.2.6.1

                  1.2.6.3.  b² is odd
                            mun:odd n := b², from 1.2.6.2

                  1.2.6.4.  b² is not odd
                            mun:not-both n := b², from C2, contradicting 1.2.6.3

          1.2.7.  a is odd or b is even
                  mun:or-right P := a is odd, Q := b is even, from 1.2.6

    direction
    assume a is odd or b is even                                      (D2)

    1.3.  (a − 3)·b² is even
          cases, from D2

          case
          assume a is odd                                             (C5)

          1.3.1.  k ∈ ℤ. a = 2k + 1.
                  obtain k: mun:odd, from C5

          1.3.2.  a − 3 = 2(k − 1)
                  algebra, from 1.3.1

          1.3.3.  a − 3 is even
                  mun:even n := a − 3, from 1.3.2

          1.3.4.  (a − 3)·b² is even
                  mun:even-product a := a − 3, x := b², from 1.3.3

          case
          assume b is even                                            (C6)

          1.3.5.  k ∈ ℤ. b = 2k.
                  obtain k: mun:even, from C6

          1.3.6.  (a − 3)·b² = 2(2(a − 3)·k²)
                  algebra, from 1.3.5

          1.3.7.  (a − 3)·b² is even
                  mun:even n := (a − 3)·b², from 1.3.6
