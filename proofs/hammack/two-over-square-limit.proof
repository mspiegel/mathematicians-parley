import definition         stdlib/calculus/tends-to
import theorem            stdlib/numbers/archimedean
import mundane definition stdlib/numbers/abs
import mundane theorem    stdlib/numbers/multiply-le
import mundane theorem    stdlib/numbers/reciprocal-order
import mundane theorem    stdlib/numbers/reciprocal-positive

theorem two-over-square-limit
  note        a(n) − 5 is 2/n², which is positive and at most 2/n because
              n ≤ n². Choose N with 1/N below ε/2: from N on, 2/n ≤ 2/N < ε.
  ε ranges over ℝ
  n ranges over ℕ
  let a : ℕ → ℝ                                                       (H1)
  assume for all n ∈ ℕ, a(n) = 5 + 2/n²                               (H2)
  then a(n) → 5 as n → ∞

1.  For all ε > 0, there exists N ∈ ℕ such that |a(n) − 5| < ε for all n ≥ N.
    proof
    let ε ∈ ℝ                                                         (K1)
    assume ε > 0                                                      (A1)

    1.1.  ε/2 > 0
          inequalities
            ε > 0        A1
            ε/2 > 0      multiplying by 1/2

    1.2.  N ∈ ℕ. 1/N < ε/2.
          obtain N: thm:archimedean x := ε/2, from 1.1

    1.3.  For all n ≥ N, |a(n) − 5| < ε.
          proof
          let n ∈ ℕ                                                   (K2)
          assume n ≥ N                                                (A2)

          1.3.1.  n > 0
                  inequalities, from K2

          1.3.2.  n ≥ 1
                  inequalities, from K2

          1.3.3.  n·1 ≤ n·n
                  mun:multiply-le x := 1, y := n, c := n, from 1.3.2
                  requires n > 0: from 1.3.1

          1.3.4.  n·n = n²
                  algebra

          1.3.5.  n ≤ n²
                  transitivity, from 1.3.3, 1.3.4

          1.3.6.  n² > 0
                  transitivity, from 1.3.1, 1.3.5

          1.3.7.  1/n² ≤ 1/n
                  mun:reciprocal-order x := n, y := n², from 1.3.5
                  requires n > 0: from 1.3.1
                  requires n² > 0: from 1.3.6

          1.3.8.  1/n ≤ 1/N
                  mun:reciprocal-order x := N, y := n, from A2
                  requires N > 0: inequalities, from 1.2
                  requires n > 0: from 1.3.1

          1.3.9.  2·(1/n²) ≤ 2·(1/n)
                  inequalities
                    1/n² ≤ 1/n              1.3.7
                    2·(1/n²) ≤ 2·(1/n)      multiplying by 2

          1.3.10. 2·(1/n) ≤ 2·(1/N)
                  inequalities
                    1/n ≤ 1/N               1.3.8
                    2·(1/n) ≤ 2·(1/N)       multiplying by 2

          1.3.11. 2·(1/N) < ε
                  inequalities
                    1/N < ε/2               1.2
                    2·(1/N) < 2·(ε/2)       multiplying by 2
                    2·(1/N) < ε             algebra

          1.3.12. a(n) = 5 + 2/n²
                  instantiate n := n in H2

          1.3.13. a(n) − 5 = 2·(1/n²)
                  algebra, from 1.3.12

          1.3.14. a(n) − 5 < ε
                  transitivity, from 1.3.13, 1.3.9, 1.3.10, 1.3.11
                  requires a(n) ∈ ℝ: from H1

          1.3.15. 1/n² > 0
                  mun:reciprocal-positive x := n², from 1.3.6

          1.3.16. 2·(1/n²) > 0
                  inequalities
                    1/n² > 0           1.3.15
                    2·(1/n²) > 0       multiplying by 2

          1.3.17. 0 < a(n) − 5
                  transitivity, from 1.3.16, 1.3.13
                  requires a(n) ∈ ℝ: from H1

          1.3.18. |a(n) − 5| = a(n) − 5
                  mun:abs x := a(n) − 5
                  requires a(n) ∈ ℝ: from H1
                  requires 0 ≤ a(n) − 5: weakening, from 1.3.17

          1.3.19. |a(n) − 5| < ε
                  transitivity, from 1.3.18, 1.3.14
                  requires a(n) ∈ ℝ: from H1

    1.4.  There exists N ∈ ℕ such that |a(n) − 5| < ε for all n ≥ N.
          exhibit, from 1.3

2.  a(n) → 5 as n → ∞
    def:tends-to L := 5, from 1
