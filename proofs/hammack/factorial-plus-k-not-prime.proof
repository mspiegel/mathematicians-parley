import mundane theorem    stdlib/counting/factorial-divisible
import mundane theorem    stdlib/counting/factorial-nat
import mundane theorem    stdlib/divisibility/divides-self
import mundane theorem    stdlib/divisibility/divides-sum
import definition         stdlib/divisibility/prime
import mundane theorem    stdlib/numbers/nat-closure
import mundane theorem    stdlib/numbers/pos-int-nat
import mundane theorem    stdlib/reasoning/modus-ponens
import mundane theorem    stdlib/sums/range-bounds

theorem factorial-plus-k-not-prime
  note        k divides n! because 2 ≤ k ≤ n, and k divides k, so k divides
              n! + k. If n! + k were prime, k would be 1 or n! + k; k is at
              least 2, and k = n! + k would make n! zero.
  let n ∈ ℕ                                                           (H1)
  let k ∈ {2, …, n}                                                   (H2)
  then not (n! + k is prime)

1.  2 ≤ k. k ≤ n.
    mun:range-bounds a := 2, b := n, from H2

2.  0 < k
    inequalities, from 1

3.  k ∈ ℕ
    mun:pos-int-nat m := k, from 2

4.  n! ∈ ℕ
    mun:factorial-nat

5.  n! + k ∈ ℕ
    mun:nat-closure a := n!, b := k, from 3, 4

6.  k divides n!
    mun:factorial-divisible m := k, from 1, 3

7.  k divides k
    mun:divides-self n := k

8.  k divides n! + k
    mun:divides-sum d := k, a := n!, b := k, from 6, 7
    requires n! ∈ ℤ: from 4

9.  not (n! + k is prime)
    contradiction
    suppose n! + k is prime                                           (S)

    9.1.  n! + k > 1. For all d ∈ ℕ, if d divides n! + k then d = 1 or d = n! + k.
          def:prime p := n! + k, from S
          requires n! + k ∈ ℕ: from 5

    9.2.  If k divides n! + k then k = 1 or k = n! + k.
          instantiate d := k in line 9.1, from 3

    9.3.  k = 1 or k = n! + k
          mun:modus-ponens P := k divides n! + k, from 8, 9.2

    9.4.  k = n! + k
          cases, from 9.3

          case
          assume k = 1                                                (C1)

          9.4.1.  1 < k
                  inequalities, from 1

          9.4.2.  1 ≠ k
                  inequalities, contradicting C1
                    1 < k               9.4.1
                    1 ≠ k               weakening

          case
          assume k = n! + k, which is the claim                       (C2)

    9.5.  n! = 0
          algebra, from 9.4
          requires n! ∈ ℝ: from 4

    9.6.  n! ≠ 0
          inequalities, from 4, contradicting 9.5
