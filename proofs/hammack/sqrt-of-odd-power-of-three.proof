import definition         stdlib/divisibility/odd
import definition         stdlib/numbers/sqrt
import mundane theorem    stdlib/numbers/exponent-step
import mundane theorem    stdlib/numbers/exponent-sum
import mundane theorem    stdlib/numbers/nat0-as-int
import mundane theorem    stdlib/numbers/power-nat
import mundane theorem    stdlib/numbers/product-nonneg
import mundane theorem    stdlib/numbers/square-equal
import theorem            proofs/hammack/sqrt3-irrational/sqrt3-irrational
import theorem            proofs/setmm/rational-closure/irrational-product

theorem sqrt-of-odd-power-of-three
  note        With k = 2m + 1, 3^k is 3^m·3^m·3, and √3·3^m is at least 0
              with that square, so it is √(3^k). It is a nonzero rational
              times the irrational √3.
  let k ∈ ℕ                                                           (H1)
  assume k is odd                                                     (H2)
  then √(3^k) is irrational

1.  m ∈ ℤ. k = 2m + 1.
    obtain m: def:odd n := k, from H2

2.  1 ≤ k
    inequalities, from H1

3.  1 ≤ 2m + 1
    substitute k = 2m + 1 (line 1) into line 2

4.  0 ≤ m
    inequalities
      1 ≤ 2m + 1    3
      0 ≤ 2m        adding −1
      0 ≤ m         multiplying by 1/2

5.  m ∈ ℕ₀
    mun:nat0-as-int n := m, from 4

6.  3^m ∈ ℕ
    mun:power-nat a := 3, from 5

7.  3^k ∈ ℕ
    mun:power-nat a := 3, m := k

8.  k = (m + m) + 1
    algebra, from 1

9.  3^k = 3^((m + m) + 1)
    substitute k = (m + m) + 1 (line 8)

10. 3^((m + m) + 1) = 3^(m + m)·3
    mun:exponent-step a := 3, m := m + m
    requires m + m ∈ ℕ₀: membership, from 5

11. 3^(m + m) = 3^m·3^m
    mun:exponent-sum a := 3, n := m, from 5

12. 3^(m + m)·3 = 3^m·3^m·3
    substitute 3^(m + m) = 3^m·3^m (line 11)

13. 3^k = 3^m·3^m·3
    calculation
      3^k = 3^((m + m) + 1)    9
          = 3^(m + m)·3        10
          = 3^m·3^m·3          12

14. √3 ∈ ℝ. √3 ≥ 0. (√3)² = 3.
    def:sqrt x := 3
    requires 3 ≥ 0: arithmetic

15. √(3^k) ∈ ℝ. √(3^k) ≥ 0. (√(3^k))² = 3^k.
    def:sqrt x := 3^k
    requires 0 ≤ 3^k: inequalities, from 7

16. √3·3^m ≥ 0
    mun:product-nonneg x := √3, y := 3^m, from 6, 14
    requires 0 ≤ 3^m: inequalities, from 6

17. (√3·3^m)² = 3^m·3^m·3
    algebra, from 6, 14

18. (√(3^k))² = (√3·3^m)²
    calculation
      (√(3^k))² = 3^k             15
                = 3^m·3^m·3       13
                = (√3·3^m)²       17

19. √(3^k) = √3·3^m
    mun:square-equal x := √(3^k), y := √3·3^m, from 6, 15, 16, 18

20. √3 is irrational
    thm:sqrt3-irrational

21. √3·3^m is irrational
    thm:irrational-product A := √3, B := 3^m, from 6, 20

22. √(3^k) is irrational
    substitute √(3^k) = √3·3^m (line 19) into line 21
