import mundane theorem    stdlib/numbers/exponent-step
import mundane theorem    stdlib/numbers/power-real
import mundane theorem    stdlib/sums/sum-extended
import mundane theorem    stdlib/sums/sum-single

theorem geometric-sum-base-two
  note        By induction on n from 0: adding 2^(k + 1) to 2^(k + 1) − 1
              gives 2^(k + 2) − 1, since 2^(k + 2) is 2^(k + 1)·2.
  let n ∈ ℕ                                                           (H1)
  then Σ(k = 0 to n) 2^k = 2^(n + 1) − 1

let S(m) = Σ(j = 0 to m) 2^j, for m ∈ ℕ₀                              (D1)
       reads the sum of the powers of 2 from 2^0 to 2^m

1.  For all k ∈ ℕ₀, S(k) = 2^(k + 1) − 1.
    induction on k starting at 0

    base
    1.1.  Σ(j = 0 to 0) 2^j = 2^0
          mun:sum-single a := 0

    1.2.  S(0) = 2^(0 + 1) − 1
          calculation
            S(0) = Σ(j = 0 to 0) 2^j    D1
                 = 2^0                  1.1
                 = 2^(0 + 1) − 1        arithmetic

    step
    let k ∈ ℕ₀                                                        (K)
    assume step 1 is true for k, the induction hypothesis             (IH)

    1.3.  Σ(j = 0 to k + 1) 2^j = Σ(j = 0 to k) 2^j + 2^(k + 1)
          mun:sum-extended a := 0, n := k
          requires k ≥ 0: from K

    1.4.  S(k + 1) = S(k) + 2^(k + 1)
          calculation
            S(k + 1) = Σ(j = 0 to k + 1) 2^j              D1
                     = Σ(j = 0 to k) 2^j + 2^(k + 1)      1.3
                     = S(k) + 2^(k + 1)                   D1

    1.5.  S(k) + 2^(k + 1) = 2^(k + 1) − 1 + 2^(k + 1)
          substitute S(k) = 2^(k + 1) − 1 (IH)

    1.6.  2^((k + 1) + 1) = 2^(k + 1)·2
          mun:exponent-step a := 2, m := k + 1

    1.7.  2^(k + 1) − 1 + 2^(k + 1) = 2^(k + 1)·2 − 1
          algebra
          requires 2^(k + 1) ∈ ℝ: mun:power-real a := 2, m := k + 1

    1.8.  2^(k + 1)·2 − 1 = 2^((k + 1) + 1) − 1
          substitute 2^((k + 1) + 1) = 2^(k + 1)·2 (line 1.6)

    1.9.  S(k + 1) = 2^((k + 1) + 1) − 1
          calculation
            S(k + 1) = S(k) + 2^(k + 1)                 1.4
                     = 2^(k + 1) − 1 + 2^(k + 1)        1.5
                     = 2^(k + 1)·2 − 1                  1.7
                     = 2^((k + 1) + 1) − 1              1.8

2.  S(n) = 2^(n + 1) − 1
    instantiate k := n in line 1

3.  Σ(k = 0 to n) 2^k = 2^(n + 1) − 1
    calculation
      Σ(k = 0 to n) 2^k = S(n)              D1
                        = 2^(n + 1) − 1     2
