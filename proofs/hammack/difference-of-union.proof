import mundane definition stdlib/sets/difference
import mundane definition stdlib/sets/intersection
import mundane definition stdlib/sets/subset
import mundane definition stdlib/sets/union
import mundane theorem    stdlib/sets/in-union-left
import mundane theorem    stdlib/sets/in-union-right
import mundane theorem    stdlib/sets/subset-antisymmetric
import mundane theorem    stdlib/reasoning/disjunctive-syllogism-left

theorem difference-of-union
  note        An element of A outside B ∪ C is outside B and outside C.
              Conversely, outside both B and C is outside B ∪ C.
  let A be a set                                                      (H1)
  let B be a set                                                      (H2)
  let C be a set                                                      (H3)
  then A ∖ (B ∪ C) = (A ∖ B) ∩ (A ∖ C)

1.  For all t ∈ A ∖ (B ∪ C), t ∈ (A ∖ B) ∩ (A ∖ C).
    proof
    let t ∈ A ∖ (B ∪ C)                                               (K1)

    1.1.  t ∈ A. t ∉ B ∪ C.
          mun:difference u := t, Y := A, Z := B ∪ C, from K1

    1.2.  t ∉ B
          contradiction
          suppose t ∈ B                                               (S1)

          1.2.1.  t ∈ B ∪ C
                  mun:in-union-left u := t, Y := B, Z := C, from S1, contradicting 1.1

    1.3.  t ∉ C
          contradiction
          suppose t ∈ C                                               (S2)

          1.3.1.  t ∈ B ∪ C
                  mun:in-union-right u := t, Y := B, Z := C, from S2, contradicting 1.1

    1.4.  t ∈ A ∖ B
          mun:difference u := t, Y := A, Z := B, from 1.1, 1.2

    1.5.  t ∈ A ∖ C
          mun:difference u := t, Y := A, Z := C, from 1.1, 1.3

    1.6.  t ∈ (A ∖ B) ∩ (A ∖ C)
          mun:intersection u := t, Y := A ∖ B, Z := A ∖ C, from 1.4, 1.5

2.  A ∖ (B ∪ C) ⊆ (A ∖ B) ∩ (A ∖ C)
    mun:subset, from 1

3.  For all t ∈ (A ∖ B) ∩ (A ∖ C), t ∈ A ∖ (B ∪ C).
    proof
    let t ∈ (A ∖ B) ∩ (A ∖ C)                                         (K2)

    3.1.  t ∈ A ∖ B. t ∈ A ∖ C.
          mun:intersection u := t, Y := A ∖ B, Z := A ∖ C, from K2

    3.2.  t ∈ A. t ∉ B.
          mun:difference u := t, Y := A, Z := B, from 3.1

    3.3.  t ∉ C
          mun:difference u := t, Y := A, Z := C, from 3.1

    3.4.  t ∉ B ∪ C
          contradiction
          suppose t ∈ B ∪ C                                           (S3)

          3.4.1.  t ∈ B or t ∈ C
                  mun:union u := t, Y := B, Z := C, from S3

          3.4.2.  t ∈ C
                  mun:disjunctive-syllogism-left P := t ∈ B, Q := t ∈ C, from 3.2, 3.4.1, contradicting 3.3

    3.5.  t ∈ A ∖ (B ∪ C)
          mun:difference u := t, Y := A, Z := B ∪ C, from 3.2, 3.4

4.  (A ∖ B) ∩ (A ∖ C) ⊆ A ∖ (B ∪ C)
    mun:subset, from 3

5.  A ∖ (B ∪ C) = (A ∖ B) ∩ (A ∖ C)
    mun:subset-antisymmetric, from 2, 4
