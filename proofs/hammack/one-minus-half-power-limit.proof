import definition         stdlib/calculus/tends-to
import theorem            stdlib/numbers/archimedean
import mundane theorem    stdlib/numbers/abs-difference-lt
import mundane theorem    stdlib/numbers/exponent-step
import mundane theorem    stdlib/numbers/power-positive
import mundane theorem    stdlib/numbers/reciprocal-order
import mundane theorem    stdlib/numbers/reciprocal-positive

theorem one-minus-half-power-limit
  note        a(n) is 1 − 1/2^n, below 1 and above 1 − 1/n because n ≤ 2^n,
              which a short induction shows. Choose N with 1/N below ε:
              from N on, 1/2^n ≤ 1/n ≤ 1/N < ε.
  ε ranges over ℝ
  n ranges over ℕ
  let a : ℕ → ℝ                                                       (H1)
  assume for all n ∈ ℕ, a(n) = 1 − 1/2^n                              (H2)
  then a(n) → 1 as n → ∞

1.  For all k ∈ ℕ, k ≤ 2^k.
    induction on k starting at 1

    base
    1.1.  1 ≤ 2^1
          arithmetic

    step
    let k ∈ ℕ                                                         (K)
    assume step 1 is true for k, the induction hypothesis             (IH)

    1.2.  2^(k + 1) = 2^k·2
          mun:exponent-step a := 2, m := k

    1.3.  k + 1 ≤ 2·k
          inequalities, from K

    1.4.  2·k ≤ 2·2^k
          inequalities
            k ≤ 2^k          IH
            2·k ≤ 2·2^k      multiplying by 2

    1.5.  2·2^k = 2^k·2
          algebra

    1.6.  k + 1 ≤ 2^(k + 1)
          transitivity, from 1.3, 1.4, 1.5, 1.2

2.  For all ε > 0, there exists N ∈ ℕ such that |a(n) − 1| < ε for all n ≥ N.
    proof
    let ε ∈ ℝ                                                         (K1)
    assume ε > 0                                                      (A1)

    2.1.  N ∈ ℕ. 1/N < ε.
          obtain N: thm:archimedean x := ε, from A1

    2.2.  For all n ≥ N, |a(n) − 1| < ε.
          proof
          let n ∈ ℕ                                                   (K2)
          assume n ≥ N                                                (A2)

          2.2.1.  n > 0
                  inequalities, from K2

          2.2.2.  n ≤ 2^n
                  instantiate k := n in line 1

          2.2.3.  2^n > 0
                  mun:power-positive a := 2, m := n
                  requires 2 > 0: arithmetic

          2.2.4.  1/2^n ≤ 1/n
                  mun:reciprocal-order x := n, y := 2^n, from 2.2.2
                  requires n > 0: from 2.2.1
                  requires 2^n > 0: from 2.2.3

          2.2.5.  1/n ≤ 1/N
                  mun:reciprocal-order x := N, y := n, from A2
                  requires N > 0: inequalities, from 2.1
                  requires n > 0: from 2.2.1

          2.2.6.  1/2^n < ε
                  transitivity, from 2.2.4, 2.2.5, 2.1

          2.2.7.  a(n) = 1 − 1/2^n
                  instantiate n := n in H2

          2.2.8.  1 − ε < 1 − 1/2^n
                  inequalities
                    1/2^n < ε            2.2.6
                    −1/2^n > −ε          multiplying by −1
                    −ε < −1/2^n          symmetry
                    1 − ε < 1 − 1/2^n    adding 1

          2.2.9.  1 − ε < a(n)
                  transitivity, from 2.2.8, 2.2.7

          2.2.10. 1/2^n > 0
                  mun:reciprocal-positive x := 2^n, from 2.2.3

          2.2.11. 1 − 1/2^n < 1
                  inequalities
                    1/2^n > 0            2.2.10
                    −1/2^n < 0           multiplying by −1
                    1 − 1/2^n < 1        adding 1

          2.2.12. 1 < 1 + ε
                  inequalities
                    ε > 0                A1
                    1 + ε > 1            adding 1
                    1 < 1 + ε            symmetry

          2.2.13. a(n) < 1 + ε
                  transitivity, from 2.2.7, 2.2.11, 2.2.12

          2.2.14. 1 − ε < a(n) and a(n) < 1 + ε
                  join 2.2.9, 2.2.13

          2.2.15. |a(n) − 1| < ε
                  mun:abs-difference-lt x := a(n), c := 1, δ := ε, from 2.2.14
                  requires a(n) ∈ ℝ: from H1

    2.3.  There exists N ∈ ℕ such that |a(n) − 1| < ε for all n ≥ N.
          exhibit, from 2.2

3.  a(n) → 1 as n → ∞
    def:tends-to L := 1, from 2
