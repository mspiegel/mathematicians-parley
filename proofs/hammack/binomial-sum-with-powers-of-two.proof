import definition         stdlib/counting/C
import theorem            proofs/wiedijk/binomial/binomial
import mundane theorem    stdlib/numbers/one-power
import mundane theorem    stdlib/sums/range-difference
import mundane theorem    stdlib/sums/sum-termwise

theorem binomial-sum-with-powers-of-two
  note        The binomial theorem at x = 1 and y = 2: every power of 1 is 1,
              so the terms are 2^k·C(n, k), and (1 + 2)^n is 3^n.
  let n ∈ ℕ₀                                                          (H1)
  then Σ(k = 0 to n) 2^k·C(n, k) = 3^n

1.  For all k ∈ {0, …, n}, C(n, k)·1^(n − k)·2^k ∈ ℝ.
    proof
    let k ∈ {0, …, n}                                                 (J)

    1.1.  C(n, k)·1^(n − k)·2^k ∈ ℝ
          membership
          requires n − k ∈ ℕ₀: mun:range-difference a := 0, from J

2.  For all k ∈ {0, …, n}, 2^k·C(n, k) ∈ ℝ.
    membership

3.  For all k ∈ {0, …, n}, C(n, k)·1^(n − k)·2^k = 2^k·C(n, k).
    proof
    let k ∈ {0, …, n}                                                 (J)

    3.1.  1^(n − k) = 1
          mun:one-power m := n − k

    3.2.  C(n, k)·1^(n − k)·2^k = 2^k·C(n, k)
          algebra, from 3.1

4.  1 + 2 = 3
    arithmetic

5.  Σ(k = 0 to n) 2^k·C(n, k) = 3^n
    calculation
      Σ(k = 0 to n) 2^k·C(n, k) = Σ(k = 0 to n) C(n, k)·1^(n − k)·2^k     mun:sum-termwise a := 0, b := n, from 1, 2, 3
                                = (1 + 2)^n                               thm:binomial x := 1, y := 2
                                = 3^n                                     substitute line 4
