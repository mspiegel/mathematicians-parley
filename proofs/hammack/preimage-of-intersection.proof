import definition         stdlib/functions/preimage
import definition         stdlib/sets/intersection
import definition         stdlib/sets/subset
import mundane theorem    stdlib/sets/subset-antisymmetric

theorem preimage-of-intersection
  note        A point goes into Y ∩ Z exactly when it goes into Y and goes
              into Z.
  let A be a set                                                      (H1)
  let B be a set                                                      (H2)
  let f : A → B                                                       (H3)
  let Y ⊆ B                                                           (H4)
  let Z ⊆ B                                                           (H5)
  then f⁻¹[Y ∩ Z] = f⁻¹[Y] ∩ f⁻¹[Z]

1.  For all u ∈ f⁻¹[Y ∩ Z], u ∈ f⁻¹[Y] ∩ f⁻¹[Z].
    proof
    let u ∈ f⁻¹[Y ∩ Z]                                                (K1)

    1.1.  u ∈ A. f(u) ∈ Y ∩ Z.
          def:preimage Z := Y ∩ Z, from K1

    1.2.  f(u) ∈ Y. f(u) ∈ Z.
          def:intersection u := f(u), from 1.1

    1.3.  u ∈ f⁻¹[Y]
          def:preimage Z := Y, from 1.1, 1.2

    1.4.  u ∈ f⁻¹[Z]
          def:preimage, from 1.1, 1.2

    1.5.  u ∈ f⁻¹[Y] ∩ f⁻¹[Z]
          def:intersection Y := f⁻¹[Y], Z := f⁻¹[Z], from 1.3, 1.4

2.  f⁻¹[Y ∩ Z] ⊆ f⁻¹[Y] ∩ f⁻¹[Z]
    def:subset, from 1

3.  For all u ∈ f⁻¹[Y] ∩ f⁻¹[Z], u ∈ f⁻¹[Y ∩ Z].
    proof
    let u ∈ f⁻¹[Y] ∩ f⁻¹[Z]                                           (K2)

    3.1.  u ∈ f⁻¹[Y]. u ∈ f⁻¹[Z].
          def:intersection Y := f⁻¹[Y], Z := f⁻¹[Z], from K2

    3.2.  u ∈ A. f(u) ∈ Y.
          def:preimage Z := Y, from 3.1

    3.3.  f(u) ∈ Z
          def:preimage, from 3.1

    3.4.  f(u) ∈ Y ∩ Z
          def:intersection u := f(u), from 3.2, 3.3

    3.5.  u ∈ f⁻¹[Y ∩ Z]
          def:preimage Z := Y ∩ Z, from 3.2, 3.4

4.  f⁻¹[Y] ∩ f⁻¹[Z] ⊆ f⁻¹[Y ∩ Z]
    def:subset, from 3

5.  f⁻¹[Y ∩ Z] = f⁻¹[Y] ∩ f⁻¹[Z]
    mun:subset-antisymmetric, from 2, 4
