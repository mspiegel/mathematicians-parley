import definition         stdlib/counting/C
import theorem            stdlib/counting/pascal
import mundane theorem    stdlib/sums/sum-extended
import mundane theorem    stdlib/sums/sum-single

theorem sum-of-binomials-down-a-column
  note        By induction on n: adding C(k + 1, r) to C(k + 1, r + 1) gives
              C(k + 2, r + 1), by Pascal's rule. The sum starts at 0, where
              C(0, r) is 0, so the base case is 0 = C(1, r + 1).
  let n ∈ ℕ                                                           (H1)
  let r ∈ ℕ                                                           (H2)
  assume r ≤ n                                                        (H3)
  let S(m) = Σ(j = 0 to m) C(j, r), for m ∈ ℕ₀                        (D1)
         reads the sum of the binomial coefficients C(j, r) for j up to m
  then Σ(k = 0 to n) C(k, r) = C(n + 1, r + 1)

1.  For all m ∈ ℕ₀, S(m) = C(m + 1, r + 1).
    induction on m starting at 0

    base
    1.1.  Σ(j = 0 to 0) C(j, r) = C(0, r)
          mun:sum-single a := 0

    1.2.  0 < r
          inequalities, from H2

    1.3.  C(0, r) = 0
          def:C n := 0, k := r, from 1.2

    1.4.  1 < r + 1
          inequalities, from H2

    1.5.  C(1, r + 1) = 0
          def:C n := 1, k := r + 1, from 1.4

    1.6.  S(0) = C(0 + 1, r + 1)
          calculation
            S(0) = Σ(j = 0 to 0) C(j, r)    D1
                 = C(0, r)                  1.1
                 = 0                        1.3
                 = C(1, r + 1)              1.5
                 = C(0 + 1, r + 1)          arithmetic

    step
    let m ∈ ℕ₀                                                        (K)
    assume step 1 is true for m, the induction hypothesis             (IH)

    1.7.  Σ(j = 0 to m + 1) C(j, r) = Σ(j = 0 to m) C(j, r) + C(m + 1, r)
          mun:sum-extended a := 0, n := m
          requires m ≥ 0: from K

    1.8.  S(m + 1) = S(m) + C(m + 1, r)
          calculation
            S(m + 1) = Σ(j = 0 to m + 1) C(j, r)             D1
                     = Σ(j = 0 to m) C(j, r) + C(m + 1, r)   1.7
                     = S(m) + C(m + 1, r)                    D1

    1.9.  S(m) + C(m + 1, r) = C(m + 1, r + 1) + C(m + 1, r)
          substitute S(m) = C(m + 1, r + 1) (IH)

    1.10. C(m + 1, r + 1) + C(m + 1, (r + 1) − 1) = C((m + 1) + 1, r + 1)
          thm:pascal n := m + 1, k := r + 1

    1.11. (r + 1) − 1 = r
          algebra

    1.12. C(m + 1, r + 1) + C(m + 1, r) = C((m + 1) + 1, r + 1)
          substitute (r + 1) − 1 = r (line 1.11) into line 1.10

    1.13. S(m + 1) = C((m + 1) + 1, r + 1)
          calculation
            S(m + 1) = S(m) + C(m + 1, r)                          1.8
                     = C(m + 1, r + 1) + C(m + 1, r)               1.9
                     = C((m + 1) + 1, r + 1)                       1.12

2.  S(n) = C(n + 1, r + 1)
    instantiate m := n in line 1

3.  Σ(k = 0 to n) C(k, r) = C(n + 1, r + 1)
    calculation
      Σ(k = 0 to n) C(k, r) = S(n)                D1
                            = C(n + 1, r + 1)     2
