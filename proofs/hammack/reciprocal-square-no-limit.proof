import definition         stdlib/calculus/limit-at
import mundane theorem    stdlib/sets/difference-subset
import mundane theorem    stdlib/sets/remove-member
import definition         stdlib/numbers/abs
import mundane theorem    stdlib/numbers/abs-difference-lt
import theorem            stdlib/numbers/archimedean-natural
import definition         stdlib/numbers/max
import mundane theorem    stdlib/numbers/max-real
import mundane theorem    stdlib/numbers/le-max
import mundane theorem    stdlib/numbers/multiply-le
import mundane theorem    stdlib/numbers/quotient-real
import mundane theorem    stdlib/numbers/reciprocal-order-strict
import mundane theorem    stdlib/numbers/reciprocal-positive
import mundane theorem    stdlib/numbers/square-positive
import mundane theorem    stdlib/functions/function-value

theorem reciprocal-square-no-limit
  note        Near 1 the function is 1/(x − 1)², which is N² at 1 + 1/N. A
              limit L would be within 1 of f at 1 + 1/N for every N large
              enough to bring 1/N within δ of 0, so N² < L + 1; but N can
              also be taken above L + 1, and N² ≥ N.
  ε, δ range over ℝ
  let f : ℝ ∖ {1} → ℝ                                                 (H1)
  assume for all x ∈ ℝ ∖ {1}, f(x) = 1/(x² − 2x + 1)                 (H2)
  then there is no L ∈ ℝ with f tends to L at 1
  by          contradiction

suppose there is L ∈ ℝ with f tends to L at 1                         (S)

1.  L ∈ ℝ. f tends to L at 1.
    obtain L from S

2.  For all ε > 0, there exists δ > 0 such that |f(x) − L| < ε for all x ∈ ℝ ∖ {1} with (x ≠ 1 and |x − 1| < δ).
    def:limit-at D := ℝ ∖ {1}, c := 1, from 1
    requires ℝ ∖ {1} ⊆ ℝ: mun:difference-subset X := ℝ, Y := {1}

3.  There exists δ > 0 such that |f(x) − L| < 1 for all x ∈ ℝ ∖ {1} with (x ≠ 1 and |x − 1| < δ).
    instantiate ε := 1 in line 2
    requires 0 < 1: arithmetic

4.  p ∈ ℝ. p > 0. For all x ∈ ℝ ∖ {1} with (x ≠ 1 and |x − 1| < p), |f(x) − L| < 1.
    obtain p from line 3

5.  p ≠ 0
    inequalities
      p > 0          4
      p ≠ 0          weakening

6.  1/p > 0
    mun:reciprocal-positive x := p, from 4

7.  1/p ∈ ℝ
    mun:quotient-real x := 1, y := p, from 5

8.  max(1/p, L + 1) ∈ ℝ
    mun:max-real x := 1/p, y := L + 1, from 7

9.  N ∈ ℕ. N > max(1/p, L + 1).
    obtain N: thm:archimedean-natural x := max(1/p, L + 1), from 8

10. 1/p ≤ max(1/p, L + 1)
    mun:le-max x := 1/p, y := L + 1, from 7

11. L + 1 ≤ max(1/p, L + 1)
    mun:le-max x := 1/p, y := L + 1, from 7

12. 1/p < N
    transitivity, from 10, 9
    requires p ≠ 0: from 5
    requires max(1/p, L + 1) ∈ ℝ: from 8

13. L + 1 < N
    transitivity, from 11, 9
    requires max(1/p, L + 1) ∈ ℝ: from 8

14. N > 0
    inequalities, from 9

15. 1/N > 0
    mun:reciprocal-positive x := N, from 14

16. 1 + 1/N ≠ 1
    inequalities
      1/N > 0          15
      1 + 1/N > 1      adding 1
      1 + 1/N ≠ 1      weakening

17. 1 + 1/N ∈ ℝ ∖ {1}
    mun:remove-member u := 1 + 1/N, from 16

18. 1/N < 1/(1/p)
    mun:reciprocal-order-strict x := 1/p, y := N, from 6, 7, 12, 14

19. 1/N < p
    substitute
      1/N < 1/(1/p)      18
      1/N < p            algebra
    requires p ≠ 0: from 5

20. 1 + 1/N − 1 = 1/N
    algebra

21. |1 + 1/N − 1| < p
    calculation
      |1 + 1/N − 1| = |1/N|      substitute line 20
                    = 1/N        def:abs x := 1/N
                    < p          19
    requires 1/N ≥ 0: weakening, from 15

22. 1 + 1/N ≠ 1 and |1 + 1/N − 1| < p
    join 16, 21

23. |f(1 + 1/N) − L| < 1
    instantiate x := 1 + 1/N in line 4, from 17, 22

24. 1/N ≠ 0
    inequalities
      1/N > 0        15
      1/N ≠ 0        weakening

25. (1/N)² > 0
    mun:square-positive x := 1/N, from 24

26. (1 + 1/N)² − 2(1 + 1/N) + 1 > 0
    substitute
      (1/N)² > 0                           25
      (1 + 1/N)² − 2(1 + 1/N) + 1 > 0      algebra

27. (1 + 1/N)² − 2(1 + 1/N) + 1 ≠ 0
    inequalities
      (1 + 1/N)² − 2(1 + 1/N) + 1 > 0        26
      (1 + 1/N)² − 2(1 + 1/N) + 1 ≠ 0        weakening

28. f(1 + 1/N) = N²
    calculation
      f(1 + 1/N) = 1/((1 + 1/N)² − 2(1 + 1/N) + 1)    instantiate x := 1 + 1/N in H2, from 17
                 = N²                                  algebra, from 27

29. L − 1 < f(1 + 1/N) and f(1 + 1/N) < L + 1
    mun:abs-difference-lt x := f(1 + 1/N), c := L, δ := 1, from 23
    requires f(1 + 1/N) ∈ ℝ: mun:function-value, from H1, 17

30. N² < L + 1
    substitute f(1 + 1/N) = N² (line 28) into line 29

31. N·1 ≤ N·N
    mun:multiply-le x := 1, y := N, c := N, from 9

32. N ≤ N²
    inequalities
      N·1 ≤ N·N      31
      N ≤ N²         algebra

33. L + 1 < N²
    transitivity, from 13, 32

34. L + 1 ≤ N²
    inequalities
      L + 1 < N²     33
      L + 1 ≤ N²     weakening

35. not N² < L + 1
    inequalities, from 34, contradicting 30
