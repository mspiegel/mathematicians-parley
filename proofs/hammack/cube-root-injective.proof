import definition         stdlib/functions/one-to-one
import mundane theorem    stdlib/numbers/square-nonneg
import mundane theorem    stdlib/numbers/square-positive
import mundane theorem    stdlib/numbers/zero-product
import mundane theorem    stdlib/sets/remove-member

theorem cube-injective
  note        a³ − b³ = (a − b)(a² + ab + b²), so a ≠ b gives a² + ab + b² =
              0; but 4(a² + ab + b²) = (a − b)² + 3(a + b)², which is
              positive.
  let a ∈ ℝ                                                           (H1)
  let b ∈ ℝ                                                           (H2)
  assume a³ = b³                                                      (H3)
  then a = b

1.  a = b
    contradiction
    suppose a ≠ b                                                     (S)

    1.1.  (a − b)² > 0
          mun:square-positive x := a − b
          requires a − b ≠ 0: inequalities, from S

    1.2.  (a + b)² ≥ 0
          mun:square-nonneg x := a + b

    1.3.  3·(a + b)² ≥ 0
          inequalities
            (a + b)² ≥ 0           1.2
            3·(a + b)² ≥ 0         multiplying by 3

    1.4.  (a − b)² + 3·(a + b)² > 0
          inequalities, from 1.1, 1.3

    1.5.  (a − b)·(a² + a·b + b²) = 0
          algebra, from H3

    1.6.  a − b = 0 or a² + a·b + b² = 0
          mun:zero-product x := a − b, y := a² + a·b + b², from 1.5

    1.7.  a² + a·b + b² = 0
          cases, from 1.6

          case
          assume a − b = 0                                            (C1)

          1.7.1.  a = b
                  algebra, from C1, contradicting S

          case
          assume a² + a·b + b² = 0, which is the claim                (C2)

    1.8.  (a − b)² + 3·(a + b)² = 0
          algebra, from 1.7

    1.9.  (a − b)² + 3·(a + b)² ≤ 0
          inequalities
            (a − b)² + 3·(a + b)² = 0       1.8
            (a − b)² + 3·(a + b)² ≤ 0       weakening

    1.10. not (a − b)² + 3·(a + b)² > 0
          inequalities, from 1.9, contradicting 1.4

theorem cubed-mobius-one-to-one
  note        Equal cubes have equal cube roots, so (s + 1)/(s − 1) = (t +
              1)/(t − 1), which cross-multiplies to s = t.
  let f : ℝ ∖ {1} → ℝ ∖ {1}                                          (H1)
  assume for all x ∈ ℝ ∖ {1}, f(x) = ((x + 1)/(x − 1))³              (H2)
  then f : ℝ ∖ {1} → ℝ ∖ {1} is one-to-one

1.  For all s, t ∈ ℝ ∖ {1}, if f(s) = f(t) then s = t.
    proof
    let s ∈ ℝ ∖ {1}                                                   (K1)
    let t ∈ ℝ ∖ {1}                                                   (K2)
    assume f(s) = f(t)                                                (A1)

    1.1.  s ∈ ℝ. s ≠ 1.
          mun:remove-member u := s, Y := ℝ, a := 1, from K1

    1.2.  t ∈ ℝ. t ≠ 1.
          mun:remove-member u := t, Y := ℝ, a := 1, from K2

    1.3.  s − 1 ≠ 0
          algebra, from 1.1

    1.4.  t − 1 ≠ 0
          algebra, from 1.2

    1.5.  ((s + 1)/(s − 1))³ = ((t + 1)/(t − 1))³
          calculation
            ((s + 1)/(s − 1))³ = f(s)                instantiate x := s in H2, from K1
                               = f(t)                A1
                               = ((t + 1)/(t − 1))³  instantiate x := t in H2, from K2

    1.6.  (s + 1)/(s − 1) = (t + 1)/(t − 1)
          thm:cube-injective a := (s + 1)/(s − 1), b := (t + 1)/(t − 1), from 1.5
          requires (s + 1)/(s − 1) ∈ ℝ: membership, from 1.1, 1.3
          requires (t + 1)/(t − 1) ∈ ℝ: membership, from 1.2, 1.4

    1.7.  s = t
          algebra, from 1.1, 1.2, 1.3, 1.4, 1.6

2.  f : ℝ ∖ {1} → ℝ ∖ {1} is one-to-one
    def:one-to-one, from H1, 1
