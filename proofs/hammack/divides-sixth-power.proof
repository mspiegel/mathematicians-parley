import mundane definition stdlib/divisibility/divides

theorem divides-sixth-power
  note        Write b = a²·k and c = b³·m. Then c = (a²·k)³·m = a⁶·(k³·m).
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  let c ∈ ℤ                                                           (H3)
  assume a² divides b                                                 (H4)
  assume b³ divides c                                                 (H5)
  then a⁶ divides c

1.  k ∈ ℤ. b = a²·k.
    obtain k: mun:divides, from H4

2.  m ∈ ℤ. c = b³·m.
    obtain m: mun:divides, from H5

3.  b³ = (a²·k)³
    substitute b = a²·k (line 1)

4.  c = (a²·k)³·m
    substitute b³ = (a²·k)³ (line 3) into line 2

5.  (a²·k)³·m = a⁶·(k³·m)
    algebra

6.  c = a⁶·(k³·m)
    calculation
      c = (a²·k)³·m       4
        = a⁶·(k³·m)       5

7.  a⁶ divides c
    mun:divides d := a⁶, n := c, from 6
