import definition         stdlib/calculus/limit-at
import mundane theorem    stdlib/sets/subset-self
import mundane theorem    stdlib/numbers/abs-difference-lt
import mundane theorem    stdlib/functions/function-value

theorem linear-limit
  note        8x − 3 is within ε of 37 wherever x is within ε/8 of 5.
  ε, δ range over ℝ
  let f : ℝ → ℝ                                                       (H1)
  assume for all x ∈ ℝ, f(x) = 8x − 3                                (H2)
  then f tends to 37 at 5

1.  For all ε > 0, there exists δ > 0 such that |f(x) − 37| < ε for all x ∈ ℝ with (x ≠ 5 and |x − 5| < δ).
    proof
    let ε ∈ ℝ                                                         (K1)
    assume ε > 0                                                      (A1)

    1.1.  ε/8 > 0
          inequalities, from A1

    1.2.  For all x ∈ ℝ with (x ≠ 5 and |x − 5| < ε/8), |f(x) − 37| < ε.
          proof
          let x ∈ ℝ                                                   (K2)
          assume x ≠ 5 and |x − 5| < ε/8                              (A2)

          1.2.1.  f(x) = 8x − 3
                  instantiate x := x in H2

          1.2.2.  5 − ε/8 < x and x < 5 + ε/8
                  mun:abs-difference-lt c := 5, δ := ε/8, from A2

          1.2.3.  37 − ε < f(x) and f(x) < 37 + ε
                  inequalities, from 1.2.1, 1.2.2
                  requires f(x) ∈ ℝ: mun:function-value

          1.2.4.  |f(x) − 37| < ε
                  mun:abs-difference-lt x := f(x), c := 37, δ := ε, from 1.2.3
                  requires f(x) ∈ ℝ: mun:function-value

    1.3.  There exists δ > 0 such that |f(x) − 37| < ε for all x ∈ ℝ with (x ≠ 5 and |x − 5| < δ).
          exhibit, from 1.1, 1.2

2.  f tends to 37 at 5
    def:limit-at D := ℝ, c := 5, L := 37, from 1
    requires ℝ ⊆ ℝ: mun:subset-self
