import mundane definition stdlib/divisibility/divides
import mundane definition stdlib/sets/set-builder
import mundane definition stdlib/sets/subset

theorem divisors-of-k-divide-k-squared
  note        If k = t·c then k² = t·(c·k).
  let k ∈ ℤ                                                           (H1)
  then {n ∈ ℤ : n divides k} ⊆ {n ∈ ℤ : n divides k²}

1.  For all t ∈ {n ∈ ℤ : n divides k}, t ∈ {n ∈ ℤ : n divides k²}.
    proof
    let t ∈ {n ∈ ℤ : n divides k}                                     (K1)

    1.1.  t ∈ ℤ. t divides k.
          mun:set-builder, from K1

    1.2.  c ∈ ℤ. k = t·c
          obtain c: mun:divides d := t, n := k, from 1.1

    1.3.  k² = t·(c·k)
          algebra, from 1.1, 1.2

    1.4.  t divides k²
          mun:divides d := t, n := k², from 1.1, 1.3

    1.5.  t ∈ {n ∈ ℤ : n divides k²}
          mun:set-builder, from 1.1, 1.4

2.  {n ∈ ℤ : n divides k} ⊆ {n ∈ ℤ : n divides k²}
    mun:subset, from 1
