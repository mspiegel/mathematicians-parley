import theorem            proofs/hammack/cube-congruent-mod-three/residue-mod-three
import theorem            proofs/setmm/parity/odd-plus-odd
import theorem            proofs/setmm/parity/even-plus-odd
import mundane definition stdlib/divisibility/divides
import mundane definition stdlib/divisibility/even
import mundane definition stdlib/divisibility/odd
import mundane theorem    stdlib/divisibility/mod-less
import mundane theorem    stdlib/divisibility/mod-natural
import mundane theorem    stdlib/divisibility/mod-remainder
import mundane theorem    stdlib/divisibility/not-both
import mundane theorem    stdlib/numbers/integer-step
import mundane theorem    stdlib/numbers/nat0-as-int
import mundane theorem    stdlib/numbers/pos-int-nat

theorem odd-plus-even
  note        An odd number 2k + 1 and an even 2l add to 2k + 2l + 1, which
              is twice k + l, plus 1.
  let A ∈ ℤ                                                           (H1)
  let B ∈ ℤ                                                           (H2)
  assume A is odd                                                     (H3)
  assume B is even                                                    (H4)
  then A + B is odd

1.  k ∈ ℤ. A = 2k + 1.
    obtain k: mun:odd n := A, from H3

2.  l ∈ ℤ. B = 2l.
    obtain l: mun:even n := B, from H4

3.  A + B = 2(k + l) + 1
    algebra, from 1, 2

4.  A + B is odd
    mun:odd n := A + B, from 3

theorem fibonacci-even-iff-three-divides
  note        The Fibonacci numbers repeat even, odd, odd: F(3k) is even and
              F(3k + 1) and F(3k + 2) are odd, by induction on k, since a sum
              of two odd numbers is even and an even and an odd add to an
              odd. Dividing n by 3, F(n) is even exactly when the remainder
              is 0.
  let n ∈ ℕ                                                           (H1)
  let F(0) = 0,  G(0) = 1,
      F(k + 1) = G(k),  G(k + 1) = F(k) + G(k),  for k ∈ ℕ₀           (D1)
         reads the Fibonacci numbers, F(k) the kth and G(k) the next
  then F(n) is even ↔ 3 divides n

1.  For all k ∈ ℕ₀, F(k) ∈ ℕ₀ and G(k) ∈ ℕ₀.
    induction on k starting at 0

    base
    1.1.  F(0) = 0
          D1

    1.2.  G(0) = 1
          D1

    1.3.  F(0) ∈ ℕ₀
          membership, from 1.1

    1.4.  G(0) ∈ ℕ₀
          membership, from 1.2

    1.5.  F(0) ∈ ℕ₀ and G(0) ∈ ℕ₀
          join 1.3, 1.4

    step
    let k ∈ ℕ₀                                                        (K)
    assume step 1 is true for k, the induction hypothesis             (IH)

    1.6.  F(k + 1) = G(k)
          D1

    1.7.  G(k + 1) = F(k) + G(k)
          D1

    1.8.  F(k + 1) ∈ ℕ₀
          membership, from IH, 1.6

    1.9.  G(k + 1) ∈ ℕ₀
          membership, from IH, 1.7

    1.10. F(k + 1) ∈ ℕ₀ and G(k + 1) ∈ ℕ₀
          join 1.8, 1.9

2.  For all k ∈ ℕ₀, F(k) ∈ ℤ.
    proof
    let k ∈ ℕ₀                                                        (K1)

    2.1.  F(k) ∈ ℤ
          membership, from 1

3.  For all k ∈ ℕ₀, F(k + 2) = F(k) + F(k + 1).
    proof
    let k ∈ ℕ₀                                                        (K2)

    3.1.  k + 2 = (k + 1) + 1
          algebra

    3.2.  F((k + 1) + 1) = G(k + 1)
          D1

    3.3.  G(k + 1) = F(k) + G(k)
          D1

    3.4.  F(k + 1) = G(k)
          D1

    3.5.  F((k + 1) + 1) = F(k) + G(k)
          transitivity, from 3.2, 3.3

    3.6.  F((k + 1) + 1) = F(k) + F(k + 1)
          substitute F(k + 1) = G(k) (line 3.4) into line 3.5

    3.7.  F(k + 2) = F(k) + F(k + 1)
          substitute k + 2 = (k + 1) + 1 (line 3.1) into line 3.6

4.  For all k ∈ ℕ₀, F(3k) is even and F(3k + 1) is odd and F(3k + 2) is odd.
    induction on k starting at 0

    base
    4.1.  F(0) = 0
          D1

    4.2.  F(0 + 1) = G(0)
          D1

    4.3.  G(0) = 1
          D1

    4.4.  F(0 + 1) = 1
          calculation
            F(0 + 1) = G(0)    4.2
                     = 1       4.3

    4.5.  F(0 + 2) = F(0) + F(0 + 1)
          instantiate k := 0 in line 3

    4.6.  F(0 + 2) = 1
          algebra, from 4.1, 4.4, 4.5

    4.7.  F(3·0) = 2·0
          calculation
            F(3·0) = F(0)    arithmetic
                   = 0       4.1
                   = 2·0     arithmetic

    4.8.  F(3·0) is even
          mun:even n := F(3·0), from 4.7
          requires F(3·0) ∈ ℤ: membership, from 4.7

    4.9.  F(3·0 + 1) = 2·0 + 1
          calculation
            F(3·0 + 1) = F(0 + 1)    arithmetic
                       = 1           4.4
                       = 2·0 + 1     arithmetic

    4.10. F(3·0 + 1) is odd
          mun:odd n := F(3·0 + 1), from 4.9
          requires F(3·0 + 1) ∈ ℤ: membership, from 4.9

    4.11. F(3·0 + 2) = 2·0 + 1
          calculation
            F(3·0 + 2) = F(0 + 2)    arithmetic
                       = 1           4.6
                       = 2·0 + 1     arithmetic

    4.12. F(3·0 + 2) is odd
          mun:odd n := F(3·0 + 2), from 4.11
          requires F(3·0 + 2) ∈ ℤ: membership, from 4.11

    4.13. F(3·0) is even and F(3·0 + 1) is odd and F(3·0 + 2) is odd
          join 4.8, 4.10, 4.12

    step
    let k ∈ ℕ₀                                                        (K3)
    assume step 4 is true for k, the induction hypothesis             (IH2)

    4.14. F(3k + 1) ∈ ℤ
          instantiate k := 3k + 1 in line 2

    4.15. F(3k + 2) ∈ ℤ
          instantiate k := 3k + 2 in line 2

    4.16. F((3k + 1) + 2) = F(3k + 1) + F((3k + 1) + 1)
          instantiate k := 3k + 1 in line 3

    4.17. (3k + 1) + 2 = 3(k + 1)
          algebra

    4.18. (3k + 1) + 1 = 3k + 2
          algebra

    4.19. F(3(k + 1)) = F(3k + 1) + F((3k + 1) + 1)
          substitute (3k + 1) + 2 = 3(k + 1) (line 4.17) into line 4.16

    4.20. F(3(k + 1)) = F(3k + 1) + F(3k + 2)
          substitute (3k + 1) + 1 = 3k + 2 (line 4.18) into line 4.19

    4.21. F(3k + 1) + F(3k + 2) is even
          thm:odd-plus-odd A := F(3k + 1), B := F(3k + 2), from IH2
          requires F(3k + 1) ∈ ℤ: from 4.14
          requires F(3k + 2) ∈ ℤ: from 4.15

    4.22. F(3(k + 1)) is even
          substitute F(3(k + 1)) = F(3k + 1) + F(3k + 2) (line 4.20) into line 4.21

    4.23. F((3k + 2) + 2) = F(3k + 2) + F((3k + 2) + 1)
          instantiate k := 3k + 2 in line 3

    4.24. (3k + 2) + 2 = 3(k + 1) + 1
          algebra

    4.25. (3k + 2) + 1 = 3(k + 1)
          algebra

    4.26. F(3(k + 1) + 1) = F(3k + 2) + F((3k + 2) + 1)
          substitute (3k + 2) + 2 = 3(k + 1) + 1 (line 4.24) into line 4.23

    4.27. F(3(k + 1) + 1) = F(3k + 2) + F(3(k + 1))
          substitute (3k + 2) + 1 = 3(k + 1) (line 4.25) into line 4.26

    4.28. F(3(k + 1)) ∈ ℤ
          instantiate k := 3(k + 1) in line 2

    4.29. F(3k + 2) + F(3(k + 1)) is odd
          thm:odd-plus-even A := F(3k + 2), B := F(3(k + 1)), from IH2, 4.22
          requires F(3k + 2) ∈ ℤ: from 4.15
          requires F(3(k + 1)) ∈ ℤ: from 4.28

    4.30. F(3(k + 1) + 1) is odd
          substitute F(3(k + 1) + 1) = F(3k + 2) + F(3(k + 1)) (line 4.27) into line 4.29

    4.31. F(3(k + 1) + 2) = F(3(k + 1)) + F(3(k + 1) + 1)
          instantiate k := 3(k + 1) in line 3

    4.32. F(3(k + 1) + 1) ∈ ℤ
          instantiate k := 3(k + 1) + 1 in line 2

    4.33. F(3(k + 1)) + F(3(k + 1) + 1) is odd
          thm:even-plus-odd A := F(3(k + 1)), B := F(3(k + 1) + 1), from 4.22, 4.30
          requires F(3(k + 1)) ∈ ℤ: from 4.28
          requires F(3(k + 1) + 1) ∈ ℤ: from 4.32

    4.34. F(3(k + 1) + 2) is odd
          substitute F(3(k + 1) + 2) = F(3(k + 1)) + F(3(k + 1) + 1) (line 4.31) into line 4.33

    4.35. F(3(k + 1)) is even and F(3(k + 1) + 1) is odd and F(3(k + 1) + 2) is odd
          join 4.22, 4.30, 4.34

5.  F(n) is even ↔ 3 divides n
    both directions

    direction
    assume F(n) is even                                               (P1)

    5.1.  n mod 3 ∈ ℕ₀
          mun:mod-natural a := n, b := 3

    5.2.  n mod 3 < 3
          mun:mod-less a := n, b := 3

    5.3.  n mod 3 = 0 or n mod 3 = 1 or n mod 3 = 2
          thm:residue-mod-three r := n mod 3, from 5.1, 5.2

    5.4.  There is q ∈ ℤ with q·3 + n mod 3 = n.
          mun:mod-remainder a := n, m := 3, r := n mod 3, from 5.1, 5.2

    5.5.  q ∈ ℤ. q·3 + n mod 3 = n.
          obtain q from line 5.4

    5.6.  q·3 = n − n mod 3
          algebra, from 5.5
          requires n mod 3 ∈ ℝ: from 5.1

    5.7.  n ≥ 1
          inequalities, from H1

    5.8.  n − n mod 3 > n − 3
          inequalities
            n mod 3 < 3                5.2
            −(n mod 3) > −3            multiplying by −1
            n − n mod 3 > n − 3        adding n
          requires n mod 3 ∈ ℝ: from 5.1

    5.9.  n − 3 ≥ −2
          inequalities
            n ≥ 1                      5.7
            n − 3 ≥ −2                 adding −3

    5.10. q·3 > −2
          transitivity, from 5.6, 5.8, 5.9
          requires n mod 3 ∈ ℝ: from 5.1

    5.11. q > −2/3
          inequalities
            q·3 > −2                   5.10
            q > −2/3                   multiplying by 1/3

    5.12. q > −1
          calculation
            q > −2/3    5.11
              > −1      arithmetic

    5.13. −1 + 1 ≤ q
          mun:integer-step m := −1, n := q, from 5.12

    5.14. 0 ≤ q
          calculation
            0 = −1 + 1    arithmetic
              ≤ q         5.13

    5.15. q ∈ ℕ₀
          mun:nat0-as-int n := q, from 5.14

    5.16. 3 divides n
          cases, from 5.3

          case
          assume n mod 3 = 0                                          (C1)

          5.16.1. q·3 = n
                  substitute n mod 3 = 0 (C1) into line 5.5

          5.16.2. n = 3·q
                  algebra, from 5.16.1

          5.16.3. 3 divides n
                  mun:divides d := 3, from 5.16.2

          case
          assume n mod 3 = 1                                          (C2)

          5.16.4. q·3 + 1 = n
                  substitute n mod 3 = 1 (C2) into line 5.5

          5.16.5. n = 3q + 1
                  algebra, from 5.16.4

          5.16.6. F(3q) is even and F(3q + 1) is odd and F(3q + 2) is odd
                  instantiate k := q in line 4, from 5.15

          5.16.7. F(3q + 1) is odd
                  join 5.16.6

          5.16.8. F(3q + 1) ∈ ℤ
                  instantiate k := 3q + 1 in line 2
                  requires 3q + 1 ∈ ℕ₀: membership, from 5.15

          5.16.9. F(3q + 1) is even
                  substitute n = 3q + 1 (line 5.16.5) into P1

          5.16.10. F(3q + 1) is not odd
                   mun:not-both n := F(3q + 1), from 5.16.9, contradicting 5.16.7
                   requires F(3q + 1) ∈ ℤ: from 5.16.8

          case
          assume n mod 3 = 2                                          (C3)

          5.16.11. q·3 + 2 = n
                   substitute n mod 3 = 2 (C3) into line 5.5

          5.16.12. n = 3q + 2
                   algebra, from 5.16.11

          5.16.13. F(3q) is even and F(3q + 1) is odd and F(3q + 2) is odd
                   instantiate k := q in line 4, from 5.15

          5.16.14. F(3q + 2) is odd
                   join 5.16.13

          5.16.15. F(3q + 2) ∈ ℤ
                   instantiate k := 3q + 2 in line 2
                   requires 3q + 2 ∈ ℕ₀: membership, from 5.15

          5.16.16. F(3q + 2) is even
                   substitute n = 3q + 2 (line 5.16.12) into P1

          5.16.17. F(3q + 2) is not odd
                   mun:not-both n := F(3q + 2), from 5.16.16, contradicting 5.16.14
                   requires F(3q + 2) ∈ ℤ: from 5.16.15

    direction
    assume 3 divides n                                                (P2)

    5.17. k ∈ ℤ. n = 3·k.
          obtain k: mun:divides d := 3, from P2

    5.18. n ≥ 1
          inequalities, from H1

    5.19. 3·k ≥ 1
          transitivity, from 5.17, 5.18

    5.20. k ≥ 1/3
          inequalities
            3·k ≥ 1        5.19
            k ≥ 1/3        multiplying by 1/3

    5.21. k > 0
          calculation
            k ≥ 1/3    5.20
              > 0      arithmetic

    5.22. k ∈ ℕ
          mun:pos-int-nat m := k, from 5.21

    5.23. F(3k) is even and F(3k + 1) is odd and F(3k + 2) is odd
          instantiate k := k in line 4, from 5.22

    5.24. F(3k) is even
          join 5.23

    5.25. F(n) is even
          substitute n = 3·k (line 5.17) into line 5.24
