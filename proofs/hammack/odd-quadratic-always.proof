import definition         stdlib/divisibility/even
import mundane theorem    stdlib/divisibility/even-or-odd
import definition         stdlib/divisibility/odd

theorem odd-quadratic-always
  note        An integer is even or odd. If n = 2k, then 5n² + 3n + 7 is
              20k² + 6k + 7, twice 10k² + 3k + 3, plus 1. If n = 2k + 1, it
              is 20k² + 26k + 15, twice 10k² + 13k + 7, plus 1.
  let n ∈ ℤ                                                           (H1)
  then 5n² + 3n + 7 is odd

1.  n is even or n is odd
    mun:even-or-odd

2.  5n² + 3n + 7 is odd
    cases, from 1

    case
    assume n is even                                                  (C1)

    2.1.  k ∈ ℤ. n = 2k.
          obtain k: def:even, from C1

    2.2.  5n² + 3n + 7 = 2(10k² + 3k + 3) + 1
          calculation
            5n² + 3n + 7 = 5(2k)² + 3(2k) + 7     substitute line 2.1
                         = 2(10k² + 3k + 3) + 1   algebra

    2.3.  5n² + 3n + 7 is odd
          def:odd n := 5n² + 3n + 7, from 2.2

    case
    assume n is odd                                                   (C2)

    2.4.  k ∈ ℤ. n = 2k + 1.
          obtain k: def:odd, from C2

    2.5.  5n² + 3n + 7 = 2(10k² + 13k + 7) + 1
          calculation
            5n² + 3n + 7 = 5(2k + 1)² + 3(2k + 1) + 7   substitute line 2.4
                         = 2(10k² + 13k + 7) + 1        algebra

    2.6.  5n² + 3n + 7 is odd
          def:odd n := 5n² + 3n + 7, from 2.5
