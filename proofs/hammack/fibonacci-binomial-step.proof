import definition         stdlib/counting/C
import theorem            stdlib/counting/pascal
import mundane theorem    stdlib/numbers/nat0-successor
import mundane theorem    stdlib/sums/range-difference
import mundane theorem    stdlib/sums/sum-add
import mundane theorem    stdlib/sums/sum-first
import mundane theorem    stdlib/sums/sum-last
import mundane theorem    stdlib/sums/sum-real
import mundane theorem    stdlib/sums/sum-shift
import mundane theorem    stdlib/sums/sum-termwise

theorem fibonacci-binomial-step
  note        The top term of the sum for m + 2 is C(0, m + 2) = 0. Pascal's
              rule splits each remaining C((m + 2) − k, k) into
              C((m + 1) − k, k) + C((m + 1) − k, k − 1); the first parts sum
              to the sum for m + 1, and in the second the k = 0 term is
              C(m + 1, −1) = 0 and the rest, shifted by one, is the sum for m.
  let m ∈ ℕ₀                                                          (H1)
  then Σ(k = 0 to (m + 1) + 1) C(((m + 1) + 1) − k, k) = Σ(k = 0 to m + 1) C((m + 1) − k, k) + Σ(k = 0 to m) C(m − k, k)

1.  For all k ∈ {0, …, (m + 1) + 1}, C(((m + 1) + 1) − k, k) ∈ ℝ.
    proof
    let k ∈ {0, …, (m + 1) + 1}                                       (J)

    1.1.  C(((m + 1) + 1) − k, k) ∈ ℝ
          membership
          requires ((m + 1) + 1) − k ∈ ℕ₀: mun:range-difference a := 0, n := (m + 1) + 1, from J

2.  For all k ∈ {0, …, m + 1}, C(((m + 1) + 1) − k, k) ∈ ℝ.
    proof
    let k ∈ {0, …, m + 1}                                             (J)

    2.1.  (m + 1) − k ∈ ℕ₀
          mun:range-difference a := 0, n := m + 1, from J

    2.2.  ((m + 1) − k) + 1 ∈ ℕ
          mun:nat0-successor k := (m + 1) − k, from 2.1

    2.3.  ((m + 1) + 1) − k ∈ ℕ
          substitute
            ((m + 1) − k) + 1 ∈ ℕ      2.2
            ((m + 1) + 1) − k ∈ ℕ      algebra

    2.4.  C(((m + 1) + 1) − k, k) ∈ ℝ
          membership
          requires ((m + 1) + 1) − k ∈ ℕ₀: from 2.3

3.  Σ(k = 0 to (m + 1) + 1) C(((m + 1) + 1) − k, k) = Σ(k = 0 to m + 1) C(((m + 1) + 1) − k, k) + C(((m + 1) + 1) − ((m + 1) + 1), (m + 1) + 1)
    mun:sum-last n := m + 1, from 1

4.  ((m + 1) + 1) − ((m + 1) + 1) = 0
    algebra

5.  0 < (m + 1) + 1
    inequalities, from H1

6.  C(((m + 1) + 1) − ((m + 1) + 1), (m + 1) + 1) = 0
    calculation
      C(((m + 1) + 1) − ((m + 1) + 1), (m + 1) + 1) = C(0, (m + 1) + 1)     substitute line 4
                                                    = 0                     def:C n := 0, k := (m + 1) + 1, from 5

7.  Σ(k = 0 to (m + 1) + 1) C(((m + 1) + 1) − k, k) = Σ(k = 0 to m + 1) C(((m + 1) + 1) − k, k)
    substitute C(((m + 1) + 1) − ((m + 1) + 1), (m + 1) + 1) = 0 (line 6) into line 3
    requires Σ(k = 0 to m + 1) C(((m + 1) + 1) − k, k) ∈ ℝ: mun:sum-real a := 0, b := m + 1, from 2

8.  For all k ∈ {0, …, m + 1}, C(((m + 1) + 1) − k, k) = C((m + 1) − k, k) + C((m + 1) − k, k − 1).
    proof
    let k ∈ {0, …, m + 1}                                             (J)

    8.1.  (m + 1) − k ∈ ℕ₀
          mun:range-difference a := 0, n := m + 1, from J

    8.2.  ((m + 1) − k) + 1 = ((m + 1) + 1) − k
          algebra

    8.3.  C(((m + 1) + 1) − k, k) = C((m + 1) − k, k) + C((m + 1) − k, k − 1)
          calculation
            C(((m + 1) + 1) − k, k) = C(((m + 1) − k) + 1, k)                           substitute line 8.2
                                    = C((m + 1) − k, k) + C((m + 1) − k, k − 1)         thm:pascal n := (m + 1) − k, from 8.1

9.  For all k ∈ {0, …, m + 1}, C((m + 1) − k, k) ∈ ℝ.
    proof
    let k ∈ {0, …, m + 1}                                             (J)

    9.1.  (m + 1) − k ∈ ℕ₀
          mun:range-difference a := 0, n := m + 1, from J

    9.2.  C((m + 1) − k, k) ∈ ℝ
          membership
          requires (m + 1) − k ∈ ℕ₀: from 9.1

10. For all k ∈ {0, …, m + 1}, C((m + 1) − k, k − 1) ∈ ℝ.
    proof
    let k ∈ {0, …, m + 1}                                             (J)

    10.1. (m + 1) − k ∈ ℕ₀
          mun:range-difference a := 0, n := m + 1, from J

    10.2. C((m + 1) − k, k − 1) ∈ ℝ
          membership
          requires (m + 1) − k ∈ ℕ₀: from 10.1

11. For all k ∈ {0, …, m + 1}, C((m + 1) − k, k) + C((m + 1) − k, k − 1) ∈ ℝ.
    proof
    let k ∈ {0, …, m + 1}                                             (J)

    11.1. (m + 1) − k ∈ ℕ₀
          mun:range-difference a := 0, n := m + 1, from J

    11.2. C((m + 1) − k, k) + C((m + 1) − k, k − 1) ∈ ℝ
          membership
          requires (m + 1) − k ∈ ℕ₀: from 11.1

12. Σ(k = 0 to m + 1) C((m + 1) − k, k − 1) = C(m + 1, 0 − 1) + Σ(k = 1 to m + 1) C((m + 1) − k, k − 1)
    mun:sum-first n := m + 1, from 10

13. C(m + 1, 0 − 1) = 0
    calculation
      C(m + 1, 0 − 1) = C(m + 1, −1)    arithmetic
                      = 0               def:C n := m + 1

14. For all k ∈ {1, …, m + 1}, C((m + 1) − k, k − 1) ∈ ℝ.
    proof
    let k ∈ {1, …, m + 1}                                             (J)

    14.1. (m + 1) − k ∈ ℕ₀
          mun:range-difference a := 1, n := m + 1, from J

    14.2. C((m + 1) − k, k − 1) ∈ ℝ
          membership
          requires (m + 1) − k ∈ ℕ₀: from 14.1

15. Σ(k = 0 to m + 1) C((m + 1) − k, k − 1) = Σ(k = 1 to m + 1) C((m + 1) − k, k − 1)
    substitute C(m + 1, 0 − 1) = 0 (line 13) into line 12
    requires Σ(k = 1 to m + 1) C((m + 1) − k, k − 1) ∈ ℝ: mun:sum-real a := 1, b := m + 1, from 14

16. For all k ∈ {0, …, m}, C(m − k, k) ∈ ℝ.
    proof
    let k ∈ {0, …, m}                                                 (J)

    16.1. m − k ∈ ℕ₀
          mun:range-difference a := 0, n := m, from J

    16.2. C(m − k, k) ∈ ℝ
          membership
          requires m − k ∈ ℕ₀: from 16.1

17. For all k ∈ {1, …, m + 1}, C((m + 1) − k, k − 1) = C(m − (k − 1), k − 1).
    proof
    let k ∈ {1, …, m + 1}                                             (J)

    17.1. (m + 1) − k = m − (k − 1)
          algebra

    17.2. C((m + 1) − k, k − 1) = C(m − (k − 1), k − 1)
          substitute (m + 1) − k = m − (k − 1) (line 17.1)

18. For all k ∈ {1, …, m + 1}, C(m − (k − 1), k − 1) ∈ ℝ.
    proof
    let k ∈ {1, …, m + 1}                                             (J)

    18.1. (m + 1) − k ∈ ℕ₀
          mun:range-difference a := 1, n := m + 1, from J

    18.2. m − (k − 1) ∈ ℕ₀
          substitute
            (m + 1) − k ∈ ℕ₀      18.1
            m − (k − 1) ∈ ℕ₀      algebra

    18.3. C(m − (k − 1), k − 1) ∈ ℝ
          membership
          requires m − (k − 1) ∈ ℕ₀: from 18.2

19. Σ(k = 0 to m + 1) C((m + 1) − k, k − 1) = Σ(k = 0 to m) C(m − k, k)
    calculation
      Σ(k = 0 to m + 1) C((m + 1) − k, k − 1) = Σ(k = 1 to m + 1) C((m + 1) − k, k − 1)     15
                                              = Σ(k = 1 to m + 1) C(m − (k − 1), k − 1)     mun:sum-termwise a := 1, b := m + 1, from 14, 17, 18
                                              = Σ(k = 0 to m) C(m − k, k)                   mun:sum-shift a := 0, b := m, c := 1, from 16

20. Σ(k = 0 to (m + 1) + 1) C(((m + 1) + 1) − k, k) = Σ(k = 0 to m + 1) C((m + 1) − k, k) + Σ(k = 0 to m) C(m − k, k)
    calculation
      Σ(k = 0 to (m + 1) + 1) C(((m + 1) + 1) − k, k) = Σ(k = 0 to m + 1) C(((m + 1) + 1) − k, k)                                                    7
                                                      = Σ(k = 0 to m + 1) (C((m + 1) − k, k) + C((m + 1) − k, k − 1))                                 mun:sum-termwise a := 0, b := m + 1, from 2, 8, 11
                                                      = Σ(k = 0 to m + 1) C((m + 1) − k, k) + Σ(k = 0 to m + 1) C((m + 1) − k, k − 1)                mun:sum-add a := 0, b := m + 1, from 9, 10
                                                      = Σ(k = 0 to m + 1) C((m + 1) − k, k) + Σ(k = 0 to m) C(m − k, k)                              substitute line 19
