import mundane theorem    stdlib/numbers/square-nonneg
import mundane theorem    stdlib/numbers/multiply-le

theorem cubic-above-minus-one
  note        x³ − x factors as (x² − x)(x + 1). If x were at most −1, the
              first factor would be positive and the second at most 0, so the
              product would not be positive.
  let x ∈ ℝ                                                           (H1)
  assume x³ − x > 0                                                   (H2)
  then x > −1
  by          contradiction

suppose not x > −1                                                    (S)

1.  x ≤ −1
    inequalities, from S

2.  x² ≥ 0
    mun:square-nonneg

3.  −x ≥ 1
    inequalities
      x ≤ −1           1
      −x ≥ 1           multiplying by −1

4.  x² − x > 0
    inequalities, from 2, 3

5.  x + 1 ≤ 0
    inequalities, from 1

6.  (x² − x)·(x + 1) ≤ (x² − x)·0
    mun:multiply-le x := x + 1, y := 0, c := x² − x, from 4, 5

7.  x³ − x ≤ 0
    inequalities
      (x² − x)·(x + 1) ≤ (x² − x)·0      6
      (x² − x)·(x + 1) ≤ 0               algebra
      x³ − x ≤ 0                         algebra

8.  not x³ − x > 0
    inequalities, from 7, contradicting H2
