import definition         stdlib/calculus/limit-at
import mundane theorem    stdlib/sets/subset-self
import mundane theorem    stdlib/numbers/abs-difference-lt
import definition         stdlib/numbers/min
import mundane theorem    stdlib/numbers/min-real
import mundane theorem    stdlib/numbers/min-le
import mundane theorem    stdlib/numbers/lt-min
import mundane theorem    stdlib/functions/function-value

theorem limit-unfolded
  note        What f tends to L at c says, written out on the part D of the
              line that f is defined on.
  ε, δ range over ℝ
  let D ⊆ ℝ                                                           (H1)
  let f : D → ℝ                                                       (H2)
  let c ∈ ℝ                                                           (H3)
  let L ∈ ℝ                                                           (H4)
  assume f tends to L at c                                            (H5)
  then for all ε > 0, there exists δ > 0 such that |f(x) − L| < ε for all x ∈ D with (x ≠ c and |x − c| < δ)

1.  For all ε > 0, there exists δ > 0 such that |f(x) − L| < ε for all x ∈ D with (x ≠ c and |x − c| < δ).
    def:limit-at, from H1, H5


theorem limit-order
  note        Suppose L < M. Within (M − L)/3 of both, f(x) would lie above
              M − (M − L)/3 and below L + (M − L)/3, at a point near c that
              is not c; that makes M − L less than 2(M − L)/3.
  ε, δ range over ℝ
  let f : ℝ → ℝ                                                       (H1)
  let c ∈ ℝ                                                           (H2)
  let L ∈ ℝ                                                           (H3)
  let M ∈ ℝ                                                           (H4)
  assume f tends to L at c                                            (H5)
  assume f tends to M at c                                            (H6)
  then M ≤ L
  by          contradiction

suppose not M ≤ L                                                     (S)

1.  L < M
    inequalities, from S

2.  (M − L)/3 > 0
    inequalities
      L < M              1
      0 < M − L          adding −L
      0 < (M − L)/3      multiplying by 1/3
      (M − L)/3 > 0      restate

3.  For all ε > 0, there exists δ > 0 such that |f(x) − L| < ε for all x ∈ ℝ with (x ≠ c and |x − c| < δ).
    thm:limit-unfolded D := ℝ, from H5
    requires ℝ ⊆ ℝ: mun:subset-self

4.  For all ε > 0, there exists δ > 0 such that |f(x) − M| < ε for all x ∈ ℝ with (x ≠ c and |x − c| < δ).
    thm:limit-unfolded D := ℝ, L := M, from H6
    requires ℝ ⊆ ℝ: mun:subset-self

5.  There exists δ > 0 such that |f(x) − L| < (M − L)/3 for all x ∈ ℝ with (x ≠ c and |x − c| < δ).
    instantiate ε := (M − L)/3 in line 3, from 2

6.  There exists δ > 0 such that |f(x) − M| < (M − L)/3 for all x ∈ ℝ with (x ≠ c and |x − c| < δ).
    instantiate ε := (M − L)/3 in line 4, from 2

7.  p ∈ ℝ. p > 0. For all x ∈ ℝ with (x ≠ c and |x − c| < p), |f(x) − L| < (M − L)/3.
    obtain p from line 5

8.  q ∈ ℝ. q > 0. For all x ∈ ℝ with (x ≠ c and |x − c| < q), |f(x) − M| < (M − L)/3.
    obtain q from line 6

let m = min(p, q), a real number                                      (D1)
     mun:min-real x := p, y := q
     reads the smaller of p and q

9.  0 < min(p, q)
    mun:lt-min z := 0, x := p, y := q, from 7, 8

10. min(p, q) ≤ p. min(p, q) ≤ q.
    mun:min-le x := p, y := q

let x₁ = c + m/2, a real number                                       (D2)
     membership, from D1
     reads a point half of m to the right of c

11. 0 < m
    inequalities, from D1, 9

12. c < c + m/2
    inequalities
      0 < m              11
      0 < m/2            multiplying by 1/2
      c < c + m/2        adding c

13. c ≠ c + m/2
    inequalities
      c < c + m/2        12
      c ≠ c + m/2        weakening

14. x₁ ≠ c
    inequalities, from D2, 13

15. c + m/2 < c + m
    inequalities
      0 < m              11
      0 < m/2            multiplying by 1/2
      m/2 < m            adding m/2
      c + m/2 < c + m    adding c

16. m ≤ p
    inequalities, from D1, 10

17. m ≤ q
    inequalities, from D1, 10

18. c + m ≤ c + p
    inequalities
      m ≤ p              16
      c + m ≤ c + p      adding c

19. c + m ≤ c + q
    inequalities
      m ≤ q              17
      c + m ≤ c + q      adding c

20. c + m/2 < c + p
    transitivity, from 15, 18

21. c + m/2 < c + q
    transitivity, from 15, 19

22. c − p < c
    inequalities
      p > 0              7
      0 < p              restate
      c − p < c          adding c − p

23. c − q < c
    inequalities
      q > 0              8
      0 < q              restate
      c − q < c          adding c − q

24. c − p < c + m/2
    transitivity, from 22, 12

25. c − q < c + m/2
    transitivity, from 23, 12

26. c − p < x₁ and x₁ < c + p
    inequalities, from D2, 20, 24

27. c − q < x₁ and x₁ < c + q
    inequalities, from D2, 21, 25

28. |x₁ − c| < p
    mun:abs-difference-lt x := x₁, δ := p, from 26

29. |x₁ − c| < q
    mun:abs-difference-lt x := x₁, δ := q, from 27

30. |f(x₁) − L| < (M − L)/3
    instantiate x := x₁ in line 7, from 14, 28

31. |f(x₁) − M| < (M − L)/3
    instantiate x := x₁ in line 8, from 14, 29

32. f(x₁) < L + (M − L)/3
    mun:abs-difference-lt x := f(x₁), c := L, δ := (M − L)/3, from 30
    requires f(x₁) ∈ ℝ: mun:function-value

33. M − (M − L)/3 < f(x₁)
    mun:abs-difference-lt x := f(x₁), c := M, δ := (M − L)/3, from 31
    requires f(x₁) ∈ ℝ: mun:function-value

34. M − (M − L)/3 < L + (M − L)/3
    transitivity, from 33, 32
    requires f(x₁) ∈ ℝ: mun:function-value

35. M ≤ L
    inequalities, contradicting S
      M − (M − L)/3 < L + (M − L)/3     34
      2·M + L < 2·L + M                  multiplying by 3
      M < L                              adding −M − L
      M ≤ L                              weakening


theorem limit-unique
  note        A function that tends to L and to M at c has M ≤ L, and, with
              the two swapped, L ≤ M.
  let f : ℝ → ℝ                                                       (H1)
  let c ∈ ℝ                                                           (H2)
  let L ∈ ℝ                                                           (H3)
  let M ∈ ℝ                                                           (H4)
  assume f tends to L at c                                            (H5)
  assume f tends to M at c                                            (H6)
  then L = M

1.  M ≤ L
    thm:limit-order, from H5, H6

2.  L ≤ M
    thm:limit-order L := M, M := L, from H5, H6

3.  L = M
    antisymmetry, from 1, 2
