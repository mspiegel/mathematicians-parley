import definition         stdlib/calculus/limit-at
import mundane theorem    stdlib/sets/subset-self
import mundane theorem    stdlib/numbers/abs-difference-lt
import mundane definition stdlib/numbers/min
import mundane theorem    stdlib/numbers/min-real
import mundane theorem    stdlib/numbers/min-le
import mundane theorem    stdlib/numbers/lt-min
import mundane theorem    stdlib/numbers/le-antisymmetric
import mundane theorem    stdlib/functions/function-value

theorem limit-unfolded
  note        What f tends to L at c says, written out on the part D of the
              line that f is defined on.
  ε, δ range over ℝ
  let D ⊆ ℝ                                                           (H1)
  let f : D → ℝ                                                       (H2)
  let c ∈ ℝ                                                           (H3)
  let L ∈ ℝ                                                           (H4)
  assume f tends to L at c                                            (H5)
  then for all ε > 0, there exists δ > 0 such that |f(x) − L| < ε for all x ∈ D with (x ≠ c and |x − c| < δ)

1.  For all ε > 0, there exists δ > 0 such that |f(x) − L| < ε for all x ∈ D with (x ≠ c and |x − c| < δ).
    def:limit-at, from H1, H5


theorem limit-order
  note        Suppose L < M. Within (M − L)/3 of both, f(x) would lie above
              M − (M − L)/3 and below L + (M − L)/3, at a point near c that
              is not c; that makes M − L less than 2(M − L)/3.
  ε, δ range over ℝ
  let f : ℝ → ℝ                                                       (H1)
  let c ∈ ℝ                                                           (H2)
  let L ∈ ℝ                                                           (H3)
  let M ∈ ℝ                                                           (H4)
  assume f tends to L at c                                            (H5)
  assume f tends to M at c                                            (H6)
  then M ≤ L

1.  M ≤ L
    contradiction
    suppose not M ≤ L                                                 (S)

    1.1.  L < M
          inequalities, from S

    1.2.  (M − L)/3 > 0
          inequalities, from 1.1

    1.3.  For all ε > 0, there exists δ > 0 such that |f(x) − L| < ε for all x ∈ ℝ with (x ≠ c and |x − c| < δ).
          thm:limit-unfolded D := ℝ, from H5
          requires ℝ ⊆ ℝ: mun:subset-self

    1.4.  For all ε > 0, there exists δ > 0 such that |f(x) − M| < ε for all x ∈ ℝ with (x ≠ c and |x − c| < δ).
          thm:limit-unfolded D := ℝ, L := M, from H6
          requires ℝ ⊆ ℝ: mun:subset-self

    1.5.  There exists δ > 0 such that |f(x) − L| < (M − L)/3 for all x ∈ ℝ with (x ≠ c and |x − c| < δ).
          instantiate ε := (M − L)/3 in line 1.3, from 1.2

    1.6.  There exists δ > 0 such that |f(x) − M| < (M − L)/3 for all x ∈ ℝ with (x ≠ c and |x − c| < δ).
          instantiate ε := (M − L)/3 in line 1.4, from 1.2

    1.7.  p ∈ ℝ. p > 0. For all x ∈ ℝ with (x ≠ c and |x − c| < p), |f(x) − L| < (M − L)/3.
          obtain p from line 1.5

    1.8.  q ∈ ℝ. q > 0. For all x ∈ ℝ with (x ≠ c and |x − c| < q), |f(x) − M| < (M − L)/3.
          obtain q from line 1.6

    let m = min(p, q), a real number                                  (D1)
           mun:min-real x := p, y := q
           reads the smaller of p and q

    1.9.  0 < min(p, q)
          mun:lt-min z := 0, x := p, y := q, from 1.7, 1.8

    1.10. min(p, q) ≤ p. min(p, q) ≤ q.
          mun:min-le x := p, y := q

    let x₁ = c + m/2, a real number                                   (D2)
           membership, from D1
           reads a point half of m to the right of c

    1.11. x₁ ≠ c
          inequalities, from D1, D2, 1.9

    1.12. c − p < x₁ and x₁ < c + p
          inequalities, from D1, D2, 1.9, 1.10

    1.13. c − q < x₁ and x₁ < c + q
          inequalities, from D1, D2, 1.9, 1.10

    1.14. |x₁ − c| < p
          mun:abs-difference-lt x := x₁, δ := p, from 1.12

    1.15. |x₁ − c| < q
          mun:abs-difference-lt x := x₁, δ := q, from 1.13

    1.16. |f(x₁) − L| < (M − L)/3
          instantiate x := x₁ in line 1.7, from 1.11, 1.14

    1.17. |f(x₁) − M| < (M − L)/3
          instantiate x := x₁ in line 1.8, from 1.11, 1.15

    1.18. f(x₁) < L + (M − L)/3
          mun:abs-difference-lt x := f(x₁), c := L, δ := (M − L)/3, from 1.16
          requires f(x₁) ∈ ℝ: mun:function-value

    1.19. M − (M − L)/3 < f(x₁)
          mun:abs-difference-lt x := f(x₁), c := M, δ := (M − L)/3, from 1.17
          requires f(x₁) ∈ ℝ: mun:function-value

    1.20. M ≤ L
          inequalities, from 1.18, 1.19, contradicting S
          requires f(x₁) ∈ ℝ: mun:function-value


theorem limit-unique
  note        A function that tends to L and to M at c has M ≤ L, and, with
              the two swapped, L ≤ M.
  let f : ℝ → ℝ                                                       (H1)
  let c ∈ ℝ                                                           (H2)
  let L ∈ ℝ                                                           (H3)
  let M ∈ ℝ                                                           (H4)
  assume f tends to L at c                                            (H5)
  assume f tends to M at c                                            (H6)
  then L = M

1.  M ≤ L
    thm:limit-order, from H5, H6

2.  L ≤ M
    thm:limit-order L := M, M := L, from H5, H6

3.  L = M
    mun:le-antisymmetric x := L, y := M, from 1, 2
