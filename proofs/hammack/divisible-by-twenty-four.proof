import definition         stdlib/divisibility/divides
import mundane theorem    stdlib/divisibility/divides-multiple
import mundane theorem    stdlib/divisibility/divides-self
import mundane theorem    stdlib/divisibility/divides-sum
import mundane theorem    stdlib/numbers/exponent-sum

theorem divisible-by-twenty-four
  note        By induction on n: 5^(2(m + 1)) − 1 is 25·(5^(2m) − 1) + 24, and
              24 divides both parts.
  let n ∈ ℕ₀                                                          (H1)
  then 24 divides 5^(2n) − 1

1.  For all m ∈ ℕ₀, 24 divides 5^(2m) − 1.
    induction on m starting at 0

    base
    1.1.  5^(2·0) − 1 = 24·0
          arithmetic

    1.2.  24 divides 5^(2·0) − 1
          def:divides d := 24, n := 5^(2·0) − 1, from 1.1

    step
    let m ∈ ℕ₀                                                        (K)
    assume step 1 is true for m, the induction hypothesis             (IH)

    1.3.  2(m + 1) = 2m + 2
          algebra

    1.4.  5^(2(m + 1)) = 5^(2m)·5^2
          calculation
            5^(2(m + 1)) = 5^(2m + 2)      substitute line 1.3
                         = 5^(2m)·5^2      mun:exponent-sum a := 5, m := 2m, n := 2

    1.5.  24 divides (5^(2m) − 1)·25
          mun:divides-multiple e := 24, a := 5^(2m) − 1, x := 25, from IH

    1.6.  24 divides 24
          mun:divides-self n := 24

    1.7.  24 divides (5^(2m) − 1)·25 + 24
          mun:divides-sum d := 24, a := (5^(2m) − 1)·25, b := 24, from 1.5, 1.6

    1.8.  24 divides 5^(2(m + 1)) − 1
          substitute
            24 divides (5^(2m) − 1)·25 + 24      1.7
            24 divides 5^(2(m + 1)) − 1          algebra, from 1.4

2.  24 divides 5^(2n) − 1
    instantiate m := n in line 1
