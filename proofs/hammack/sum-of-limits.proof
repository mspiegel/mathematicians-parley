import definition         stdlib/calculus/tends-to
import mundane theorem    stdlib/numbers/abs-difference-lt

theorem sum-of-limits
  note        Take P for a and Q for b, each with ε/2. From P + Q on, both
              terms are within ε/2 of their limits, so the sum is within ε
              of L + M.
  ε ranges over ℝ
  n ranges over ℕ
  let a : ℕ → ℝ                                                       (H1)
  let b : ℕ → ℝ                                                       (H2)
  let L ∈ ℝ                                                           (H3)
  let M ∈ ℝ                                                           (H4)
  assume a(n) → L as n → ∞                                            (H5)
  assume b(n) → M as n → ∞                                            (H6)
  then a(n) + b(n) → L + M as n → ∞

1.  For all ε > 0, there exists N ∈ ℕ such that |a(n) + b(n) − (L + M)| < ε for all n ≥ N.
    proof
    let ε ∈ ℝ                                                         (K1)
    assume ε > 0                                                      (A1)

    1.1.  ε/2 > 0
          inequalities
            ε > 0              A1
            ε/2 > 0            multiplying by 1/2

    1.2.  For all ε > 0, there exists N ∈ ℕ such that |a(n) − L| < ε for all n ≥ N.
          def:tends-to, from H5

    1.3.  For all ε > 0, there exists N ∈ ℕ such that |b(n) − M| < ε for all n ≥ N.
          def:tends-to x := b, L := M, from H6

    1.4.  There exists N ∈ ℕ such that |a(n) − L| < ε/2 for all n ≥ N.
          instantiate ε := ε/2 in line 1.2, from 1.1

    1.5.  There exists N ∈ ℕ such that |b(n) − M| < ε/2 for all n ≥ N.
          instantiate ε := ε/2 in line 1.3, from 1.1

    1.6.  P ∈ ℕ. |a(n) − L| < ε/2 for all n ≥ P.
          obtain P from line 1.4

    1.7.  Q ∈ ℕ. |b(n) − M| < ε/2 for all n ≥ Q.
          obtain Q from line 1.5

    1.8.  Q > 0
          inequalities, from 1.7

    1.9.  P + Q ≥ P
          inequalities
            Q > 0              1.8
            P + Q > P          adding P
            P + Q ≥ P          weakening

    1.10. P > 0
          inequalities, from 1.6

    1.11. P + Q ≥ Q
          inequalities
            P > 0              1.10
            P + Q > Q          adding Q
            P + Q ≥ Q          weakening

    1.12. For all n ≥ P + Q, |a(n) + b(n) − (L + M)| < ε.
          proof
          let n ∈ ℕ                                                   (K2)
          assume n ≥ P + Q                                            (A2)

          1.12.1.  n ≥ P
                   transitivity, from A2, 1.9

          1.12.2.  n ≥ Q
                   transitivity, from A2, 1.11

          1.12.3.  |a(n) − L| < ε/2
                   instantiate n := n in line 1.6, from 1.12.1

          1.12.4.  |b(n) − M| < ε/2
                   instantiate n := n in line 1.7, from 1.12.2

          1.12.5.  L − ε/2 < a(n) and a(n) < L + ε/2
                   mun:abs-difference-lt x := a(n), c := L, δ := ε/2, from 1.12.3
                   requires a(n) ∈ ℝ: from H1

          1.12.6.  M − ε/2 < b(n) and b(n) < M + ε/2
                   mun:abs-difference-lt x := b(n), c := M, δ := ε/2, from 1.12.4
                   requires b(n) ∈ ℝ: from H2

          1.12.7.  L + M − ε < a(n) + b(n)
                   inequalities, from 1.12.5, 1.12.6
                   requires a(n) ∈ ℝ: from H1
                   requires b(n) ∈ ℝ: from H2

          1.12.8.  a(n) + b(n) < L + M + ε
                   inequalities, from 1.12.5, 1.12.6
                   requires a(n) ∈ ℝ: from H1
                   requires b(n) ∈ ℝ: from H2

          1.12.9.  L + M − ε < a(n) + b(n) and a(n) + b(n) < L + M + ε
                   join 1.12.7, 1.12.8

          1.12.10. |a(n) + b(n) − (L + M)| < ε
                   mun:abs-difference-lt x := a(n) + b(n), c := L + M, δ := ε, from 1.12.9
                   requires a(n) + b(n) ∈ ℝ: membership, from H1, H2

    1.13. There exists N ∈ ℕ such that |a(n) + b(n) − (L + M)| < ε for all n ≥ N.
          exhibit, from 1.12

2.  a(n) + b(n) → L + M as n → ∞
    def:tends-to L := L + M, from 1
