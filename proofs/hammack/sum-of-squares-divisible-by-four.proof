import mundane definition stdlib/divisibility/divides
import mundane definition stdlib/divisibility/even
import mundane definition stdlib/divisibility/odd
import mundane theorem    stdlib/divisibility/not-both

theorem sum-of-squares-divisible-by-four
  note        Odd a = 2m + 1 and b = 2n + 1 give a² + b² = 4(m² + m + n² + n)
              + 2, which is 4k only if 1 = 2(k − m² − m − n² − n) is even.
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  assume 4 divides a² + b²                                            (H3)
  then not (a is odd and b is odd)

1.  k ∈ ℤ. a² + b² = 4k.
    obtain k: mun:divides, from H3

2.  not (a is odd and b is odd)
    contradiction
    suppose a is odd and b is odd                                     (S)

    2.1.  m ∈ ℤ. a = 2m + 1.
          obtain m: mun:odd n := a, from S

    2.2.  n ∈ ℤ. b = 2n + 1.
          obtain n: mun:odd n := b, from S

    2.3.  a² = (2m + 1)²
          substitute a = 2m + 1 (line 2.1)

    2.4.  b² = (2n + 1)²
          substitute b = 2n + 1 (line 2.2)

    2.5.  (2m + 1)² + (2n + 1)² = 4k
          algebra, from 1, 2.3, 2.4

    2.6.  1 = 2(k − m² − m − n² − n)
          algebra, from 2.5

    2.7.  1 is even
          mun:even n := 1, from 2.6

    2.8.  1 is not odd
          mun:not-both n := 1, from 2.7

    2.9.  1 is odd
          arithmetic, contradicting 2.8
