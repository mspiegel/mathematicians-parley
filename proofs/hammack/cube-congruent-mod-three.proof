import definition         stdlib/divisibility/congruent-mod
import definition         stdlib/divisibility/divides
import mundane theorem    stdlib/divisibility/mod-less
import mundane theorem    stdlib/divisibility/mod-natural
import mundane theorem    stdlib/divisibility/mod-remainder
import mundane theorem    stdlib/sums/range-from-bounds

theorem residue-mod-three
  note        A whole number below 3 is 0, 1 or 2: it is one of the whole
              numbers from 0 to 3 − 1, which are those three.
  let r ∈ ℕ₀                                                          (H1)
  assume r < 3                                                        (H2)
  then r = 0 or r = 1 or r = 2

1.  r ∈ {0, …, 3 − 1}
    mun:range-from-bounds, from H2

2.  r = 0 or r = 1 or r = 2
    inspection, from 1


theorem cube-congruent-mod-three
  note        Divide a by 3: a = 3q + r with r = 0, 1 or 2. In each case
              a³ − a is 3 times a whole number.
  let a ∈ ℤ                                                           (H1)
  then a³ ≡ a (mod 3)

1.  a mod 3 ∈ ℕ₀
    mun:mod-natural b := 3

2.  a mod 3 < 3
    mun:mod-less b := 3

3.  a mod 3 = 0 or a mod 3 = 1 or a mod 3 = 2
    thm:residue-mod-three r := a mod 3, from 1, 2

4.  There is q ∈ ℤ with q·3 + a mod 3 = a.
    mun:mod-remainder m := 3, r := a mod 3, from 1, 2

5.  q ∈ ℤ. q·3 + a mod 3 = a.
    obtain q from line 4

6.  3 divides a³ − a
    cases, from 3

    case
    assume a mod 3 = 0                                                (C1)

    6.1.  q·3 = a
          substitute a mod 3 = 0 (C1) into line 5

    6.2.  a³ − a = (q·3)³ − q·3
          substitute q·3 = a (line 6.1)

    6.3.  (q·3)³ − q·3 = 3·(9·q³ − q)
          algebra

    6.4.  a³ − a = 3·(9·q³ − q)
          calculation
            a³ − a = (q·3)³ − q·3         6.2
                   = 3·(9·q³ − q)         6.3

    6.5.  3 divides a³ − a
          def:divides d := 3, n := a³ − a, from 6.4

    case
    assume a mod 3 = 1                                                (C2)

    6.6.  q·3 + 1 = a
          substitute a mod 3 = 1 (C2) into line 5

    6.7.  a³ − a = (q·3 + 1)³ − (q·3 + 1)
          substitute q·3 + 1 = a (line 6.6)

    6.8.  (q·3 + 1)³ − (q·3 + 1) = 3·(9·q³ + 9·q² + 2·q)
          algebra

    6.9.  a³ − a = 3·(9·q³ + 9·q² + 2·q)
          calculation
            a³ − a = (q·3 + 1)³ − (q·3 + 1)         6.7
                   = 3·(9·q³ + 9·q² + 2·q)          6.8

    6.10. 3 divides a³ − a
          def:divides d := 3, n := a³ − a, from 6.9

    case
    assume a mod 3 = 2                                                (C3)

    6.11. q·3 + 2 = a
          substitute a mod 3 = 2 (C3) into line 5

    6.12. a³ − a = (q·3 + 2)³ − (q·3 + 2)
          substitute q·3 + 2 = a (line 6.11)

    6.13. (q·3 + 2)³ − (q·3 + 2) = 3·(9·q³ + 18·q² + 11·q + 2)
          algebra

    6.14. a³ − a = 3·(9·q³ + 18·q² + 11·q + 2)
          calculation
            a³ − a = (q·3 + 2)³ − (q·3 + 2)         6.12
                   = 3·(9·q³ + 18·q² + 11·q + 2)    6.13

    6.15. 3 divides a³ − a
          def:divides d := 3, n := a³ − a, from 6.14

7.  a³ ≡ a (mod 3)
    def:congruent-mod, from 6
