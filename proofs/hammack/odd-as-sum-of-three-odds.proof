import mundane definition stdlib/divisibility/odd

theorem odd-as-sum-of-three-odds
  note        Take n, 1 and −1: each is odd, as 1 = 2·0 + 1 and
              −1 = 2·(−1) + 1, and their sum is n.
  let n ∈ ℤ                                                           (H1)
  assume n is odd                                                     (H2)
  then there are a, b, c ∈ ℤ with a is odd, b is odd, c is odd and n = a + b + c

1.  1 = 2·0 + 1
    arithmetic

2.  1 is odd
    mun:odd n := 1, from 1

3.  −1 = 2·(−1) + 1
    arithmetic

4.  −1 is odd
    mun:odd n := −1, from 3

5.  n = n + 1 + −1
    algebra

6.  there are a, b, c ∈ ℤ with a is odd, b is odd, c is odd and n = a + b + c
    exhibit, from H2, 2, 4, 5
