import theorem            proofs/wiedijk/sqrt2-irrational/lowest-terms
import mundane definition stdlib/divisibility/divides
import mundane definition stdlib/divisibility/even
import mundane definition stdlib/divisibility/odd
import mundane definition stdlib/numbers/irrational
import mundane theorem    stdlib/divisibility/even-or-odd
import mundane theorem    stdlib/divisibility/not-both

theorem cubic-root-is-irrational
  note        Suppose x = p/q in lowest terms. Then p³ + pq² + 3q³ = 0, and
              p and q are not both even. In each of the three remaining
              parities the left side is twice an integer plus 1, so 1 is
              even, which it is not.
  let x ∈ ℝ                                                           (H1)
  assume x³ + x + 3 = 0                                               (H2)
  then x is irrational

1.  x ∉ ℚ
    contradiction
    suppose x ∈ ℚ                                                     (S)

    1.1.  p ∈ ℤ. q ∈ ℤ. q > 0. x = p/q.
          There is no d ∈ ℤ with d > 1, d divides p, and d divides q.
          obtain p, q: thm:lowest-terms x := x, from S

    1.2.  (p/q)³ + p/q + 3 = 0
          substitute x = p/q (line 1.1) into H2

    1.3.  p³ + p·q² + 3q³ = 0
          algebra, from 1.2
          requires q ≠ 0: weakening, from 1.1

    1.4.  p is even or p is odd
          mun:even-or-odd n := p

    1.5.  1 is even
          cases, from 1.4

          case
          assume p is even                                            (C1)

          1.5.1.  r ∈ ℤ. p = 2r.
                  obtain r: mun:even n := p, from C1

          1.5.2.  q is even or q is odd
                  mun:even-or-odd n := q

          1.5.3.  1 is even
                  cases, from 1.5.2

                  case
                  assume q is even                                    (C2)

                  1.5.3.1.  s ∈ ℤ. q = 2s.
                            obtain s: mun:even n := q, from C2

                  1.5.3.2.  2 divides p
                            mun:divides d := 2, n := p, from 1.5.1

                  1.5.3.3.  2 divides q
                            mun:divides d := 2, n := q, from 1.5.3.1

                  1.5.3.4.  There is d ∈ ℤ with d > 1, d divides p, and d divides q.
                            exhibit, from 1.5.3.2, 1.5.3.3, contradicting 1.1
                            requires 2 > 1: arithmetic

                  case
                  assume q is odd                                     (C3)

                  1.5.3.5.  s ∈ ℤ. q = 2s + 1.
                            obtain s: mun:odd n := q, from C3

                  1.5.3.6.  (2r)³ + 2r·q² + 3q³ = 0
                            substitute p = 2r (line 1.5.1) into line 1.3

                  1.5.3.7.  (2r)³ + 2r·(2s + 1)² + 3(2s + 1)³ = 0
                            substitute q = 2s + 1 (line 1.5.3.5) into line 1.5.3.6

                  1.5.3.8.  1 = 2(−(4r³ + 4r·s² + 4r·s + r + 12s³ + 18s² + 9s + 1))
                            algebra, from 1.5.3.7

                  1.5.3.9.  1 is even
                            mun:even n := 1, from 1.5.3.8

          case
          assume p is odd                                             (C4)

          1.5.4.  r ∈ ℤ. p = 2r + 1.
                  obtain r: mun:odd n := p, from C4

          1.5.5.  (2r + 1)³ + (2r + 1)·q² + 3q³ = 0
                  substitute p = 2r + 1 (line 1.5.4) into line 1.3

          1.5.6.  q is even or q is odd
                  mun:even-or-odd n := q

          1.5.7.  1 is even
                  cases, from 1.5.6

                  case
                  assume q is even                                    (C5)

                  1.5.7.1.  s ∈ ℤ. q = 2s.
                            obtain s: mun:even n := q, from C5

                  1.5.7.2.  (2r + 1)³ + (2r + 1)·(2s)² + 3(2s)³ = 0
                            substitute q = 2s (line 1.5.7.1) into line 1.5.5

                  1.5.7.3.  1 = 2(−(4r³ + 6r² + 3r + 4r·s² + 2s² + 12s³))
                            algebra, from 1.5.7.2

                  1.5.7.4.  1 is even
                            mun:even n := 1, from 1.5.7.3

                  case
                  assume q is odd                                     (C6)

                  1.5.7.5.  s ∈ ℤ. q = 2s + 1.
                            obtain s: mun:odd n := q, from C6

                  1.5.7.6.  (2r + 1)³ + (2r + 1)·(2s + 1)² + 3(2s + 1)³ = 0
                            substitute q = 2s + 1 (line 1.5.7.5) into line 1.5.5

                  1.5.7.7.  1 = 2(−(4r³ + 6r² + 4r + 4r·s² + 4r·s + 12s³ + 20s² + 11s + 2))
                            algebra, from 1.5.7.6

                  1.5.7.8.  1 is even
                            mun:even n := 1, from 1.5.7.7

    1.6.  1 is not odd
          mun:not-both n := 1, from 1.5

    1.7.  1 is odd
          arithmetic, contradicting 1.6

2.  x is irrational
    mun:irrational, from 1
