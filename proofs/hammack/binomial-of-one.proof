import definition         stdlib/counting/C
import theorem            stdlib/counting/pascal
import mundane theorem    stdlib/counting/binomial-zero-index

theorem binomial-of-one
  note        By induction on j: C(0, 1) is 0 because 0 < 1, and Pascal's rule
              gives C(j + 1, 1) = C(j, 1) + C(j, 0) = j + 1.
  let m ∈ ℕ₀                                                          (H1)
  then C(m, 1) = m

1.  For all j ∈ ℕ₀, C(j, 1) = j.
    induction on j starting at 0

    base
    1.1.  0 < 1
          arithmetic

    1.2.  C(0, 1) = 0
          def:C n := 0, k := 1, from 1.1

    step
    let j ∈ ℕ₀                                                        (K)
    assume step 1 is true for j, the induction hypothesis             (IH)

    1.3.  C(j, 1) + C(j, 1 − 1) = C(j + 1, 1)
          thm:pascal n := j, k := 1

    1.4.  C(j, 0) = 1
          mun:binomial-zero-index n := j

    1.5.  C(j, 1) + C(j, 0) = C(j + 1, 1)
          substitute 1 − 1 = 0 (arithmetic) into line 1.3

    1.6.  C(j + 1, 1) = j + 1
          calculation
            C(j + 1, 1) = C(j, 1) + C(j, 0)     1.5
                        = j + C(j, 0)           substitute IH
                        = j + 1                 substitute line 1.4

2.  C(m, 1) = m
    instantiate j := m in line 1
