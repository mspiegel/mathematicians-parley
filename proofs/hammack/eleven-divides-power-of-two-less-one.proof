import definition         stdlib/divisibility/divides

theorem eleven-divides-power-of-two-less-one
  note        2^10 − 1 is 1023, which is 11 times 93.
  then there exists n ∈ ℕ such that 11 divides 2^n − 1

1.  2^10 − 1 = 11·93
    arithmetic

2.  11 divides 2^10 − 1
    def:divides d := 11, n := 2^10 − 1, from 1

3.  There exists n ∈ ℕ such that 11 divides 2^n − 1.
    exhibit, from 2
