import definition         stdlib/calculus/limit-at
import mundane theorem    stdlib/sets/subset-self
import definition         stdlib/numbers/abs
import mundane theorem    stdlib/numbers/abs-real
import mundane theorem    stdlib/numbers/abs-product
import mundane theorem    stdlib/numbers/abs-difference-lt
import definition         stdlib/numbers/min
import mundane theorem    stdlib/numbers/min-real
import mundane theorem    stdlib/numbers/lt-min
import mundane theorem    stdlib/numbers/less-scaled
import mundane theorem    stdlib/numbers/multiply-le

theorem quadratic-limit
  note        Near 1, f(x) − 5 = (4x + 4)(x − 1) has |4x + 4| below 12 once
              x is within 1 of 1, so x within min(1, ε/12) of 1 makes the
              product less than ε.
  ε, δ range over ℝ
  let f : ℝ → ℝ                                                       (H1)
  assume for all x ∈ ℝ, f(x) = 4x² + 1                               (H2)
  then f tends to 5 at 1

1.  For all ε > 0, there exists δ > 0 such that |f(x) − 5| < ε for all x ∈ ℝ with (x ≠ 1 and |x − 1| < δ).
    proof
    let ε ∈ ℝ                                                         (K1)
    assume ε > 0                                                      (A1)

    let m = min(1, ε/12), a real number                               (D1)
           mun:min-real x := 1, y := ε/12
           reads the smaller of 1 and ε/12

    1.1.  0 < ε/12
          inequalities
            ε > 0            A1
            ε/12 > 0         multiplying by 1/12
            0 < ε/12         restate

    1.2.  0 < min(1, ε/12)
          mun:lt-min z := 0, x := 1, y := ε/12
          requires 0 < 1: arithmetic
          requires 0 < ε/12: from 1.1

    1.3.  m > 0
          inequalities, from D1, 1.2

    1.4.  For all x ∈ ℝ with (x ≠ 1 and |x − 1| < m), |f(x) − 5| < ε.
          proof
          let x ∈ ℝ                                                   (K2)
          assume x ≠ 1 and |x − 1| < m                                (A2)

          1.4.1.  |x − 1| < 1 and |x − 1| < ε/12
                  mun:lt-min z := |x − 1|, x := 1, y := ε/12, from A2, D1
                  requires |x − 1| ∈ ℝ: mun:abs-real x := x − 1

          1.4.2.  1 − 1 < x and x < 1 + 1
                  mun:abs-difference-lt c := 1, δ := 1, from 1.4.1

          1.4.3.  4·x > 0
                  inequalities
                    1 − 1 < x            1.4.2
                    0 < 4·x              multiplying by 4
                    4·x > 0              restate

          1.4.4.  4·x + 4 > 0
                  inequalities, from 1.4.3

          1.4.5.  |4·x + 4| = 4·x + 4
                  def:abs x := 4·x + 4
                  requires 4·x + 4 ≥ 0: weakening, from 1.4.4

          1.4.6.  4·x + 4 < 12
                  inequalities
                    x < 1 + 1            1.4.2
                    4·x < 8              multiplying by 4
                    4·x + 4 < 12         adding 4

          1.4.7.  0 < |4·x + 4|
                  transitivity, from 1.4.4, 1.4.5

          1.4.8.  |4·x + 4| < 12
                  transitivity, from 1.4.5, 1.4.6

          1.4.9.  0 < |4·x + 4| and |4·x + 4| < 12
                  join 1.4.7, 1.4.8

          1.4.10. |4·x + 4| ≤ 12
                  inequalities
                    |4·x + 4| < 12   1.4.8
                    |4·x + 4| ≤ 12   weakening
                  requires |4·x + 4| ∈ ℝ: mun:abs-real x := 4·x + 4

          1.4.11. f(x) = 4·x² + 1
                  instantiate x := x in H2

          1.4.12. |(4·x + 4)·(x − 1)| = |4·x + 4|·|x − 1|
                  mun:abs-product x := 4·x + 4, y := x − 1

          1.4.13. |f(x) − 5| = |4·x + 4|·|x − 1|
                  substitute
                    |(4·x + 4)·(x − 1)| = |4·x + 4|·|x − 1|      1.4.12
                    |f(x) − 5| = |4·x + 4|·|x − 1|               algebra, from 1.4.11

          1.4.14. |f(x) − 5| < ε
                  calculation
                    |f(x) − 5| = |4·x + 4|·|x − 1|     1.4.13
                               < |4·x + 4|·(ε/12)      mun:less-scaled x := |x − 1|, y := ε/12, c := |4·x + 4|, from 1.4.1, 1.4.9
                               = ε/12·|4·x + 4|        algebra
                               ≤ ε/12·12               mun:multiply-le x := |4·x + 4|, y := 12, c := ε/12, from 1.4.10
                               = ε                     algebra
                  requires |x − 1| ∈ ℝ: mun:abs-real x := x − 1
                  requires |4·x + 4| ∈ ℝ: mun:abs-real x := 4·x + 4
                  requires ε/12 > 0: from 1.1

    1.5.  There exists δ > 0 such that |f(x) − 5| < ε for all x ∈ ℝ with (x ≠ 1 and |x − 1| < δ).
          exhibit, from 1.3, 1.4

2.  f tends to 5 at 1
    def:limit-at D := ℝ, c := 1, L := 5, from 1
    requires ℝ ⊆ ℝ: mun:subset-self
