import definition         stdlib/counting/factorial
import mundane theorem    stdlib/counting/factorial-nat
import mundane theorem    stdlib/numbers/multiply-cancel
import mundane theorem    stdlib/sums/sum-extended
import mundane theorem    stdlib/sums/sum-single
import mundane theorem    stdlib/sums/sum-termwise

theorem product-nonzero
  note        If x·y were 0, then x·y = 0·y, and y ≠ 0 lets y cancel, leaving
              x = 0.
  let x ∈ ℝ                                                           (H1)
  let y ∈ ℝ                                                           (H2)
  assume x ≠ 0                                                        (H3)
  assume y ≠ 0                                                        (H4)
  then x·y ≠ 0

1.  x·y ≠ 0
    contradiction
    suppose x·y = 0                                                   (S)

    1.1.  x·y = 0·y
          algebra, from S

    1.2.  x = 0
          mun:multiply-cancel a := x, b := 0, c := y, from H4, 1.1, contradicting H3

theorem first-term-sum
  note        A sum of one term is that term.
  let t : ℕ → ℝ                                                       (H1)
  then Σ(j = 1 to 1) t(j) = t(1)

1.  Σ(j = 1 to 1) t(j) = t(1)
    mun:sum-single a := 1

theorem next-term-sum
  note        The sum to k + 1 is the sum to k and the term k + 1.
  let k ∈ ℕ                                                           (H1)
  let t : ℕ → ℝ                                                       (H2)
  then Σ(j = 1 to k + 1) t(j) = Σ(j = 1 to k) t(j) + t(k + 1)

1.  Σ(j = 1 to k + 1) t(j) = Σ(j = 1 to k) t(j) + t(k + 1)
    mun:sum-extended a := 1, n := k
    requires k ≥ 1: from H1

theorem quotient-terms-sum
  note        Where the terms t(k) are k/(k + 1)!, the sums of the two agree
              term by term.
  let n ∈ ℕ                                                           (H1)
  let t : ℕ → ℝ                                                       (H2)
  assume for all k ∈ ℕ, t(k) = k/(k + 1)!                            (H3)
  then Σ(k = 1 to n) t(k) = Σ(k = 1 to n) k/(k + 1)!

1.  For all k ∈ ℕ, k/(k + 1)! ∈ ℝ.
    proof
    let k ∈ ℕ                                                         (K)

    1.1.  (k + 1)! ∈ ℕ
          mun:factorial-nat n := k + 1

    1.2.  k/(k + 1)! ∈ ℝ
          membership, from 1.1

2.  Σ(k = 1 to n) t(k) = Σ(k = 1 to n) k/(k + 1)!
    mun:sum-termwise a := 1, b := n, from H3, 1

theorem factorial-quotient-step
  note        With F the factorial (k + 1)! and c = k + 1, adding c/(F·(c + 1))
              to 1 − 1/F gives 1 − 1/(F·(c + 1)): the term is (1/F)·(c/(c + 1)),
              and c/(c + 1) is 1 − 1/(c + 1).
  let c ∈ ℕ                                                           (H1)
  let F ∈ ℝ                                                           (H2)
  assume F ≠ 0                                                        (H3)
  then 1 − 1/F + c/(F·(c + 1)) = 1 − 1/(F·(c + 1))

1.  c/(F·(c + 1)) = (1/F)·(c/(c + 1))
    algebra
    requires F ≠ 0: from H3

2.  c/(c + 1) = 1 − 1/(c + 1)
    algebra

3.  1/(F·(c + 1)) = (1/F)·(1/(c + 1))
    algebra
    requires F ≠ 0: from H3

4.  1 − 1/F + c/(F·(c + 1)) = 1 − 1/(F·(c + 1))
    calculation
      1 − 1/F + c/(F·(c + 1)) = 1 − 1/F + (1/F)·(c/(c + 1))             substitute line 1
                              = 1 − 1/F + (1/F)·(1 − 1/(c + 1))         substitute line 2
                              = 1 − (1/F)·(1/(c + 1))                   algebra
                              = 1 − 1/(F·(c + 1))                       substitute line 3
    requires F ≠ 0: from H3

theorem sum-of-factorial-quotients
  note        By induction on n: adding (k + 1)/(k + 2)! to 1 − 1/(k + 1)!
              gives 1 − 1/(k + 2)!, since (k + 2)! is (k + 1)!·(k + 2).
  let n ∈ ℕ                                                           (H1)
  then Σ(k = 1 to n) k/(k + 1)! = 1 − 1/(n + 1)!

1.  For all j ∈ ℕ, j/(j + 1)! ∈ ℝ.
    proof
    let j ∈ ℕ                                                         (J)

    1.1.  (j + 1)! ∈ ℕ
          mun:factorial-nat n := j + 1

    1.2.  j/(j + 1)! ∈ ℝ
          membership, from 1.1

2.  For all k ∈ ℕ, Σ(j = 1 to k) j/(j + 1)! = 1 − 1/(k + 1)!.
    induction on k starting at 1

    base
    2.1.  1! = 1
          def:factorial

    2.2.  (1 + 1)! = 2
          calculation
            (1 + 1)! = 1!·(1 + 1)     def:factorial n := 1
                     = 1·(1 + 1)      substitute line 2.1
                     = 2              arithmetic

    2.3.  Σ(j = 1 to 1) j/(j + 1)! = 1 − 1/(1 + 1)!
          calculation
            Σ(j = 1 to 1) j/(j + 1)! = 1/(1 + 1)!         mun:sum-single a := 1, from 1
                                     = 1/2                substitute line 2.2
                                     = 1 − 1/2            arithmetic
                                     = 1 − 1/(1 + 1)!     substitute line 2.2

    step
    let k ∈ ℕ                                                         (K)
    assume step 2 is true for k, the induction hypothesis             (IH)

    2.4.  ((k + 1) + 1)! = (k + 1)!·((k + 1) + 1)
          def:factorial n := k + 1

    2.5.  (k + 1)! ∈ ℕ
          mun:factorial-nat n := k + 1

    2.6.  Σ(j = 1 to k + 1) j/(j + 1)! = 1 − 1/((k + 1) + 1)!
          calculation
            Σ(j = 1 to k + 1) j/(j + 1)! = Σ(j = 1 to k) j/(j + 1)! + (k + 1)/((k + 1) + 1)!      mun:sum-extended a := 1, n := k, from 1
                                         = 1 − 1/(k + 1)! + (k + 1)/((k + 1) + 1)!                substitute IH
                                         = 1 − 1/(k + 1)! + (k + 1)/((k + 1)!·((k + 1) + 1))      substitute line 2.4
                                         = 1 − 1/((k + 1)!·((k + 1) + 1))                         thm:factorial-quotient-step c := k + 1, F := (k + 1)!, from 2.5
                                         = 1 − 1/((k + 1) + 1)!                                   substitute line 2.4
          requires k ≥ 1: from K

3.  Σ(k = 1 to n) k/(k + 1)! = 1 − 1/(n + 1)!
    instantiate k := n in line 2
