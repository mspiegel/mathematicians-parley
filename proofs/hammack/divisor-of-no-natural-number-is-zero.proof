import mundane theorem    stdlib/divisibility/divides-multiple
import mundane theorem    stdlib/divisibility/divides-self
import mundane theorem    stdlib/numbers/pos-int-nat
import mundane theorem    stdlib/numbers/square-positive

theorem divisor-of-no-natural-number-is-zero
  note        If b were not 0, its square would be a natural number that b
              divides.
  let b ∈ ℤ                                                           (H1)
  assume for all k ∈ ℕ, not (b divides k)                            (H2)
  then b = 0
  by          contradiction

suppose b ≠ 0                                                         (S)

1.  b² > 0
    mun:square-positive x := b, from S

2.  b² ∈ ℕ
    mun:pos-int-nat m := b², from 1

3.  b divides b
    mun:divides-self n := b

4.  b divides b·b
    mun:divides-multiple e := b, a := b, x := b, from 3

5.  b divides b²
    substitute
      b divides b·b      4
      b divides b²       algebra

6.  not (b divides b²)
    instantiate k := b² in H2, from 2

7.  b divides b²
    restate 5, contradicting 6
