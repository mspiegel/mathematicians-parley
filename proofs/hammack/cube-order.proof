import mundane theorem    stdlib/numbers/product-nonneg
import mundane theorem    stdlib/numbers/square-nonneg

theorem cube-order
  note        If y ≤ x, then x³ − y³ = (x − y)(x² + xy + y²) is a product of
              two numbers at least 0, since x² + xy + y² is (x + y/2)² +
              3y²/4. So x³ < y³ forces x < y.
  let x ∈ ℝ                                                           (H1)
  let y ∈ ℝ                                                           (H2)
  assume x³ < y³                                                      (H3)
  then x < y

1.  x < y
    contradiction
    suppose not x < y                                                 (S)

    1.1.  y ≤ x
          inequalities, from S

    1.2.  x − y ≥ 0
          inequalities
            y ≤ x           1.1
            0 ≤ x − y       adding −y
            x − y ≥ 0       restate

    1.3.  (x + y/2)² ≥ 0
          mun:square-nonneg x := x + y/2

    1.4.  y² ≥ 0
          mun:square-nonneg x := y

    1.5.  3·y²/4 ≥ 0
          inequalities
            y² ≥ 0          1.4
            3·y²/4 ≥ 0      multiplying by 3/4

    1.6.  (x + y/2)² + 3·y²/4 ≥ 0
          inequalities, from 1.3, 1.5

    1.7.  x² + x·y + y² = (x + y/2)² + 3·y²/4
          algebra

    1.8.  x² + x·y + y² ≥ 0
          transitivity, from 1.7, 1.6

    1.9.  (x − y)·(x² + x·y + y²) ≥ 0
          mun:product-nonneg x := x − y, y := x² + x·y + y², from 1.2, 1.8

    1.10. x³ − y³ = (x − y)·(x² + x·y + y²)
          algebra

    1.11. x³ − y³ ≥ 0
          transitivity, from 1.10, 1.9

    1.12. x³ ≥ y³
          inequalities
            x³ − y³ ≥ 0     1.11
            x³ ≥ y³         adding y³

    1.13. not x³ < y³
          inequalities, from 1.12, contradicting H3
