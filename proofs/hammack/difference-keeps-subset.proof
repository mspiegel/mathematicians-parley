import definition         stdlib/sets/difference
import definition         stdlib/sets/subset
import mundane theorem    stdlib/sets/in-subset

theorem subset-minus-a-set
  note        An element of A outside C is in B, since A is inside B, and
              still outside C.
  let A be a set                                                      (H1)
  let B be a set                                                      (H2)
  let C be a set                                                      (H3)
  assume A ⊆ B                                                        (H4)
  then A ∖ C ⊆ B ∖ C

1.  For all t ∈ A ∖ C, t ∈ B ∖ C.
    proof
    let t ∈ A ∖ C                                                     (K1)

    1.1.  t ∈ A. t ∉ C.
          def:difference u := t, Y := A, Z := C, from K1

    1.2.  t ∈ B
          mun:in-subset X := A, Y := B, u := t, from H4, 1.1

    1.3.  t ∈ B ∖ C
          def:difference u := t, Y := B, Z := C, from 1.1, 1.2

2.  A ∖ C ⊆ B ∖ C
    def:subset, from 1
