import theorem            proofs/hammack/gcd-integer-natural/gcd-integer-natural
import mundane definition stdlib/divisibility/gcd
import mundane theorem    stdlib/divisibility/divides-combination
import mundane theorem    stdlib/divisibility/divides-difference
import mundane theorem    stdlib/divisibility/divides-multiple
import mundane theorem    stdlib/divisibility/divides-one
import mundane theorem    stdlib/numbers/pos-int-nat
import mundane theorem    stdlib/numbers/square-nonneg

theorem odd-and-quartic-coprime
  note        A common divisor g of 2n + 1 and 4n² + 1 divides 4n² + 1 less
              (2n + 1)(2n − 1), which is 2, and so divides (2n + 1) − n·2,
              which is 1.
  let n ∈ ℤ                                                           (H1)
  then gcd(2n + 1, 4n² + 1) = 1

1.  n² ≥ 0
    mun:square-nonneg x := n

2.  4n² + 1 ≥ 1
    inequalities
      n² ≥ 0           1
      4n² ≥ 0          multiplying by 4
      4n² + 1 ≥ 1      adding 1

3.  4n² + 1 ∈ ℕ
    mun:pos-int-nat m := 4n² + 1
    requires 0 < 4n² + 1: inequalities, from 2

4.  gcd(2n + 1, 4n² + 1) ∈ ℕ. gcd(2n + 1, 4n² + 1) divides 2n + 1.
    gcd(2n + 1, 4n² + 1) divides 4n² + 1.
    thm:gcd-integer-natural a := 2n + 1, b := 4n² + 1, from 3

5.  gcd(2n + 1, 4n² + 1) divides (2n + 1)·(2n − 1)
    mun:divides-multiple e := gcd(2n + 1, 4n² + 1), a := 2n + 1, x := 2n − 1, from 4

6.  gcd(2n + 1, 4n² + 1) divides 4n² + 1 − (2n + 1)·(2n − 1)
    mun:divides-difference d := gcd(2n + 1, 4n² + 1), a := 4n² + 1, b := (2n + 1)·(2n − 1), from 4, 5

7.  4n² + 1 − (2n + 1)·(2n − 1) = 2
    algebra

8.  gcd(2n + 1, 4n² + 1) divides 2
    substitute 4n² + 1 − (2n + 1)·(2n − 1) = 2 (line 7) into line 6

9.  gcd(2n + 1, 4n² + 1) divides (2n + 1)·1 + 2·(−n)
    mun:divides-combination e := gcd(2n + 1, 4n² + 1), a := 2n + 1, b := 2, x := 1, y := −n, from 4, 8

10. (2n + 1)·1 + 2·(−n) = 1
    algebra

11. gcd(2n + 1, 4n² + 1) divides 1
    substitute (2n + 1)·1 + 2·(−n) = 1 (line 10) into line 9

12. gcd(2n + 1, 4n² + 1) = 1
    mun:divides-one d := gcd(2n + 1, 4n² + 1), from 4, 11
