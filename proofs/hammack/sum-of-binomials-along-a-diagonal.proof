import definition         stdlib/counting/C
import theorem            stdlib/counting/pascal
import mundane theorem    stdlib/counting/binomial-zero-index
import mundane theorem    stdlib/sums/sum-extended
import mundane theorem    stdlib/sums/sum-single

theorem sum-of-binomials-along-a-diagonal
  note        By induction on k: adding C(n + k + 1, k + 1) to C(n + k + 1, k)
              gives C(n + k + 2, k + 1), by Pascal's rule.
  let n ∈ ℕ₀                                                          (H1)
  let k ∈ ℕ₀                                                          (H2)
  let S(m) = Σ(j = 0 to m) C(n + j, j), for m ∈ ℕ₀                    (D1)
         reads the sum of the binomial coefficients C(n + j, j) for j up to m
  then Σ(j = 0 to k) C(n + j, j) = C(n + k + 1, k)

1.  For all m ∈ ℕ₀, S(m) = C(n + m + 1, m).
    induction on m starting at 0

    base
    1.1.  S(0) = C(n + 0 + 1, 0)
          calculation
            S(0) = Σ(j = 0 to 0) C(n + j, j)    D1
                 = C(n + 0, 0)                  mun:sum-single a := 0
                 = 1                            mun:binomial-zero-index n := n + 0
                 = C(n + 0 + 1, 0)              mun:binomial-zero-index n := n + 0 + 1

    step
    let m ∈ ℕ₀                                                        (K)
    assume step 1 is true for m, the induction hypothesis             (IH)

    1.2.  S(m + 1) = S(m) + C(n + (m + 1), m + 1)
          calculation
            S(m + 1) = Σ(j = 0 to m + 1) C(n + j, j)                                  D1
                     = Σ(j = 0 to m) C(n + j, j) + C(n + (m + 1), m + 1)              mun:sum-extended a := 0, n := m
                     = S(m) + C(n + (m + 1), m + 1)                                   D1
          requires m ≥ 0: from K

    1.3.  n + (m + 1) = n + m + 1
          algebra

    1.4.  C(n + m + 1, m + 1) + C(n + m + 1, (m + 1) − 1) = C((n + m + 1) + 1, m + 1)
          thm:pascal n := n + m + 1, k := m + 1

    1.5.  C(n + m + 1, m + 1) + C(n + m + 1, m) = C((n + m + 1) + 1, m + 1)
          substitute
            C(n + m + 1, m + 1) + C(n + m + 1, (m + 1) − 1) = C((n + m + 1) + 1, m + 1)      1.4
            C(n + m + 1, m + 1) + C(n + m + 1, m) = C((n + m + 1) + 1, m + 1)                algebra

    1.6.  (n + m + 1) + 1 = n + (m + 1) + 1
          algebra

    1.7.  C(n + (m + 1), m + 1) = C(n + m + 1, m + 1)
          substitute n + (m + 1) = n + m + 1 (line 1.3)

    1.8.  S(m + 1) = C(n + (m + 1) + 1, m + 1)
          calculation
            S(m + 1) = S(m) + C(n + (m + 1), m + 1)                                 1.2
                     = C(n + m + 1, m) + C(n + (m + 1), m + 1)                      substitute IH
                     = C(n + m + 1, m) + C(n + m + 1, m + 1)                        substitute line 1.7
                     = C(n + m + 1, m + 1) + C(n + m + 1, m)                        algebra
                     = C((n + m + 1) + 1, m + 1)                                    1.5
                     = C(n + (m + 1) + 1, m + 1)                                    substitute line 1.6

2.  Σ(j = 0 to k) C(n + j, j) = C(n + k + 1, k)
    calculation
      Σ(j = 0 to k) C(n + j, j) = S(k)                D1
                                = C(n + k + 1, k)     instantiate m := k in line 1
