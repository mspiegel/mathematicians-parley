import definition         stdlib/counting/C
import theorem            stdlib/counting/pascal
import mundane theorem    stdlib/counting/binomial-nat0
import mundane theorem    stdlib/counting/binomial-zero-index
import mundane theorem    stdlib/sums/sum-extended
import mundane theorem    stdlib/sums/sum-single

theorem sum-of-binomials-along-a-diagonal
  note        By induction on k: adding C(n + k + 1, k + 1) to C(n + k + 1, k)
              gives C(n + k + 2, k + 1), by Pascal's rule.
  let n ∈ ℕ₀                                                          (H1)
  let k ∈ ℕ₀                                                          (H2)
  let S(m) = Σ(j = 0 to m) C(n + j, j), for m ∈ ℕ₀                    (D1)
         reads the sum of the binomial coefficients C(n + j, j) for j up to m
  then Σ(j = 0 to k) C(n + j, j) = C(n + k + 1, k)

1.  For all m ∈ ℕ₀, S(m) = C(n + m + 1, m).
    induction on m starting at 0

    base
    1.1.  Σ(j = 0 to 0) C(n + j, j) = C(n + 0, 0)
          mun:sum-single a := 0

    1.2.  C(n + 0, 0) = 1
          mun:binomial-zero-index n := n + 0

    1.3.  C(n + 0 + 1, 0) = 1
          mun:binomial-zero-index n := n + 0 + 1

    1.4.  S(0) = C(n + 0 + 1, 0)
          calculation
            S(0) = Σ(j = 0 to 0) C(n + j, j)    D1
                 = C(n + 0, 0)                  1.1
                 = 1                            1.2
                 = C(n + 0 + 1, 0)              1.3

    step
    let m ∈ ℕ₀                                                        (K)
    assume step 1 is true for m, the induction hypothesis             (IH)

    1.5.  Σ(j = 0 to m + 1) C(n + j, j) = Σ(j = 0 to m) C(n + j, j) + C(n + (m + 1), m + 1)
          mun:sum-extended a := 0, n := m
          requires m ≥ 0: from K

    1.6.  S(m + 1) = S(m) + C(n + (m + 1), m + 1)
          calculation
            S(m + 1) = Σ(j = 0 to m + 1) C(n + j, j)                                  D1
                     = Σ(j = 0 to m) C(n + j, j) + C(n + (m + 1), m + 1)              1.5
                     = S(m) + C(n + (m + 1), m + 1)                                   D1

    1.7.  S(m) + C(n + (m + 1), m + 1) = C(n + m + 1, m) + C(n + (m + 1), m + 1)
          substitute S(m) = C(n + m + 1, m) (IH)

    1.8.  n + (m + 1) = n + m + 1
          algebra

    1.9.  C(n + m + 1, m + 1) + C(n + m + 1, (m + 1) − 1) = C((n + m + 1) + 1, m + 1)
          thm:pascal n := n + m + 1, k := m + 1

    1.10. (m + 1) − 1 = m
          algebra

    1.11. C(n + m + 1, m + 1) + C(n + m + 1, m) = C((n + m + 1) + 1, m + 1)
          substitute (m + 1) − 1 = m (line 1.10) into line 1.9

    1.12. (n + m + 1) + 1 = n + (m + 1) + 1
          algebra

    1.13. C(n + (m + 1), m + 1) = C(n + m + 1, m + 1)
          substitute n + (m + 1) = n + m + 1 (line 1.8)

    1.14. C(n + m + 1, m) + C(n + (m + 1), m + 1) = C(n + m + 1, m) + C(n + m + 1, m + 1)
          substitute C(n + (m + 1), m + 1) = C(n + m + 1, m + 1) (line 1.13)

    1.15. C(n + m + 1, m) + C(n + m + 1, m + 1) = C(n + m + 1, m + 1) + C(n + m + 1, m)
          algebra
          requires C(n + m + 1, m) ∈ ℕ₀: mun:binomial-nat0
          requires C(n + m + 1, m + 1) ∈ ℕ₀: mun:binomial-nat0

    1.16. C((n + m + 1) + 1, m + 1) = C(n + (m + 1) + 1, m + 1)
          substitute (n + m + 1) + 1 = n + (m + 1) + 1 (line 1.12)

    1.17. S(m + 1) = C(n + (m + 1) + 1, m + 1)
          calculation
            S(m + 1) = S(m) + C(n + (m + 1), m + 1)                                 1.6
                     = C(n + m + 1, m) + C(n + (m + 1), m + 1)                      1.7
                     = C(n + m + 1, m) + C(n + m + 1, m + 1)                        1.14
                     = C(n + m + 1, m + 1) + C(n + m + 1, m)                        1.15
                     = C((n + m + 1) + 1, m + 1)                                    1.11
                     = C(n + (m + 1) + 1, m + 1)                                    1.16

2.  S(k) = C(n + k + 1, k)
    instantiate m := k in line 1

3.  Σ(j = 0 to k) C(n + j, j) = C(n + k + 1, k)
    calculation
      Σ(j = 0 to k) C(n + j, j) = S(k)                D1
                                = C(n + k + 1, k)     2
