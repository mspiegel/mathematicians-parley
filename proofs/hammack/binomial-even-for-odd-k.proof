import theorem            proofs/hammack/weighted-binomial-sum/weighted-term
import definition         stdlib/counting/C
import mundane theorem    stdlib/counting/binomial-nat0
import definition         stdlib/divisibility/even
import definition         stdlib/divisibility/odd
import mundane theorem    stdlib/numbers/nat-minus-one
import axiom              stdlib/reasoning/excluded-middle
import definition         stdlib/sums/range

theorem even-times
  note        An even number 2a times B is 2(a·B).
  let A ∈ ℤ                                                           (H1)
  let B ∈ ℤ                                                           (H2)
  assume A is even                                                    (H3)
  then A·B is even

1.  a ∈ ℤ. A = 2a.
    obtain a: def:even, from H3

2.  A·B = 2(a·B)
    algebra, from 1

3.  A·B is even
    def:even n := A·B, from 2

theorem odd-factor
  note        If A = 2b + 1 and A·B = 2a, then B is A·B − 2b·B, which is
              2(a − b·B).
  let A ∈ ℤ                                                           (H1)
  let B ∈ ℤ                                                           (H2)
  assume A is odd                                                     (H3)
  assume A·B is even                                                  (H4)
  then B is even

1.  b ∈ ℤ. A = 2b + 1.
    obtain b: def:odd, from H3

2.  a ∈ ℤ. A·B = 2a.
    obtain a: def:even n := A·B, from H4

3.  (2b + 1)·B = 2a
    substitute A = 2b + 1 (line 1) into line 2

4.  B = 2(a − b·B)
    algebra, from 3

5.  B is even
    def:even n := B, from 4

theorem binomial-even-for-odd-k
  note        k·C(n, k) is n·C(n − 1, k − 1), which is even because n is, and
              an odd k times C(n, k) is even only if C(n, k) is. When k is
              above n the coefficient is 0.
  let n ∈ ℕ                                                           (H1)
  let k ∈ ℕ                                                           (H2)
  assume n is even                                                    (H3)
  assume k is odd                                                     (H4)
  then C(n, k) is even

1.  k ≤ n or not k ≤ n
    axi:excluded-middle P := k ≤ n

2.  C(n, k) is even
    cases, from 1

    case
    assume k ≤ n                                                      (C1)

    2.1.  n − 1 ∈ ℕ₀
          mun:nat-minus-one

    2.2.  1 ≤ k. k ≤ (n − 1) + 1.
          inequalities, from C1, H2

    2.3.  k ∈ {1, …, (n − 1) + 1}
          def:range n := (n − 1) + 1, from 2.2

    2.4.  k·C((n − 1) + 1, k) = ((n − 1) + 1)·C(n − 1, k − 1)
          thm:weighted-term m := n − 1, from 2.3
          requires n − 1 ∈ ℕ₀: from 2.1

    2.5.  k·C(n, k) = n·C(n − 1, k − 1)
          substitute
            k·C((n − 1) + 1, k) = ((n − 1) + 1)·C(n − 1, k − 1)      2.4
            k·C(n, k) = n·C(n − 1, k − 1)                            algebra

    2.6.  C(n − 1, k − 1) ∈ ℕ₀
          mun:binomial-nat0 n := n − 1, k := k − 1
          requires n − 1 ∈ ℕ₀: from 2.1

    2.7.  n·C(n − 1, k − 1) is even
          thm:even-times A := n, B := C(n − 1, k − 1), from H3
          requires C(n − 1, k − 1) ∈ ℤ: from 2.6

    2.8.  k·C(n, k) is even
          substitute k·C(n, k) = n·C(n − 1, k − 1) (line 2.5) into line 2.7

    2.9.  C(n, k) is even
          thm:odd-factor A := k, B := C(n, k), from H4, 2.8

    case
    assume not k ≤ n                                                  (C2)

    2.10. n < k
          inequalities, from C2

    2.11. C(n, k) = 0
          def:C, from 2.10

    2.12. C(n, k) = 2·0
          calculation
            C(n, k) = 0      2.11
                    = 2·0    arithmetic

    2.13. C(n, k) is even
          def:even n := C(n, k), from 2.12
