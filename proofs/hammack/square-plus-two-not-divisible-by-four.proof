import theorem            proofs/hammack/square-minus-three/four-times-between
import mundane definition stdlib/divisibility/divides
import mundane definition stdlib/divisibility/even
import mundane theorem    stdlib/divisibility/even-or-odd
import mundane definition stdlib/divisibility/odd

theorem square-plus-two-not-divisible-by-four
  note        If 4 divides n² + 2, then n² + 2 = 4m. For n = 2k this gives
              4(m − k²) = 2, and for n = 2k + 1 it gives
              4(m − k² − k) = 3. No multiple of 4 is 2 or 3.
  let n ∈ ℤ                                                           (H1)
  then not (4 divides n² + 2)

1.  not (4 divides n² + 2)
    contradiction
    suppose 4 divides n² + 2                                          (S)

    1.1.  m ∈ ℤ. n² + 2 = 4m.
          obtain m: mun:divides d := 4, n := n² + 2, from S

    1.2.  n is even or n is odd
          mun:even-or-odd

    1.3.  n² + 2 ≠ 4m
          cases, from 1.2

          case
          assume n is even                                            (C1)

          1.3.1.  k ∈ ℤ. n = 2k.
                  obtain k: mun:even, from C1

          1.3.2.  (2k)² + 2 = 4m
                  substitute n = 2k (line 1.3.1) into line 1.1

          1.3.3.  4(m − k²) = 2
                  algebra, from 1.3.2

          1.3.4.  4(m − k²) ≠ 2
                  thm:four-times-between j := m − k², r := 2, contradicting 1.3.3
                  requires 2 > 0: arithmetic
                  requires 2 < 4: arithmetic

          case
          assume n is odd                                             (C2)

          1.3.5.  k ∈ ℤ. n = 2k + 1.
                  obtain k: mun:odd, from C2

          1.3.6.  (2k + 1)² + 2 = 4m
                  substitute n = 2k + 1 (line 1.3.5) into line 1.1

          1.3.7.  4(m − k² − k) = 3
                  algebra, from 1.3.6

          1.3.8.  4(m − k² − k) ≠ 3
                  thm:four-times-between j := m − k² − k, r := 3, contradicting 1.3.7
                  requires 3 > 0: arithmetic
                  requires 3 < 4: arithmetic

    1.4.  n² + 2 ≠ 4m
          restate 1.3, contradicting 1.1
