import theorem            proofs/hammack/gcd-with-remainder/gcd-with-remainder
import definition         stdlib/divisibility/congruent-mod
import definition         stdlib/divisibility/divides
import definition         stdlib/divisibility/gcd

theorem congruent-same-gcd
  note        If a ≡ b (mod n) then a − b = n·k for some k, so a = k·n + b,
              and dividing a by n leaves the gcd with n that b has.
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  let n ∈ ℕ                                                           (H3)
  assume a ≡ b (mod n)                                                (H4)
  then gcd(a, n) = gcd(b, n)

1.  n divides a − b
    def:congruent-mod, from H4

2.  k ∈ ℤ. a − b = n·k.
    obtain k: def:divides d := n, n := a − b, from 1

3.  a = k·n + b
    algebra, from 2

4.  gcd(a, n) = gcd(b, n)
    thm:gcd-with-remainder b := n, q := k, r := b, from 3
