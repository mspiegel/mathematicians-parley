import definition         stdlib/divisibility/divides
import mundane theorem    stdlib/divisibility/divides-difference
import mundane theorem    stdlib/divisibility/divides-multiple
import mundane theorem    stdlib/numbers/exponent-sum

theorem divisible-by-nine
  note        By induction on n: 4^(3(m + 1)) + 8 is 64·(4^(3m) + 8) − 504,
              and 9 divides both 64·(4^(3m) + 8) and 504 = 9·56.
  let n ∈ ℕ₀                                                          (H1)
  then 9 divides 4^(3n) + 8

1.  For all m ∈ ℕ₀, 9 divides 4^(3m) + 8.
    induction on m starting at 0

    base
    1.1.  4^(3·0) + 8 = 9·1
          arithmetic

    1.2.  9 divides 4^(3·0) + 8
          def:divides d := 9, n := 4^(3·0) + 8, from 1.1

    step
    let m ∈ ℕ₀                                                        (K)
    assume step 1 is true for m, the induction hypothesis             (IH)

    1.3.  3(m + 1) = 3m + 3
          algebra

    1.4.  4^(3(m + 1)) = 4^(3m)·4^3
          calculation
            4^(3(m + 1)) = 4^(3m + 3)      substitute line 1.3
                         = 4^(3m)·4^3      mun:exponent-sum a := 4, m := 3m, n := 3

    1.5.  9 divides (4^(3m) + 8)·64
          mun:divides-multiple e := 9, a := 4^(3m) + 8, x := 64, from IH

    1.6.  9 divides 504
          def:divides d := 9, n := 504
          requires 504 = 9·56: arithmetic

    1.7.  9 divides (4^(3m) + 8)·64 − 504
          mun:divides-difference d := 9, a := (4^(3m) + 8)·64, b := 504, from 1.5, 1.6

    1.8.  9 divides 4^(3(m + 1)) + 8
          substitute
            9 divides (4^(3m) + 8)·64 − 504      1.7
            9 divides 4^(3(m + 1)) + 8           algebra, from 1.4

2.  9 divides 4^(3n) + 8
    instantiate m := n in line 1
