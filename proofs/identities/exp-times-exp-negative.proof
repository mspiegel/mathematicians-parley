import definition         stdlib/logarithms/exp
import mundane theorem    stdlib/logarithms/exp-sum

theorem exp-times-exp-negative
  note        exp(x)·exp(−x) = exp(x + (−x)) = exp(0) = 1.
  let x ∈ ℝ                                                           (H1)
  then exp(x)·exp(−x) = 1

1.  x + −x = 0
    algebra

2.  exp(x)·exp(−x) = 1
    calculation
      exp(x)·exp(−x) = exp(x + −x)    mun:exp-sum a := x, b := −x
                     = exp(0)         substitute line 1
                     = 1              real arithmetic
