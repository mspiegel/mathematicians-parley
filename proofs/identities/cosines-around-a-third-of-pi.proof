import theorem            stdlib/trigonometry/cos-add
import mundane definition stdlib/trigonometry/cos
import mundane theorem    stdlib/trigonometry/cos-negative
import mundane theorem    stdlib/trigonometry/cos-real
import mundane definition stdlib/trigonometry/sin
import mundane theorem    stdlib/trigonometry/sin-negative
import mundane theorem    stdlib/trigonometry/sin-real

theorem cosines-around-a-third-of-pi
  let x ∈ ℝ                                                           (H1)
  then cos(π/3 + x) + cos(π/3 − x) = cos(x)

1.  cos(π/3 + x) = cos(π/3)·cos(x) − sin(π/3)·sin(x)
    thm:cos-add a := π/3, b := x

2.  cos(π/3 + (−x)) = cos(π/3)·cos(−x) − sin(π/3)·sin(−x)
    thm:cos-add a := π/3, b := −x

3.  π/3 − x = π/3 + (−x)
    algebra

4.  cos(−x) = cos(x)
    mun:cos-negative a := x

5.  sin(−x) = −sin(x)
    mun:sin-negative a := x

6.  cos(π/3 + x) + cos(π/3 − x) = cos(π/3 + x) + cos(π/3 + (−x))
    substitute π/3 − x = π/3 + (−x) (line 3)

7.  cos(π/3 + x) + cos(π/3 + (−x)) = (cos(π/3)·cos(x) − sin(π/3)·sin(x)) + cos(π/3 + (−x))
    substitute cos(π/3 + x) = cos(π/3)·cos(x) − sin(π/3)·sin(x) (line 1)

8.  (cos(π/3)·cos(x) − sin(π/3)·sin(x)) + cos(π/3 + (−x)) = (cos(π/3)·cos(x) − sin(π/3)·sin(x)) + (cos(π/3)·cos(−x) − sin(π/3)·sin(−x))
    substitute cos(π/3 + (−x)) = cos(π/3)·cos(−x) − sin(π/3)·sin(−x) (line 2)

9.  (cos(π/3)·cos(x) − sin(π/3)·sin(x)) + (cos(π/3)·cos(−x) − sin(π/3)·sin(−x)) = (cos(π/3)·cos(x) − sin(π/3)·sin(x)) + (cos(π/3)·cos(x) − sin(π/3)·sin(−x))
    substitute cos(−x) = cos(x) (line 4)

10. (cos(π/3)·cos(x) − sin(π/3)·sin(x)) + (cos(π/3)·cos(x) − sin(π/3)·sin(−x)) = (cos(π/3)·cos(x) − sin(π/3)·sin(x)) + (cos(π/3)·cos(x) − sin(π/3)·(−sin(x)))
    substitute sin(−x) = −sin(x) (line 5)

11. (cos(π/3)·cos(x) − sin(π/3)·sin(x)) + (cos(π/3)·cos(x) − sin(π/3)·(−sin(x))) = 2·cos(π/3)·cos(x)
    algebra
    requires cos(x) ∈ ℝ: mun:cos-real a := x
    requires sin(x) ∈ ℝ: mun:sin-real a := x

12. 2·cos(π/3)·cos(x) = 2·(1/2)·cos(x)
    substitute cos(π/3) = 1/2 (real arithmetic)

13. 2·(1/2)·cos(x) = cos(x)
    algebra
    requires cos(x) ∈ ℝ: mun:cos-real a := x

14. cos(π/3 + x) + cos(π/3 − x) = cos(x)
    calculation
      cos(π/3 + x) + cos(π/3 − x) = cos(π/3 + x) + cos(π/3 + (−x))                                                                                                      6
        = (cos(π/3)·cos(x) − sin(π/3)·sin(x)) + cos(π/3 + (−x))                                                                                                         7
        = (cos(π/3)·cos(x) − sin(π/3)·sin(x)) + (cos(π/3)·cos(−x) − sin(π/3)·sin(−x))                                                                                   8
        = (cos(π/3)·cos(x) − sin(π/3)·sin(x)) + (cos(π/3)·cos(x) − sin(π/3)·sin(−x))                                                                                    9
        = (cos(π/3)·cos(x) − sin(π/3)·sin(x)) + (cos(π/3)·cos(x) − sin(π/3)·(−sin(x)))                                                                                  10
        = 2·cos(π/3)·cos(x)                                                                                                                                             11
        = 2·(1/2)·cos(x)                                                                                                                                                12
        = cos(x)                                                                                                                                                        13
