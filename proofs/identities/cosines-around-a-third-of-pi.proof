import theorem            stdlib/trigonometry/cos-add
import definition         stdlib/trigonometry/cos
import mundane theorem    stdlib/trigonometry/cos-negative
import definition         stdlib/trigonometry/sin
import mundane theorem    stdlib/trigonometry/sin-negative

theorem cosines-around-a-third-of-pi
  let x ∈ ℝ                                                           (H1)
  then cos(π/3 + x) + cos(π/3 − x) = cos(x)

1.  cos(π/3 + x) = cos(π/3)·cos(x) − sin(π/3)·sin(x)
    thm:cos-add a := π/3, b := x

2.  cos(π/3 + (−x)) = cos(π/3)·cos(−x) − sin(π/3)·sin(−x)
    thm:cos-add a := π/3, b := −x

3.  π/3 − x = π/3 + (−x)
    algebra

4.  cos(−x) = cos(x)
    mun:cos-negative a := x

5.  sin(−x) = −sin(x)
    mun:sin-negative a := x

6.  cos(π/3 + x) + cos(π/3 − x) = cos(x)
    calculation
      cos(π/3 + x) + cos(π/3 − x) = cos(π/3 + x) + cos(π/3 + (−x))                                                                                                      substitute line 3
        = (cos(π/3)·cos(x) − sin(π/3)·sin(x)) + cos(π/3 + (−x))                                                                                                         substitute line 1
        = (cos(π/3)·cos(x) − sin(π/3)·sin(x)) + (cos(π/3)·cos(−x) − sin(π/3)·sin(−x))                                                                                   substitute line 2
        = (cos(π/3)·cos(x) − sin(π/3)·sin(x)) + (cos(π/3)·cos(x) − sin(π/3)·sin(−x))                                                                                    substitute line 4
        = (cos(π/3)·cos(x) − sin(π/3)·sin(x)) + (cos(π/3)·cos(x) − sin(π/3)·(−sin(x)))                                                                                  substitute line 5
        = 2·cos(π/3)·cos(x)                                                                                                                                             algebra
        = 2·(1/2)·cos(x)                                                                                                                                                real arithmetic
        = cos(x)                                                                                                                                                        algebra
