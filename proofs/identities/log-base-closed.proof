import definition         stdlib/logarithms/ln
import mundane theorem    stdlib/numbers/quotient-positive

theorem log-two-of-eight
  note        8 is 2³, so ln(8) is 3·ln(2) and the quotient is 3.
  then ln(8)/ln(2) = 3

1.  ln(8)/ln(2) = 3·ln(2)/ln(2)
    substitute ln(8) = 3·ln(2) (real arithmetic)

2.  ln(8)/ln(2) = 3
    calculation
      ln(8)/ln(2) = 3·ln(2)/ln(2)    1
                  = 3                algebra
    requires ln(2) ≠ 0: real arithmetic


theorem log-ten-of-thousand
  note        1000 is 10³, so ln(1000) is 3·ln(10) and the quotient is 3.
  then ln(1000)/ln(10) = 3

1.  ln(1000)/ln(10) = 3·ln(10)/ln(10)
    substitute ln(1000) = 3·ln(10) (real arithmetic)

2.  ln(1000)/ln(10) = 3
    calculation
      ln(1000)/ln(10) = 3·ln(10)/ln(10)    1
                      = 3                  algebra
    requires ln(10) ≠ 0: real arithmetic


theorem log-two-of-three-between
  note        ln(2) < ln(3) < 2·ln(2), so dividing by ln(2) > 0 puts the
              quotient between 1 and 2.
  then 1 < ln(3)/ln(2) and ln(3)/ln(2) < 2

1.  (ln(3) − ln(2))/ln(2) > 0
    mun:quotient-positive x := ln(3) − ln(2), y := ln(2)
    requires ln(3) − ln(2) > 0: real arithmetic
    requires ln(2) > 0: real arithmetic

2.  ln(3)/ln(2) − 1 > 0
    substitute
      (ln(3) − ln(2))/ln(2) > 0      1
      ln(3)/ln(2) − 1 > 0            algebra
    requires ln(2) ≠ 0: real arithmetic

3.  1 < ln(3)/ln(2)
    inequalities, from 2
    requires ln(2) ≠ 0: real arithmetic

4.  (2·ln(2) − ln(3))/ln(2) > 0
    mun:quotient-positive x := 2·ln(2) − ln(3), y := ln(2)
    requires 2·ln(2) − ln(3) > 0: real arithmetic
    requires ln(2) > 0: real arithmetic

5.  2 − ln(3)/ln(2) > 0
    substitute
      (2·ln(2) − ln(3))/ln(2) > 0      4
      2 − ln(3)/ln(2) > 0              algebra
    requires ln(2) ≠ 0: real arithmetic

6.  ln(3)/ln(2) < 2
    inequalities
      2 − ln(3)/ln(2) > 0                          5
      2 − ln(3)/ln(2) + ln(3)/ln(2) > ln(3)/ln(2)  adding ln(3)/ln(2)
      2 > ln(3)/ln(2)                              algebra
      ln(3)/ln(2) < 2                              restate
    requires ln(2) ≠ 0: real arithmetic

7.  1 < ln(3)/ln(2) and ln(3)/ln(2) < 2
    join 3, 6
