import theorem            stdlib/trigonometry/cos-add
import definition         stdlib/trigonometry/cos
import mundane theorem    stdlib/trigonometry/cos-real
import definition         stdlib/trigonometry/sin
import mundane theorem    stdlib/trigonometry/sin-cos-squares
import mundane theorem    stdlib/trigonometry/sin-real

theorem fourth-powers-and-the-double-angle
  let x ∈ ℝ                                                           (H1)
  then cos(x)^4 − sin(x)^4 = cos(2·x)

1.  sin(x)² + cos(x)² = 1
    mun:sin-cos-squares a := x

2.  cos(x)^4 − sin(x)^4 = (cos(x)² − sin(x)²)·(sin(x)² + cos(x)²)
    algebra
    requires cos(x) ∈ ℝ: mun:cos-real a := x
    requires sin(x) ∈ ℝ: mun:sin-real a := x

3.  (cos(x)² − sin(x)²)·(sin(x)² + cos(x)²) = (cos(x)² − sin(x)²)·1
    substitute sin(x)² + cos(x)² = 1 (line 1)

4.  (cos(x)² − sin(x)²)·1 = cos(x)·cos(x) − sin(x)·sin(x)
    algebra
    requires cos(x) ∈ ℝ: mun:cos-real a := x
    requires sin(x) ∈ ℝ: mun:sin-real a := x

5.  cos(x + x) = cos(x)·cos(x) − sin(x)·sin(x)
    thm:cos-add a := x, b := x

6.  2·x = x + x
    algebra

7.  cos(2·x) = cos(x + x)
    substitute 2·x = x + x (line 6)

8.  cos(x)^4 − sin(x)^4 = cos(2·x)
    calculation
      cos(x)^4 − sin(x)^4 = (cos(x)² − sin(x)²)·(sin(x)² + cos(x)²)     2
                          = (cos(x)² − sin(x)²)·1                       3
                          = cos(x)·cos(x) − sin(x)·sin(x)               4
                          = cos(x + x)                                  5
                          = cos(2·x)                                    7
