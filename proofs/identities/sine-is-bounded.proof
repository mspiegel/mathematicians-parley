import definition         stdlib/trigonometry/cos
import definition         stdlib/trigonometry/sin
import mundane theorem    stdlib/trigonometry/sin-cos-squares
import mundane theorem    stdlib/numbers/square-less
import mundane theorem    stdlib/numbers/square-nonneg

theorem sine-is-bounded
  let x ∈ ℝ                                                           (H1)
  then −1 ≤ sin(x) and sin(x) ≤ 1

1.  sin(x)² + cos(x)² = 1
    mun:sin-cos-squares a := x

2.  cos(x)² ≥ 0
    mun:square-nonneg x := cos(x)

3.  −cos(x)² ≤ 0
    inequalities
      cos(x)² ≥ 0         2
      −cos(x)² ≤ 0        multiplying by −1

4.  sin(x)² + cos(x)² ≤ 1
    inequalities
      sin(x)² + cos(x)² = 1       1
      sin(x)² + cos(x)² ≤ 1       weakening

5.  sin(x)² ≤ 1
    inequalities, from 3, 4

6.  sin(x) ≤ 1
    contradiction
    suppose not sin(x) ≤ 1                                            (S1)

    6.1.  sin(x) > 1
          inequalities, from S1

    6.2.  sin(x) > 0
          inequalities, from 6.1

    6.3.  1² < sin(x)²
          mun:square-less x := 1, y := sin(x), from 6.1
          requires 1 ≥ 0: arithmetic
          requires sin(x) ≥ 0: weakening, from 6.2

    6.4.  not sin(x)² ≤ 1
          inequalities, from 6.3, contradicting 5

7.  −1 ≤ sin(x)
    contradiction
    suppose not −1 ≤ sin(x)                                           (S2)

    7.1.  sin(x) < −1
          inequalities, from S2

    7.2.  −sin(x) > 1
          inequalities
            sin(x) < −1       7.1
            −sin(x) > 1       multiplying by −1

    7.3.  −sin(x) > 0
          inequalities, from 7.2

    7.4.  1² < (−sin(x))²
          mun:square-less x := 1, y := −sin(x), from 7.2
          requires 1 ≥ 0: arithmetic
          requires −sin(x) ≥ 0: weakening, from 7.3

    7.5.  (−sin(x))² = sin(x)²
          algebra

    7.6.  1² < sin(x)²
          transitivity, from 7.4, 7.5

    7.7.  not sin(x)² ≤ 1
          inequalities, from 7.6, contradicting 5

8.  −1 ≤ sin(x) and sin(x) ≤ 1
    join 6, 7
