import theorem            stdlib/trigonometry/cos-add
import definition         stdlib/trigonometry/cos
import definition         stdlib/trigonometry/sin
import theorem            stdlib/trigonometry/sin-add
import mundane theorem    stdlib/trigonometry/sin-cos-squares

theorem sine-of-triple
  let x ∈ ℝ                                                           (H1)
  then sin(3·x) = 3·sin(x) − 4·sin(x)^3

1.  2·x = x + x
    algebra

2.  sin(2·x) = sin(x)·cos(x) + cos(x)·sin(x)
    calculation
      sin(2·x) = sin(x + x)                          substitute line 1
               = sin(x)·cos(x) + cos(x)·sin(x)       thm:sin-add a := x, b := x

3.  cos(2·x) = cos(x)·cos(x) − sin(x)·sin(x)
    calculation
      cos(2·x) = cos(x + x)                          substitute line 1
               = cos(x)·cos(x) − sin(x)·sin(x)       thm:cos-add a := x, b := x

4.  3·x = 2·x + x
    algebra

5.  sin(x)² + cos(x)² = 1
    mun:sin-cos-squares a := x

6.  sin(3·x) = 3·sin(x) − 4·sin(x)^3
    calculation
      sin(3·x) = sin(2·x + x)                                                                                                       substitute line 4
               = sin(2·x)·cos(x) + cos(2·x)·sin(x)                                                                                  thm:sin-add a := 2·x, b := x
               = (sin(x)·cos(x) + cos(x)·sin(x))·cos(x) + cos(2·x)·sin(x)                                                           substitute line 2
               = (sin(x)·cos(x) + cos(x)·sin(x))·cos(x) + (cos(x)·cos(x) − sin(x)·sin(x))·sin(x)                                    substitute line 3
               = 3·sin(x) − 4·sin(x)^3                                                                                              algebra, from 5
