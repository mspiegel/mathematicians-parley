import definition         stdlib/trigonometry/cos
import mundane theorem    stdlib/trigonometry/cos-negative
import mundane theorem    stdlib/trigonometry/cos-real
import definition         stdlib/trigonometry/sin
import theorem            stdlib/trigonometry/sin-add
import mundane theorem    stdlib/trigonometry/sin-negative
import mundane theorem    stdlib/trigonometry/sin-real

theorem sine-of-half-pi-minus
  let x ∈ ℝ                                                           (H1)
  then sin(π/2 − x) = cos(x)

1.  π/2 − x = π/2 + (−x)
    algebra

2.  sin(π/2)·cos(−x) + cos(π/2)·sin(−x) = 1·cos(−x) + cos(π/2)·sin(−x)
    substitute sin(π/2) = 1 (real arithmetic)

3.  1·cos(−x) + cos(π/2)·sin(−x) = 1·cos(−x) + 0·sin(−x)
    substitute cos(π/2) = 0 (real arithmetic)

4.  cos(−x) = cos(x)
    mun:cos-negative a := x

5.  sin(−x) = −sin(x)
    mun:sin-negative a := x

6.  sin(π/2 − x) = cos(x)
    calculation
      sin(π/2 − x) = sin(π/2 + (−x))                                    substitute line 1
                   = sin(π/2)·cos(−x) + cos(π/2)·sin(−x)                thm:sin-add a := π/2, b := −x
                   = 1·cos(−x) + cos(π/2)·sin(−x)                       2
                   = 1·cos(−x) + 0·sin(−x)                              3
                   = 1·cos(x) + 0·sin(−x)                               substitute line 4
                   = 1·cos(x) + 0·(−sin(x))                             substitute line 5
                   = cos(x)                                             algebra
    requires cos(x) ∈ ℝ: mun:cos-real a := x
    requires sin(x) ∈ ℝ: mun:sin-real a := x
