import definition         stdlib/trigonometry/cos
import mundane theorem    stdlib/trigonometry/cos-negative
import definition         stdlib/trigonometry/sin
import theorem            stdlib/trigonometry/sin-add
import mundane theorem    stdlib/trigonometry/sin-negative

theorem sine-of-half-pi-minus
  let x ∈ ℝ                                                           (H1)
  then sin(π/2 − x) = cos(x)

1.  π/2 − x = π/2 + (−x)
    algebra

2.  cos(−x) = cos(x)
    mun:cos-negative a := x

3.  sin(−x) = −sin(x)
    mun:sin-negative a := x

4.  sin(π/2 − x) = cos(x)
    calculation
      sin(π/2 − x) = sin(π/2 + (−x))                                    substitute line 1
                   = sin(π/2)·cos(−x) + cos(π/2)·sin(−x)                thm:sin-add a := π/2, b := −x
                   = 1·cos(−x) + cos(π/2)·sin(−x)                       real arithmetic
                   = 1·cos(−x) + 0·sin(−x)                              real arithmetic
                   = 1·cos(x) + 0·sin(−x)                               substitute line 2
                   = 1·cos(x) + 0·(−sin(x))                             substitute line 3
                   = cos(x)                                             algebra
