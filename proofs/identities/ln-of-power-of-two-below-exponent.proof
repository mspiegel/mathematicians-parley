import mundane definition stdlib/logarithms/ln
import theorem            stdlib/logarithms/ln-power
import mundane theorem    stdlib/numbers/less-scaled

theorem ln-of-power-of-two-below-exponent
  note        ln(2^n) = n·ln(2), and ln(2) < 1 with n > 0 gives n·ln(2) < n.
  let n ∈ ℕ                                                           (H1)
  then ln(2^n) < n

1.  ln(2^n) = n·ln(2)
    thm:ln-power x := 2
    requires 2 > 0: arithmetic

2.  ln(2) < 1
    real arithmetic

3.  n > 0
    inequalities, from H1

4.  n·ln(2) < n·1
    mun:less-scaled x := ln(2), y := 1, c := n, from 2, 3

5.  n·1 = n
    algebra

6.  ln(2^n) < n
    calculation
      ln(2^n) = n·ln(2)    1
              < n·1        4
              = n          5
