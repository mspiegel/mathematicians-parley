import theorem            stdlib/trigonometry/cos-add
import definition         stdlib/trigonometry/cos
import definition         stdlib/trigonometry/sin

theorem cosine-plus-pi
  let x ∈ ℝ                                                           (H1)
  then cos(x + π) = −cos(x)

1.  cos(x + π) = −cos(x)
    calculation
      cos(x + π) = cos(x)·cos(π) − sin(x)·sin(π)      thm:cos-add a := x, b := π
                 = cos(x)·(−1) − sin(x)·sin(π)        real arithmetic
                 = cos(x)·(−1) − sin(x)·0             real arithmetic
                 = −cos(x)                            algebra
