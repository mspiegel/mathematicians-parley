import mundane definition stdlib/logarithms/ln
import mundane definition stdlib/logarithms/exp
import mundane theorem    stdlib/logarithms/exp-sum
import mundane theorem    stdlib/logarithms/exp-ln
import mundane theorem    stdlib/logarithms/ln-real

theorem exp-of-ln-plus-one
  note        exp(ln(x) + 1) = exp(ln(x))·exp(1) = x·e.
  let x ∈ ℝ                                                           (H1)
  assume x > 0                                                        (H2)
  then exp(ln(x) + 1) = e·x

1.  exp(ln(x) + 1) = exp(ln(x))·exp(1)
    mun:exp-sum a := ln(x), b := 1
    requires ln(x) ∈ ℝ: mun:ln-real, from H2

2.  exp(ln(x)) = x
    mun:exp-ln, from H2

3.  exp(ln(x) + 1) = x·exp(1)
    substitute exp(ln(x)) = x (line 2) into line 1

4.  exp(1) = e
    real arithmetic

5.  exp(ln(x) + 1) = x·e
    substitute exp(1) = e (line 4) into line 3

6.  exp(ln(x) + 1) = e·x
    algebra, from 5
