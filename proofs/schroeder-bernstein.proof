import mundane definition stdlib/functions/bijection
import mundane theorem    stdlib/functions/function-into
import mundane theorem    stdlib/functions/function-value
import mundane definition stdlib/functions/image
import mundane theorem    stdlib/functions/image-monotone
import mundane theorem    stdlib/functions/image-within
import mundane theorem    stdlib/functions/inverse-value
import mundane definition stdlib/functions/one-to-one
import mundane theorem    stdlib/functions/value-in-image
import mundane axiom      stdlib/reasoning/excluded-middle
import mundane theorem    stdlib/sets/complement-swap
import mundane theorem    stdlib/sets/complement-swap-outside
import mundane definition stdlib/sets/difference
import mundane theorem    stdlib/sets/difference-reverses
import mundane theorem    stdlib/sets/difference-subset
import mundane theorem    stdlib/sets/disjoint-difference
import mundane theorem    stdlib/sets/disjoint-member
import mundane theorem    stdlib/sets/disjoint-within
import mundane theorem    stdlib/sets/equal-subset
import mundane theorem    stdlib/sets/in-subset
import mundane definition stdlib/sets/indexed-union
import mundane definition stdlib/sets/part-builder
import mundane definition stdlib/sets/subset
import mundane theorem    stdlib/sets/subset-antisymmetric
import mundane theorem    stdlib/sets/union-contains-member
import mundane theorem    stdlib/sets/union-within

theorem fixed-part
  metamath    sbthlem3, which says it of the union set.mm builds, where this
              says there is such a part
  note        C is a part of A such that g, applied to everything f misses
              from C, lands exactly on the rest of A. On C the bijection
              will be f; off C it is g run backwards.
  let A be a set                                                      (H1)
  let B be a set                                                      (H2)
  let f : A → B                                                       (H3)
  let g : B → A                                                       (H4)
  then there exists C ⊆ A such that g[B ∖ f[C]] = A ∖ C

define M(X) := g[B ∖ f[X]], for X ⊆ A                              (D1)
       reads take what f misses from X, and see where g sends it
define D := {X ⊆ A : M(X) ∩ X = ∅}                                  (D2)
       reads the parts X of A that share nothing with M(X)
define C := ⋃(X ∈ D) X                                               (D3)
       reads everything in at least one of them: the largest part of A that shares nothing with its M

1.  For all X ⊆ A, M(X) ⊆ A.
    mun:image-within f := g, from D1

2.  For all X, Y ⊆ A, if X ⊆ Y then M(Y) ⊆ M(X).
    proof
    let X ⊆ A                                                         (K3)
    let Y ⊆ A                                                         (K4)
    assume X ⊆ Y                                                      (A1)

    2.1.  f[X] ⊆ f[Y]
          mun:image-monotone, from A1

    2.2.  B ∖ f[Y] ⊆ B ∖ f[X]
          mun:difference-reverses, from 2.1

    2.3.  M(Y) ⊆ M(X)
          mun:image-monotone f := g, from D1, 2.2
          requires X ⊆ A: from K3
          requires Y ⊆ A: from K4

3.  For all X ∈ D, X ⊆ A.
    mun:part-builder, from D2

4.  C ⊆ A
    mun:union-within, from D3, 3

5.  M(C) ⊆ A
    instantiate X := C in line 1, from 4

6.  For all X ∈ D, M(C) ∩ X = ∅.
    proof
    let X ∈ D                                                         (K6)

    6.1.  X ⊆ A
          mun:part-builder, from D2, K6

    6.2.  M(X) ∩ X = ∅
          mun:part-builder, from D2, K6

    6.3.  X ⊆ C
          mun:union-contains-member Y := X, from D3, K6

    6.4.  M(C) ⊆ M(X)
          instantiate X := X, Y := C in line 2, from 6.1, 4, 6.3

    6.5.  M(C) ∩ X = ∅
          mun:disjoint-within, from 6.4, 6.2

7.  For all a ∈ M(C), a ∈ A ∖ C.
    proof
    let a ∈ M(C)                                                      (K7)

    7.1.  a ∈ A
          mun:in-subset, from 5, K7

    7.2.  a ∉ C
          contradiction
          suppose a ∈ C                                               (S1)

          7.2.1.  X ∈ D. a ∈ X.
                  obtain X: mun:indexed-union u := a, from D3, S1

          7.2.2.  M(C) ∩ X = ∅
                  instantiate X := X in line 6, from 7.2.1

          7.2.3.  a ∉ X
                  mun:disjoint-member, from 7.2.2, K7, contradicting 7.2.1

    7.3.  a ∈ A ∖ C
          mun:difference, from 7.1, 7.2

8.  M(C) ⊆ A ∖ C
    mun:subset, from 7

9.  C ⊆ A ∖ M(C)
    mun:complement-swap, from 4, 5, 8

10. A ∖ M(C) ⊆ A
    mun:difference-subset

11. M(A ∖ M(C)) ⊆ M(C)
    instantiate X := C, Y := A ∖ M(C) in line 2, from 4, 10, 9

12. M(C) ∩ (A ∖ M(C)) = ∅
    mun:disjoint-difference

13. M(A ∖ M(C)) ∩ (A ∖ M(C)) = ∅
    mun:disjoint-within, from 11, 12

14. A ∖ M(C) ∈ D
    mun:part-builder u := A ∖ M(C), from D2, 10, 13

15. A ∖ M(C) ⊆ C
    mun:union-contains-member Y := A ∖ M(C), from D3, 14

16. A ∖ C ⊆ M(C)
    mun:complement-swap-outside, from 15

17. M(C) = A ∖ C
    mun:subset-antisymmetric, from 8, 16

18. There exists C ⊆ A such that g[B ∖ f[C]] = A ∖ C.
    exhibit, from D1, 4, 17


theorem schroeder-bernstein
  metamath    sbth, which says it of one set dominating another, where this
              says it of the one-to-one functions that dominating names
  let A be a set                                                      (H1)
  let B be a set                                                      (H2)
  let f : A → B be one-to-one                                         (H3)
  let g : B → A be one-to-one                                         (H4)
  then there is a bijection from A to B

1.  For all s, t ∈ A, if f(s) = f(t) then s = t.
    mun:one-to-one, from H3

2.  C ⊆ A. g[B ∖ f[C]] = A ∖ C.
    obtain C: thm:fixed-part

    define R := f[C]                                                  (D1)
           reads what f reaches from C
    define h(x) := f(x)      if x ∈ C
                   g⁻¹(x)    otherwise,  for x ∈ A                    (D2)
           reads f on C, and the way back along g on the rest of A

3.  For all t ∈ A ∖ C, h(t) ∈ B ∖ R and g(h(t)) = t.
    proof
    let t ∈ A ∖ C                                                     (K1)

    3.1.  t ∈ A. t ∉ C.
          mun:difference, from K1

    3.2.  A ∖ C ⊆ g[B ∖ R]
          mun:equal-subset, from D1, 2

    3.3.  t ∈ g[B ∖ R]
          mun:in-subset, from 3.2, K1

    3.4.  y ∈ B ∖ R. t = g(y).
          obtain y: mun:image f := g, u := t, Y := B ∖ R, from 3.3
          requires B ∖ R ⊆ B: mun:difference-subset

    3.5.  y ∈ B
          mun:difference, from 3.4

    3.6.  h(t) = g⁻¹(t)
          D2, from 3.1

    3.7.  g⁻¹(g(y)) = y
          mun:inverse-value, from H4, 3.5

    3.8.  g⁻¹(t) = g⁻¹(g(y))
          substitute t = g(y) (line 3.4)

    3.9.  h(t) = y
          calculation
            h(t) = g⁻¹(t)            3.6
                 = g⁻¹(g(y))         3.8
                 = y                 3.7

    3.10. h(t) ∈ B ∖ R
          substitute h(t) = y (line 3.9) into line 3.4

    3.11. g(h(t)) = g(y)
          substitute h(t) = y (line 3.9)

    3.12. g(h(t)) = t
          calculation
            g(h(t)) = g(y)           3.11
                    = t              3.4

    3.13. h(t) ∈ B ∖ R. g(h(t)) = t.
          join 3.10, 3.12

4.  For all u ∈ C, for all v ∈ A ∖ C, h(u) ≠ h(v).
    proof
    let u ∈ C                                                         (K2)
    let v ∈ A ∖ C                                                     (K3)

    4.1.  h(u) ≠ h(v)
          contradiction
          suppose h(u) = h(v)                                         (S1)

          4.1.1.  h(u) = f(u)
                  D2, from K2
                  requires u ∈ A: mun:in-subset, from 2, K2

          4.1.2.  f(u) ∈ R
                  mun:value-in-image, from D1, K2
                  requires C ⊆ A: from 2

          4.1.3.  h(v) = f(u)
                  calculation
                    h(v) = h(u)      S1
                         = f(u)      4.1.1

          4.1.4.  h(v) ∈ R
                  substitute h(v) = f(u) (line 4.1.3) into line 4.1.2

          4.1.5.  h(v) ∈ B ∖ R. g(h(v)) = v.
                  instantiate t := v in line 3, from K3

          4.1.6.  h(v) ∉ R
                  mun:difference, from 4.1.5, contradicting 4.1.4

5.  For all s ∈ A, h(s) ∈ B.
    proof
    let s ∈ A                                                         (K4)

    5.1.  s ∈ C or s ∉ C
          mun:excluded-middle P := s ∈ C

    5.2.  h(s) ∈ B
          cases, from 5.1

          case
          assume s ∈ C                                                (C1)

          5.2.1.  h(s) = f(s)
                  D2, from C1
                  requires s ∈ A: from K4

          5.2.2.  f(s) ∈ B
                  mun:function-value f := f, x := s, from K4

          5.2.3.  h(s) ∈ B
                  substitute h(s) = f(s) (line 5.2.1) into line 5.2.2

          case
          assume s ∉ C                                                (C2)

          5.2.4.  s ∈ A ∖ C
                  mun:difference, from K4, C2

          5.2.5.  h(s) ∈ B ∖ R. g(h(s)) = s.
                  instantiate t := s in line 3, from 5.2.4

          5.2.6.  h(s) ∈ B
                  mun:difference, from 5.2.5

6.  h : A → B
    mun:function-into, from 5
    requires h is a function on A: from D2

7.  For all s, t ∈ A, if h(s) = h(t) then s = t.
    proof
    let s ∈ A                                                         (K5)
    let t ∈ A                                                         (K6)
    assume h(s) = h(t)                                                (A1)

    7.1.  s ∈ C or s ∉ C
          mun:excluded-middle P := s ∈ C

    7.2.  t ∈ C or t ∉ C
          mun:excluded-middle P := t ∈ C

    7.3.  s = t
          cases, from 7.1

          case
          assume s ∈ C                                                (C3)

          7.3.1.  s = t
                  cases, from 7.2

                  case
                  assume t ∈ C                                        (C4)

                  7.3.1.1.  h(s) = f(s)
                            D2, from C3
                            requires s ∈ A: from K5

                  7.3.1.2.  h(t) = f(t)
                            D2, from C4
                            requires t ∈ A: from K6

                  7.3.1.3.  f(s) = f(t)
                            calculation
                              f(s) = h(s)      7.3.1.1
                                   = h(t)      A1
                                   = f(t)      7.3.1.2

                  7.3.1.4.  s = t
                            instantiate s := s, t := t in line 1, from K5, K6, 7.3.1.3

                  case
                  assume t ∉ C                                        (C5)

                  7.3.1.5.  t ∈ A ∖ C
                            mun:difference, from K6, C5

                  7.3.1.6.  h(s) ≠ h(t)
                            instantiate u := s, v := t in line 4, from C3, 7.3.1.5, contradicting A1

          case
          assume s ∉ C                                                (C6)

          7.3.2.  s ∈ A ∖ C
                  mun:difference, from K5, C6

          7.3.3.  h(s) ∈ B ∖ R. g(h(s)) = s.
                  instantiate t := s in line 3, from 7.3.2

          7.3.4.  s = t
                  cases, from 7.2

                  case
                  assume t ∈ C                                        (C7)

                  7.3.4.1.  h(s) ≠ h(t)
                            instantiate u := t, v := s in line 4, from C7, 7.3.2, contradicting A1

                  case
                  assume t ∉ C                                        (C8)

                  7.3.4.2.  t ∈ A ∖ C
                            mun:difference, from K6, C8

                  7.3.4.3.  h(t) ∈ B ∖ R. g(h(t)) = t.
                            instantiate t := t in line 3, from 7.3.4.2

                  7.3.4.4.  g(h(s)) = g(h(t))
                            substitute h(s) = h(t) (A1)

                  7.3.4.5.  s = t
                            calculation
                              s = g(h(s))      7.3.3
                                = g(h(t))      7.3.4.4
                                = t            7.3.4.3

8.  For all b ∈ B, there is s ∈ A with b = h(s).
    proof
    let b ∈ B                                                         (K7)

    8.1.  b ∈ R or b ∉ R
          mun:excluded-middle P := b ∈ R

    8.2.  There is s ∈ A with b = h(s).
          cases, from 8.1

          case
          assume b ∈ R                                                (C9)

          8.2.1.  x ∈ C. b = f(x).
                  obtain x: mun:image u := b, Y := C, from D1, C9
                  requires C ⊆ A: from 2

          8.2.2.  x ∈ A
                  mun:in-subset, from 2, 8.2.1

          8.2.3.  h(x) = f(x)
                  D2, from 8.2.1
                  requires x ∈ A: from 8.2.2

          8.2.4.  b = h(x)
                  calculation
                    b = f(x)         8.2.1
                      = h(x)         8.2.3

          8.2.5.  There is s ∈ A with b = h(s).
                  exhibit, from 8.2.2, 8.2.4

          case
          assume b ∉ R                                                (C10)

          8.2.6.  b ∈ B ∖ R
                  mun:difference, from K7, C10

          8.2.7.  g(b) ∈ g[B ∖ R]
                  mun:value-in-image f := g, from 8.2.6
                  requires B ∖ R ⊆ B: mun:difference-subset

          8.2.8.  g[B ∖ R] ⊆ A ∖ C
                  mun:equal-subset, from D1, 2

          8.2.9.  g(b) ∈ A ∖ C
                  mun:in-subset, from 8.2.8, 8.2.7

          8.2.10. g(b) ∈ A. g(b) ∉ C.
                  mun:difference, from 8.2.9

          8.2.11. h(g(b)) = g⁻¹(g(b))
                  D2, from 8.2.10

          8.2.12. g⁻¹(g(b)) = b
                  mun:inverse-value, from H4, K7

          8.2.13. b = h(g(b))
                  calculation
                    b = g⁻¹(g(b))    8.2.12
                      = h(g(b))      8.2.11

          8.2.14. There is s ∈ A with b = h(s).
                  exhibit, from 8.2.10, 8.2.13

9.  h : A → B is one-to-one
    mun:one-to-one, from 6, 7

10. There is a bijection from A to B.
    mun:bijection, from 9, 8
