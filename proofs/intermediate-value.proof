import axiom              stdlib/calculus/completeness
import theorem            proofs/triangle-inequality/abs-bounds
import mundane definition stdlib/calculus/interval
import mundane theorem    stdlib/calculus/interval-real
import mundane definition stdlib/calculus/least-upper-bound
import mundane definition stdlib/calculus/upper-bound
import mundane theorem    stdlib/numbers/abs-difference-lt
import mundane theorem    stdlib/numbers/abs-real
import mundane theorem    stdlib/numbers/half-real
import mundane theorem    stdlib/numbers/lt-min
import mundane definition stdlib/numbers/min
import mundane theorem    stdlib/numbers/min-le
import mundane theorem    stdlib/numbers/min-real
import mundane theorem    stdlib/numbers/real-closure
import mundane axiom      stdlib/numbers/trichotomy
import mundane definition stdlib/sets/set-builder
import mundane theorem    stdlib/sets/set-builder-subset
import mundane theorem    stdlib/sets/subset-transitive
import definition         stdlib/calculus/continuous-on

theorem intermediate-value
  metamath    ivth, the general form
  let a ∈ ℝ                                                           (H1)
  let b ∈ ℝ                                                           (H2)
  assume a < b                                                        (H3)
  let f : [a, b] → ℝ                                                  (H4)
  assume f is continuous on [a, b]                                    (H5)
  assume f(a) < 0                                                     (H6)
  assume 0 < f(b)                                                     (H7)
  ε, δ range over ℝ
  then there exists c ∈ [a, b] such that f(c) = 0

define S := {x ∈ [a, b] : f(x) < 0}                                   (D1)
       reads the points of the interval where f is still below zero

1.  a ∈ [a, b]
    mun:interval x := a, from H1, H2
    requires a ≤ a: inequalities, from H1
    requires a ≤ b: inequalities, from H1, H2, H3

2.  a ∈ S
    mun:set-builder u := a, from D1, 1, H6

3.  S ⊆ [a, b]
    mun:set-builder-subset, from D1

4.  [a, b] ⊆ ℝ
    mun:interval-real, from H1, H2

5.  S ⊆ ℝ
    mun:subset-transitive X := S, Y := [a, b], Z := ℝ, from 3, 4

6.  For all s ∈ S, s ≤ b.
    fix
    let s ∈ S                                                         (K1)

    6.1.  s ∈ [a, b]
          mun:set-builder, from D1, K1

    6.2.  s ≤ b
          mun:interval, from H1, H2, 6.1

7.  b is an upper bound of S
    mun:upper-bound, from 6

8.  c ∈ ℝ. c is a least upper bound of S.
    obtain c: axi:completeness S := S, from 5, 2, 7
    requires b ∈ ℝ: from H2

9.  c is an upper bound of S.
    For all u ∈ ℝ, if u is an upper bound of S then c ≤ u.
    mun:least-upper-bound, from 8

10. For all s ∈ S, s ≤ c.
    mun:upper-bound, from 9

11. a ≤ c
    instantiate s := a in line 10, from 2

12. c ≤ b
    instantiate u := b in line 9, from H2, 7

13. c ∈ [a, b]
    mun:interval x := c, from H1, H2, 8, 11, 12

14. f(c) < 0 or f(c) = 0 or 0 < f(c)
    mun:trichotomy x := f(c), from H4, 13

15. For all c′ ∈ [a, b], for all ε > 0, there exists δ > 0 such that
    |f(x) − f(c′)| < ε for all x ∈ [a, b] with |x − c′| < δ.
    def:continuous-on, from H5
    requires [a, b] ⊆ ℝ: mun:interval-real, from H1, H2

16. f(c) = 0
    cases, from 14

    case
    assume f(c) < 0                                                   (C1)

    16.1.  c ≠ b
           contradiction
           suppose c = b                                              (S1)

           16.1.1.  f(b) < 0
                    substitute c = b (S1) into C1

           16.1.2.  b ∈ [a, b]
                    mun:interval x := b, from H1, H2
                    requires a ≤ b: inequalities, from H1, H2, H3
                    requires b ≤ b: inequalities, from H2

           16.1.3.  not f(b) < 0
                    inequalities, from H7, contradicting 16.1.1
                    requires f(b) ∈ ℝ: from H4, 16.1.2

    16.2.  c < b
           inequalities, from 12, 16.1
           requires c ∈ ℝ: from 8
           requires b ∈ ℝ: from H2

    16.3.  −f(c) > 0
           inequalities, from C1
           requires f(c) ∈ ℝ: from H4, 13

    16.4.  There exists δ > 0 such that
           |f(x) − f(c)| < −f(c) for all x ∈ [a, b] with |x − c| < δ.
           instantiate c′ := c, ε := −f(c) in line 15, from 13, H4, 16.3

    16.5.  δ ∈ ℝ. δ > 0.
           For all x ∈ [a, b], if |x − c| < δ then |f(x) − f(c)| < −f(c).
           obtain δ from line 16.4

    define x₁ := min(b, c + δ/2)                                       (D2)
           reads a point right of c, within δ of it, and not past b

    16.6.  δ/2 > 0
           inequalities, from 16.5
           requires δ ∈ ℝ: from 16.5

    16.7.  c + δ/2 ∈ ℝ
           mun:real-closure x := c, y := δ/2, from 8
           requires δ/2 ∈ ℝ: mun:half-real x := δ, from 16.5

    16.8.  c < c + δ/2
           inequalities, from 16.6
           requires c ∈ ℝ: from 8
           requires δ ∈ ℝ: from 16.5

    16.9.  x₁ ∈ ℝ
           mun:min-real x := b, y := c + δ/2, from D2, H2, 16.7

    16.10. c < x₁
           mun:lt-min z := c, x := b, y := c + δ/2, from D2, 8, H2, 16.7, 16.2, 16.8

    16.11. x₁ ≤ b. x₁ ≤ c + δ/2.
           mun:min-le x := b, y := c + δ/2, from D2, H2, 16.7

    16.12. x₁ − c < δ
           inequalities, from 16.11, 16.6
           requires x₁ ∈ ℝ: from 16.9
           requires c ∈ ℝ: from 8
           requires δ ∈ ℝ: from 16.5

    16.13. a ≤ x₁
           inequalities, from 11, 16.10
           requires a ∈ ℝ: from H1
           requires c ∈ ℝ: from 8
           requires x₁ ∈ ℝ: from 16.9

    16.14. x₁ ∈ [a, b]
           mun:interval x := x₁, from H1, H2, 16.9, 16.13, 16.11

    16.15. c − δ < x₁
           inequalities, from 16.10, 16.5
           requires c ∈ ℝ: from 8
           requires x₁ ∈ ℝ: from 16.9
           requires δ ∈ ℝ: from 16.5

    16.16. x₁ < c + δ
           inequalities, from 16.12
           requires c ∈ ℝ: from 8
           requires x₁ ∈ ℝ: from 16.9
           requires δ ∈ ℝ: from 16.5

    16.17. |x₁ − c| < δ
           mun:abs-difference-lt x := x₁, c := c, δ := δ, from 16.9, 8, 16.5, 16.15, 16.16

    16.18. |f(x₁) − f(c)| < −f(c)
           instantiate x := x₁ in line 16.5, from 16.14, 16.17

    16.19. f(x₁) − f(c) ∈ ℝ
           mun:real-closure, from H4, 16.14, 13

    16.20. f(x₁) − f(c) ≤ |f(x₁) − f(c)|
           thm:abs-bounds x := f(x₁) − f(c), from 16.19

    16.21. f(x₁) < 0
           inequalities, from 16.20, 16.18
           requires f(x₁) ∈ ℝ: from H4, 16.14
           requires f(c) ∈ ℝ: from H4, 13
           requires |f(x₁) − f(c)| ∈ ℝ: mun:abs-real x := f(x₁) − f(c), from 16.19

    16.22. x₁ ∈ S
           mun:set-builder u := x₁, from D1, 16.14, 16.21

    16.23. x₁ ≤ c
           instantiate s := x₁ in line 10, from 16.22

    16.24. not x₁ ≤ c
           inequalities, from 16.10, contradicting 16.23
           requires c ∈ ℝ: from 8
           requires x₁ ∈ ℝ: from 16.9

    case
    assume f(c) = 0, which is the claim                               (C2)

    case
    assume 0 < f(c)                                                   (C3)

    16.25. There exists δ > 0 such that
           |f(x) − f(c)| < f(c) for all x ∈ [a, b] with |x − c| < δ.
           instantiate c′ := c, ε := f(c) in line 15, from 13, H4, C3

    16.26. δ ∈ ℝ. δ > 0.
           For all x ∈ [a, b], if |x − c| < δ then |f(x) − f(c)| < f(c).
           obtain δ from line 16.25

    16.27. For all s ∈ S, s ≤ c − δ.
           fix
           let s ∈ S                                                  (K2)

           16.27.1.  s ∈ [a, b]
                     mun:set-builder, from D1, K2

           16.27.2.  f(s) < 0
                     mun:set-builder, from D1, K2

           16.27.3.  s ∈ ℝ
                     mun:interval, from H1, H2, 16.27.1

           16.27.4.  s ≤ c
                     instantiate s := s in line 10, from K2

           16.27.5.  s ≤ c − δ
                     contradiction
                     suppose not s ≤ c − δ                            (S2)

                     16.27.5.1.  c − δ < s
                                 inequalities, from S2
                                 requires c ∈ ℝ: from 8
                                 requires s ∈ ℝ: from 16.27.3
                                 requires δ ∈ ℝ: from 16.26

                     16.27.5.2.  s < c + δ
                                 inequalities, from 16.27.4, 16.26
                                 requires c ∈ ℝ: from 8
                                 requires s ∈ ℝ: from 16.27.3
                                 requires δ ∈ ℝ: from 16.26

                     16.27.5.3.  |s − c| < δ
                                 mun:abs-difference-lt x := s, c := c, δ := δ,
                                   from 16.27.3, 8, 16.26, 16.27.5.1, 16.27.5.2

                     16.27.5.4.  |f(s) − f(c)| < f(c)
                                 instantiate x := s in line 16.26, from 16.27.1, 16.27.5.3

                     16.27.5.5.  f(s) − f(c) ∈ ℝ
                                 mun:real-closure, from H4, 16.27.1, 13

                     16.27.5.6.  −(f(s) − f(c)) ≤ |f(s) − f(c)|
                                 thm:abs-bounds x := f(s) − f(c), from 16.27.5.5

                     16.27.5.7.  0 < f(s)
                                 inequalities, from 16.27.5.6, 16.27.5.4
                                 requires f(s) ∈ ℝ: from H4, 16.27.1
                                 requires f(c) ∈ ℝ: from H4, 13
                                 requires |f(s) − f(c)| ∈ ℝ: mun:abs-real x := f(s) − f(c),
                                   from 16.27.5.5

                     16.27.5.8.  not f(s) < 0
                                 inequalities, from 16.27.5.7, contradicting 16.27.2
                                 requires f(s) ∈ ℝ: from H4, 16.27.1

    16.28. c − δ is an upper bound of S
           mun:upper-bound, from 16.27

    16.29. c ≤ c − δ
           instantiate u := c − δ in line 9, from 16.28
           requires c − δ ∈ ℝ: mun:real-closure, from 8, 16.26

    16.30. not c ≤ c − δ
           inequalities, from 16.26, contradicting 16.29
           requires c ∈ ℝ: from 8
           requires δ ∈ ℝ: from 16.26

17. There exists c ∈ [a, b] such that f(c) = 0.
    exhibit, from 13, 16
