import theorem            stdlib/divisibility/gcd-mod
import mundane definition stdlib/divisibility/gcd
import mundane theorem    stdlib/divisibility/gcd-commutes
import mundane theorem    stdlib/divisibility/gcd-zero
import mundane theorem    stdlib/divisibility/mod-less
import mundane theorem    stdlib/divisibility/mod-natural
import mundane theorem    stdlib/numbers/integer-step
import mundane theorem    stdlib/numbers/nat0-int
import mundane theorem    stdlib/numbers/nat0-nonzero
import mundane theorem    stdlib/numbers/nat0-real
import mundane theorem    stdlib/reasoning/disjunctive-syllogism
import mundane axiom      stdlib/reasoning/excluded-middle
import mundane theorem    stdlib/reasoning/from-contradiction
import mundane theorem    stdlib/reasoning/or-left
import mundane theorem    stdlib/reasoning/or-right

theorem euclid
  metamath    eucalg
  let M ∈ ℕ₀                                                          (H1)
  let N ∈ ℕ₀                                                          (H2)
  define a(0) := M,  b(0) := N,
         a(k + 1) := a(k)             if b(k) = 0
                     b(k)             otherwise,
         b(k + 1) := 0                if b(k) = 0
                     a(k) mod b(k)    otherwise,   for k ∈ ℕ₀           (D1)
         reads the two numbers Euclid's algorithm holds after k steps
  then a(N) = gcd(M, N)

1.  a(0) = M
    D1

2.  b(0) = N
    D1

3.  For all k ∈ ℕ₀, a(k) ∈ ℕ₀ and b(k) ∈ ℕ₀ and gcd(a(k), b(k)) = gcd(M, N)
    and (b(k) + k ≤ N or b(k) = 0).
    fix
    let k ∈ ℕ₀                                                        (K)

    3.1.  a(k) ∈ ℕ₀ and b(k) ∈ ℕ₀ and gcd(a(k), b(k)) = gcd(M, N)
          and (b(k) + k ≤ N or b(k) = 0)
          induction on k starting at 0, from K

          base
          3.1.1.  a(0) ∈ ℕ₀
                  substitute a(0) = M (line 1) into H1

          3.1.2.  b(0) ∈ ℕ₀
                  substitute b(0) = N (line 2) into H2

          3.1.3.  gcd(a(0), b(0)) = gcd(M, b(0))
                  substitute a(0) = M (line 1)

          3.1.4.  gcd(M, b(0)) = gcd(M, N)
                  substitute b(0) = N (line 2)

          3.1.5.  gcd(a(0), b(0)) = gcd(M, N)
                  calculation
                    gcd(a(0), b(0)) = gcd(M, b(0))     3.1.3
                                    = gcd(M, N)        3.1.4

          3.1.6.  b(0) + 0 ≤ N
                  inequalities, from 2
                  requires N ∈ ℝ: mun:nat0-real, from H2
                  requires b(0) ∈ ℝ: mun:nat0-real, from 3.1.2

          3.1.7.  b(0) + 0 ≤ N or b(0) = 0
                  mun:or-left, from 3.1.6

          3.1.8.  a(0) ∈ ℕ₀ and b(0) ∈ ℕ₀ and gcd(a(0), b(0)) = gcd(M, N)
                  and (b(0) + 0 ≤ N or b(0) = 0)
                  join 3.1.1, 3.1.2, 3.1.5, 3.1.7

          step
          3.1.9.  For all j ∈ ℕ₀, if a(j) ∈ ℕ₀ and b(j) ∈ ℕ₀
                  and gcd(a(j), b(j)) = gcd(M, N) and (b(j) + j ≤ N or b(j) = 0)
                  then a(j + 1) ∈ ℕ₀ and b(j + 1) ∈ ℕ₀
                  and gcd(a(j + 1), b(j + 1)) = gcd(M, N)
                  and (b(j + 1) + (j + 1) ≤ N or b(j + 1) = 0).
                  fix
                  let j ∈ ℕ₀                                          (J)
                  assume a(j) ∈ ℕ₀ and b(j) ∈ ℕ₀ and gcd(a(j), b(j)) = gcd(M, N) and (b(j) + j ≤ N or b(j) = 0)   (I)

                  3.1.9.1.  b(j) = 0 or b(j) ≠ 0
                            mun:excluded-middle P := b(j) = 0

                  3.1.9.2.  a(j + 1) ∈ ℕ₀ and b(j + 1) ∈ ℕ₀
                            and gcd(a(j + 1), b(j + 1)) = gcd(M, N)
                            and (b(j + 1) + (j + 1) ≤ N or b(j + 1) = 0)
                            cases, from 3.1.9.1

                            case
                            assume b(j) = 0                           (C1)

                            3.1.9.2.1.  a(j + 1) = a(j)
                                        D1, from C1
                                        requires j ∈ ℕ₀: from J

                            3.1.9.2.2.  b(j + 1) = 0
                                        D1, from C1
                                        requires j ∈ ℕ₀: from J

                            3.1.9.2.3.  a(j + 1) ∈ ℕ₀
                                        substitute a(j + 1) = a(j) (line 3.1.9.2.1) into I

                            3.1.9.2.4.  0 ∈ ℕ₀
                                        membership

                            3.1.9.2.5.  b(j + 1) ∈ ℕ₀
                                        substitute b(j + 1) = 0 (line 3.1.9.2.2) into line 3.1.9.2.4

                            3.1.9.2.6.  gcd(a(j + 1), b(j + 1)) = gcd(a(j), b(j + 1))
                                        substitute a(j + 1) = a(j) (line 3.1.9.2.1)

                            3.1.9.2.7.  gcd(a(j), b(j + 1)) = gcd(a(j), 0)
                                        substitute b(j + 1) = 0 (line 3.1.9.2.2)

                            3.1.9.2.8.  gcd(a(j), 0) = gcd(a(j), b(j))
                                        substitute b(j) = 0 (C1)

                            3.1.9.2.9.  gcd(a(j + 1), b(j + 1)) = gcd(M, N)
                                        calculation
                                          gcd(a(j + 1), b(j + 1)) = gcd(a(j), b(j + 1))    3.1.9.2.6
                                                                  = gcd(a(j), 0)           3.1.9.2.7
                                                                  = gcd(a(j), b(j))        3.1.9.2.8
                                                                  = gcd(M, N)              I

                            3.1.9.2.10. b(j + 1) + (j + 1) ≤ N or b(j + 1) = 0
                                        mun:or-right, from 3.1.9.2.2

                            3.1.9.2.11. a(j + 1) ∈ ℕ₀ and b(j + 1) ∈ ℕ₀
                                        and gcd(a(j + 1), b(j + 1)) = gcd(M, N)
                                        and (b(j + 1) + (j + 1) ≤ N or b(j + 1) = 0)
                                        join 3.1.9.2.3, 3.1.9.2.5, 3.1.9.2.9, 3.1.9.2.10

                            case
                            assume b(j) ≠ 0                           (C2)

                            3.1.9.2.12. a(j + 1) = b(j)
                                        D1, from C2
                                        requires j ∈ ℕ₀: from J

                            3.1.9.2.13. b(j + 1) = a(j) mod b(j)
                                        D1, from C2
                                        requires j ∈ ℕ₀: from J

                            3.1.9.2.14. b(j) ∈ ℕ
                                        mun:nat0-nonzero, from I, C2

                            3.1.9.2.15. a(j) mod b(j) ∈ ℕ₀
                                        mun:mod-natural, from 3.1.9.2.14
                                        requires a(j) ∈ ℤ: mun:nat0-int, from I

                            3.1.9.2.16. a(j + 1) ∈ ℕ₀
                                        substitute a(j + 1) = b(j) (line 3.1.9.2.12) into I

                            3.1.9.2.17. b(j + 1) ∈ ℕ₀
                                        substitute b(j + 1) = a(j) mod b(j) (line 3.1.9.2.13) into line 3.1.9.2.15

                            3.1.9.2.18. gcd(a(j) mod b(j), b(j)) = gcd(a(j), b(j))
                                        thm:gcd-mod, from 3.1.9.2.14
                                        requires a(j) ∈ ℤ: mun:nat0-int, from I

                            3.1.9.2.19. gcd(b(j), a(j) mod b(j)) = gcd(a(j) mod b(j), b(j))
                                        mun:gcd-commutes
                                        requires b(j) ∈ ℤ: mun:nat0-int, from I
                                        requires a(j) mod b(j) ∈ ℤ: mun:nat0-int, from 3.1.9.2.15

                            3.1.9.2.20. gcd(a(j + 1), b(j + 1)) = gcd(b(j), b(j + 1))
                                        substitute a(j + 1) = b(j) (line 3.1.9.2.12)

                            3.1.9.2.21. gcd(b(j), b(j + 1)) = gcd(b(j), a(j) mod b(j))
                                        substitute b(j + 1) = a(j) mod b(j) (line 3.1.9.2.13)

                            3.1.9.2.22. gcd(a(j + 1), b(j + 1)) = gcd(M, N)
                                        calculation
                                          gcd(a(j + 1), b(j + 1)) = gcd(b(j), b(j + 1))                3.1.9.2.20
                                                                  = gcd(b(j), a(j) mod b(j))           3.1.9.2.21
                                                                  = gcd(a(j) mod b(j), b(j))           3.1.9.2.19
                                                                  = gcd(a(j), b(j))                    3.1.9.2.18
                                                                  = gcd(M, N)                          I

                            3.1.9.2.23. b(j) + j ≤ N
                                        mun:disjunctive-syllogism, from I, C2

                            3.1.9.2.24. a(j) mod b(j) < b(j)
                                        mun:mod-less, from 3.1.9.2.14
                                        requires a(j) ∈ ℤ: mun:nat0-int, from I

                            3.1.9.2.25. b(j + 1) < b(j)
                                        substitute b(j + 1) = a(j) mod b(j) (line 3.1.9.2.13) into line 3.1.9.2.24

                            3.1.9.2.26. b(j + 1) + 1 ≤ b(j)
                                        mun:integer-step, from 3.1.9.2.25
                                        requires b(j + 1) ∈ ℤ: mun:nat0-int, from 3.1.9.2.17
                                        requires b(j) ∈ ℤ: mun:nat0-int, from I

                            3.1.9.2.27. b(j + 1) + (j + 1) ≤ N
                                        inequalities, from 3.1.9.2.26, 3.1.9.2.23
                                        requires b(j + 1) ∈ ℝ: mun:nat0-real, from 3.1.9.2.17
                                        requires b(j) ∈ ℝ: mun:nat0-real, from I
                                        requires j ∈ ℝ: mun:nat0-real, from J
                                        requires N ∈ ℝ: mun:nat0-real, from H2

                            3.1.9.2.28. b(j + 1) + (j + 1) ≤ N or b(j + 1) = 0
                                        mun:or-left, from 3.1.9.2.27

                            3.1.9.2.29. a(j + 1) ∈ ℕ₀ and b(j + 1) ∈ ℕ₀
                                        and gcd(a(j + 1), b(j + 1)) = gcd(M, N)
                                        and (b(j + 1) + (j + 1) ≤ N or b(j + 1) = 0)
                                        join 3.1.9.2.16, 3.1.9.2.17, 3.1.9.2.22, 3.1.9.2.28

4.  a(N) ∈ ℕ₀ and b(N) ∈ ℕ₀ and gcd(a(N), b(N)) = gcd(M, N)
    and (b(N) + N ≤ N or b(N) = 0)
    instantiate k := N in line 3, from H2

5.  b(N) = 0 or b(N) ≠ 0
    mun:excluded-middle P := b(N) = 0

6.  b(N) = 0
    cases, from 5

    case
    assume b(N) = 0                                                   (C3)

    6.1.  b(N) = 0
          join C3

    case
    assume b(N) ≠ 0                                                   (C4)

    6.2.  b(N) + N ≤ N
          mun:disjunctive-syllogism, from 4, C4

    6.3.  b(N) ∈ ℕ
          mun:nat0-nonzero, from 4, C4

    6.4.  not b(N) + N ≤ N
          inequalities, from 6.3
          requires N ∈ ℝ: mun:nat0-real, from H2

    6.5.  b(N) + N ≤ N. not b(N) + N ≤ N.
          join 6.2, 6.4

    6.6.  b(N) = 0
          mun:from-contradiction P := b(N) + N ≤ N, Q := b(N) = 0, from 6.5

7.  gcd(a(N), 0) = a(N)
    mun:gcd-zero, from 4

8.  gcd(a(N), 0) = gcd(a(N), b(N))
    substitute b(N) = 0 (line 6)

9.  a(N) = gcd(M, N)
    calculation
      a(N) = gcd(a(N), 0)          7
           = gcd(a(N), b(N))       8
           = gcd(M, N)             4
