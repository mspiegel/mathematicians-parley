import theorem            stdlib/divisibility/gcd-mod
import mundane definition stdlib/divisibility/gcd
import mundane theorem    stdlib/divisibility/gcd-commutes
import mundane theorem    stdlib/divisibility/gcd-zero
import mundane theorem    stdlib/divisibility/mod-less
import mundane theorem    stdlib/divisibility/mod-natural
import mundane theorem    stdlib/numbers/integer-step
import mundane theorem    stdlib/numbers/nat0-int
import mundane theorem    stdlib/numbers/nat0-nonzero
import mundane theorem    stdlib/numbers/nat0-real
import mundane theorem    stdlib/reasoning/disjunctive-syllogism
import mundane axiom      stdlib/reasoning/excluded-middle
import mundane theorem    stdlib/reasoning/or-left
import mundane theorem    stdlib/reasoning/or-right

theorem euclid
  metamath    eucalg
  note        Each step replaces (a, b) by (b, a mod b), which keeps the gcd
              and makes b smaller, until b is 0 and the gcd is a itself. b
              starts at N and falls by at least 1 a step, so after N steps
              it is 0.
  let M ∈ ℕ₀                                                          (H1)
  let N ∈ ℕ₀                                                          (H2)
  define a(0) := M,  b(0) := N,
         a(k + 1) := a(k)             if b(k) = 0
                     b(k)             otherwise,
         b(k + 1) := 0                if b(k) = 0
                     a(k) mod b(k)    otherwise,   for k ∈ ℕ₀           (D1)
         reads the two numbers Euclid's algorithm holds after k steps
  then a(N) = gcd(M, N)

1.  a(0) = M
    D1

2.  b(0) = N
    D1

3.  For all k ∈ ℕ₀, a(k) ∈ ℕ₀ and b(k) ∈ ℕ₀ and gcd(a(k), b(k)) = gcd(M, N)
    and (b(k) + k ≤ N or b(k) = 0).
    induction on k starting at 0
    note the gcd never changes, and b falls by at least 1 a step until it is 0

    base
    3.1.  a(0) ∈ ℕ₀
          substitute a(0) = M (line 1) into H1

    3.2.  b(0) ∈ ℕ₀
          substitute b(0) = N (line 2) into H2

    3.3.  gcd(a(0), b(0)) = gcd(M, b(0))
          substitute a(0) = M (line 1)

    3.4.  gcd(M, b(0)) = gcd(M, N)
          substitute b(0) = N (line 2)

    3.5.  gcd(a(0), b(0)) = gcd(M, N)
          calculation
            gcd(a(0), b(0)) = gcd(M, b(0))     3.3
                            = gcd(M, N)        3.4

    3.6.  b(0) + 0 ≤ N
          inequalities, from 2
          requires b(0) ∈ ℝ: mun:nat0-real, from 3.2

    3.7.  b(0) + 0 ≤ N or b(0) = 0
          mun:or-left, from 3.6

    3.8.  a(0) ∈ ℕ₀ and b(0) ∈ ℕ₀ and gcd(a(0), b(0)) = gcd(M, N)
          and (b(0) + 0 ≤ N or b(0) = 0)
          join 3.1, 3.2, 3.5, 3.7

    step
    let k ∈ ℕ₀                                                        (K)
    assume step 3 is true for k, the induction hypothesis             (IH)

    3.9.  b(k) = 0 or b(k) ≠ 0
          mun:excluded-middle P := b(k) = 0

    3.10. a(k + 1) ∈ ℕ₀ and b(k + 1) ∈ ℕ₀
          and gcd(a(k + 1), b(k + 1)) = gcd(M, N)
          and (b(k + 1) + (k + 1) ≤ N or b(k + 1) = 0)
          cases, from 3.9

          case
          assume b(k) = 0                                             (C1)

          3.10.1.  a(k + 1) = a(k)
                   D1, from C1

          3.10.2.  b(k + 1) = 0
                   D1, from C1

          3.10.3.  a(k + 1) ∈ ℕ₀
                   substitute a(k + 1) = a(k) (line 3.10.1) into IH

          3.10.4.  0 ∈ ℕ₀
                   membership

          3.10.5.  b(k + 1) ∈ ℕ₀
                   substitute b(k + 1) = 0 (line 3.10.2) into line 3.10.4

          3.10.6.  gcd(a(k + 1), b(k + 1)) = gcd(a(k), b(k + 1))
                   substitute a(k + 1) = a(k) (line 3.10.1)

          3.10.7.  gcd(a(k), b(k + 1)) = gcd(a(k), 0)
                   substitute b(k + 1) = 0 (line 3.10.2)

          3.10.8.  gcd(a(k), 0) = gcd(a(k), b(k))
                   substitute b(k) = 0 (C1)

          3.10.9.  gcd(a(k + 1), b(k + 1)) = gcd(M, N)
                   calculation
                     gcd(a(k + 1), b(k + 1)) = gcd(a(k), b(k + 1))    3.10.6
                                             = gcd(a(k), 0)           3.10.7
                                             = gcd(a(k), b(k))        3.10.8
                                             = gcd(M, N)              IH

          3.10.10. b(k + 1) + (k + 1) ≤ N or b(k + 1) = 0
                   mun:or-right, from 3.10.2

          3.10.11. a(k + 1) ∈ ℕ₀ and b(k + 1) ∈ ℕ₀
                   and gcd(a(k + 1), b(k + 1)) = gcd(M, N)
                   and (b(k + 1) + (k + 1) ≤ N or b(k + 1) = 0)
                   join 3.10.3, 3.10.5, 3.10.9, 3.10.10

          case
          assume b(k) ≠ 0                                             (C2)

          3.10.12. a(k + 1) = b(k)
                   D1, from C2

          3.10.13. b(k + 1) = a(k) mod b(k)
                   D1, from C2

          3.10.14. a(k) mod b(k) ∈ ℕ₀
                   mun:mod-natural
                   requires b(k) ∈ ℕ: mun:nat0-nonzero, from IH, C2
                   requires a(k) ∈ ℤ: mun:nat0-int, from IH

          3.10.15. a(k + 1) ∈ ℕ₀
                   substitute a(k + 1) = b(k) (line 3.10.12) into IH

          3.10.16. b(k + 1) ∈ ℕ₀
                   substitute b(k + 1) = a(k) mod b(k) (line 3.10.13) into line 3.10.14

          3.10.17. gcd(a(k) mod b(k), b(k)) = gcd(a(k), b(k))
                   thm:gcd-mod
                   requires b(k) ∈ ℕ: mun:nat0-nonzero, from IH, C2
                   requires a(k) ∈ ℤ: mun:nat0-int, from IH

          3.10.18. gcd(b(k), a(k) mod b(k)) = gcd(a(k) mod b(k), b(k))
                   mun:gcd-commutes
                   requires b(k) ∈ ℤ: mun:nat0-int, from IH
                   requires a(k) mod b(k) ∈ ℤ: mun:nat0-int, from 3.10.14

          3.10.19. gcd(a(k + 1), b(k + 1)) = gcd(b(k), b(k + 1))
                   substitute a(k + 1) = b(k) (line 3.10.12)

          3.10.20. gcd(b(k), b(k + 1)) = gcd(b(k), a(k) mod b(k))
                   substitute b(k + 1) = a(k) mod b(k) (line 3.10.13)

          3.10.21. gcd(a(k + 1), b(k + 1)) = gcd(M, N)
                   calculation
                     gcd(a(k + 1), b(k + 1)) = gcd(b(k), b(k + 1))         3.10.19
                                             = gcd(b(k), a(k) mod b(k))    3.10.20
                                             = gcd(a(k) mod b(k), b(k))    3.10.18
                                             = gcd(a(k), b(k))             3.10.17
                                             = gcd(M, N)                   IH

          3.10.22. b(k) + k ≤ N
                   mun:disjunctive-syllogism, from IH, C2

          3.10.23. a(k) mod b(k) < b(k)
                   mun:mod-less
                   requires b(k) ∈ ℕ: mun:nat0-nonzero, from IH, C2
                   requires a(k) ∈ ℤ: mun:nat0-int, from IH

          3.10.24. b(k + 1) < b(k)
                   substitute b(k + 1) = a(k) mod b(k) (line 3.10.13) into line 3.10.23

          3.10.25. b(k + 1) + 1 ≤ b(k)
                   mun:integer-step, from 3.10.24
                   requires b(k + 1) ∈ ℤ: mun:nat0-int, from 3.10.16
                   requires b(k) ∈ ℤ: mun:nat0-int, from IH

          3.10.26. b(k + 1) + (k + 1) ≤ N
                   inequalities, from 3.10.25, 3.10.22
                   requires b(k + 1) ∈ ℝ: mun:nat0-real, from 3.10.16
                   requires b(k) ∈ ℝ: mun:nat0-real, from IH

          3.10.27. b(k + 1) + (k + 1) ≤ N or b(k + 1) = 0
                   mun:or-left, from 3.10.26

          3.10.28. a(k + 1) ∈ ℕ₀ and b(k + 1) ∈ ℕ₀
                   and gcd(a(k + 1), b(k + 1)) = gcd(M, N)
                   and (b(k + 1) + (k + 1) ≤ N or b(k + 1) = 0)
                   join 3.10.15, 3.10.16, 3.10.21, 3.10.27

4.  a(N) ∈ ℕ₀ and b(N) ∈ ℕ₀ and gcd(a(N), b(N)) = gcd(M, N)
    and (b(N) + N ≤ N or b(N) = 0)
    instantiate k := N in line 3

5.  b(N) = 0 or b(N) ≠ 0
    mun:excluded-middle P := b(N) = 0

6.  b(N) = 0
    cases, from 5

    case
    assume b(N) = 0, which is the claim                               (C3)

    case
    assume b(N) ≠ 0                                                   (C4)

    6.1.  b(N) + N ≤ N
          mun:disjunctive-syllogism, from 4, C4

    6.2.  b(N) ∈ ℕ
          mun:nat0-nonzero, from 4, C4

    6.3.  not b(N) + N ≤ N
          inequalities, from 6.2, contradicting 6.1

7.  gcd(a(N), 0) = a(N)
    mun:gcd-zero, from 4

8.  gcd(a(N), 0) = gcd(a(N), b(N))
    substitute b(N) = 0 (line 6)

9.  a(N) = gcd(M, N)
    calculation
      a(N) = gcd(a(N), 0)          7
           = gcd(a(N), b(N))       8
           = gcd(M, N)             4
