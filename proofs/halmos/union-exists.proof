import axiom              stdlib/sets/extensionality
import axiom              stdlib/sets/pairing
import axiom              stdlib/sets/unions
import mundane definition stdlib/sets/union
import mundane definition stdlib/sets/pair
import mundane definition stdlib/sets/indexed-union
import mundane theorem    stdlib/sets/in-union-left
import mundane theorem    stdlib/sets/in-union-right

theorem union-exists
  note        What is in one set or another makes a collection that
              exists: the pair {A, B} exists by pairing, the union of its
              members exists by the axiom of unions, and that union has the
              members A ∪ B has, so by extensionality the two are one.
              Halmos, Naive Set Theory, section 4.
  let A be a set                                                      (H1)
  let B be a set                                                      (H2)
  then A ∪ B exists

1.  {A, B} exists
    axi:pairing a := A, b := B

2.  ⋃(X ∈ {A, B}) X exists
    axi:unions C := {A, B}, from 1

3.  For all x ∈ ⋃(X ∈ {A, B}) X, x ∈ A ∪ B.
    proof
    let x ∈ ⋃(X ∈ {A, B}) X                                           (K1)

    3.1.  there is X ∈ {A, B} with x ∈ X
          mun:indexed-union u := x, D := {A, B}, from K1

    3.2.  X ∈ {A, B}. x ∈ X.
          obtain X from line 3.1

    3.3.  X = A or X = B
          mun:pair x := X, u := A, w := B, from 3.2

    3.4.  x ∈ A ∪ B
          cases, from 3.3

          case
          assume X = A                                                (C1)

          3.4.1.  x ∈ A
                  substitute X = A (C1) into line 3.2

          3.4.2.  x ∈ A ∪ B
                  mun:in-union-left u := x, Y := A, Z := B, from 3.4.1

          case
          assume X = B                                                (C2)

          3.4.3.  x ∈ B
                  substitute X = B (C2) into line 3.2

          3.4.4.  x ∈ A ∪ B
                  mun:in-union-right u := x, Y := A, Z := B, from 3.4.3

4.  For all x ∈ A ∪ B, x ∈ ⋃(X ∈ {A, B}) X.
    proof
    let x ∈ A ∪ B                                                     (K2)

    4.1.  x ∈ A or x ∈ B
          mun:union u := x, Y := A, Z := B, from K2

    4.2.  x ∈ ⋃(X ∈ {A, B}) X
          cases, from 4.1

          case
          assume x ∈ A                                                (C3)

          4.2.1.  A ∈ {A, B}
                  inspection

          4.2.2.  there is X ∈ {A, B} with x ∈ X
                  exhibit, from C3, 4.2.1

          4.2.3.  x ∈ ⋃(X ∈ {A, B}) X
                  mun:indexed-union u := x, D := {A, B}, from 4.2.2

          case
          assume x ∈ B                                                (C4)

          4.2.4.  B ∈ {A, B}
                  inspection

          4.2.5.  there is X ∈ {A, B} with x ∈ X
                  exhibit, from C4, 4.2.4

          4.2.6.  x ∈ ⋃(X ∈ {A, B}) X
                  mun:indexed-union u := x, D := {A, B}, from 4.2.5

5.  ⋃(X ∈ {A, B}) X = A ∪ B
    axi:extensionality X := ⋃(X ∈ {A, B}) X, Y := A ∪ B, from 3, 4

6.  A ∪ B exists
    substitute ⋃(X ∈ {A, B}) X = A ∪ B (line 5) into line 2
