import axiom              stdlib/sets/extensionality
import axiom              stdlib/sets/separation
import mundane definition stdlib/sets/intersection
import mundane definition stdlib/sets/set-builder

theorem intersection-exists
  note        What two sets share makes a collection that exists, where one
              of them exists: it is the members of A that are in B, which
              exist by the axiom of separation, and the two have the same
              members, so by extensionality they are one. Halmos, Naive Set
              Theory, section 4.
  let A be a set                                                      (H1)
  assume A exists                                                     (H2)
  let B be a set                                                      (H3)
  then A ∩ B exists

1.  For all x ∈ {t ∈ A : t ∈ B}, x ∈ A ∩ B.
    proof
    let x ∈ {t ∈ A : t ∈ B}                                           (K1)

    1.1.  x ∈ A and x ∈ B
          mun:set-builder X := A, from K1

    1.2.  x ∈ A ∩ B
          mun:intersection Y := A, Z := B, from 1.1

2.  For all x ∈ A ∩ B, x ∈ {t ∈ A : t ∈ B}.
    proof
    let x ∈ A ∩ B                                                     (K2)

    2.1.  x ∈ A and x ∈ B
          mun:intersection Y := A, Z := B, from K2

    2.2.  x ∈ {t ∈ A : t ∈ B}
          mun:set-builder X := A, from 2.1

3.  {t ∈ A : t ∈ B} = A ∩ B
    axi:extensionality X := {t ∈ A : t ∈ B}, Y := A ∩ B, from 1, 2

4.  {t ∈ A : t ∈ B} exists
    axi:separation X := A, from H2

5.  A ∩ B exists
    substitute {t ∈ A : t ∈ B} = A ∩ B (line 3) into line 4
