import theorem            stdlib/numbers/archimedean-natural
import theorem            stdlib/calculus/convergent-bounded
import mundane theorem    stdlib/sums/sum-split
import mundane theorem    stdlib/sums/sum-le
import mundane theorem    stdlib/sums/sum-constant
import mundane theorem    stdlib/sums/sum-single
import mundane theorem    stdlib/sums/sum-real
import mundane theorem    stdlib/sums/range-bounds
import mundane theorem    stdlib/numbers/exponent-step
import mundane theorem    stdlib/numbers/exponent-zero
import mundane theorem    stdlib/numbers/power-nat
import mundane theorem    stdlib/numbers/reciprocal-order

theorem harmonic-block
  note        Doubling the number of terms from 2^j to 2^(j + 1) adds 2^j
              terms, each at least 1/2^(j + 1), so the sum grows by at
              least 1/2.
  let j ∈ ℕ₀                                                          (H1)
  then Σ(k = 1 to 2^(j + 1)) 1/k ≥ Σ(k = 1 to 2^j) 1/k + 1/2

1.  2^(j + 1) = 2^j·2
    mun:exponent-step a := 2, m := j

2.  2^j ∈ ℕ
    mun:power-nat a := 2, m := j

3.  2^(j + 1) ∈ ℕ
    mun:power-nat a := 2, m := j + 1

4.  2^j ≤ 2^j·2
    inequalities, from 2

5.  2^j ≤ 2^(j + 1)
    transitivity, from 4, 1
    requires 2^j ∈ ℝ: membership, from H1
    requires 2^(j + 1) ∈ ℝ: membership, from H1

6.  For all k ∈ ℕ, 1/k ∈ ℝ.
    proof
    let k ∈ ℕ                                                         (K1)

    6.1.  1/k ∈ ℝ
          membership
          requires k ≠ 0: from K1

7.  Σ(k = 1 to 2^(j + 1)) 1/k = Σ(k = 1 to 2^j) 1/k + Σ(k = 2^j + 1 to 2^(j + 1)) 1/k
    mun:sum-split a := 1, b := 2^j, c := 2^(j + 1), from 5, 6
    requires 2^j ∈ ℤ: membership, from H1
    requires 2^(j + 1) ∈ ℤ: membership, from H1
    requires 1 ≤ 2^j + 1: inequalities, from 2

8.  0 < 2^j + 1
    inequalities, from 2

9.  For all k ∈ {2^j + 1, …, 2^(j + 1)}, 1/2^(j + 1) ≤ 1/k.
    proof
    let k ∈ {2^j + 1, …, 2^(j + 1)}                                   (K2)

    9.1.  2^j + 1 ≤ k. k ≤ 2^(j + 1).
          mun:range-bounds a := 2^j + 1, b := 2^(j + 1), from K2
          requires 2^j + 1 ∈ ℤ: membership, from H1
          requires 2^(j + 1) ∈ ℤ: membership, from H1

    9.2.  k > 0
          transitivity, from 8, 9.1
          requires 2^j ∈ ℝ: membership, from H1

    9.3.  1/2^(j + 1) ≤ 1/k
          mun:reciprocal-order x := k, y := 2^(j + 1), from 9.1
          requires 2^(j + 1) ∈ ℤ: membership, from H1
          requires k > 0: from 9.2
          requires 2^(j + 1) > 0: inequalities, from 3

10. For all k ∈ {2^j + 1, …, 2^(j + 1)}, 1/k ∈ ℝ.
    proof
    let k ∈ {2^j + 1, …, 2^(j + 1)}                                   (K3)

    10.1. 2^j + 1 ≤ k. k ≤ 2^(j + 1).
          mun:range-bounds a := 2^j + 1, b := 2^(j + 1), from K3
          requires 2^j + 1 ∈ ℤ: membership, from H1
          requires 2^(j + 1) ∈ ℤ: membership, from H1

    10.2. k > 0
          transitivity, from 8, 10.1
          requires 2^j ∈ ℝ: membership, from H1

    10.3. 1/k ∈ ℝ
          membership
          requires k ≠ 0: weakening, from 10.2

11. Σ(k = 2^j + 1 to 2^(j + 1)) 1/2^(j + 1) ≤ Σ(k = 2^j + 1 to 2^(j + 1)) 1/k
    mun:sum-le a := 2^j + 1, b := 2^(j + 1), from 9
    requires 2^j + 1 ∈ ℤ: membership, from H1
    requires 2^(j + 1) ∈ ℤ: membership, from H1
    requires for all k ∈ {2^j + 1, …, 2^(j + 1)}, 1/k ∈ ℝ: from 10

12. 2^j + 1 ≤ 2^j·2
    inequalities, from 2

13. 2^j + 1 ≤ 2^(j + 1)
    transitivity, from 12, 1
    requires 2^j ∈ ℝ: membership, from H1
    requires 2^(j + 1) ∈ ℝ: membership, from H1

14. Σ(k = 2^j + 1 to 2^(j + 1)) 1/2^(j + 1) = (2^(j + 1) − (2^j + 1) + 1)·(1/2^(j + 1))
    mun:sum-constant a := 2^j + 1, b := 2^(j + 1), c := 1/2^(j + 1)
    requires 2^j + 1 ∈ ℤ: membership, from H1
    requires 2^(j + 1) ∈ ℤ: membership, from H1
    requires 2^j + 1 ≤ 2^(j + 1): from 13
    requires 2^(j + 1) ≠ 0: inequalities, from 3
    requires 1/2^(j + 1) ∈ ℝ: membership, from H1

15. (2^(j + 1) − (2^j + 1) + 1)·(1/2^(j + 1)) = (2^j·2 − (2^j + 1) + 1)·(1/(2^j·2))
    substitute 2^(j + 1) = 2^j·2 (line 1)

16. (2^j·2 − (2^j + 1) + 1)·(1/(2^j·2)) = 1/2
    algebra
    requires 2^j ≠ 0: inequalities, from 2

17. (2^(j + 1) − (2^j + 1) + 1)·(1/2^(j + 1)) = 1/2
    calculation
      (2^(j + 1) − (2^j + 1) + 1)·(1/2^(j + 1)) = (2^j·2 − (2^j + 1) + 1)·(1/(2^j·2))    15
                                                 = 1/2                                    16

18. 1/2 ≤ Σ(k = 2^j + 1 to 2^(j + 1)) 1/k
    transitivity, from 17, 14, 11
    requires 2^j ∈ ℝ: membership, from H1
    requires 2^(j + 1) ≠ 0: inequalities, from 3
    requires 2^j + 1 ∈ ℤ: membership, from H1
    requires 2^(j + 1) ∈ ℤ: membership, from H1
    requires for all k ∈ {2^j + 1, …, 2^(j + 1)}, 1/k ∈ ℝ: from 10
    requires Σ(k = 2^j + 1 to 2^(j + 1)) 1/k ∈ ℝ: mun:sum-real a := 2^j + 1, b := 2^(j + 1)
    requires Σ(k = 2^j + 1 to 2^(j + 1)) 1/2^(j + 1) ∈ ℝ: membership, from H1

19. Σ(k = 1 to 2^j) 1/k + 1/2 ≤ Σ(k = 1 to 2^j) 1/k + Σ(k = 2^j + 1 to 2^(j + 1)) 1/k
    inequalities
      1/2 ≤ Σ(k = 2^j + 1 to 2^(j + 1)) 1/k                                          18
      Σ(k = 1 to 2^j) 1/k + 1/2 ≤ Σ(k = 1 to 2^j) 1/k + Σ(k = 2^j + 1 to 2^(j + 1)) 1/k   adding Σ(k = 1 to 2^j) 1/k
    requires Σ(k = 1 to 2^j) 1/k ∈ ℝ: membership, from 6
    requires 2^j + 1 ∈ ℤ: membership, from H1
    requires 2^(j + 1) ∈ ℤ: membership, from H1
    requires for all k ∈ {2^j + 1, …, 2^(j + 1)}, 1/k ∈ ℝ: from 10
    requires Σ(k = 2^j + 1 to 2^(j + 1)) 1/k ∈ ℝ: mun:sum-real a := 2^j + 1, b := 2^(j + 1)

20. Σ(k = 1 to 2^(j + 1)) 1/k ≥ Σ(k = 1 to 2^j) 1/k + 1/2
    transitivity, from 19, 7
    requires Σ(k = 1 to 2^(j + 1)) 1/k ∈ ℝ: membership, from 6
    requires Σ(k = 1 to 2^j) 1/k ∈ ℝ: membership, from 6
    requires 2^j + 1 ∈ ℤ: membership, from H1
    requires 2^(j + 1) ∈ ℤ: membership, from H1
    requires for all k ∈ {2^j + 1, …, 2^(j + 1)}, 1/k ∈ ℝ: from 10
    requires Σ(k = 2^j + 1 to 2^(j + 1)) 1/k ∈ ℝ: mun:sum-real a := 2^j + 1, b := 2^(j + 1)


theorem harmonic-unbounded
  note        Each doubling of the terms adds at least 1/2 (harmonic-block), so
              the first 2^m terms add up to at least m/2. Taking N above 2M,
              the first 2^N terms add up to more than M.
  let M ∈ ℝ                                                           (H1)
  then there is n ∈ ℕ with Σ(k = 1 to n) 1/k > M

1.  For all k ∈ ℕ, 1/k ∈ ℝ.
    proof
    let k ∈ ℕ                                                         (K1)

    1.1.  1/k ∈ ℝ
          membership
          requires k ≠ 0: from K1

2.  For all m ∈ ℕ₀, Σ(k = 1 to 2^m) 1/k ≥ m/2.
    induction on m starting at 0

    base
    2.1.  2^0 = 1
          mun:exponent-zero a := 2

    2.2.  Σ(k = 1 to 2^0) 1/k = Σ(k = 1 to 1) 1/k
          substitute 2^0 = 1 (line 2.1)

    2.3.  Σ(k = 1 to 1) 1/k = 1
          mun:sum-single a := 1, from 1

    2.4.  Σ(k = 1 to 2^0) 1/k = 1
          calculation
            Σ(k = 1 to 2^0) 1/k = Σ(k = 1 to 1) 1/k     2.2
                                = 1                     2.3

    2.5.  1 ≥ 0/2
          arithmetic

    2.6.  Σ(k = 1 to 2^0) 1/k ≥ 0/2
          transitivity, from 2.4, 2.5
          requires Σ(k = 1 to 2^0) 1/k ∈ ℝ: membership, from 1

    step
    let m ∈ ℕ₀                                                        (K)
    assume step 2 is true for m, the induction hypothesis             (IH)

    2.7.  Σ(k = 1 to 2^(m + 1)) 1/k ≥ Σ(k = 1 to 2^m) 1/k + 1/2
          thm:harmonic-block j := m

    2.8.  Σ(k = 1 to 2^m) 1/k + 1/2 ≥ (m + 1)/2
          inequalities
            Σ(k = 1 to 2^m) 1/k ≥ m/2                  IH
            Σ(k = 1 to 2^m) 1/k + 1/2 ≥ (m + 1)/2      adding 1/2
          requires Σ(k = 1 to 2^m) 1/k ∈ ℝ: membership, from 1

    2.9.  Σ(k = 1 to 2^(m + 1)) 1/k ≥ (m + 1)/2
          transitivity, from 2.7, 2.8
          requires Σ(k = 1 to 2^(m + 1)) 1/k ∈ ℝ: membership, from 1
          requires Σ(k = 1 to 2^m) 1/k ∈ ℝ: membership, from 1

3.  N ∈ ℕ. N > 2M.
    obtain N: thm:archimedean-natural x := 2M

4.  Σ(k = 1 to 2^N) 1/k ≥ N/2
    instantiate m := N in line 2

5.  N/2 > M
    inequalities
      N > 2M           3
      N/2 > M          multiplying by 1/2

6.  Σ(k = 1 to 2^N) 1/k > M
    transitivity, from 4, 5
    requires Σ(k = 1 to 2^N) 1/k ∈ ℝ: membership, from 1

7.  2^N ∈ ℕ
    mun:power-nat a := 2, m := N

8.  There is n ∈ ℕ with Σ(k = 1 to n) 1/k > M.
    exhibit, from 6, 7


theorem harmonic
  metamath    harmonic
  note        A sum with a limit is bounded, and the harmonic sums are not:
              harmonic-unbounded passes any bound B.
  then there is no L ∈ ℝ with Σ(k = 1 to n) 1/k → L as n → ∞

1.  For all k ∈ ℕ, 1/k ∈ ℝ.
    proof
    let k ∈ ℕ                                                         (K1)

    1.1.  1/k ∈ ℝ
          membership
          requires k ≠ 0: from K1

2.  There is no L ∈ ℝ with Σ(k = 1 to n) 1/k → L as n → ∞.
    contradiction
    suppose there is L ∈ ℝ with Σ(k = 1 to n) 1/k → L as n → ∞       (S)

    2.1.  L ∈ ℝ. Σ(k = 1 to n) 1/k → L as n → ∞.
          obtain L from S

    2.2.  B ∈ ℝ. For all m ∈ ℕ, Σ(k = 1 to m) 1/k ≤ B.
          obtain B: thm:convergent-bounded, from 1, 2.1

    2.3.  N ∈ ℕ. Σ(k = 1 to N) 1/k > B.
          obtain N: thm:harmonic-unbounded M := B

    2.4.  Σ(k = 1 to N) 1/k ≤ B
          instantiate m := N in line 2.2

    2.5.  not Σ(k = 1 to N) 1/k > B
          inequalities, from 2.4, contradicting 2.3
          requires Σ(k = 1 to N) 1/k ∈ ℝ: membership, from 1
