import theorem            stdlib/geometry/area-by-sine
import mundane theorem    stdlib/geometry/area-positive
import mundane theorem    stdlib/geometry/area-real
import mundane theorem    stdlib/geometry/distance-symmetric
import theorem            stdlib/geometry/law-of-cosines
import mundane definition stdlib/geometry/triangle
import mundane theorem    stdlib/geometry/triangle-angle-real
import mundane definition stdlib/numbers/sqrt
import mundane theorem    stdlib/numbers/square-equal
import mundane theorem    stdlib/numbers/square-nonneg
import mundane definition stdlib/trigonometry/cos
import mundane theorem    stdlib/trigonometry/cos-real
import mundane definition stdlib/trigonometry/sin
import mundane theorem    stdlib/trigonometry/sin-cos-squares
import mundane theorem    stdlib/trigonometry/sin-real

theorem heron
  note        The area is half of two sides times the sine of the angle
              between them, and the law of cosines gives that angle's cosine
              from the three sides; sin² + cos² = 1 then leaves the area in
              the sides alone, and the polynomial they give factors as
              16·s·(s − |BC|)·(s − |CA|)·(s − |AB|).
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  assume A, B, C form a triangle                                      (H4)
  let s = (|BC| + |CA| + |AB|)/2                                      (D1)
      reads half the perimeter of the triangle
  then the area of △ABC = √(s·(s − |BC|)·(s − |CA|)·(s − |AB|))

1.  B ≠ C
    mun:triangle P := A, Q := B, R := C, from H4

2.  A ≠ C
    mun:triangle P := A, Q := B, R := C, from H4

3.  ∠BCA ∈ ℝ
    mun:triangle-angle-real P := A, Q := B, R := C, from H4

4.  the area of △ABC = (1/2)·(|BC|·|AC|)·sin(∠BCA)
    thm:area-by-sine P := A, Q := B, R := C, from 1, 2

5.  |AB|² = |BC|² + |CA|² − 2·(|BC|·|CA|·cos(∠BCA))
    thm:law-of-cosines P := B, Q := C, R := A, from 1, 2

6.  |CA| = |AC|
    mun:distance-symmetric P := C, Q := A

7.  |AB|² = |BC|² + |AC|² − 2·(|BC|·|AC|·cos(∠BCA))
    substitute |CA| = |AC| (line 6) into line 5

8.  2·(|BC|·|AC|·cos(∠BCA)) = |BC|² + |AC|² − |AB|²
    algebra, from 7
    requires cos(∠BCA) ∈ ℝ: mun:cos-real a := ∠BCA, from 3

9.  sin(∠BCA)² + cos(∠BCA)² = 1
    mun:sin-cos-squares a := ∠BCA
    requires ∠BCA ∈ ℂ: membership, from 3

10. sin(∠BCA)² = 1 − cos(∠BCA)²
    algebra, from 9
    requires sin(∠BCA) ∈ ℝ: mun:sin-real a := ∠BCA, from 3
    requires cos(∠BCA) ∈ ℝ: mun:cos-real a := ∠BCA, from 3

11. (the area of △ABC)² = ((1/2)·(|BC|·|AC|)·sin(∠BCA))²
    substitute the area of △ABC = (1/2)·(|BC|·|AC|)·sin(∠BCA) (line 4)

12. ((1/2)·(|BC|·|AC|)·sin(∠BCA))² = (|BC|·|AC|)²·sin(∠BCA)²/4
    algebra
    requires sin(∠BCA) ∈ ℝ: mun:sin-real a := ∠BCA, from 3

13. (|BC|·|AC|)²·sin(∠BCA)²/4 = (|BC|·|AC|)²·(1 − cos(∠BCA)²)/4
    substitute sin(∠BCA)² = 1 − cos(∠BCA)² (line 10)

14. (|BC|·|AC|)²·(1 − cos(∠BCA)²)/4 = (4·(|BC|·|AC|)² − (2·(|BC|·|AC|·cos(∠BCA)))²)/16
    algebra
    requires cos(∠BCA) ∈ ℝ: mun:cos-real a := ∠BCA, from 3

15. (4·(|BC|·|AC|)² − (2·(|BC|·|AC|·cos(∠BCA)))²)/16 = (4·(|BC|·|AC|)² − (|BC|² + |AC|² − |AB|²)²)/16
    substitute 2·(|BC|·|AC|·cos(∠BCA)) = |BC|² + |AC|² − |AB|² (line 8)

16. s·(s − |BC|)·(s − |CA|)·(s − |AB|) = (4·(|BC|·|AC|)² − (|BC|² + |AC|² − |AB|²)²)/16
    algebra, from D1, 6

17. (the area of △ABC)² = s·(s − |BC|)·(s − |CA|)·(s − |AB|)
    calculation
      (the area of △ABC)² = ((1/2)·(|BC|·|AC|)·sin(∠BCA))²                                  11
                          = (|BC|·|AC|)²·sin(∠BCA)²/4                                       12
                          = (|BC|·|AC|)²·(1 − cos(∠BCA)²)/4                                 13
                          = (4·(|BC|·|AC|)² − (2·(|BC|·|AC|·cos(∠BCA)))²)/16                14
                          = (4·(|BC|·|AC|)² − (|BC|² + |AC|² − |AB|²)²)/16                  15
                          = s·(s − |BC|)·(s − |CA|)·(s − |AB|)                              16

18. the area of △ABC ∈ ℝ
    mun:area-real P := A, Q := B, R := C, from 1, 2

19. the area of △ABC > 0
    mun:area-positive P := A, Q := B, R := C, from H4

20. (the area of △ABC)² ≥ 0
    mun:square-nonneg x := the area of △ABC, from 18

21. s·(s − |BC|)·(s − |CA|)·(s − |AB|) ≥ 0
    substitute (the area of △ABC)² = s·(s − |BC|)·(s − |CA|)·(s − |AB|) (line 17) into line 20

22. √(s·(s − |BC|)·(s − |CA|)·(s − |AB|)) ∈ ℝ.
    √(s·(s − |BC|)·(s − |CA|)·(s − |AB|)) ≥ 0.
    (√(s·(s − |BC|)·(s − |CA|)·(s − |AB|)))² = s·(s − |BC|)·(s − |CA|)·(s − |AB|).
    mun:sqrt x := s·(s − |BC|)·(s − |CA|)·(s − |AB|), from 21
    requires s·(s − |BC|)·(s − |CA|)·(s − |AB|) ∈ ℝ: membership, from D1

23. (the area of △ABC)² = (√(s·(s − |BC|)·(s − |CA|)·(s − |AB|)))²
    calculation
      (the area of △ABC)² = s·(s − |BC|)·(s − |CA|)·(s − |AB|)                              17
                          = (√(s·(s − |BC|)·(s − |CA|)·(s − |AB|)))²                         22

24. the area of △ABC = √(s·(s − |BC|)·(s − |CA|)·(s − |AB|))
    mun:square-equal x := the area of △ABC, y := √(s·(s − |BC|)·(s − |CA|)·(s − |AB|)), from 22, 23
    requires the area of △ABC ∈ ℝ: from 18
    requires the area of △ABC ≥ 0: weakening, from 19
