import theorem            stdlib/geometry/area-by-sine
import axiom              stdlib/geometry/area-positive
import mundane theorem    stdlib/geometry/area-real
import theorem            stdlib/geometry/law-of-cosines
import mundane theorem    stdlib/geometry/triangle-angle-real
import definition         stdlib/numbers/sqrt
import mundane theorem    stdlib/numbers/square-equal
import mundane theorem    stdlib/numbers/square-nonneg
import definition         stdlib/trigonometry/cos
import mundane theorem    stdlib/trigonometry/cos-real
import definition         stdlib/trigonometry/sin
import mundane theorem    stdlib/trigonometry/sin-cos-squares
import mundane theorem    stdlib/trigonometry/sin-real

theorem heron
  note        The area is half of two sides times the sine of the angle
              between them, and the law of cosines gives that angle's cosine
              from the three sides; sin² + cos² = 1 then leaves the area in
              the sides alone, and the polynomial they give factors as
              16·s·(s − |BC|)·(s − |CA|)·(s − |AB|).
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  assume A, B, C form a triangle                                      (H4)
  let s = (|BC| + |CA| + |AB|)/2                                      (D1)
      reads half the perimeter of the triangle
  then the area of △ABC = √(s·(s − |BC|)·(s − |CA|)·(s − |AB|))

1.  ∠BCA ∈ ℝ
    mun:triangle-angle-real P := A, Q := B, R := C, from H4

2.  the area of △ABC = (1/2)·(|BC|·|AC|)·sin(∠BCA)
    thm:area-by-sine P := A, Q := B, R := C, from H4

3.  |AB|² = |BC|² + |CA|² − 2·(|BC|·|CA|·cos(∠BCA))
    thm:law-of-cosines P := B, Q := C, R := A, from H4

4.  2·(|BC|·|AC|·cos(∠BCA)) = |BC|² + |AC|² − |AB|²
    algebra, from 3
    requires cos(∠BCA) ∈ ℝ: mun:cos-real a := ∠BCA, from 1

5.  sin(∠BCA)² + cos(∠BCA)² = 1
    mun:sin-cos-squares a := ∠BCA
    requires ∠BCA ∈ ℂ: membership, from 1

6.  sin(∠BCA)² = 1 − cos(∠BCA)²
    algebra, from 5
    requires sin(∠BCA) ∈ ℝ: mun:sin-real a := ∠BCA, from 1
    requires cos(∠BCA) ∈ ℝ: mun:cos-real a := ∠BCA, from 1

7.  (the area of △ABC)² = s·(s − |BC|)·(s − |CA|)·(s − |AB|)
    calculation
      (the area of △ABC)² = ((1/2)·(|BC|·|AC|)·sin(∠BCA))²                                  substitute line 2
                          = (|BC|·|AC|)²·sin(∠BCA)²/4                                       algebra
                          = (|BC|·|AC|)²·(1 − cos(∠BCA)²)/4                                 substitute line 6
                          = (4·(|BC|·|AC|)² − (2·(|BC|·|AC|·cos(∠BCA)))²)/16                algebra
                          = (4·(|BC|·|AC|)² − (|BC|² + |AC|² − |AB|²)²)/16                  substitute line 4
                          = s·(s − |BC|)·(s − |CA|)·(s − |AB|)                              algebra, from D1
    requires sin(∠BCA) ∈ ℝ: mun:sin-real a := ∠BCA, from 1
    requires cos(∠BCA) ∈ ℝ: mun:cos-real a := ∠BCA, from 1

8.  the area of △ABC ∈ ℝ
    mun:area-real P := A, Q := B, R := C, from H4

9.  the area of △ABC > 0
    axi:area-positive P := A, Q := B, R := C, from H4

10. (the area of △ABC)² ≥ 0
    mun:square-nonneg x := the area of △ABC, from 8

11. s·(s − |BC|)·(s − |CA|)·(s − |AB|) ≥ 0
    substitute (the area of △ABC)² = s·(s − |BC|)·(s − |CA|)·(s − |AB|) (line 7) into line 10

12. √(s·(s − |BC|)·(s − |CA|)·(s − |AB|)) ∈ ℝ.
    √(s·(s − |BC|)·(s − |CA|)·(s − |AB|)) ≥ 0.
    (√(s·(s − |BC|)·(s − |CA|)·(s − |AB|)))² = s·(s − |BC|)·(s − |CA|)·(s − |AB|).
    def:sqrt x := s·(s − |BC|)·(s − |CA|)·(s − |AB|), from 11
    requires s·(s − |BC|)·(s − |CA|)·(s − |AB|) ∈ ℝ: membership, from D1

13. (the area of △ABC)² = (√(s·(s − |BC|)·(s − |CA|)·(s − |AB|)))²
    calculation
      (the area of △ABC)² = s·(s − |BC|)·(s − |CA|)·(s − |AB|)                              7
                          = (√(s·(s − |BC|)·(s − |CA|)·(s − |AB|)))²                         12

14. the area of △ABC = √(s·(s − |BC|)·(s − |CA|)·(s − |AB|))
    mun:square-equal x := the area of △ABC, y := √(s·(s − |BC|)·(s − |CA|)·(s − |AB|)), from 12, 13
    requires the area of △ABC ∈ ℝ: from 8
    requires the area of △ABC ≥ 0: weakening, from 9
