import axiom              stdlib/calculus/completeness
import theorem            proofs/wiedijk/triangle-inequality/abs-bounds
import mundane definition stdlib/calculus/interval
import mundane theorem    stdlib/calculus/interval-real
import mundane definition stdlib/calculus/least-upper-bound
import mundane definition stdlib/calculus/upper-bound
import mundane theorem    stdlib/numbers/abs-difference-lt
import mundane theorem    stdlib/numbers/abs-real
import mundane theorem    stdlib/numbers/lt-min
import mundane definition stdlib/numbers/min
import mundane theorem    stdlib/numbers/min-le
import mundane theorem    stdlib/numbers/min-real
import mundane theorem    stdlib/numbers/real-closure
import mundane axiom      stdlib/numbers/trichotomy
import mundane definition stdlib/sets/set-builder
import mundane theorem    stdlib/sets/set-builder-subset
import mundane theorem    stdlib/sets/subset-transitive
import definition         stdlib/calculus/continuous-on

theorem intermediate-value
  metamath    ivth, the general form
  note        Let c be the least upper bound of the points where f is below 0.
              If f(c) < 0, f stays below 0 a little to the right of c, so c is
              no upper bound. If f(c) > 0, f stays above 0 a little to the
              left of c, so a smaller number is an upper bound. So f(c) = 0.
  let a ∈ ℝ                                                           (H1)
  let b ∈ ℝ                                                           (H2)
  assume a < b                                                        (H3)
  let f : [a, b] → ℝ                                                  (H4)
  assume f is continuous on [a, b]                                    (H5)
  assume f(a) < 0                                                     (H6)
  assume 0 < f(b)                                                     (H7)
  ε, δ range over ℝ
  then there exists c ∈ [a, b] such that f(c) = 0

let S = {x ∈ [a, b] : f(x) < 0}                                       (D1)
       reads the points of the interval where f is still below zero

1.  a ∈ [a, b]
    mun:interval x := a
    requires a ≤ a: inequalities
    requires a ≤ b: weakening, from H3

2.  a ∈ S
    mun:set-builder u := a, from D1, H6, 1

3.  S ⊆ [a, b]
    mun:set-builder-subset, from D1

4.  [a, b] ⊆ ℝ
    mun:interval-real

5.  S ⊆ ℝ
    mun:subset-transitive X := S, Y := [a, b], Z := ℝ, from 3, 4

6.  For all s ∈ S, s ≤ b.
    proof
    let s ∈ S                                                         (K1)

    6.1.  s ∈ [a, b]
          mun:set-builder, from D1, K1

    6.2.  s ≤ b
          mun:interval, from 6.1

7.  b is an upper bound of S
    mun:upper-bound, from 6

8.  c ∈ ℝ. c is a least upper bound of S.
    obtain c: axi:completeness, from 2, 5, 7

9.  c is an upper bound of S.
    For all u ∈ ℝ, if u is an upper bound of S then c ≤ u.
    mun:least-upper-bound, from 8

10. For all s ∈ S, s ≤ c.
    mun:upper-bound, from 9

11. a ≤ c
    instantiate s := a in line 10, from 2

12. c ≤ b
    instantiate u := b in line 9, from 7

13. c ∈ [a, b]
    mun:interval x := c, from 11, 12

14. f(c) < 0 or f(c) = 0 or 0 < f(c)
    mun:trichotomy x := f(c), from H4, 13

15. For all c′ ∈ [a, b], for all ε > 0, there exists δ > 0 such that
    |f(x) − f(c′)| < ε for all x ∈ [a, b] with |x − c′| < δ.
    def:continuous-on, from H5
    requires [a, b] ⊆ ℝ: mun:interval-real

16. f(c) = 0
    cases, from 14

    case
    note f stays below 0 at a point x₁ just right of c, so x₁ ∈ S and c is no bound
    assume f(c) < 0                                                   (C1)

    16.1.  c ≠ b
           contradiction
           suppose c = b                                              (S1)

           16.1.1.  f(b) < 0
                    substitute c = b (S1) into C1

           16.1.2.  b ∈ [a, b]
                    mun:interval x := b
                    requires a ≤ b: weakening, from H3
                    requires b ≤ b: inequalities

           16.1.3.  0 ≤ f(b)
                    inequalities
                      0 < f(b)          H7
                      0 ≤ f(b)          weakening
                    requires f(b) ∈ ℝ: from H4, 16.1.2

           16.1.4.  not f(b) < 0
                    inequalities, from 16.1.3, contradicting 16.1.1
                    requires f(b) ∈ ℝ: from H4, 16.1.2

    16.2.  c < b
           inequalities, from 12, 16.1

    16.3.  −f(c) > 0
           inequalities
             f(c) < 0          C1
             −f(c) > 0         multiplying by −1
           requires f(c) ∈ ℝ: from H4, 13

    16.4.  There exists δ > 0 such that
           |f(x) − f(c)| < −f(c) for all x ∈ [a, b] with |x − c| < δ.
           instantiate c′ := c, ε := −f(c) in line 15, from H4, 13, 16.3

    16.5.  δ ∈ ℝ. δ > 0.
           For all x ∈ [a, b], if |x − c| < δ then |f(x) − f(c)| < −f(c).
           obtain δ from line 16.4

    let x₁ = min(b, c + δ/2), a real number                            (D2)
           mun:min-real x := b, y := c + δ/2
           reads a point right of c, within δ of it, and not past b

    16.6.  δ/2 > 0
           inequalities
             δ > 0             16.5
             δ/2 > 0           multiplying by 1/2

    16.7.  c < c + δ/2
           inequalities
             δ/2 > 0           16.6
             c + δ/2 > c       adding c
             c < c + δ/2       symmetry

    16.8.  c < x₁
           mun:lt-min z := c, x := b, y := c + δ/2, from D2, 16.2, 16.7

    16.9.  x₁ ≤ b. x₁ ≤ c + δ/2.
           mun:min-le x := b, y := c + δ/2, from D2

    16.10. x₁ − c ≤ δ/2
           inequalities
             x₁ ≤ c + δ/2      16.9
             x₁ − c ≤ δ/2      adding −c

    16.11. δ/2 < δ
           inequalities
             δ/2 > 0           16.6
             δ > δ/2           adding δ/2
             δ/2 < δ           symmetry

    16.12. x₁ − c < δ
           transitivity, from 16.10, 16.11

    16.13. a < x₁
           transitivity, from 11, 16.8

    16.14. a ≤ x₁
           inequalities
             a < x₁            16.13
             a ≤ x₁            weakening

    16.15. x₁ ∈ [a, b]
           mun:interval x := x₁, from 16.9, 16.14

    16.16. c − δ < c
           inequalities
             δ > 0             16.5
             c > c − δ         adding c − δ
             c − δ < c         symmetry

    16.17. c − δ < x₁
           transitivity, from 16.16, 16.8

    16.18. x₁ < c + δ
           inequalities
             x₁ − c < δ        16.12
             x₁ < c + δ        adding c

    16.19. |x₁ − c| < δ
           mun:abs-difference-lt x := x₁, from 16.17, 16.18

    16.20. |f(x₁) − f(c)| < −f(c)
           instantiate x := x₁ in line 16.5, from 16.15, 16.19

    16.21. f(x₁) − f(c) ≤ |f(x₁) − f(c)|
           thm:abs-bounds x := f(x₁) − f(c)
           requires f(x₁) − f(c) ∈ ℝ: mun:real-closure, from H4, 13, 16.15

    16.22. f(x₁) − f(c) < −f(c)
           transitivity, from 16.21, 16.20
           requires f(x₁) ∈ ℝ: from H4, 16.15
           requires f(c) ∈ ℝ: from H4, 13
           requires |f(x₁) − f(c)| ∈ ℝ: mun:abs-real x := f(x₁) − f(c)

    16.23. f(x₁) < 0
           inequalities
             f(x₁) − f(c) < −f(c)      16.22
             f(x₁) < 0                 adding f(c)
           requires f(x₁) ∈ ℝ: from H4, 16.15
           requires f(c) ∈ ℝ: from H4, 13

    16.24. x₁ ∈ S
           mun:set-builder u := x₁, from D1, 16.15, 16.23

    16.25. x₁ ≤ c
           instantiate s := x₁ in line 10, from 16.24

    16.26. not x₁ ≤ c
           inequalities, from 16.8, contradicting 16.25

    case
    assume f(c) = 0, which is the claim                               (C2)

    case
    note f stays above 0 within δ of c, so c − δ is a bound below c
    assume 0 < f(c)                                                   (C3)

    16.27. There exists δ > 0 such that
           |f(x) − f(c)| < f(c) for all x ∈ [a, b] with |x − c| < δ.
           instantiate c′ := c, ε := f(c) in line 15, from C3, H4, 13

    16.28. δ ∈ ℝ. δ > 0.
           For all x ∈ [a, b], if |x − c| < δ then |f(x) − f(c)| < f(c).
           obtain δ from line 16.27

    16.29. For all s ∈ S, s ≤ c − δ.
           proof
           let s ∈ S                                                  (K2)

           16.29.1.  s ∈ [a, b]
                     mun:set-builder, from D1, K2

           16.29.2.  f(s) < 0
                     mun:set-builder, from D1, K2

           16.29.3.  s ≤ c
                     instantiate s := s in line 10, from K2

           16.29.4.  s ≤ c − δ
                     contradiction
                     suppose not s ≤ c − δ                            (S2)

                     16.29.4.1.  c − δ < s
                                 inequalities, from S2
                                 requires s ∈ ℝ: mun:interval, from 16.29.1

                     16.29.4.2.  s < c + δ
                                 inequalities, from 16.28, 16.29.3
                                 requires s ∈ ℝ: mun:interval, from 16.29.1

                     16.29.4.3.  |s − c| < δ
                                 mun:abs-difference-lt x := s,
                                   from 16.29.4.1, 16.29.4.2
                                 requires s ∈ ℝ: mun:interval, from 16.29.1

                     16.29.4.4.  |f(s) − f(c)| < f(c)
                                 instantiate x := s in line 16.28, from 16.29.1, 16.29.4.3

                     16.29.4.5.  −(f(s) − f(c)) ≤ |f(s) − f(c)|
                                 thm:abs-bounds x := f(s) − f(c)
                                 requires f(s) − f(c) ∈ ℝ: mun:real-closure, from H4, 13, 16.29.1

                     16.29.4.6.  −(f(s) − f(c)) < f(c)
                                 transitivity, from 16.29.4.5, 16.29.4.4
                                 requires f(s) ∈ ℝ: from H4, 16.29.1
                                 requires f(c) ∈ ℝ: from H4, 13
                                 requires |f(s) − f(c)| ∈ ℝ: mun:abs-real x := f(s) − f(c)

                     16.29.4.7.  0 ≤ f(s)
                                 inequalities
                                   −(f(s) − f(c)) < f(c)      16.29.4.6
                                   0 < f(s)                   adding f(s) − f(c)
                                   0 ≤ f(s)                   weakening
                                 requires f(s) ∈ ℝ: from H4, 16.29.1
                                 requires f(c) ∈ ℝ: from H4, 13

                     16.29.4.8.  not f(s) < 0
                                 inequalities, from 16.29.4.7, contradicting 16.29.2
                                 requires f(s) ∈ ℝ: from H4, 16.29.1

    16.30. c − δ is an upper bound of S
           mun:upper-bound, from 16.29

    16.31. c ≤ c − δ
           instantiate u := c − δ in line 9, from 16.30

    16.32. c − δ < c
           inequalities
             δ > 0             16.28
             c > c − δ         adding c − δ
             c − δ < c         symmetry

    16.33. not c ≤ c − δ
           inequalities, from 16.32, contradicting 16.31

17. There exists c ∈ [a, b] such that f(c) = 0.
    exhibit, from 13, 16
