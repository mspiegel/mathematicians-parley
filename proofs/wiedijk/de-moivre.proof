import theorem            stdlib/trigonometry/cos-add
import theorem            stdlib/trigonometry/sin-add
import mundane theorem    stdlib/numbers/exponent-step
import definition         stdlib/numbers/i
import mundane theorem    stdlib/numbers/i-complex
import definition         stdlib/trigonometry/cos
import definition         stdlib/trigonometry/sin

theorem de-moivre
  metamath    demoivre
  note        By induction on the power: multiplying cos(kx) + i·sin(kx) by
              cos(x) + i·sin(x), with i·i = −1 and the addition formulas for
              cos and sin, gives cos((k + 1)x) + i·sin((k + 1)x).
  let x ∈ ℝ                                                           (H1)
  let n ∈ ℕ₀                                                          (H2)
  then (cos(x) + i·sin(x))^n = cos(n·x) + i·sin(n·x)

1.  i·i = −1
    def:i

2.  For all k ∈ ℕ₀, (cos(x) + i·sin(x))^k = cos(k·x) + i·sin(k·x).
    induction on k starting at 0

    base
    2.1.  0·x = 0
          algebra

    2.2.  cos(0) + i·sin(0) = 1 + i·sin(0)
          substitute cos(0) = 1 (real arithmetic)

    2.3.  1 + i·sin(0) = 1 + i·0
          substitute sin(0) = 0 (real arithmetic)

    2.4.  (cos(x) + i·sin(x))^0 = cos(0·x) + i·sin(0·x)
          calculation
            (cos(x) + i·sin(x))^0 = 1                         algebra
                                  = 1 + i·0                   algebra
                                  = 1 + i·sin(0)              2.3
                                  = cos(0) + i·sin(0)         2.2
                                  = cos(0·x) + i·sin(0·x)     substitute line 2.1
          requires i ∈ ℂ: mun:i-complex

    step
    let k ∈ ℕ₀                                                        (K)
    assume step 2 is true for k, the induction hypothesis             (IH)

    2.5.  cos(k·x + x) = cos(k·x)·cos(x) − sin(k·x)·sin(x)
          thm:cos-add a := k·x, b := x

    2.6.  sin(k·x + x) = sin(k·x)·cos(x) + cos(k·x)·sin(x)
          thm:sin-add a := k·x, b := x

    2.7.  k·x + x = (k + 1)·x
          algebra

    2.8.  (cos(x) + i·sin(x))^(k + 1) = cos((k + 1)·x) + i·sin((k + 1)·x)
          calculation
            (cos(x) + i·sin(x))^(k + 1) = (cos(x) + i·sin(x))^k·(cos(x) + i·sin(x))                  mun:exponent-step a := cos(x) + i·sin(x), m := k
                = (cos(k·x) + i·sin(k·x))·(cos(x) + i·sin(x))                                        substitute IH
                = cos(k·x)·cos(x) + i·(sin(k·x)·cos(x) + cos(k·x)·sin(x)) + (i·i)·(sin(k·x)·sin(x))  algebra
                = cos(k·x)·cos(x) + i·(sin(k·x)·cos(x) + cos(k·x)·sin(x)) + (−1)·(sin(k·x)·sin(x))   substitute line 1
                = (cos(k·x)·cos(x) − sin(k·x)·sin(x)) + i·(sin(k·x)·cos(x) + cos(k·x)·sin(x))      algebra
                = cos(k·x + x) + i·(sin(k·x)·cos(x) + cos(k·x)·sin(x))                              substitute line 2.5
                = cos(k·x + x) + i·sin(k·x + x)                                                      substitute line 2.6
                = cos((k + 1)·x) + i·sin((k + 1)·x)                                                  substitute line 2.7
          requires i ∈ ℂ: mun:i-complex

3.  (cos(x) + i·sin(x))^n = cos(n·x) + i·sin(n·x)
    instantiate k := n in line 2
