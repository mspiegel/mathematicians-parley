theorem paired-product
  note        The members of X pair off, each x with f(x). Of each pair one
              member is the smaller, and f takes the smaller members onto
              the larger, so the product over X is the product over the
              smaller members x of x·f(x), each of which is 1 modulo n.
  let X ⊆ ℤ                                                           (H1)
  assume X is finite                                                  (H2)
  let n ∈ ℕ                                                           (H3)
  let f : X → X                                                       (H4)
  assume for all x ∈ X, f(f(x)) = x                                   (H5)
  assume for all x ∈ X, f(x) ≠ x                                      (H6)
  assume for all x ∈ X, x·f(x) ≡ 1 (mod n)                            (H7)
  then ∏(x ∈ X) x ≡ 1 (mod n)

let L = {x ∈ X : x < f(x)}                                            (D1)
       reads the members of X below their partners

let U = {x ∈ X : not x < f(x)}                                        (D2)
       reads the members of X above their partners

1.  X = L ∪ U
    mun:set-builder-split, from D1, D2

2.  L ∩ U = ∅
    mun:set-builder-split-disjoint, from D1, D2

3.  L ⊆ X
    mun:set-builder-subset, from D1

4.  U ⊆ X
    mun:set-builder-subset, from D2

5.  L is finite
    mun:finite-part, from H2, 3

6.  L ⊆ ℤ
    mun:subset-transitive, from H1, 3

7.  U ⊆ ℤ
    mun:subset-transitive, from H1, 4

8.  For all x ∈ X, x ∈ ℤ.
    mun:in-subset, from H1

9.  ∏(x ∈ X) x = (∏(x ∈ L) x)·∏(x ∈ U) x
    mun:product-split, from H2, 1, 2, 8

10. For all x ∈ L, f(x) ∈ U.
    proof
    note f(x) is above its partner x
    let x ∈ L                                                         (K1)

    10.1. x ∈ X. x < f(x).
          mun:set-builder u := x, from D1, K1

    10.2. f(f(x)) = x
          instantiate x := x in H5, from 10.1

    10.3. x ∈ ℤ
          mun:in-subset, from H1, 10.1

    10.4. f(x) ∈ ℤ
          mun:in-subset, from H1, H4, 10.1

    10.5. f(f(x)) ∈ ℤ
          membership, from 10.2, 10.3

    10.6. f(f(x)) < f(x)
          calculation
            f(f(x)) = x         10.2
                    < f(x)      10.1

    10.7. f(f(x)) ≤ f(x)
          inequalities
            f(f(x)) < f(x)      10.6
            f(f(x)) ≤ f(x)      weakening
          requires f(x) ∈ ℤ: from 10.4
          requires f(f(x)) ∈ ℤ: from 10.5

    10.8. not f(x) < f(f(x))
          inequalities, from 10.4, 10.5, 10.7

    10.9. f(x) ∈ U
          mun:set-builder u := f(x), from D2, H4, 10.1, 10.8

let g(x) = f(x), for x ∈ L                                            (D3)
       reads f on the members below their partners

11. g : L → U
    mun:function-into, from D3, 10
    requires g is a function on L: from D3

12. For all s, t ∈ L, if g(s) = g(t) then s = t.
    proof
    note f undoes itself, so it takes no two members to one
    let s ∈ L                                                         (K2)
    let t ∈ L                                                         (K3)
    assume g(s) = g(t)                                                (K4)

    12.1. s ∈ X
          mun:in-subset, from K2, 3

    12.2. t ∈ X
          mun:in-subset, from K3, 3

    12.3. g(s) = f(s)
          D3, from K2

    12.4. g(t) = f(t)
          D3, from K3

    12.5. f(s) = f(t)
          calculation
            f(s) = g(s)       12.3
                 = g(t)       K4
                 = f(t)       12.4

    12.6. f(f(s)) = f(f(t))
          substitute f(s) = f(t) (line 12.5)

    12.7. f(f(s)) = s
          instantiate x := s in H5, from 12.1

    12.8. f(f(t)) = t
          instantiate x := t in H5, from 12.2

    12.9. s = t
          calculation
            s = f(f(s))       12.7
              = f(f(t))       12.6
              = t             12.8

13. g : L → U is one-to-one
    mun:one-to-one, from 11, 12

14. For all u ∈ U, there is x ∈ L with u = g(x).
    proof
    note the partner of u is below it, and g takes it back to u
    let u ∈ U                                                         (K5)

    14.1. u ∈ X. not u < f(u).
          mun:set-builder, from D2, K5

    14.2. f(f(u)) = u
          instantiate x := u in H5, from 14.1

    14.3. f(u) ≠ u
          instantiate x := u in H6, from 14.1

    14.4. f(u) < u
          inequalities, from 14.1, 14.3
          requires u ∈ ℤ: mun:in-subset, from H1, 14.1
          requires f(u) ∈ ℤ: mun:in-subset, from H1, H4, 14.1

    14.5. f(u) < f(f(u))
          calculation
            f(u) < u          14.4
                 = f(f(u))    14.2

    14.6. f(u) ∈ L
          mun:set-builder u := f(u), from D1, H4, 14.1, 14.5

    14.7. g(f(u)) = f(f(u))
          D3, from 14.6

    14.8. u = g(f(u))
          calculation
            u = f(f(u))       14.2
              = g(f(u))       14.7

    14.9. there is x ∈ L with u = g(x)
          exhibit, from 14.6, 14.8

15. g : L → U is onto
    mun:onto, from 11, 14

16. g : L → U is one-to-one and onto
    mun:one-to-one-onto, from 13, 15

17. For all x ∈ U, x ∈ ℤ.
    mun:in-subset, from 7

18. ∏(x ∈ U) x = ∏(x ∈ L) f(x)
    mun:product-reindex, from D3, 5, 16, 17

19. For all x ∈ L, x ∈ ℤ.
    mun:in-subset, from 6

20. For all x ∈ L, f(x) ∈ ℝ.
    mun:int-real m := f(x)
    requires f(x) ∈ ℤ: mun:in-subset, from D3, 7, 11

21. ∏(x ∈ L) x·f(x) = (∏(x ∈ L) x)·∏(x ∈ L) f(x)
    mun:product-of-products, from 5, 19
    requires for all x ∈ L, f(x) ∈ ℝ: from 20

22. For all x ∈ L, x·f(x) ≡ 1 (mod n).
    proof
    let x ∈ L                                                         (K6)

    22.1. x ∈ X
          mun:in-subset, from K6, 3

    22.2. x·f(x) ≡ 1 (mod n)
          instantiate x := x in H7, from 22.1

23. For all x ∈ L, x·f(x) ∈ ℤ.
    proof
    let x ∈ L                                                         (K7)

    23.1. x ∈ ℤ
          mun:in-subset, from K7, 6

    23.2. f(x) ∈ ℤ
          mun:in-subset, from D3, K7, 7, 11

    23.3. x·f(x) ∈ ℤ
          membership, from 23.1, 23.2

24. ∏(x ∈ L) x·f(x) ≡ ∏(x ∈ L) 1 (mod n)
    thm:product-congruent-termwise, from 5, 22, 23

25. ∏(x ∈ L) 1 = 1
    mun:product-of-ones, from 5

26. ∏(x ∈ L) x·f(x) ≡ 1 (mod n)
    substitute ∏(x ∈ L) 1 = 1 (line 25) into line 24

27. (∏(x ∈ L) x)·∏(x ∈ U) x = (∏(x ∈ L) x)·∏(x ∈ L) f(x)
    substitute ∏(x ∈ U) x = ∏(x ∈ L) f(x) (line 18)

28. ∏(x ∈ X) x = ∏(x ∈ L) x·f(x)
    calculation
      ∏(x ∈ X) x = (∏(x ∈ L) x)·∏(x ∈ U) x         9
                 = (∏(x ∈ L) x)·∏(x ∈ L) f(x)      27
                 = ∏(x ∈ L) x·f(x)                 21

29. ∏(x ∈ X) x ≡ 1 (mod n)
    substitute ∏(x ∈ X) x = ∏(x ∈ L) x·f(x) (line 28) into line 26

theorem coprime-below-prime
  note        A prime shares a factor with a number below it only by
              dividing it, and it divides no smaller natural number.
  let p ∈ ℕ                                                           (H1)
  assume p is prime                                                   (H2)
  let a ∈ ℕ                                                           (H3)
  assume a < p                                                        (H4)
  then gcd(a, p) = 1

1.  not (p divides a)
    mun:below-not-divisible n := p, x := a, from H4

2.  gcd(p, a) = 1
    mun:prime-coprime, from H2, 1

3.  gcd(a, p) = gcd(p, a)
    mun:gcd-commutes

4.  gcd(a, p) = 1
    calculation
      gcd(a, p) = gcd(p, a)     3
                = 1             2

theorem wilson
  metamath    wilthimp
  note        Each a from 2 to p − 2 has an inverse f(a) modulo p, by
              Fermat's little theorem: a^(p − 2) taken modulo p. The
              inverse is again from 2 to p − 2, it is not a itself, and its
              inverse is a, so the numbers from 2 to p − 2 pair off, and
              their product is 1 modulo p. What is left of (p − 1)! is 1 and
              p − 1, which is −1 modulo p.
  let p ∈ ℕ                                                           (H1)
  assume p is prime                                                   (H2)
  then (p − 1)! ≡ −1 (mod p)

let f(a) = (a^(p − 2)) mod p, for a ∈ {2, …, p − 2}                   (D1)
       reads the inverse of a modulo p

1.  p > 1
    mun:prime, from H2

2.  1 + 1 ≤ p
    mun:integer-step m := 1, n := p, from 1

3.  2 ≤ p
    substitute 1 + 1 = 2 (arithmetic) into line 2

4.  2 < p or 2 = p
    mun:le-cases x := 2, y := p, from 3

5.  (p − 1)! ≡ −1 (mod p)
    cases, from 4

    case
    note the numbers from 2 to p − 2 pair off with their inverses
    assume 2 < p                                                      (C1)

    5.1.  2 + 1 ≤ p
          mun:integer-step m := 2, n := p, from C1

    5.2.  3 ≤ p
          substitute 2 + 1 = 3 (arithmetic) into line 5.1

    5.3.  p − 2 ∈ ℕ
          mun:pos-int-nat m := p − 2
          requires 0 < p − 2: inequalities, from 5.2

    5.4.  φ(p) = p − 1
          thm:phi-prime, from H2

    5.5.  For all a ∈ {2, …, p − 2}, gcd(a, p) = 1.
          proof
          let a ∈ {2, …, p − 2}                                       (K1)

          5.5.1.  a ∈ ℕ
                  mun:pos-int-nat m := a
                  requires 0 < a: inequalities, from K1

          5.5.2.  gcd(a, p) = 1
                  thm:coprime-below-prime, from H2, 5.5.1
                  requires a < p: inequalities, from K1

    5.6.  For all a ∈ {2, …, p − 2}, f(a) ∈ {0, …, p − 1}.
          proof
          let a ∈ {2, …, p − 2}                                       (K2)

          5.6.1.  a^(p − 2) ∈ ℤ
                  mun:power-integer m := p − 2, from 5.3

          5.6.2.  (a^(p − 2)) mod p < p
                  mun:mod-less, from 5.6.1

          5.6.3.  (a^(p − 2)) mod p ∈ {0, …, p − 1}
                  mun:range-from-bounds, from 5.6.2
                  requires (a^(p − 2)) mod p ∈ ℕ₀: mun:mod-natural, from 5.6.1

          5.6.4.  f(a) = (a^(p − 2)) mod p
                  D1, from K2

          5.6.5.  f(a) ∈ {0, …, p − 1}
                  substitute f(a) = (a^(p − 2)) mod p (line 5.6.4) into line 5.6.3

    5.7.  For all a ∈ {2, …, p − 2}, f(a) ∈ ℤ.
          proof
          let a ∈ {2, …, p − 2}                                       (K3)

          5.7.1.  f(a) ∈ {0, …, p − 1}
                  instantiate a := a in line 5.6, from K3

          5.7.2.  f(a) ∈ ℤ
                  mun:range-integer, from 5.7.1

    5.8.  For all a ∈ {2, …, p − 2}, a·f(a) ≡ 1 (mod p).
          proof
          note a^(p − 1) ≡ 1, and a^(p − 1) is a·a^(p − 2)
          let a ∈ {2, …, p − 2}                                       (K4)

          5.8.1.  gcd(a, p) = 1
                  instantiate a := a in line 5.5, from K4

          5.8.2.  a^φ(p) ≡ 1 (mod p)
                  thm:euler n := p, from 5.8.1

          5.8.3.  a^(p − 1) ≡ 1 (mod p)
                  substitute φ(p) = p − 1 (line 5.4) into line 5.8.2

          5.8.4.  a^(p − 2 + 1) = a^(p − 2)·a
                  mun:exponent-step m := p − 2, from 5.3

          5.8.5.  p − 2 + 1 = p − 1
                  algebra

          5.8.6.  a^(p − 1) = a^(p − 2)·a
                  substitute p − 2 + 1 = p − 1 (line 5.8.5) into line 5.8.4

          5.8.7.  a^(p − 2) ∈ ℤ
                  mun:power-integer m := p − 2, from 5.3

          5.8.8.  a^(p − 2) ≡ (a^(p − 2)) mod p (mod p)
                  mun:mod-congruent x := a^(p − 2), n := p, from 5.8.7

          5.8.9.  f(a) = (a^(p − 2)) mod p
                  D1, from K4

          5.8.10. a^(p − 2) ≡ f(a) (mod p)
                  substitute f(a) = (a^(p − 2)) mod p (line 5.8.9) into line 5.8.8

          5.8.11. f(a) ∈ ℤ
                  instantiate a := a in line 5.7, from K4

          5.8.12. f(a)·a ≡ a^(p − 2)·a (mod p)
                  thm:congruent-times c := a, from 5.8.7, 5.8.10, 5.8.11

          5.8.13. f(a)·a ≡ a^(p − 1) (mod p)
                  substitute a^(p − 1) = a^(p − 2)·a (line 5.8.6) into line 5.8.12

          5.8.14. a·f(a) = f(a)·a
                  algebra, from 5.8.11

          5.8.15. a^(p − 1) ∈ ℤ
                  membership, from 5.8.6, 5.8.7

          5.8.16. a·f(a) ≡ 1 (mod p)
                  calculation
                    a·f(a) = f(a)·a            5.8.14
                           ≡ a^(p − 1) (mod p)  5.8.13
                           ≡ 1 (mod p)          5.8.3
                  requires f(a)·a ∈ ℤ: membership, from 5.8.11
                  requires a^(p − 1) ∈ ℤ: from 5.8.15

    5.9.  For all a ∈ {2, …, p − 2}, not (p divides a − 1).
          proof
          let a ∈ {2, …, p − 2}                                       (K5)

          5.9.1.  a − 1 ∈ ℕ
                  mun:pos-int-nat m := a − 1
                  requires 0 < a − 1: inequalities, from K5

          5.9.2.  not (p divides a − 1)
                  mun:below-not-divisible n := p, x := a − 1, from 5.9.1
                  requires a − 1 < p: inequalities, from K5

    5.10. For all a ∈ {2, …, p − 2}, not (p divides a + 1).
          proof
          let a ∈ {2, …, p − 2}                                       (K6)

          5.10.1. a + 1 ∈ ℕ
                  mun:pos-int-nat m := a + 1
                  requires 0 < a + 1: inequalities, from K6

          5.10.2. not (p divides a + 1)
                  mun:below-not-divisible n := p, x := a + 1, from 5.10.1
                  requires a + 1 < p: inequalities, from K6

    5.11. 0 ∈ {0, …, p − 1}
          mun:range-from-bounds m := p, x := 0, from H1

    5.12. 1 ∈ {0, …, p − 1}
          mun:range-from-bounds m := p, x := 1, from 1

    5.13. {2, …, p − 2} ⊆ {0, …, p − 1}
          mun:range-inside
          requires 0 ≤ 2: arithmetic
          requires p − 2 ≤ p − 1: inequalities

    5.14. For all a ∈ {2, …, p − 2}, f(a) ∈ {2, …, p − 2}.
          proof
          note the inverse is not 0, 1 or p − 1
          let a ∈ {2, …, p − 2}                                       (K7)

          5.14.1. a·f(a) ≡ 1 (mod p)
                  instantiate a := a in line 5.8, from K7

          5.14.2. f(a) ∈ {0, …, p − 1}
                  instantiate a := a in line 5.6, from K7

          5.14.3. f(a) ∈ ℤ
                  mun:range-integer, from 5.14.2

          5.14.4. a ∈ {0, …, p − 1}
                  mun:in-subset, from K7, 5.13

          5.14.5. f(a) ≠ 0
                  contradiction
                  suppose f(a) = 0                                    (S1)

                  5.14.5.1. a·0 ≡ 1 (mod p)
                            substitute f(a) = 0 (S1) into line 5.14.1

                  5.14.5.2. a·0 = 0
                            algebra

                  5.14.5.3. 0 ≡ 1 (mod p)
                            substitute a·0 = 0 (line 5.14.5.2) into line 5.14.5.1

                  5.14.5.4. 0 = 1, which is impossible
                            mun:congruent-in-range, from 5.11, 5.12, 5.14.5.3

          5.14.6. f(a) ≠ 1
                  contradiction
                  suppose f(a) = 1                                    (S2)

                  5.14.6.1. a ≡ 1 (mod p)
                            substitute f(a) = 1 (S2) into line 5.14.1

                  5.14.6.2. a = 1
                            mun:congruent-in-range, from 5.12, 5.14.4, 5.14.6.1

                  5.14.6.3. a ≤ 1
                            inequalities
                              a = 1        5.14.6.2
                              a ≤ 1        weakening

                  5.14.6.4. not a ≤ 1
                            inequalities, from K7, contradicting 5.14.6.3

          5.14.7. f(a) ≠ p − 1
                  contradiction
                  suppose f(a) = p − 1                                (S3)

                  5.14.7.1. a·(p − 1) ≡ 1 (mod p)
                            substitute f(a) = p − 1 (S3) into line 5.14.1

                  5.14.7.2. p divides a·(p − 1) − 1
                            mun:congruent-mod, from 5.14.7.1

                  5.14.7.3. p divides p·a
                            mun:divides-multiple e := p, a := p, x := a
                            requires p divides p: mun:divides-self n := p

                  5.14.7.4. p divides p·a − (a·(p − 1) − 1)
                            mun:divides-difference, from 5.14.7.2, 5.14.7.3

                  5.14.7.5. p·a − (a·(p − 1) − 1) = a + 1
                            algebra

                  5.14.7.6. p divides a + 1
                            substitute p·a − (a·(p − 1) − 1) = a + 1 (line 5.14.7.5) into line 5.14.7.4

                  5.14.7.7. not (p divides a + 1)
                            instantiate a := a in line 5.10, from K7, contradicting 5.14.7.6

          5.14.8. 0 < f(a)
                  inequalities, from 5.14.2, 5.14.3, 5.14.5

          5.14.9. f(a) ∈ ℕ
                  mun:pos-int-nat m := f(a), from 5.14.3, 5.14.8

          5.14.10. 1 < f(a)
                  inequalities, from 5.14.6, 5.14.9

          5.14.11. 1 + 1 ≤ f(a)
                  mun:integer-step m := 1, n := f(a), from 5.14.3, 5.14.10

          5.14.12. 2 ≤ f(a)
                  substitute 1 + 1 = 2 (arithmetic) into line 5.14.11

          5.14.13. f(a) < p − 1
                  inequalities, from 5.14.2, 5.14.7
                  requires f(a) ∈ ℤ: from 5.14.3

          5.14.14. f(a) + 1 ≤ p − 1
                  mun:integer-step m := f(a), n := p − 1, from 5.14.3, 5.14.13

          5.14.15. f(a) ≤ p − 2
                  inequalities
                    f(a) + 1 ≤ p − 1      5.14.14
                    f(a) ≤ p − 2          adding −1
                  requires f(a) ∈ ℤ: from 5.14.3

          5.14.16. f(a) ∈ {2, …, p − 2}
                  mun:range-between k := f(a), a := 2, b := p − 2, from 5.14.3, 5.14.12, 5.14.15

    5.15. For all a ∈ {2, …, p − 2}, f(a) ≠ a.
          proof
          note a² ≡ 1 would make p divide (a − 1)(a + 1)
          let a ∈ {2, …, p − 2}                                       (K8)

          5.15.1. a·f(a) ≡ 1 (mod p)
                  instantiate a := a in line 5.8, from K8

          5.15.2. not (p divides a − 1)
                  instantiate a := a in line 5.9, from K8

          5.15.3. not (p divides a + 1)
                  instantiate a := a in line 5.10, from K8

          5.15.4. f(a) ≠ a
                  contradiction
                  suppose f(a) = a                                    (S4)

                  5.15.4.1. a·a ≡ 1 (mod p)
                            substitute f(a) = a (S4) into line 5.15.1

                  5.15.4.2. p divides a·a − 1
                            mun:congruent-mod, from 5.15.4.1

                  5.15.4.3. a·a − 1 = (a − 1)·(a + 1)
                            algebra

                  5.15.4.4. p divides (a − 1)·(a + 1)
                            substitute a·a − 1 = (a − 1)·(a + 1) (line 5.15.4.3) into line 5.15.4.2

                  5.15.4.5. p divides a − 1 or p divides a + 1
                            thm:prime-divides-product m := a − 1, n := a + 1, from H2, 5.15.4.4

                  5.15.4.6. p divides a + 1
                            mun:disjunctive-syllogism-left, from 5.15.2, 5.15.4.5

                  5.15.4.7. not (p divides a + 1)
                            join 5.15.3, contradicting 5.15.4.6

    5.16. For all a ∈ {2, …, p − 2}, f(f(a)) = a.
          proof
          note f(a) has inverse a, and an inverse is one remainder only
          let a ∈ {2, …, p − 2}                                       (K9)

          5.16.1. f(a) ∈ {2, …, p − 2}
                  instantiate a := a in line 5.14, from K9

          5.16.2. f(a)·f(f(a)) ≡ 1 (mod p)
                  instantiate a := f(a) in line 5.8, from 5.16.1

          5.16.3. a·f(a) ≡ 1 (mod p)
                  instantiate a := a in line 5.8, from K9

          5.16.4. f(a) ∈ ℤ
                  instantiate a := a in line 5.7, from K9

          5.16.5. f(f(a)) ∈ {0, …, p − 1}
                  instantiate a := f(a) in line 5.6, from 5.16.1

          5.16.6. f(f(a)) ∈ ℤ
                  mun:range-integer, from 5.16.5

          5.16.7. f(f(a))·f(a) = f(a)·f(f(a))
                  algebra, from 5.16.4, 5.16.6

          5.16.8. f(f(a))·f(a) ≡ a·f(a) (mod p)
                  calculation
                    f(f(a))·f(a) = f(a)·f(f(a))     5.16.7
                                 ≡ 1 (mod p)          5.16.2
                                 ≡ a·f(a) (mod p)     5.16.3
                  requires f(a)·f(f(a)) ∈ ℤ: membership, from 5.16.4, 5.16.6
                  requires a·f(a) ∈ ℤ: membership, from 5.16.4

          5.16.9. gcd(f(a), p) = 1
                  instantiate a := f(a) in line 5.5, from 5.16.1

          5.16.10. f(f(a)) ≡ a (mod p)
                  thm:congruent-cancel c := f(a), from 5.16.4, 5.16.6, 5.16.8, 5.16.9

          5.16.11. a ∈ {0, …, p − 1}
                  mun:in-subset, from K9, 5.13

          5.16.12. f(f(a)) = a
                  mun:congruent-in-range, from 5.16.5, 5.16.10, 5.16.11

    5.17. f : {2, …, p − 2} → {2, …, p − 2}
          mun:function-into, from D1, 5.14
          requires f is a function on {2, …, p − 2}: from D1

    5.18. {2, …, p − 2} is finite
          mun:range-finite

    5.19. {2, …, p − 2} ⊆ ℤ
          mun:range-in-integers

    5.20. ∏(a ∈ {2, …, p − 2}) a ≡ 1 (mod p)
          thm:paired-product, from 5.8, 5.15, 5.16, 5.18, 5.19
          requires f : {2, …, p − 2} → {2, …, p − 2}: from 5.17

    5.21. p − 1 ∈ ℕ₀
          mun:nat-minus-one n := p

    5.22. (p − 1)! = ∏(k = 1 to p − 1) k
          mun:factorial-product n := p − 1, from 5.21

    5.23. ∏(k = 1 to p − 2 + 1) k = (∏(k = 1 to p − 2) k)·(p − 2 + 1)
          mun:product-extended a := 1, n := p − 2
          requires p − 2 ≥ 1: inequalities, from 5.2

    5.24. p − 2 + 1 = p − 1
          algebra

    5.25. ∏(k = 1 to p − 1) k = (∏(k = 1 to p − 2) k)·(p − 1)
          substitute p − 2 + 1 = p − 1 (line 5.24) into line 5.23

    5.26. ∏(k = 1 to p − 2) k = 1·∏(k = 1 + 1 to p − 2) k
          mun:product-first a := 1, b := p − 2
          requires 1 ≤ p − 2: inequalities, from 5.2

    5.27. ∏(k = 2 to p − 2) k ∈ ℤ
          mun:product-integer, from 5.18, 5.19

    5.28. ∏(k = 1 to p − 2) k = ∏(k = 2 to p − 2) k
          substitute 1 + 1 = 2 (arithmetic) into line 5.26
          requires ∏(k = 2 to p − 2) k ∈ ℤ: from 5.27

    5.29. (∏(k = 1 to p − 2) k)·(p − 1) = (∏(k = 2 to p − 2) k)·(p − 1)
          substitute ∏(k = 1 to p − 2) k = ∏(k = 2 to p − 2) k (line 5.28)

    5.30. (∏(k = 2 to p − 2) k)·(p − 1) ≡ p − 1 (mod p)
          thm:congruent-times b := 1, c := p − 1, from 5.20, 5.27

    5.31. p divides p
          mun:divides-self n := p

    5.32. (p − 1) − (−1) = p
          algebra

    5.33. p divides (p − 1) − (−1)
          substitute (p − 1) − (−1) = p (line 5.32) into line 5.31

    5.34. p − 1 ≡ −1 (mod p)
          mun:congruent-mod, from 5.33

    5.35. (p − 1)! ≡ −1 (mod p)
          calculation
            (p − 1)! = ∏(k = 1 to p − 1) k                    5.22
                     = (∏(k = 1 to p − 2) k)·(p − 1)          5.25
                     = (∏(k = 2 to p − 2) k)·(p − 1)          5.29
                     ≡ p − 1 (mod p)                          5.30
                     ≡ −1 (mod p)                             5.34
          requires (∏(k = 2 to p − 2) k)·(p − 1) ∈ ℤ: membership, from 5.27

    case
    note for p = 2 the claim is worked out
    assume 2 = p                                                      (C2)

    5.36. (2 − 1)! ≡ −1 (mod 2)
          arithmetic

    5.37. (p − 1)! ≡ −1 (mod p)
          substitute 2 = p (C2) into line 5.36
