import mundane theorem    stdlib/divisibility/minus-one-congruent
import mundane theorem    stdlib/divisibility/divides-multiple
import mundane theorem    stdlib/divisibility/divides-difference
import mundane theorem    stdlib/divisibility/prime-coprime
import mundane theorem    stdlib/divisibility/gcd-commutes
import mundane theorem    stdlib/divisibility/congruent-in-range
import mundane theorem    stdlib/divisibility/mod-congruent
import mundane theorem    stdlib/divisibility/mod-less
import mundane theorem    stdlib/divisibility/mod-natural
