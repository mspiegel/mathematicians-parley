import mundane theorem    stdlib/numbers/exponent-step
import mundane theorem    stdlib/sums/sum-last
import mundane theorem    stdlib/sums/sum-single

define G(a, n) := Σ(j = 0 to n) a^j, for a ∈ ℝ, n ∈ ℕ₀               (D1)
       reads the geometric series: the powers of a, from a^0 up to a^n

theorem geometric-sum
  metamath    geoser
  note        By induction on n: adding the next power a^(k + 1) to
              (1 − a^(k + 1))/(1 − a) gives (1 − a^(k + 2))/(1 − a).
  let a ∈ ℝ                                                           (H1)
  assume a ≠ 1                                                        (H2)
  let n ∈ ℕ₀                                                          (H3)
  then G(a, n) = (1 − a^(n + 1))/(1 − a)

1.  For all k ∈ ℕ₀, G(a, k) = (1 − a^(k + 1))/(1 − a).
    induction on k starting at 0

    base
    1.1.  G(a, 0) = 1
          calculation
            G(a, 0) = Σ(j = 0 to 0) a^j     D1
                    = a^0                   mun:sum-single a := 0
                    = 1                     algebra

    1.2.  G(a, 0) = (1 − a)/(1 − a)
          calculation
            G(a, 0) = 1                    1.1
                    = (1 − a)/(1 − a)      algebra
          requires 1 − a ≠ 0: algebra, from H2

    step
    let k ∈ ℕ₀                                                        (K)
    assume step 1 is true for k, the induction hypothesis             (IH)

    1.3.  G(a, k + 1) = G(a, k) + a^(k + 1)
          calculation
            G(a, k + 1) = Σ(j = 0 to k + 1) a^j              D1
                        = Σ(j = 0 to k) a^j + a^(k + 1)      mun:sum-last n := k
                        = G(a, k) + a^(k + 1)                D1

    1.4.  a^((k + 1) + 1) = a^(k + 1)·a
          mun:exponent-step m := k + 1

    1.5.  G(a, k + 1) = (1 − a^((k + 1) + 1))/(1 − a)
          calculation
            G(a, k + 1) = G(a, k) + a^(k + 1)                         1.3
                        = (1 − a^(k + 1))/(1 − a) + a^(k + 1)         substitute IH
                        = (1 − a^(k + 1)·a)/(1 − a)                  algebra
                        = (1 − a^((k + 1) + 1))/(1 − a)              substitute line 1.4
          requires 1 − a ≠ 0: algebra, from H2

2.  G(a, n) = (1 − a^(n + 1))/(1 − a)
    instantiate k := n in line 1
