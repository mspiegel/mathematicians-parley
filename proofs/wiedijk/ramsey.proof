import mundane theorem    stdlib/sets/difference-of-union
import mundane theorem    stdlib/sets/difference-shrinks
import mundane theorem    stdlib/sets/difference-subset
import mundane theorem    stdlib/sets/in-subset
import mundane theorem    stdlib/sets/nonempty-member
import mundane theorem    stdlib/sets/not-in-difference
import mundane theorem    stdlib/sets/pair-subset
import mundane theorem    stdlib/sets/remove-and-restore
import mundane theorem    stdlib/sets/remove-member
