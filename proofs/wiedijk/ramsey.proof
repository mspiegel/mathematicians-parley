import theorem            stdlib/counting/pascal
import mundane theorem    stdlib/counting/binomial-all
import mundane theorem    stdlib/counting/binomial-nat
import mundane theorem    stdlib/counting/binomial-nat0
import mundane theorem    stdlib/counting/binomial-zero-index
import mundane theorem    stdlib/counting/card-add-one
import mundane theorem    stdlib/counting/card-disjoint-union
import mundane theorem    stdlib/counting/card-nat0
import mundane theorem    stdlib/counting/card-nonempty
import mundane theorem    stdlib/counting/card-pair-distinct
import mundane theorem    stdlib/counting/card-positive
import mundane theorem    stdlib/counting/card-remove
import mundane theorem    stdlib/counting/card-singleton
import mundane theorem    stdlib/counting/card-subset
import mundane theorem    stdlib/counting/card-two
import mundane theorem    stdlib/counting/finite-part
import mundane theorem    stdlib/numbers/integer-step
import mundane theorem    stdlib/numbers/nat-minus-one
