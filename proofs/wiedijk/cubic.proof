import definition         stdlib/numbers/i
import mundane theorem    stdlib/numbers/i-complex
import mundane theorem    stdlib/numbers/zero-product
import definition         stdlib/sets/triple
import mundane theorem    stdlib/sets/triple-members

theorem cubic
  note        With y = 3·a·x + b the cubic is (y³ − 3·M·y + N)/(27·a²), and
              N = T³ + M³/T³. The cube roots of 1 are 1, (−1 + i·√3)/2 and
              (−1 − i·√3)/2, and with them y³ − 3·M·y + N factors as the
              product of y + r·T + M/(r·T) over the three; so the cubic is 0
              just when one factor is.
  let a ∈ ℂ                                                           (H1)
  let b ∈ ℂ                                                           (H2)
  let c ∈ ℂ                                                           (H3)
  let d ∈ ℂ                                                           (H4)
  let x ∈ ℂ                                                           (H5)
  assume a ≠ 0                                                        (H6)
  let M ∈ ℂ                                                           (H7)
  assume M = b² − 3·a·c                                               (H8)
  let N ∈ ℂ                                                           (H9)
  assume N = 2·b³ − 9·a·b·c + 27·a²·d                                 (H10)
  let G ∈ ℂ                                                           (H11)
  assume G² = N² − 4·M³                                               (H12)
  let T ∈ ℂ                                                           (H13)
  assume T³ = (N + G)/2                                               (H14)
  assume T ≠ 0                                                        (H15)
  then a·x³ + b·x² + c·x + d = 0 ↔ there is r ∈ {1, (−1 + i·√3)/2, (−1 − i·√3)/2} with x = −(b + r·T + M/(r·T))/(3·a)

1.  i ∈ ℂ
    mun:i-complex

2.  i·i = −1
    def:i

3.  (√3)² = 3
    real arithmetic

4.  (i·√3)² = −3
    algebra, from 1, 2, 3

let ω₁ = (−1 + i·√3)/2, a complex number                             (D1)
    membership, from 1
    reads a cube root of 1 other than 1

let ω₂ = (−1 − i·√3)/2, a complex number                             (D2)
    membership, from 1
    reads the third cube root of 1

5.  ω₁·ω₂ = 1
    algebra, from D1, D2, 1, 4

6.  ω₁ ≠ 0
    contradiction
    suppose ω₁ = 0                                                    (S1)

    6.1.  1 = 0, which is impossible
          algebra, from S1, 5

7.  ω₂ ≠ 0
    contradiction
    suppose ω₂ = 0                                                    (S2)

    7.1.  1 = 0, which is impossible
          algebra, from S2, 5

8.  T³ + M³/T³ = N
    algebra, from H12, H14, H15

let y = 3·a·x + b, a complex number                                  (D3)
    membership
    reads the root moved so that the cubic has no square term

let u = y + T + M/T, a complex number                                (D4)
    membership, from H15
    reads the factor for the cube root 1

let v = y + ω₁·T + M/(ω₁·T), a complex number                        (D5)
    membership, from H15, 6
    reads the factor for the cube root ω₁

let w = y + ω₂·T + M/(ω₂·T), a complex number                        (D6)
    membership, from H15, 7
    reads the factor for the cube root ω₂

9.  a·x³ + b·x² + c·x + d = (y³ − 3·M·y + N)/(27·a²)
    algebra, from D3, H6, H8, H10

10. v·w = y² − (T + M/T)·y + T² − M + M²/T²
    algebra, from D1, D2, D5, D6, H15, 1, 4, 6, 7

11. y³ − 3·M·y + N = u·(v·w)
    calculation
      y³ − 3·M·y + N = u·(y² − (T + M/T)·y + T² − M + M²/T²)    algebra, from D4, H15, 8
                     = u·(v·w)                                   substitute line 10

12. a·x³ + b·x² + c·x + d = 0 ↔ there is r ∈ {1, (−1 + i·√3)/2, (−1 − i·√3)/2} with x = −(b + r·T + M/(r·T))/(3·a)
    both directions

    direction
    assume a·x³ + b·x² + c·x + d = 0                                  (A1)

    12.1. u·(v·w) = 0
          calculation
            u·(v·w) = y³ − 3·M·y + N    11
                    = 0                 algebra, from A1, H6, 9

    12.2. u = 0 or v·w = 0
          mun:zero-product x := u, y := v·w, from 12.1

    12.3. there is r ∈ {1, (−1 + i·√3)/2, (−1 − i·√3)/2} with x = −(b + r·T + M/(r·T))/(3·a)
          cases, from 12.2

          case
          assume u = 0                                                (C1)

          12.3.1. x = −(b + T + M/T)/(3·a)
                  algebra, from C1, D3, D4, H6, H15

          12.3.2. 1 ∈ {1, (−1 + i·√3)/2, (−1 − i·√3)/2}
                  mun:triple-members

          12.3.3. there is r ∈ {1, (−1 + i·√3)/2, (−1 − i·√3)/2} with x = −(b + r·T + M/(r·T))/(3·a)
                  exhibit, from 12.3.1, 12.3.2

          case
          assume v·w = 0                                              (C2)

          12.3.4. v = 0 or w = 0
                  mun:zero-product x := v, y := w, from C2

          12.3.5. there is r ∈ {1, (−1 + i·√3)/2, (−1 − i·√3)/2} with x = −(b + r·T + M/(r·T))/(3·a)
                  cases, from 12.3.4

                  case
                  assume v = 0                                        (C3)

                  12.3.5.1. x = −(b + ((−1 + i·√3)/2)·T + M/(((−1 + i·√3)/2)·T))/(3·a)
                            algebra, from C3, D1, D3, D5, H6, H15, 1, 6

                  12.3.5.2. (−1 + i·√3)/2 ∈ {1, (−1 + i·√3)/2, (−1 − i·√3)/2}
                            mun:triple-members

                  12.3.5.3. there is r ∈ {1, (−1 + i·√3)/2, (−1 − i·√3)/2} with x = −(b + r·T + M/(r·T))/(3·a)
                            exhibit, from 12.3.5.1, 12.3.5.2

                  case
                  assume w = 0                                        (C4)

                  12.3.5.4. x = −(b + ((−1 − i·√3)/2)·T + M/(((−1 − i·√3)/2)·T))/(3·a)
                            algebra, from C4, D2, D3, D6, H6, H15, 1, 7

                  12.3.5.5. (−1 − i·√3)/2 ∈ {1, (−1 + i·√3)/2, (−1 − i·√3)/2}
                            mun:triple-members

                  12.3.5.6. there is r ∈ {1, (−1 + i·√3)/2, (−1 − i·√3)/2} with x = −(b + r·T + M/(r·T))/(3·a)
                            exhibit, from 12.3.5.4, 12.3.5.5

    direction
    assume there is r ∈ {1, (−1 + i·√3)/2, (−1 − i·√3)/2} with x = −(b + r·T + M/(r·T))/(3·a)    (A2)

    12.4. r ∈ {1, (−1 + i·√3)/2, (−1 − i·√3)/2}. x = −(b + r·T + M/(r·T))/(3·a).
          obtain r from A2

    12.5. r = 1 or r = (−1 + i·√3)/2 or r = (−1 − i·√3)/2
          def:triple x := r, from 12.4

    12.6. u·(v·w) = 0
          cases, from 12.5

          case
          assume r = 1 or r = (−1 + i·√3)/2                           (C5)

          12.6.1. u·(v·w) = 0
                  cases, from C5

                  case
                  assume r = 1                                        (C6)

                  12.6.1.1. x = −(b + 1·T + M/(1·T))/(3·a)
                            substitute r = 1 (C6) into line 12.4

                  12.6.1.2. u = 0
                            algebra, from D3, D4, H6, H15, 12.6.1.1

                  12.6.1.3. u·(v·w) = 0
                            algebra, from 12.6.1.2

                  case
                  assume r = (−1 + i·√3)/2                            (C7)

                  12.6.1.4. x = −(b + ((−1 + i·√3)/2)·T + M/(((−1 + i·√3)/2)·T))/(3·a)
                            substitute r = (−1 + i·√3)/2 (C7) into line 12.4

                  12.6.1.5. v = 0
                            algebra, from D1, D3, D5, H6, H15, 1, 6, 12.6.1.4

                  12.6.1.6. u·(v·w) = 0
                            algebra, from 12.6.1.5

          case
          assume r = (−1 − i·√3)/2                                    (C8)

          12.6.2. x = −(b + ((−1 − i·√3)/2)·T + M/(((−1 − i·√3)/2)·T))/(3·a)
                  substitute r = (−1 − i·√3)/2 (C8) into line 12.4

          12.6.3. w = 0
                  algebra, from D2, D3, D6, H6, H15, 1, 7, 12.6.2

          12.6.4. u·(v·w) = 0
                  algebra, from 12.6.3

    12.7. y³ − 3·M·y + N = 0
          calculation
            y³ − 3·M·y + N = u·(v·w)    11
                           = 0          12.6

    12.8.  a·x³ + b·x² + c·x + d = 0
           calculation
             a·x³ + b·x² + c·x + d = (y³ − 3·M·y + N)/(27·a²)    9
                                   = 0/(27·a²)                   substitute line 12.7
                                   = 0                           algebra, from H6
