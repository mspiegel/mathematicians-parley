theorem choose-from-none
  note        A set with no elements has one part, the empty set, which has
              0 elements. So there is one way to choose 0 elements from it
              and none to choose any other number.
  let X be a set                                                      (H1)
  let j ∈ ℤ                                                           (H2)
  assume |X| = 0                                                      (H3)
  then |{S ⊆ X : |S| = j}| = C(0, j)

let F = {S ⊆ X : |S| = j}                                             (D1)
       reads the parts of X with j elements

1.  X = ∅
    mun:card-zero, from H3

2.  j = 0 or j ≠ 0
    mun:excluded-middle P := j = 0

3.  |F| = C(0, j)
    cases, from 2

    case
    note the empty set is the one part of X, and it has 0 elements
    assume j = 0                                                      (C1)

    3.1.  ∅ ⊆ X
          mun:empty-subset

    3.2.  |∅| = 0
          mun:card-empty

    3.3.  |∅| = j
          calculation
            |∅| = 0      3.2
                = j      C1

    3.4.  ∅ ∈ F
          mun:part-builder u := ∅, from D1, 3.1, 3.3

    3.5.  For all R ∈ F, R ∈ {∅}.
          proof
          let R ∈ F                                                   (K1)

          3.5.1.  R ⊆ X
                  mun:part-builder u := R, from D1, K1

          3.5.2.  R ⊆ ∅
                  substitute X = ∅ (line 1) into line 3.5.1

          3.5.3.  R = ∅
                  mun:subset-empty, from 3.5.2

          3.5.4.  R ∈ {∅}
                  mun:singleton x := R, a := ∅, from 3.5.3

    3.6.  F ⊆ {∅}
          mun:subset, from 3.5

    3.7.  {∅} ⊆ F
          mun:singleton-subset, from 3.4

    3.8.  F = {∅}
          mun:subset-antisymmetric, from 3.6, 3.7

    3.9.  |F| = |{∅}|
          substitute F = {∅} (line 3.8)

    3.10. |{∅}| = 1
          mun:card-singleton x := ∅

    3.11. C(0, 0) = 1
          mun:binomial-zero-index n := 0

    3.12. C(0, j) = C(0, 0)
          substitute j = 0 (C1)

    3.13. |F| = C(0, j)
          calculation
            |F| = |{∅}|      3.9
                = 1          3.10
                = C(0, 0)    3.11
                = C(0, j)    3.12

    case
    note no part of the empty set has j elements, so there is nothing to count
    assume j ≠ 0                                                      (C2)

    3.14. For all R ⊆ X, |R| ≠ j.
          proof
          let R ⊆ X                                                   (K2)

          3.14.1. R ⊆ ∅
                  substitute X = ∅ (line 1) into K2

          3.14.2. R = ∅
                  mun:subset-empty, from 3.14.1

          3.14.3. |R| = |∅|
                  substitute R = ∅ (line 3.14.2)

          3.14.4. |∅| = 0
                  mun:card-empty

          3.14.5. |R| ≠ j
                  contradiction
                  suppose |R| = j                                     (S1)

                  3.14.5.1. j = 0
                            calculation
                              j = |R|      S1
                                = |∅|      3.14.3
                                = 0        3.14.4

                  3.14.5.2. j ≠ 0
                            restate C2, contradicting 3.14.5.1

    3.15. F = ∅
          mun:part-builder-empty, from D1, 3.14

    3.16. |F| = |∅|
          substitute F = ∅ (line 3.15)

    3.17. |∅| = 0
          mun:card-empty

    3.18. j ∉ {0, …, 0}
          contradiction
          suppose j ∈ {0, …, 0}                                       (S2)

          3.18.1. j ≤ 0
                  mun:range-bounds a := 0, b := 0, k := j, from S2

          3.18.2. 0 ≤ j
                  mun:range-bounds a := 0, b := 0, k := j, from S2

          3.18.3. j = 0
                  antisymmetry, from 3.18.1, 3.18.2

          3.18.4. j ≠ 0
                  restate C2, contradicting 3.18.3

    3.19. C(0, j) = 0
          mun:binomial-outside n := 0, k := j, from 3.18

    3.20. |F| = C(0, j)
          calculation
            |F| = |∅|        3.16
                = 0          3.17
                = C(0, j)    3.19

4.  |{S ⊆ X : |S| = j}| = C(0, j)
    substitute F = {S ⊆ X : |S| = j} (D1) into line 3


theorem add-element-bijection
  note        Adding a to each part of Y with j elements matches them one to
              one with the sets made so: since a is not in Y, taking a away
              again gives back the part it was added to.
  let Y be a set                                                      (H1)
  let a ∉ Y                                                           (H2)
  let j ∈ ℤ                                                           (H3)
  then there is a bijection from {S ⊆ Y : |S| = j} to {T ∪ {a} : T ∈ {S ⊆ Y : |S| = j}}

let F = {S ⊆ Y : |S| = j}                                             (D1)
       reads the parts of Y with j elements

1.  For all S, T ∈ F, if S ∪ {a} = T ∪ {a} then S = T.
    proof
    note adding a can be undone by taking it away, so nothing is sent twice
    let S ∈ F                                                         (K1)
    let T ∈ F                                                         (K2)
    assume S ∪ {a} = T ∪ {a}                                          (K3)

    1.1.  S ⊆ Y
          mun:part-builder u := S, X := Y, from D1, K1

    1.2.  T ⊆ Y
          mun:part-builder u := T, X := Y, from D1, K2

    1.3.  a ∉ S
          mun:not-in-subset Y := S, Z := Y, from H2, 1.1

    1.4.  a ∉ T
          mun:not-in-subset Y := T, Z := Y, from H2, 1.2

    1.5.  (S ∪ {a}) ∖ {a} = S ∖ {a}
          mun:difference-of-union

    1.6.  (T ∪ {a}) ∖ {a} = T ∖ {a}
          mun:difference-of-union

    1.7.  S ∖ {a} = S
          mun:difference-absent, from 1.3

    1.8.  T ∖ {a} = T
          mun:difference-absent, from 1.4

    1.9.  (T ∪ {a}) ∖ {a} = S ∖ {a}
          substitute S ∪ {a} = T ∪ {a} (K3) into line 1.5

    1.10. S = T
          calculation
            S = S ∖ {a}            1.7
              = (T ∪ {a}) ∖ {a}    1.9
              = T ∖ {a}            1.6
              = T                  1.8

2.  There is a bijection from {S ⊆ Y : |S| = j} to {T ∪ {a} : T ∈ {S ⊆ Y : |S| = j}}.
    mun:image-of-injection, from D1, 1


theorem add-element-disjoint
  note        A part of Y never holds a, and every set made by adding a to a
              part of Y does, so the two families share nothing.
  let Y be a set                                                      (H1)
  let a ∉ Y                                                           (H2)
  let j ∈ ℤ                                                           (H3)
  then {S ⊆ Y : |S| = j} ∩ {T ∪ {a} : T ∈ {S ⊆ Y : |S| = j − 1}} = ∅

let U = {S ⊆ Y : |S| = j}                                             (D1)
       reads the parts of Y with j elements

let V = {S ⊆ Y : |S| = j − 1}                                         (D2)
       reads the parts of Y with j − 1 elements

1.  For all T ∈ V, T ∪ {a} ∉ U.
    proof
    let T ∈ V                                                         (K1)

    1.1.  a ∈ T ∪ {a}
          mun:in-union-singleton

    1.2.  T ∪ {a} ∉ U
          contradiction
          suppose T ∪ {a} ∈ U                                         (S1)

          1.2.1.  T ∪ {a} ⊆ Y
                  mun:part-builder u := T ∪ {a}, X := Y, from D1, S1

          1.2.2.  a ∉ T ∪ {a}
                  mun:not-in-subset Y := T ∪ {a}, Z := Y, from H2, 1.2.1,
                    contradicting 1.1

2.  For all u ∈ {T ∪ {a} : T ∈ V}, u ∉ U.
    mun:added-elements-are-new Y := V, from 1

3.  {S ⊆ Y : |S| = j} ∩ {T ∪ {a} : T ∈ {S ⊆ Y : |S| = j − 1}} = ∅
    mun:disjoint-empty, from D1, D2, 2


theorem choose-split
  note        A part of X with j elements either leaves a out, and is a part
              of X ∖ {a} with j elements, or holds a, and is a part of
              X ∖ {a} with j − 1 elements with a put back.
  let X be a set                                                      (H1)
  let a ∈ X                                                           (H2)
  let j ∈ ℤ                                                           (H3)
  assume X is finite                                                  (H4)
  then {S ⊆ X : |S| = j} = {S ⊆ X ∖ {a} : |S| = j} ∪ {T ∪ {a} : T ∈ {S ⊆ X ∖ {a} : |S| = j − 1}}

let F = {S ⊆ X : |S| = j}                                             (D1)
       reads the parts of X with j elements

let U = {S ⊆ X ∖ {a} : |S| = j}                                       (D2)
       reads the parts of X with j elements that leave a out

let V = {S ⊆ X ∖ {a} : |S| = j − 1}                                   (D3)
       reads the parts of X ∖ {a} with j − 1 elements

let W = {T ∪ {a} : T ∈ V}                                             (D4)
       reads the parts of X with j elements that hold a

1.  For all R ∈ F, R ∈ U ∪ W.
    proof
    let R ∈ F                                                         (K1)

    1.1.  R ⊆ X. |R| = j.
          mun:part-builder u := R, from D1, K1

    1.2.  a ∈ R or a ∉ R
          mun:excluded-middle P := a ∈ R

    1.3.  R ∈ U ∪ W
          cases, from 1.2

          case
          note R holds a, and is a part of X ∖ {a} with j − 1 elements, with a put back
          assume a ∈ R                                                (C1)

          1.3.1.  R ≠ ∅
                  mun:member-nonempty, from C1

          1.3.2.  |R| ≥ 1
                  mun:card-at-least-one, from 1.3.1

          1.3.3.  j ≥ 1
                  substitute |R| = j (line 1.1) into line 1.3.2

          1.3.4.  0 ≤ j − 1
                  inequalities, from 1.3.3

          1.3.5.  j − 1 ∈ ℕ₀
                  mun:nat0-as-int n := j − 1, from 1.3.4

          1.3.6.  |R| = (j − 1) + 1
                  algebra, from 1.1

          1.3.7.  |R ∖ {a}| = j − 1
                  mun:card-remove X := R, k := j − 1, from C1, 1.3.5, 1.3.6

          1.3.8.  R ∖ {a} ⊆ X ∖ {a}
                  mun:difference-shrinks, from 1.1

          1.3.9.  R ∖ {a} ∈ V
                  mun:part-builder u := R ∖ {a}, X := X ∖ {a}, from D3, 1.3.7, 1.3.8

          1.3.10. (R ∖ {a}) ∪ {a} ∈ W
                  mun:added-element-in-image Y := V, s := R ∖ {a}, from D4, 1.3.9

          1.3.11. (R ∖ {a}) ∪ {a} = R
                  mun:remove-and-restore, from C1

          1.3.12. R ∈ W
                  substitute (R ∖ {a}) ∪ {a} = R (line 1.3.11) into line 1.3.10

          1.3.13. R ∈ U ∪ W
                  mun:in-union-right, from 1.3.12

          case
          note R leaves a out, so it is a part of X ∖ {a} with j elements
          assume a ∉ R                                                (C2)

          1.3.14. R ⊆ X ∖ {a}
                  mun:subset-into-difference, from C2, 1.1

          1.3.15. R ∈ U
                  mun:part-builder u := R, X := X ∖ {a}, from D2, 1.1, 1.3.14

          1.3.16. R ∈ U ∪ W
                  mun:in-union-left, from 1.3.15

2.  F ⊆ U ∪ W
    mun:subset, from 1

3.  X ∖ {a} ⊆ X
    mun:difference-subset

4.  For all R ∈ U, R ∈ F.
    proof
    let R ∈ U                                                         (K2)

    4.1.  R ⊆ X ∖ {a}. |R| = j.
          mun:part-builder u := R, X := X ∖ {a}, from D2, K2

    4.2.  R ⊆ X
          mun:subset-transitive, from 3, 4.1

    4.3.  R ∈ F
          mun:part-builder u := R, from D1, 4.1, 4.2

5.  U ⊆ F
    mun:subset, from 4

6.  For all T ∈ V, T ∪ {a} ∈ F.
    proof
    let T ∈ V                                                         (K3)

    6.1.  T ⊆ X ∖ {a}. |T| = j − 1.
          mun:part-builder u := T, X := X ∖ {a}, from D3, K3

    6.2.  T ⊆ X
          mun:subset-transitive, from 3, 6.1

    6.3.  {a} ⊆ X
          mun:singleton-subset, from H2

    6.4.  T ∪ {a} ⊆ X
          mun:union-subset, from 6.2, 6.3

    6.5.  T is finite
          mun:finite-part, from H4, 6.2

    6.6.  a ∉ T
          mun:subset-of-difference, from 6.1

    6.7.  |T ∪ {a}| = |T| + 1
          mun:card-add-one, from 6.5, 6.6

    6.8.  |T ∪ {a}| = j
          algebra, from 6.1, 6.7

    6.9.  T ∪ {a} ∈ F
          mun:part-builder u := T ∪ {a}, from D1, 6.4, 6.8

7.  W ⊆ F
    mun:added-elements-stay-inside Y := V, Z := F, from D4, 6

8.  U ∪ W ⊆ F
    mun:union-subset, from 5, 7

9.  {S ⊆ X : |S| = j} = {S ⊆ X ∖ {a} : |S| = j} ∪ {T ∪ {a} : T ∈ {S ⊆ X ∖ {a} : |S| = j − 1}}
    mun:subset-antisymmetric, from D1, D2, D3, D4, 2, 8


theorem combinations
  metamath    hashbc
  note        By induction on the size. Taking one element a out of a set of
              m + 1 splits its parts with j elements into those without a,
              C(m, j) of them, and those with a, one for each part of the
              rest with j − 1 elements, C(m, j − 1) of them; Pascal's rule
              adds the two.
  let n ∈ ℕ₀                                                          (H1)
  let k ∈ ℤ                                                           (H2)
  let A be a set                                                      (H3)
  assume |A| = n                                                      (H4)
  then |{S ⊆ A : |S| = k}| = C(n, k)

1.  For all m ∈ ℕ₀, for all sets X, for all j ∈ ℤ, if |X| = m then |{S ⊆ X : |S| = j}| = C(m, j).
    induction on m starting at 0

    base
    1.1.  For all sets X, for all j ∈ ℤ, if |X| = 0 then |{S ⊆ X : |S| = j}| = C(0, j).
          proof
          let X be a set                                              (K1)
          let j ∈ ℤ                                                   (K2)
          assume |X| = 0                                              (C1)

          1.1.1.  |{S ⊆ X : |S| = j}| = C(0, j)
                  thm:choose-from-none, from C1

    step
    let m ∈ ℕ₀                                                        (K3)
    assume step 1 is true for m, the induction hypothesis             (IH)

    1.2.  For all sets X, for all j ∈ ℤ, if |X| = m + 1 then |{S ⊆ X : |S| = j}| = C(m + 1, j).
          proof
          note take an element a out of X, and split the parts with j elements by whether they hold it
          let X be a set                                              (K4)
          let j ∈ ℤ                                                   (K5)
          assume |X| = m + 1                                          (C2)

          1.2.1.  a ∈ X
                  obtain a: mun:card-nonempty, from C2

          1.2.2.  |X ∖ {a}| = m
                  mun:card-remove, from C2, 1.2.1

          1.2.3.  X is finite
                  mun:card-finite m := m + 1, from C2

          let U = {S ⊆ X ∖ {a} : |S| = j}                             (D1)
                 reads the parts of X with j elements that leave a out
          let V = {S ⊆ X ∖ {a} : |S| = j − 1}                         (D2)
                 reads the parts of X ∖ {a} with j − 1 elements
          let W = {T ∪ {a} : T ∈ V}                                   (D3)
                 reads the parts of X with j elements that hold a

          1.2.4.  |U| = C(m, j)
                  instantiate X := X ∖ {a}, j := j in IH, from D1, 1.2.2

          1.2.5.  |V| = C(m, j − 1)
                  instantiate X := X ∖ {a}, j := j − 1 in IH, from D2, 1.2.2

          1.2.6.  There is a bijection from V to W.
                  thm:add-element-bijection Y := X ∖ {a}, j := j − 1, from D2, D3
                  requires a ∉ X ∖ {a}: mun:not-in-difference

          1.2.7.  |W| = C(m, j − 1)
                  mun:card-bijection X := V, Y := W, m := C(m, j − 1),
                    from 1.2.5, 1.2.6
                  requires C(m, j − 1) ∈ ℕ₀: mun:binomial-nat0

          1.2.8.  U ∩ W = ∅
                  thm:add-element-disjoint Y := X ∖ {a}, from D1, D2, D3
                  requires a ∉ X ∖ {a}: mun:not-in-difference

          1.2.9.  {S ⊆ X : |S| = j} = U ∪ W
                  thm:choose-split, from D1, D2, D3, 1.2.1, 1.2.3

          1.2.10. |U ∪ W| = C(m, j) + C(m, j − 1)
                  mun:card-disjoint-union X := U, Y := W, m := C(m, j),
                    n := C(m, j − 1), from 1.2.4, 1.2.7, 1.2.8
                  requires C(m, j) ∈ ℕ₀: mun:binomial-nat0
                  requires C(m, j − 1) ∈ ℕ₀: mun:binomial-nat0

          1.2.11. |{S ⊆ X : |S| = j}| = C(m, j) + C(m, j − 1)
                  substitute {S ⊆ X : |S| = j} = U ∪ W (line 1.2.9) into line 1.2.10

          1.2.12. C(m, j) + C(m, j − 1) = C(m + 1, j)
                  thm:pascal n := m, k := j

          1.2.13. |{S ⊆ X : |S| = j}| = C(m + 1, j)
                  calculation
                    |{S ⊆ X : |S| = j}| = C(m, j) + C(m, j − 1)    1.2.11
                                        = C(m + 1, j)              1.2.12

2.  |{S ⊆ A : |S| = k}| = C(n, k)
    instantiate m := n, X := A, j := k in line 1, from H3, H4
