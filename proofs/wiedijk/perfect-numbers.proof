import mundane theorem    stdlib/divisibility/coprime-power
import mundane definition stdlib/divisibility/divides
import mundane theorem    stdlib/divisibility/divides-difference
import mundane theorem    stdlib/divisibility/divides-le
import mundane theorem    stdlib/divisibility/divides-multiple
import mundane theorem    stdlib/divisibility/divides-one
import mundane theorem    stdlib/divisibility/divides-quotient
import mundane theorem    stdlib/divisibility/divides-self
import mundane definition stdlib/divisibility/even
import mundane theorem    stdlib/divisibility/even-or-odd
import mundane definition stdlib/divisibility/gcd
import mundane theorem    stdlib/divisibility/gcd-commutes
import mundane theorem    stdlib/divisibility/not-both
import mundane theorem    stdlib/divisibility/odd-not-divisible
import mundane theorem    stdlib/divisibility/one-divides
import mundane definition stdlib/divisibility/prime
import mundane theorem    stdlib/divisibility/prime-coprime
import mundane theorem    stdlib/divisibility/prime-nat
import mundane theorem    stdlib/divisibility/sigma-nat
