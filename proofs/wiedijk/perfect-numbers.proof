define power-times-odd: j is a power of two times an odd number means
       there is k ∈ ℕ₀ with there is m ∈ ℕ with m is odd and j = 2^k·m   (D1)
       reads j is 2 to some power, times an odd number

theorem euclid-perfect
  metamath    perfect1
  note        σ multiplies over numbers that share no factor, as 2^(p − 1) and
              2^p − 1 do. σ(2^(p − 1)) = 2^p − 1 by the geometric sum, and
              σ(2^p − 1) = 2^p since it is prime. Their product is twice the
              number, which is what perfect means.
  let p ∈ ℕ                                                           (H1)
  assume 2^p − 1 is prime                                             (H2)
  then 2^(p − 1)·(2^p − 1) is perfect

1.  (p − 1) + 1 = p
    algebra

2.  2^((p − 1) + 1) = 2^(p − 1)·2
    mun:exponent-step a := 2, m := p − 1
    requires p − 1 ∈ ℕ₀: mun:nat-minus-one n := p

3.  2^p = 2^(p − 1)·2
    substitute (p − 1) + 1 = p (line 1) into line 2

4.  not (2^p − 1 divides 2^(p − 1))
    contradiction
    suppose 2^p − 1 divides 2^(p − 1)                                 (S)

    4.1.  2^p − 1 divides 2^(p − 1)·2
          mun:divides-multiple e := 2^p − 1, a := 2^(p − 1), x := 2, from S
          requires p − 1 ∈ ℕ₀: mun:nat-minus-one n := p
          requires 2^(p − 1) ∈ ℕ: mun:power-nat a := 2, m := p − 1

    4.2.  2^p − 1 divides 2^p
          substitute 2^p = 2^(p − 1)·2 (line 3) into line 4.1

    4.3.  2^p − 1 divides 2^p − 1
          mun:divides-self n := 2^p − 1

    4.4.  2^p − 1 divides 2^p − (2^p − 1)
          mun:divides-difference d := 2^p − 1, a := 2^p, b := 2^p − 1, from 4.2, 4.3

    4.5.  2^p − 1 divides 1
          substitute
            2^p − 1 divides 2^p − (2^p − 1)      4.4
            2^p − 1 divides 1                    algebra

    4.6.  2^p − 1 = 1
          mun:divides-one d := 2^p − 1, from 4.5
          requires 2^p − 1 ∈ ℕ: mun:prime-nat p := 2^p − 1, from H2

    4.7.  2^p − 1 > 1
          def:prime p := 2^p − 1, from H2
          requires 2^p − 1 ∈ ℕ: mun:prime-nat p := 2^p − 1, from H2

    4.8.  2^p − 1 ≠ 1
          inequalities, contradicting 4.6
            2^p − 1 > 1      4.7
            2^p − 1 ≠ 1      weakening

5.  gcd(2^(p − 1), 2^p − 1) = 1
    calculation
      gcd(2^(p − 1), 2^p − 1) = gcd(2^p − 1, 2^(p − 1))     mun:gcd-commutes a := 2^(p − 1), b := 2^p − 1
                             = 1                            mun:prime-coprime p := 2^p − 1, a := 2^(p − 1), from H2, 4
    requires 2^p − 1 ∈ ℕ: mun:prime-nat p := 2^p − 1, from H2
    requires p − 1 ∈ ℕ₀: mun:nat-minus-one n := p
    requires 2^(p − 1) ∈ ℕ: mun:power-nat a := 2, m := p − 1

6.  σ(2^p − 1) = 2^p
    calculation
      σ(2^p − 1) = (2^p − 1) + 1      thm:sigma-prime p := 2^p − 1, from H2
                 = 2^p                algebra
    requires 2^p − 1 ∈ ℕ: mun:prime-nat p := 2^p − 1, from H2

7.  σ(2^(p − 1)) = 2^p − 1
    calculation
      σ(2^(p − 1)) = Σ(j = 0 to p − 1) 2^j            thm:sigma-prime-power p := 2, k := p − 1
                   = (1 − 2^((p − 1) + 1))/(1 − 2)    thm:geometric-sum a := 2, n := p − 1
                   = (1 − 2^p)/(1 − 2)                substitute line 1
                   = 2^p − 1                          algebra
    requires p − 1 ∈ ℕ₀: mun:nat-minus-one n := p
    requires 2 is prime: mun:two-prime
    requires 2 ≠ 1: arithmetic

8.  (2^p − 1)·2^p = 2·(2^(p − 1)·(2^p − 1))
    algebra, from 3
    requires p − 1 ∈ ℕ₀: mun:nat-minus-one n := p
    requires 2^(p − 1) ∈ ℝ: membership

9.  σ(2^(p − 1)·(2^p − 1)) = 2·(2^(p − 1)·(2^p − 1))
    calculation
      σ(2^(p − 1)·(2^p − 1)) = σ(2^(p − 1))·σ(2^p − 1)      thm:sigma-multiplicative m := 2^(p − 1), n := 2^p − 1, from 5
                             = (2^p − 1)·σ(2^p − 1)          substitute line 7
                             = (2^p − 1)·2^p                 substitute line 6
                             = 2·(2^(p − 1)·(2^p − 1))       8
    requires p − 1 ∈ ℕ₀: mun:nat-minus-one n := p
    requires 2^(p − 1) ∈ ℕ: mun:power-nat a := 2, m := p − 1
    requires 2^p − 1 ∈ ℕ: mun:prime-nat p := 2^p − 1, from H2

10. 2^(p − 1)·(2^p − 1) is perfect
    def:perfect n := 2^(p − 1)·(2^p − 1), from 9
    requires p − 1 ∈ ℕ₀: mun:nat-minus-one n := p
    requires 2^(p − 1) ∈ ℕ: mun:power-nat a := 2, m := p − 1
    requires 2^p − 1 ∈ ℕ: mun:prime-nat p := 2^p − 1, from H2

theorem odd-part
  note        Every natural number is a power of 2 times an odd number. An
              odd number is 2^0 times itself, and an even number is twice a
              smaller one, which is a power of 2 times an odd number by
              induction, with the power one higher.
  let n ∈ ℕ                                                           (H1)
  then there is k ∈ ℕ₀ with there is m ∈ ℕ with m is odd and n = 2^k·m

1.  For all N ∈ ℕ₀, for all j ∈ {1, …, N}, j is a power of two times an odd number.
    induction on N starting at 0

    base
    1.1.  For all j ∈ {1, …, 0}, j is a power of two times an odd number.
          proof
          let j ∈ {1, …, 0}                                           (K1)

          1.1.1.  1 ≤ j
                  mun:range-bounds a := 1, b := 0, k := j, from K1

          1.1.2.  j ≤ 0
                  mun:range-bounds a := 1, b := 0, k := j, from K1

          1.1.3.  not j ≤ 0
                  inequalities, from 1.1.1, contradicting 1.1.2

    step
    let N ∈ ℕ₀                                                        (K2)
    assume step 1 is true for N, the induction hypothesis             (IH)

    1.2.  For all j ∈ {1, …, N + 1}, j is a power of two times an odd number.
          proof
          let j ∈ {1, …, N + 1}                                       (K3)

          1.2.1.  1 ≤ j
                  mun:range-bounds a := 1, b := N + 1, k := j, from K3

          1.2.2.  j ≤ N + 1
                  mun:range-bounds a := 1, b := N + 1, k := j, from K3

          1.2.3.  j is even or j is odd
                  mun:even-or-odd n := j

          1.2.4.  There is k ∈ ℕ₀ with there is m ∈ ℕ with m is odd and j = 2^k·m.
                  cases, from 1.2.3

                  case
                  note j is twice a smaller number, which has the form already
                  assume j is even                                    (C1)

                  1.2.4.1.   i ∈ ℤ. j = 2i.
                             obtain i: def:even n := j, from C1

                  1.2.4.2.   1 ≤ 2i
                             substitute j = 2i (line 1.2.4.1) into line 1.2.1

                  1.2.4.3.   0 < i
                             mun:factor-positive a := 2, b := i
                             requires 2 ≥ 0: arithmetic
                             requires 2·i > 0: inequalities, from 1.2.4.2

                  1.2.4.4.   i ∈ ℕ
                             mun:pos-int-nat m := i, from 1.2.4.3

                  1.2.4.5.   i < 2i
                             inequalities
                               0 < i                1.2.4.3
                               i < i + i            adding i
                               i < 2i               algebra

                  1.2.4.6.   i < N + 1
                             transitivity, from 1.2.4.5, 1.2.4.1, 1.2.2

                  1.2.4.7.   i + 1 ≤ N + 1
                             mun:integer-step m := i, n := N + 1, from 1.2.4.6

                  1.2.4.8.   i ≤ N
                             inequalities
                               i + 1 ≤ N + 1        1.2.4.7
                               i ≤ N                adding −1

                  1.2.4.9.   i ∈ {1, …, N}
                             def:range-between k := i, a := 1, b := N, from 1.2.4.8
                             requires 1 ≤ i: inequalities, from 1.2.4.4

                  1.2.4.10.  i is a power of two times an odd number
                             instantiate j := i in IH, from 1.2.4.9

                  1.2.4.11.  There is k ∈ ℕ₀ with there is m ∈ ℕ with m is odd and i = 2^k·m.
                             D1, from 1.2.4.10

                  1.2.4.12.  k ∈ ℕ₀. m ∈ ℕ. m is odd. i = 2^k·m.
                             obtain k, m from line 1.2.4.11

                  1.2.4.13.  2^(k + 1) = 2^k·2
                             mun:exponent-step a := 2, m := k

                  1.2.4.14.  j = 2^(k + 1)·m
                             algebra, from 1.2.4.1, 1.2.4.12, 1.2.4.13

                  1.2.4.15.  There is k ∈ ℕ₀ with there is m ∈ ℕ with m is odd and j = 2^k·m.
                             exhibit, from 1.2.4.12, 1.2.4.14

                  case
                  note j is 2^0 times itself
                  assume j is odd                                     (C2)

                  1.2.4.16.  j = 2^0·j
                             algebra

                  1.2.4.17.  There is k ∈ ℕ₀ with there is m ∈ ℕ with m is odd and j = 2^k·m.
                             exhibit, from C2, 1.2.4.16

          1.2.5.  j is a power of two times an odd number
                  D1, from 1.2.4

2.  For all j ∈ {1, …, n}, j is a power of two times an odd number.
    instantiate N := n in line 1

3.  n ∈ {1, …, n}
    def:range-between k := n, a := 1, b := n
    requires 1 ≤ n: inequalities, from H1
    requires n ≤ n: inequalities

4.  n is a power of two times an odd number
    instantiate j := n in line 2, from 3

5.  There is k ∈ ℕ₀ with there is m ∈ ℕ with m is odd and n = 2^k·m.
    D1, from 4

theorem three-divisors
  note        1, e and m are three different divisors of m, and σ(m) sums
              all of them, so it is at least their sum.
  let m ∈ ℕ                                                           (H1)
  let e ∈ ℕ                                                           (H2)
  assume e divides m                                                  (H3)
  assume 1 < e                                                        (H4)
  assume e < m                                                        (H5)
  then σ(m) ≥ 1 + e + m

1.  1 divides m
    mun:one-divides n := m

2.  m divides m
    mun:divides-self n := m

3.  1 ∈ {d ∈ ℕ : d divides m}
    def:set-builder u := 1, from 1

4.  e ∈ {d ∈ ℕ : d divides m}
    def:set-builder u := e, from H3

5.  m ∈ {d ∈ ℕ : d divides m}
    def:set-builder u := m, from 2

6.  {1, e, m} ⊆ {d ∈ ℕ : d divides m}
    mun:triple-subset, from 3, 4, 5

7.  1 < m
    transitivity, from H4, H5

8.  σ(m) ≥ 1 + e + m
    calculation
      σ(m) ≥ Σ(d ∈ {1, e, m}) d            mun:sigma-part n := m, Y := {1, e, m}, from 6
           = 1 + e + m                      mun:sum-of-three a := 1, b := e, c := m
    requires 1 ≠ e: weakening, from H4
    requires 1 ≠ m: weakening, from 7
    requires e ≠ m: weakening, from H5

theorem euler-perfect
  metamath    perfect
  note        Write the number as 2^k·m with m odd. σ multiplies, so
              (2^(k + 1) − 1)·σ(m) = 2^(k + 1)·m, and 2^(k + 1) − 1 divides
              m, say m = (2^(k + 1) − 1)·c. Then σ(m) = m + c, and m has no
              divisor beyond 1, c and m; so c = 1, and m = 2^(k + 1) − 1 has
              no divisor but 1 and itself.
  let n ∈ ℕ                                                           (H1)
  assume n is even                                                    (H2)
  assume n is perfect                                                 (H3)
  then there is p ∈ ℕ with 2^p − 1 is prime and n = 2^(p − 1)·(2^p − 1)

1.  k ∈ ℕ₀. m ∈ ℕ. m is odd. n = 2^k·m.
    obtain k, m: thm:odd-part

2.  k ≠ 0
    contradiction
    suppose k = 0                                                     (S1)

    2.1.  n = 2^0·m
          substitute k = 0 (S1) into line 1

    2.2.  n = m
          calculation
            n = 2^0·m       2.1
              = m           algebra

    2.3.  n is odd
          substitute n = m (line 2.2) into line 1

    2.4.  n is not odd
          mun:not-both, from H2, contradicting 2.3

3.  k ∈ ℕ
    mun:nat0-nonzero m := k, from 2

let p = k + 1, a positive integer                                     (D2)
    mun:nat0-successor
    reads the exponent of 2 in the prime 2^p − 1

4.  1 < p
    inequalities, from D2, 3

5.  2^1 < 2^p
    mun:power-order a := 2, m := 1, n := p, from 4
    requires 2 > 1: arithmetic

6.  2^p − 1 > 1
    inequalities, from 5

7.  2^p − 1 ∈ ℕ
    mun:pos-int-nat
    requires 0 < 2^p − 1: inequalities, from 6

8.  2^p = 2^k·2
    mun:exponent-step a := 2, m := k, from D2

9.  not (2 divides 2^p − 1)
    contradiction
    suppose 2 divides 2^p − 1                                         (S2)

    9.1.  2 divides 2
          mun:divides-self n := 2

    9.2.  2 divides 2·2^k
          mun:divides-multiple e := 2, a := 2, x := 2^k, from 9.1

    9.3.  2 divides 2^p
          substitute
            2 divides 2·2^k      9.2
            2 divides 2^p        algebra, from 8

    9.4.  2 divides 2^p − (2^p − 1)
          mun:divides-difference d := 2, a := 2^p, b := 2^p − 1, from S2, 9.3

    9.5.  2 divides 1
          substitute
            2 divides 2^p − (2^p − 1)      9.4
            2 divides 1                    algebra

    9.6.  2 = 1, which is impossible
          mun:divides-one d := 2, from 9.5

10. gcd(2, 2^p − 1) = 1
    mun:prime-coprime p := 2, a := 2^p − 1, from 9
    requires 2 is prime: mun:two-prime

11. gcd(2^p, 2^p − 1) = 1
    mun:coprime-power a := 2, b := 2^p − 1, k := p, from 10

12. gcd(2, m) = 1
    mun:prime-coprime p := 2, a := m
    requires 2 is prime: mun:two-prime
    requires not (2 divides m): mun:odd-not-divisible n := m, from 1

13. gcd(2^k, m) = 1
    mun:coprime-power a := 2, b := m, from 12

14. σ(2^k) = 2^p − 1
    calculation
      σ(2^k) = Σ(j = 0 to k) 2^j               thm:sigma-prime-power p := 2
             = (1 − 2^(k + 1))/(1 − 2)         thm:geometric-sum a := 2, n := k
             = 2^p − 1                         algebra, from D2
    requires 2 is prime: mun:two-prime
    requires 2 ≠ 1: arithmetic
    requires 2^(k + 1) ∈ ℕ: mun:power-nat a := 2, m := k + 1

15. (2^p − 1)·σ(m) = 2^p·m
    calculation
      (2^p − 1)·σ(m) = σ(2^k)·σ(m)       substitute line 14
                     = σ(2^k·m)           thm:sigma-multiplicative m := 2^k, n := m, from 13
                     = σ(n)               substitute line 1
                     = 2n                 def:perfect, from H3
                     = 2^p·m              algebra, from 1, 8

16. σ(m) ∈ ℕ
    mun:sigma-nat n := m

17. m·2^p = (2^p − 1)·σ(m)
    algebra, from 15
    requires σ(m) ∈ ℝ: from 16

18. 2^p − 1 divides m·2^p
    def:divides d := 2^p − 1, n := m·2^p, from 16, 17

19. 2^p − 1 divides m
    thm:coprime-divides x := m, c := 2^p, n := 2^p − 1, from 7, 11, 18

let c = m/(2^p − 1), a positive integer                               (D3)
    mun:divides-quotient n := m, d := 2^p − 1, from 7, 19
    reads m with the factor 2^p − 1 taken out

20. m = (2^p − 1)·c
    algebra, from D3
    requires 2^p − 1 ≠ 0: from 7

21. σ(m)·(2^p − 1) = (2^p·c)·(2^p − 1)
    algebra, from 15, 20
    requires σ(m) ∈ ℝ: from 16

22. σ(m) = m + c
    calculation
      σ(m) = 2^p·c       mun:multiply-cancel a := σ(m), b := 2^p·c, c := 2^p − 1, from 21
           = m + c       algebra, from 20
    requires σ(m) ∈ ℝ: from 16
    requires 2^p − 1 ≠ 0: from 7

23. c = 1
    contradiction
    note were c more than 1, m would have the three divisors 1, c and m
    suppose c ≠ 1                                                     (S3)

    23.1.  2^p − 1 − 1 > 0
           inequalities, from 6

    23.2.  (2^p − 1 − 1)·c > 0
           mun:product-positive x := 2^p − 1 − 1, y := c, from D3, 23.1

    23.3.  m − c > 0
           substitute
             (2^p − 1 − 1)·c > 0      23.2
             m − c > 0                algebra, from 20

    23.4.  c < m
           inequalities
             m − c > 0        23.3
             m > c            adding c
             c < m            restate

    23.5.  1 < c
           inequalities, from D3, S3
           requires 2^p − 1 ≠ 0: from 7

    23.6.  m = c·(2^p − 1)
           algebra, from 20

    23.7.  c divides m
           def:divides d := c, n := m, from 23.6

    23.8.  σ(m) ≥ 1 + c + m
           thm:three-divisors e := c, from 23.4, 23.5, 23.7

    23.9.  1 + c + m ≤ m + c
           transitivity, from 23.8, 22

    23.10. 1 ≤ 0, which is impossible
           inequalities
             1 + c + m ≤ m + c        23.9
             1 ≤ 0                    adding −c − m

24. m = 2^p − 1
    substitute c = 1 (line 23) into line 20

25. σ(m) = m + 1
    substitute c = 1 (line 23) into line 22

26. For all d ∈ ℕ, if d divides m then d = 1 or d = m.
    proof
    note a divisor other than 1 and m would make σ(m) more than m + 1
    let d ∈ ℕ                                                         (K1)
    assume d divides m                                                (A1)

    26.1.  d = 1 or d ≠ 1
           axi:excluded-middle P := d = 1

    26.2.  d = 1 or d = m
           cases, from 26.1

           case
           assume d = 1                                               (C1)

           26.2.1.  d = 1 or d = m
                    mun:or-left, from C1

           case
           assume d ≠ 1                                               (C2)

           26.2.2.  d = m or d ≠ m
                    axi:excluded-middle P := d = m

           26.2.3.  d = 1 or d = m
                    cases, from 26.2.2

                    case
                    assume d = m                                      (C3)

                    26.2.3.1.  d = 1 or d = m
                               mun:or-right, from C3

                    case
                    assume d ≠ m                                      (C4)

                    26.2.3.2.  d ≤ m
                               mun:divides-le e := d, from A1

                    26.2.3.3.  1 < d
                               inequalities, from C2, K1

                    26.2.3.4.  d < m
                               inequalities, from C4, 26.2.3.2

                    26.2.3.5.  σ(m) ≥ 1 + d + m
                               thm:three-divisors e := d, from A1, 26.2.3.3, 26.2.3.4

                    26.2.3.6.  1 + d + m ≤ m + 1
                               transitivity, from 26.2.3.5, 25

                    26.2.3.7.  d ≤ 0
                               inequalities
                                 1 + d + m ≤ m + 1        26.2.3.6
                                 d ≤ 0                    adding −1 − m

                    26.2.3.8.  not 1 < d
                               inequalities, from 26.2.3.7, contradicting 26.2.3.3

27. m > 1
    substitute m = 2^p − 1 (line 24) into line 6

28. m is prime
    def:prime p := m, from 26, 27

29. 2^p − 1 is prime
    substitute m = 2^p − 1 (line 24) into line 28

30. p − 1 = k
    algebra, from D2

31. n = 2^(p − 1)·(2^p − 1)
    calculation
      n = 2^k·m                       1
        = 2^(p − 1)·m                 substitute line 30
        = 2^(p − 1)·(2^p − 1)         substitute line 24

32. There is p ∈ ℕ with 2^p − 1 is prime and n = 2^(p − 1)·(2^p − 1).
    exhibit, from 29, 31
