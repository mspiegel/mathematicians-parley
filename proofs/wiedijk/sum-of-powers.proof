import definition         stdlib/polynomials/B
import theorem            stdlib/polynomials/bernoulli-difference
import theorem            stdlib/sums/sum-telescopes-up
import mundane theorem    stdlib/numbers/nat0-successor
import mundane theorem    stdlib/polynomials/bernoulli-complex
import mundane theorem    stdlib/sums/sum-scaled
import mundane theorem    stdlib/sums/sum-termwise-complex

theorem sum-of-powers
  metamath    fsumkthpow
  note        B(k + 1, n + 1) − B(k + 1, n) = (k + 1)·n^k, so (k + 1) times
              the sum of the n^k telescopes to B(k + 1, m + 1) − B(k + 1, 0).
  let k ∈ ℕ₀                                                          (H1)
  let m ∈ ℕ₀                                                          (H2)
  then Σ(n = 0 to m) n^k = (B(k + 1, m + 1) − B(k + 1, 0))/(k + 1)

1.  For all n ∈ {0, …, m}, B(k + 1, n + 1) − B(k + 1, n) = (k + 1)·n^k.
    proof
    let n ∈ {0, …, m}                                                 (K1)

    1.1.  B(k + 1, n + 1) − B(k + 1, n) = (k + 1)·n^((k + 1) − 1)
          thm:bernoulli-difference n := k + 1, x := n
          requires k + 1 ∈ ℕ: mun:nat0-successor

    1.2.  (k + 1) − 1 = k
          algebra

    1.3.  B(k + 1, n + 1) − B(k + 1, n) = (k + 1)·n^k
          substitute (k + 1) − 1 = k (line 1.2) into line 1.1

2.  Σ(n = 0 to m) (B(k + 1, n + 1) − B(k + 1, n)) = Σ(n = 0 to m) (k + 1)·n^k
    mun:sum-termwise-complex a := 0, b := m, from 1

3.  Σ(n = 0 to m) (B(k + 1, n + 1) − B(k + 1, n)) = B(k + 1, m + 1) − B(k + 1, 0)
    thm:sum-telescopes-up a := 0, b := m
    requires m + 1 ≥ 0: inequalities, from H2

4.  (k + 1)·(Σ(n = 0 to m) n^k) = Σ(n = 0 to m) (k + 1)·n^k
    mun:sum-scaled a := 0, b := m, c := k + 1

5.  (k + 1)·(Σ(n = 0 to m) n^k) = B(k + 1, m + 1) − B(k + 1, 0)
    calculation
      (k + 1)·(Σ(n = 0 to m) n^k) = Σ(n = 0 to m) (k + 1)·n^k                          4
                                  = Σ(n = 0 to m) (B(k + 1, n + 1) − B(k + 1, n))      2
                                  = B(k + 1, m + 1) − B(k + 1, 0)                      3

6.  Σ(n = 0 to m) n^k = (B(k + 1, m + 1) − B(k + 1, 0))/(k + 1)
    algebra, from 5
    requires k + 1 ∈ ℕ: mun:nat0-successor
    requires B(k + 1, m + 1) ∈ ℂ: mun:bernoulli-complex n := k + 1, x := m + 1
    requires B(k + 1, 0) ∈ ℂ: mun:bernoulli-complex n := k + 1, x := 0
