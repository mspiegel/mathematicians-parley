import definition         stdlib/trigonometry/cos
import theorem            stdlib/trigonometry/cos-add
import mundane theorem    stdlib/trigonometry/cos-real
import definition         stdlib/trigonometry/sin
import theorem            stdlib/trigonometry/sin-add
import mundane theorem    stdlib/trigonometry/sin-cos-squares
import mundane theorem    stdlib/trigonometry/sin-negative
import mundane theorem    stdlib/trigonometry/sin-real
import mundane theorem    stdlib/trigonometry/cos-supplement
import theorem            stdlib/geometry/intersecting-chords
import axiom              stdlib/geometry/supplementary-angles
import theorem            stdlib/geometry/law-of-cosines
import mundane theorem    stdlib/geometry/segment-addition
import mundane theorem    stdlib/geometry/between-apart
import mundane theorem    stdlib/geometry/between-symmetric
import mundane theorem    stdlib/geometry/angle-real
import mundane theorem    stdlib/geometry/distance-nonneg
import axiom              stdlib/geometry/distance-positive
import mundane theorem    stdlib/numbers/square-equal
import mundane theorem    stdlib/numbers/product-nonneg
import mundane theorem    stdlib/numbers/multiply-cancel

theorem ptolemy
  note        Ptolemy's theorem as set.mm states it, of the angles a cyclic
              quadrilateral's sides subtend: four angles adding to π. Since
              d = π − (a + b + c), sin(d) = sin(a + b + c); the addition
              formulas write both sides in sines and cosines of a, b and c,
              and they differ by sin(a)·sin(b)·(1 − sin(c)² − cos(c)²), which
              is 0.
  let a ∈ ℝ                                                           (H1)
  let b ∈ ℝ                                                           (H2)
  let c ∈ ℝ                                                           (H3)
  let d ∈ ℝ                                                           (H4)
  assume a + b + c + d = π                                            (H5)
  then sin(a)·sin(b) + sin(c)·sin(d) = sin(b + c)·sin(a + c)

1.  d = π + (−(a + b + c))
    algebra, from H5

2.  sin(π)·cos(−(a + b + c)) + cos(π)·sin(−(a + b + c)) = 0·cos(−(a + b + c)) + cos(π)·sin(−(a + b + c))
    substitute sin(π) = 0 (real arithmetic)

3.  0·cos(−(a + b + c)) + cos(π)·sin(−(a + b + c)) = 0·cos(−(a + b + c)) + (−1)·sin(−(a + b + c))
    substitute cos(π) = −1 (real arithmetic)

4.  sin(−(a + b + c)) = −sin(a + b + c)
    mun:sin-negative a := a + b + c

5.  sin(d) = sin(a + b + c)
    calculation
      sin(d) = sin(π + (−(a + b + c)))                                    substitute line 1
             = sin(π)·cos(−(a + b + c)) + cos(π)·sin(−(a + b + c))         thm:sin-add a := π, b := −(a + b + c)
             = 0·cos(−(a + b + c)) + cos(π)·sin(−(a + b + c))              2
             = 0·cos(−(a + b + c)) + (−1)·sin(−(a + b + c))                3
             = 0·cos(−(a + b + c)) + (−1)·(−sin(a + b + c))                substitute line 4
             = sin(a + b + c)                                              algebra
    requires cos(−(a + b + c)) ∈ ℝ: mun:cos-real a := −(a + b + c)
    requires sin(a + b + c) ∈ ℝ: mun:sin-real a := a + b + c

6.  sin(a + b + c) = sin(a + b)·cos(c) + cos(a + b)·sin(c)
    thm:sin-add a := a + b, b := c

7.  sin(a + b) = sin(a)·cos(b) + cos(a)·sin(b)
    thm:sin-add

8.  cos(a + b) = cos(a)·cos(b) − sin(a)·sin(b)
    thm:cos-add

9.  sin(b + c) = sin(b)·cos(c) + cos(b)·sin(c)
    thm:sin-add a := b, b := c

10. sin(a + c) = sin(a)·cos(c) + cos(a)·sin(c)
    thm:sin-add b := c

11. sin(c)² + cos(c)² = 1
    mun:sin-cos-squares a := c

12. sin(a)·sin(b) + sin(c)·sin(d) = sin(b + c)·sin(a + c)
    calculation
      sin(a)·sin(b) + sin(c)·sin(d) = sin(a)·sin(b) + sin(c)·sin(a + b + c)                                                substitute line 5
          = sin(a)·sin(b) + sin(c)·(sin(a + b)·cos(c) + cos(a + b)·sin(c))                                                 substitute line 6
          = sin(a)·sin(b) + sin(c)·((sin(a)·cos(b) + cos(a)·sin(b))·cos(c) + cos(a + b)·sin(c))                            substitute line 7
          = sin(a)·sin(b) + sin(c)·((sin(a)·cos(b) + cos(a)·sin(b))·cos(c) + (cos(a)·cos(b) − sin(a)·sin(b))·sin(c))       substitute line 8
          = (sin(b)·cos(c) + cos(b)·sin(c))·(sin(a)·cos(c) + cos(a)·sin(c))                                                algebra, from 11
          = sin(b + c)·(sin(a)·cos(c) + cos(a)·sin(c))                                                                     substitute line 9
          = sin(b + c)·sin(a + c)                                                                                          substitute line 10
    requires sin(a) ∈ ℝ: mun:sin-real
    requires cos(a) ∈ ℝ: mun:cos-real
    requires sin(b) ∈ ℝ: mun:sin-real a := b
    requires cos(b) ∈ ℝ: mun:cos-real a := b
    requires sin(c) ∈ ℝ: mun:sin-real a := c
    requires cos(c) ∈ ℝ: mun:cos-real a := c

theorem cyclic-ptolemy
  note        Ptolemy's theorem of four points in order on a circle, said by
              their diagonals crossing at P. The chords cross, so
              |PA|·|PC| = |PB|·|PD|; the four angles at P are θ, 180° − θ, θ
              and 180° − θ; and the law of cosines in the four triangles at P,
              with |PC| = |PB|·|PD|/|PA|, gives |CD| = (|PD|/|PA|)·|AB| and
              |BC| = (|PB|/|PA|)·|AD|. The cosine terms then cancel, and what
              is left is (|PA| + |PC|)·(|PB| + |PD|) = |AC|·|BD|.
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  let D be a point                                                    (H4)
  let O be a point                                                    (H5)
  let P be a point                                                    (H6)
  assume |AO| = |BO|                                                  (H7)
  assume |AO| = |CO|                                                  (H8)
  assume |AO| = |DO|                                                  (H9)
  assume P is between A and C                                         (H10)
  assume P is between B and D                                         (H11)
  then |AC|·|BD| = |AB|·|CD| + |AD|·|BC|

1.  A ≠ P. C ≠ P.
    mun:between-apart R := P, S := A, T := C, from H10

2.  B ≠ P. D ≠ P.
    mun:between-apart R := P, S := B, T := D, from H11

3.  |PA|·|PC| = |PB|·|PD|
    thm:intersecting-chords B := C, C := B, from H7, H8, H9, H10, H11

4.  ∠APB + ∠BPC = 180°
    axi:supplementary-angles B := P, D := B, from H10, 2

5.  ∠BPC + ∠CPD = 180°
    axi:supplementary-angles A := B, B := P, C := D, D := C, from H11, 1

6.  P is between C and A
    mun:between-symmetric R := P, S := A, T := C, from H10

7.  ∠CPD + ∠DPA = 180°
    axi:supplementary-angles A := C, B := P, C := A, from 2, 6

8.  ∠CPD = ∠APB
    algebra, from 4, 5
    requires ∠APB ∈ ℝ: mun:angle-real P := A, Q := P, R := B, from 1, 2
    requires ∠BPC ∈ ℝ: mun:angle-real P := B, Q := P, R := C, from 1, 2
    requires ∠CPD ∈ ℝ: mun:angle-real P := C, Q := P, R := D, from 1, 2

9.  cos(180° − ∠APB) = −cos(∠APB)
    mun:cos-supplement x := ∠APB
    requires ∠APB ∈ ℝ: mun:angle-real P := A, Q := P, R := B, from 1, 2

10. |BA|² = |AP|² + |PB|² − 2·(|AP|·|PB|·cos(∠APB))
    thm:law-of-cosines P := A, Q := P, R := B, from 1, 2

11. |CB|² = |BP|² + |PC|² − 2·(|BP|·|PC|·cos(∠BPC))
    thm:law-of-cosines P := B, Q := P, R := C, from 1, 2

12. |CB|² = |BP|² + |PC|² − 2·(|BP|·|PC|·(−cos(∠APB)))
    substitute
      |CB|² = |BP|² + |PC|² − 2·(|BP|·|PC|·cos(∠BPC))             11
      |CB|² = |BP|² + |PC|² − 2·(|BP|·|PC|·cos(180° − ∠APB))      algebra, from 4
      |CB|² = |BP|² + |PC|² − 2·(|BP|·|PC|·(−cos(∠APB)))          substitute line 9
    requires ∠APB ∈ ℝ: mun:angle-real P := A, Q := P, R := B, from 1, 2
    requires ∠BPC ∈ ℝ: mun:angle-real P := B, Q := P, R := C, from 1, 2

13. |DC|² = |CP|² + |PD|² − 2·(|CP|·|PD|·cos(∠CPD))
    thm:law-of-cosines P := C, Q := P, R := D, from 1, 2

14. |DC|² = |CP|² + |PD|² − 2·(|CP|·|PD|·cos(∠APB))
    substitute ∠CPD = ∠APB (line 8) into line 13

15. |AD|² = |DP|² + |PA|² − 2·(|DP|·|PA|·cos(∠DPA))
    thm:law-of-cosines P := D, Q := P, R := A, from 1, 2

16. |AD|² = |DP|² + |PA|² − 2·(|DP|·|PA|·(−cos(∠APB)))
    substitute
      |AD|² = |DP|² + |PA|² − 2·(|DP|·|PA|·cos(∠DPA))             15
      |AD|² = |DP|² + |PA|² − 2·(|DP|·|PA|·cos(180° − ∠APB))      algebra, from 7, 8
      |AD|² = |DP|² + |PA|² − 2·(|DP|·|PA|·(−cos(∠APB)))          substitute line 9
    requires ∠CPD ∈ ℝ: mun:angle-real P := C, Q := P, R := D, from 1, 2
    requires ∠DPA ∈ ℝ: mun:angle-real P := D, Q := P, R := A, from 1, 2

17. cos(∠APB) ∈ ℝ
    mun:cos-real a := ∠APB
    requires ∠APB ∈ ℝ: mun:angle-real P := A, Q := P, R := B, from 1, 2

18. (|PA|·|PC|)² = (|PB|·|PD|)²
    algebra, from 3

19. |PA|·|PD|·cos(∠APB)·(|PA|·|PC|) = |PA|·|PD|·cos(∠APB)·(|PB|·|PD|)
    algebra, from 3
    requires cos(∠APB) ∈ ℝ: from 17

20. |PA|·|PB|·cos(∠APB)·(|PA|·|PC|) = |PA|·|PB|·cos(∠APB)·(|PB|·|PD|)
    algebra, from 3
    requires cos(∠APB) ∈ ℝ: from 17

21. |DC|²·|PA|² = |PD|²·|BA|²
    calculation
      |DC|²·|PA|² = (|CP|² + |PD|² − 2·(|CP|·|PD|·cos(∠APB)))·|PA|²                                algebra, from 14
                  = (|PA|·|PC|)² + |PA|²·|PD|² − 2·(|PA|·|PD|·cos(∠APB)·(|PA|·|PC|))               algebra
                  = (|PB|·|PD|)² + |PA|²·|PD|² − 2·(|PA|·|PD|·cos(∠APB)·(|PB|·|PD|))               algebra, from 18, 19
                  = |PD|²·(|AP|² + |PB|² − 2·(|AP|·|PB|·cos(∠APB)))                                algebra
                  = |PD|²·|BA|²                                                                    algebra, from 10
    requires cos(∠APB) ∈ ℝ: from 17

22. |CB|²·|PA|² = |PB|²·|AD|²
    calculation
      |CB|²·|PA|² = (|BP|² + |PC|² − 2·(|BP|·|PC|·(−cos(∠APB))))·|PA|²                              algebra, from 12
                  = |PA|²·|PB|² + (|PA|·|PC|)² + 2·(|PA|·|PB|·cos(∠APB)·(|PA|·|PC|))               algebra
                  = |PA|²·|PB|² + (|PB|·|PD|)² + 2·(|PA|·|PB|·cos(∠APB)·(|PB|·|PD|))               algebra, from 18, 20
                  = |PB|²·(|DP|² + |PA|² − 2·(|DP|·|PA|·(−cos(∠APB))))                             algebra
                  = |PB|²·|AD|²                                                                    algebra, from 16
    requires cos(∠APB) ∈ ℝ: from 17

23. |DC| ≥ 0
    mun:distance-nonneg P := D, Q := C

24. |PA| ≥ 0
    mun:distance-nonneg Q := A

25. |PD| ≥ 0
    mun:distance-nonneg Q := D

26. |BA| ≥ 0
    mun:distance-nonneg P := B, Q := A

27. |CB| ≥ 0
    mun:distance-nonneg P := C, Q := B

28. |PB| ≥ 0
    mun:distance-nonneg Q := B

29. |AD| ≥ 0
    mun:distance-nonneg P := A, Q := D

30. |DC|·|PA| ≥ 0
    mun:product-nonneg x := |DC|, y := |PA|, from 23, 24

31. |PD|·|BA| ≥ 0
    mun:product-nonneg x := |PD|, y := |BA|, from 25, 26

32. |CB|·|PA| ≥ 0
    mun:product-nonneg x := |CB|, y := |PA|, from 24, 27

33. |PB|·|AD| ≥ 0
    mun:product-nonneg x := |PB|, y := |AD|, from 28, 29

34. (|DC|·|PA|)² = (|PD|·|BA|)²
    algebra, from 21

35. |DC|·|PA| = |PD|·|BA|
    mun:square-equal x := |DC|·|PA|, y := |PD|·|BA|, from 30, 31, 34

36. (|CB|·|PA|)² = (|PB|·|AD|)²
    algebra, from 22

37. |CB|·|PA| = |PB|·|AD|
    mun:square-equal x := |CB|·|PA|, y := |PB|·|AD|, from 32, 33, 36

38. |AB|·(|DC|·|PA|) = |AB|·(|PD|·|BA|)
    algebra, from 35

39. |AD|·(|CB|·|PA|) = |AD|·(|PB|·|AD|)
    algebra, from 37

40. |PD|·|BA|² = |PD|·(|AP|² + |PB|² − 2·(|AP|·|PB|·cos(∠APB)))
    algebra, from 10
    requires cos(∠APB) ∈ ℝ: from 17

41. |PB|·|AD|² = |PB|·(|DP|² + |PA|² − 2·(|DP|·|PA|·(−cos(∠APB))))
    algebra, from 16
    requires cos(∠APB) ∈ ℝ: from 17

42. (|PB| + |PD|)·(|PA|² + |PB|·|PD|) = ((|AP| + |PC|)·(|BP| + |PD|))·|PA|
    algebra, from 3

43. (|PB| + |PD|)·(|PA|² + |PB|·|PD|) = (|AC|·(|BP| + |PD|))·|PA|
    substitute
      (|PB| + |PD|)·(|PA|² + |PB|·|PD|) = ((|AP| + |PC|)·(|BP| + |PD|))·|PA|      42
      (|PB| + |PD|)·(|PA|² + |PB|·|PD|) = (|AC|·(|BP| + |PD|))·|PA|               mun:segment-addition P := A, Q := C, S := P, from H10

44. (|PB| + |PD|)·(|PA|² + |PB|·|PD|) = (|AC|·|BD|)·|PA|
    substitute
      (|PB| + |PD|)·(|PA|² + |PB|·|PD|) = (|AC|·(|BP| + |PD|))·|PA|      43
      (|PB| + |PD|)·(|PA|² + |PB|·|PD|) = (|AC|·|BD|)·|PA|               mun:segment-addition P := B, Q := D, S := P, from H11

45. (|AB|·|CD| + |AD|·|BC|)·|PA| = (|AC|·|BD|)·|PA|
    calculation
      (|AB|·|CD| + |AD|·|BC|)·|PA| = |PD|·|BA|² + |PB|·|AD|²                                                        algebra, from 38, 39
                                  = |PD|·(|AP|² + |PB|² − 2·(|AP|·|PB|·cos(∠APB))) + |PB|·(|DP|² + |PA|² − 2·(|DP|·|PA|·(−cos(∠APB))))   algebra, from 40, 41
                                  = (|PB| + |PD|)·(|PA|² + |PB|·|PD|)                                                algebra
                                  = (|AC|·|BD|)·|PA|                                                                 44
    requires cos(∠APB) ∈ ℝ: from 17

46. |PA| > 0
    axi:distance-positive Q := A, from 1

47. |AC|·|BD| = |AB|·|CD| + |AD|·|BC|
    mun:multiply-cancel a := |AC|·|BD|, b := |AB|·|CD| + |AD|·|BC|, c := |PA|, from 45
    requires |PA| ≠ 0: weakening, from 46
