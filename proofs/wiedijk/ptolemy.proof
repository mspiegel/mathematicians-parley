import mundane definition stdlib/trigonometry/cos
import theorem            stdlib/trigonometry/cos-add
import mundane theorem    stdlib/trigonometry/cos-real
import mundane definition stdlib/trigonometry/sin
import theorem            stdlib/trigonometry/sin-add
import mundane theorem    stdlib/trigonometry/sin-cos-squares
import mundane theorem    stdlib/trigonometry/sin-negative
import mundane theorem    stdlib/trigonometry/sin-real

theorem ptolemy
  note        Ptolemy's theorem as set.mm states it, of the angles a cyclic
              quadrilateral's sides subtend: four angles adding to π. Since
              d = π − (a + b + c), sin(d) = sin(a + b + c); the addition
              formulas write both sides in sines and cosines of a, b and c,
              and they differ by sin(a)·sin(b)·(1 − sin(c)² − cos(c)²), which
              is 0.
  let a ∈ ℝ                                                           (H1)
  let b ∈ ℝ                                                           (H2)
  let c ∈ ℝ                                                           (H3)
  let d ∈ ℝ                                                           (H4)
  assume a + b + c + d = π                                            (H5)
  then sin(a)·sin(b) + sin(c)·sin(d) = sin(b + c)·sin(a + c)

1.  d = π + (−(a + b + c))
    algebra, from H5

2.  sin(d) = sin(π + (−(a + b + c)))
    substitute d = π + (−(a + b + c)) (line 1)

3.  sin(π + (−(a + b + c))) = sin(π)·cos(−(a + b + c)) + cos(π)·sin(−(a + b + c))
    thm:sin-add a := π, b := −(a + b + c)

4.  sin(π)·cos(−(a + b + c)) + cos(π)·sin(−(a + b + c)) = 0·cos(−(a + b + c)) + cos(π)·sin(−(a + b + c))
    substitute sin(π) = 0 (real arithmetic)

5.  0·cos(−(a + b + c)) + cos(π)·sin(−(a + b + c)) = 0·cos(−(a + b + c)) + (−1)·sin(−(a + b + c))
    substitute cos(π) = −1 (real arithmetic)

6.  sin(−(a + b + c)) = −sin(a + b + c)
    mun:sin-negative a := a + b + c

7.  0·cos(−(a + b + c)) + (−1)·sin(−(a + b + c)) = 0·cos(−(a + b + c)) + (−1)·(−sin(a + b + c))
    substitute sin(−(a + b + c)) = −sin(a + b + c) (line 6)

8.  0·cos(−(a + b + c)) + (−1)·(−sin(a + b + c)) = sin(a + b + c)
    algebra
    requires cos(−(a + b + c)) ∈ ℝ: mun:cos-real a := −(a + b + c)
    requires sin(a + b + c) ∈ ℝ: mun:sin-real a := a + b + c

9.  sin(d) = sin(a + b + c)
    calculation
      sin(d) = sin(π + (−(a + b + c)))                                    2
             = sin(π)·cos(−(a + b + c)) + cos(π)·sin(−(a + b + c))         3
             = 0·cos(−(a + b + c)) + cos(π)·sin(−(a + b + c))              4
             = 0·cos(−(a + b + c)) + (−1)·sin(−(a + b + c))                5
             = 0·cos(−(a + b + c)) + (−1)·(−sin(a + b + c))                7
             = sin(a + b + c)                                              8

10. sin(a + b + c) = sin(a + b)·cos(c) + cos(a + b)·sin(c)
    thm:sin-add a := a + b, b := c

11. sin(a + b) = sin(a)·cos(b) + cos(a)·sin(b)
    thm:sin-add a := a, b := b

12. cos(a + b) = cos(a)·cos(b) − sin(a)·sin(b)
    thm:cos-add a := a, b := b

13. sin(b + c) = sin(b)·cos(c) + cos(b)·sin(c)
    thm:sin-add a := b, b := c

14. sin(a + c) = sin(a)·cos(c) + cos(a)·sin(c)
    thm:sin-add a := a, b := c

15. sin(c)² + cos(c)² = 1
    mun:sin-cos-squares a := c

16. sin(a)·sin(b) + sin(c)·sin(d) = sin(a)·sin(b) + sin(c)·sin(a + b + c)
    substitute sin(d) = sin(a + b + c) (line 9)

17. sin(a)·sin(b) + sin(c)·sin(a + b + c) = sin(a)·sin(b) + sin(c)·(sin(a + b)·cos(c) + cos(a + b)·sin(c))
    substitute sin(a + b + c) = sin(a + b)·cos(c) + cos(a + b)·sin(c) (line 10)

18. sin(a)·sin(b) + sin(c)·(sin(a + b)·cos(c) + cos(a + b)·sin(c)) = sin(a)·sin(b) + sin(c)·((sin(a)·cos(b) + cos(a)·sin(b))·cos(c) + cos(a + b)·sin(c))
    substitute sin(a + b) = sin(a)·cos(b) + cos(a)·sin(b) (line 11)

19. sin(a)·sin(b) + sin(c)·((sin(a)·cos(b) + cos(a)·sin(b))·cos(c) + cos(a + b)·sin(c)) = sin(a)·sin(b) + sin(c)·((sin(a)·cos(b) + cos(a)·sin(b))·cos(c) + (cos(a)·cos(b) − sin(a)·sin(b))·sin(c))
    substitute cos(a + b) = cos(a)·cos(b) − sin(a)·sin(b) (line 12)

20. sin(a)·sin(b) + sin(c)·((sin(a)·cos(b) + cos(a)·sin(b))·cos(c) + (cos(a)·cos(b) − sin(a)·sin(b))·sin(c)) = (sin(b)·cos(c) + cos(b)·sin(c))·(sin(a)·cos(c) + cos(a)·sin(c))
    algebra, from 15
    requires sin(a) ∈ ℝ: mun:sin-real a := a
    requires cos(a) ∈ ℝ: mun:cos-real a := a
    requires sin(b) ∈ ℝ: mun:sin-real a := b
    requires cos(b) ∈ ℝ: mun:cos-real a := b
    requires sin(c) ∈ ℝ: mun:sin-real a := c
    requires cos(c) ∈ ℝ: mun:cos-real a := c

21. (sin(b)·cos(c) + cos(b)·sin(c))·(sin(a)·cos(c) + cos(a)·sin(c)) = sin(b + c)·(sin(a)·cos(c) + cos(a)·sin(c))
    substitute sin(b)·cos(c) + cos(b)·sin(c) = sin(b + c) (line 13)

22. sin(b + c)·(sin(a)·cos(c) + cos(a)·sin(c)) = sin(b + c)·sin(a + c)
    substitute sin(a)·cos(c) + cos(a)·sin(c) = sin(a + c) (line 14)

23. sin(a)·sin(b) + sin(c)·sin(d) = sin(b + c)·sin(a + c)
    calculation
      sin(a)·sin(b) + sin(c)·sin(d) = sin(a)·sin(b) + sin(c)·sin(a + b + c)                                                16
          = sin(a)·sin(b) + sin(c)·(sin(a + b)·cos(c) + cos(a + b)·sin(c))                                                 17
          = sin(a)·sin(b) + sin(c)·((sin(a)·cos(b) + cos(a)·sin(b))·cos(c) + cos(a + b)·sin(c))                            18
          = sin(a)·sin(b) + sin(c)·((sin(a)·cos(b) + cos(a)·sin(b))·cos(c) + (cos(a)·cos(b) − sin(a)·sin(b))·sin(c))       19
          = (sin(b)·cos(c) + cos(b)·sin(c))·(sin(a)·cos(c) + cos(a)·sin(c))                                                20
          = sin(b + c)·(sin(a)·cos(c) + cos(a)·sin(c))                                                                     21
          = sin(b + c)·sin(a + c)                                                                                          22
