import definition         stdlib/trigonometry/cos
import theorem            stdlib/trigonometry/cos-add
import mundane theorem    stdlib/trigonometry/cos-real
import definition         stdlib/trigonometry/sin
import theorem            stdlib/trigonometry/sin-add
import mundane theorem    stdlib/trigonometry/sin-cos-squares
import mundane theorem    stdlib/trigonometry/sin-negative
import mundane theorem    stdlib/trigonometry/cos-supplement
import theorem            stdlib/geometry/intersecting-chords
import axiom              stdlib/geometry/supplementary-angles
import theorem            stdlib/geometry/law-of-cosines
import mundane theorem    stdlib/geometry/segment-addition
import mundane theorem    stdlib/geometry/between-apart
import mundane theorem    stdlib/geometry/distance-nonneg
import axiom              stdlib/geometry/distance-positive
import mundane theorem    stdlib/numbers/square-equal
import mundane theorem    stdlib/numbers/product-nonneg
import mundane theorem    stdlib/numbers/multiply-cancel

theorem ptolemy
  note        Ptolemy's theorem as set.mm states it, of the angles a cyclic
              quadrilateral's sides subtend: four angles adding to π. Since
              d = π − (a + b + c), sin(d) = sin(a + b + c); the addition
              formulas write both sides in sines and cosines of a, b and c,
              and they differ by sin(a)·sin(b)·(1 − sin(c)² − cos(c)²), which
              is 0.
  let a ∈ ℝ                                                           (H1)
  let b ∈ ℝ                                                           (H2)
  let c ∈ ℝ                                                           (H3)
  let d ∈ ℝ                                                           (H4)
  assume a + b + c + d = π                                            (H5)
  then sin(a)·sin(b) + sin(c)·sin(d) = sin(b + c)·sin(a + c)

1.  d = π + (−(a + b + c))
    algebra, from H5

2.  sin(−(a + b + c)) = −sin(a + b + c)
    mun:sin-negative a := a + b + c

3.  sin(d) = sin(a + b + c)
    calculation
      sin(d) = sin(π + (−(a + b + c)))                                    substitute line 1
             = sin(π)·cos(−(a + b + c)) + cos(π)·sin(−(a + b + c))         thm:sin-add a := π, b := −(a + b + c)
             = 0·cos(−(a + b + c)) + cos(π)·sin(−(a + b + c))              real arithmetic
             = 0·cos(−(a + b + c)) + (−1)·sin(−(a + b + c))                real arithmetic
             = 0·cos(−(a + b + c)) + (−1)·(−sin(a + b + c))                substitute line 2
             = sin(a + b + c)                                              algebra

4.  sin(a + b + c) = sin(a + b)·cos(c) + cos(a + b)·sin(c)
    thm:sin-add a := a + b, b := c

5.  sin(a + b) = sin(a)·cos(b) + cos(a)·sin(b)
    thm:sin-add

6.  cos(a + b) = cos(a)·cos(b) − sin(a)·sin(b)
    thm:cos-add

7.  sin(b + c) = sin(b)·cos(c) + cos(b)·sin(c)
    thm:sin-add a := b, b := c

8.  sin(a + c) = sin(a)·cos(c) + cos(a)·sin(c)
    thm:sin-add b := c

9.  sin(c)² + cos(c)² = 1
    mun:sin-cos-squares a := c

10. sin(a)·sin(b) + sin(c)·sin(d) = sin(b + c)·sin(a + c)
    calculation
      sin(a)·sin(b) + sin(c)·sin(d) = sin(a)·sin(b) + sin(c)·sin(a + b + c)                                                substitute line 3
          = sin(a)·sin(b) + sin(c)·(sin(a + b)·cos(c) + cos(a + b)·sin(c))                                                 substitute line 4
          = sin(a)·sin(b) + sin(c)·((sin(a)·cos(b) + cos(a)·sin(b))·cos(c) + cos(a + b)·sin(c))                            substitute line 5
          = sin(a)·sin(b) + sin(c)·((sin(a)·cos(b) + cos(a)·sin(b))·cos(c) + (cos(a)·cos(b) − sin(a)·sin(b))·sin(c))       substitute line 6
          = (sin(b)·cos(c) + cos(b)·sin(c))·(sin(a)·cos(c) + cos(a)·sin(c))                                                algebra, from 9
          = sin(b + c)·(sin(a)·cos(c) + cos(a)·sin(c))                                                                     substitute line 7
          = sin(b + c)·sin(a + c)                                                                                          substitute line 8

theorem cyclic-ptolemy
  note        Ptolemy's theorem of four points in order on a circle, said by
              their diagonals crossing at P. The chords cross, so
              |PA|·|PC| = |PB|·|PD|; the four angles at P are θ, 180° − θ, θ
              and 180° − θ; and the law of cosines in the four triangles at P,
              with |PC| = |PB|·|PD|/|PA|, gives |CD| = (|PD|/|PA|)·|AB| and
              |BC| = (|PB|/|PA|)·|AD|. The cosine terms then cancel, and what
              is left is (|PA| + |PC|)·(|PB| + |PD|) = |AC|·|BD|.
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  let D be a point                                                    (H4)
  let O be a point                                                    (H5)
  let P be a point                                                    (H6)
  assume |AO| = |BO|                                                  (H7)
  assume |AO| = |CO|                                                  (H8)
  assume |AO| = |DO|                                                  (H9)
  assume P is between A and C                                         (H10)
  assume P is between B and D                                         (H11)
  assume A ≠ B                                                        (H12)
  assume B ≠ C                                                        (H13)
  assume C ≠ D                                                        (H14)
  assume D ≠ A                                                        (H15)
  then |AC|·|BD| = |AB|·|CD| + |AD|·|BC|

1.  A ≠ P. C ≠ P.
    mun:between-apart R := P, S := A, T := C, from H10

2.  B ≠ P. D ≠ P.
    mun:between-apart R := P, S := B, T := D, from H11

3.  |PA|·|PC| = |PB|·|PD|
    thm:intersecting-chords B := C, C := B, from H7, H8, H9, H10, H11

4.  ∠APB + ∠BPC = 180°
    axi:supplementary-angles B := P, D := B, from H10, H12, H13, 2

5.  ∠BPC + ∠CPD = 180°
    axi:supplementary-angles A := B, B := P, C := D, D := C, from H11, H13, H14, 1

6.  ∠CPD + ∠DPA = 180°
    axi:supplementary-angles A := C, B := P, C := A, from H10, H14, H15, 2

7.  ∠CPD = ∠APB
    algebra, from 4, 5

8.  cos(180° − ∠APB) = −cos(∠APB)
    mun:cos-supplement x := ∠APB

let c = cos(∠APB), a real number                                     (D1)
    mun:cos-real a := ∠APB
    reads the cosine of the angle the diagonals make at P

9.  |BA|² = |AP|² + |PB|² − 2·(|AP|·|PB|·cos(∠APB))
    thm:law-of-cosines P := A, Q := P, R := B, from H12, 1, 2

10. |CB|² = |BP|² + |PC|² − 2·(|BP|·|PC|·cos(∠BPC))
    thm:law-of-cosines P := B, Q := P, R := C, from H13, 1, 2

11. |CB|² = |BP|² + |PC|² − 2·(|BP|·|PC|·(−cos(∠APB)))
    substitute
      |CB|² = |BP|² + |PC|² − 2·(|BP|·|PC|·cos(∠BPC))             10
      |CB|² = |BP|² + |PC|² − 2·(|BP|·|PC|·cos(180° − ∠APB))      algebra, from 4
      |CB|² = |BP|² + |PC|² − 2·(|BP|·|PC|·(−cos(∠APB)))          substitute line 8

12. |DC|² = |CP|² + |PD|² − 2·(|CP|·|PD|·cos(∠CPD))
    thm:law-of-cosines P := C, Q := P, R := D, from H14, 1, 2

13. |DC|² = |CP|² + |PD|² − 2·(|CP|·|PD|·cos(∠APB))
    substitute ∠CPD = ∠APB (line 7) into line 12

14. |AD|² = |DP|² + |PA|² − 2·(|DP|·|PA|·cos(∠DPA))
    thm:law-of-cosines P := D, Q := P, R := A, from H15, 1, 2

15. |AD|² = |DP|² + |PA|² − 2·(|DP|·|PA|·(−cos(∠APB)))
    substitute
      |AD|² = |DP|² + |PA|² − 2·(|DP|·|PA|·cos(∠DPA))             14
      |AD|² = |DP|² + |PA|² − 2·(|DP|·|PA|·cos(180° − ∠APB))      algebra, from 6, 7
      |AD|² = |DP|² + |PA|² − 2·(|DP|·|PA|·(−cos(∠APB)))          substitute line 8

16. (|PA|·|PC|)² = (|PB|·|PD|)²
    algebra, from 3

17. |PA|·|PD|·c·(|PA|·|PC|) = |PA|·|PD|·c·(|PB|·|PD|)
    algebra, from 3

18. |PA|·|PB|·c·(|PA|·|PC|) = |PA|·|PB|·c·(|PB|·|PD|)
    algebra, from 3

19. |DC|²·|PA|² = |PD|²·|BA|²
    calculation
      |DC|²·|PA|² = (|CP|² + |PD|² − 2·(|CP|·|PD|·c))·|PA|²                     algebra, from D1, 13
                  = (|PA|·|PC|)² + |PA|²·|PD|² − 2·(|PA|·|PD|·c·(|PA|·|PC|))    algebra
                  = (|PB|·|PD|)² + |PA|²·|PD|² − 2·(|PA|·|PD|·c·(|PB|·|PD|))    algebra, from 16, 17
                  = |PD|²·(|AP|² + |PB|² − 2·(|AP|·|PB|·c))                     algebra
                  = |PD|²·|BA|²                                                 algebra, from D1, 9

20. |CB|²·|PA|² = |PB|²·|AD|²
    calculation
      |CB|²·|PA|² = (|BP|² + |PC|² + 2·(|BP|·|PC|·c))·|PA|²                     algebra, from D1, 11
                  = |PA|²·|PB|² + (|PA|·|PC|)² + 2·(|PA|·|PB|·c·(|PA|·|PC|))    algebra
                  = |PA|²·|PB|² + (|PB|·|PD|)² + 2·(|PA|·|PB|·c·(|PB|·|PD|))    algebra, from 16, 18
                  = |PB|²·(|DP|² + |PA|² + 2·(|DP|·|PA|·c))                     algebra
                  = |PB|²·|AD|²                                                 algebra, from D1, 15

21. |DC| ≥ 0
    mun:distance-nonneg P := D, Q := C

22. |PA| ≥ 0
    mun:distance-nonneg Q := A

23. |PD| ≥ 0
    mun:distance-nonneg Q := D

24. |BA| ≥ 0
    mun:distance-nonneg P := B, Q := A

25. |CB| ≥ 0
    mun:distance-nonneg P := C, Q := B

26. |PB| ≥ 0
    mun:distance-nonneg Q := B

27. |AD| ≥ 0
    mun:distance-nonneg P := A, Q := D

28. |DC|·|PA| ≥ 0
    mun:product-nonneg x := |DC|, y := |PA|, from 21, 22

29. |PD|·|BA| ≥ 0
    mun:product-nonneg x := |PD|, y := |BA|, from 23, 24

30. |CB|·|PA| ≥ 0
    mun:product-nonneg x := |CB|, y := |PA|, from 22, 25

31. |PB|·|AD| ≥ 0
    mun:product-nonneg x := |PB|, y := |AD|, from 26, 27

32. (|DC|·|PA|)² = (|PD|·|BA|)²
    algebra, from 19

33. |DC|·|PA| = |PD|·|BA|
    mun:square-equal x := |DC|·|PA|, y := |PD|·|BA|, from 28, 29, 32

34. (|CB|·|PA|)² = (|PB|·|AD|)²
    algebra, from 20

35. |CB|·|PA| = |PB|·|AD|
    mun:square-equal x := |CB|·|PA|, y := |PB|·|AD|, from 30, 31, 34

36. |AB|·(|DC|·|PA|) = |AB|·(|PD|·|BA|)
    algebra, from 33

37. |AD|·(|CB|·|PA|) = |AD|·(|PB|·|AD|)
    algebra, from 35

38. |PD|·|BA|² = |PD|·(|AP|² + |PB|² − 2·(|AP|·|PB|·c))
    algebra, from D1, 9

39. |PB|·|AD|² = |PB|·(|DP|² + |PA|² + 2·(|DP|·|PA|·c))
    algebra, from D1, 15

40. (|PB| + |PD|)·(|PA|² + |PB|·|PD|) = ((|AP| + |PC|)·(|BP| + |PD|))·|PA|
    algebra, from 3

41. (|PB| + |PD|)·(|PA|² + |PB|·|PD|) = (|AC|·(|BP| + |PD|))·|PA|
    substitute
      (|PB| + |PD|)·(|PA|² + |PB|·|PD|) = ((|AP| + |PC|)·(|BP| + |PD|))·|PA|      40
      (|PB| + |PD|)·(|PA|² + |PB|·|PD|) = (|AC|·(|BP| + |PD|))·|PA|               mun:segment-addition P := A, Q := C, S := P, from H10

42. (|PB| + |PD|)·(|PA|² + |PB|·|PD|) = (|AC|·|BD|)·|PA|
    substitute
      (|PB| + |PD|)·(|PA|² + |PB|·|PD|) = (|AC|·(|BP| + |PD|))·|PA|      41
      (|PB| + |PD|)·(|PA|² + |PB|·|PD|) = (|AC|·|BD|)·|PA|               mun:segment-addition P := B, Q := D, S := P, from H11

43. (|AB|·|CD| + |AD|·|BC|)·|PA| = (|AC|·|BD|)·|PA|
    calculation
      (|AB|·|CD| + |AD|·|BC|)·|PA| = |PD|·|BA|² + |PB|·|AD|²                                                algebra, from 36, 37
                                  = |PD|·(|AP|² + |PB|² − 2·(|AP|·|PB|·c)) + |PB|·(|DP|² + |PA|² + 2·(|DP|·|PA|·c))    algebra, from 38, 39
                                  = (|PB| + |PD|)·(|PA|² + |PB|·|PD|)                                        algebra
                                  = (|AC|·|BD|)·|PA|                                                         42

44. |PA| > 0
    axi:distance-positive Q := A, from 1

45. |AC|·|BD| = |AB|·|CD| + |AD|·|BC|
    mun:multiply-cancel a := |AC|·|BD|, b := |AB|·|CD| + |AD|·|BC|, c := |PA|, from 43
    requires |PA| ≠ 0: weakening, from 44
