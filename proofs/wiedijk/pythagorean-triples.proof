import theorem            proofs/wiedijk/sqrt2-irrational/even-square
import definition         stdlib/divisibility/divides
import theorem            stdlib/divisibility/divides-gcd
import mundane theorem    stdlib/divisibility/divides-combination
import mundane theorem    stdlib/divisibility/divides-one
import mundane theorem    stdlib/divisibility/divides-self
import mundane theorem    stdlib/divisibility/divides-transitive
import definition         stdlib/divisibility/gcd
import mundane theorem    stdlib/divisibility/gcd-commutes
import mundane theorem    stdlib/divisibility/coprime-product
import theorem            stdlib/divisibility/coprime-square
import mundane theorem    stdlib/divisibility/divides-sum
import mundane theorem    stdlib/divisibility/divides-difference
import mundane theorem    stdlib/divisibility/divides-multiple
import mundane theorem    stdlib/divisibility/not-both
import mundane theorem    stdlib/divisibility/divides-square
import mundane theorem    stdlib/divisibility/divides-quotient
import mundane theorem    stdlib/divisibility/gcd-quotients-coprime
import mundane theorem    stdlib/numbers/pos-int-nat
import mundane theorem    stdlib/numbers/multiply-cancel
import mundane theorem    stdlib/numbers/square-equal
import mundane theorem    stdlib/numbers/square-less
import mundane theorem    stdlib/numbers/square-positive
import definition         stdlib/divisibility/even
import mundane theorem    stdlib/divisibility/even-or-odd
import definition         stdlib/divisibility/odd
import mundane theorem    stdlib/reasoning/disjunctive-syllogism
import mundane theorem    stdlib/reasoning/or-left
import mundane theorem    stdlib/reasoning/or-right
import mundane theorem    stdlib/sets/pair-equal

theorem even-leg
  note        If both legs were odd, c² would be twice an odd number: then c is
              even, c² is a multiple of 4, and 4 would divide 2.
  let a ∈ ℕ                                                          (H1)
  let b ∈ ℕ                                                           (H2)
  let c ∈ ℕ                                                           (H3)
  assume a² + b² = c²                                                 (H4)
  then a is even or b is even

1.  a is even or a is odd
    mun:even-or-odd n := a

2.  a is even or b is even
    cases, from 1

    case
    assume a is even                                                  (C1)

    2.1.  a is even or b is even
          mun:or-left, from C1

    case
    assume a is odd                                                   (C2)

    2.2.  b is not odd
          contradiction
          suppose b is odd                                            (S)

          2.2.1.  p ∈ ℤ. a = 2p + 1.
                  obtain p: def:odd n := a, from C2

          2.2.2.  q ∈ ℤ. b = 2q + 1.
                  obtain q: def:odd n := b, from S

          2.2.3.  (2p + 1)² + b² = c²
                  substitute a = 2p + 1 (line 2.2.1) into H4

          2.2.4.  (2p + 1)² + (2q + 1)² = c²
                  substitute b = 2q + 1 (line 2.2.2) into line 2.2.3

          2.2.5.  c² = 2(2p² + 2p + 2q² + 2q + 1)
                  calculation
                    c² = (2p + 1)² + (2q + 1)²         2.2.4
                       = 2(2p² + 2p + 2q² + 2q + 1)    algebra

          2.2.6.  c² is even
                  def:even n := c², from 2.2.5

          2.2.7.  c is even
                  thm:even-square n := c, from 2.2.6

          2.2.8.  r ∈ ℤ. c = 2r.
                  obtain r: def:even n := c, from 2.2.7

          2.2.9.  (2p + 1)² + (2q + 1)² = (2r)²
                  substitute c = 2r (line 2.2.8) into line 2.2.4

          2.2.10. 2 = 4(r² − p² − p − q² − q)
                  algebra, from 2.2.9

          2.2.11. 4 divides 2, which is impossible
                  def:divides d := 4, n := 2, from 2.2.10

    2.3.  b is even or b is odd
          mun:even-or-odd n := b

    2.4.  b is even
          mun:disjunctive-syllogism P := b is even, Q := b is odd, from 2.2, 2.3

    2.5.  a is even or b is even
          mun:or-right, from 2.4

theorem leg-hypotenuse-coprime
  note        A common factor of b and c divides c² − b², which is a². It
              shares no factor with a, since such a factor would divide
              gcd(a, b) = 1; so it shares none with a² either, and divides 1.
  let a ∈ ℕ                                                          (H1)
  let b ∈ ℕ                                                           (H2)
  let c ∈ ℕ                                                           (H3)
  assume a² + b² = c²                                                 (H4)
  assume gcd(a, b) = 1                                                (H5)
  then gcd(b, c) = 1

1.  gcd(b, c) ∈ ℕ. gcd(b, c) divides b. gcd(b, c) divides c.
    def:gcd a := b, b := c

2.  gcd(b, c) divides c·c + b·(−b)
    mun:divides-combination e := gcd(b, c), a := c, x := c, y := −b, from 1

3.  c·c + b·(−b) = a·a
    algebra, from H4

4.  gcd(b, c) divides a·a
    substitute c·c + b·(−b) = a·a (line 3) into line 2

5.  gcd(gcd(b, c), a) ∈ ℕ. gcd(gcd(b, c), a) divides gcd(b, c).
    gcd(gcd(b, c), a) divides a.
    def:gcd a := gcd(b, c), b := a, from 1

6.  gcd(gcd(b, c), a) divides b
    mun:divides-transitive d := gcd(gcd(b, c), a), e := gcd(b, c), n := b, from 1, 5

7.  gcd(gcd(b, c), a) divides gcd(a, b)
    thm:divides-gcd d := gcd(gcd(b, c), a), from 5, 6

8.  gcd(gcd(b, c), a) divides 1
    substitute gcd(a, b) = 1 (H5) into line 7

9.  gcd(a, gcd(b, c)) = 1
    calculation
      gcd(a, gcd(b, c)) = gcd(gcd(b, c), a)    mun:gcd-commutes b := gcd(b, c)
                        = 1                    mun:divides-one d := gcd(gcd(b, c), a), from 5, 8
    requires gcd(b, c) ∈ ℤ: membership, from 1

10. gcd(b, c) divides gcd(b, c)
    mun:divides-self n := gcd(b, c)
    requires gcd(b, c) ∈ ℤ: membership, from 1

11. gcd(b, c) divides gcd(a·a, gcd(b, c))
    thm:divides-gcd d := gcd(b, c), a := a·a, b := gcd(b, c), from 4, 10
    requires gcd(b, c) ∈ ℤ: membership, from 1

12. gcd(b, c) divides 1
    substitute
      gcd(b, c) divides gcd(a·a, gcd(b, c))      11
      gcd(b, c) divides 1                        mun:coprime-product x := a, y := a, n := gcd(b, c), from 1, 9

13. gcd(b, c) = 1
    mun:divides-one d := gcd(b, c), from 1, 12

theorem primitive-triple
  note        With a even, b and c are odd, so c + b = 2s and c − b = 2t.
              Then s + t = c and s − t = b, so s and t share no factor, and
              s·t = (a/2)² is a square. Numbers that share no factor and
              multiply to a square are squares themselves: s = m², t = n².
  let a ∈ ℕ                                                          (H1)
  let b ∈ ℕ                                                           (H2)
  let c ∈ ℕ                                                           (H3)
  assume a² + b² = c²                                                 (H4)
  assume gcd(a, b) = 1                                                (H5)
  assume a is even                                                    (H6)
  then there are m, n ∈ ℕ with n < m, gcd(m, n) = 1, m + n is odd,
       a = 2mn, b = m² − n², and c = m² + n²

1.  w ∈ ℤ. a = 2w.
    obtain w: def:even n := a, from H6

2.  0 < a
    inequalities, from H1

3.  0 < 2w
    substitute a = 2w (line 1) into line 2

4.  w ∈ ℕ
    mun:pos-int-nat m := w
    requires 0 < w: multiplying by 1/2, from 3

5.  2 divides a
    def:divides d := 2, n := a, from 1

6.  b is odd
    contradiction
    suppose b is not odd                                              (S1)

    6.1.  b is even or b is odd
          mun:even-or-odd n := b

    6.2.  b is even
          mun:disjunctive-syllogism P := b is even, Q := b is odd, from S1, 6.1

    6.3.  v ∈ ℤ. b = 2v.
          obtain v: def:even n := b, from 6.2

    6.4.  2 divides b
          def:divides d := 2, n := b, from 6.3

    6.5.  2 divides gcd(a, b)
          thm:divides-gcd d := 2, from 5, 6.4

    6.6.  2 divides 1, which is impossible
          substitute gcd(a, b) = 1 (H5) into line 6.5

7.  q ∈ ℤ. b = 2q + 1.
    obtain q: def:odd n := b, from 6

8.  (2w)² + b² = c²
    substitute a = 2w (line 1) into H4

9.  (2w)² + (2q + 1)² = c²
    substitute b = 2q + 1 (line 7) into line 8

10. c is odd
    contradiction
    suppose c is not odd                                              (S2)

    10.1. c is even or c is odd
          mun:even-or-odd n := c

    10.2. c is even
          mun:disjunctive-syllogism P := c is even, Q := c is odd, from S2, 10.1

    10.3. r ∈ ℤ. c = 2r.
          obtain r: def:even n := c, from 10.2

    10.4. (2w)² + (2q + 1)² = (2r)²
          substitute c = 2r (line 10.3) into line 9

    10.5. 1 = 2(2r² − 2w² − 2q² − 2q)
          algebra, from 10.4

    10.6. 2 divides 1, which is impossible
          def:divides d := 2, n := 1, from 10.5

11. r ∈ ℤ. c = 2r + 1.
    obtain r: def:odd n := c, from 10

12. c + b = 2(r + q + 1)
    algebra, from 7, 11

13. c + b is even
    def:even n := c + b, from 12

14. s ∈ ℤ. c + b = 2s.
    obtain s: def:even n := c + b, from 13

15. c − b = 2(r − q)
    algebra, from 7, 11

16. c − b is even
    def:even n := c − b, from 15

17. t ∈ ℤ. c − b = 2t.
    obtain t: def:even n := c − b, from 16

18. c·2 = (s + t)·2
    algebra, from 14, 17

19. c = s + t
    mun:multiply-cancel a := c, b := s + t, c := 2, from 18
    requires 2 ≠ 0: arithmetic

20. (s − t)·2 = 2s − 2t
    algebra

21. (s − t)·2 = (c + b) − 2t
    substitute c + b = 2s (line 14) into line 20

22. (s − t)·2 = (c + b) − (c − b)
    substitute c − b = 2t (line 17) into line 21

23. b·2 = (s − t)·2
    calculation
      b·2 = (c + b) − (c − b)    algebra
          = (s − t)·2            22

24. b = s − t
    mun:multiply-cancel a := b, b := s − t, c := 2, from 23
    requires 2 ≠ 0: arithmetic

25. a² > 0
    mun:square-positive x := a, from H1

26. b² < a² + b²
    inequalities
      a² > 0              25
      a² + b² > b²        adding b²
      b² < a² + b²        restate

27. b² < c²
    transitivity, from 26, H4

28. b < c
    mun:square-less x := b, y := c, from 27
    requires b ≥ 0: inequalities, from H2
    requires c ≥ 0: inequalities, from H3

29. 0 < c − b
    inequalities
      b < c               28
      0 < c − b           adding −b

30. 0 < 2t
    substitute c − b = 2t (line 17) into line 29

31. t ∈ ℕ
    mun:pos-int-nat m := t
    requires 0 < t: multiplying by 1/2, from 30

32. 0 < c + b
    inequalities, from H2, H3

33. 0 < 2s
    substitute c + b = 2s (line 14) into line 32

34. s ∈ ℕ
    mun:pos-int-nat m := s
    requires 0 < s: multiplying by 1/2, from 33

35. c² − b² = a²
    algebra, from H4

36. (c + b)·(c − b) = c² − b²
    algebra

37. (2s)·(c − b) = c² − b²
    substitute c + b = 2s (line 14) into line 36

38. (2s)·(2t) = c² − b²
    substitute c − b = 2t (line 17) into line 37

39. w²·4 = (s·t)·4
    calculation
      w²·4 = (2w)²          algebra
           = a²             substitute line 1
           = c² − b²        35
           = (2s)·(2t)      38
           = (s·t)·4        algebra

40. w² = s·t
    mun:multiply-cancel a := w², b := s·t, c := 4, from 39
    requires 4 ≠ 0: arithmetic

41. gcd(s, t) ∈ ℕ. gcd(s, t) divides s. gcd(s, t) divides t.
    def:gcd a := s, b := t, from 31, 34

42. gcd(s, t) divides s + t
    mun:divides-sum d := gcd(s, t), a := s, b := t, from 41

43. gcd(s, t) divides c
    substitute c = s + t (line 19) into line 42

44. gcd(s, t) divides s − t
    mun:divides-difference d := gcd(s, t), a := s, b := t, from 41

45. gcd(s, t) divides b
    substitute b = s − t (line 24) into line 44

46. gcd(s, t) divides gcd(b, c)
    thm:divides-gcd d := gcd(s, t), a := b, b := c, from 43, 45
    requires gcd(s, t) ∈ ℤ: membership, from 41

47. gcd(s, t) divides 1
    substitute
      gcd(s, t) divides gcd(b, c)      46
      gcd(s, t) divides 1              thm:leg-hypotenuse-coprime, from H4, H5

48. gcd(s, t) = 1
    mun:divides-one d := gcd(s, t), from 41, 47

49. s = gcd(s, w)². t = gcd(t, w)².
    thm:coprime-square, from 4, 31, 34, 40, 48

let m = gcd(s, w), a positive integer                               (D1)
    def:gcd a := s, b := w, from 4, 34
    reads the number whose square is s

50. s = m²
    calculation
      s = gcd(s, w)²    49
        = m²            D1

let n = gcd(t, w), a positive integer                               (D2)
    def:gcd a := t, b := w, from 4, 31
    reads the number whose square is t

51. t = n²
    calculation
      t = gcd(t, w)²    49
        = n²            D2

52. w² = m²·t
    substitute s = m² (line 50) into line 40

53. w² = m²·n²
    substitute t = n² (line 51) into line 52

54. m·n ∈ ℕ
    membership

55. w² = (m·n)²
    algebra, from 53

56. w = m·n
    mun:square-equal x := w, y := m·n, from 55
    requires w ≥ 0: inequalities, from 4
    requires m·n ≥ 0: inequalities, from 54

57. a = 2(m·n)
    substitute w = m·n (line 56) into line 1

58. b = m² − t
    substitute s = m² (line 50) into line 24

59. b = m² − n²
    substitute t = n² (line 51) into line 58

60. c = m² + t
    substitute s = m² (line 50) into line 19

61. c = m² + n²
    substitute t = n² (line 51) into line 60

62. 0 < b
    inequalities, from H2

63. 0 < m² − n²
    transitivity, from 62, 59

64. n² < m²
    inequalities
      0 < m² − n²         63
      n² < m²             adding n²

65. n < m
    mun:square-less x := n, y := m, from 64
    requires n ≥ 0: inequalities, from D2
    requires m ≥ 0: inequalities, from D1

66. gcd(m, n) ∈ ℕ. gcd(m, n) divides m. gcd(m, n) divides n.
    def:gcd a := m, b := n

67. gcd(m, n) divides m·m
    mun:divides-multiple e := gcd(m, n), a := m, x := m, from 66

68. m·m = s
    algebra, from 50

69. gcd(m, n) divides s
    substitute m·m = s (line 68) into line 67

70. gcd(m, n) divides n·n
    mun:divides-multiple e := gcd(m, n), a := n, x := n, from 66

71. n·n = t
    algebra, from 51

72. gcd(m, n) divides t
    substitute n·n = t (line 71) into line 70

73. gcd(m, n) divides gcd(s, t)
    thm:divides-gcd d := gcd(m, n), a := s, b := t, from 69, 72
    requires gcd(m, n) ∈ ℤ: membership, from 66

74. gcd(m, n) divides 1
    substitute gcd(s, t) = 1 (line 48) into line 73

75. gcd(m, n) = 1
    mun:divides-one d := gcd(m, n), from 66, 74

76. m + n is odd
    contradiction
    suppose m + n is not odd                                          (S3)

    76.1. m + n is even or m + n is odd
          mun:even-or-odd n := m + n

    76.2. m + n is even
          mun:disjunctive-syllogism P := m + n is even, Q := m + n is odd, from S3, 76.1

    76.3. u ∈ ℤ. m + n = 2u.
          obtain u: def:even n := m + n, from 76.2

    76.4. m² − n² = (m + n)·(m − n)
          algebra

    76.5. m² − n² = (2u)·(m − n)
          substitute m + n = 2u (line 76.3) into line 76.4

    76.6. b = 2(u·(m − n))
          calculation
            b = m² − n²            59
              = (2u)·(m − n)       76.5
              = 2(u·(m − n))       algebra

    76.7. b is even
          def:even n := b, from 76.6

    76.8. b is not odd
          mun:not-both n := b, from 76.7, contradicting 6

77. There are m, n ∈ ℕ with n < m, gcd(m, n) = 1, m + n is odd,
    a = 2mn, b = m² − n², and c = m² + n².
    exhibit, from 59, 61, 65, 75, 76
    requires a = 2mn: algebra, from H1, 57

theorem triple-scaled
  note        Divide the triple by k = gcd(a, b). k divides c too, since k²
              divides a² + b² = c², and the triple divided by k is still one,
              with legs that share no factor.
  let a ∈ ℕ                                                          (H1)
  let b ∈ ℕ                                                           (H2)
  let c ∈ ℕ                                                           (H3)
  assume a² + b² = c²                                                 (H4)
  then there is k ∈ ℕ with a/k ∈ ℕ, b/k ∈ ℕ, c/k ∈ ℕ, gcd(a/k, b/k) = 1,
       and (a/k)² + (b/k)² = (c/k)²

let k = gcd(a, b), a positive integer                               (D1)
    def:gcd
    reads the largest number dividing both legs

1.  k divides a. k divides b.
    def:gcd, from D1

2.  a/k ∈ ℕ
    mun:divides-quotient n := a, d := k, from 1

3.  b/k ∈ ℕ
    mun:divides-quotient n := b, d := k, from 1

4.  k² divides a²
    mun:divides-square d := k, n := a, from 1

5.  k² divides b²
    mun:divides-square d := k, n := b, from 1

6.  k² divides a² + b²
    mun:divides-sum d := k², a := a², b := b², from 4, 5

7.  k² divides c²
    substitute a² + b² = c² (H4) into line 6

8.  k divides c
    mun:divides-square d := k, n := c, from 7

9.  c/k ∈ ℕ
    mun:divides-quotient n := c, d := k, from 8

10. gcd(a/k, b/k) = 1
    mun:gcd-quotients-coprime, from D1
    requires b ≠ 0: inequalities, from H2

11. (a/k)² + (b/k)² = (a² + b²)/k²
    algebra

12. (a/k)² + (b/k)² = c²/k²
    substitute a² + b² = c² (H4) into line 11

13. (a/k)² + (b/k)² = (c/k)²
    calculation
      (a/k)² + (b/k)² = c²/k²        12
                      = (c/k)²       algebra

14. There is k ∈ ℕ with a/k ∈ ℕ, b/k ∈ ℕ, c/k ∈ ℕ, gcd(a/k, b/k) = 1,
    and (a/k)² + (b/k)² = (c/k)².
    exhibit, from 2, 3, 9, 10, 13

theorem triple-from-parameters
  note        The formulas give a triple by algebra: (m² − n²)² + (2mn)² is
              (m² + n²)², and multiplying all three by k keeps it one.
  let a ∈ ℕ                                                          (H1)
  let b ∈ ℕ                                                           (H2)
  let c ∈ ℕ                                                           (H3)
  let k ∈ ℕ                                                           (H4)
  let m ∈ ℕ                                                           (H5)
  let n ∈ ℕ                                                           (H6)
  assume c = k(m² + n²)                                               (H7)
  assume {a, b} = {k(m² − n²), 2kmn}                                   (H8)
  then a² + b² = c²

1.  (a = k(m² − n²) and b = 2kmn) or (a = 2kmn and b = k(m² − n²))
    mun:pair-equal c := k(m² − n²), d := 2kmn, from H8

2.  a² + b² = c²
    cases, from 1

    case
    assume a = k(m² − n²) and b = 2kmn                                (C1)

    2.1.  a² + b² = c²
          calculation
            a² + b² = (k(m² − n²))² + b²            substitute C1
                    = (k(m² − n²))² + (2kmn)²       substitute C1
                    = (k(m² + n²))²                 algebra
                    = c²                            substitute H7

    case
    assume a = 2kmn and b = k(m² − n²)                                (C2)

    2.2.  a² + b² = c²
          calculation
            a² + b² = (2kmn)² + b²                  substitute C2
                    = (2kmn)² + (k(m² − n²))²       substitute C2
                    = (k(m² + n²))²                 algebra
                    = c²                            substitute H7

theorem triple-parameters
  note        Every triple is k times one whose legs share no factor
              (triple-scaled). One of those legs is even (even-leg), and
              primitive-triple gives m and n for it, whichever leg it is.
  let a ∈ ℕ                                                          (H1)
  let b ∈ ℕ                                                           (H2)
  let c ∈ ℕ                                                           (H3)
  assume a² + b² = c²                                                 (H4)
  then there are k, m, n ∈ ℕ with c = k(m² + n²) and {a, b} = {k(m² − n²), 2kmn}

1.  k ∈ ℕ. a/k ∈ ℕ. b/k ∈ ℕ. c/k ∈ ℕ. gcd(a/k, b/k) = 1.
    (a/k)² + (b/k)² = (c/k)².
    obtain k: thm:triple-scaled, from H4

2.  a/k is even or b/k is even
    thm:even-leg a := a/k, b := b/k, c := c/k, from 1

3.  There are k, m, n ∈ ℕ with c = k(m² + n²) and {a, b} = {k(m² − n²), 2kmn}.
    cases, from 2

    case
    assume a/k is even                                                (C1)

    3.1.  m ∈ ℕ. n ∈ ℕ. n < m. gcd(m, n) = 1. m + n is odd.
          a/k = 2mn. b/k = m² − n². c/k = m² + n².
          obtain m, n: thm:primitive-triple a := a/k, b := b/k, c := c/k, from C1, 1

    3.2.  a = 2kmn
          algebra, from 3.1

    3.3.  b = k(m² − n²)
          algebra, from 3.1

    3.4.  c = k(m² + n²)
          algebra, from 3.1

    3.5.  {a, b} = {2kmn, b}
          substitute a = 2kmn (line 3.2)

    3.6.  {2kmn, b} = {2kmn, k(m² − n²)}
          substitute b = k(m² − n²) (line 3.3)

    3.7.  {a, b} = {k(m² − n²), 2kmn}
          calculation
            {a, b} = {2kmn, b}                  3.5
                   = {2kmn, k(m² − n²)}         3.6

    3.8.  There are k, m, n ∈ ℕ with c = k(m² + n²) and {a, b} = {k(m² − n²), 2kmn}.
          exhibit, from 3.4, 3.7

    case
    assume b/k is even                                                (C2)

    3.9.  gcd(b/k, a/k) = gcd(a/k, b/k)
          mun:gcd-commutes a := b/k, b := a/k
          requires b/k ∈ ℤ: membership, from 1
          requires a/k ∈ ℤ: membership, from 1

    3.10. gcd(b/k, a/k) = 1
          calculation
            gcd(b/k, a/k) = gcd(a/k, b/k)    3.9
                          = 1                1

    3.11. (b/k)² + (a/k)² = (c/k)²
          algebra, from 1

    3.12. m ∈ ℕ. n ∈ ℕ. n < m. gcd(m, n) = 1. m + n is odd.
          b/k = 2mn. a/k = m² − n². c/k = m² + n².
          obtain m, n: thm:primitive-triple a := b/k, b := a/k, c := c/k, from C2, 1, 3.10, 3.11

    3.13. a = k(m² − n²)
          algebra, from 3.12

    3.14. b = 2kmn
          algebra, from 3.12

    3.15. c = k(m² + n²)
          algebra, from 3.12

    3.16. {a, b} = {k(m² − n²), b}
          substitute a = k(m² − n²) (line 3.13)

    3.17. {k(m² − n²), b} = {k(m² − n²), 2kmn}
          substitute b = 2kmn (line 3.14)

    3.18. {a, b} = {k(m² − n²), 2kmn}
          calculation
            {a, b} = {k(m² − n²), b}            3.16
                   = {k(m² − n²), 2kmn}         3.17

    3.19. There are k, m, n ∈ ℕ with c = k(m² + n²) and {a, b} = {k(m² − n²), 2kmn}.
          exhibit, from 3.15, 3.18

theorem pythagorean-triples
  metamath    pythagtrip, which says the two legs' places with an "or"
  note        Both directions: every triple has the form (triple-parameters),
              and every number of the form is a triple
              (triple-from-parameters). The legs are k(m² − n²) and 2kmn in
              either order, so the statement lists them as a set.
  let a ∈ ℕ                                                           (H1)
  let b ∈ ℕ                                                           (H2)
  let c ∈ ℕ                                                           (H3)
  then a² + b² = c² ↔ there are k, m, n ∈ ℕ with c = k(m² + n²) and {a, b} = {k(m² − n²), 2kmn}

1.  a² + b² = c² ↔ there are k, m, n ∈ ℕ with c = k(m² + n²) and {a, b} = {k(m² − n²), 2kmn}.
    both directions

    direction
    assume a² + b² = c²                                               (D1)

    1.1.  There are k, m, n ∈ ℕ with c = k(m² + n²) and {a, b} = {k(m² − n²), 2kmn}.
          thm:triple-parameters, from D1

    direction
    assume there are k, m, n ∈ ℕ with c = k(m² + n²) and {a, b} = {k(m² − n²), 2kmn} (D2)

    1.2.  k ∈ ℕ. m ∈ ℕ. n ∈ ℕ. c = k(m² + n²). {a, b} = {k(m² − n²), 2kmn}.
          obtain k, m, n from D2

    1.3.  a² + b² = c²
          thm:triple-from-parameters, from 1.2
