import theorem            stdlib/numbers/archimedean
import theorem            stdlib/sums/sum-telescopes
import mundane definition stdlib/calculus/series-sum
import mundane theorem    stdlib/numbers/abs-difference-lt
import mundane theorem    stdlib/numbers/reciprocal-order
import mundane theorem    stdlib/numbers/product-nonzero
import mundane theorem    stdlib/numbers/reciprocal-positive
import mundane theorem    stdlib/sums/sum-real
import mundane theorem    stdlib/sums/sum-termwise
import definition         stdlib/calculus/tends-to

define T(k) := k(k + 1)/2, for k ∈ ℕ                                  (D1)
       reads the k-th triangular number

theorem triangular-reciprocals
  metamath    trirecip
  note        1/T(k) = 2/k − 2/(k + 1), so the first n terms telescope to
              2 − 2/(n + 1), which tends to 2.
  ε ranges over ℝ
  n ranges over ℕ
  then Σ(k = 1 to ∞) 1/T(k) = 2

1.  For all k ∈ ℕ, 1/T(k) = 2/k − 2/(k + 1).
    proof
    let k ∈ ℕ                                                         (K1)

    1.1.  k + 1 > 0
          inequalities, from K1

    1.2.  1/(k(k + 1)/2) = 2/k − 2/(k + 1)
          algebra
          requires k ≠ 0: from K1
          requires k + 1 ≠ 0: weakening, from 1.1

    1.3.  1/T(k) = 2/k − 2/(k + 1)
          calculation
            1/T(k) = 1/(k(k + 1)/2)       D1
                   = 2/k − 2/(k + 1)      1.2

2.  For all k ∈ ℕ, 1/T(k) ∈ ℝ.
    proof
    let k ∈ ℕ                                                         (K2)

    2.1.  k + 1 > 0
          inequalities, from K2

    2.2.  k(k + 1) ≠ 0
          mun:product-nonzero x := k, y := k + 1
          requires k ≠ 0: from K2
          requires k + 1 ≠ 0: weakening, from 2.1

    2.3.  k(k + 1)/2 ≠ 0
          algebra, from 2.2

    2.4.  1/T(k) ∈ ℝ
          membership, from D1, 2.3

3.  For all k ∈ ℕ, 2/k ∈ ℝ.
    proof
    let k ∈ ℕ                                                         (K3)

    3.1.  2/k ∈ ℝ
          membership
          requires k ≠ 0: from K3

4.  For all k ∈ ℕ, 2/k − 2/(k + 1) ∈ ℝ.
    proof
    let k ∈ ℕ                                                         (K4)

    4.1.  k + 1 > 0
          inequalities, from K4

    4.2.  2/k − 2/(k + 1) ∈ ℝ
          membership
          requires k ≠ 0: from K4
          requires k + 1 ≠ 0: weakening, from 4.1

5.  For all n ∈ ℕ, Σ(k = 1 to n) 1/T(k) = 2 − 2/(n + 1).
    proof
    let n ∈ ℕ                                                         (K5)

    5.1.  Σ(k = 1 to n) 1/T(k) = Σ(k = 1 to n) (2/k − 2/(k + 1))
          mun:sum-termwise a := 1, b := n, from 1, 2, 4

    5.2.  Σ(k = 1 to n) (2/k − 2/(k + 1)) = 2 − 2/(n + 1)
          thm:sum-telescopes a := 1, b := n, from 3
          requires n + 1 ≥ 1: inequalities, from K5

    5.3.  Σ(k = 1 to n) 1/T(k) = 2 − 2/(n + 1)
          calculation
            Σ(k = 1 to n) 1/T(k) = Σ(k = 1 to n) (2/k − 2/(k + 1))    5.1
                                 = 2 − 2/(n + 1)                      5.2

6.  For all ε > 0, there exists N ∈ ℕ such that
    |Σ(k = 1 to n) 1/T(k) − 2| < ε for all n ≥ N.
    proof
    let ε ∈ ℝ                                                         (K6)
    assume ε > 0                                                      (A1)

    6.1.  N ∈ ℕ. 1/N < ε/2.
          obtain N: thm:archimedean x := ε/2
          requires ε/2 > 0: multiplying by 1/2, from A1

    6.2.  For all n ≥ N, |Σ(k = 1 to n) 1/T(k) − 2| < ε.
          proof
          let n ∈ ℕ                                                   (K7)
          assume n ≥ N                                                (A2)

          6.2.1.  Σ(k = 1 to n) 1/T(k) = 2 − 2/(n + 1)
                  instantiate n := n in line 5

          6.2.2.  N ≤ n + 1
                  inequalities, from A2

          6.2.3.  1/(n + 1) ≤ 1/N
                  mun:reciprocal-order x := N, y := n + 1, from 6.2.2
                  requires N > 0: inequalities, from 6.1
                  requires n + 1 > 0: inequalities, from K7

          6.2.4.  1/(n + 1) > 0
                  mun:reciprocal-positive x := n + 1
                  requires n + 1 > 0: inequalities, from K7

          6.2.5.  n + 1 > 0
                  inequalities, from K7

          6.2.6.  1/(n + 1) < ε/2
                  transitivity, from 6.2.3, 6.1
                  requires n + 1 ≠ 0: weakening, from 6.2.5

          6.2.7.  2 − ε < 2 − 2/(n + 1)
                  inequalities
                    1/(n + 1) < ε/2               6.2.6
                    2/(n + 1) < ε                 multiplying by 2
                    2 − ε < 2 − 2/(n + 1)         adding 2 − ε − 2/(n + 1)
                  requires n + 1 ≠ 0: weakening, from 6.2.5

          6.2.8.  2 − ε < Σ(k = 1 to n) 1/T(k)
                  transitivity, from 6.2.7, 6.2.1
                  requires n + 1 ≠ 0: weakening, from 6.2.5

          6.2.9.  2 − 2/(n + 1) < 2
                  inequalities
                    1/(n + 1) > 0                 6.2.4
                    −2/(n + 1) < 0                multiplying by −2
                    2 − 2/(n + 1) < 2             adding 2
                  requires n + 1 ≠ 0: weakening, from 6.2.5

          6.2.10. 2 − 2/(n + 1) < 2 + ε
                  inequalities, from A1, 6.2.9
                  requires n + 1 ≠ 0: weakening, from 6.2.5

          6.2.11. Σ(k = 1 to n) 1/T(k) < 2 + ε
                  transitivity, from 6.2.1, 6.2.10
                  requires n + 1 ≠ 0: weakening, from 6.2.5

          6.2.12. |Σ(k = 1 to n) 1/T(k) − 2| < ε
                  mun:abs-difference-lt x := Σ(k = 1 to n) 1/T(k), c := 2, δ := ε, from 6.2.8, 6.2.11
                  requires Σ(k = 1 to n) 1/T(k) ∈ ℝ: mun:sum-real a := 1, b := n, from 2

    6.3.  There exists N ∈ ℕ such that |Σ(k = 1 to n) 1/T(k) − 2| < ε for all n ≥ N.
          exhibit, from 6.2

7.  Σ(k = 1 to n) 1/T(k) → 2 as n → ∞
    def:tends-to L := 2, from 6
    requires for all n ∈ ℕ, Σ(k = 1 to n) 1/T(k) ∈ ℝ: mun:sum-real a := 1, b := n, from 2

8.  Σ(k = 1 to ∞) 1/T(k) = 2
    mun:series-sum L := 2, from 7
    requires for all k ∈ ℕ, 1/T(k) ∈ ℝ: from 2
