import mundane definition stdlib/numbers/abs
import mundane theorem    stdlib/numbers/abs-real
import mundane theorem    stdlib/numbers/nonneg-or-neg

theorem abs-bounds
  metamath    leabs, absneg
  note        |x| is x or −x, whichever is not negative, so it is at least
              both.
  let x ∈ ℝ                                                           (H1)
  then x ≤ |x|. −x ≤ |x|.

1.  x ≥ 0 or x < 0
    mun:nonneg-or-neg

2.  x ≤ |x|. −x ≤ |x|.
    cases, from 1

    case
    assume x ≥ 0                                                      (C1)

    2.1.  |x| = x
          mun:abs, from C1

    2.2.  x ≤ |x|
          inequalities
            |x| = x          2.1
            x = |x|          restate
            x ≤ |x|          weakening

    2.3.  −x ≤ 0
          inequalities
            x ≥ 0            C1
            −x ≤ 0           multiplying by −1

    2.4.  −x ≤ |x|
          transitivity, from 2.3, C1, 2.1

    2.5.  x ≤ |x|. −x ≤ |x|.
          join 2.2, 2.4

    case
    assume x < 0                                                      (C2)

    2.6.  |x| = −x
          mun:abs, from C2

    2.7.  −x ≤ |x|
          inequalities
            |x| = −x         2.6
            −x = |x|         restate
            −x ≤ |x|         weakening

    2.8.  0 < −x
          inequalities
            x < 0            C2
            −x > 0           multiplying by −1
            0 < −x           restate

    2.9.  x < |x|
          transitivity, from C2, 2.8, 2.6

    2.10. x ≤ |x|
          inequalities
            x < |x|          2.9
            x ≤ |x|          weakening
          requires |x| ∈ ℝ: mun:abs-real

    2.11. x ≤ |x|. −x ≤ |x|.
          join 2.7, 2.10


theorem triangle-inequality
  metamath    abstri, over ℂ
  note        |a + b| is a + b or −(a + b), and each of those is at most
              |a| + |b|, since a and −a are at most |a| (abs-bounds), and the
              same for b.
  let a ∈ ℝ                                                           (H1)
  let b ∈ ℝ                                                           (H2)
  then |a + b| ≤ |a| + |b|

1.  a + b ≥ 0 or a + b < 0
    mun:nonneg-or-neg x := a + b

2.  a ≤ |a|. −a ≤ |a|.
    thm:abs-bounds x := a

3.  b ≤ |b|. −b ≤ |b|.
    thm:abs-bounds x := b

4.  |a + b| ≤ |a| + |b|
    cases, from 1

    case
    assume a + b ≥ 0                                                  (C1)

    4.1.  |a + b| = a + b
          mun:abs x := a + b, from C1

    4.2.  a + b ≤ |a| + |b|
          inequalities, from 2, 3
          requires |a| ∈ ℝ: mun:abs-real x := a
          requires |b| ∈ ℝ: mun:abs-real x := b

    4.3.  |a + b| ≤ |a| + |b|
          calculation
            |a + b| = a + b                 4.1
                    ≤ |a| + |b|             4.2

    case
    assume a + b < 0                                                  (C2)

    4.4.  |a + b| = −(a + b)
          mun:abs x := a + b, from C2

    4.5.  −(a + b) = −a + −b
          algebra

    4.6.  −a + −b ≤ |a| + |b|
          inequalities, from 2, 3
          requires |a| ∈ ℝ: mun:abs-real x := a
          requires |b| ∈ ℝ: mun:abs-real x := b

    4.7.  |a + b| ≤ |a| + |b|
          calculation
            |a + b| = −(a + b)              4.4
                    = −a + −b               4.5
                    ≤ |a| + |b|             4.6
