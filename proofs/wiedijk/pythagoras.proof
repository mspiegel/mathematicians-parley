import theorem            stdlib/geometry/angle-angle-similar
import theorem            stdlib/geometry/altitude-foot
import mundane theorem    stdlib/geometry/segment-addition
import mundane theorem    stdlib/geometry/angle-along-segment
import mundane theorem    stdlib/geometry/angle-symmetric
import mundane theorem    stdlib/geometry/between-symmetric
import mundane definition stdlib/geometry/triangle

theorem similar-triangles
  note        Two triangles with two angles equal have their sides about the
              first angle in proportion, as the library proves it from the
              postulates (angle-angle-similar, by Euclid VI.2).
  let P be a point                                                   (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  let P′ be a point                                                   (H4)
  let Q′ be a point                                                   (H5)
  let R′ be a point                                                   (H6)
  assume P, Q, R form a triangle                                      (H7)
  assume P′, Q′, R′ form a triangle                                   (H8)
  assume ∠QPR = ∠Q′P′R′                                               (H9)
  assume ∠PQR = ∠P′Q′R′                                               (H10)
  then |PQ|·|P′R′| = |P′Q′|·|PR|

1.  |PQ|·|P′R′| = |P′Q′|·|PR|
    thm:angle-angle-similar, from H7, H8, H9, H10

theorem pythagoras
  metamath    pythag
  note        Drop the altitude from C to its foot D on AB. The two smaller
              triangles are each similar to ABC, which gives |AD|·|AB| = |AC|²
              and |DB|·|AB| = |BC|². Adding, with |AD| + |DB| = |AB|, gives
              |AB|².
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  assume A, B, C form a triangle                                      (H4)
  assume ∠ACB = 90°                                                   (H5)
  then |AB|² = |AC|² + |BC|²

1.  D ∈ 𝔼². D is between A and B. ∠ADC = 90°. ∠BDC = 90°.
    A, D, C form a triangle. B, D, C form a triangle.
    obtain D: thm:altitude-foot P := A, Q := B, R := C, from H4, H5

2.  ∠DAC = ∠BAC
    mun:angle-along-segment P := A, Q := B, R := C, S := D, from 1
    requires C ≠ A: mun:triangle, from H4

3.  ∠BAC = ∠CAB
    mun:angle-symmetric P := B, Q := A, R := C, from H4

4.  ∠DAC = ∠CAB
    calculation
      ∠DAC = ∠BAC       2
           = ∠CAB       3

5.  ∠ADC = ∠ACB
    calculation
      ∠ADC = 90°        1
           = ∠ACB       H5

6.  |AD|·|AB| = |AC|·|AC|
    thm:similar-triangles P := A, Q := D, R := C, P′ := A, Q′ := C, R′ := B,
      from H4, 1, 4, 5

7.  D is between B and A
    mun:between-symmetric R := D, S := A, T := B, from 1

8.  ∠DBC = ∠ABC
    mun:angle-along-segment P := B, Q := A, R := C, S := D, from 7
    requires C ≠ B: mun:triangle, from H4

9.  ∠ABC = ∠CBA
    mun:angle-symmetric P := A, Q := B, R := C, from H4

10. ∠DBC = ∠CBA
    calculation
      ∠DBC = ∠ABC       8
           = ∠CBA       9

11. ∠BCA = ∠ACB
    mun:angle-symmetric P := B, Q := C, R := A, from H4

12. ∠BDC = ∠BCA
    calculation
      ∠BDC = 90°        1
           = ∠ACB       H5
           = ∠BCA       11

13. |BD|·|BA| = |BC|·|BC|
    thm:similar-triangles P := B, Q := D, R := C, P′ := B, Q′ := C, R′ := A,
      from H4, 1, 10, 12

14. |AD| + |DB| = |AB|
    mun:segment-addition P := A, Q := B, S := D, from 1

15. |AB|² = |AC|² + |BC|²
    algebra, from 6, 13, 14
