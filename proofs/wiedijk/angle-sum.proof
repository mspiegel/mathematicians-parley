import axiom              stdlib/geometry/parallel-through
import theorem            stdlib/geometry/alternate-angles
import theorem            stdlib/geometry/angles-on-a-line

theorem angle-sum
  metamath    ang180
  note        Draw through B the line parallel to AC. The angles it makes with
              BA and BC equal the triangle's angles at A and at C (alternate
              angles), and with the angle at B they make a straight line.
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  assume A, B, C form a triangle                                      (H4)
  then ∠BAC + ∠ABC + ∠BCA = 180°

1.  D ∈ 𝔼². E ∈ 𝔼². line BD ∥ line AC. line BE ∥ line CA.
    B is between D and E.
    D and C are on opposite sides of line BA.
    E and A are on opposite sides of line BC.
    A and C are on the same side of line BD.
    obtain D, E: axi:parallel-through P := A, Q := C, R := B, from H4

2.  ∠DBA = ∠BAC
    thm:alternate-angles P := A, Q := C, R := B, S := D, from H4, 1

3.  ∠EBC = ∠BCA
    thm:alternate-angles P := C, Q := A, R := B, S := E, from H4, 1

4.  ∠DBA + ∠ABC + ∠EBC = 180°
    thm:angles-on-a-line P := A, Q := C, R := B, S := D, T := E, from 1

5.  ∠BAC + ∠ABC + ∠BCA = ∠DBA + ∠ABC + ∠BCA
    substitute ∠DBA = ∠BAC (line 2)

6.  ∠DBA + ∠ABC + ∠BCA = ∠DBA + ∠ABC + ∠EBC
    substitute ∠EBC = ∠BCA (line 3)

7.  ∠BAC + ∠ABC + ∠BCA = 180°
    calculation
      ∠BAC + ∠ABC + ∠BCA = ∠DBA + ∠ABC + ∠BCA      5
                         = ∠DBA + ∠ABC + ∠EBC      6
                         = 180°                    4
