import theorem            stdlib/counting/count-functions
import theorem            stdlib/counting/count-one-to-one
import mundane theorem    stdlib/counting/range-size
import mundane theorem    stdlib/sums/range-finite

theorem birthday
  metamath    birthday
  note        Of the ways 23 people can have their birthdays among 365 days,
              fewer than half give no two of them the same day: the one-to-
              one functions are 365·364·…·343 of the 365^23 functions, and
              twice that product is less than 365^23.
  let S = the functions from {1, …, 23} to {1, …, 365}                (D1)
         reads the ways 23 people can have their birthdays
  let T = {f ∈ S : f : {1, …, 23} → {1, …, 365} is one-to-one}        (D2)
         reads the ways in which no two of them share one
  then |T|/|S| < 1/2

1.  {1, …, 23} is finite
    mun:range-finite a := 1, b := 23

2.  {1, …, 365} is finite
    mun:range-finite a := 1, b := 365

3.  |{1, …, 23}| = 23
    mun:range-size n := 23

4.  |{1, …, 365}| = 365
    mun:range-size n := 365

5.  |S| = |{1, …, 365}|^|{1, …, 23}|
    thm:count-functions X := {1, …, 23}, Y := {1, …, 365}, from D1, 1, 2

6.  |S| = 365^23
    substitute
      |S| = |{1, …, 365}|^|{1, …, 23}|      5
      |S| = 365^|{1, …, 23}|                substitute line 4
      |S| = 365^23                          substitute line 3

7.  23 ≤ 365
    arithmetic

8.  |{1, …, 23}| ≤ |{1, …, 365}|
    transitivity, from 3, 7, 4

9.  |T| = ∏(k ∈ {0, …, |{1, …, 23}| − 1}) (|{1, …, 365}| − k)
    thm:count-one-to-one X := {1, …, 23}, Y := {1, …, 365}, from D1, D2, 1, 2, 8

10. |T| = ∏(k ∈ {0, …, 22}) (365 − k)
    substitute
      |T| = ∏(k ∈ {0, …, |{1, …, 23}| − 1}) (|{1, …, 365}| − k)      9
      |T| = ∏(k ∈ {0, …, 23 − 1}) (|{1, …, 365}| − k)                substitute line 3
      |T| = ∏(k ∈ {0, …, 22}) (|{1, …, 365}| − k)                    arithmetic
      |T| = ∏(k ∈ {0, …, 22}) (365 − k)                              substitute line 4

11. (∏(k ∈ {0, …, 22}) (365 − k))/365^23 < 1/2
    arithmetic

12. |T|/|S| < 1/2
    calculation
      |T|/|S| = |T|/365^23                                     substitute line 6
              = (∏(k ∈ {0, …, 22}) (365 − k))/365^23           substitute line 10
              < 1/2                                            11
