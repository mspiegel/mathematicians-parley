import theorem            proofs/wiedijk/pythagoras/pythagoras
import theorem            stdlib/geometry/perpendicular-foot
import axiom              stdlib/geometry/supplementary-angles
import mundane theorem    stdlib/geometry/on-line-cases
import mundane theorem    stdlib/geometry/between-apart
import mundane theorem    stdlib/geometry/between-ends-apart
import mundane theorem    stdlib/geometry/angle-along-segment
import mundane theorem    stdlib/geometry/segment-addition
import mundane theorem    stdlib/geometry/angle-symmetric
import mundane theorem    stdlib/geometry/angle-real
import mundane theorem    stdlib/geometry/triangle-angle-real
import mundane theorem    stdlib/geometry/distance-zero
import mundane theorem    stdlib/geometry/right-angle-by-cosine
import mundane theorem    stdlib/geometry/right-angle-triangle
import mundane theorem    stdlib/geometry/cosine-right-triangle
import definition         stdlib/geometry/triangle
import definition         stdlib/trigonometry/cos
import mundane theorem    stdlib/trigonometry/cos-real
import mundane theorem    stdlib/trigonometry/cos-supplement
import axiom              stdlib/reasoning/excluded-middle
import mundane theorem    stdlib/reasoning/modus-ponens

theorem pythagoras-at-foot
  note        Pythagoras from P to a point Q of a line through the foot H
              of the perpendicular from P. Where Q is H there is nothing to
              add; elsewhere the angle at H is right.
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let H be a point                                                    (H3)
  assume P ≠ H                                                        (H4)
  assume P ≠ Q                                                        (H5)
  assume if H ≠ Q then ∠PHQ = 90°                                     (H6)
  then |PQ|² = |PH|² + |HQ|²

1.  H = Q or H ≠ Q
    axi:excluded-middle P := H = Q

2.  |PQ|² = |PH|² + |HQ|²
    cases, from 1

    case
    assume H = Q                                                      (C1)

    2.1.  |HQ| = 0
          mun:distance-zero P := H, from C1

    2.2.  |PQ|² = |PH|² + |HQ|²
          calculation
            |PQ|² = |PH|²              substitute C1
                  = |PH|² + |HQ|²      algebra, from 2.1

    case
    assume H ≠ Q                                                      (C2)

    2.3.  ∠PHQ = 90°
          mun:modus-ponens, from C2, H6

    2.4.  P, H, Q form a triangle
          mun:right-angle-triangle Q := H, R := Q, from C2, H4, H5, 2.3

    2.5.  |PQ|² = |PH|² + |HQ|²
          thm:pythagoras A := P, B := Q, C := H, from 2.3, 2.4

theorem foot-on-ray
  note        Euclid II.13. The foot H is on the ray from Q through R, so
              the angle at Q in the right triangle PHQ is the angle PQR, and
              its cosine gives |QH|; H's distance from R is the difference
              of the two distances from Q.
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  let H be a point                                                    (H4)
  assume P, Q, R form a triangle                                      (H5)
  assume P ≠ H                                                        (H6)
  assume Q ≠ H                                                        (H7)
  assume ∠PHQ = 90°                                                   (H8)
  assume ∠HQP = ∠RQP                                                  (H9)
  assume |HR|² = (|QR| − |QH|)²                                       (H10)
  then |HR|² = |HQ|² + |QR|² − 2·(|PQ|·|QR|·cos(∠PQR))

1.  |QH| = |QP|·cos(∠HQP)
    mun:cosine-right-triangle R := H, from H6, H7, H8
    requires P ≠ Q: def:triangle, from H5

2.  ∠HQP = ∠PQR
    calculation
      ∠HQP = ∠RQP       H9
           = ∠PQR       mun:angle-symmetric P := R, R := P, from H5

3.  |QH| = |QP|·cos(∠PQR)
    substitute ∠HQP = ∠PQR (line 2) into line 1

4.  |HR|² = |HQ|² + |QR|² − 2·(|QR|·|QH|)
    algebra, from H10

5.  |HR|² = |HQ|² + |QR|² − 2·(|QR|·(|QP|·cos(∠PQR)))
    substitute |QH| = |QP|·cos(∠PQR) (line 3) into line 4

6.  ∠PQR ∈ ℝ
    mun:triangle-angle-real, from H5

7.  |HR|² = |HQ|² + |QR|² − 2·(|PQ|·|QR|·cos(∠PQR))
    algebra, from 5
    requires cos(∠PQR) ∈ ℝ: mun:cos-real a := ∠PQR, from 6

theorem distance-from-foot
  note        Euclid II.12 and II.13, in one statement by the cosine. The
              foot H of the perpendicular from P is Q, between Q and R, R,
              beyond R, or beyond Q; in each case its distance from R comes
              from its distance from Q and the angle at Q.
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  let H be a point                                                    (H4)
  assume P, Q, R form a triangle                                      (H5)
  assume H is on line QR                                              (H6)
  assume P ≠ H                                                        (H7)
  assume if H ≠ Q then ∠PHQ = 90°                                     (H8)
  assume if H ≠ R then ∠PHR = 90°                                     (H9)
  then |HR|² = |HQ|² + |QR|² − 2·(|PQ|·|QR|·cos(∠PQR))

1.  P ≠ Q. Q ≠ R.
    def:triangle, from H5

2.  ∠PQR ∈ ℝ
    mun:triangle-angle-real, from H5

3.  H = Q or (H is between Q and R) or H = R or (R is between Q and H) or
    (Q is between H and R)
    mun:on-line-cases P := H, from H6, 1

4.  |HR|² = |HQ|² + |QR|² − 2·(|PQ|·|QR|·cos(∠PQR))
    cases, from 3

    case
    note   The angle at Q is right, and H is Q.
    assume H = Q                                                      (C1)

    4.1.  H ≠ R
          substitute Q = H (C1) into line 1

    4.2.  ∠PHR = 90°
          mun:modus-ponens, from H9, 4.1

    4.3.  ∠PQR = 90°
          substitute H = Q (C1) into line 4.2

    4.4.  cos(∠PQR) = 0
          mun:right-angle-by-cosine, from 1, 4.3
          requires P ≠ R: def:triangle, from H5

    4.5.  |HQ| = 0
          mun:distance-zero P := H, from C1

    4.6.  |HR|² = |HQ|² + |QR|² − 2·(|PQ|·|QR|·cos(∠PQR))
          calculation
            |HR|² = |QR|²                                          substitute C1
                  = |HQ|² + |QR|²                                  algebra, from 4.5
                  = |HQ|² + |QR|² − 2·(|PQ|·|QR|·cos(∠PQR))        algebra, from 4.4

    case
    assume H is between Q and R                                       (C2)

    4.7.  Q ≠ H. R ≠ H.
          mun:between-apart R := H, S := Q, T := R, from C2

    4.8.  ∠PHQ = 90°
          mun:modus-ponens, from H8, 4.7

    4.9.  ∠HQP = ∠RQP
          mun:angle-along-segment P := Q, Q := R, R := P, S := H, from C2
          requires P ≠ Q: from 1
          requires P ≠ H: from H7
          requires P ≠ R: def:triangle, from H5

    4.10. |QH| + |HR| = |QR|
          mun:segment-addition P := Q, Q := R, S := H, from C2

    4.11. |HR|² = (|QR| − |QH|)²
          algebra, from 4.10

    4.12. |HR|² = |HQ|² + |QR|² − 2·(|PQ|·|QR|·cos(∠PQR))
          thm:foot-on-ray, from H5, H7, 4.7, 4.8, 4.9, 4.11

    case
    assume H = R                                                      (C3)

    4.13. Q ≠ H
          substitute R = H (C3) into line 1

    4.14. ∠PHQ = 90°
          mun:modus-ponens, from H8, 4.13

    4.15. ∠HQP = ∠RQP
          substitute H = R (C3)

    4.16. |HR| = 0
          mun:distance-zero P := H, Q := R, from C3

    4.17. |HR|² = (|QR| − |QR|)²
          algebra, from 4.16

    4.18. |HR|² = (|QR| − |QH|)²
          substitute R = H (C3) into line 4.17

    4.19. |HR|² = |HQ|² + |QR|² − 2·(|PQ|·|QR|·cos(∠PQR))
          thm:foot-on-ray, from H5, H7, 4.13, 4.14, 4.15, 4.18

    case
    assume R is between Q and H                                       (C4)

    4.20. Q ≠ H
          mun:between-ends-apart S := Q, T := H, from C4

    4.21. ∠PHQ = 90°
          mun:modus-ponens, from H8, 4.20

    4.22. ∠RQP = ∠HQP
          mun:angle-along-segment P := Q, Q := H, R := P, S := R, from C4
          requires P ≠ Q: from 1
          requires P ≠ R: def:triangle, from H5
          requires P ≠ H: from H7

    4.23. |QR| + |RH| = |QH|
          mun:segment-addition P := Q, Q := H, S := R, from C4

    4.24. |HR|² = (|QR| − |QH|)²
          algebra, from 4.23

    4.25. |HR|² = |HQ|² + |QR|² − 2·(|PQ|·|QR|·cos(∠PQR))
          thm:foot-on-ray, from H5, H7, 4.20, 4.21, 4.22, 4.24

    case
    note   Euclid II.12: the angle at Q is obtuse, the supplement of ∠HQP.
    assume Q is between H and R                                       (C5)

    4.26. H ≠ Q. R ≠ Q.
          mun:between-apart R := Q, S := H, T := R, from C5

    4.27. ∠PHQ = 90°
          mun:modus-ponens, from H8, 4.26

    4.28. |QH| = |QP|·cos(∠HQP)
          mun:cosine-right-triangle R := H, from H7, 1, 4.26, 4.27

    4.29. ∠HQP + ∠PQR = 180°
          axi:supplementary-angles A := H, B := Q, C := R, D := P, from C5
          requires P ≠ Q: from 1
          requires P ≠ H: from H7
          requires P ≠ R: def:triangle, from H5

    4.30. |QH| = |QP|·cos(180° − ∠PQR)
          substitute
            |QH| = |QP|·cos(∠HQP)             4.28
            |QH| = |QP|·cos(180° − ∠PQR)      algebra, from 4.29
          requires ∠HQP ∈ ℝ: mun:angle-real P := H, R := P, from H7, 1, 4.26
          requires ∠PQR ∈ ℝ: from 2

    4.31. |QH| = |QP|·−cos(∠PQR)
          substitute
            |QH| = |QP|·cos(180° − ∠PQR)      4.30
            |QH| = |QP|·−cos(∠PQR)            mun:cos-supplement x := ∠PQR
          requires ∠PQR ∈ ℝ: from 2

    4.32. |HQ| + |QR| = |HR|
          mun:segment-addition P := H, Q := R, S := Q, from C5

    4.33. |HR|² = |HQ|² + |QR|² + 2·(|QR|·|QH|)
          algebra, from 4.32

    4.34. |HR|² = |HQ|² + |QR|² + 2·(|QR|·(|QP|·−cos(∠PQR)))
          substitute |QH| = |QP|·−cos(∠PQR) (line 4.31) into line 4.33

    4.35. |HR|² = |HQ|² + |QR|² − 2·(|PQ|·|QR|·cos(∠PQR))
          algebra, from 4.34
          requires cos(∠PQR) ∈ ℝ: mun:cos-real a := ∠PQR, from 2

theorem law-of-cosines
  metamath    lawcos, which states it for any three points with the third
              apart from the other two, by the signed angle, and names the
              sides by hypotheses
  note        Euclid II.12 and II.13 by the cosine. Drop the perpendicular
              from P to line QR, foot H. Pythagoras in the two right
              triangles at H gives |PQ|² and |RP|² from |PH|; the position
              of H on the line gives |HR| from |HQ|, |QR| and the angle at
              Q; and |PH| drops out between the two.
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  assume P, Q, R form a triangle                                      (H4)
  then |RP|² = |PQ|² + |QR|² − 2·(|PQ|·|QR|·cos(∠PQR))

1.  H ∈ 𝔼². H is on line QR. P ≠ H. If H ≠ Q then ∠PHQ = 90°.
    If H ≠ R then ∠PHR = 90°.
    obtain H: thm:perpendicular-foot, from H4

2.  |PQ|² = |PH|² + |HQ|²
    thm:pythagoras-at-foot, from 1
    requires P ≠ Q: def:triangle, from H4

3.  |HR|² = |HQ|² + |QR|² − 2·(|PQ|·|QR|·cos(∠PQR))
    thm:distance-from-foot, from H4, 1

4.  |RP|² = |PQ|² + |QR|² − 2·(|PQ|·|QR|·cos(∠PQR))
    calculation
      |RP|² = |PH|² + |HR|²                              thm:pythagoras-at-foot Q := R, from 1
            = |PQ|² − |HQ|² + |HR|²                      algebra, from 2
            = |PQ|² + |QR|² − 2·(|PQ|·|QR|·cos(∠PQR))    algebra, from 3
    requires P ≠ R: def:triangle, from H4
    requires ∠PQR ∈ ℝ: mun:triangle-angle-real, from H4
    requires cos(∠PQR) ∈ ℝ: mun:cos-real a := ∠PQR
