import theorem            stdlib/groups/group-cancel
import mundane theorem    stdlib/counting/card-equal
import mundane theorem    stdlib/counting/card-nat0
import mundane theorem    stdlib/counting/finite-part
import mundane theorem    stdlib/counting/partition-count
import mundane theorem    stdlib/counting/parts-finite
import definition         stdlib/divisibility/divides
import definition         stdlib/functions/bijection
import mundane theorem    stdlib/functions/function-into
import definition         stdlib/functions/one-to-one
import definition         stdlib/functions/one-to-one-onto
import definition         stdlib/functions/onto
import definition         stdlib/groups/coset
import axiom              stdlib/groups/group-associative
import axiom              stdlib/groups/group-closed
import axiom              stdlib/groups/group-identity
import axiom              stdlib/groups/group-inverse
import axiom              stdlib/groups/group-inverse-closed
import mundane theorem    stdlib/groups/subgroup-closed
import mundane theorem    stdlib/groups/subgroup-identity
import mundane theorem    stdlib/groups/subgroup-inverse
import mundane theorem    stdlib/groups/subgroup-within
import mundane theorem    stdlib/sets/in-subset
import definition         stdlib/sets/indexed-union
import definition         stdlib/sets/intersection
import definition         stdlib/sets/part-builder
import definition         stdlib/sets/subset
import mundane theorem    stdlib/sets/subset-antisymmetric
import mundane theorem    stdlib/sets/union-within

theorem coset-within
  note        Each member of gH is g times a member of H, and both are in G.
  let G be a group with operation · and identity e                    (H1)
  assume H is a subgroup of G                                         (H2)
  let g ∈ G                                                           (H3)
  then gH ⊆ G

1.  H ⊆ G
    mun:subgroup-within, from H2

2.  For all u ∈ gH, u ∈ G.
    proof
    let u ∈ gH                                                        (K1)

    2.1.  h ∈ H. u = g·h.
          obtain h: def:coset, from H2, H3, K1

    2.2.  h ∈ G
          mun:in-subset, from 1, 2.1

    2.3.  g·h ∈ G
          axi:group-closed a := g, b := h, from H3, 2.2

    2.4.  u ∈ G
          substitute u = g·h (line 2.1) into line 2.3

3.  gH ⊆ G
    def:subset, from 2

theorem coset-member
  note        g is g times the identity, which is in H.
  let G be a group with operation · and identity e                    (H1)
  assume H is a subgroup of G                                         (H2)
  let g ∈ G                                                           (H3)
  then g ∈ gH

1.  e ∈ H
    mun:subgroup-identity, from H2

2.  g·e = g
    axi:group-identity a := g, from H3

3.  g ∈ gH
    def:coset u := g, from H2, H3, 1, 2

theorem coset-inclusion
  note        x is a·h for some h in H, so x times a member c of H is
              a·(h·c), and h·c is in H.
  let G be a group with operation · and identity e                    (H1)
  assume H is a subgroup of G                                         (H2)
  let a ∈ G                                                           (H3)
  let x ∈ aH                                                          (H4)
  then xH ⊆ aH

1.  H ⊆ G
    mun:subgroup-within, from H2

2.  h ∈ H. x = a·h.
    obtain h: def:coset u := x, g := a, from H2, H3, H4

3.  aH ⊆ G
    thm:coset-within g := a, from H2, H3

4.  x ∈ G
    mun:in-subset, from H4, 3

5.  h ∈ G
    mun:in-subset, from 1, 2

6.  For all u ∈ xH, u ∈ aH.
    proof
    let u ∈ xH                                                        (K1)

    6.1.  c ∈ H. u = x·c.
          obtain c: def:coset g := x, from H2, K1, 4

    6.2.  c ∈ G
          mun:in-subset, from 1, 6.1

    6.3.  h·c ∈ H
          mun:subgroup-closed a := h, b := c, from H2, 2, 6.1

    6.4.  u = a·(h·c)
          calculation
            u = x·c              6.1
              = (a·h)·c          substitute line 2
              = a·(h·c)          axi:group-associative b := h, from H3, 5, 6.2

    6.5.  u ∈ aH
          def:coset g := a, from H2, H3, 6.3, 6.4

7.  xH ⊆ aH
    def:subset, from 6

theorem coset-of-member
  note        A coset is the coset of any of its members: x is in aH, and a
              is in xH, so each coset holds the other.
  let G be a group with operation · and identity e                    (H1)
  assume H is a subgroup of G                                         (H2)
  let a ∈ G                                                           (H3)
  let x ∈ aH                                                          (H4)
  then xH = aH

1.  H ⊆ G
    mun:subgroup-within, from H2

2.  h ∈ H. x = a·h.
    obtain h: def:coset u := x, g := a, from H2, H3, H4

3.  h ∈ G
    mun:in-subset, from 1, 2

4.  h⁻¹ ∈ H
    mun:subgroup-inverse a := h, from H2, 2

5.  h⁻¹ ∈ G
    axi:group-inverse-closed a := h, from 3

6.  h·h⁻¹ = e
    axi:group-inverse a := h, from 3

7.  a = x·h⁻¹
    calculation
      a = a·e                  axi:group-identity, from H3
        = a·(h·h⁻¹)            substitute line 6
        = (a·h)·h⁻¹            axi:group-associative b := h, c := h⁻¹, from H3, 3, 5
        = x·h⁻¹                substitute line 2

8.  aH ⊆ G
    thm:coset-within g := a, from H2, H3

9.  x ∈ G
    mun:in-subset, from H4, 8

10. a ∈ xH
    def:coset u := a, g := x, from H2, 4, 7, 9

11. xH ⊆ aH
    thm:coset-inclusion, from H2, H3, H4

12. aH ⊆ xH
    thm:coset-inclusion a := x, x := a, from H2, 9, 10

13. xH = aH
    mun:subset-antisymmetric, from 11, 12

theorem coset-size
  note        Multiplying by g sends H one to one onto gH.
  let G be a finite group with operation · and identity e             (H1)
  assume H is a subgroup of G                                         (H2)
  let g ∈ G                                                           (H3)
  then |gH| = |H|

1.  H ⊆ G
    mun:subgroup-within, from H2

2.  H is finite
    mun:finite-part, from H1, 1

let t(c) = g·c, for c ∈ H                                             (D1)
       reads g times c

3.  For all h ∈ H, t(h) ∈ gH.
    proof
    let h ∈ H                                                         (K1)

    3.1.  t(h) = g·h
          D1, from K1

    3.2.  t(h) ∈ gH
          def:coset u := t(h), from H2, H3, K1, 3.1

4.  t : H → gH
    mun:function-into, from 3
    requires t is a function on H: from D1

5.  For all s, r ∈ H, if t(s) = t(r) then s = r.
    proof
    let s ∈ H                                                         (K2)
    let r ∈ H                                                         (K3)
    assume t(s) = t(r)                                                (A1)

    5.1.  t(s) = g·s
          D1, from K2

    5.2.  t(r) = g·r
          D1, from K3

    5.3.  g·s = g·r
          calculation
            g·s = t(s)           5.1
                = t(r)           A1
                = g·r            5.2

    5.4.  s ∈ G
          mun:in-subset, from K2, 1

    5.5.  r ∈ G
          mun:in-subset, from K3, 1

    5.6.  s = r
          thm:group-cancel a := s, b := r, from H3, 5.3, 5.4, 5.5

6.  t : H → gH is one-to-one
    def:one-to-one, from 4, 5

7.  For all u ∈ gH, there is h ∈ H with u = t(h).
    proof
    let u ∈ gH                                                        (K4)

    7.1.  h ∈ H. u = g·h.
          obtain h: def:coset, from H2, H3, K4

    7.2.  t(h) = g·h
          D1, from 7.1

    7.3.  u = t(h)
          calculation
            u = g·h              7.1
              = t(h)             7.2

    7.4.  There is h ∈ H with u = t(h).
          exhibit, from 7.1, 7.3

8.  There is a bijection from H to gH.
    def:bijection
    requires t : H → gH is onto: def:onto, from 4, 7
    requires t : H → gH is one-to-one and onto: def:one-to-one-onto, from 6

9.  |gH| = |H|
    mun:card-equal X := H, Y := gH, from 2, 8

theorem lagrange
  metamath-counterpart lagsubg, which says it of the index set.mm builds from the
              relation of being in one coset, where this counts the cosets
  note        The cosets of H split G into parts, each with as many elements
              as H. So |G| is |H| times the number of cosets.
  let G be a finite group with operation · and identity e             (H1)
  assume H is a subgroup of G                                         (H2)
  then |H| divides |G|

let K = {X ⊆ G : there is g ∈ G with X = gH}                        (D1)
       reads the cosets of H: the parts of G of the form gH

1.  H ⊆ G
    mun:subgroup-within, from H2

2.  H is finite
    mun:finite-part, from H1, 1

3.  For all Y ∈ K, Y ⊆ G.
    def:part-builder, from D1

4.  ⋃(Y ∈ K) Y ⊆ G
    mun:union-within, from 3

5.  For all g ∈ G, g ∈ ⋃(Y ∈ K) Y.
    proof
    note the cosets cover G: g is in its own coset gH
    let g ∈ G                                                         (K1)

    5.1.  gH ⊆ G
          thm:coset-within, from H2, K1

    5.2.  g ∈ gH
          thm:coset-member, from H2, K1

    5.3.  There is a ∈ G with gH = aH.
          exhibit, from K1

    5.4.  gH ∈ K
          def:part-builder u := gH, from D1, 5.1, 5.3

    5.5.  There is Y ∈ K with g ∈ Y.
          exhibit, from 5.2, 5.4

    5.6.  g ∈ ⋃(Y ∈ K) Y
          def:indexed-union u := g, from 5.5

6.  G ⊆ ⋃(Y ∈ K) Y
    def:subset, from 5

7.  ⋃(Y ∈ K) Y = G
    mun:subset-antisymmetric, from 4, 6

8.  For all Y, Z ∈ K, for all x ∈ Y ∩ Z, Y = Z.
    proof
    note two cosets that share an element x are both xH, so they do not overlap otherwise
    let Y ∈ K                                                         (K2)
    let Z ∈ K                                                         (K3)
    let x ∈ Y ∩ Z                                                     (K4)

    8.1.  a ∈ G. Y = aH.
          obtain a: def:part-builder, from D1, K2

    8.2.  b ∈ G. Z = bH.
          obtain b: def:part-builder, from D1, K3

    8.3.  x ∈ Y. x ∈ Z.
          def:intersection, from K4

    8.4.  x ∈ aH
          substitute Y = aH (line 8.1) into line 8.3

    8.5.  x ∈ bH
          substitute Z = bH (line 8.2) into line 8.3

    8.6.  Y = Z
          calculation
            Y = aH                  8.1
              = xH                  thm:coset-of-member a := a, from H2, 8.1, 8.4
              = bH                  thm:coset-of-member a := b, from H2, 8.2, 8.5
              = Z                   8.2

9.  For all Y ∈ K, |Y| = |H|.
    proof
    let Y ∈ K                                                         (K5)

    9.1.  a ∈ G. Y = aH.
          obtain a: def:part-builder, from D1, K5

    9.2.  |Y| = |H|
          calculation
            |Y| = |aH|               substitute line 9.1
                = |H|                thm:coset-size g := a, from H2, 9.1

10. |G| = |K| · |H|
    mun:partition-count A := G, m := |H|, from H1, 7, 8, 9
    requires |H| ∈ ℕ₀: mun:card-nat0, from 2

11. K is finite
    mun:parts-finite A := G, from H1, 3

12. |G| = |H|·|K|
    algebra, from 10
    requires |K| ∈ ℕ₀: mun:card-nat0, from 11
    requires |H| ∈ ℕ₀: mun:card-nat0, from 2

13. |H| divides |G|
    def:divides d := |H|, n := |G|, from 12
    requires |H| ∈ ℕ₀: mun:card-nat0, from 2
    requires |K| ∈ ℕ₀: mun:card-nat0, from 11
    requires |G| ∈ ℕ₀: mun:card-nat0, from H1
