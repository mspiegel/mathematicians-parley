import mundane theorem    stdlib/calculus/derivative-local
import definition         stdlib/calculus/interval
import mundane theorem    stdlib/calculus/interval-real
import mundane theorem    stdlib/calculus/open-within-closed
import mundane theorem    stdlib/calculus/open-interval-open
import mundane theorem    stdlib/calculus/open-interval-real
import mundane theorem    stdlib/functions/function-into
import mundane theorem    stdlib/sets/in-subset
import mundane theorem    stdlib/sets/subset-self
import mundane theorem    stdlib/numbers/abs-product
import mundane theorem    stdlib/numbers/abs-real
import mundane theorem    stdlib/calculus/derivative-real-on
import definition         stdlib/numbers/abs
import mundane theorem    stdlib/numbers/multiply-le-nonneg
import theorem            stdlib/polynomials/integer-polynomial-at-a-fraction
import mundane theorem    stdlib/polynomials/integer-polynomial-real
import mundane theorem    stdlib/numbers/power-positive
import mundane theorem    stdlib/numbers/product-nonzero
import mundane theorem    stdlib/numbers/nonzero-integer-abs
import mundane theorem    stdlib/numbers/divide-le
import mundane theorem    stdlib/numbers/abs-difference-le
import mundane theorem    stdlib/numbers/abs-zero
import mundane theorem    stdlib/numbers/abs-nonneg
import mundane theorem    stdlib/numbers/abs-negative
import mundane theorem    stdlib/numbers/product-nonneg
