import theorem            stdlib/counting/pascal
import mundane theorem    stdlib/counting/binomial-nat0
import mundane theorem    stdlib/counting/binomial-zero-index
import mundane theorem    stdlib/numbers/exponent-step
import mundane theorem    stdlib/numbers/power-real
import mundane theorem    stdlib/sums/range-difference
import mundane theorem    stdlib/sums/sum-add
import mundane theorem    stdlib/sums/sum-first
import mundane theorem    stdlib/sums/sum-last
import mundane theorem    stdlib/sums/sum-scaled
import mundane theorem    stdlib/sums/sum-shift
import mundane theorem    stdlib/sums/sum-real
import mundane theorem    stdlib/sums/sum-single
import mundane theorem    stdlib/sums/sum-termwise
import mundane theorem    stdlib/functions/function-into
import definition         stdlib/counting/C

theorem binomial-step
  note        Multiplying row m by x + y gives row m + 1. Times x, each term
              keeps its k and gains a power of x; times y, each term moves to
              k + 1. Each sum gains a zero term so that both run from 0 to
              m + 1, and then the two coefficients at each k add up to
              C(m + 1, k) by Pascal's rule.
  let x ∈ ℝ                                                           (H1)
  let y ∈ ℝ                                                           (H2)
  let m ∈ ℕ₀                                                          (H3)
  then (Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k)·(x + y) = Σ(k = 0 to m + 1) C(m + 1, k)·x^((m + 1) − k)·y^k

let t(k) = C(m, k)·x^(m − k)·y^k, for k ∈ {0, …, m}                   (D1)
       reads the k-th term of row m

let p(k) = C(m, k)·x^((m + 1) − k)·y^k, for k ∈ {0, …, m + 1}         (D2)
       reads row m's k-th coefficient, with the powers of row m + 1

let q(k) = C(m, k − 1)·x^((m + 1) − k)·y^k, for k ∈ {0, …, m + 1}     (D3)
       reads row m's coefficient before the k-th, with the powers of row m + 1

1.  For all k ∈ {0, …, m}, t(k) ∈ ℝ.
    proof
    let k ∈ {0, …, m}                                                 (J)

    1.1.  t(k) ∈ ℝ
          membership, from D1, J
          requires m − k ∈ ℕ₀: mun:range-difference a := 0, n := m, from J

2.  t : {0, …, m} → ℝ
    mun:function-into, from 1
    requires t is a function on {0, …, m}: from D1

3.  For all k ∈ {0, …, m + 1}, p(k) ∈ ℝ.
    proof
    let k ∈ {0, …, m + 1}                                             (J)

    3.1.  p(k) ∈ ℝ
          membership, from D2, J
          requires (m + 1) − k ∈ ℕ₀: mun:range-difference a := 0, n := m + 1, from J

4.  p : {0, …, m + 1} → ℝ
    mun:function-into, from 3
    requires p is a function on {0, …, m + 1}: from D2

5.  For all k ∈ {0, …, m + 1}, q(k) ∈ ℝ.
    proof
    let k ∈ {0, …, m + 1}                                             (J)

    5.1.  q(k) ∈ ℝ
          membership, from D3, J
          requires (m + 1) − k ∈ ℕ₀: mun:range-difference a := 0, n := m + 1, from J

6.  q : {0, …, m + 1} → ℝ
    mun:function-into, from 5
    requires q is a function on {0, …, m + 1}: from D3

7.  Σ(k = 0 to m) t(k) ∈ ℝ
    mun:sum-real a := 0, b := m
    requires t : {0, …, m} → ℝ: from 2

8.  For all k ∈ {0, …, m}, x·t(k) = C(m, k)·x^((m + 1) − k)·y^k.
    proof
    note times x, each term keeps its k and gains a power of x
    let k ∈ {0, …, m}                                                 (J)

    8.1.  t(k) = C(m, k)·x^(m − k)·y^k
          D1, from J

    8.2.  (m − k) + 1 = (m + 1) − k
          algebra

    8.3.  x^(m − k)·x = x^((m + 1) − k)
          calculation
            x^(m − k)·x = x^((m − k) + 1)       mun:exponent-step a := x, m := m − k
                        = x^((m + 1) − k)       substitute line 8.2
          requires m − k ∈ ℕ₀: mun:range-difference a := 0, n := m, from J

    8.4.  x·t(k) = C(m, k)·x^((m + 1) − k)·y^k
          calculation
            x·t(k) = x·(C(m, k)·x^(m − k)·y^k)       substitute line 8.1
                   = C(m, k)·(x^(m − k)·x)·y^k       algebra
                   = C(m, k)·x^((m + 1) − k)·y^k     substitute line 8.3
          requires C(m, k) ∈ ℕ₀: mun:binomial-nat0
          requires m − k ∈ ℕ₀: mun:range-difference a := 0, n := m, from J
          requires x^(m − k) ∈ ℝ: mun:power-real, from H1

9.  m < m + 1
    inequalities

10. C(m, m + 1) = 0
    def:C n := m, k := m + 1, from 9

11. (m + 1) − (m + 1) = 0
    algebra

12. C(m, m + 1)·x^((m + 1) − (m + 1))·y^(m + 1) = 0
    calculation
      C(m, m + 1)·x^((m + 1) − (m + 1))·y^(m + 1) = C(m, m + 1)·x^0·y^(m + 1)    substitute line 11
                                                  = 0·x^0·y^(m + 1)               substitute line 10
                                                  = 0                             algebra
    requires y^(m + 1) ∈ ℝ: mun:power-real a := y, m := m + 1

13. Σ(k = 0 to m + 1) C(m, k)·x^((m + 1) − k)·y^k = Σ(k = 0 to m) C(m, k)·x^((m + 1) − k)·y^k + C(m, m + 1)·x^((m + 1) − (m + 1))·y^(m + 1)
    mun:sum-last n := m

14. Σ(k = 0 to m + 1) C(m, k)·x^((m + 1) − k)·y^k = Σ(k = 0 to m) C(m, k)·x^((m + 1) − k)·y^k + 0
    substitute C(m, m + 1)·x^((m + 1) − (m + 1))·y^(m + 1) = 0 (line 12) into line 13

15. x·(Σ(k = 0 to m) t(k)) = Σ(k = 0 to m) C(m, k)·x^((m + 1) − k)·y^k
    calculation
      x·(Σ(k = 0 to m) t(k)) = Σ(k = 0 to m) x·t(k)                          mun:sum-scaled a := 0, b := m, c := x
                             = Σ(k = 0 to m) C(m, k)·x^((m + 1) − k)·y^k     mun:sum-termwise a := 0, b := m, from 8
    requires t : {0, …, m} → ℝ: from 2

16. Σ(k = 0 to m + 1) C(m, k)·x^((m + 1) − k)·y^k = x·(Σ(k = 0 to m) t(k))
    substitute x·(Σ(k = 0 to m) t(k)) = Σ(k = 0 to m) C(m, k)·x^((m + 1) − k)·y^k (line 15) into line 14
    requires Σ(k = 0 to m) t(k) ∈ ℝ: from 7

17. For all k ∈ {0, …, m + 1}, p(k) = C(m, k)·x^((m + 1) − k)·y^k.
    proof
    let k ∈ {0, …, m + 1}                                             (J)

    17.1. p(k) = C(m, k)·x^((m + 1) − k)·y^k
          D2, from J

18. x·(Σ(k = 0 to m) t(k)) = Σ(k = 0 to m + 1) p(k)
    calculation
      x·(Σ(k = 0 to m) t(k)) = Σ(k = 0 to m + 1) C(m, k)·x^((m + 1) − k)·y^k  16
                             = Σ(k = 0 to m + 1) p(k)                         mun:sum-termwise a := 0, b := m + 1, t := p, from 17
    requires p : {0, …, m + 1} → ℝ: from 4

19. For all k ∈ {0, …, m}, y·t(k) = C(m, k)·x^(m − k)·y^(k + 1).
    proof
    note times y, each term gains a power of y and moves to k + 1
    let k ∈ {0, …, m}                                                 (J)

    19.1.  t(k) = C(m, k)·x^(m − k)·y^k
           D1, from J

    19.2.  y^(k + 1) = y^k·y
           mun:exponent-step a := y, m := k

    19.3.  y·t(k) = C(m, k)·x^(m − k)·y^(k + 1)
           calculation
             y·t(k) = y·(C(m, k)·x^(m − k)·y^k)         substitute line 19.1
                    = C(m, k)·x^(m − k)·(y^k·y)         algebra
                    = C(m, k)·x^(m − k)·y^(k + 1)       substitute line 19.2
           requires C(m, k) ∈ ℕ₀: mun:binomial-nat0
           requires m − k ∈ ℕ₀: mun:range-difference a := 0, n := m, from J
           requires x^(m − k) ∈ ℝ: mun:power-real, from H1

20. For all k ∈ {1, …, m + 1}, C(m, k − 1)·x^(m − (k − 1))·y^((k − 1) + 1) = C(m, k − 1)·x^((m + 1) − k)·y^k.
    proof
    let k ∈ {1, …, m + 1}                                             (J)

    20.1.  m − (k − 1) = (m + 1) − k
           algebra

    20.2.  (k − 1) + 1 = k
           algebra

    20.3.  C(m, k − 1)·x^(m − (k − 1))·y^((k − 1) + 1) = C(m, k − 1)·x^((m + 1) − k)·y^k
           calculation
             C(m, k − 1)·x^(m − (k − 1))·y^((k − 1) + 1) = C(m, k − 1)·x^((m + 1) − k)·y^((k − 1) + 1)    substitute line 20.1
                                                         = C(m, k − 1)·x^((m + 1) − k)·y^k                substitute line 20.2

21. C(m, 0 − 1) = 0
    calculation
      C(m, 0 − 1) = C(m, −1)    arithmetic
                  = 0           def:C n := m

22. C(m, 0 − 1)·x^(m + 1)·y^0 = 0
    calculation
      C(m, 0 − 1)·x^(m + 1)·y^0 = 0·x^(m + 1)·y^0    substitute line 21
                                = 0                  algebra
    requires x^(m + 1) ∈ ℝ: mun:power-real a := x, m := m + 1

23. Σ(k = 0 to m + 1) C(m, k − 1)·x^((m + 1) − k)·y^k = C(m, 0 − 1)·x^(m + 1)·y^0 + Σ(k = 1 to m + 1) C(m, k − 1)·x^((m + 1) − k)·y^k
    mun:sum-first n := m + 1

24. Σ(k = 0 to m + 1) C(m, k − 1)·x^((m + 1) − k)·y^k = Σ(k = 1 to m + 1) C(m, k − 1)·x^((m + 1) − k)·y^k
    substitute C(m, 0 − 1)·x^(m + 1)·y^0 = 0 (line 22) into line 23
    requires Σ(k = 1 to m + 1) C(m, k − 1)·x^((m + 1) − k)·y^k ∈ ℝ: mun:sum-real a := 1, b := m + 1

25. For all k ∈ {0, …, m + 1}, q(k) = C(m, k − 1)·x^((m + 1) − k)·y^k.
    proof
    let k ∈ {0, …, m + 1}                                             (J)

    25.1. q(k) = C(m, k − 1)·x^((m + 1) − k)·y^k
          D3, from J

26. y·(Σ(k = 0 to m) t(k)) = Σ(k = 0 to m + 1) q(k)
    calculation
      y·(Σ(k = 0 to m) t(k)) = Σ(k = 0 to m) y·t(k)                                                 mun:sum-scaled a := 0, b := m, c := y
                             = Σ(k = 0 to m) C(m, k)·x^(m − k)·y^(k + 1)                            mun:sum-termwise a := 0, b := m, from 19
                             = Σ(k = 1 to m + 1) C(m, k − 1)·x^(m − (k − 1))·y^((k − 1) + 1)        mun:sum-shift a := 0, b := m, c := 1
                             = Σ(k = 1 to m + 1) C(m, k − 1)·x^((m + 1) − k)·y^k                    mun:sum-termwise a := 1, b := m + 1, from 20
                             = Σ(k = 0 to m + 1) C(m, k − 1)·x^((m + 1) − k)·y^k                    24
                             = Σ(k = 0 to m + 1) q(k)                                               mun:sum-termwise a := 0, b := m + 1, t := q, from 25
    requires t : {0, …, m} → ℝ: from 2
    requires q : {0, …, m + 1} → ℝ: from 6

27. For all k ∈ {0, …, m + 1}, p(k) + q(k) = C(m + 1, k)·x^((m + 1) − k)·y^k.
    proof
    note then the two sums add term by term, and Pascal's rule joins the coefficients
    let k ∈ {0, …, m + 1}                                             (J)

    27.1.  p(k) = C(m, k)·x^((m + 1) − k)·y^k
           D2, from J

    27.2.  q(k) = C(m, k − 1)·x^((m + 1) − k)·y^k
           D3, from J

    27.3.  C(m, k) + C(m, k − 1) = C(m + 1, k)
           thm:pascal n := m

    27.4.  p(k) + q(k) = C(m + 1, k)·x^((m + 1) − k)·y^k
           calculation
             p(k) + q(k) = C(m, k)·x^((m + 1) − k)·y^k + q(k)                                       substitute line 27.1
                         = C(m, k)·x^((m + 1) − k)·y^k + C(m, k − 1)·x^((m + 1) − k)·y^k            substitute line 27.2
                         = (C(m, k) + C(m, k − 1))·x^((m + 1) − k)·y^k                              algebra
                         = C(m + 1, k)·x^((m + 1) − k)·y^k                                          substitute line 27.3
           requires C(m, k) ∈ ℕ₀: mun:binomial-nat0
           requires C(m, k − 1) ∈ ℕ₀: mun:binomial-nat0 k := k − 1
           requires (m + 1) − k ∈ ℕ₀: mun:range-difference a := 0, n := m + 1, from J
           requires x^((m + 1) − k) ∈ ℝ: mun:power-real, from H1

28. For all k ∈ {0, …, m}, t(k) = C(m, k)·x^(m − k)·y^k.
    proof
    let k ∈ {0, …, m}                                                 (J)

    28.1. t(k) = C(m, k)·x^(m − k)·y^k
          D1, from J

29. Σ(k = 0 to m) t(k) = Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k
    mun:sum-termwise a := 0, b := m, from 28
    requires t : {0, …, m} → ℝ: from 2

30. (Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k)·(x + y) = Σ(k = 0 to m + 1) C(m + 1, k)·x^((m + 1) − k)·y^k
    calculation
      (Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k)·(x + y) = (Σ(k = 0 to m) t(k))·(x + y)                           substitute line 29
                                                    = x·(Σ(k = 0 to m) t(k)) + y·(Σ(k = 0 to m) t(k))         algebra
                                                    = Σ(k = 0 to m + 1) p(k) + y·(Σ(k = 0 to m) t(k))         substitute line 18
                                                    = Σ(k = 0 to m + 1) p(k) + Σ(k = 0 to m + 1) q(k)         substitute line 26
                                                    = Σ(k = 0 to m + 1) (p(k) + q(k))                         mun:sum-add a := 0, b := m + 1, t := p, u := q
                                                    = Σ(k = 0 to m + 1) C(m + 1, k)·x^((m + 1) − k)·y^k       mun:sum-termwise a := 0, b := m + 1, from 27
    requires Σ(k = 0 to m) t(k) ∈ ℝ: from 7
    requires p : {0, …, m + 1} → ℝ: from 4
    requires q : {0, …, m + 1} → ℝ: from 6


theorem binomial
  metamath    binom
  note        By induction on the power: (x + y)^0 = 1 is the one term of row
              0, and (x + y)^(m + 1) is (x + y)^m·(x + y), which binomial-step
              turns into row m + 1.
  let x ∈ ℝ                                                           (H1)
  let y ∈ ℝ                                                           (H2)
  let n ∈ ℕ₀                                                          (H3)
  then (x + y)^n = Σ(k = 0 to n) C(n, k)·x^(n − k)·y^k

1.  For all m ∈ ℕ₀, (x + y)^m = Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k.
    induction on m starting at 0

    base
    1.1.  C(0, 0) = 1
          mun:binomial-zero-index n := 0

    1.2.  (x + y)^0 = Σ(k = 0 to 0) C(0, k)·x^(0 − k)·y^k
          calculation
            (x + y)^0 = 1                                        algebra
                      = x^0·y^0                                  algebra
                      = C(0, 0)·x^0·y^0                          substitute line 1.1
                      = Σ(k = 0 to 0) C(0, k)·x^(0 − k)·y^k      mun:sum-single a := 0

    step
    let m ∈ ℕ₀                                                        (K)
    assume step 1 is true for m, the induction hypothesis             (IH)

    1.3.  (x + y)^(m + 1) = Σ(k = 0 to m + 1) C(m + 1, k)·x^((m + 1) − k)·y^k
          calculation
            (x + y)^(m + 1) = (x + y)^m·(x + y)                                          mun:exponent-step a := x + y
                            = (Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k)·(x + y)              substitute IH
                            = Σ(k = 0 to m + 1) C(m + 1, k)·x^((m + 1) − k)·y^k          thm:binomial-step

2.  (x + y)^n = Σ(k = 0 to n) C(n, k)·x^(n − k)·y^k
    instantiate m := n in line 1
