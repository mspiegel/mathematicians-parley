import axiom              stdlib/geometry/side-angle-side
import mundane theorem    stdlib/geometry/angle-symmetric
import definition         stdlib/geometry/congruent

theorem isosceles
  metamath    isosctr
  note        Read the triangle as ACB and as BCA. Two sides and the angle
              between them agree, |CA| = |CB| and the angle at C, so the two
              are congruent and the angles at A and at B match.
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  assume A, B, C form a triangle                                      (H4)
  assume |CA| = |CB|                                                  (H5)
  then ∠CAB = ∠CBA

1.  ∠ACB = ∠BCA
    mun:angle-symmetric P := A, Q := C, R := B, from H4

2.  triangle ACB ≅ triangle BCA
    axi:side-angle-side P := A, Q := C, R := B, P′ := B, Q′ := C, R′ := A,
      from H4, H5, 1

3.  ∠CAB = ∠CBA
    calculation
      ∠CAB = ∠BAC       mun:angle-symmetric P := C, Q := A, R := B, from H4
           = ∠ABC       def:congruent, from 2
           = ∠CBA       mun:angle-symmetric P := A, Q := B, R := C, from H4
