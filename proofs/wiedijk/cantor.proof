import definition         stdlib/sets/set-builder
import mundane theorem    stdlib/sets/set-builder-subset

theorem cantor
  note        Let B be the elements of A that their own image leaves out. If B
              were some f(x), then x would be in B exactly when it is not.
  let A be a set                                                      (H1)
  let f : A → 𝒫A                                                      (H2)
  then there exists B ⊆ A such that f(x) ≠ B for all x ∈ A

let B = {x ∈ A : x ∉ f(x)}                                            (D1)
       reads the members of A that their own image leaves out

1.  B ⊆ A
    mun:set-builder-subset, from D1

2.  For all x ∈ A, f(x) ≠ B.
    proof
    let x ∈ A                                                         (K)
    by          contradiction
    suppose f(x) = B                                                  (S)

    2.1.  x ∉ B
          contradiction
          suppose x ∈ B                                               (S1)

          2.1.1.  x ∉ f(x)
                  def:set-builder, from D1, S1

          2.1.2.  x ∉ B
                  substitute f(x) = B (S) into line 2.1.1, contradicting S1

    2.2.  x ∉ f(x)
          substitute f(x) = B (S) into line 2.1

    2.3.  x ∈ B
          def:set-builder, from D1, K, 2.2, contradicting 2.1

3.  There exists B ⊆ A such that f(x) ≠ B for all x ∈ A.
    exhibit, from 1, 2
