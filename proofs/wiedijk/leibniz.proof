import mundane definition stdlib/calculus/series-sum-from-zero
import theorem            stdlib/calculus/integral-difference
import theorem            stdlib/calculus/integral-nonneg
import theorem            stdlib/calculus/integral-order
import mundane theorem    stdlib/calculus/integral-real
