import mundane theorem    stdlib/functions/function-into
import mundane theorem    stdlib/numbers/nat0-successor
import mundane theorem    stdlib/numbers/one-power
import mundane theorem    stdlib/numbers/zero-power
import mundane theorem    stdlib/sets/in-subset
import theorem            stdlib/calculus/continuous-constant
import theorem            stdlib/calculus/continuous-square
import theorem            stdlib/calculus/continuous-sum
import theorem            stdlib/calculus/continuous-quotient
import theorem            stdlib/trigonometry/continuous-arctan
import theorem            stdlib/trigonometry/derivative-arctan
import mundane definition stdlib/trigonometry/arctan
import mundane theorem    stdlib/trigonometry/arctan-real
import mundane theorem    stdlib/trigonometry/arctan-values
import mundane theorem    stdlib/numbers/square-nonneg
import mundane theorem    stdlib/numbers/exponent-sum
import mundane theorem    stdlib/numbers/exponent-step
import mundane theorem    stdlib/sums/sum-single
import mundane theorem    stdlib/sums/sum-last
import mundane theorem    stdlib/sums/sum-real
