import theorem            stdlib/geometry/law-of-cosines
import theorem            stdlib/geometry/supplementary-angles
import mundane theorem    stdlib/geometry/angle-real
import mundane theorem    stdlib/geometry/between-apart
import mundane theorem    stdlib/geometry/distance-positive
import mundane theorem    stdlib/geometry/distance-zero
import mundane theorem    stdlib/numbers/multiply-cancel
import mundane definition stdlib/trigonometry/cos
import mundane theorem    stdlib/trigonometry/cos-real
import mundane theorem    stdlib/trigonometry/cos-supplement
import mundane axiom      stdlib/reasoning/excluded-middle

theorem power-of-a-point
  note        A point P of a chord AB of a circle with centre O cuts it into
              parts whose product is |AO|² − |PO|². The law of cosines at P
              in the triangles APO and OPB gives |AO|² and |BO|²; the angles
              at P are supplementary, so their cosines are opposite, and the
              cosine drops out between the two. Where P is O there are no
              angles at P, and both parts are radii.
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let P be a point                                                    (H3)
  let O be a point                                                    (H4)
  assume P is between A and B                                         (H5)
  assume |AO| = |BO|                                                  (H6)
  then |PA|·|PB| = |AO|² − |PO|²

1.  O = P or O ≠ P
    mun:excluded-middle P := O = P

2.  |PA|·|PB| = |AO|² − |PO|²
    cases, from 1

    case
    assume O = P                                                      (C1)

    2.1.  |PO| = 0
          mun:distance-zero P := P, Q := O, from C1

    2.2.  |PA|·|PB| = |OA|·|OB|
          substitute P = O (C1)

    2.3.  |PA|·|PB| = |AO|·|AO|
          substitute |BO| = |AO| (H6) into line 2.2

    2.4.  |PA|·|PB| = |AO|² − |PO|²
          algebra, from 2.1, 2.3

    case
    assume O ≠ P                                                      (C2)

    2.5.  A ≠ P. B ≠ P.
          mun:between-apart R := P, S := A, T := B, from H5

    2.6.  |OA|² = |AP|² + |PO|² − 2·(|AP|·|PO|·cos(∠APO))
          thm:law-of-cosines P := A, Q := P, R := O, from C2, 2.5

    2.7.  |BO|² = |OP|² + |PB|² − 2·(|OP|·|PB|·cos(∠OPB))
          thm:law-of-cosines P := O, Q := P, R := B, from C2, 2.5

    2.8.  ∠APO + ∠OPB = 180°
          thm:supplementary-angles A := A, B := P, C := B, D := O, from C2, H5

    2.9.  ∠APO ∈ ℝ
          mun:angle-real P := A, Q := P, R := O, from C2, 2.5

    2.10. ∠OPB ∈ ℝ
          mun:angle-real P := O, Q := P, R := B, from C2, 2.5

    2.11. ∠OPB = 180° − ∠APO
          algebra, from 2.8
          requires ∠APO ∈ ℝ: from 2.9
          requires ∠OPB ∈ ℝ: from 2.10

    2.12. cos(∠OPB) = cos(180° − ∠APO)
          substitute ∠OPB = 180° − ∠APO (line 2.11)

    2.13. cos(180° − ∠APO) = −cos(∠APO)
          mun:cos-supplement x := ∠APO
          requires ∠APO ∈ ℝ: from 2.9

    2.14. cos(∠OPB) = −cos(∠APO)
          calculation
            cos(∠OPB) = cos(180° − ∠APO)      2.12
                      = −cos(∠APO)            2.13

    2.15. |AO|² = |PO|² + |PB|² − 2·(|PO|·|PB|·cos(∠OPB))
          substitute |BO| = |AO| (H6) into line 2.7

    2.16. |AO|² = |PO|² + |PB|² − 2·(|PO|·|PB|·−cos(∠APO))
          substitute cos(∠OPB) = −cos(∠APO) (line 2.14) into line 2.15

    2.17. |PA| > 0
          mun:distance-positive P := P, Q := A, from 2.5

    2.18. |PB| > 0
          mun:distance-positive P := P, Q := B, from 2.5

    2.19. 2·(|PO|·cos(∠APO)) = (|PA|² + |PO|² − |AO|²)/|PA|
          algebra, from 2.6
          requires cos(∠APO) ∈ ℝ: mun:cos-real a := ∠APO, from 2.9
          requires |PA| ≠ 0: weakening, from 2.17

    2.20. 2·(|PO|·cos(∠APO)) = (|AO|² − |PO|² − |PB|²)/|PB|
          algebra, from 2.16
          requires cos(∠APO) ∈ ℝ: mun:cos-real a := ∠APO, from 2.9
          requires |PB| ≠ 0: weakening, from 2.18

    2.21. (|PA|² + |PO|² − |AO|²)/|PA| = (|AO|² − |PO|² − |PB|²)/|PB|
          calculation
            (|PA|² + |PO|² − |AO|²)/|PA| = 2·(|PO|·cos(∠APO))              2.19
                                         = (|AO|² − |PO|² − |PB|²)/|PB|    2.20

    2.22. |PA|·|PB|·(|PA| + |PB|) = (|AO|² − |PO|²)·(|PA| + |PB|)
          algebra, from 2.21
          requires |PA| ≠ 0: weakening, from 2.17
          requires |PB| ≠ 0: weakening, from 2.18

    2.23. |PA| + |PB| > 0
          inequalities, from 2.17, 2.18

    2.24. |PA|·|PB| = |AO|² − |PO|²
          mun:multiply-cancel a := |PA|·|PB|, b := |AO|² − |PO|², c := |PA| + |PB|,
            from 2.22
          requires |PA| + |PB| ≠ 0: weakening, from 2.23

theorem intersecting-chords
  metamath    chordthm
  note        Euclid III.35. Each chord through P is cut by P into parts
              whose product is |AO|² − |PO|², the radius squared less the
              square of P's distance from the centre (power-of-a-point), and
              that does not depend on the chord.
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  let D be a point                                                    (H4)
  let P be a point                                                    (H5)
  let O be a point                                                    (H6)
  assume P is between A and B                                         (H7)
  assume P is between C and D                                         (H8)
  assume |AO| = |BO|                                                  (H9)
  assume |AO| = |CO|                                                  (H10)
  assume |AO| = |DO|                                                  (H11)
  then |PA|·|PB| = |PC|·|PD|

1.  |PA|·|PB| = |AO|² − |PO|²
    thm:power-of-a-point, from H7, H9

2.  |CO| = |DO|
    calculation
      |CO| = |AO|       H10
           = |DO|       H11

3.  |PC|·|PD| = |CO|² − |PO|²
    thm:power-of-a-point A := C, B := D, from H8, 2

4.  |PC|·|PD| = |AO|² − |PO|²
    substitute |CO| = |AO| (H10) into line 3

5.  |PA|·|PB| = |PC|·|PD|
    calculation
      |PA|·|PB| = |AO|² − |PO|²     1
                = |PC|·|PD|         4
