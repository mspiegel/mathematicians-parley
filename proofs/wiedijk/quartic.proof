import mundane theorem    stdlib/numbers/zero-product
import mundane theorem    stdlib/reasoning/or-left
import mundane theorem    stdlib/reasoning/or-right

theorem quartic
  note        With y = x + a/4 the quartic is y⁴ + P·y² + Q·y + R. As in the
              cubic, T + U/T is a root of z³ − 3·U·z − V, so M is a root of
              Ferrari's resolvent M·(P + M)² − Q² − 4·R·M; and with M = 4·S²
              the quartic factors as (y + S − I)·(y + S + I)·(y − S − J)·
              (y − S + J). So it is 0 just when one factor is.
  let a ∈ ℂ                                                           (H1)
  let b ∈ ℂ                                                           (H2)
  let c ∈ ℂ                                                           (H3)
  let d ∈ ℂ                                                           (H4)
  let x ∈ ℂ                                                           (H5)
  let P ∈ ℂ                                                           (H6)
  assume P = b − (3/8)·a²                                             (H7)
  let Q ∈ ℂ                                                           (H8)
  assume Q = c − (a·b)/2 + a³/8                                       (H9)
  let R ∈ ℂ                                                           (H10)
  assume R = d − (c·a)/4 + ((a²·b)/16 − (3/256)·a⁴)                   (H11)
  let U ∈ ℂ                                                           (H12)
  assume U = P² + 12·R                                                (H13)
  let V ∈ ℂ                                                           (H14)
  assume V = −(2·P³) − 27·Q² + 72·(P·R)                               (H15)
  let W ∈ ℂ                                                           (H16)
  assume W² = V² − 4·U³                                               (H17)
  let T ∈ ℂ                                                           (H18)
  assume T³ = (V + W)/2                                               (H19)
  assume T ≠ 0                                                        (H20)
  let M ∈ ℂ                                                           (H21)
  assume M = −(2·P + T + U/T)/3                                       (H22)
  assume M ≠ 0                                                        (H23)
  let S ∈ ℂ                                                           (H24)
  assume 4·S² = M                                                     (H25)
  let I ∈ ℂ                                                           (H26)
  assume I² = −S² − P/2 + (Q/4)/S                                     (H27)
  let J ∈ ℂ                                                           (H28)
  assume J² = −S² − P/2 − (Q/4)/S                                     (H29)
  then x⁴ + a·x³ + b·x² + c·x + d = 0 ↔ (x = −a/4 − S + I or x = −a/4 − S − I) or (x = −a/4 + S + J or x = −a/4 + S − J)

1.  S ≠ 0
    contradiction
    suppose S = 0                                                     (S1)

    1.1.  M = 0
          algebra, from H25, S1, contradicting H23

2.  T³ + U³/T³ = V
    algebra, from H17, H19, H20

3.  (T + U/T)³ − 3·U·(T + U/T) − V = 0
    algebra, from H20, 2

4.  T + U/T = −3·M − 2·P
    algebra, from H20, H22

5.  27·(M·(P + M)² − Q² − 4·R·M) = 0
    calculation
      27·(M·(P + M)² − Q² − 4·R·M) = −(−3·M − 2·P)³ + 3·U·(−3·M − 2·P) + V    algebra, from H13, H15
                                   = −(T + U/T)³ + 3·U·(T + U/T) + V          substitute line 4
                                   = 0                                        algebra, from H20, 3

6.  M·(P + M)² − Q² − 4·R·M = 0
    algebra, from 5

let y = x + a/4, a complex number                                    (D1)
    membership
    reads the root moved so that the quartic has no cube term

let u = (y + S − I)·(y + S + I), a complex number                    (D2)
    membership
    reads the quadratic factor with the roots −S + I and −S − I

let v = (y − S − J)·(y − S + J), a complex number                    (D3)
    membership
    reads the quadratic factor with the roots S + J and S − J

7.  u = y² + 2·S·y + 2·S² + P/2 − (Q/4)/S
    algebra, from D2, H27, 1

8.  v = y² − 2·S·y + 2·S² + P/2 + (Q/4)/S
    algebra, from D3, H29, 1

9.  x⁴ + a·x³ + b·x² + c·x + d = u·v
    calculation
      x⁴ + a·x³ + b·x² + c·x + d = y⁴ + (b − (3/8)·a²)·y² + (c − (a·b)/2 + a³/8)·y + (d − (c·a)/4 + ((a²·b)/16 − (3/256)·a⁴))    algebra, from D1
          = y⁴ + P·y² + (c − (a·b)/2 + a³/8)·y + (d − (c·a)/4 + ((a²·b)/16 − (3/256)·a⁴))                substitute H7
          = y⁴ + P·y² + Q·y + (d − (c·a)/4 + ((a²·b)/16 − (3/256)·a⁴))                                    substitute H9
          = y⁴ + P·y² + Q·y + R                                                                           substitute H11
          = (y² + 2·S·y + 2·S² + P/2 − (Q/4)/S)·(y² − 2·S·y + 2·S² + P/2 + (Q/4)/S)                       algebra, from H25, 1, 6
          = (y² + 2·S·y + 2·S² + P/2 − (Q/4)/S)·v                                                         substitute line 8
          = u·v                                                                                           substitute line 7

10. x⁴ + a·x³ + b·x² + c·x + d = 0 ↔ (x = −a/4 − S + I or x = −a/4 − S − I) or (x = −a/4 + S + J or x = −a/4 + S − J)
    both directions

    direction
    assume x⁴ + a·x³ + b·x² + c·x + d = 0                             (A1)

    10.1. u·v = 0
          calculation
            u·v = x⁴ + a·x³ + b·x² + c·x + d    9
                = 0                             A1

    10.2. u = 0 or v = 0
          mun:zero-product x := u, y := v, from 10.1

    10.3. (x = −a/4 − S + I or x = −a/4 − S − I) or (x = −a/4 + S + J or x = −a/4 + S − J)
          cases, from 10.2

          case
          assume u = 0                                                (C1)

          10.3.1. y + S − I = 0 or y + S + I = 0
                  mun:zero-product x := y + S − I, y := y + S + I, from C1, D2

          10.3.2. x = −a/4 − S + I or x = −a/4 − S − I
                  cases, from 10.3.1

                  case
                  assume y + S − I = 0                                (C2)

                  10.3.2.1. x = −a/4 − S + I
                            algebra, from C2, D1

                  10.3.2.2. x = −a/4 − S + I or x = −a/4 − S − I
                            mun:or-left, from 10.3.2.1

                  case
                  assume y + S + I = 0                                (C3)

                  10.3.2.3. x = −a/4 − S − I
                            algebra, from C3, D1

                  10.3.2.4. x = −a/4 − S + I or x = −a/4 − S − I
                            mun:or-right, from 10.3.2.3

          10.3.3. (x = −a/4 − S + I or x = −a/4 − S − I) or (x = −a/4 + S + J or x = −a/4 + S − J)
                  mun:or-left, from 10.3.2

          case
          assume v = 0                                                (C4)

          10.3.4. y − S − J = 0 or y − S + J = 0
                  mun:zero-product x := y − S − J, y := y − S + J, from C4, D3

          10.3.5. x = −a/4 + S + J or x = −a/4 + S − J
                  cases, from 10.3.4

                  case
                  assume y − S − J = 0                                (C5)

                  10.3.5.1. x = −a/4 + S + J
                            algebra, from C5, D1

                  10.3.5.2. x = −a/4 + S + J or x = −a/4 + S − J
                            mun:or-left, from 10.3.5.1

                  case
                  assume y − S + J = 0                                (C6)

                  10.3.5.3. x = −a/4 + S − J
                            algebra, from C6, D1

                  10.3.5.4. x = −a/4 + S + J or x = −a/4 + S − J
                            mun:or-right, from 10.3.5.3

          10.3.6. (x = −a/4 − S + I or x = −a/4 − S − I) or (x = −a/4 + S + J or x = −a/4 + S − J)
                  mun:or-right, from 10.3.5

    direction
    assume (x = −a/4 − S + I or x = −a/4 − S − I) or (x = −a/4 + S + J or x = −a/4 + S − J)    (A2)

    10.4. u·v = 0
          cases, from A2

          case
          assume x = −a/4 − S + I or x = −a/4 − S − I                 (C7)

          10.4.1. u·v = 0
                  cases, from C7

                  case
                  assume x = −a/4 − S + I                             (C8)

                  10.4.1.1. y + S − I = 0
                            algebra, from C8, D1

                  10.4.1.2. u·v = 0
                            algebra, from D2, 10.4.1.1

                  case
                  assume x = −a/4 − S − I                             (C9)

                  10.4.1.3. y + S + I = 0
                            algebra, from C9, D1

                  10.4.1.4. u·v = 0
                            algebra, from D2, 10.4.1.3

          case
          assume x = −a/4 + S + J or x = −a/4 + S − J                 (C10)

          10.4.2. u·v = 0
                  cases, from C10

                  case
                  assume x = −a/4 + S + J                             (C11)

                  10.4.2.1. y − S − J = 0
                            algebra, from C11, D1

                  10.4.2.2. u·v = 0
                            algebra, from D3, 10.4.2.1

                  case
                  assume x = −a/4 + S − J                             (C12)

                  10.4.2.3. y − S + J = 0
                            algebra, from C12, D1

                  10.4.2.4. u·v = 0
                            algebra, from D3, 10.4.2.3

    10.5. x⁴ + a·x³ + b·x² + c·x + d = 0
          calculation
            x⁴ + a·x³ + b·x² + c·x + d = u·v    9
                                       = 0      10.4
