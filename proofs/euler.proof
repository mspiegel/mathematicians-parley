import definition         stdlib/divisibility/φ
import mundane definition stdlib/divisibility/gcd
import theorem            stdlib/divisibility/congruent-cancel
import theorem            stdlib/divisibility/coprime-divides
import mundane definition stdlib/divisibility/congruent-mod
import theorem            stdlib/divisibility/product-coprime
import theorem            stdlib/divisibility/product-congruent
import theorem            stdlib/sums/product-reorder
import theorem            stdlib/sums/product-factor
import mundane theorem    stdlib/sums/product-integer
import mundane theorem    stdlib/divisibility/coprime-product
import mundane theorem    stdlib/divisibility/congruent-in-range
import mundane theorem    stdlib/divisibility/mod-congruent
import mundane theorem    stdlib/divisibility/mod-equal-congruent
import theorem            stdlib/divisibility/gcd-mod
import mundane theorem    stdlib/divisibility/mod-natural
import mundane theorem    stdlib/divisibility/mod-less
import mundane theorem    stdlib/divisibility/phi-natural
import mundane theorem    stdlib/functions/function-into
import mundane definition stdlib/functions/one-to-one
import mundane theorem    stdlib/counting/finite-part
import mundane theorem    stdlib/numbers/int-real
import mundane theorem    stdlib/numbers/int-closure
import mundane theorem    stdlib/sums/range-finite
import mundane theorem    stdlib/sums/range-from-bounds
import mundane theorem    stdlib/sums/range-in-integers
import mundane theorem    stdlib/sums/range-integer
import mundane definition stdlib/sets/set-builder
import mundane theorem    stdlib/sets/set-builder-subset
import mundane theorem    stdlib/sets/subset-transitive

theorem euler
  metamath    eulerth
  let n ∈ ℕ                                                           (H1)
  let a ∈ ℤ                                                           (H2)
  assume gcd(a, n) = 1                                                (H3)
  then a^φ(n) ≡ 1 (mod n)

define S := {r ∈ {0, …, n − 1} : gcd(r, n) = 1}                      (D1)
       reads the remainders on dividing by n that have no factor in common with n

define f(r) := (r·a) mod n, for r ∈ S                                (D2)
       reads the remainder of r times a on dividing by n

1.  {0, …, n − 1} is finite
    mun:range-finite
    requires 0 ∈ ℤ: arithmetic
    requires n − 1 ∈ ℤ: membership, from H1

2.  {0, …, n − 1} ⊆ ℤ
    mun:range-in-integers
    requires 0 ∈ ℤ: arithmetic
    requires n − 1 ∈ ℤ: membership, from H1

3.  S ⊆ {0, …, n − 1}
    mun:set-builder-subset, from D1

4.  S is finite
    mun:finite-part, from 1, 3

5.  S ⊆ ℤ
    mun:subset-transitive, from 3, 2

6.  For all r ∈ S, f(r) ∈ S.
    fix
    let r ∈ S                                                         (K1)

    6.1.  r ∈ {0, …, n − 1}. gcd(r, n) = 1.
          mun:set-builder u := r, from K1, D1

    6.2.  gcd(r·a, n) = 1
          mun:coprime-product, from H2, H1, 6.1, H3
          requires 0 ∈ ℤ: arithmetic
          requires n − 1 ∈ ℤ: membership, from H1
          requires r ∈ ℤ: mun:range-integer, from 6.1

    6.3.  gcd((r·a) mod n, n) = gcd(r·a, n)
          thm:gcd-mod, from H1
          requires 0 ∈ ℤ: arithmetic
          requires n − 1 ∈ ℤ: membership, from H1
          requires r ∈ ℤ: mun:range-integer, from 6.1
          requires r·a ∈ ℤ: membership, from H2

    6.4.  gcd((r·a) mod n, n) = 1
          calculation
            gcd((r·a) mod n, n) = gcd(r·a, n)        6.3
                                = 1                  6.2

    6.5.  (r·a) mod n < n
          mun:mod-less, from H1
          requires 0 ∈ ℤ: arithmetic
          requires n − 1 ∈ ℤ: membership, from H1
          requires r ∈ ℤ: mun:range-integer, from 6.1
          requires r·a ∈ ℤ: membership, from H2

    6.6.  (r·a) mod n ∈ {0, …, n − 1}
          mun:range-from-bounds, from H1, 6.5
          requires 0 ∈ ℤ: arithmetic
          requires n − 1 ∈ ℤ: membership, from H1
          requires r ∈ ℤ: mun:range-integer, from 6.1
          requires r·a ∈ ℤ: membership, from H2
          requires (r·a) mod n ∈ ℕ₀: mun:mod-natural, from H1

    6.7.  (r·a) mod n ∈ S
          mun:set-builder u := (r·a) mod n, from 6.6, 6.4, D1

    6.8.  f(r) = (r·a) mod n
          D2, from K1

    6.9.  f(r) ∈ S
          substitute f(r) = (r·a) mod n (line 6.8) into line 6.7

7.  For all s, t ∈ S, if f(s) = f(t) then s = t.
    fix
    let s ∈ S                                                         (K2)
    let t ∈ S                                                         (K3)
    assume f(s) = f(t)                                                (K4)

    7.1.  s ∈ {0, …, n − 1}. gcd(s, n) = 1.
          mun:set-builder u := s, from K2, D1

    7.2.  t ∈ {0, …, n − 1}. gcd(t, n) = 1.
          mun:set-builder u := t, from K3, D1

    7.3.  f(s) = (s·a) mod n
          D2, from K2

    7.4.  f(t) = (t·a) mod n
          D2, from K3

    7.5.  (s·a) mod n = (t·a) mod n
          calculation
            (s·a) mod n = f(s)          7.3
                        = f(t)          K4
                        = (t·a) mod n   7.4

    7.6.  s·a ≡ t·a (mod n)
          mun:mod-equal-congruent, from H1, 7.5
          requires 0 ∈ ℤ: arithmetic
          requires n − 1 ∈ ℤ: membership, from H1
          requires s ∈ ℤ: mun:range-integer, from 7.1
          requires t ∈ ℤ: mun:range-integer, from 7.2
          requires s·a ∈ ℤ: membership, from H2
          requires t·a ∈ ℤ: membership, from H2

    7.7.  s ≡ t (mod n)
          thm:congruent-cancel c := a, from H2, H1, 7.6, H3
          requires 0 ∈ ℤ: arithmetic
          requires n − 1 ∈ ℤ: membership, from H1
          requires s ∈ ℤ: mun:range-integer, from 7.1
          requires t ∈ ℤ: mun:range-integer, from 7.2

    7.8.  s = t
          mun:congruent-in-range, from H1, 7.1, 7.2, 7.7

8.  f : S → S
    mun:function-into, from 6
    requires f is a function on S: from D2

9.  f : S → S is one-to-one
    mun:one-to-one, from 8, 7

10. ∏(r ∈ S) f(r) = ∏(r ∈ S) r
    thm:product-reorder, from 5, 4, 9

11. For all r ∈ S, r·a ≡ f(r) (mod n).
    fix
    let r ∈ S                                                         (K5)

    11.1. r ∈ {0, …, n − 1}. gcd(r, n) = 1.
          mun:set-builder u := r, from K5, D1

    11.2. r·a ≡ (r·a) mod n (mod n)
          mun:mod-congruent, from H1
          requires 0 ∈ ℤ: arithmetic
          requires n − 1 ∈ ℤ: membership, from H1
          requires r ∈ ℤ: mun:range-integer, from 11.1
          requires r·a ∈ ℤ: membership, from H2

    11.3. f(r) = (r·a) mod n
          D2, from K5

    11.4. r·a ≡ f(r) (mod n)
          substitute f(r) = (r·a) mod n (line 11.3) into line 11.2

12. ∏(r ∈ S) r·a ≡ ∏(r ∈ S) f(r) (mod n)
    thm:product-congruent X := S, f := f, from 5, 4, H2, H1, 11
    requires f : S → S: from 8

13. ∏(r ∈ S) r·a = a^|S|·∏(r ∈ S) r
    thm:product-factor, from 5, 4, H2

14. φ(n) = |S|
    def:φ, from H1, D1

15. a^|S|·∏(r ∈ S) r ≡ ∏(r ∈ S) f(r) (mod n)
    substitute ∏(r ∈ S) r·a = a^|S|·∏(r ∈ S) r (line 13) into line 12

16. a^|S|·∏(r ∈ S) r ≡ ∏(r ∈ S) r (mod n)
    substitute ∏(r ∈ S) f(r) = ∏(r ∈ S) r (line 10) into line 15

17. a^φ(n)·∏(r ∈ S) r ≡ ∏(r ∈ S) r (mod n)
    substitute φ(n) = |S| (line 14) into line 16

18. For all r ∈ S, gcd(r, n) = 1.
    mun:set-builder u := r, from D1

19. gcd(∏(r ∈ S) r, n) = 1
    thm:product-coprime, from 5, 4, H1, 18

20. a^φ(n)·∏(r ∈ S) r − ∏(r ∈ S) r = (a^φ(n) − 1)·∏(r ∈ S) r
    algebra
    requires φ(n) ∈ ℕ: mun:phi-natural, from H1
    requires a^φ(n) ∈ ℝ: membership, from H2
    requires ∏(r ∈ S) r ∈ ℤ: mun:product-integer, from 5, 4
    requires ∏(r ∈ S) r ∈ ℝ: mun:int-real

21. n divides a^φ(n)·∏(r ∈ S) r − ∏(r ∈ S) r
    mun:congruent-mod, from 17
    requires n ∈ ℤ: membership, from H1
    requires φ(n) ∈ ℕ: mun:phi-natural, from H1
    requires a^φ(n) ∈ ℤ: membership, from H2
    requires ∏(r ∈ S) r ∈ ℤ: mun:product-integer, from 5, 4
    requires a^φ(n)·∏(r ∈ S) r ∈ ℤ: mun:int-closure

22. n divides (a^φ(n) − 1)·∏(r ∈ S) r
    substitute a^φ(n)·∏(r ∈ S) r − ∏(r ∈ S) r = (a^φ(n) − 1)·∏(r ∈ S) r (line 20) into line 21

23. n divides a^φ(n) − 1
    thm:coprime-divides c := ∏(r ∈ S) r, from H1, 22, 19
    requires ∏(r ∈ S) r ∈ ℤ: mun:product-integer, from 5, 4
    requires φ(n) ∈ ℕ: mun:phi-natural, from H1
    requires a^φ(n) − 1 ∈ ℤ: membership, from H2

24. a^φ(n) ≡ 1 (mod n)
    mun:congruent-mod, from 23
    requires n ∈ ℤ: membership, from H1
    requires φ(n) ∈ ℕ: mun:phi-natural, from H1
    requires a^φ(n) ∈ ℤ: membership, from H2
    requires 1 ∈ ℤ: arithmetic
