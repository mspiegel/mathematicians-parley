import definition         stdlib/divisibility/φ
import mundane definition stdlib/divisibility/gcd
import theorem            stdlib/divisibility/congruent-cancel
import theorem            stdlib/divisibility/coprime-divides
import mundane definition stdlib/divisibility/congruent-mod
import theorem            stdlib/divisibility/product-coprime
import theorem            stdlib/divisibility/product-congruent
import theorem            stdlib/sums/product-reorder
import theorem            stdlib/sums/product-factor
import mundane theorem    stdlib/sums/product-integer
import mundane theorem    stdlib/divisibility/coprime-product
import mundane theorem    stdlib/divisibility/congruent-in-range
import mundane theorem    stdlib/divisibility/mod-congruent
import mundane theorem    stdlib/divisibility/mod-equal-congruent
import theorem            stdlib/divisibility/gcd-mod
import mundane theorem    stdlib/divisibility/mod-natural
import mundane theorem    stdlib/divisibility/mod-less
import mundane theorem    stdlib/functions/function-into
import mundane definition stdlib/functions/one-to-one
import mundane theorem    stdlib/counting/finite-part
import mundane theorem    stdlib/counting/card-nat0
import mundane theorem    stdlib/numbers/int-real
import mundane theorem    stdlib/numbers/int-closure
import mundane theorem    stdlib/sums/range-finite
import mundane theorem    stdlib/sums/range-from-bounds
import mundane theorem    stdlib/sums/range-in-integers
import mundane theorem    stdlib/sums/range-integer
import mundane definition stdlib/sets/set-builder
import mundane theorem    stdlib/sets/set-builder-subset
import mundane theorem    stdlib/sets/subset-transitive

theorem euler
  metamath    eulerth
  let n ∈ ℕ                                                           (H1)
  let a ∈ ℤ                                                           (H2)
  assume gcd(a, n) = 1                                                (H3)
  then a^φ(n) ≡ 1 (mod n)

define S := {r ∈ {0, …, n − 1} : gcd(r, n) = 1}                      (D1)
       reads the remainders on dividing by n that have no factor in common with n

define f(r) := (r·a) mod n, for r ∈ S                                (D2)
       reads the remainder of r times a on dividing by n

1.  n − 1 ∈ ℤ
    membership, from H1

2.  {0, …, n − 1} is finite
    mun:range-finite
    requires 0 ∈ ℤ: arithmetic
    requires n − 1 ∈ ℤ: from 1

3.  {0, …, n − 1} ⊆ ℤ
    mun:range-in-integers
    requires 0 ∈ ℤ: arithmetic
    requires n − 1 ∈ ℤ: from 1

4.  S ⊆ {0, …, n − 1}
    mun:set-builder-subset, from D1

5.  S is finite
    mun:finite-part, from 2, 4

6.  S ⊆ ℤ
    mun:subset-transitive, from 4, 3

7.  For all r ∈ S, f(r) ∈ S.
    fix
    let r ∈ S                                                         (K1)

    7.1.  r ∈ {0, …, n − 1}. gcd(r, n) = 1.
          mun:set-builder u := r, from K1, D1

    7.2.  r ∈ ℤ
          mun:range-integer, from 7.1
          requires 0 ∈ ℤ: arithmetic
          requires n − 1 ∈ ℤ: from 1

    7.3.  r·a ∈ ℤ
          membership, from 7.2, H2

    7.4.  gcd(r·a, n) = 1
          mun:coprime-product, from 7.2, H2, H1, 7.1, H3

    7.5.  gcd((r·a) mod n, n) = gcd(r·a, n)
          thm:gcd-mod, from 7.3, H1

    7.6.  gcd((r·a) mod n, n) = 1
          calculation
            gcd((r·a) mod n, n) = gcd(r·a, n)        7.5
                                = 1                  7.4

    7.7.  (r·a) mod n ∈ ℕ₀
          mun:mod-natural, from 7.3, H1

    7.8.  (r·a) mod n < n
          mun:mod-less, from 7.3, H1

    7.9.  (r·a) mod n ∈ {0, …, n − 1}
          mun:range-from-bounds, from H1, 7.7, 7.8

    7.10. (r·a) mod n ∈ S
          mun:set-builder u := (r·a) mod n, from 7.9, 7.6, D1

    7.11. f(r) = (r·a) mod n
          D2, from K1

    7.12. f(r) ∈ S
          substitute f(r) = (r·a) mod n (line 7.11) into line 7.10

8.  For all s, t ∈ S, if f(s) = f(t) then s = t.
    fix
    let s ∈ S                                                         (K2)
    let t ∈ S                                                         (K3)
    assume f(s) = f(t)                                                (K4)

    8.1.  s ∈ {0, …, n − 1}. gcd(s, n) = 1.
          mun:set-builder u := s, from K2, D1

    8.2.  t ∈ {0, …, n − 1}. gcd(t, n) = 1.
          mun:set-builder u := t, from K3, D1

    8.3.  s ∈ ℤ
          mun:range-integer, from 8.1
          requires 0 ∈ ℤ: arithmetic
          requires n − 1 ∈ ℤ: from 1

    8.4.  t ∈ ℤ
          mun:range-integer, from 8.2
          requires 0 ∈ ℤ: arithmetic
          requires n − 1 ∈ ℤ: from 1

    8.5.  s·a ∈ ℤ
          membership, from 8.3, H2

    8.6.  t·a ∈ ℤ
          membership, from 8.4, H2

    8.7.  f(s) = (s·a) mod n
          D2, from K2

    8.8.  f(t) = (t·a) mod n
          D2, from K3

    8.9.  (s·a) mod n = (t·a) mod n
          calculation
            (s·a) mod n = f(s)          8.7
                        = f(t)          K4
                        = (t·a) mod n   8.8

    8.10. s·a ≡ t·a (mod n)
          mun:mod-equal-congruent, from 8.5, 8.6, H1, 8.9

    8.11. s ≡ t (mod n)
          thm:congruent-cancel c := a, from 8.3, 8.4, H2, H1, 8.10, H3

    8.12. s = t
          mun:congruent-in-range, from H1, 8.1, 8.2, 8.11

9.  f : S → S
    mun:function-into, from 7
    requires f is a function on S: from D2

10. f : S → S is one-to-one
    mun:one-to-one, from 9, 8

11. ∏(r ∈ S) f(r) = ∏(r ∈ S) r
    thm:product-reorder, from 6, 5, 10

12. For all r ∈ S, r·a ≡ f(r) (mod n).
    fix
    let r ∈ S                                                         (K5)

    12.1. r ∈ {0, …, n − 1}. gcd(r, n) = 1.
          mun:set-builder u := r, from K5, D1

    12.2. r ∈ ℤ
          mun:range-integer, from 12.1
          requires 0 ∈ ℤ: arithmetic
          requires n − 1 ∈ ℤ: from 1

    12.3. r·a ∈ ℤ
          membership, from 12.2, H2

    12.4. r·a ≡ (r·a) mod n (mod n)
          mun:mod-congruent, from 12.3, H1

    12.5. f(r) = (r·a) mod n
          D2, from K5

    12.6. r·a ≡ f(r) (mod n)
          substitute f(r) = (r·a) mod n (line 12.5) into line 12.4

13. ∏(r ∈ S) r·a ≡ ∏(r ∈ S) f(r) (mod n)
    thm:product-congruent X := S, f := f, from 6, 5, H2, H1, 12
    requires f : S → S: from 9

14. ∏(r ∈ S) r·a = a^|S|·∏(r ∈ S) r
    thm:product-factor, from 6, 5, H2

15. φ(n) = |S|
    def:φ, from H1, D1

16. a^|S|·∏(r ∈ S) r ≡ ∏(r ∈ S) f(r) (mod n)
    substitute ∏(r ∈ S) r·a = a^|S|·∏(r ∈ S) r (line 14) into line 13

17. a^|S|·∏(r ∈ S) r ≡ ∏(r ∈ S) r (mod n)
    substitute ∏(r ∈ S) f(r) = ∏(r ∈ S) r (line 11) into line 16

18. a^φ(n)·∏(r ∈ S) r ≡ ∏(r ∈ S) r (mod n)
    substitute φ(n) = |S| (line 15) into line 17

19. For all r ∈ S, gcd(r, n) = 1.
    mun:set-builder u := r, from D1

20. gcd(∏(r ∈ S) r, n) = 1
    thm:product-coprime, from 6, 5, H1, 19

21. ∏(r ∈ S) r ∈ ℤ
    mun:product-integer, from 6, 5

22. |S| ∈ ℕ₀
    mun:card-nat0, from 5

23. φ(n) ∈ ℕ₀
    substitute φ(n) = |S| (line 15) into line 22

24. a^φ(n) ∈ ℤ
    membership, from H2, 23

25. a^φ(n)·∏(r ∈ S) r − ∏(r ∈ S) r = (a^φ(n) − 1)·∏(r ∈ S) r
    algebra
    requires a^φ(n) ∈ ℝ: mun:int-real, from 24
    requires ∏(r ∈ S) r ∈ ℝ: mun:int-real, from 21

26. n divides a^φ(n)·∏(r ∈ S) r − ∏(r ∈ S) r
    mun:congruent-mod, from 18
    requires n ∈ ℤ: membership, from H1
    requires a^φ(n)·∏(r ∈ S) r ∈ ℤ: mun:int-closure, from 24, 21
    requires ∏(r ∈ S) r ∈ ℤ: from 21

27. n divides (a^φ(n) − 1)·∏(r ∈ S) r
    substitute a^φ(n)·∏(r ∈ S) r − ∏(r ∈ S) r = (a^φ(n) − 1)·∏(r ∈ S) r (line 25) into line 26

28. n divides a^φ(n) − 1
    thm:coprime-divides c := ∏(r ∈ S) r, from 21, H1, 27, 20
    requires a^φ(n) − 1 ∈ ℤ: membership, from H2, 23

29. a^φ(n) ≡ 1 (mod n)
    mun:congruent-mod, from 28
    requires n ∈ ℤ: membership, from H1
    requires a^φ(n) ∈ ℤ: from 24
    requires 1 ∈ ℤ: arithmetic
