import mundane theorem    stdlib/numbers/exponent-one
import mundane theorem    stdlib/numbers/exponent-step
import mundane theorem    stdlib/numbers/exponent-zero
import mundane theorem    stdlib/numbers/nat0-closure
import mundane theorem    stdlib/numbers/power-real
import mundane theorem    stdlib/sums/sum-last
import mundane theorem    stdlib/sums/sum-single

theorem geometric-sum
  metamath    geoser
  let a ∈ ℝ                                                           (H1)
  assume a ≠ 1                                                        (H2)
  let n ∈ ℕ₀                                                          (H3)
  then Σ(k = 0 to n) a^k = (1 − a^(n + 1))/(1 − a)

define G(m) := Σ(j = 0 to m) a^j, for m ∈ ℕ₀                          (D1)
       reads the sum of the powers of a up to the m-th

1.  1 − a ≠ 0
    algebra, from H2
    requires a ∈ ℝ: from H1

2.  For all k ∈ ℕ₀, G(k) = (1 − a^(k + 1))/(1 − a).
    induction on k starting at 0

    base
    2.1.  Σ(j = 0 to 0) a^j = a^0
          mun:sum-single a := 0
          requires 0 ∈ ℤ: arithmetic
          requires a ∈ ℝ: from H1

    2.2.  a^0 = 1
          mun:exponent-zero a := a, from H1

    2.3.  G(0) = 1
          calculation
            G(0) = Σ(j = 0 to 0) a^j     D1
                 = a^0                   2.1
                 = 1                     2.2

    2.4.  a^(0 + 1) = a^1
          substitute 0 + 1 = 1 (arithmetic)

    2.5.  a^1 = a
          mun:exponent-one a := a, from H1

    2.6.  a^(0 + 1) = a
          calculation
            a^(0 + 1) = a^1       2.4
                      = a         2.5

    2.7.  1 = (1 − a)/(1 − a)
          algebra
          requires 1 − a ≠ 0: from 1
          requires a ∈ ℝ: from H1

    2.8.  (1 − a)/(1 − a) = (1 − a^(0 + 1))/(1 − a)
          substitute a^(0 + 1) = a (line 2.6)

    2.9.  G(0) = (1 − a^(0 + 1))/(1 − a)
          calculation
            G(0) = 1                              2.3
                 = (1 − a)/(1 − a)                2.7
                 = (1 − a^(0 + 1))/(1 − a)        2.8

    step
    let k ∈ ℕ₀                                                        (K)
    assume step 2 is true for k, the induction hypothesis             (IH)

    2.10. k + 1 ∈ ℕ₀
          mun:nat0-closure, from K

    2.11. Σ(j = 0 to k + 1) a^j = Σ(j = 0 to k) a^j + a^(k + 1)
          mun:sum-last n := k, from K
          requires a ∈ ℝ: from H1

    2.12. G(k + 1) = G(k) + a^(k + 1)
          calculation
            G(k + 1) = Σ(j = 0 to k + 1) a^j              D1
                     = Σ(j = 0 to k) a^j + a^(k + 1)      2.11
                     = G(k) + a^(k + 1)                   D1
          requires k + 1 ∈ ℕ₀: from 2.10
          requires k ∈ ℕ₀: from K

    2.13. G(k) + a^(k + 1) = (1 − a^(k + 1))/(1 − a) + a^(k + 1)
          substitute G(k) = (1 − a^(k + 1))/(1 − a) (IH)

    2.14. a^((k + 1) + 1) = a^(k + 1)·a
          mun:exponent-step m := k + 1, from H1, 2.10

    2.15. (1 − a^(k + 1))/(1 − a) + a^(k + 1) = (1 − a^(k + 1)·a)/(1 − a)
          algebra
          requires 1 − a ≠ 0: from 1
          requires a ∈ ℝ: from H1
          requires a^(k + 1) ∈ ℝ: mun:power-real m := k + 1, from H1, 2.10

    2.16. (1 − a^(k + 1)·a)/(1 − a) = (1 − a^((k + 1) + 1))/(1 − a)
          substitute a^((k + 1) + 1) = a^(k + 1)·a (line 2.14)

    2.17. G(k + 1) = (1 − a^((k + 1) + 1))/(1 − a)
          calculation
            G(k + 1) = G(k) + a^(k + 1)                         2.12
                     = (1 − a^(k + 1))/(1 − a) + a^(k + 1)      2.13
                     = (1 − a^(k + 1)·a)/(1 − a)               2.15
                     = (1 − a^((k + 1) + 1))/(1 − a)           2.16

3.  G(n) = (1 − a^(n + 1))/(1 − a)
    instantiate k := n in line 2, from H3

4.  Σ(k = 0 to n) a^k = (1 − a^(n + 1))/(1 − a)
    calculation
      Σ(k = 0 to n) a^k = G(n)                          D1
                        = (1 − a^(n + 1))/(1 − a)       3
    requires n ∈ ℕ₀: from H3
