import axiom              stdlib/geometry/side-angle-side
import mundane theorem    stdlib/geometry/angle-symmetric
import mundane theorem    stdlib/geometry/distance-symmetric
import definition         stdlib/geometry/congruent

theorem isosceles
  metamath    isosctr
  note        Read the triangle as ACB and as BCA. Two sides and the angle
              between them agree, |CA| = |CB| and the angle at C, so the two
              are congruent and the angles at A and at B match.
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  assume A, B, C form a triangle                                      (H4)
  assume |CA| = |CB|                                                  (H5)
  then ∠CAB = ∠CBA

1.  |AC| = |CA|
    mun:distance-symmetric P := A, Q := C

2.  |CB| = |BC|
    mun:distance-symmetric P := C, Q := B

3.  |AC| = |BC|
    calculation
      |AC| = |CA|       1
           = |CB|       H5
           = |BC|       2

4.  ∠ACB = ∠BCA
    mun:angle-symmetric P := A, Q := C, R := B, from H4

5.  triangle ACB ≅ triangle BCA
    axi:side-angle-side P := A, Q := C, R := B, P′ := B, Q′ := C, R′ := A,
      from 3, 4, H4, H5

6.  ∠BAC = ∠ABC
    def:congruent, from 5

7.  ∠CAB = ∠BAC
    mun:angle-symmetric P := C, Q := A, R := B, from H4

8.  ∠ABC = ∠CBA
    mun:angle-symmetric P := A, Q := B, R := C, from H4

9.  ∠CAB = ∠CBA
    calculation
      ∠CAB = ∠BAC       7
           = ∠ABC       6
           = ∠CBA       8
