import mundane definition stdlib/trigonometry/cos
import mundane definition stdlib/trigonometry/sin
import mundane theorem    stdlib/trigonometry/cos-complex as trigonometry-cos-complex
import mundane theorem    stdlib/trigonometry/sin-complex as trigonometry-sin-complex
import mundane theorem    stdlib/trigonometry/cos-negative as trigonometry-cos-negative
import mundane theorem    stdlib/trigonometry/sin-negative as trigonometry-sin-negative
import mundane theorem    stdlib/trigonometry/sin-cos-squares as trigonometry-sin-cos-squares
import mundane theorem    stdlib/trigonometry/sin-nonneg as trigonometry-sin-nonneg
import mundane theorem    stdlib/trigonometry/sin-positive as trigonometry-sin-positive
import mundane theorem    stdlib/trigonometry/cos-nonneg as trigonometry-cos-nonneg
import mundane theorem    stdlib/trigonometry/cos-positive as trigonometry-cos-positive
import mundane theorem    stdlib/trigonometry/sin-bounded as trigonometry-sin-bounded
import mundane theorem    stdlib/trigonometry/cos-bounded as trigonometry-cos-bounded
import mundane theorem    stdlib/trigonometry/cos-decreasing as trigonometry-cos-decreasing
import mundane theorem    stdlib/trigonometry/special-angles as trigonometry-special-angles
import mundane theorem    stdlib/trigonometry/cos-supplement as trigonometry-cos-supplement
import mundane theorem    stdlib/trigonometry/sin-supplement as trigonometry-sin-supplement
import mundane definition stdlib/trigonometry/arctan
import mundane theorem    stdlib/trigonometry/arctan-values as trigonometry-arctan-values
import mundane theorem    stdlib/trigonometry/arctan-real as trigonometry-arctan-real
import theorem            stdlib/trigonometry/continuous-arctan as trigonometry-continuous-arctan
import theorem            stdlib/trigonometry/derivative-arctan as trigonometry-derivative-arctan

theorem cos-complex
  let a ∈ ℂ                                                           (H1)
  then cos(a) ∈ ℂ

1.  cos(a) ∈ ℂ
    mun:trigonometry-cos-complex

theorem sin-complex
  let a ∈ ℂ                                                           (H1)
  then sin(a) ∈ ℂ

1.  sin(a) ∈ ℂ
    mun:trigonometry-sin-complex

theorem cos-negative
  let a ∈ ℂ                                                           (H1)
  then cos(−a) = cos(a)

1.  cos(−a) = cos(a)
    mun:trigonometry-cos-negative

theorem sin-negative
  let a ∈ ℂ                                                           (H1)
  then sin(−a) = −sin(a)

1.  sin(−a) = −sin(a)
    mun:trigonometry-sin-negative

theorem sin-cos-squares
  let a ∈ ℂ                                                           (H1)
  then sin(a)² + cos(a)² = 1

1.  sin(a)² + cos(a)² = 1
    mun:trigonometry-sin-cos-squares

theorem sin-nonneg
  let a ∈ [0, π]                                                      (H1)
  then 0 ≤ sin(a)

1.  0 ≤ sin(a)
    mun:trigonometry-sin-nonneg, from H1

theorem sin-positive
  let a ∈ (0, π)                                                      (H1)
  then 0 < sin(a)

1.  0 < sin(a)
    mun:trigonometry-sin-positive, from H1

theorem cos-nonneg
  let a ∈ [−π/2, π/2]                                                 (H1)
  then 0 ≤ cos(a)

1.  0 ≤ cos(a)
    mun:trigonometry-cos-nonneg, from H1

theorem cos-positive
  let a ∈ (−π/2, π/2)                                                 (H1)
  then 0 < cos(a)

1.  0 < cos(a)
    mun:trigonometry-cos-positive, from H1

theorem sin-bounded
  let a ∈ ℝ                                                           (H1)
  then −1 ≤ sin(a). sin(a) ≤ 1.

1.  −1 ≤ sin(a). sin(a) ≤ 1.
    mun:trigonometry-sin-bounded

theorem cos-bounded
  let a ∈ ℝ                                                           (H1)
  then −1 ≤ cos(a). cos(a) ≤ 1.

1.  −1 ≤ cos(a). cos(a) ≤ 1.
    mun:trigonometry-cos-bounded

theorem cos-decreasing
  let a ∈ [0, π]                                                      (H1)
  let b ∈ [0, π]                                                      (H2)
  then a < b ↔ cos(b) < cos(a)

1.  a < b ↔ cos(b) < cos(a)
    mun:trigonometry-cos-decreasing, from H1, H2

theorem special-angles
  then cos(90°) = 0. sin(90°) = 1. cos(60°) = 1/2. sin(30°) = 1/2.

1.  cos(90°) = 0. sin(90°) = 1. cos(60°) = 1/2. sin(30°) = 1/2.
    mun:trigonometry-special-angles

theorem cos-supplement
  let x ∈ ℝ                                                           (H1)
  then cos(180° − x) = −cos(x)

1.  cos(180° − x) = −cos(x)
    mun:trigonometry-cos-supplement

theorem sin-supplement
  let x ∈ ℝ                                                           (H1)
  then sin(180° − x) = sin(x)

1.  sin(180° − x) = sin(x)
    mun:trigonometry-sin-supplement

theorem arctan-values
  then arctan(0) = 0. arctan(1) = π/4.

1.  arctan(0) = 0. arctan(1) = π/4.
    mun:trigonometry-arctan-values

theorem arctan-real
  let y ∈ ℝ                                                           (H1)
  then arctan(y) ∈ ℝ

1.  arctan(y) ∈ ℝ
    mun:trigonometry-arctan-real x := y

theorem continuous-arctan
  let E ⊆ ℝ                                                           (H1)
  let h : E → ℝ                                                       (H2)
  assume for all y ∈ E, h(y) = arctan(y)                              (H3)
  then h is continuous on E

1.  h is continuous on E
    thm:trigonometry-continuous-arctan D := E, g := h, from H1, H3

theorem derivative-arctan
  let E ⊆ ℝ                                                           (H1)
  let V ⊆ E                                                           (H2)
  assume V is open                                                    (H3)
  let h : E → ℝ                                                       (H4)
  assume for all y ∈ E, h(y) = arctan(y)                              (H5)
  then h is differentiable on V. For all y ∈ V, h′(y) = 1/(1 + y²).

1.  h is differentiable on V. For all y ∈ V, h′(y) = 1/(1 + y²).
    thm:trigonometry-derivative-arctan D := E, U := V, g := h, from H1, H2, H3, H5
