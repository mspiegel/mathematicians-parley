theorem quotient-positive
  let x ∈ ℝ                                                           (H1)
  let y ∈ ℝ                                                           (H2)
  assume x > 0                                                        (H3)
  assume y > 0                                                        (H4)
  then x/y > 0

1.  x/y > 0
    mun:numbers-quotient-positive, from H3, H4

