  let a ∈ ℝ                                                           (H1)
  assume a ≠ 0                                                        (H2)
  let m ∈ ℤ                                                           (H3)
  let n ∈ ℤ                                                           (H4)
  then a^(m + n) = a^m·a^n

1.  a^(m + n) = a^m·a^n
    mun:numbers-exponent-sum-integer, from H2

