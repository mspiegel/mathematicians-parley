    mun:numbers-exponent-negative, from H2

theorem power-cancel
  let a ∈ ℝ                                                           (H1)
  let m ∈ ℤ                                                           (H2)
  let n ∈ ℤ                                                           (H3)
  assume a > 1                                                        (H4)
  then a^m = a^n ↔ m = n

1.  a^m = a^n ↔ m = n
    mun:numbers-power-cancel, from H4

theorem power-order
  let a ∈ ℝ                                                           (H1)
  let m ∈ ℤ                                                           (H2)
  let n ∈ ℤ                                                           (H3)
  assume a > 1                                                        (H4)
  then m < n ↔ a^m < a^n

1.  m < n ↔ a^m < a^n
    mun:numbers-power-order, from H4

