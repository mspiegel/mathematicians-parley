theorem rational
  let x ∈ ℝ                                                           (H1)
  assume x ∈ ℚ                                                        (H2)
  then there are p ∈ ℤ and q ∈ ℕ with x = p/q

1.  There are p ∈ ℤ and q ∈ ℕ with x = p/q.
    def:stdlib/numbers/rational, from H2

theorem half-positive
  let x ∈ ℝ                                                           (H1)
  assume x > 0                                                        (H2)
  then x/2 > 0

1.  x/2 > 0
    thm:stdlib/numbers/half-positive, from H1, H2

theorem nat-int
  let m ∈ ℕ                                                           (H1)
  then m ∈ ℤ

1.  m ∈ ℤ
    thm:stdlib/numbers/nat-int, from H1

theorem int-real
  let m ∈ ℤ                                                           (H1)
  then m ∈ ℝ

1.  m ∈ ℝ
    thm:stdlib/numbers/int-real, from H1

theorem nat-real
  let m ∈ ℕ                                                           (H1)
  then m ∈ ℝ

1.  m ∈ ℝ
    thm:stdlib/numbers/nat-real, from H1

theorem nat0-real
  let m ∈ ℕ₀                                                          (H1)
  then m ∈ ℝ

1.  m ∈ ℝ
    thm:stdlib/numbers/nat0-real, from H1

theorem below-successor
  let a ∈ ℝ                                                           (H1)
  then a < a + 1

1.  a < a + 1
    thm:stdlib/numbers/below-successor, from H1

theorem nat0-int
  let m ∈ ℕ₀                                                          (H1)
  then m ∈ ℤ

1.  m ∈ ℤ
    thm:stdlib/numbers/nat0-int, from H1

theorem nat-ge-1
  let m ∈ ℕ                                                           (H1)
  then m ≥ 1

1.  m ≥ 1
    thm:stdlib/numbers/nat-ge-1, from H1

theorem max-real
  let x ∈ ℝ                                                           (H1)
  let y ∈ ℝ                                                           (H2)
  then max(x, y) ∈ ℝ

1.  max(x, y) ∈ ℝ
    thm:stdlib/numbers/max-real, from H1, H2

theorem le-max-left
  let x ∈ ℝ                                                           (H1)
  let y ∈ ℝ                                                           (H2)
  then x ≤ max(x, y)

1.  x ≤ max(x, y)
    thm:stdlib/numbers/le-max, from H1, H2

theorem le-max-right
  let x ∈ ℝ                                                           (H1)
  let y ∈ ℝ                                                           (H2)
  then y ≤ max(x, y)

1.  y ≤ max(x, y)
    thm:stdlib/numbers/le-max, from H1, H2

theorem max-le
  let x ∈ ℝ                                                           (H1)
  let y ∈ ℝ                                                           (H2)
  let z ∈ ℝ                                                           (H3)
  then max(x, y) ≤ z ↔ x ≤ z and y ≤ z

1.  max(x, y) ≤ z ↔ x ≤ z and y ≤ z
    thm:stdlib/numbers/max-le, from H1, H2, H3

theorem quotient-real
  let x ∈ ℝ                                                           (H1)
  let y ∈ ℝ                                                           (H2)
  assume y ≠ 0                                                        (H3)
  then x/y ∈ ℝ

1.  x/y ∈ ℝ
    thm:stdlib/numbers/quotient-real, from H1, H2, H3

theorem abs-product
  let x ∈ ℝ                                                           (H1)
  let y ∈ ℝ                                                           (H2)
  then |x·y| = |x|·|y|

1.  |x·y| = |x|·|y|
    thm:stdlib/numbers/abs-product, from H1, H2

theorem abs-quotient
  let x ∈ ℝ                                                           (H1)
  let y ∈ ℝ                                                           (H2)
  assume y ≠ 0                                                        (H3)
  then |x/y| = |x|/|y|

1.  |x/y| = |x|/|y|
    thm:stdlib/numbers/abs-quotient, from H1, H2, H3

theorem abs-negative
  let x ∈ ℝ                                                           (H1)
  then |−x| = |x|

1.  |−x| = |x|
    thm:stdlib/numbers/abs-negative, from H1

theorem abs-zero
  then |0| = 0

1.  |0| = 0
    thm:stdlib/numbers/abs-zero

theorem abs-one
  then |1| = 1

1.  |1| = 1
    thm:stdlib/numbers/abs-one

theorem abs-square
  let x ∈ ℝ                                                           (H1)
  then |x|² = x²

1.  |x|² = x²
    thm:stdlib/numbers/abs-square, from H1

theorem abs-power
  let x ∈ ℝ                                                           (H1)
  let n ∈ ℕ₀                                                          (H2)
  then |x^n| = |x|^n

1.  |x^n| = |x|^n
    thm:stdlib/numbers/abs-power, from H1, H2

theorem nat0-member
  let n ∈ ℝ                                                           (H1)
  then n ∈ ℕ₀ ↔ n ∈ ℕ or n = 0

1.  n ∈ ℕ₀ ↔ n ∈ ℕ or n = 0
    thm:stdlib/numbers/nat0-member

theorem nat0-as-int
  let n ∈ ℝ                                                           (H1)
  then n ∈ ℕ₀ ↔ n ∈ ℤ and 0 ≤ n

1.  n ∈ ℕ₀ ↔ n ∈ ℤ and 0 ≤ n
    thm:stdlib/numbers/nat0-as-int
