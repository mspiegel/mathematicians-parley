  let m ∈ ℕ                                                           (H1)
  then m ≥ 1

1.  m ≥ 1
    mun:numbers-nat-ge-1

theorem max-real
  let x ∈ ℝ                                                           (H1)
  let y ∈ ℝ                                                           (H2)
  then max(x, y) ∈ ℝ

1.  max(x, y) ∈ ℝ
    mun:numbers-max-real

theorem le-max-left
  let x ∈ ℝ                                                           (H1)
  let y ∈ ℝ                                                           (H2)
  then x ≤ max(x, y)

1.  x ≤ max(x, y)
    mun:le-max

theorem le-max-right
  let x ∈ ℝ                                                           (H1)
  let y ∈ ℝ                                                           (H2)
  then y ≤ max(x, y)

1.  y ≤ max(x, y)
    mun:le-max

theorem max-le
  let x ∈ ℝ                                                           (H1)
  let y ∈ ℝ                                                           (H2)
  let z ∈ ℝ                                                           (H3)
  then max(x, y) ≤ z ↔ x ≤ z and y ≤ z

1.  max(x, y) ≤ z ↔ x ≤ z and y ≤ z
    mun:numbers-max-le

theorem quotient-real
  let x ∈ ℝ                                                           (H1)
  let y ∈ ℝ                                                           (H2)
  assume y ≠ 0                                                        (H3)
  then x/y ∈ ℝ

1.  x/y ∈ ℝ
    mun:numbers-quotient-real, from H3

theorem abs-product
  let x ∈ ℝ                                                           (H1)
  let y ∈ ℝ                                                           (H2)
  then |x·y| = |x|·|y|

1.  |x·y| = |x|·|y|
    mun:numbers-abs-product

theorem abs-quotient
  let x ∈ ℝ                                                           (H1)
  let y ∈ ℝ                                                           (H2)
  assume y ≠ 0                                                        (H3)
  then |x/y| = |x|/|y|

1.  |x/y| = |x|/|y|
    mun:numbers-abs-quotient, from H3

theorem abs-negative
  let x ∈ ℝ                                                           (H1)
  then |−x| = |x|

1.  |−x| = |x|
    mun:numbers-abs-negative

theorem abs-zero
  then |0| = 0

1.  |0| = 0
    mun:numbers-abs-zero

theorem abs-one
  then |1| = 1

1.  |1| = 1
    mun:numbers-abs-one

theorem abs-square
  let x ∈ ℝ                                                           (H1)
  then |x|² = x²

1.  |x|² = x²
    mun:numbers-abs-square

theorem abs-power
  let x ∈ ℝ                                                           (H1)
  let n ∈ ℕ₀                                                          (H2)
  then |x^n| = |x|^n

1.  |x^n| = |x|^n
    mun:numbers-abs-power

theorem nat0
  let n ∈ ℝ                                                           (H1)
  assume n ∈ ℕ₀                                                       (H2)
  then n ∈ ℕ or n = 0

1.  n ∈ ℕ or n = 0
    mun:numbers-nat0, from H2

theorem nat0-as-int
  let n ∈ ℝ                                                           (H1)
  then n ∈ ℕ₀ ↔ n ∈ ℤ and 0 ≤ n

1.  n ∈ ℕ₀ ↔ n ∈ ℤ and 0 ≤ n
    mun:numbers-nat0-as-int

theorem nat0-nonzero
  let m ∈ ℕ₀                                                          (H1)
  assume m ≠ 0                                                        (H2)
  then m ∈ ℕ

1.  m ∈ ℕ
    mun:numbers-nat0-nonzero, from H2

theorem abs-positive
  let x ∈ ℝ                                                           (H1)
  assume x ≠ 0                                                        (H2)
  then |x| > 0

1.  |x| > 0
    mun:numbers-abs-positive, from H2

theorem exponent-sum
  let a ∈ ℝ                                                           (H1)
  let m ∈ ℕ₀                                                          (H2)
  let n ∈ ℕ₀                                                          (H3)
  then a^(m + n) = a^m·a^n

1.  a^(m + n) = a^m·a^n
    mun:numbers-exponent-sum

theorem product-nonzero
  let x ∈ ℝ                                                           (H1)
  let y ∈ ℝ                                                           (H2)
  assume x ≠ 0                                                        (H3)
  assume y ≠ 0                                                        (H4)
  then x·y ≠ 0

1.  x·y ≠ 0
    mun:numbers-product-nonzero, from H3, H4

theorem integer-step
  let m ∈ ℤ                                                           (H1)
  let n ∈ ℤ                                                           (H2)
  assume m < n                                                        (H3)
  then m + 1 ≤ n

1.  m + 1 ≤ n
    mun:numbers-integer-step, from H3
