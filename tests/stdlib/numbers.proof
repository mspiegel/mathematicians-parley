theorem exponent-sum
  let a ∈ ℝ                                                           (H1)
  let m ∈ ℕ₀                                                          (H2)
  let n ∈ ℕ₀                                                          (H3)
  then a^(m + n) = a^m·a^n

1.  a^(m + n) = a^m·a^n
    mun:numbers-exponent-sum

