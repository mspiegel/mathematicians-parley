theorem quotient-positive
  let x ∈ ℝ                                                           (H1)
  let y ∈ ℝ                                                           (H2)
  assume x > 0                                                        (H3)
  assume y > 0                                                        (H4)
  then x/y > 0

1.  x/y > 0
    mun:numbers-quotient-positive, from H3, H4

theorem less-scaled
  let x ∈ ℝ                                                           (H1)
  let y ∈ ℝ                                                           (H2)
  let c ∈ ℝ                                                           (H3)
  assume c > 0                                                        (H4)
  then x < y ↔ c·x < c·y

1.  x < y ↔ c·x < c·y
    mun:numbers-less-scaled, from H4

theorem abs-nonneg
  let x ∈ ℝ                                                           (H1)
  then |x| ≥ 0

1.  |x| ≥ 0
    mun:numbers-abs-nonneg

theorem one-power
  let m ∈ ℤ                                                           (H1)
  then 1^m = 1

1.  1^m = 1
    mun:numbers-one-power

theorem square-le
  let x ∈ ℝ                                                           (H1)
  let y ∈ ℝ                                                           (H2)
  assume x ≥ 0                                                        (H3)
  assume y ≥ 0                                                        (H4)
  then x ≤ y ↔ x² ≤ y²

1.  x ≤ y ↔ x² ≤ y²
    mun:numbers-square-le, from H3, H4

theorem product-nonneg
  let x ∈ ℝ                                                           (H1)
  let y ∈ ℝ                                                           (H2)
  assume x ≥ 0                                                        (H3)
  assume y ≥ 0                                                        (H4)
  then x·y ≥ 0

1.  x·y ≥ 0
    mun:numbers-product-nonneg, from H3, H4

theorem quotient-nonneg
  let x ∈ ℝ                                                           (H1)
  let y ∈ ℝ                                                           (H2)
  assume x ≥ 0                                                        (H3)
  assume y > 0                                                        (H4)
  then x/y ≥ 0

1.  x/y ≥ 0
    mun:numbers-quotient-nonneg, from H3, H4

theorem le-cases
  let x ∈ ℝ                                                           (H1)
  let y ∈ ℝ                                                           (H2)
  then x ≤ y ↔ x < y or x = y

1.  x ≤ y ↔ x < y or x = y
    mun:numbers-le-cases

theorem rational
  let x ∈ ℝ                                                           (H1)
  assume x ∈ ℚ                                                        (H2)
  then there are p ∈ ℤ and q ∈ ℕ with x = p/q

1.  There are p ∈ ℤ and q ∈ ℕ with x = p/q.
    mun:numbers-rational, from H2

theorem half-positive
  let x ∈ ℝ                                                           (H1)
  assume x > 0                                                        (H2)
  then x/2 > 0

1.  x/2 > 0
    mun:numbers-half-positive, from H2

theorem exponent-one
  let a ∈ ℝ                                                           (H1)
  then a^1 = a

1.  a^1 = a
    mun:numbers-exponent-one

theorem nat-int
  let m ∈ ℕ                                                           (H1)
  then m ∈ ℤ

1.  m ∈ ℤ
    mun:numbers-nat-int

