theorem factorial-base
  then 1! = 1

1.  1! = 1
    def:stdlib/counting/factorial

theorem factorial-step
  let n ∈ ℕ                                                           (H1)
  then (n + 1)! = n!·(n + 1)

1.  (n + 1)! = n!·(n + 1)
    def:stdlib/counting/factorial, from H1

theorem binomial-coefficient
  let n ∈ ℕ₀                                                          (H1)
  let k ∈ {0, …, n}                                                   (H2)
  then C(n, k) = n!/((n − k)!·k!)

1.  C(n, k) = n!/((n − k)!·k!)
    def:stdlib/counting/binomial-coefficient, from H1, H2

theorem card-empty
  then |∅| = 0

1.  |∅| = 0
    thm:stdlib/counting/card-empty

theorem factorial-zero
  then 0! = 1

1.  0! = 1
    thm:stdlib/counting/factorial-zero
