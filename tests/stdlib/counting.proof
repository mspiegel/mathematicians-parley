import mundane theorem    stdlib/counting/card-empty as counting-card-empty
import mundane definition stdlib/counting/factorial
import mundane theorem    stdlib/counting/factorial-zero as counting-factorial-zero
import definition         stdlib/counting/C
import mundane theorem    stdlib/counting/range-size
import theorem            stdlib/counting/count-functions
import theorem            stdlib/counting/count-one-to-one

theorem factorial-base
  then 1! = 1

1.  1! = 1
    mun:factorial

theorem factorial-step
  let n ∈ ℕ                                                           (H1)
  then (n + 1)! = n!·(n + 1)

1.  (n + 1)! = n!·(n + 1)
    mun:factorial

theorem binomial-coefficient
  let n ∈ ℕ₀                                                          (H1)
  let k ∈ ℤ                                                           (H2)
  assume k ∈ {0, …, n}                                                (H3)
  then C(n, k) = n!/((n − k)!·k!)

1.  C(n, k) = n!/((n − k)!·k!)
    def:C, from H3

theorem card-empty
  then |∅| = 0

1.  |∅| = 0
    mun:counting-card-empty

theorem factorial-zero
  then 0! = 1

1.  0! = 1
    mun:counting-factorial-zero

theorem size-of-a-range
  then |{1, …, 12}| = 12

1.  |{1, …, 12}| = 12
    mun:range-size n := 12

theorem functions-counted
  let A be a set                                                      (H1)
  let B be a set                                                      (H2)
  assume A is finite                                                  (H3)
  assume B is finite                                                  (H4)
  then |the functions from A to B| = |B|^|A|

1.  |the functions from A to B| = |B|^|A|
    thm:count-functions X := A, Y := B, from H3, H4

theorem one-to-one-counted
  note        The count of one-to-one functions cited where the page names
              its sets, its functions and the product's letter otherwise.
  let A be a set                                                      (H1)
  let B be a set                                                      (H2)
  assume A is finite                                                  (H3)
  assume B is finite                                                  (H4)
  assume |A| ≤ |B|                                                    (H5)
  then |{g ∈ the functions from A to B : g : A → B is one-to-one}| = ∏(j ∈ {0, …, |A| − 1}) (|B| − j)

1.  |{g ∈ the functions from A to B : g : A → B is one-to-one}| = ∏(j ∈ {0, …, |A| − 1}) (|B| − j)
    thm:count-one-to-one X := A, Y := B, from H3, H4, H5
