import mundane theorem    stdlib/sets/difference-empty as sets-difference-empty
import mundane theorem    stdlib/sets/difference-self as sets-difference-self
import mundane theorem    stdlib/sets/difference-set as sets-difference-set
import mundane definition stdlib/sets/intersection as sets-intersection
import mundane theorem    stdlib/sets/intersection-commutes as sets-intersection-commutes
import mundane theorem    stdlib/sets/intersection-distributes as sets-intersection-distributes
import mundane theorem    stdlib/sets/intersection-empty as sets-intersection-empty
import mundane theorem    stdlib/sets/intersection-self as sets-intersection-self
import mundane theorem    stdlib/sets/remove-member as sets-remove-member
import mundane theorem    stdlib/sets/subset-empty as sets-subset-empty
import mundane definition stdlib/sets/union as sets-union
import mundane theorem    stdlib/sets/union-commutes as sets-union-commutes
import mundane theorem    stdlib/sets/union-empty as sets-union-empty
import mundane theorem    stdlib/sets/union-self as sets-union-self
import mundane theorem    stdlib/sets/union-difference as sets-union-difference
import mundane theorem    stdlib/sets/nonempty-member as sets-nonempty-member
import mundane theorem    stdlib/sets/pair-parts-equal as sets-pair-parts-equal
import mundane theorem    stdlib/sets/pair-in-product as sets-pair-in-product
import axiom              stdlib/sets/extensionality as sets-extensionality
import axiom              stdlib/sets/empty-set as sets-empty-set
import axiom              stdlib/sets/pairing as sets-pairing
import axiom              stdlib/sets/unions as sets-unions
import axiom              stdlib/sets/power-sets as sets-power-sets
import axiom              stdlib/sets/separation as sets-separation
import axiom              stdlib/sets/replacement as sets-replacement
import axiom              stdlib/sets/infinity as sets-infinity

theorem extensionality
  let A be a set                                                      (H1)
  let B be a set                                                      (H2)
  assume for all x ∈ A, x ∈ B                                         (H3)
  assume for all x ∈ B, x ∈ A                                         (H4)
  then A = B

1.  A = B
    axi:sets-extensionality X := A, Y := B, from H3, H4

theorem empty-set
  then ∅ is a set

1.  ∅ is a set
    axi:sets-empty-set

theorem pairing
  let x be an element                                                 (H1)
  let y be an element                                                 (H2)
  then {x, y} is a set

1.  {x, y} is a set
    axi:sets-pairing a := x, b := y

theorem unions
  let F be a set                                                      (H1)
  then ⋃(A ∈ F) A is a set

1.  ⋃(A ∈ F) A is a set
    axi:sets-unions C := F

theorem power-sets
  let A be a set                                                      (H1)
  then 𝒫A is a set

1.  𝒫A is a set
    axi:sets-power-sets X := A

theorem separation
  let A be a set                                                      (H1)
  let B be a set                                                      (H2)
  then {x ∈ A : x ∉ B} is a set

1.  {x ∈ A : x ∉ B} is a set
    axi:sets-separation

theorem replacement
  let A be a set                                                      (H1)
  let B be a set                                                      (H2)
  let g : A → B                                                       (H3)
  then {g(x) : x ∈ A} is a set

1.  {g(x) : x ∈ A} is a set
    axi:sets-replacement Y := A, Z := B, E := g

theorem infinity
  then ℕ is a set

1.  ℕ is a set
    axi:sets-infinity

theorem union-difference
  let Y be a set                                                      (H1)
  let Z be a set                                                      (H2)
  then Y ∪ (Z ∖ Y) = Y ∪ Z

1.  Y ∪ (Z ∖ Y) = Y ∪ Z
    mun:sets-union-difference

theorem nonempty-member
  let Y be a set                                                      (H1)
  assume Y ≠ ∅                                                        (H2)
  then there is a ∈ Y

1.  There is a ∈ Y.
    mun:sets-nonempty-member, from H2

theorem difference-set
  let X be a set                                                      (H1)
  let a be an element                                                 (H2)
  then X ∖ {a} is a set

1.  X ∖ {a} is a set
    mun:sets-difference-set

theorem intersection
  let Y be a set                                                      (H1)
  let Z be a set                                                      (H2)
  let u be an element                                                 (H3)
  assume u ∈ Y ∩ Z                                                    (H4)
  then u ∈ Y and u ∈ Z

1.  u ∈ Y and u ∈ Z
    mun:sets-intersection, from H4

theorem union
  let Y be a set                                                      (H1)
  let Z be a set                                                      (H2)
  let u be an element                                                 (H3)
  assume u ∈ Y ∪ Z                                                    (H4)
  then u ∈ Y or u ∈ Z

1.  u ∈ Y or u ∈ Z
    mun:sets-union, from H4

theorem remove-member
  let Y be a set                                                      (H1)
  let a be an element                                                 (H2)
  let u be an element                                                 (H3)
  then u ∈ Y ∖ {a} ↔ u ∈ Y and u ≠ a

1.  u ∈ Y ∖ {a} ↔ u ∈ Y and u ≠ a
    mun:sets-remove-member

theorem intersection-commutes
  let Y be a set                                                      (H1)
  let Z be a set                                                      (H2)
  then Y ∩ Z = Z ∩ Y

1.  Y ∩ Z = Z ∩ Y
    mun:sets-intersection-commutes

theorem union-commutes
  let Y be a set                                                      (H1)
  let Z be a set                                                      (H2)
  then Y ∪ Z = Z ∪ Y

1.  Y ∪ Z = Z ∪ Y
    mun:sets-union-commutes

theorem intersection-self
  let Y be a set                                                      (H1)
  then Y ∩ Y = Y

1.  Y ∩ Y = Y
    mun:sets-intersection-self

theorem union-self
  let Y be a set                                                      (H1)
  then Y ∪ Y = Y

1.  Y ∪ Y = Y
    mun:sets-union-self

theorem union-empty
  let Y be a set                                                      (H1)
  then Y ∪ ∅ = Y

1.  Y ∪ ∅ = Y
    mun:sets-union-empty

theorem intersection-empty
  let Y be a set                                                      (H1)
  then Y ∩ ∅ = ∅

1.  Y ∩ ∅ = ∅
    mun:sets-intersection-empty

theorem difference-self
  let Y be a set                                                      (H1)
  then Y ∖ Y = ∅

1.  Y ∖ Y = ∅
    mun:sets-difference-self

theorem difference-empty
  let Y be a set                                                      (H1)
  then Y ∖ ∅ = Y

1.  Y ∖ ∅ = Y
    mun:sets-difference-empty

theorem intersection-distributes
  let X be a set                                                      (H1)
  let Y be a set                                                      (H2)
  let Z be a set                                                      (H3)
  then X ∩ (Y ∪ Z) = (X ∩ Y) ∪ (X ∩ Z)

1.  X ∩ (Y ∪ Z) = (X ∩ Y) ∪ (X ∩ Z)
    mun:sets-intersection-distributes

theorem subset-empty
  let Y be a set                                                      (H1)
  then Y ⊆ ∅ ↔ Y = ∅

1.  Y ⊆ ∅ ↔ Y = ∅
    mun:sets-subset-empty

theorem pair-parts-equal
  let a ∈ ℝ                                                           (H1)
  let b ∈ ℝ                                                           (H2)
  let c ∈ ℝ                                                           (H3)
  let d ∈ ℝ                                                           (H4)
  assume (a, b) = (c, d)                                              (H5)
  then a = c and b = d

1.  a = c and b = d
    mun:sets-pair-parts-equal, from H5

theorem pair-in-product
  let a ∈ ℝ                                                           (H1)
  let b ∈ ℝ                                                           (H2)
  then (a, b) ∈ ℝ × ℝ

1.  (a, b) ∈ ℝ × ℝ
    mun:sets-pair-in-product
