import mundane    stdlib/sets/difference-empty as sets-difference-empty
import mundane    stdlib/sets/difference-self as sets-difference-self
import mundane    stdlib/sets/difference-set as sets-difference-set
import mundane    stdlib/sets/intersection-commutes as sets-intersection-commutes
import mundane    stdlib/sets/intersection-distributes as sets-intersection-distributes
import mundane    stdlib/sets/intersection-empty as sets-intersection-empty
import mundane    stdlib/sets/intersection-member as sets-intersection-member
import mundane    stdlib/sets/intersection-self as sets-intersection-self
import mundane    stdlib/sets/remove-member as sets-remove-member
import mundane    stdlib/sets/subset-empty as sets-subset-empty
import mundane    stdlib/sets/union-commutes as sets-union-commutes
import mundane    stdlib/sets/union-empty as sets-union-empty
import mundane    stdlib/sets/union-member as sets-union-member
import mundane    stdlib/sets/union-self as sets-union-self

theorem difference-set
  let X be a set                                                      (H1)
  let a be an element                                                 (H2)
  then X ∖ {a} is a set

1.  X ∖ {a} is a set
    mun:sets-difference-set

theorem intersection-member
  let Y be a set                                                      (H1)
  let Z be a set                                                      (H2)
  let u be an element                                                 (H3)
  then u ∈ Y ∩ Z ↔ u ∈ Y and u ∈ Z

1.  u ∈ Y ∩ Z ↔ u ∈ Y and u ∈ Z
    mun:sets-intersection-member

theorem union-member
  let Y be a set                                                      (H1)
  let Z be a set                                                      (H2)
  let u be an element                                                 (H3)
  then u ∈ Y ∪ Z ↔ u ∈ Y or u ∈ Z

1.  u ∈ Y ∪ Z ↔ u ∈ Y or u ∈ Z
    mun:sets-union-member

theorem remove-member
  let Y be a set                                                      (H1)
  let a be an element                                                 (H2)
  let u be an element                                                 (H3)
  then u ∈ Y ∖ {a} ↔ u ∈ Y and u ≠ a

1.  u ∈ Y ∖ {a} ↔ u ∈ Y and u ≠ a
    mun:sets-remove-member

theorem intersection-commutes
  let Y be a set                                                      (H1)
  let Z be a set                                                      (H2)
  then Y ∩ Z = Z ∩ Y

1.  Y ∩ Z = Z ∩ Y
    mun:sets-intersection-commutes

theorem union-commutes
  let Y be a set                                                      (H1)
  let Z be a set                                                      (H2)
  then Y ∪ Z = Z ∪ Y

1.  Y ∪ Z = Z ∪ Y
    mun:sets-union-commutes

theorem intersection-self
  let Y be a set                                                      (H1)
  then Y ∩ Y = Y

1.  Y ∩ Y = Y
    mun:sets-intersection-self

theorem union-self
  let Y be a set                                                      (H1)
  then Y ∪ Y = Y

1.  Y ∪ Y = Y
    mun:sets-union-self

theorem union-empty
  let Y be a set                                                      (H1)
  then Y ∪ ∅ = Y

1.  Y ∪ ∅ = Y
    mun:sets-union-empty

theorem intersection-empty
  let Y be a set                                                      (H1)
  then Y ∩ ∅ = ∅

1.  Y ∩ ∅ = ∅
    mun:sets-intersection-empty

theorem difference-self
  let Y be a set                                                      (H1)
  then Y ∖ Y = ∅

1.  Y ∖ Y = ∅
    mun:sets-difference-self

theorem difference-empty
  let Y be a set                                                      (H1)
  then Y ∖ ∅ = Y

1.  Y ∖ ∅ = Y
    mun:sets-difference-empty

theorem intersection-distributes
  let X be a set                                                      (H1)
  let Y be a set                                                      (H2)
  let Z be a set                                                      (H3)
  then X ∩ (Y ∪ Z) = (X ∩ Y) ∪ (X ∩ Z)

1.  X ∩ (Y ∪ Z) = (X ∩ Y) ∪ (X ∩ Z)
    mun:sets-intersection-distributes

theorem subset-empty
  let Y be a set                                                      (H1)
  then Y ⊆ ∅ ↔ Y = ∅

1.  Y ⊆ ∅ ↔ Y = ∅
    mun:sets-subset-empty
