theorem point
  let A ∈ 𝔼²                                                          (H1)
  then A is a point

1.  A is a point
    def:geometry-point

theorem angle-real
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  assume P ≠ Q                                                        (H4)
  assume R ≠ Q                                                        (H5)
  then ∠PQR ∈ ℝ. ∠PQR ≥ 0.

1.  ∠PQR ∈ ℝ. ∠PQR ≥ 0.
    mun:geometry-angle-real, from H4, H5

theorem isosceles
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  assume P, Q, R form a triangle                                      (H4)
  assume |PQ| = |PR|                                                  (H5)
  then △PQR is isosceles

1.  |PQ| = |PR| or |QP| = |QR|
    mun:or-left, from H5

2.  |PQ| = |PR| or |QP| = |QR| or |RP| = |RQ|
    mun:or-left, from 1

3.  △PQR is isosceles
    def:geometry-isosceles, from H4, 2

theorem equilateral
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  assume P, Q, R form a triangle                                      (H4)
  assume |PQ| = |QR|                                                  (H5)
  assume |QR| = |RP|                                                  (H6)
  then △PQR is equilateral

1.  △PQR is equilateral
    def:geometry-equilateral, from H4, H5, H6

theorem right-angled
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  assume △PQR is right-angled at R                                    (H4)
  then P, Q, R form a triangle

1.  P, Q, R form a triangle
    def:geometry-right-angled, from H4

theorem right-angled-at-vertex
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  assume P, Q, R form a triangle                                      (H4)
  assume ∠PRQ = 90°                                                   (H5)
  then △PQR is right-angled at R

1.  △PQR is right-angled at R
    mun:geometry-right-angled-at-vertex, from H4, H5

theorem congruent-by-symbol
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  let P′ be a point                                                   (H4)
  let Q′ be a point                                                   (H5)
  let R′ be a point                                                   (H6)
  assume △PQR ≅ △P′Q′R′                                               (H7)
  then |PQ| = |P′Q′|

1.  |PQ| = |P′Q′|
    def:geometry-congruent, from H7

theorem law-of-cosines
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  assume P ≠ Q                                                        (H4)
  assume R ≠ Q                                                        (H5)
  then |RP|² = |PQ|² + |QR|² − 2·(|PQ|·|QR|·cos(∠PQR))

1.  |RP|² = |PQ|² + |QR|² − 2·(|PQ|·|QR|·cos(∠PQR))
    thm:geometry-law-of-cosines, from H4, H5

theorem angle-equal-by-cosine
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  let P′ be a point                                                   (H4)
  let Q′ be a point                                                   (H5)
  let R′ be a point                                                   (H6)
  assume P ≠ Q                                                        (H7)
  assume R ≠ Q                                                        (H8)
  assume P′ ≠ Q′                                                      (H9)
  assume R′ ≠ Q′                                                      (H10)
  assume cos(∠PQR) = cos(∠P′Q′R′)                                     (H11)
  then ∠PQR = ∠P′Q′R′

1.  ∠PQR = ∠P′Q′R′
    mun:geometry-angle-equal-by-cosine, from H7, H8, H9, H10, H11

theorem angle-order-by-cosine
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  let P′ be a point                                                   (H4)
  let Q′ be a point                                                   (H5)
  let R′ be a point                                                   (H6)
  assume P ≠ Q                                                        (H7)
  assume R ≠ Q                                                        (H8)
  assume P′ ≠ Q′                                                      (H9)
  assume R′ ≠ Q′                                                      (H10)
  then ∠PQR < ∠P′Q′R′ ↔ cos(∠P′Q′R′) < cos(∠PQR)

1.  ∠PQR < ∠P′Q′R′ ↔ cos(∠P′Q′R′) < cos(∠PQR)
    mun:geometry-angle-order-by-cosine, from H7, H8, H9, H10

theorem right-angle-by-cosine
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  assume P ≠ Q                                                        (H4)
  assume R ≠ Q                                                        (H5)
  then ∠PQR = 90° ↔ cos(∠PQR) = 0

1.  ∠PQR = 90° ↔ cos(∠PQR) = 0
    mun:geometry-right-angle-by-cosine, from H4, H5

theorem midpoint-halves
  note        The midpoint is half way along: its definition gives the
              betweenness and the equal halves, and segment addition the
              whole.
  let M be a point                                                    (H1)
  let A be a point                                                    (H2)
  let B be a point                                                    (H3)
  assume M is the midpoint of AB                                      (H4)
  then |AM| = |AB|/2

1.  M is between A and B. |AM| = |MB|.
    def:geometry-midpoint, from H4

2.  |AM| + |MB| = |AB|
    mun:geometry-segment-addition, from 1

3.  |AM| = |AB|/2
    algebra, from 1, 2

theorem on-line
  let P be a point                                                    (H1)
  let A be a point                                                    (H2)
  let B be a point                                                    (H3)
  assume P is on line AB                                              (H4)
  then A, B, P are collinear

1.  A, B, P are collinear
    def:geometry-on-line, from H4

theorem perpendicular-by-right-angle
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  assume P ≠ Q                                                        (H4)
  assume R ≠ Q                                                        (H5)
  assume ∠PQR = 90°                                                   (H6)
  then line QP ⊥ line QR

1.  line QP ⊥ line QR
    mun:geometry-perpendicular-by-right-angle, from H4, H5, H6

theorem intersecting-chords
  note        The circle is named once, as the points at distance r from O,
              and its four points are on it by that.
  let O be a point                                                    (H1)
  let r ∈ ℝ                                                           (H2)
  let ω = {X ∈ 𝔼² : |XO| = r}                                         (D1)
      reads the circle with centre O and radius r
  let A be a point                                                    (H3)
  let B be a point                                                    (H4)
  let C be a point                                                    (H5)
  let D be a point                                                    (H6)
  let P be a point                                                    (H7)
  assume A ∈ ω                                                        (H8)
  assume B ∈ ω                                                        (H9)
  assume C ∈ ω                                                        (H10)
  assume D ∈ ω                                                        (H11)
  assume P is between A and B                                         (H12)
  assume P is between C and D                                         (H13)
  then |PA|·|PB| = |PC|·|PD|

1.  |AO| = r
    def:set-builder u := A, from D1, H8

2.  |BO| = r
    def:set-builder u := B, from D1, H9

3.  |CO| = r
    def:set-builder u := C, from D1, H10

4.  |DO| = r
    def:set-builder u := D, from D1, H11

5.  |AO| = |BO|
    transitivity, from 1, 2

6.  |AO| = |CO|
    transitivity, from 1, 3

7.  |AO| = |DO|
    transitivity, from 1, 4

8.  |PA|·|PB| = |PC|·|PD|
    thm:geometry-intersecting-chords, from H12, H13, 5, 6, 7

theorem chord-midpoint-right-angle
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let M be a point                                                    (H3)
  let O be a point                                                    (H4)
  assume M is the midpoint of AB                                      (H5)
  assume |AO| = |BO|                                                  (H6)
  assume O ≠ M                                                        (H7)
  then ∠OMB = 90°

1.  ∠OMB = 90°
    thm:geometry-chord-midpoint-right-angle, from H5, H6, H7

theorem signed-angle-size
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  then |∡PQR| = ∠PQR

1.  |∡PQR| = ∠PQR
    mun:geometry-signed-angle-size

theorem signed-angle-real
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  assume P ≠ Q                                                        (H4)
  assume R ≠ Q                                                        (H5)
  then ∡PQR ≤ π

1.  ∡PQR ≤ π
    mun:geometry-signed-angle-real, from H4, H5

theorem signed-angle-reverse
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  assume P ≠ Q                                                        (H4)
  assume R ≠ Q                                                        (H5)
  assume ∡PQR ≠ π                                                     (H6)
  then ∡RQP = −∡PQR

1.  ∡RQP = −∡PQR
    mun:geometry-signed-angle-reverse, from H4, H5, H6

theorem signed-angle-sum
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  assume P ≠ Q                                                        (H4)
  assume Q ≠ R                                                        (H5)
  assume P ≠ R                                                        (H6)
  then ∡RQP + ∡PRQ + ∡QPR ∈ {−π, π}

1.  ∡RQP + ∡PRQ + ∡QPR ∈ {−π, π}
    thm:geometry-signed-angle-sum, from H4, H5, H6

theorem area
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  then the area of △PQR = (1/2)·(|QR|·|PR|)·|sin(∡QRP)|

1.  the area of △PQR = (1/2)·(|QR|·|PR|)·|sin(∡QRP)|
    def:geometry-area

theorem area-by-sine
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  assume P ≠ R                                                        (H4)
  assume Q ≠ R                                                        (H5)
  then the area of △PQR = (1/2)·(|QR|·|PR|)·sin(∠QRP)

1.  the area of △PQR = (1/2)·(|QR|·|PR|)·sin(∠QRP)
    thm:geometry-area-by-sine, from H4, H5

theorem area-positive
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  assume P, Q, R form a triangle                                      (H4)
  then the area of △PQR > 0

1.  the area of △PQR > 0
    axi:geometry-area-positive, from H4

theorem heron
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  let s ∈ ℝ                                                           (H4)
  assume P ≠ R                                                        (H5)
  assume Q ≠ R                                                        (H6)
  assume s = (|QR| + |PR| + |PQ|)/2                                   (H7)
  then the area of △PQR = √(s·(s − |QR|)·((s − |PR|)·(s − |PQ|)))

1.  the area of △PQR = √(s·(s − |QR|)·((s − |PR|)·(s − |PQ|)))
    thm:geometry-heron, from H5, H6, H7

theorem distance-nonneg
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  then |PQ| ≥ 0

1.  |PQ| ≥ 0
    mun:geometry-distance-nonneg

theorem distance-symmetric
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  then |PQ| = |QP|

1.  |PQ| = |QP|
    mun:geometry-distance-symmetric

theorem distance-positive
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  assume P ≠ Q                                                        (H3)
  then |PQ| > 0

1.  |PQ| > 0
    axi:geometry-distance-positive, from H3

theorem distance-zero
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  then |PQ| = 0 ↔ P = Q

1.  |PQ| = 0 ↔ P = Q
    mun:geometry-distance-zero

theorem distance-by-coordinates
  let a ∈ ℝ                                                           (H1)
  let b ∈ ℝ                                                           (H2)
  let c ∈ ℝ                                                           (H3)
  let d ∈ ℝ                                                           (H4)
  then |(a, b)(c, d)| = √((a − c)² + (b − d)²)

1.  |(a, b)(c, d)| = √((a − c)² + (b − d)²)
    mun:geometry-distance-by-coordinates

theorem collinear-by-coordinates
  let a ∈ ℝ                                                           (H1)
  let b ∈ ℝ                                                           (H2)
  let c ∈ ℝ                                                           (H3)
  let d ∈ ℝ                                                           (H4)
  let e ∈ ℝ                                                           (H5)
  let f ∈ ℝ                                                           (H6)
  then (a, b), (c, d), (e, f) are collinear ↔ (c − a)·(f − b) = (e − a)·(d − b)

1.  (a, b), (c, d), (e, f) are collinear ↔ (c − a)·(f − b) = (e − a)·(d − b)
    mun:geometry-collinear-by-coordinates

theorem between-by-coordinates
  let a ∈ ℝ                                                           (H1)
  let b ∈ ℝ                                                           (H2)
  let c ∈ ℝ                                                           (H3)
  let d ∈ ℝ                                                           (H4)
  let e ∈ ℝ                                                           (H5)
  let f ∈ ℝ                                                           (H6)
  then (c, d) is between (a, b) and (e, f) ↔ (a − c)·(f − d) = (e − c)·(b − d) and (a − c)·(e − c) + (b − d)·(f − d) < 0

1.  (c, d) is between (a, b) and (e, f) ↔ (a − c)·(f − d) = (e − c)·(b − d) and (a − c)·(e − c) + (b − d)·(f − d) < 0
    mun:geometry-between-by-coordinates

theorem points-apart-by-coordinates
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let a ∈ ℝ                                                           (H3)
  let b ∈ ℝ                                                           (H4)
  let c ∈ ℝ                                                           (H5)
  let d ∈ ℝ                                                           (H6)
  assume A = (a, b)                                                   (H7)
  assume B = (c, d)                                                   (H8)
  then A ≠ B ↔ (a, b) ≠ (c, d)

1.  A ≠ B ↔ (a, b) ≠ (c, d)
    mun:geometry-points-apart-by-coordinates, from H7, H8

theorem distance-of-points-by-coordinates
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let a ∈ ℝ                                                           (H3)
  let b ∈ ℝ                                                           (H4)
  let c ∈ ℝ                                                           (H5)
  let d ∈ ℝ                                                           (H6)
  assume A = (a, b)                                                   (H7)
  assume B = (c, d)                                                   (H8)
  then |AB| = √((a − c)² + (b − d)²)

1.  |AB| = √((a − c)² + (b − d)²)
    mun:geometry-distance-of-points-by-coordinates, from H7, H8

theorem angle-at-most-straight
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  assume P ≠ Q                                                        (H4)
  assume R ≠ Q                                                        (H5)
  then ∠PQR ≤ 180°

1.  ∠PQR ≤ 180°
    mun:geometry-angle-at-most-straight, from H4, H5

theorem angle-by-cosine
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  let x ∈ ℝ                                                           (H4)
  assume P ≠ Q                                                        (H5)
  assume R ≠ Q                                                        (H6)
  assume 0 ≤ x                                                        (H7)
  assume x ≤ 180°                                                     (H8)
  then ∠PQR = x ↔ cos(∠PQR) = cos(x)

1.  ∠PQR = x ↔ cos(∠PQR) = cos(x)
