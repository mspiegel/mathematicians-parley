  let X be a point                                                    (H3)
  let Y be a point                                                    (H4)
  assume X is on line AB                                              (H5)
  assume not (Y is on line AB)                                        (H6)
  then X ≠ Y

1.  X ≠ Y
    mun:geometry-on-off-apart, from H5, H6

theorem off-line-through
  let R be a point                                                    (H1)
  let P be a point                                                    (H2)
  let S be a point                                                    (H3)
  let X be a point                                                    (H4)
  assume not (S is on line RP)                                        (H5)
  assume X is on line RS                                              (H6)
  assume X ≠ R                                                        (H7)
  then not (X is on line RP)

1.  not (X is on line RP)
    mun:geometry-off-line-through, from H5, H6, H7

theorem line-crossing-between
  let R be a point                                                    (H1)
  let P be a point                                                    (H2)
  let S be a point                                                    (H3)
  let X be a point                                                    (H4)
  assume X is on line RS                                              (H5)
  assume S and X are on opposite sides of line RP                     (H6)
  then R is between S and X

1.  R is between S and X
    mun:geometry-line-crossing-between, from H5, H6

theorem angle-same-ray
  let R be a point                                                    (H1)
  let P be a point                                                    (H2)
  let Q be a point                                                    (H3)
  let X be a point                                                    (H4)
  assume X is on line PQ                                              (H5)
  assume X and Q are on the same side of line PR                      (H6)
  then ∠RPX = ∠RPQ

1.  ∠RPX = ∠RPQ
    mun:geometry-angle-same-ray, from H5, H6

theorem ray-side-transfer
  let R be a point                                                    (H1)
  let P be a point                                                    (H2)
  let S be a point                                                    (H3)
  let Q be a point                                                    (H4)
  let X be a point                                                    (H5)
  assume X is on line RP                                              (H6)
  assume X and P are on the same side of line RS                      (H7)
  assume not (P is on line RQ)                                        (H8)
  then X and P are on the same side of line RQ

1.  X and P are on the same side of line RQ
    mun:geometry-ray-side-transfer, from H6, H7, H8

theorem off-line-swap
  let R be a point                                                    (H1)
  let P be a point                                                    (H2)
  let Q be a point                                                    (H3)
  assume not (Q is on line RP)                                        (H4)
  then not (P is on line RQ)

1.  not (P is on line RQ)
    mun:geometry-off-line-swap, from H4

theorem parallel-along
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  let D be a point                                                    (H4)
  let E be a point                                                    (H5)
  assume line AB ∥ line CD                                            (H6)
  assume A ≠ B                                                        (H7)
  assume E is on line AB                                              (H8)
  assume E ≠ A                                                        (H9)
  then line AE ∥ line DC

1.  line AE ∥ line DC
    mun:geometry-parallel-along, from H6, H7, H8, H9

theorem segment-point
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let r ∈ ℝ                                                           (H3)
  assume r > 0                                                        (H4)
  assume r < |AB|                                                     (H5)
  then there is X ∈ 𝔼² with (X is between A and B) and |AX| = r

1.  there is X ∈ 𝔼² with (X is between A and B) and |AX| = r
    mun:geometry-segment-point, from H4, H5

theorem parallel-uniqueness
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let P be a point                                                    (H3)
  let C be a point                                                    (H4)
  let D be a point                                                    (H5)
  assume A ≠ B                                                        (H6)
  assume not (P is on line AB)                                        (H7)
  assume P ≠ C                                                        (H8)
  assume P ≠ D                                                        (H9)
  assume line PC ∥ line AB                                            (H10)
  assume line PD ∥ line AB                                            (H11)
  then line PC = line PD

1.  line PC = line PD
    axi:geometry-parallel-uniqueness, from H6, H7, H8, H9, H10, H11

theorem ruler
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  assume A ≠ B                                                        (H3)
  then there is f : line AB → ℝ with f : line AB → ℝ is one-to-one and onto and for all P, Q ∈ line AB, |PQ| = |f(P) − f(Q)|

1.  there is f : line AB → ℝ with f : line AB → ℝ is one-to-one and onto
    and for all P, Q ∈ line AB, |PQ| = |f(P) − f(Q)|
    axi:geometry-ruler, from H3

theorem ruler-placement
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  assume A ≠ B                                                        (H3)
  then there is f : line AB → ℝ with f : line AB → ℝ is one-to-one and onto and f(A) = 0 and f(B) > 0 and for all P, Q ∈ line AB, |PQ| = |f(P) − f(Q)|

1.  there is f : line AB → ℝ with f : line AB → ℝ is one-to-one and onto
    and f(A) = 0 and f(B) > 0 and for all P, Q ∈ line AB, |PQ| = |f(P) − f(Q)|
    axi:geometry-ruler-placement, from H3
