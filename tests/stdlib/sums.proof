import mundane    stdlib/sums/range as sums-range
import mundane    stdlib/sums/range-empty as sums-range-empty
import mundane    stdlib/sums/range-nat as sums-range-nat
import mundane    stdlib/sums/range-single as sums-range-single
import mundane    stdlib/sums/range-split as sums-range-split
import mundane    stdlib/sums/range0 as sums-range0

theorem range-nat
  let n ∈ ℤ                                                           (H1)
  let k ∈ {1, …, n}                                                   (H2)
  then k ∈ ℕ

1.  k ∈ ℕ
    mun:sums-range-nat, from H1, H2

theorem range
  let n ∈ ℤ                                                           (H1)
  let k ∈ ℝ                                                           (H2)
  assume k ∈ {1, …, n}                                                (H3)
  then k ∈ ℕ and k ≤ n

1.  k ∈ ℕ and k ≤ n
    mun:sums-range, from H1, H3

theorem range0
  let n ∈ ℕ₀                                                          (H1)
  let k ∈ ℝ                                                           (H2)
  assume k ∈ {0, …, n}                                                (H3)
  then k ∈ ℕ₀ and k ≤ n

1.  k ∈ ℕ₀ and k ≤ n
    mun:sums-range0, from H1, H3

theorem range-single
  let m ∈ ℤ                                                           (H1)
  then {m, …, m} = {m}

1.  {m, …, m} = {m}
    mun:sums-range-single, from H1

theorem range-empty
  then {1, …, 0} = ∅

1.  {1, …, 0} = ∅
    mun:sums-range-empty

theorem range-split
  let m ∈ ℤ                                                           (H1)
  let n ∈ ℤ                                                           (H2)
  let k ∈ {m, …, n}                                                   (H3)
  then {m, …, n} = {m, …, k} ∪ {k + 1, …, n}

1.  {m, …, n} = {m, …, k} ∪ {k + 1, …, n}
    mun:sums-range-split, from H3
