import mundane    stdlib/sums/range-empty as sums-range-empty
import mundane    stdlib/sums/range-member as sums-range-member
import mundane    stdlib/sums/range-nat as sums-range-nat
import mundane    stdlib/sums/range-single as sums-range-single
import mundane    stdlib/sums/range-split as sums-range-split
import mundane    stdlib/sums/range0-member as sums-range0-member

theorem range-nat
  let n ∈ ℤ                                                           (H1)
  let k ∈ {1, …, n}                                                   (H2)
  then k ∈ ℕ

1.  k ∈ ℕ
    mun:sums-range-nat, from H1, H2

theorem range-member
  let n ∈ ℤ                                                           (H1)
  let k ∈ ℝ                                                           (H2)
  then k ∈ {1, …, n} ↔ k ∈ ℕ and k ≤ n

1.  k ∈ {1, …, n} ↔ k ∈ ℕ and k ≤ n
    mun:sums-range-member, from H1

theorem range0-member
  let n ∈ ℕ₀                                                          (H1)
  let k ∈ ℝ                                                           (H2)
  then k ∈ {0, …, n} ↔ k ∈ ℕ₀ and k ≤ n

1.  k ∈ {0, …, n} ↔ k ∈ ℕ₀ and k ≤ n
    mun:sums-range0-member, from H1

theorem range-single
  let m ∈ ℤ                                                           (H1)
  then {m, …, m} = {m}

1.  {m, …, m} = {m}
    mun:sums-range-single, from H1

theorem range-empty
  then {1, …, 0} = ∅

1.  {1, …, 0} = ∅
    mun:sums-range-empty

theorem range-split
  let m ∈ ℤ                                                           (H1)
  let n ∈ ℤ                                                           (H2)
  let k ∈ {m, …, n}                                                   (H3)
  then {m, …, n} = {m, …, k} ∪ {k + 1, …, n}

1.  {m, …, n} = {m, …, k} ∪ {k + 1, …, n}
    mun:sums-range-split, from H3
