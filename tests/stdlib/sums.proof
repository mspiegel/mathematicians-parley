import mundane definition stdlib/sums/range as sums-range
import mundane definition stdlib/sums/range-between as sums-range-between
import mundane theorem    stdlib/sums/range-empty as sums-range-empty
import mundane theorem    stdlib/sums/range-nat as sums-range-nat
import mundane theorem    stdlib/sums/range-nat0 as sums-range-nat0
import mundane theorem    stdlib/sums/range-single as sums-range-single
import mundane theorem    stdlib/sums/range-split as sums-range-split
import mundane theorem    stdlib/sums/range-extended as sums-range-extended
import mundane definition stdlib/sums/range0 as sums-range0
import mundane theorem    stdlib/sums/sum-empty-range as sums-sum-empty-range
import mundane theorem    stdlib/sums/sum-empty-set as sums-sum-empty-set

theorem sum-empty-range
  then Σ(k = 1 to 0) (2k − 1) = 0

1.  Σ(k = 1 to 0) (2k − 1) = 0
    mun:sums-sum-empty-range a := 1, b := 0
    requires 0 < 1: arithmetic

theorem sum-empty-set
  then Σ(k ∈ ∅) k² = 0

1.  Σ(k ∈ ∅) k² = 0
    mun:sums-sum-empty-set

theorem range-nat
  let n ∈ ℤ                                                           (H1)
  let k ∈ {1, …, n}                                                   (H2)
  then k ∈ ℕ

1.  k ∈ ℕ
    mun:sums-range-nat, from H2

theorem range-nat0
  let n ∈ ℤ                                                           (H1)
  let k ∈ {0, …, n}                                                   (H2)
  then k ∈ ℕ₀

1.  k ∈ ℕ₀
    mun:sums-range-nat0, from H2

theorem range
  let n ∈ ℤ                                                           (H1)
  let k ∈ ℝ                                                           (H2)
  assume k ∈ {1, …, n}                                                (H3)
  then k ∈ ℕ and k ≤ n

1.  k ∈ ℕ and k ≤ n
    mun:sums-range, from H3

theorem range0
  let n ∈ ℕ₀                                                          (H1)
  let k ∈ ℝ                                                           (H2)
  assume k ∈ {0, …, n}                                                (H3)
  then k ∈ ℕ₀ and k ≤ n

1.  k ∈ ℕ₀ and k ≤ n
    mun:sums-range0, from H3

theorem range-between
  let k ∈ ℤ                                                           (H1)
  let a ∈ ℤ                                                           (H2)
  let b ∈ ℤ                                                           (H3)
  assume a ≤ k                                                        (H4)
  assume k ≤ b                                                        (H5)
  then k ∈ {a, …, b}

1.  k ∈ {a, …, b}
    mun:sums-range-between, from H4, H5

theorem range-single
  let m ∈ ℤ                                                           (H1)
  then {m, …, m} = {m}

1.  {m, …, m} = {m}
    mun:sums-range-single

theorem range-empty
  then {1, …, 0} = ∅

1.  {1, …, 0} = ∅
    mun:sums-range-empty

theorem range-split
  let m ∈ ℤ                                                           (H1)
  let n ∈ ℤ                                                           (H2)
  let k ∈ {m, …, n}                                                   (H3)
  then {m, …, n} = {m, …, k} ∪ {k + 1, …, n}

1.  {m, …, n} = {m, …, k} ∪ {k + 1, …, n}
    mun:sums-range-split, from H3

theorem range-extended
  let m ∈ ℤ                                                           (H1)
  let n ∈ ℤ                                                           (H2)
  let j ∈ {m, …, n}                                                   (H3)
  then j ∈ {m, …, n + 1}

1.  j ∈ {m, …, n + 1}
    mun:sums-range-extended k := j, a := m, b := n, from H3
