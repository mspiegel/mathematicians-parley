import theorem            stdlib/calculus/derivative-linear
import theorem            stdlib/calculus/derivative-sum
import theorem            stdlib/calculus/derivative-difference
import mundane theorem    stdlib/calculus/integral-point
import theorem            stdlib/calculus/area-function
import mundane theorem    stdlib/calculus/reals-open
import mundane theorem    stdlib/sets/subset-self

theorem derivative-on-the-line
  let f : ℝ → ℝ                                                       (H1)
  assume f is differentiable on ℝ                                     (H2)
  let g : ℝ → ℝ                                                       (H3)
  assume for all x ∈ ℝ, g(x) = 3·x                                    (H4)
  let F : ℝ → ℝ                                                       (H5)
  assume for all x ∈ ℝ, F(x) = f(x) + g(x)                            (H6)
  then for all x ∈ ℝ, F′(x) = f′(x) + 3

1.  ℝ ⊆ ℝ
    mun:subset-self X := ℝ

2.  ℝ is open
    mun:reals-open

3.  g is differentiable on ℝ
    thm:derivative-linear D := ℝ, U := ℝ, m := 3, g := g, from 1, 2, H4
    requires 3 ∈ ℝ: arithmetic

4.  For all x ∈ ℝ, g′(x) = 3.
    thm:derivative-linear D := ℝ, U := ℝ, m := 3, g := g, from 1, 2, H4
    requires 3 ∈ ℝ: arithmetic

5.  For all x ∈ ℝ, F′(x) = f′(x) + g′(x).
    thm:derivative-sum D := ℝ, U := ℝ, F := F, f := f, g := g, from 1, H6, H2, 3

6.  For all x ∈ ℝ, F′(x) = f′(x) + 3.
    proof
    let x ∈ ℝ                                                         (K1)

    6.1.  F′(x) = f′(x) + g′(x)
          instantiate x := x in line 5, from K1

    6.2.  g′(x) = 3
          instantiate x := x in line 4, from K1

    6.3.  F′(x) = f′(x) + 3
          substitute g′(x) = 3 (line 6.2) into line 6.1

theorem derivative-of-a-difference
  let f : ℝ → ℝ                                                       (H1)
  assume f is differentiable on ℝ                                     (H2)
  let g : ℝ → ℝ                                                       (H3)
  assume for all x ∈ ℝ, g(x) = 3·x                                    (H4)
  let F : ℝ → ℝ                                                       (H5)
  assume for all x ∈ ℝ, F(x) = f(x) − g(x)                            (H6)
  then for all x ∈ ℝ, F′(x) = f′(x) − 3

1.  ℝ ⊆ ℝ
    mun:subset-self X := ℝ

2.  ℝ is open
    mun:reals-open

3.  g is differentiable on ℝ
    thm:derivative-linear D := ℝ, U := ℝ, m := 3, g := g, from 1, 2, H4
    requires 3 ∈ ℝ: arithmetic

4.  For all x ∈ ℝ, g′(x) = 3.
    thm:derivative-linear D := ℝ, U := ℝ, m := 3, g := g, from 1, 2, H4
    requires 3 ∈ ℝ: arithmetic

5.  For all x ∈ ℝ, F′(x) = f′(x) − g′(x).
    thm:derivative-difference D := ℝ, U := ℝ, F := F, f := f, g := g, from 1, H6, H2, 3

6.  For all x ∈ ℝ, F′(x) = f′(x) − 3.
    proof
    let x ∈ ℝ                                                         (K1)

    6.1.  F′(x) = f′(x) − g′(x)
          instantiate x := x in line 5, from K1

    6.2.  g′(x) = 3
          instantiate x := x in line 4, from K1

    6.3.  F′(x) = f′(x) − 3
          substitute g′(x) = 3 (line 6.2) into line 6.1

theorem area-under-other-letters
  note        Part one of the fundamental theorem cited where the page names
              everything otherwise: the interval [c, d], the integrand g over
              s, and the integral's upper end y.
  let c ∈ ℝ                                                           (H1)
  let d ∈ ℝ                                                           (H2)
  assume c < d                                                        (H3)
  let g : [c, d] → ℝ                                                  (H4)
  assume g is continuous on [c, d]                                    (H5)
  let H : [c, d] → ℝ                                                  (H6)
  assume for all y ∈ [c, d], H(y) = ∫(c to y) g(s) ds                 (H7)
  then for all y ∈ (c, d), H′(y) = g(y)

1.  For all y ∈ (c, d), H′(y) = g(y).
    thm:area-function a := c, b := d, f := g, G := H, from H1, H2, H3, H5, H7

theorem integral-over-a-point
  let c ∈ ℝ                                                           (H1)
  let g : ℝ → ℝ                                                       (H2)
  then ∫(c to c) g(s) ds = 0

1.  ∫(c to c) g(s) ds = 0
    mun:integral-point a := c, f := g, from H1
