theorem limit-unfolded
  ε, δ range over ℝ
  let D ⊆ ℝ                                                           (H1)
  let f : D → ℝ                                                       (H2)
  let c ∈ ℝ                                                           (H3)
  let L ∈ ℝ                                                           (H4)
  assume f tends to L at c                                            (H5)
  then for all ε > 0, there exists δ > 0 such that |f(x) − L| < ε for all x ∈ D with (x ≠ c and |x − c| < δ)

1.  For all ε > 0, there exists δ > 0 such that |f(x) − L| < ε for all x ∈ D with (x ≠ c and |x − c| < δ).
    def:limit-at, from H1, H5

theorem derivative-on-the-line
  let f : ℝ → ℝ                                                       (H1)
  assume f is differentiable on ℝ                                     (H2)
  let g : ℝ → ℝ                                                       (H3)
  assume for all x ∈ ℝ, g(x) = 3·x                                    (H4)
  let F : ℝ → ℝ                                                       (H5)
  assume for all x ∈ ℝ, F(x) = f(x) + g(x)                            (H6)
  then for all x ∈ ℝ, F′(x) = f′(x) + 3

1.  ℝ ⊆ ℝ
    mun:subset-self X := ℝ

2.  ℝ is open
    mun:reals-open

3.  g is differentiable on ℝ
    thm:derivative-linear D := ℝ, U := ℝ, m := 3, from H4, 1, 2

4.  For all x ∈ ℝ, g′(x) = 3.
    thm:derivative-linear D := ℝ, U := ℝ, m := 3, from H4, 1, 2

5.  For all x ∈ ℝ, F′(x) = f′(x) + g′(x).
    thm:derivative-sum D := ℝ, U := ℝ, from H2, H6, 1, 3

6.  For all x ∈ ℝ, F′(x) = f′(x) + 3.
    proof
    let x ∈ ℝ                                                         (K1)

    6.1.  F′(x) = f′(x) + g′(x)
          instantiate x := x in line 5

    6.2.  g′(x) = 3
          instantiate x := x in line 4

    6.3.  F′(x) = f′(x) + 3
          substitute g′(x) = 3 (line 6.2) into line 6.1

theorem derivative-of-a-difference
  let f : ℝ → ℝ                                                       (H1)
  assume f is differentiable on ℝ                                     (H2)
  let g : ℝ → ℝ                                                       (H3)
  assume for all x ∈ ℝ, g(x) = 3·x                                    (H4)
  let F : ℝ → ℝ                                                       (H5)
  assume for all x ∈ ℝ, F(x) = f(x) − g(x)                            (H6)
  then for all x ∈ ℝ, F′(x) = f′(x) − 3

1.  ℝ ⊆ ℝ
    mun:subset-self X := ℝ

2.  ℝ is open
    mun:reals-open

3.  g is differentiable on ℝ
    thm:derivative-linear D := ℝ, U := ℝ, m := 3, from H4, 1, 2

4.  For all x ∈ ℝ, g′(x) = 3.
    thm:derivative-linear D := ℝ, U := ℝ, m := 3, from H4, 1, 2

5.  For all x ∈ ℝ, F′(x) = f′(x) − g′(x).
    thm:derivative-difference D := ℝ, U := ℝ, from H2, H6, 1, 3

6.  For all x ∈ ℝ, F′(x) = f′(x) − 3.
    proof
    let x ∈ ℝ                                                         (K1)

    6.1.  F′(x) = f′(x) − g′(x)
          instantiate x := x in line 5

    6.2.  g′(x) = 3
          instantiate x := x in line 4

    6.3.  F′(x) = f′(x) − 3
          substitute g′(x) = 3 (line 6.2) into line 6.1

theorem area-under-other-letters
  note        Part one of the fundamental theorem cited where the page names
              everything otherwise: the interval [c, d], the integrand g over
              s, and the integral's upper end y.
  let c ∈ ℝ                                                           (H1)
  let d ∈ ℝ                                                           (H2)
  assume c < d                                                        (H3)
  let g : [c, d] → ℝ                                                  (H4)
  assume g is continuous on [c, d]                                    (H5)
  let H : [c, d] → ℝ                                                  (H6)
  assume for all y ∈ [c, d], H(y) = ∫(c to y) g(s) ds                 (H7)
  then for all y ∈ (c, d), H′(y) = g(y)

1.  For all y ∈ (c, d), H′(y) = g(y).
    thm:area-function a := c, b := d, f := g, G := H, from H3, H5, H7

theorem area-is-continuous
  let c ∈ ℝ                                                           (H1)
  let d ∈ ℝ                                                           (H2)
  assume c < d                                                        (H3)
  let g : [c, d] → ℝ                                                  (H4)
  assume g is continuous on [c, d]                                    (H5)
  let H : [c, d] → ℝ                                                  (H6)
  assume for all y ∈ [c, d], H(y) = ∫(c to y) g(s) ds                 (H7)
  then H is continuous on [c, d]

1.  H is continuous on [c, d]
    thm:area-function a := c, b := d, f := g, G := H, from H3, H5, H7

theorem integral-is-real
  let c ∈ ℝ                                                           (H1)
  let d ∈ ℝ                                                           (H2)
  assume c < d                                                        (H3)
  let g : [c, d] → ℝ                                                  (H4)
  assume g is continuous on [c, d]                                    (H5)
  let y ∈ [c, d]                                                      (H6)
  then ∫(c to y) g(s) ds ∈ ℝ

1.  ∫(c to y) g(s) ds ∈ ℝ
    mun:integral-real a := c, b := d, f := g, x := y, from H3, H5, H6

theorem continuous-of-a-difference
  let f : ℝ → ℝ                                                       (H1)
  assume f is continuous on ℝ                                         (H2)
  let g : ℝ → ℝ                                                       (H3)
  assume g is continuous on ℝ                                         (H4)
  let F : ℝ → ℝ                                                       (H5)
  assume for all x ∈ ℝ, F(x) = f(x) − g(x)                            (H6)
  then F is continuous on ℝ

1.  ℝ ⊆ ℝ
    mun:subset-self X := ℝ

2.  F is continuous on ℝ
    thm:continuous-difference D := ℝ, from H2, H4, H6, 1

theorem continuous-on-a-part
  note        A function on ℝ continuous there is continuous on a part of ℝ,
              though that part is not its domain.
  let f : ℝ → ℝ                                                       (H1)
  assume f is continuous on ℝ                                         (H2)
  let S ⊆ ℝ                                                           (H3)
  then f is continuous on S

1.  ℝ ⊆ ℝ
    mun:subset-self X := ℝ

2.  f is continuous on S
    mun:continuous-on-part D := ℝ, from H2, H3, 1

theorem integral-over-a-point
  let c ∈ ℝ                                                           (H1)
  let g : ℝ → ℝ                                                       (H2)
  then ∫(c to c) g(s) ds = 0

1.  ∫(c to c) g(s) ds = 0
    mun:integral-point a := c, f := g

theorem a-convergent-bounded-on-both-sides
  let y : ℕ → ℝ                                                       (H1)
  let M ∈ ℝ                                                           (H2)
  assume y(n) → M as n → ∞                                            (H3)
  then there exists B ∈ ℝ such that for all m ∈ ℕ, |y(m)| ≤ B

1.  there exists B ∈ ℝ such that for all m ∈ ℕ, |y(m)| ≤ B
    thm:convergent-abs-bounded x := y, L := M, from H3

theorem inside-an-open-interval
  let a ∈ ℝ                                                           (H1)
  let b ∈ ℝ                                                           (H2)
  let x ∈ (a, b)                                                      (H3)
  then x ∈ ℝ and a < x and x < b

1.  x ∈ ℝ and a < x and x < b
    mun:open-interval, from H3

theorem an-open-interval-is-real
  let a ∈ ℝ                                                           (H1)
  let b ∈ ℝ                                                           (H2)
  then (a, b) ⊆ ℝ

1.  (a, b) ⊆ ℝ
    mun:open-interval-real

theorem closed-between-two-inner-points
  let a ∈ ℝ                                                           (H1)
  let b ∈ ℝ                                                           (H2)
  let p ∈ (a, b)                                                      (H3)
  let q ∈ (a, b)                                                      (H4)
  then [p, q] ⊆ (a, b)

1.  [p, q] ⊆ (a, b)
    mun:closed-within-open, from H3, H4

theorem open-but-for-a-point
  let a ∈ ℝ                                                           (H1)
  let b ∈ ℝ                                                           (H2)
  let c ∈ (a, b)                                                      (H3)
  then (a, b) ∖ {c} is open

1.  (a, b) ∖ {c} is open
    mun:open-without-point U := (a, b), from H3
    requires (a, b) ⊆ ℝ: mun:open-interval-real
    requires (a, b) is open: mun:open-interval-open

theorem rolle-inside-a-larger-domain
  let a ∈ ℝ                                                           (H1)
  let b ∈ ℝ                                                           (H2)
  assume a < b                                                        (H3)
  let h : ℝ → ℝ                                                       (H4)
  assume h is continuous on [a, b]                                    (H5)
  assume h is differentiable on (a, b)                                (H6)
  assume h(a) = h(b)                                                  (H7)
  then there is c ∈ (a, b) with h′(c) = 0

1.  [a, b] ⊆ ℝ
    mun:interval-real

2.  ℝ ⊆ ℝ
    mun:subset-self X := ℝ

3.  there is c ∈ (a, b) with h′(c) = 0
    thm:rolle-on-part D := ℝ, f := h, from H3, H5, H6, H7, 1, 2

theorem cauchy-inside-a-larger-domain
  let a ∈ ℝ                                                           (H1)
  let b ∈ ℝ                                                           (H2)
  assume a < b                                                        (H3)
  let h : ℝ → ℝ                                                       (H4)
  let k : ℝ → ℝ                                                       (H5)
  assume h is continuous on [a, b]                                    (H6)
  assume k is continuous on [a, b]                                    (H7)
  assume h is differentiable on (a, b)                                (H8)
  assume k is differentiable on (a, b)                                (H9)
  then there is c ∈ (a, b) with (h(b) − h(a))·k′(c) = (k(b) − k(a))·h′(c)

1.  [a, b] ⊆ ℝ
    mun:interval-real

2.  ℝ ⊆ ℝ
    mun:subset-self X := ℝ

3.  there is c ∈ (a, b) with (h(b) − h(a))·k′(c) = (k(b) − k(a))·h′(c)
    thm:cauchy-mean-value D := ℝ, f := h, g := k, from H3, H6, H7, H8, H9, 1, 2

theorem a-derivative-on-a-part-is-real
  let D ⊆ ℝ                                                           (H1)
  let h : D → ℝ                                                       (H2)
  let S ⊆ D                                                           (H3)
  assume h is differentiable on S                                     (H4)
  let y ∈ S                                                           (H5)
  then h′(y) ∈ ℝ

1.  h′(y) ∈ ℝ
    mun:derivative-real-on U := S, f := h, x := y, from H1, H3, H4, H5

theorem differentiable-on-a-smaller-set
  let D ⊆ ℝ                                                           (H1)
  let h : D → ℝ                                                       (H2)
  let V ⊆ D                                                           (H3)
  let W ⊆ V                                                           (H4)
  assume h is differentiable on V                                     (H5)
  then h is differentiable on W

1.  h is differentiable on W
    mun:differentiable-on-part U := V, S := W, f := h, from H1, H3, H4, H5

theorem equal-functions-have-one-derivative
  let D ⊆ ℝ                                                           (H1)
  let E ⊆ ℝ                                                           (H2)
  let V ⊆ D                                                           (H3)
  assume V ⊆ E                                                        (H4)
  assume V is open                                                    (H5)
  let h : D → ℝ                                                       (H6)
  let H : E → ℝ                                                       (H7)
  assume for all y ∈ V, H(y) = h(y)                                   (H8)
  assume h is differentiable on V                                     (H9)
  then for all y ∈ V, H′(y) = h′(y)

1.  For all y ∈ V, H′(y) = h′(y).
    mun:derivative-local U := V, f := h, F := H, from H1, H2, H3, H4, H5, H8, H9

theorem equal-functions-are-differentiable-together
  let D ⊆ ℝ                                                           (H1)
  let E ⊆ ℝ                                                           (H2)
  let V ⊆ D                                                           (H3)
  assume V ⊆ E                                                        (H4)
  assume V is open                                                    (H5)
  let h : D → ℝ                                                       (H6)
  let H : E → ℝ                                                       (H7)
  assume for all y ∈ V, H(y) = h(y)                                   (H8)
  assume h is differentiable on V                                     (H9)
  then H is differentiable on V

1.  H is differentiable on V
    mun:derivative-local U := V, f := h, F := H, from H1, H2, H3, H4, H5, H8, H9

theorem a-limit-filled-in
  let U ⊆ ℝ                                                           (H1)
  assume U is open                                                    (H2)
  let p ∈ U                                                           (H3)
  let h : U ∖ {p} → ℝ                                                 (H4)
  let H : U → ℝ                                                       (H5)
  assume for all y ∈ U ∖ {p}, H(y) = h(y)                             (H6)
  assume H(p) = 0                                                     (H7)
  assume h is differentiable on U ∖ {p}                               (H8)
  assume h tends to 0 at p                                            (H9)
  then H is continuous on U

1.  H is continuous on U
    thm:continuous-extension c := p, L := 0, f := h, F := H, from H1, H2, H3, H6, H7, H8, H9

theorem a-series-from-its-zeroth-term
  let s : ℕ₀ → ℝ                                                      (H1)
  assume Σ(j = 0 to m) s(j) → 3 as m → ∞                              (H2)
  then Σ(j = 0 to ∞) s(j) = 3

1.  Σ(j = 0 to ∞) s(j) = 3
    mun:series-sum-from-zero t := s, L := 3, from H2

theorem a-constant-is-continuous
  let E ⊆ ℝ                                                           (H1)
  let h : E → ℝ                                                       (H2)
  assume for all y ∈ E, h(y) = 5                                      (H3)
  then h is continuous on E

1.  h is continuous on E
    thm:continuous-constant D := E, c := 5, g := h, from H1, H3

theorem a-power-is-continuous
  let E ⊆ ℝ                                                           (H1)
  let h : E → ℝ                                                       (H2)
  assume for all y ∈ E, h(y) = y^3                                    (H3)
  then h is continuous on E

1.  h is continuous on E
    thm:continuous-power D := E, n := 3, g := h, from H1, H3

theorem a-multiple-is-continuous
  let E ⊆ ℝ                                                           (H1)
  let h : E → ℝ                                                       (H2)
  let H : E → ℝ                                                       (H3)
  assume for all y ∈ E, H(y) = 7·h(y)                                 (H4)
  assume h is continuous on E                                         (H5)
  then H is continuous on E

1.  H is continuous on E
    thm:continuous-scaled D := E, c := 7, F := H, f := h, from H1, H4, H5

theorem a-quotient-is-continuous
  let E ⊆ ℝ                                                           (H1)
  let h : E → ℝ                                                       (H2)
  let k : E → ℝ                                                       (H3)
  let H : E → ℝ                                                       (H4)
  assume for all y ∈ E, k(y) ≠ 0                                      (H5)
  assume for all y ∈ E, H(y) = h(y)/k(y)                              (H6)
  assume h is continuous on E                                         (H7)
  assume k is continuous on E                                         (H8)
  then H is continuous on E

1.  H is continuous on E
    thm:continuous-quotient D := E, F := H, f := h, g := k, from H1, H5, H6, H7, H8

theorem the-derivative-of-a-power
  let E ⊆ ℝ                                                           (H1)
  let V ⊆ E                                                           (H2)
  assume V is open                                                    (H3)
  let h : E → ℝ                                                       (H4)
  assume for all y ∈ E, h(y) = y^(2 + 1)                              (H5)
  then h is differentiable on V. For all y ∈ V, h′(y) = (2 + 1)·y^2.

1.  h is differentiable on V. For all y ∈ V, h′(y) = (2 + 1)·y^2.
    thm:derivative-power D := E, U := V, n := 2, g := h, from H1, H2, H3, H5

theorem the-derivative-of-a-multiple
  let E ⊆ ℝ                                                           (H1)
  let V ⊆ E                                                           (H2)
  let h : E → ℝ                                                       (H3)
  let H : E → ℝ                                                       (H4)
  assume for all y ∈ E, H(y) = 7·h(y)                                 (H5)
  assume h is differentiable on V                                     (H6)
  then H is differentiable on V. For all y ∈ V, H′(y) = 7·h′(y).

1.  H is differentiable on V. For all y ∈ V, H′(y) = 7·h′(y).
    thm:derivative-scaled D := E, U := V, c := 7, F := H, f := h, from H1, H2, H5, H6

theorem an-integral-of-a-difference
  let c ∈ ℝ                                                           (H1)
  let d ∈ ℝ                                                           (H2)
  assume c < d                                                        (H3)
  let h : [c, d] → ℝ                                                  (H4)
  let k : [c, d] → ℝ                                                  (H5)
  let H : [c, d] → ℝ                                                  (H6)
  assume for all y ∈ [c, d], H(y) = h(y) − k(y)                       (H7)
  assume h is continuous on [c, d]                                    (H8)
  assume k is continuous on [c, d]                                    (H9)
  then ∫(c to d) H(s) ds = ∫(c to d) h(s) ds − ∫(c to d) k(s) ds

1.  ∫(c to d) H(s) ds = ∫(c to d) h(s) ds − ∫(c to d) k(s) ds
    thm:integral-difference a := c, b := d, f := h, g := k, h := H, from H3, H7, H8, H9

theorem integrals-in-order
  let c ∈ ℝ                                                           (H1)
  let d ∈ ℝ                                                           (H2)
  assume c < d                                                        (H3)
  let h : [c, d] → ℝ                                                  (H4)
  let k : [c, d] → ℝ                                                  (H5)
  assume for all y ∈ [c, d], h(y) ≤ k(y)                              (H6)
  assume h is continuous on [c, d]                                    (H7)
  assume k is continuous on [c, d]                                    (H8)
  then ∫(c to d) h(s) ds ≤ ∫(c to d) k(s) ds

1.  ∫(c to d) h(s) ds ≤ ∫(c to d) k(s) ds
    thm:integral-order a := c, b := d, f := h, g := k, from H3, H6, H7, H8

theorem an-integral-not-negative
  let c ∈ ℝ                                                           (H1)
  let d ∈ ℝ                                                           (H2)
  assume c < d                                                        (H3)
  let h : [c, d] → ℝ                                                  (H4)
  assume for all y ∈ [c, d], h(y) ≥ 0                                 (H5)
  assume h is continuous on [c, d]                                    (H6)
  then ∫(c to d) h(s) ds ≥ 0

1.  ∫(c to d) h(s) ds ≥ 0
    thm:integral-nonneg a := c, b := d, f := h, from H3, H5, H6
