import theorem            stdlib/divisibility/gcd-mod as divisibility-gcd-mod
import mundane definition stdlib/divisibility/gcd
import mundane theorem    stdlib/divisibility/gcd-commutes as divisibility-gcd-commutes
import mundane theorem    stdlib/divisibility/gcd-one as divisibility-gcd-one
import mundane theorem    stdlib/divisibility/gcd-zero as divisibility-gcd-zero
import mundane theorem    stdlib/divisibility/gcd-integer as divisibility-gcd-integer
import mundane theorem    stdlib/divisibility/gcd-negative as divisibility-gcd-negative
import mundane theorem    stdlib/divisibility/mod-less as divisibility-mod-less
import mundane theorem    stdlib/divisibility/mod-natural as divisibility-mod-natural
import mundane theorem    stdlib/divisibility/mod-value as divisibility-mod-value
import mundane theorem    stdlib/divisibility/mod-below as divisibility-mod-below
import mundane theorem    stdlib/divisibility/zero-divides as divisibility-zero-divides
import definition         stdlib/divisibility/σ
import mundane theorem    stdlib/divisibility/mod-real as divisibility-mod-real
import mundane definition stdlib/divisibility/lcm
import mundane theorem    stdlib/divisibility/lcm-times-gcd as divisibility-lcm-times-gcd
import mundane theorem    stdlib/divisibility/odd-plus-odd as divisibility-odd-plus-odd
import mundane theorem    stdlib/divisibility/odd-minus-odd as divisibility-odd-minus-odd
import mundane theorem    stdlib/divisibility/odd-plus-even as divisibility-odd-plus-even
import mundane theorem    stdlib/divisibility/odd-minus-even as divisibility-odd-minus-even
import mundane theorem    stdlib/divisibility/even-product as divisibility-even-product
import mundane theorem    stdlib/divisibility/even-product-factor as divisibility-even-product-factor
import theorem            stdlib/divisibility/prime-divides-product as divisibility-prime-divides-product
import mundane theorem    stdlib/divisibility/odd-not-even as divisibility-odd-not-even
import theorem            stdlib/divisibility/prime-divides-power as divisibility-prime-divides-power

theorem odd-not-even
  let n ∈ ℤ                                                           (H1)
  assume n is odd                                                     (H2)
  then not (n is even)

1.  not (n is even)
    mun:divisibility-odd-not-even, from H2

theorem even-product-factor
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  then a·b is even ↔ a is even or b is even

1.  a·b is even ↔ a is even or b is even
    mun:divisibility-even-product-factor

theorem prime-divides-product
  let p ∈ ℕ                                                           (H1)
  assume p is prime                                                   (H2)
  let m ∈ ℤ                                                           (H3)
  let n ∈ ℤ                                                           (H4)
  then p divides m·n ↔ p divides m or p divides n

1.  p divides m·n ↔ p divides m or p divides n
    thm:divisibility-prime-divides-product, from H2

theorem odd-plus-odd
  let a ∈ ℤ                                                           (H1)
  assume a is odd                                                     (H2)
  let b ∈ ℤ                                                           (H3)
  assume b is odd                                                     (H4)
  then a + b is even

1.  a + b is even
    mun:divisibility-odd-plus-odd, from H2, H4

theorem odd-minus-odd
  let a ∈ ℤ                                                           (H1)
  assume a is odd                                                     (H2)
  let b ∈ ℤ                                                           (H3)
  assume b is odd                                                     (H4)
  then a − b is even

1.  a − b is even
    mun:divisibility-odd-minus-odd, from H2, H4

theorem odd-plus-even
  let a ∈ ℤ                                                           (H1)
  assume a is odd                                                     (H2)
  let b ∈ ℤ                                                           (H3)
  assume b is even                                                    (H4)
  then a + b is odd

1.  a + b is odd
    mun:divisibility-odd-plus-even, from H2, H4

theorem odd-minus-even
  let a ∈ ℤ                                                           (H1)
  assume a is odd                                                     (H2)
  let b ∈ ℤ                                                           (H3)
  assume b is even                                                    (H4)
  then a − b is odd

1.  a − b is odd
    mun:divisibility-odd-minus-even, from H2, H4

theorem even-product
  let a ∈ ℤ                                                           (H1)
  assume a is even                                                    (H2)
  let x ∈ ℤ                                                           (H3)
  then a·x is even

1.  a·x is even
    mun:divisibility-even-product, from H2

theorem lcm-a-multiple
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  then a divides lcm(a, b)

1.  a divides lcm(a, b)
    mun:lcm

theorem lcm-least
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  then for all k ∈ ℤ, if a divides k and b divides k then lcm(a, b) divides k

1.  For all k ∈ ℤ, if a divides k and b divides k then lcm(a, b) divides k.
    mun:lcm

theorem lcm-times-gcd
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  then lcm(a, b)·gcd(a, b) = |a·b|

1.  lcm(a, b)·gcd(a, b) = |a·b|
    mun:divisibility-lcm-times-gcd

theorem mod-real
  let a ∈ ℝ                                                           (H1)
  let b ∈ ℝ                                                           (H2)
  assume b > 0                                                        (H3)
  then a mod b ∈ ℝ

1.  a mod b ∈ ℝ
    mun:divisibility-mod-real, from H3

theorem sigma
  let n ∈ ℕ                                                           (H1)
  then σ(n) = Σ(d ∈ ℕ : d divides n) d

1.  σ(n) = Σ(d ∈ ℕ : d divides n) d
    def:σ

theorem gcd-commutes
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  then gcd(a, b) = gcd(b, a)

1.  gcd(a, b) = gcd(b, a)
    mun:divisibility-gcd-commutes

theorem gcd-one
  let a ∈ ℤ                                                           (H1)
  then gcd(a, 1) = 1

1.  gcd(a, 1) = 1
    mun:divisibility-gcd-one

theorem gcd-integer
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  then gcd(a, b) divides b

1.  gcd(a, b) divides b
    mun:divisibility-gcd-integer

theorem gcd-negative
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  then gcd(−a, b) = gcd(a, b)

1.  gcd(−a, b) = gcd(a, b)
    mun:divisibility-gcd-negative

theorem gcd-zero
  let n ∈ ℕ₀                                                          (H1)
  then gcd(n, 0) = n

1.  gcd(n, 0) = n
    mun:divisibility-gcd-zero

theorem gcd-mod
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℕ                                                           (H2)
  then gcd(a mod b, b) = gcd(a, b)

1.  gcd(a mod b, b) = gcd(a, b)
    thm:divisibility-gcd-mod

theorem mod-natural
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℕ                                                           (H2)
  then a mod b ∈ ℕ₀

1.  a mod b ∈ ℕ₀
    mun:divisibility-mod-natural

theorem mod-less
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℕ                                                           (H2)
  then a mod b < b

1.  a mod b < b
    mun:divisibility-mod-less

theorem mod-value
  let a ∈ ℝ                                                           (H1)
  let b ∈ ℝ                                                           (H2)
  assume b > 0                                                        (H3)
  then a mod b = a − b·⌊a/b⌋

1.  a mod b = a − b·⌊a/b⌋
    mun:divisibility-mod-value, from H3

theorem mod-below
  let a ∈ ℝ                                                           (H1)
  let b ∈ ℝ                                                           (H2)
  assume 0 ≤ a                                                        (H3)
  assume a < b                                                        (H4)
  then a mod b = a

1.  a mod b = a
    mun:divisibility-mod-below, from H3, H4

theorem zero-divides
  let n ∈ ℤ                                                           (H1)
  then 0 divides n ↔ n = 0

1.  0 divides n ↔ n = 0
    mun:divisibility-zero-divides

theorem prime-divides-power
  let q ∈ ℕ                                                           (H1)
  assume q is prime                                                   (H2)
  let x ∈ ℤ                                                           (H3)
  let k ∈ ℕ                                                           (H4)
  then q divides x^k ↔ q divides x

1.  q divides x^k ↔ q divides x
    thm:divisibility-prime-divides-power p := q, a := x, n := k, from H2
