import theorem    stdlib/divisibility/gcd-mod as divisibility-gcd-mod
import mundane    stdlib/divisibility/gcd
import mundane    stdlib/divisibility/gcd-commutes as divisibility-gcd-commutes
import mundane    stdlib/divisibility/gcd-one as divisibility-gcd-one
import mundane    stdlib/divisibility/gcd-zero as divisibility-gcd-zero
import mundane    stdlib/divisibility/mod-less as divisibility-mod-less
import mundane    stdlib/divisibility/mod-natural as divisibility-mod-natural
import mundane    stdlib/divisibility/zero-divides as divisibility-zero-divides
import definition stdlib/divisibility/σ

theorem sigma
  let n ∈ ℕ                                                           (H1)
  then σ(n) = Σ(d ∈ {e ∈ ℕ : e divides n}) d

1.  σ(n) = Σ(d ∈ {e ∈ ℕ : e divides n}) d
    def:σ n := n, from H1

theorem gcd-commutes
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  then gcd(a, b) = gcd(b, a)

1.  gcd(a, b) = gcd(b, a)
    mun:divisibility-gcd-commutes, from H1, H2

theorem gcd-one
  let a ∈ ℤ                                                           (H1)
  then gcd(a, 1) = 1

1.  gcd(a, 1) = 1
    mun:divisibility-gcd-one, from H1

theorem gcd-zero
  let n ∈ ℕ₀                                                          (H1)
  then gcd(n, 0) = n

1.  gcd(n, 0) = n
    mun:divisibility-gcd-zero, from H1

theorem gcd-mod
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℕ                                                           (H2)
  then gcd(a mod b, b) = gcd(a, b)

1.  gcd(a mod b, b) = gcd(a, b)
    thm:divisibility-gcd-mod, from H1, H2

theorem mod-natural
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℕ                                                           (H2)
  then a mod b ∈ ℕ₀

1.  a mod b ∈ ℕ₀
    mun:divisibility-mod-natural, from H1, H2

theorem mod-less
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℕ                                                           (H2)
  then a mod b < b

1.  a mod b < b
    mun:divisibility-mod-less, from H1, H2

theorem zero-divides
  let n ∈ ℤ                                                           (H1)
  then 0 divides n ↔ n = 0

1.  0 divides n ↔ n = 0
    mun:divisibility-zero-divides, from H1
