import proof stdlib/divisibility

theorem gcd-commutes
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  then gcd(a, b) = gcd(b, a)

1.  gcd(a, b) = gcd(b, a)
    thm:stdlib/divisibility/gcd-commutes, from H1, H2

theorem gcd-one
  let a ∈ ℤ                                                           (H1)
  then gcd(a, 1) = 1

1.  gcd(a, 1) = 1
    thm:stdlib/divisibility/gcd-one, from H1

theorem gcd-zero
  let n ∈ ℕ₀                                                          (H1)
  then gcd(n, 0) = n

1.  gcd(n, 0) = n
    thm:stdlib/divisibility/gcd-zero, from H1

theorem gcd-mod
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℕ                                                           (H2)
  then gcd(a mod b, b) = gcd(a, b)

1.  gcd(a mod b, b) = gcd(a, b)
    thm:stdlib/divisibility/gcd-mod, from H1, H2

theorem mod-natural
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℕ                                                           (H2)
  then a mod b ∈ ℕ₀

1.  a mod b ∈ ℕ₀
    thm:stdlib/divisibility/mod-natural, from H1, H2

theorem mod-less
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℕ                                                           (H2)
  then a mod b < b

1.  a mod b < b
    thm:stdlib/divisibility/mod-less, from H1, H2

theorem zero-divides
  let n ∈ ℤ                                                           (H1)
  then 0 divides n ↔ n = 0

1.  0 divides n ↔ n = 0
    thm:stdlib/divisibility/zero-divides, from H1
