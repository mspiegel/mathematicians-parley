import mundane theorem    stdlib/numbers/real-power-positive
import mundane theorem    stdlib/numbers/real-power-real
import mundane theorem    stdlib/numbers/root-power
import mundane theorem    stdlib/numbers/half-power
import mundane definition stdlib/logarithms/exp
import mundane theorem    stdlib/logarithms/e-power
import mundane theorem    stdlib/numbers/cube-root-real
import mundane theorem    stdlib/numbers/cube-root-cubed
import mundane theorem    stdlib/numbers/cube-root-of-cube
import mundane theorem    stdlib/numbers/cube-root-as-power
import mundane theorem    stdlib/numbers/real-power-complex
import mundane theorem    stdlib/numbers/real-power-nonneg
import mundane theorem    stdlib/numbers/real-power-sum
import mundane theorem    stdlib/numbers/real-power-of-power

theorem a-real-power-of-a-positive-real
  note        y is real, so x^y is the principal power, and positive.
  let x ∈ ℝ                                                           (H1)
  assume x > 0                                                        (H2)
  let y ∈ ℝ                                                           (H3)
  then x^y > 0

1.  x^y > 0
    mun:real-power-positive, from H2

theorem a-fraction-for-an-exponent
  note        An exponent with a division in it is not whole.
  let x ∈ ℝ                                                           (H1)
  assume x ≥ 0                                                        (H2)
  then x^(1/3) ∈ ℝ

1.  x^(1/3) ∈ ℝ
    mun:real-power-real y := 1/3, from H2

theorem the-cube-of-a-cube-root
  note        The principal cube root of x, cubed: the outer power is whole.
  let x ∈ ℂ                                                           (H1)
  then (x^(1/3))^3 = x

1.  (x^(1/3))^3 = x
    mun:root-power n := 3

theorem a-half-power
  let x ∈ ℝ                                                           (H1)
  then x^(1/2) = √x

1.  x^(1/2) = √x
    mun:half-power

theorem e-to-a-real-power
  let y ∈ ℝ                                                           (H1)
  then e^y = exp(y)

1.  e^y = exp(y)
    mun:e-power

theorem a-real-power-under-a-binder
  note        The binder puts y in ℝ, so 2^y is the principal power.
  then for all y ∈ ℝ, 2^y > 0

1.  For all y ∈ ℝ, 2^y > 0.
    proof
    let y ∈ ℝ                                                         (K1)

    1.1.  2^y > 0
          mun:real-power-positive x := 2
          requires 2 > 0: arithmetic

theorem a-real-power-under-a-binder-cited
  note        Cited, the statement above is read alone, where only its binder
              says what y is.
  then for all z ∈ ℝ, 2^z > 0

1.  For all z ∈ ℝ, 2^z > 0.
    thm:a-real-power-under-a-binder

theorem a-cube-root-is-real
  let x ∈ ℝ                                                           (H1)
  then ∛x ∈ ℝ

1.  ∛x ∈ ℝ
    mun:cube-root-real

theorem a-cube-root-cubed
  let x ∈ ℝ                                                           (H1)
  then (∛x)³ = x

1.  (∛x)³ = x
    mun:cube-root-cubed

theorem the-cube-root-of-a-cube
  let x ∈ ℝ                                                           (H1)
  then ∛(x³) = x

1.  ∛(x³) = x
    mun:cube-root-of-cube

theorem a-cube-root-written-with-its-index
  note        ³√x is ∛x written with its index raised.
  let x ∈ ℝ                                                           (H1)
  then (³√x)³ = x

1.  (³√x)³ = x
    mun:cube-root-cubed

theorem a-cube-root-as-a-power
  let x ∈ ℝ                                                           (H1)
  assume x ≥ 0                                                        (H2)
  then ∛x = x^(1/3)

1.  ∛x = x^(1/3)
    mun:cube-root-as-power, from H2

theorem a-complex-power
  let z ∈ ℂ                                                           (H1)
  let w ∈ ℂ                                                           (H2)
  then z^w ∈ ℂ

1.  z^w ∈ ℂ
    mun:real-power-complex x := z, y := w

theorem a-real-power-not-below-zero
  let x ∈ ℝ                                                           (H1)
  assume x ≥ 0                                                        (H2)
  then x^(1/3) ≥ 0

1.  x^(1/3) ≥ 0
    mun:real-power-nonneg y := 1/3, from H2

theorem real-powers-added
  note        A sum in the exponent is the product of the two powers.
  let x ∈ ℝ                                                           (H1)
  assume x ≠ 0                                                        (H2)
  let a ∈ ℝ                                                           (H3)
  let b ∈ ℝ                                                           (H4)
  then x^(a + b) = x^a·x^b

1.  x^(a + b) = x^a·x^b
    mun:real-power-sum, from H2

theorem a-real-power-of-a-real-power
  let x ∈ ℝ                                                           (H1)
  assume x > 0                                                        (H2)
  let a ∈ ℝ                                                           (H3)
  let b ∈ ℝ                                                           (H4)
  then x^(a·b) = (x^a)^b

1.  x^(a·b) = (x^a)^b
    mun:real-power-of-power, from H2
