import mundane theorem    stdlib/sums/sum-constant
import mundane theorem    stdlib/sums/sum-single
import mundane theorem    stdlib/sums/sum-extended
import theorem            stdlib/sums/product-factor
import mundane theorem    stdlib/sums/product-extended
import mundane theorem    stdlib/sums/product-real

theorem a-constant-summed
  then Σ(k = 1 to 3) 5 = 15

1.  Σ(k = 1 to 3) 5 = (3 − 1 + 1)·5
    mun:sum-constant a := 1, b := 3, c := 5
    requires 1 ≤ 3: arithmetic

2.  Σ(k = 1 to 3) 5 = 15
    calculation
    Σ(k = 1 to 3) 5 = (3 − 1 + 1)·5     1
                    = 15                arithmetic

theorem one-to-three-summed
  then Σ(k = 1 to 3) k = 6

1.  Σ(k = 1 to 1) k = 1
    mun:sum-single a := 1

2.  Σ(k = 1 to 1 + 1) k = Σ(k = 1 to 1) k + (1 + 1)
    mun:sum-extended a := 1, n := 1
    requires 1 ≥ 1: arithmetic

3.  Σ(k = 1 to 2 + 1) k = Σ(k = 1 to 2) k + (2 + 1)
    mun:sum-extended a := 1, n := 2
    requires 2 ≥ 1: arithmetic

4.  1 + 1 = 2
    arithmetic

5.  Σ(k = 1 to 2) k = Σ(k = 1 to 1) k + 2
    substitute 1 + 1 = 2 (line 4) into line 2

6.  Σ(k = 1 to 2) k = 1 + 2
    substitute Σ(k = 1 to 1) k = 1 (line 1) into line 5

7.  Σ(k = 1 to 2) k = 3
    calculation
    Σ(k = 1 to 2) k = 1 + 2     6
                    = 3         arithmetic

8.  2 + 1 = 3
    arithmetic

9.  Σ(k = 1 to 3) k = Σ(k = 1 to 2) k + 3
    substitute 2 + 1 = 3 (line 8) into line 3

10. Σ(k = 1 to 3) k = 3 + 3
    substitute Σ(k = 1 to 2) k = 3 (line 7) into line 9

11. Σ(k = 1 to 3) k = 6
    calculation
    Σ(k = 1 to 3) k = 3 + 3     10
                    = 6         arithmetic

theorem one-to-three-not-five
  then Σ(k = 1 to 3) k ≠ 5

1.  Σ(k = 1 to 3) k = 6
    thm:one-to-three-summed

2.  Σ(k = 1 to 3) k ≠ 5
    contradiction
    suppose Σ(k = 1 to 3) k = 5                                       (S)

    2.1.  6 = 5, which is impossible
          calculation
          6 = Σ(k = 1 to 3) k     1
            = 5                   S

theorem a-product-scaled
  note        Each of the |X| terms carries a factor 3, and the factors come
              out together as 3^|X|.
  let X ⊆ ℤ                                                           (H1)
  assume X is finite                                                  (H2)
  then ∏(x ∈ X) x·3 = 3^|X|·∏(x ∈ X) x

1.  ∏(x ∈ X) x·3 = 3^|X|·∏(x ∈ X) x
    thm:product-factor c := 3, from H1, H2

theorem a-product-scaled-cited
  note        The theorem above, cited over another set and another index
              letter.
  let Y ⊆ ℤ                                                           (H1)
  assume Y is finite                                                  (H2)
  then ∏(k ∈ Y) k·3 = 3^|Y|·∏(k ∈ Y) k

1.  ∏(k ∈ Y) k·3 = 3^|Y|·∏(k ∈ Y) k
    thm:a-product-scaled X := Y, from H1, H2

theorem a-product-over-a-range-worked-out
  then ∏(k = 1 to 4) k = 24

1.  ∏(k = 1 to 4) k = 24
    arithmetic

theorem a-product-over-a-range-split-at-its-last
  note        product-extended is stated over {a, …, n + 1}, and the range
              written from 1 to n + 1 is the same product.
  let n ∈ ℕ                                                           (H1)
  let t : {1, …, n + 1} → ℝ                                           (H2)
  then ∏(k = 1 to n + 1) t(k) = (∏(k = 1 to n) t(k))·t(n + 1)

1.  ∏(k = 1 to n + 1) t(k) = (∏(k = 1 to n) t(k))·t(n + 1)
    mun:product-extended a := 1
    requires n ≥ 1: from H1

theorem a-product-over-a-range-is-real
  let n ∈ ℕ                                                           (H1)
  let t : {1, …, n} → ℝ                                               (H2)
  then ∏(k = 1 to n) t(k) ∈ ℝ

1.  ∏(k = 1 to n) t(k) ∈ ℝ
    mun:product-real a := 1, b := n

theorem a-sum-over-a-range-written-as-a-set
  note        sum-extended is stated from a to n + 1, and the sum over the
              set {1, …, n + 1} is the same sum.
  let n ∈ ℕ                                                           (H1)
  let t : {1, …, n + 1} → ℝ                                           (H2)
  then Σ(k ∈ {1, …, n + 1}) t(k) = Σ(k ∈ {1, …, n}) t(k) + t(n + 1)

1.  Σ(k ∈ {1, …, n + 1}) t(k) = Σ(k ∈ {1, …, n}) t(k) + t(n + 1)
    mun:sum-extended a := 1
    requires n ≥ 1: from H1
