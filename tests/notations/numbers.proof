import definition         stdlib/numbers/abs
import definition         stdlib/numbers/sqrt
import definition         stdlib/numbers/rational
import definition         stdlib/numbers/irrational
import mundane theorem    stdlib/numbers/square-equal
import mundane theorem    stdlib/divisibility/mod-remainder

theorem two-cubed
  then 2³ = 8

1.  2³ = 8
    arithmetic

theorem two-to-the-tenth
  then 2¹⁰ = 1024

1.  2¹⁰ = 1024
    arithmetic

theorem a-fourth-power-of-a-square
  let x ∈ ℝ                                                           (H1)
  then x⁴ = (x²)²

1.  x⁴ = (x²)²
    algebra

theorem a-cube-multiplied-out
  let x ∈ ℝ                                                           (H1)
  then (x + 1)³ = x³ + 3·x² + 3·x + 1

1.  (x + 1)³ = x³ + 3·x² + 3·x + 1
    algebra

theorem seven-mod-three
  then 7 mod 3 = 1

1.  7 mod 3 = 1
    arithmetic

theorem seven-mod-three-not-two
  then 7 mod 3 ≠ 2

1.  7 mod 3 ≠ 2
    arithmetic

theorem minus-one-mod-five
  note        The remainder of a negative number is not negative: −1 is
              (−1)·5 + 4.
  then (−1) mod 5 = 4

1.  (−1)·5 + 4 = −1
    arithmetic

2.  There is q ∈ ℤ with q·5 + 4 = −1.
    exhibit, from 1

3.  (−1) mod 5 = 4
    mun:mod-remainder a := −1, m := 5, r := 4, from 2
    requires 4 < 5: arithmetic

theorem abs-minus-three
  then |−3| = 3

1.  −3 < 0
    arithmetic

2.  |−3| = −(−3)
    def:abs x := −3, from 1

3.  |−3| = 3
    calculation
    |−3| = −(−3)     2
         = 3         arithmetic

theorem abs-three
  then |3| = 3

1.  3 ≥ 0
    arithmetic

2.  |3| = 3
    def:abs x := 3, from 1

theorem sqrt-four
  note        √ is the root that is not negative: √4 is 2, not −2.
  then √4 = 2

1.  (√4)² = 4. √4 ≥ 0.
    def:sqrt x := 4
    requires 4 ≥ 0: arithmetic

2.  (√4)² = 2²
    calculation
    (√4)² = 4      1
          = 2²     arithmetic

3.  √4 = 2
    mun:square-equal x := √4, y := 2, from 2
    requires √4 ≥ 0: from 1
    requires 2 ≥ 0: arithmetic

theorem sqrt-four-not-irrational
  then not (√4 is irrational)

1.  √4 = 2
    thm:sqrt-four

2.  √4 = 2/1
    calculation
    √4 = 2       1
       = 2/1     arithmetic

3.  √4 ∈ ℚ
    def:rational x := √4, from 2

4.  not (√4 is irrational)
    contradiction
    suppose √4 is irrational                                          (S)

    4.1.  √4 ∉ ℚ
          def:irrational x := √4, from S, contradicting 3
