import theorem            proofs/wiedijk/fundamental-calculus/fundamental-calculus
import theorem            stdlib/calculus/continuous-linear
import theorem            stdlib/calculus/continuous-square
import theorem            stdlib/calculus/derivative-square
import definition         stdlib/calculus/interval
import mundane theorem    stdlib/calculus/interval-real
import mundane theorem    stdlib/calculus/open-within-closed
import mundane theorem    stdlib/calculus/open-interval-open
import mundane theorem    stdlib/sets/in-subset

theorem an-integral-of-a-line
  note        The area under 2t from 0 to 1 is 1: t² is an antiderivative,
              and 1² − 0² = 1.
  let f : [0, 1] → ℝ                                                  (H1)
  assume for all x ∈ [0, 1], f(x) = 2·x                               (H2)
  let F : [0, 1] → ℝ                                                  (H3)
  assume for all x ∈ [0, 1], F(x) = x²                                (H4)
  then ∫(0 to 1) f(t) dt = 1

1.  f is continuous on [0, 1]
    thm:continuous-linear D := [0, 1], m := 2, from H2
    requires [0, 1] ⊆ ℝ: mun:interval-real a := 0, b := 1

2.  F is continuous on [0, 1]
    thm:continuous-square D := [0, 1], from H4
    requires [0, 1] ⊆ ℝ: mun:interval-real a := 0, b := 1

3.  (0, 1) ⊆ [0, 1]
    mun:open-within-closed a := 0, b := 1

4.  F is differentiable on (0, 1). For all x ∈ (0, 1), F′(x) = 2x.
    thm:derivative-square D := [0, 1], U := (0, 1), from H4, 3
    requires [0, 1] ⊆ ℝ: mun:interval-real a := 0, b := 1
    requires (0, 1) is open: mun:open-interval-open a := 0, b := 1

5.  For all x ∈ (0, 1), F′(x) = f(x).
    proof
    let x ∈ (0, 1)                                                    (K1)

    5.1.  x ∈ [0, 1]
          mun:in-subset, from K1, 3

    5.2.  f(x) = 2·x
          instantiate x := x in H2, from 5.1

    5.3.  F′(x) = 2x
          instantiate x := x in line 4, from K1

    5.4.  F′(x) = f(x)
          calculation
          F′(x) = 2x       5.3
                = f(x)     5.2

6.  ∫(0 to 1) f(t) dt = F(1) − F(0)
    thm:fundamental-calculus a := 0, b := 1, from 1, 2, 4, 5
    requires 0 < 1: arithmetic

7.  1 ∈ [0, 1]
    def:interval a := 0, b := 1, x := 1
    requires 0 ≤ 1: arithmetic
    requires 1 ≤ 1: arithmetic

8.  0 ∈ [0, 1]
    def:interval a := 0, b := 1, x := 0
    requires 0 ≤ 0: arithmetic
    requires 0 ≤ 1: arithmetic

9.  F(1) = 1²
    instantiate x := 1 in H4, from 7

10. F(0) = 0²
    instantiate x := 0 in H4, from 8

11. ∫(0 to 1) f(t) dt = 1² − F(0)
    substitute F(1) = 1² (line 9) into line 6

12. ∫(0 to 1) f(t) dt = 1² − 0²
    substitute F(0) = 0² (line 10) into line 11

13. ∫(0 to 1) f(t) dt = 1
    calculation
    ∫(0 to 1) f(t) dt = 1² − 0²     12
                      = 1           arithmetic
