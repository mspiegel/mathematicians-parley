import theorem            stdlib/calculus/continuous-linear
import theorem            stdlib/calculus/derivative-linear
import theorem            stdlib/calculus/derivative-square
import mundane theorem    stdlib/sets/subset-self
import mundane theorem    stdlib/sets/subset-transitive
import mundane definition stdlib/calculus/interval
import mundane theorem    stdlib/calculus/interval-real
import mundane theorem    stdlib/calculus/open-within-closed
import mundane theorem    stdlib/calculus/open-interval-open
import mundane definition stdlib/calculus/upper-bound
import mundane definition stdlib/calculus/least-upper-bound
import definition         stdlib/calculus/tends-to
import theorem            stdlib/numbers/archimedean
import mundane theorem    stdlib/numbers/abs-difference-lt
import mundane theorem    stdlib/numbers/reciprocal-order
import mundane theorem    stdlib/numbers/reciprocal-positive
import definition         stdlib/calculus/limit-at
import mundane theorem    stdlib/functions/function-value

theorem a-line-tends-to-its-value
  note        2x + 1 is within ε of 3 wherever x is within ε/2 of 1.
  ε, δ range over ℝ
  let g : ℝ → ℝ                                                       (H1)
  assume for all x ∈ ℝ, g(x) = 2·x + 1                                (H2)
  then g tends to 3 at 1

1.  For all ε > 0, there exists δ > 0 such that |g(x) − 3| < ε for all x ∈ ℝ with (x ≠ 1 and |x − 1| < δ).
    proof
    let ε ∈ ℝ                                                         (K1)
    assume ε > 0                                                      (A1)

    1.1.  ε/2 > 0
          inequalities
            ε > 0            A1
            ε/2 > 0          multiplying by 1/2

    1.2.  For all x ∈ ℝ with (x ≠ 1 and |x − 1| < ε/2), |g(x) − 3| < ε.
          proof
          let x ∈ ℝ                                                   (K2)
          assume x ≠ 1 and |x − 1| < ε/2                              (A2)

          1.2.1.  g(x) = 2·x + 1
                  instantiate x := x in H2

          1.2.2.  1 − ε/2 < x and x < 1 + ε/2
                  mun:abs-difference-lt c := 1, δ := ε/2, from A2

          1.2.3.  1 − ε/2 < x
                  inequalities, from 1.2.2

          1.2.4.  x < 1 + ε/2
                  inequalities, from 1.2.2

          1.2.5.  3 − ε < 2·x + 1
                  inequalities
                    1 − ε/2 < x              1.2.3
                    2 − ε < 2·x              multiplying by 2
                    3 − ε < 2·x + 1          adding 1

          1.2.6.  3 − ε < g(x)
                  transitivity, from 1.2.5, 1.2.1

          1.2.7.  2·x + 1 < 3 + ε
                  inequalities
                    x < 1 + ε/2              1.2.4
                    2·x < 2 + ε              multiplying by 2
                    2·x + 1 < 3 + ε          adding 1

          1.2.8.  g(x) < 3 + ε
                  transitivity, from 1.2.1, 1.2.7

          1.2.9.  3 − ε < g(x) and g(x) < 3 + ε
                  join 1.2.6, 1.2.8

          1.2.10. |g(x) − 3| < ε
                  mun:abs-difference-lt x := g(x), c := 3, δ := ε, from 1.2.9
                  requires g(x) ∈ ℝ: mun:function-value f := g

    1.3.  There exists δ > 0 such that |g(x) − 3| < ε for all x ∈ ℝ with (x ≠ 1 and |x − 1| < δ).
          exhibit, from 1.1, 1.2

2.  g tends to 3 at 1
    def:limit-at D := ℝ, c := 1, L := 3, from 1
    requires ℝ ⊆ ℝ: mun:subset-self

theorem a-line-is-continuous
  let g : [0, 1] → ℝ                                                  (H1)
  assume for all x ∈ [0, 1], g(x) = 2·x                               (H2)
  then g is continuous on [0, 1]

1.  g is continuous on [0, 1]
    thm:continuous-linear D := [0, 1], m := 2, from H2
    requires [0, 1] ⊆ ℝ: mun:interval-real a := 0, b := 1

theorem a-line-is-differentiable
  let g : [0, 1] → ℝ                                                  (H1)
  assume for all x ∈ [0, 1], g(x) = 2·x                               (H2)
  then g is differentiable on (0, 1)

1.  g is differentiable on (0, 1)
    thm:derivative-linear D := [0, 1], U := (0, 1), m := 2, from H2
    requires [0, 1] ⊆ ℝ: mun:interval-real a := 0, b := 1
    requires (0, 1) ⊆ [0, 1]: mun:open-within-closed a := 0, b := 1
    requires (0, 1) is open: mun:open-interval-open a := 0, b := 1

theorem the-slope-of-a-line
  note        The derivative of 2x is 2 at every point.
  let g : [0, 1] → ℝ                                                  (H1)
  assume for all x ∈ [0, 1], g(x) = 2·x                               (H2)
  then for all x ∈ (0, 1), g′(x) = 2

1.  For all x ∈ (0, 1), g′(x) = 2.
    thm:derivative-linear D := [0, 1], U := (0, 1), m := 2, from H2
    requires [0, 1] ⊆ ℝ: mun:interval-real a := 0, b := 1
    requires (0, 1) ⊆ [0, 1]: mun:open-within-closed a := 0, b := 1
    requires (0, 1) is open: mun:open-interval-open a := 0, b := 1

theorem a-square-is-differentiable
  note        x² on the whole line is differentiable on (0, 1), though its
              derivative is defined beyond (0, 1) too: "differentiable on"
              says the derivative exists at every point of the set, not that
              the set is where it exists.
  let g : ℝ → ℝ                                                       (H1)
  assume for all x ∈ ℝ, g(x) = x²                                     (H2)
  then g is differentiable on (0, 1)

1.  g is differentiable on (0, 1)
    thm:derivative-square D := ℝ, U := (0, 1), from H2
    requires ℝ ⊆ ℝ: mun:subset-self
    requires (0, 1) ⊆ [0, 1]: mun:open-within-closed a := 0, b := 1
    requires [0, 1] ⊆ ℝ: mun:interval-real a := 0, b := 1
    requires (0, 1) ⊆ ℝ: mun:subset-transitive
    requires (0, 1) is open: mun:open-interval-open a := 0, b := 1

theorem the-slope-of-a-square
  let g : ℝ → ℝ                                                       (H1)
  assume for all x ∈ ℝ, g(x) = x²                                     (H2)
  then for all x ∈ (0, 1), g′(x) = 2x

1.  For all x ∈ (0, 1), g′(x) = 2x.
    thm:derivative-square D := ℝ, U := (0, 1), from H2
    requires ℝ ⊆ ℝ: mun:subset-self
    requires (0, 1) ⊆ [0, 1]: mun:open-within-closed a := 0, b := 1
    requires [0, 1] ⊆ ℝ: mun:interval-real a := 0, b := 1
    requires (0, 1) ⊆ ℝ: mun:subset-transitive
    requires (0, 1) is open: mun:open-interval-open a := 0, b := 1

theorem one-bounds-the-unit-interval
  then 1 is an upper bound of [0, 1]

1.  For all s ∈ [0, 1], s ≤ 1.
    proof
    let s ∈ [0, 1]                                                    (K1)

    1.1.  s ≤ 1
          mun:interval a := 0, b := 1, x := s, from K1

2.  1 is an upper bound of [0, 1]
    mun:upper-bound u := 1, S := [0, 1], from 1

theorem one-is-in-the-unit-interval
  then 1 ∈ [0, 1]

1.  1 ∈ [0, 1]
    mun:interval a := 0, b := 1, x := 1
    requires 0 ≤ 1: arithmetic
    requires 1 ≤ 1: arithmetic

theorem a-half-does-not-bound-the-unit-interval
  then not (1/2 is an upper bound of [0, 1])

1.  1 ∈ [0, 1]
    thm:one-is-in-the-unit-interval

2.  not (1/2 is an upper bound of [0, 1])
    contradiction
    suppose 1/2 is an upper bound of [0, 1]                           (S)

    2.1.  For all s ∈ [0, 1], s ≤ 1/2.
          mun:upper-bound u := 1/2, S := [0, 1], from S

    2.2.  1 ≤ 1/2, which is impossible
          instantiate s := 1 in line 2.1, from 1

theorem an-upper-bound-cited
  note        "Is an upper bound of" says "for all" only in set.mm's words, so
              a step claiming it cites a theorem that states it whole.
  then 1 is an upper bound of [0, 1]

1.  1 is an upper bound of [0, 1]
    thm:one-bounds-the-unit-interval

theorem one-is-the-least-bound-of-the-unit-interval
  then 1 is a least upper bound of [0, 1]

1.  1 is an upper bound of [0, 1]
    thm:one-bounds-the-unit-interval

2.  1 ∈ [0, 1]
    thm:one-is-in-the-unit-interval

3.  For all u ∈ ℝ, if u is an upper bound of [0, 1] then 1 ≤ u.
    proof
    let u ∈ ℝ                                                         (K1)
    assume u is an upper bound of [0, 1]                              (A1)

    3.1.  For all s ∈ [0, 1], s ≤ u.
          mun:upper-bound S := [0, 1], from A1

    3.2.  1 ≤ u
          instantiate s := 1 in line 3.1, from 2

4.  1 is an upper bound of [0, 1], and for all u ∈ ℝ, if u is an upper
    bound of [0, 1] then 1 ≤ u.
    join 1, 3

5.  1 is a least upper bound of [0, 1]
    mun:least-upper-bound c := 1, S := [0, 1], from 4

theorem one-over-n-tends-to-zero
  ε ranges over ℝ
  n ranges over ℕ
  then 1/n → 0 as n → ∞

1.  For all ε > 0, there exists N ∈ ℕ such that |1/n − 0| < ε for all n ≥ N.
    proof
    let ε ∈ ℝ                                                         (K1)
    assume ε > 0                                                      (A1)

    1.1.  N ∈ ℕ. 1/N < ε.
          obtain N: thm:archimedean x := ε, from A1

    1.2.  For all n ≥ N, |1/n − 0| < ε.
          proof
          let n ∈ ℕ                                                   (K2)
          assume n ≥ N                                                (A2)

          1.2.1.  1/n ≤ 1/N
                  mun:reciprocal-order x := N, y := n, from A2
                  requires N > 0: inequalities, from 1.1
                  requires n > 0: inequalities, from K2

          1.2.2.  1/n > 0
                  mun:reciprocal-positive x := n
                  requires n > 0: inequalities, from K2

          1.2.3.  0 − ε < 0
                  inequalities
                    ε > 0            A1
                    0 − ε < 0        multiplying by −1

          1.2.4.  0 − ε < 1/n
                  transitivity, from 1.2.3, 1.2.2

          1.2.5.  1/N < ε
                  inequalities, from 1.1

          1.2.6.  1/n < 0 + ε
                  transitivity, from 1.2.1, 1.2.5

          1.2.7.  |1/n − 0| < ε
                  mun:abs-difference-lt x := 1/n, c := 0, δ := ε, from 1.2.4, 1.2.6

    1.3.  There exists N ∈ ℕ such that |1/n − 0| < ε for all n ≥ N.
          exhibit, from 1.2

2.  For all n ∈ ℕ, 1/n ∈ ℝ.
    proof
    let n ∈ ℕ                                                         (K3)

    2.1.  1/n ∈ ℝ
          membership

3.  1/n → 0 as n → ∞
    def:tends-to L := 0, from 1, 2

theorem one-over-n-does-not-tend-to-one
  ε ranges over ℝ
  n ranges over ℕ
  then not (1/n → 1 as n → ∞)

1.  For all n ∈ ℕ, 1/n ∈ ℝ.
    proof
    let n ∈ ℕ                                                         (K1)

    1.1.  1/n ∈ ℝ
          membership

2.  not (1/n → 1 as n → ∞)
    contradiction
    suppose 1/n → 1 as n → ∞                                          (S)

    2.1.  For all ε > 0, there exists N ∈ ℕ such that |1/n − 1| < ε for all n ≥ N.
          def:tends-to L := 1, from S, 1

    2.2.  There exists N ∈ ℕ such that |1/n − 1| < 1/2 for all n ≥ N.
          instantiate ε := 1/2 in line 2.1
          requires 0 < 1/2: arithmetic

    2.3.  N ∈ ℕ. |1/n − 1| < 1/2 for all n ≥ N.
          obtain N from line 2.2

    2.4.  |1/(N + 1) − 1| < 1/2
          instantiate n := N + 1 in line 2.3
          requires N + 1 ≥ N: inequalities

    2.5.  N + 1 > 0
          inequalities, from 2.3

    2.6.  1 − 1/2 < 1/(N + 1) and 1/(N + 1) < 1 + 1/2
          mun:abs-difference-lt x := 1/(N + 1), c := 1, δ := 1/2, from 2.4

    2.7.  2 ≤ N + 1
          inequalities, from 2.3

    2.8.  1/(N + 1) ≤ 1/2
          mun:reciprocal-order x := 2, y := N + 1, from 2.7
          requires 2 > 0: arithmetic
          requires N + 1 > 0: from 2.5

    2.9.  not (1/(N + 1) ≤ 1/2)
          inequalities, from 2.6, contradicting 2.8
