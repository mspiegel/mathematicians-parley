import mundane definition stdlib/functions/one-to-one
import mundane definition stdlib/functions/onto
import mundane definition stdlib/functions/one-to-one-onto
import mundane theorem    stdlib/functions/function-into
import mundane theorem    stdlib/functions/function-value
import mundane theorem    stdlib/numbers/square-nonneg
import mundane theorem    stdlib/functions/value-in-image
import mundane theorem    stdlib/functions/inverse-value
import mundane theorem    stdlib/sets/pair-subset

theorem a-value-of-a-line
  note        f(3) is f applied to 3, read off the rule that defines f: it is
              not f times 3.
  let f(x) = 2·x + 1, for x ∈ ℝ                                       (D1)
         reads double and add one
  then f(3) = 7

1.  f(3) = 2·3 + 1
    D1

2.  f(3) = 7
    calculation
    f(3) = 2·3 + 1     1
         = 7           arithmetic

theorem a-line-is-one-to-one
  note        2s + 1 = 2t + 1 only where s = t, so no two numbers go to one
              place.
  let f(x) = 2·x + 1, for x ∈ ℝ                                       (D1)
         reads double and add one
  then f : ℝ → ℝ is one-to-one

1.  f : ℝ → ℝ
    mun:function-into
    requires f is a function on ℝ: from D1
    requires for all x ∈ ℝ, f(x) ∈ ℝ: membership, from D1

2.  For all s, t ∈ ℝ, if f(s) = f(t) then s = t.
    proof
    let s ∈ ℝ                                                         (K1)
    let t ∈ ℝ                                                         (K2)
    assume f(s) = f(t)                                                (A1)

    2.1.  f(s) = 2·s + 1
          D1

    2.2.  f(t) = 2·t + 1
          D1

    2.3.  2·s + 1 = 2·t + 1
          calculation
          2·s + 1 = f(s)          2.1
                  = f(t)          A1
                  = 2·t + 1       2.2

    2.4.  s = t
          algebra, from 2.3

3.  f : ℝ → ℝ is one-to-one
    mun:one-to-one, from 1, 2

theorem a-line-is-onto
  note        Every real y is 2x + 1 at x = (y − 1)/2, so the line reaches
              every point.
  let f(x) = 2·x + 1, for x ∈ ℝ                                       (D1)
         reads double and add one
  then f : ℝ → ℝ is onto

1.  f : ℝ → ℝ
    mun:function-into
    requires f is a function on ℝ: from D1
    requires for all x ∈ ℝ, f(x) ∈ ℝ: membership, from D1

2.  For all y ∈ ℝ, there is x ∈ ℝ with y = f(x).
    proof
    let y ∈ ℝ                                                         (K1)

    2.1.  f((y − 1)/2) = 2·((y − 1)/2) + 1
          D1

    2.2.  y = f((y − 1)/2)
          algebra, from 2.1
          requires f((y − 1)/2) ∈ ℝ: from 1

    2.3.  There is x ∈ ℝ with y = f(x).
          exhibit, from 2.2

3.  f : ℝ → ℝ is onto
    mun:onto, from 1, 2

theorem a-line-is-one-to-one-and-onto
  note        2x + 1 sends no two numbers to one place and reaches every
              real, so it pairs ℝ off against itself.
  let f(x) = 2·x + 1, for x ∈ ℝ                                       (D1)
         reads double and add one
  then f : ℝ → ℝ is one-to-one and onto

1.  f : ℝ → ℝ
    mun:function-into
    requires f is a function on ℝ: from D1
    requires for all x ∈ ℝ, f(x) ∈ ℝ: membership, from D1

2.  For all s, t ∈ ℝ, if f(s) = f(t) then s = t.
    proof
    let s ∈ ℝ                                                         (K1)
    let t ∈ ℝ                                                         (K2)
    assume f(s) = f(t)                                                (A1)

    2.1.  2·s + 1 = 2·t + 1
          calculation
          2·s + 1 = f(s)          D1
                  = f(t)          A1
                  = 2·t + 1       D1

    2.2.  s = t
          algebra, from 2.1

3.  For all y ∈ ℝ, there is x ∈ ℝ with y = f(x).
    proof
    let y ∈ ℝ                                                         (K3)

    3.1.  f((y − 1)/2) = 2·((y − 1)/2) + 1
          D1

    3.2.  y = f((y − 1)/2)
          algebra, from 3.1
          requires f((y − 1)/2) ∈ ℝ: from 1

    3.3.  There is x ∈ ℝ with y = f(x).
          exhibit, from 3.2

4.  f : ℝ → ℝ is one-to-one
    mun:one-to-one, from 1, 2

5.  f : ℝ → ℝ is onto
    mun:onto, from 1, 3

6.  f : ℝ → ℝ is one-to-one and onto
    mun:one-to-one-onto, from 4, 5

theorem a-bijection-is-onto
  note        A function one-to-one and onto is onto: the definition read
              from the let that says it.
  let A be a set                                                      (H1)
  let B be a set                                                      (H2)
  let f : A → B be one-to-one and onto                                (H3)
  then f : A → B is onto

1.  f : A → B is onto
    mun:one-to-one-onto, from H3

theorem an-onto-function-reaches-a-point
  note        A function onto B sends something to each point of B: the
              definition read from the let that says it.
  let A be a set                                                      (H1)
  let B be a set                                                      (H2)
  let f : A → B be onto                                               (H3)
  let y ∈ B                                                           (H4)
  then there is x ∈ A with y = f(x)

1.  For all y ∈ B, there is x ∈ A with y = f(x).
    mun:onto, from H3

2.  There is x ∈ A with y = f(x).
    instantiate y := y in line 1, from H4

theorem an-onto-function-has-its-values
  note        A function onto B is a function into B, so its values lie in
              B.
  let A be a set                                                      (H1)
  let B be a set                                                      (H2)
  let f : A → B be onto                                               (H3)
  let x ∈ A                                                           (H4)
  then f(x) ∈ B

1.  f(x) ∈ B
    mun:function-value, from H4

theorem a-value-in-an-image
  note        f[{1, 2}] is the set f sends {1, 2} to, and f(1) = 3 is in it.
  let f : ℝ → ℝ                                                       (H1)
  assume for all x ∈ ℝ, f(x) = 2·x + 1                                (H2)
  then 3 ∈ f[{1, 2}]

1.  1 ∈ {1, 2}
    inspection

2.  {1, 2} ⊆ ℝ
    mun:pair-subset a := 1, b := 2, X := ℝ

3.  f(1) ∈ f[{1, 2}]
    mun:value-in-image, from 1, 2

4.  f(1) = 2·1 + 1
    instantiate x := 1 in H2

5.  f(1) = 3
    calculation
    f(1) = 2·1 + 1     4
         = 3           arithmetic

6.  3 ∈ f[{1, 2}]
    substitute f(1) = 3 (line 5) into line 3

theorem an-inverse-value
  note        f⁻¹ takes each value of f back to where it came from: 7 came
              from 3.
  let f : ℝ → ℝ be one-to-one                                         (H1)
  assume for all x ∈ ℝ, f(x) = 2·x + 1                                (H2)
  then f⁻¹(7) = 3

1.  f⁻¹(f(3)) = 3
    mun:inverse-value, from H1

2.  f(3) = 2·3 + 1
    instantiate x := 3 in H2

3.  f(3) = 7
    calculation
    f(3) = 2·3 + 1     2
         = 7           arithmetic

4.  f⁻¹(7) = 3
    substitute f(3) = 7 (line 3) into line 1

theorem a-square-is-not-one-to-one
  note        −1 and 1 have one square, so x² sends two numbers to one place.
  let f(x) = x², for x ∈ ℝ                                            (D1)
         reads the square
  then not (f : ℝ → ℝ is one-to-one)

1.  f(−1) = (−1)²
    D1

2.  f(1) = 1²
    D1

3.  f(−1) = f(1)
    calculation
    f(−1) = (−1)²     1
          = 1²        arithmetic
          = f(1)      2

4.  not (f : ℝ → ℝ is one-to-one)
    contradiction
    suppose f : ℝ → ℝ is one-to-one                                   (S)

    4.1.  For all s, t ∈ ℝ, if f(s) = f(t) then s = t.
          mun:one-to-one, from S

    4.2.  −1 = 1, which is impossible
          instantiate s := −1, t := 1 in line 4.1, from 3

theorem a-square-is-not-onto
  note        No square is −1, so x² does not reach every real.
  let f(x) = x², for x ∈ ℝ                                            (D1)
         reads the square
  then not (f : ℝ → ℝ is onto)

1.  not (f : ℝ → ℝ is onto)
    contradiction
    suppose f : ℝ → ℝ is onto                                         (S)

    1.1.  For all y ∈ ℝ, there is x ∈ ℝ with y = f(x).
          mun:onto, from S

    1.2.  There is x ∈ ℝ with −1 = f(x).
          instantiate y := −1 in line 1.1

    1.3.  x ∈ ℝ. −1 = f(x).
          obtain x from line 1.2

    1.4.  f(x) = x²
          D1

    1.5.  x² ≥ 0
          mun:square-nonneg

    1.6.  −1 = x²
          calculation
          −1 = f(x)     1.3
             = x²       1.4

    1.7.  −1 ≥ 0, which is impossible
          substitute −1 = x² (line 1.6) into line 1.5
