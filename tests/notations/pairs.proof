import mundane theorem stdlib/sets/pair-parts-equal

theorem a-function-on-pairs
  note        f(x, y) applies a function on pairs to the pair of x and y, as
              f((x, y)) would.
  let f : ℝ × ℝ → ℝ                                                   (H1)
  assume for all x, y ∈ ℝ, f(x, y) = x + y                            (H2)
  then f(1, 2) = 3

1.  f(1, 2) = 1 + 2
    instantiate x := 1, y := 2 in H2

2.  f(1, 2) = 3
    calculation
      f(1, 2) = 1 + 2      1
              = 3          arithmetic

theorem an-interval-and-a-pair
  note        The same brackets name an interval where a set is wanted and a
              pair elsewhere.
  let x ∈ ℝ                                                           (H1)
  assume x ∈ (0, 1)                                                   (H2)
  assume (x, 2) = (1, 2)                                              (H3)
  then x = 1

1.  x = 1 and 2 = 2
    mun:pair-parts-equal, from H3

2.  x = 1
    join 1

theorem a-point-by-its-coordinates
  note        Where a point is wanted the same brackets name the point with
              those coordinates: beside the point A, and as an end of a
              distance.
  let A ∈ 𝔼²                                                          (H1)
  let B ∈ 𝔼²                                                          (H2)
  assume A = (1, 2)                                                   (H3)
  assume |AB| = 3                                                     (H4)
  then |(1, 2)B| = 3

1.  |(1, 2)B| = 3
    substitute A = (1, 2) (H3) into H4
