import definition         stdlib/divisibility/divides
import definition         stdlib/divisibility/odd
import definition         stdlib/divisibility/congruent-mod
import mundane theorem    stdlib/divisibility/zero-divides
import mundane theorem    stdlib/reasoning/iff-not-from-right

theorem three-divides-twelve
  then 3 divides 12

1.  3 divides 12
    arithmetic

theorem five-divides-zero
  then 5 divides 0

1.  5 divides 0
    arithmetic

theorem zero-does-not-divide-five
  then not (0 divides 5)

1.  0 divides 5 ↔ 5 = 0
    mun:zero-divides n := 5

2.  5 ≠ 0
    arithmetic

3.  not (0 divides 5)
    mun:iff-not-from-right, from 1, 2

theorem two-does-not-divide-seven
  then not (2 divides 7)

1.  not (2 divides 7)
    arithmetic

theorem zero-is-even
  then 0 is even

1.  0 is even
    arithmetic

theorem minus-three-is-odd
  then −3 is odd

1.  −3 = 2·(−2) + 1
    arithmetic

2.  −3 is odd
    def:odd n := −3, from 1

theorem one-is-not-even
  then not (1 is even)

1.  not (1 is even)
    arithmetic

theorem seventeen-two-mod-five
  then 17 ≡ 2 (mod 5)

1.  17 ≡ 2 (mod 5)
    arithmetic

theorem minus-one-four-mod-five
  then −1 ≡ 4 (mod 5)

1.  −1 − 4 = 5·(−1)
    arithmetic

2.  5 divides −1 − 4
    def:divides d := 5, n := −1 − 4, from 1

3.  −1 ≡ 4 (mod 5)
    def:congruent-mod n := 5, a := −1, b := 4, from 2

theorem seventeen-not-three-mod-five
  then not (17 ≡ 3 (mod 5))

1.  not (17 ≡ 3 (mod 5))
    arithmetic
