import mundane definition stdlib/sets/union
import mundane definition stdlib/sets/intersection
import mundane definition stdlib/sets/set-builder
import mundane definition stdlib/sets/powerset
import mundane definition stdlib/sets/pair
import mundane definition stdlib/sets/singleton
import mundane theorem    stdlib/sets/singleton-subset
import mundane theorem    stdlib/sets/listed-repeat
import mundane theorem    stdlib/sets/powerset-empty
import mundane theorem    stdlib/counting/card-singleton
import mundane theorem    stdlib/counting/card-pair-distinct
import mundane theorem    stdlib/reasoning/or-left
import mundane theorem    stdlib/reasoning/or-right
import mundane theorem    stdlib/reasoning/disjunctive-syllogism

theorem two-in-a-listed-set
  let S = {1, 2, 3}                                                   (D1)
      reads the numbers from 1 to 3
  then 2 ∈ S

1.  2 ∈ S
    inspection, from D1

theorem four-not-in-a-listed-set
  let S = {1, 2, 3}                                                   (D1)
      reads the numbers from 1 to 3
  then 4 ∉ S

1.  4 ∉ S
    inspection, from D1

theorem a-repeat-counts-once
  note        A list names each element once however often it is written.
  then |{1, 2, 2}| = 2

1.  {1, 2, 2} = {1, 2}
    mun:listed-repeat a := 1, b := 2

2.  1 ≠ 2
    arithmetic

3.  |{1, 2}| = 2
    mun:card-pair-distinct u := 1, w := 2, from 2

4.  |{1, 2, 2}| = 2
    substitute {1, 2} = {1, 2, 2} (line 1) into line 3

theorem a-pair-counted
  then |{1, 2}| = 2

1.  |{1, 2}| = 2
    inspection

theorem four-not-in-a-written-set
  then 4 ∉ {1, 2, 3}

1.  4 ∉ {1, 2, 3}
    inspection

theorem in-a-union
  then 3 ∈ {1, 2} ∪ {3}

1.  3 ∈ {3}
    mun:singleton x := 3, a := 3

2.  3 ∈ {1, 2} or 3 ∈ {3}
    mun:or-right, from 1

3.  3 ∈ {1, 2} ∪ {3}
    mun:union, from 2

theorem not-in-an-intersection
  then 3 ∉ {1, 2} ∩ {3}

1.  3 ≠ 1
    arithmetic

2.  3 ≠ 2
    arithmetic

3.  3 ∉ {1, 2}
    contradiction
    suppose 3 ∈ {1, 2}                                                (S)

    3.1.  3 = 1 or 3 = 2
          mun:pair x := 3, u := 1, w := 2, from S

    3.2.  3 = 1
          mun:disjunctive-syllogism, from 2, 3.1, contradicting 1

4.  3 ∉ {1, 2} ∩ {3}
    contradiction
    suppose 3 ∈ {1, 2} ∩ {3}                                          (S)

    4.1.  3 ∈ {1, 2}
          mun:intersection, from S, contradicting 3

theorem a-part-of-a-set
  then {1} ∈ 𝒫{1, 2}

1.  1 = 1
    arithmetic

2.  1 = 1 or 1 = 2
    mun:or-left, from 1

3.  1 ∈ {1, 2}
    mun:pair x := 1, u := 1, w := 2, from 2

4.  {1} ⊆ {1, 2}
    mun:singleton-subset a := 1, X := {1, 2}, from 3

5.  {1} ∈ 𝒫{1, 2}
    mun:powerset, from 4

theorem power-set-of-empty-has-one-member
  note        The empty set has one part, itself: 𝒫∅ is not empty.
  then |𝒫∅| = 1

1.  𝒫∅ = {∅}
    mun:powerset-empty

2.  |{∅}| = 1
    mun:card-singleton x := ∅

3.  |𝒫∅| = 1
    substitute 𝒫∅ = {∅} (line 1) into line 2

theorem even-in-the-evens
  let E = {x ∈ ℕ : x is even}                                         (D1)
      reads the even natural numbers
  then 4 ∈ E

1.  4 is even
    arithmetic

2.  4 ∈ E
    mun:set-builder u := 4, from D1, 1

theorem odd-not-in-the-evens
  let E = {x ∈ ℕ : x is even}                                         (D1)
      reads the even natural numbers
  then 3 ∉ E

1.  not (3 is even)
    arithmetic

2.  3 ∉ E
    contradiction
    suppose 3 ∈ E                                                     (S)

    2.1.  3 is even
          mun:set-builder u := 3, from D1, S, contradicting 1
