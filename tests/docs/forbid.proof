import theorem            stdlib/geometry/side-side-side
import axiom              stdlib/geometry/side-angle-side
forbid theorem            stdlib/geometry/law-of-cosines
forbid theorem            stdlib/geometry/law-of-sines

theorem congruent-by-sides
  note        GRAMMAR.md's forbids, kept: the file imports neither law.
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  let D be a point                                                    (H4)
  let E be a point                                                    (H5)
  let F be a point                                                    (H6)
  assume A, B, C form a triangle                                      (H7)
  assume D, E, F form a triangle                                      (H8)
  assume |AB| = |DE|                                                  (H9)
  assume |BC| = |EF|                                                  (H10)
  assume |CA| = |FD|                                                  (H11)
  then triangle ABC ≅ triangle DEF

1.  triangle ABC ≅ triangle DEF
    thm:side-side-side, from H7, H8, H9, H10, H11

theorem congruent-by-an-angle
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  let D be a point                                                    (H4)
  let E be a point                                                    (H5)
  let F be a point                                                    (H6)
  assume A, B, C form a triangle                                      (H7)
  assume D, E, F form a triangle                                      (H8)
  assume |AB| = |DE|                                                  (H9)
  assume ∠ABC = ∠DEF                                                  (H10)
  assume |BC| = |EF|                                                  (H11)
  then triangle ABC ≅ triangle DEF

1.  triangle ABC ≅ triangle DEF
    axi:side-angle-side P := A, Q := B, R := C, P′ := D, Q′ := E, R′ := F,
      from H7, H8, H9, H10, H11
