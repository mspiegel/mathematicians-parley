import definition         stdlib/counting/C
import mundane theorem    stdlib/counting/binomial-nat0

theorem a-range-member-is-cited
  note        A letter introduced in a range is an integer as a letter introduced in ℤ is: k ∈ {0, …, N} says k ∈ ℤ once, and no line writes it.
  let N ∈ ℕ₀    (H1)
  let k ∈ {0, …, N}    (H2)
  then C(N, k)·1 = C(N, k)

1.  C(N, k)·1 = C(N, k)
    algebra
    requires C(N, k) ∈ ℕ₀: mun:binomial-nat0
