import mundane definition stdlib/functions/one-to-one

theorem a-cited-codomain
  note        The line the step cites types F into C, and fixes the codomain over F's let, which says {B}.
  let A be a set    (H1)
  let C be a set    (H2)
  let B be an element    (H3)
  let F : A → {B}    (H4)
  then F : A → C is one-to-one → (for all s, t ∈ A, if F(s) = F(t) then s = t)

1.  F : A → C is one-to-one → (for all s, t ∈ A, if F(s) = F(t) then s = t)
    proof
    assume F : A → C is one-to-one    (S)

    1.1.  For all s, t ∈ A, if F(s) = F(t) then s = t.
          mun:one-to-one f := F, from S
