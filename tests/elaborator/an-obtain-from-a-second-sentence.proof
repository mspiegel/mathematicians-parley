theorem four-positive-and-even
  note        A statement of two sentences whose "there is" is the second.
  then 4 > 0. There is k ∈ ℤ with 4 = 2k.

1.  4 = 2·2
    arithmetic

2.  There is k ∈ ℤ with 4 = 2k.
    exhibit, from 1

3.  4 > 0
    arithmetic

4.  4 > 0. There is k ∈ ℤ with 4 = 2k.
    join 3, 2

theorem an-obtain-from-a-second-sentence
  note        An obtain takes its "there is" from the sentence of the cited
              statement the checker finds it in, here the second, and not
              from the statement read as one formula.
  then there is j ∈ ℤ with 4 = 2j

1.  j ∈ ℤ. 4 = 2j.
    obtain j: thm:four-positive-and-even

2.  There is j ∈ ℤ with 4 = 2j.
    exhibit, from 1
