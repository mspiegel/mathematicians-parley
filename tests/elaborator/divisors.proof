theorem a-product-written-not-zero
  note        The page says x·y ≠ 0 and nothing of x or y alone.
  let x ∈ ℝ    (H1)
  let y ∈ ℝ    (H2)
  assume x·y ≠ 0    (H3)
  then (2·x·y + 3)/(x·y) = 2 + 3/(x·y)

1.  (2·x·y + 3)/(x·y) = 2 + 3/(x·y)
    algebra
    requires x·y ≠ 0: from H3

theorem each-factor-by-its-requires-line
  note        Each factor's line restated by a requires line, which the step takes.
  let x ∈ ℝ    (H1)
  let y ∈ ℝ    (H2)
  assume x ≠ 0    (H3)
  assume y ≠ 0    (H4)
  then (2·x·y + 3)/(x·y) = 2 + 3/(x·y)

1.  (2·x·y + 3)/(x·y) = 2 + 3/(x·y)
    algebra
    requires x ≠ 0: from H3
    requires y ≠ 0: from H4

theorem a-square-made-ten-times
  note        x² ≠ 0 written; 1/10 makes the denominator 10·x².
  let x ∈ ℝ    (H1)
  let z ∈ ℝ    (H2)
  assume x^2 ≠ 0    (H3)
  then (1/10·x^3 + z)/x^2 = (1/10·x^3 + z)/x^2

1.  (1/10·x^3 + z)/x^2 = (1/10·x^3 + z)/x^2
    algebra
    requires x^2 ≠ 0: from H3

theorem divided-by-a-half
  note        x/2 ≠ 0 written, and a/(x/2) is 2·a/x.
  let x ∈ ℝ    (H1)
  assume x/2 ≠ 0    (H2)
  then 3/(x/2) = 6/x

1.  3/(x/2) = 6/x
    algebra
    requires x/2 ≠ 0: from H2

theorem a-multiplier-over-the-divisor
  note        The claim is the cited equation times x/(x + 3), and both sides are multiplied by x + 3.
  let x ∈ ℝ    (H1)
  let y ∈ ℝ    (H2)
  assume y = 1    (H3)
  assume x + 3 ≠ 0    (H4)
  then (x·y)/(x + 3) + 1 = x/(x + 3) + y

1.  (x·y)/(x + 3) + 1 = x/(x + 3) + y
    algebra, from H3
    requires x + 3 ≠ 0: from H4
