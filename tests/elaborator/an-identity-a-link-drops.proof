import definition         stdlib/counting/C
import mundane theorem    stdlib/counting/binomial-nat0

theorem an-identity-a-link-drops
  note        A link that drops 1 from C(N, k) drops it from a number, which a requires line of the calculation says.
  let N ∈ ℕ₀    (H1)
  let k ∈ ℤ    (H2)
  assume C(N, k)·1^k = C(N, k)·1    (H3)
  then C(N, k)·1^k = C(N, k)

1.  C(N, k)·1^k = C(N, k)
    calculation
      C(N, k)·1^k = C(N, k)     H3
    requires C(N, k) ∈ ℕ₀: mun:binomial-nat0
