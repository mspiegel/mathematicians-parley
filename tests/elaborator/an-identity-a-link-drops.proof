theorem an-identity-a-link-drops
  note        A link that drops 1 from b(k) drops it from a number, which a requires line of the calculation says.
  let b : ℤ → ℝ    (H1)
  let k ∈ ℤ    (H2)
  assume b(k)·1^k = b(k)·1    (H3)
  then b(k)·1^k = b(k)

1.  b(k)·1^k = b(k)
    calculation
      b(k)·1^k = b(k)     H3
    requires b(k) ∈ ℝ: from H1
