import definition         stdlib/counting/factorial
import mundane theorem stdlib/counting/factorial-nat
import theorem            stdlib/divisibility/divides-gcd
import definition         stdlib/divisibility/gcd

theorem a-membership-from-lines-together
  note        A bare `from` gives a membership the lines it names give
              together, as `membership` would build it: (k + 1)! ∈ ℝ from
              k! ∈ ℕ and (k + 1)! = k!·(k + 1).
  let k ∈ ℕ                                                           (H1)
  let y ∈ ℝ                                                           (H2)
  assume y ≤ (k + 1)!                                                 (H3)
  assume (k + 1)! ≤ 3                                                 (H4)
  then y ≤ 3

1.  k! ∈ ℕ
    mun:factorial-nat n := k

2.  (k + 1)! = k!·(k + 1)
    def:factorial n := k

3.  y ≤ 3
    transitivity, from H3, H4
    requires (k + 1)! ∈ ℝ: from 1, 2

theorem a-product-membership-from-a-line
  note        c·gcd(a, b) ∈ ℤ from the line gcd(a, b) ∈ ℕ, c let into ℤ.
  let a ∈ ℕ                                                           (H1)
  let b ∈ ℕ                                                           (H2)
  let c ∈ ℤ                                                           (H3)
  let x ∈ ℤ                                                           (H4)
  let y ∈ ℤ                                                           (H5)
  assume c·gcd(a, b) divides x                                        (H6)
  assume c·gcd(a, b) divides y                                        (H7)
  then c·gcd(a, b) divides gcd(x, y)

1.  gcd(a, b) ∈ ℕ
    def:gcd

2.  c·gcd(a, b) divides gcd(x, y)
    thm:divides-gcd d := c·gcd(a, b), a := x, b := y, from H6, H7
    requires c·gcd(a, b) ∈ ℤ: from 1
