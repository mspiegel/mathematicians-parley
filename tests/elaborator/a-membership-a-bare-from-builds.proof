import definition         stdlib/counting/factorial
import mundane theorem    stdlib/counting/factorial-nat
import theorem            stdlib/divisibility/divides-gcd
import definition         stdlib/divisibility/gcd

theorem a-membership-from-lines-together
  note        A bare `from` gives a membership the lines it names give
              together, as `membership` would build it: (k + 1)! ∈ ℝ from
              k! ∈ ℕ and (k + 1)! = k!·(k + 1). k is let into ℤ, so the
              page does not say (k + 1)! is a number once.
  let k ∈ ℤ                                                           (H1)
  assume k ∈ ℕ₀                                                       (H2)
  let y ∈ ℝ                                                           (H3)
  assume y ≤ (k + 1)!                                                 (H4)
  assume (k + 1)! ≤ 3                                                 (H5)
  then y ≤ 3

1.  k! ∈ ℕ
    mun:factorial-nat n := k, from H2

2.  (k + 1)! = k!·(k + 1)
    def:factorial n := k, from H2

3.  y ≤ 3
    transitivity, from H4, H5
    requires (k + 1)! ∈ ℝ: from 1, 2

theorem a-product-membership-from-a-line
  note        c·f(a) ∈ ℤ from the line f(a) ∈ ℕ, c let into ℤ.
  let f : ℕ → ℕ                                                       (H1)
  let a ∈ ℕ                                                           (H2)
  let c ∈ ℤ                                                           (H3)
  let x ∈ ℤ                                                           (H4)
  let y ∈ ℤ                                                           (H5)
  assume c·f(a) divides x                                             (H6)
  assume c·f(a) divides y                                             (H7)
  then c·f(a) divides gcd(x, y)

1.  f(a) ∈ ℕ
    membership, from H1

2.  c·f(a) divides gcd(x, y)
    thm:divides-gcd d := c·f(a), a := x, b := y, from H6, H7
    requires c·f(a) ∈ ℤ: from 1
