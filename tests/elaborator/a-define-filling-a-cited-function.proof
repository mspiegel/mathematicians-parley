import mundane theorem    stdlib/functions/function-into

theorem value-at-one
  note        Cited below with its f filled by a define the build holds as k, the letter this binds.
  let f : ℕ → ℝ                                                       (H1)
  assume for all k ∈ ℕ, f(k) = k + 1                                  (H2)
  then f(1) = 1 + 1

1.  f(1) = 1 + 1
    instantiate k := 1 in H2

theorem a-define-filling-a-cited-function
  note        The cited theorem's bound k is moved apart from the define's letter.
  then 1 = 1

let t(j) = j + 1, for j ∈ ℕ                                           (D1)
    reads one more

1.  For all j ∈ ℕ, t(j) ∈ ℝ.
    membership, from D1

2.  t : ℕ → ℝ
    mun:function-into, from 1
    requires t is a function on ℕ: from D1

3.  For all j ∈ ℕ, t(j) = j + 1.
    D1

4.  t(1) = 1 + 1
    thm:value-at-one f := t, from 3
    requires t : ℕ → ℝ: from 2

5.  1 = 1
    arithmetic
