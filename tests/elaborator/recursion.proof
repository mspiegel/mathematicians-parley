theorem one-sequence
  define c(0) := 1,  c(k + 1) := 2·c(k),  for k ∈ ℕ₀                   (D1)
         reads the powers of two
  then c(0 + 1) = 2

1.  c(0) = 1
    D1

2.  0 ∈ ℕ₀
    membership

3.  c(0 + 1) = 2·c(0)
    D1, from 2

4.  2·c(0) = 2·1
    substitute c(0) = 1 (line 1)

5.  2·1 = 2
    arithmetic

6.  c(0 + 1) = 2
    calculation
      c(0 + 1) = 2·c(0)     3
               = 2·1        4
               = 2          5

theorem rule-names-index
  define s(0) := 0,  s(k + 1) := s(k) + k,  for k ∈ ℕ₀                 (D1)
         reads the sums 0 + 1 + … + (k − 1)
  then s(0) = 0 and s(1 + 1) = s(1) + 1

1.  s(0) = 0
    D1

2.  1 ∈ ℕ₀
    membership

3.  s(1 + 1) = s(1) + 1
    D1, from 2

4.  s(0) = 0 and s(1 + 1) = s(1) + 1
    join 1, 3
