import definition         stdlib/numbers/sqrt
import mundane theorem    stdlib/numbers/square-less

theorem a-requires-weakening-with-its-membership
  note        A requires line by a manipulation is a row of inequalities, and
              takes the membership of each atom from a requires line above it:
              √(x + 1) + √x > 0 weakened to ≠ 0 needs √(x + 1) and √x real.
  let x ∈ ℝ                                                           (H1)
  assume x ≥ 0                                                        (H2)
  then √(x + 1) − √x = 1/(√(x + 1) + √x)

1.  x + 1 ≥ 0
    inequalities, from H2

2.  √(x + 1) ∈ ℝ. √(x + 1) ≥ 0. (√(x + 1))² = x + 1.
    def:sqrt x := x + 1, from 1

3.  √x ∈ ℝ. √x ≥ 0. (√x)² = x.
    def:sqrt, from H2

4.  x < x + 1
    inequalities

5.  (√x)² < (√(x + 1))²
    calculation
      (√x)² = x                3
            < x + 1            4
            = (√(x + 1))²      2

6.  √x < √(x + 1)
    mun:square-less x := √x, y := √(x + 1), from 2, 3, 5

7.  √(x + 1) > 0
    transitivity, from 3, 6
    requires √(x + 1) ∈ ℝ: from 2

8.  √(x + 1) + √x > 0
    inequalities, from 2, 3, 7

9.  √(x + 1) − √x = 1/(√(x + 1) + √x)
    algebra, from 2, 3
    requires √(x + 1) ∈ ℝ: from 2
    requires √x ∈ ℝ: from 3
    requires √(x + 1) + √x ≠ 0: weakening, from 8
