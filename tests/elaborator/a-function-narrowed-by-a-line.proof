import mundane theorem    stdlib/divisibility/mod-less
import mundane theorem    stdlib/divisibility/mod-natural
import mundane theorem    stdlib/numbers/power-integer
import mundane theorem    stdlib/numbers/nat-minus-one
import mundane theorem    stdlib/sums/range-from-bounds

theorem a-function-narrowed-by-a-line
  note        A function's define says no kind of number; a line below it says its values are natural numbers or 0, by a block read at a member of its domain; a step then puts a value in a range from that line, and the define gives it back as the term.
  let n ∈ ℕ                                                           (H1)
  then for all k ∈ {1, …, n}, (k^(n − 1)) mod n ∈ {0, …, n − 1}

let f(k) = (k^(n − 1)) mod n, for k ∈ {1, …, n}                      (D1)
    reads the remainder of k^(n − 1) on division by n

1.  n − 1 ∈ ℕ₀
    mun:nat-minus-one

2.  For all k ∈ {1, …, n}, f(k) ∈ ℕ₀.
    proof
    let k ∈ {1, …, n}                                                 (K1)

    2.1.  k^(n − 1) ∈ ℤ
          mun:power-integer m := n − 1, from 1

    2.2.  (k^(n − 1)) mod n ∈ ℕ₀
          mun:mod-natural, from 2.1

    2.3.  f(k) = (k^(n − 1)) mod n
          D1, from K1

    2.4.  f(k) ∈ ℕ₀
          substitute f(k) = (k^(n − 1)) mod n (line 2.3) into line 2.2

3.  For all k ∈ {1, …, n}, (k^(n − 1)) mod n ∈ {0, …, n − 1}.
    proof
    let k ∈ {1, …, n}                                                 (K2)

    3.1.  k^(n − 1) ∈ ℤ
          mun:power-integer m := n − 1, from 1

    3.2.  (k^(n − 1)) mod n < n
          mun:mod-less, from 3.1

    3.3.  f(k) = (k^(n − 1)) mod n
          D1, from K2

    3.4.  f(k) < n
          substitute f(k) = (k^(n − 1)) mod n (line 3.3) into line 3.2

    3.5.  f(k) ∈ {0, …, n − 1}
          mun:range-from-bounds, from 3.4
          requires f(k) ∈ ℕ₀: from 2

    3.6.  (k^(n − 1)) mod n ∈ {0, …, n − 1}
          substitute f(k) = (k^(n − 1)) mod n (line 3.3) into line 3.5
