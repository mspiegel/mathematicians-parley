import definition         stdlib/numbers/abs
import mundane theorem stdlib/numbers/floor-integer

theorem a-bound-on-the-size-of-a-floor
  note        A bound on |⌊A⌋| chained from an equation and a bound, the floor term an atom of the chain.
  let A ∈ ℝ    (H1)
  assume |⌊A⌋| = ⌊A⌋    (H2)
  assume ⌊A⌋ ≤ 1    (H3)
  then |⌊A⌋| ≤ 1

1.  ⌊A⌋ ∈ ℤ
    mun:floor-integer x := A

2.  ⌊A⌋ ∈ ℝ
    membership, from 1

3.  |⌊A⌋| ≤ 1
    transitivity, from H2, H3
    requires ⌊A⌋ ∈ ℝ: from 2

theorem a-rounding-error-at-most-a-half
  note        The size of a rounding error, the floor of a sum an atom inside an absolute value.
  let A ∈ ℝ    (H1)
  assume ⌊A + 1/2⌋ − A ≥ 0    (H2)
  assume ⌊A + 1/2⌋ − A ≤ 1/2    (H3)
  then |⌊A + 1/2⌋ − A| ≤ 1/2

1.  ⌊A + 1/2⌋ ∈ ℤ
    mun:floor-integer x := A + 1/2

2.  ⌊A + 1/2⌋ − A ∈ ℝ
    membership, from 1

3.  |⌊A + 1/2⌋ − A| = ⌊A + 1/2⌋ − A
    def:abs x := ⌊A + 1/2⌋ − A, from H2, 2

4.  |⌊A + 1/2⌋ − A| ≤ 1/2
    transitivity, from 3, H3
    requires ⌊A + 1/2⌋ ∈ ℝ: membership, from 1
