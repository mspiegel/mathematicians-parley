import mundane definition stdlib/numbers/abs
import mundane theorem stdlib/numbers/abs-real
import mundane theorem stdlib/numbers/floor-integer

theorem a-bound-on-the-size-of-a-floor
  note        A bound on |⌊A⌋| read from an equation and a bound, the floor term an atom of the inequality.
  let A ∈ ℝ    (H1)
  assume |⌊A⌋| = ⌊A⌋    (H2)
  assume ⌊A⌋ ≤ 1    (H3)
  then |⌊A⌋| ≤ 1

1.  ⌊A⌋ ∈ ℤ
    mun:floor-integer x := A

2.  ⌊A⌋ ∈ ℝ
    membership, from 1

3.  |⌊A⌋| ≤ 1
    inequalities, from H2, H3, 2
    requires |⌊A⌋| ∈ ℝ: mun:abs-real x := ⌊A⌋, from 2

theorem a-rounding-error-at-most-a-half
  note        The size of a rounding error, the floor of a sum an atom inside an absolute value.
  let A ∈ ℝ    (H1)
  assume ⌊A + 1/2⌋ − A ≥ 0    (H2)
  assume ⌊A + 1/2⌋ − A ≤ 1/2    (H3)
  then |⌊A + 1/2⌋ − A| ≤ 1/2

1.  ⌊A + 1/2⌋ ∈ ℤ
    mun:floor-integer x := A + 1/2

2.  ⌊A + 1/2⌋ − A ∈ ℝ
    membership, from 1

3.  |⌊A + 1/2⌋ − A| = ⌊A + 1/2⌋ − A
    mun:abs x := ⌊A + 1/2⌋ − A, from H2, 2

4.  |⌊A + 1/2⌋ − A| ≤ 1/2
    inequalities, from H3, 1, 3
    requires |⌊A + 1/2⌋ − A| ∈ ℝ: mun:abs-real x := ⌊A + 1/2⌋ − A, from 2
