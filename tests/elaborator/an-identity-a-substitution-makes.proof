import definition         stdlib/counting/C
import mundane theorem    stdlib/counting/binomial-nat0

theorem an-identity-a-substitution-makes-at-a-value
  note        Putting 1 for 1^k makes b(0)·1, and dropping the 1 asks that b(0) be a number, which the function's type and the point say.
  let b : ℤ → ℝ    (H1)
  let k ∈ ℤ    (H2)
  assume 1^k = 1    (H3)
  then b(0)·1^k = b(0)

1.  b(0)·1^k = b(0)
    substitute 1^k = 1 (H3)
    requires b(0) ∈ ℝ: from H1

theorem an-identity-a-substitution-makes-at-a-coefficient
  note        And C(N, k) is a number by the item that says so.
  let N ∈ ℕ₀    (H1)
  let k ∈ ℤ    (H2)
  assume 1^k = 1    (H3)
  then C(N, k)·1^k = C(N, k)

1.  C(N, k)·1^k = C(N, k)
    substitute 1^k = 1 (H3)
    requires C(N, k) ∈ ℕ₀: mun:binomial-nat0
