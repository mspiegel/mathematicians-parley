import mundane theorem    stdlib/calculus/derivative-real

theorem prime-name
  let c ∈ ℝ                                                           (H1)
  let c′ ∈ ℝ                                                          (H2)
  assume c′ = c + 1                                                   (H3)
  then c′ − c = 1

1.  c′ − c = 1
    algebra, from H3

theorem derivative-names
  let a ∈ ℝ                                                           (H1)
  let b ∈ ℝ                                                           (H2)
  let f : [a, b] → ℝ                                                  (H3)
  assume f is differentiable on (a, b)                                (H4)
  assume f′ is continuous on (a, b)                                   (H5)
  assume f′ is differentiable on (a, b)                               (H6)
  let x ∈ (a, b)                                                      (H7)
  assume f′′(x) = 0                                                   (H8)
  then f′(x) ∈ ℝ

1.  f′(x) ∈ ℝ
    mun:derivative-real a := a, b := b, f := f, x := x, from H4, H7

theorem order-apart
  let a ∈ ℝ                                                           (H1)
  let b ∈ ℝ                                                           (H2)
  assume a < b                                                        (H3)
  then b − a ≠ 0

1.  b − a ≠ 0
    inequalities, from H3

theorem bracketed-formula
  let a ∈ ℝ                                                           (H1)
  assume (for all x ∈ ℝ, x ≤ a)                                       (H2)
  then a ≤ a

1.  a ≤ a
    instantiate x := a in H2
