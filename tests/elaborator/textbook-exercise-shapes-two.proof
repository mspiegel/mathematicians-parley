import mundane definition stdlib/divisibility/odd
import definition         stdlib/calculus/limit-at
import mundane theorem    stdlib/sets/subset-self
import mundane definition stdlib/numbers/sqrt

theorem a-contradiction-ending-in-cases
  note        The block's last step is the cases step, which names the line
              its cases together contradict.
  let x ∈ ℝ                                                           (H1)
  assume x > 2 or x > 1                                               (H2)
  then x > 0

1.  x > 0
    contradiction
    suppose not (x > 0)                                               (S)

    1.1.  x > 0
          cases, from H2, contradicting S

          case
          assume x > 2                                                (C1)

          1.1.1.  x > 0
                  inequalities, from C1

          case
          assume x > 1                                                (C2)

          1.1.2.  x > 0
                  inequalities, from C2

theorem a-define-inside-a-case
  note        A define written in one case is that case's own.
  let x ∈ ℝ                                                           (H1)
  assume x = 1 or x = 2                                               (H2)
  then x > 0

1.  x > 0
    cases, from H2

    case
    assume x = 1                                                      (C1)

    let y = x + 1, a real number                                      (D1)
        membership
        reads one more than x

    1.1.  y = x + 1
          D1

    1.2.  1 > 0
          arithmetic

    1.3.  x > 0
          transitivity, from C1, 1.2

    case
    assume x = 2                                                      (C2)

    1.4.  2 > 0
          arithmetic

    1.5.  x > 0
          transitivity, from C2, 1.4

theorem an-obtain-through-the-second-sentence
  note        The pair names b, so it is b is odd that is unfolded, though
              the line says a is odd first.
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  assume a is odd and b is odd                                        (H3)
  then there is j ∈ ℤ with b = 2j + 1

1.  j ∈ ℤ. b = 2j + 1.
    obtain j: mun:odd n := b, from H3

2.  There is j ∈ ℤ with b = 2j + 1.
    exhibit, from 1

theorem a-limit-unfolded-on-the-line
  note        The definition read over all of ℝ, D := ℝ, the other way
              from the one it is folded back.
  ε, δ range over ℝ
  let f : ℝ → ℝ                                                       (H1)
  let c ∈ ℝ                                                           (H2)
  let L ∈ ℝ                                                           (H3)
  assume f tends to L at c                                            (H4)
  then for all ε > 0, there exists δ > 0 such that |f(x) − L| < ε for all x ∈ ℝ with (x ≠ c and |x − c| < δ)

1.  For all ε > 0, there exists δ > 0 such that |f(x) − L| < ε for all x ∈ ℝ with (x ≠ c and |x − c| < δ).
    def:limit-at D := ℝ, from H4
    requires ℝ ⊆ ℝ: mun:subset-self

theorem a-root-in-a-bound
  note        2·√a is a number once √a is, which line 1 says.
  let a ∈ ℝ                                                           (H1)
  assume a ≥ 0                                                        (H2)
  assume not (a ≥ 2·√a)                                               (H3)
  then a < 2·√a

1.  √a ∈ ℝ. √a ≥ 0. (√a)² = a.
    mun:sqrt x := a, from H2

2.  a < 2·√a
    inequalities, from H3, 1
