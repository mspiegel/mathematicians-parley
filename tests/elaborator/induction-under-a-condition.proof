import mundane theorem    stdlib/graphs/walk-step
import mundane theorem    stdlib/graphs/joined-end
import mundane theorem    stdlib/graphs/not-an-end
import mundane theorem    stdlib/graphs/join-distinct
import mundane theorem    stdlib/counting/count-nat0
import mundane theorem    stdlib/counting/count-empty-range
import mundane theorem    stdlib/counting/count-step-holds
import mundane theorem    stdlib/counting/count-step-fails
import mundane theorem    stdlib/numbers/nat0-successor
import mundane theorem    stdlib/numbers/nat0-closure
import mundane theorem    stdlib/functions/function-value
import mundane definition stdlib/sums/range
import mundane definition stdlib/sums/range0
import mundane definition stdlib/divisibility/even
import mundane definition stdlib/divisibility/odd
import mundane theorem    stdlib/divisibility/even-or-odd
import mundane theorem    stdlib/divisibility/not-both
import mundane axiom      stdlib/reasoning/excluded-middle
import mundane theorem    stdlib/reasoning/disjunctive-syllogism
import mundane theorem    stdlib/reasoning/modus-ponens
import mundane theorem    stdlib/reasoning/iff-both-true
import mundane theorem    stdlib/reasoning/iff-both-false
import mundane theorem    stdlib/reasoning/iff-from-right
import mundane theorem    stdlib/reasoning/iff-not-from-right
import mundane definition stdlib/sets/difference
import mundane definition stdlib/sets/singleton

theorem walk-parity-by-induction
  note        The parity of a walk's edges at a vertex, one edge at a time.
              It keeps three forms of SYNTAX.md in use: a define in the
              theorem's header that the statement uses, an induction over
              only the k with k ≤ n, and `proof` blocks that open with an
              assumption and no `let`. Of the first k edges, a vertex other
              than v(0) is an end of an odd number exactly when it is v(k).
  let G be an undirected multigraph with vertices V and edges E      (H1)
  let n ∈ ℕ₀                                                          (H2)
  let e : {1, …, n} → E                                               (H3)
  let v : {0, …, n} → V                                               (H4)
  assume v and e form a walk of n edges                               (H5)
  let k ∈ {0, …, n}                                                   (H6)
  let x ∈ V ∖ {v(0)}                                                  (H7)
  define c(j, y) := |{i ∈ {1, …, j} : y is an end of e(i)}|, for j ∈ ℕ₀, y ∈ V  (D1)
         reads how many of the first j edges have y as an end
  then c(k, x) is odd ↔ x = v(k)

1.  For all j ∈ ℕ₀ with j ≤ n, for all y ∈ V ∖ {v(0)}, c(j, y) is odd ↔ y = v(j).
    induction on j starting at 0

    base
    1.1.  If 0 ≤ n then for all y ∈ V ∖ {v(0)}, c(0, y) is odd ↔ y = v(0).
          proof
          assume 0 ≤ n                                                (C1)
          let y ∈ V ∖ {v(0)}                                          (K1)

          1.1.1.  y ∈ V. y ∉ {v(0)}.
                  mun:difference, from K1

          1.1.2.  c(0, y) = |{i ∈ {1, …, 0} : y is an end of e(i)}|
                  D1
                  requires 0 ∈ ℕ₀: arithmetic
                  requires y ∈ V: from 1.1.1

          1.1.3.  |{i ∈ {1, …, 0} : y is an end of e(i)}| = 0
                  mun:count-empty-range

          1.1.4.  0 = 2·0
                  arithmetic

          1.1.5.  c(0, y) = 2·0
                  calculation
                    c(0, y) = |{i ∈ {1, …, 0} : y is an end of e(i)}|    1.1.2
                            = 0                                         1.1.3
                            = 2·0                                       1.1.4

          1.1.6.  c(0, y) is even
                  mun:even n := c(0, y), from 1.1.5
                  requires 0 ∈ ℤ: arithmetic
                  requires c(0, y) ∈ ℕ₀: mun:count-nat0 k := 0, from D1, 1.1.1

          1.1.7.  c(0, y) is not odd
                  mun:not-both n := c(0, y), from 1.1.6
                  requires 0 ∈ ℤ: arithmetic
                  requires c(0, y) ∈ ℕ₀: mun:count-nat0 k := 0, from D1, 1.1.1

          1.1.8.  y ≠ v(0)
                  contradiction
                  suppose y = v(0)                                    (S1)

                  1.1.8.1.  y ∈ {v(0)}
                            mun:singleton, from S1, contradicting 1.1.1

          1.1.9.  c(0, y) is odd ↔ y = v(0)
                  mun:iff-both-false, from 1.1.7, 1.1.8

    step
    let j ∈ ℕ₀                                                        (K2)
    assume step 1 is true for j, the induction hypothesis             (IH)

    1.2.  If j + 1 ≤ n then for all y ∈ V ∖ {v(0)},
          c(j + 1, y) is odd ↔ y = v(j + 1).
          proof
          assume j + 1 ≤ n                                            (C2)
          let y ∈ V ∖ {v(0)}                                          (K3)

          1.2.1.  y ∈ V. y ∉ {v(0)}.
                  mun:difference, from K3

          1.2.2.  j + 1 ∈ {1, …, n}
                  mun:range k := j + 1, from C2
                  requires n ∈ ℤ: membership, from H2
                  requires j + 1 ∈ ℕ: mun:nat0-successor, from K2

          1.2.3.  j ≤ n
                  inequalities, from C2
                  requires j ∈ ℝ: membership, from K2
                  requires n ∈ ℝ: membership, from H2

          1.2.4.  j ∈ {0, …, n}
                  mun:range0 k := j, from 1.2.3
                  requires n ∈ ℕ₀: from H2
                  requires j ∈ ℕ₀: from K2

          1.2.5.  j + 1 ∈ {0, …, n}
                  mun:range0 k := j + 1, from C2
                  requires n ∈ ℕ₀: from H2
                  requires j + 1 ∈ ℕ₀: mun:nat0-closure, from K2

          1.2.6.  e(j + 1) joins v(j + 1 − 1) and v(j + 1)
                  mun:walk-step i := j + 1, from H2, H5, 1.2.2

          1.2.7.  j + 1 − 1 = j
                  algebra
                  requires j ∈ ℝ: membership, from K2

          1.2.8.  e(j + 1) joins v(j) and v(j + 1)
                  substitute j + 1 − 1 = j (line 1.2.7) into line 1.2.6

          1.2.9.  For all y ∈ V ∖ {v(0)}, c(j, y) is odd ↔ y = v(j).
                  mun:modus-ponens, from IH, 1.2.3

          1.2.10. c(j, y) is odd ↔ y = v(j)
                  instantiate y := y in line 1.2.9, from K3

          1.2.11. y = v(j + 1) or y ≠ v(j + 1)
                  mun:excluded-middle

          1.2.12. c(j + 1, y) is odd ↔ y = v(j + 1)
                  cases, from 1.2.11

                  case
                  assume y = v(j + 1)                                 (C3)

                  1.2.12.1.  v(j) ≠ v(j + 1)
                             mun:join-distinct a := e(j + 1), u := v(j), w := v(j + 1),
                               from 1.2.8
                             requires e(j + 1) ∈ E: mun:function-value, from H3, 1.2.2
                             requires v(j) ∈ V: mun:function-value, from H4, 1.2.4
                             requires v(j + 1) ∈ V: mun:function-value, from H4, 1.2.5

                  1.2.12.2.  y ≠ v(j)
                             substitute y = v(j + 1) (C3) into line 1.2.12.1

                  1.2.12.3.  c(j, y) is not odd
                             mun:iff-not-from-right, from 1.2.10, 1.2.12.2

                  1.2.12.4.  c(j, y) is even or c(j, y) is odd
                             mun:even-or-odd n := c(j, y)
                             requires c(j, y) ∈ ℕ₀: mun:count-nat0 k := j, from D1, K2, 1.2.1

                  1.2.12.5.  c(j, y) is even
                             mun:disjunctive-syllogism, from 1.2.12.4, 1.2.12.3

                  1.2.12.6.  v(j + 1) is an end of e(j + 1)
                             mun:joined-end a := e(j + 1), u := v(j), w := v(j + 1),
                               from 1.2.8
                             requires e(j + 1) ∈ E: mun:function-value, from H3, 1.2.2
                             requires v(j) ∈ V: mun:function-value, from H4, 1.2.4
                             requires v(j + 1) ∈ V: mun:function-value, from H4, 1.2.5

                  1.2.12.7.  y is an end of e(j + 1)
                             substitute y = v(j + 1) (C3) into line 1.2.12.6

                  1.2.12.8.  c(j + 1, y) = c(j, y) + 1
                             mun:count-step-holds k := j, from K2, 1.2.12.7, D1
                             requires y ∈ V: from 1.2.1
                             requires j + 1 ∈ ℕ₀: mun:nat0-closure, from K2

                  1.2.12.9.  m ∈ ℤ. c(j, y) = 2m.
                             obtain m: mun:even n := c(j, y), from 1.2.12.5
                             requires c(j, y) ∈ ℕ₀: mun:count-nat0 k := j, from D1, K2, 1.2.1

                  1.2.12.10. c(j + 1, y) = 2m + 1
                             substitute c(j, y) = 2m (line 1.2.12.9) into line 1.2.12.8

                  1.2.12.11. c(j + 1, y) is odd
                             mun:odd n := c(j + 1, y), from 1.2.12.10
                             requires j + 1 ∈ ℕ₀: mun:nat0-closure, from K2
                             requires c(j + 1, y) ∈ ℕ₀: mun:count-nat0 k := j + 1, from D1, 1.2.1
                             requires m ∈ ℤ: from 1.2.12.9

                  1.2.12.12. c(j + 1, y) is odd ↔ y = v(j + 1)
                             mun:iff-both-true, from 1.2.12.11, C3

                  case
                  assume y ≠ v(j + 1)                                 (C4)

                  1.2.12.13. y = v(j) or y ≠ v(j)
                             mun:excluded-middle

                  1.2.12.14. c(j + 1, y) is even
                             cases, from 1.2.12.13

                             case
                             assume y = v(j)                          (C5)

                             1.2.12.14.1.  v(j) is an end of e(j + 1)
                                           mun:joined-end a := e(j + 1), u := v(j), w := v(j + 1),
                                             from 1.2.8
                                           requires e(j + 1) ∈ E: mun:function-value, from H3, 1.2.2
                                           requires v(j) ∈ V: mun:function-value, from H4, 1.2.4
                                           requires v(j + 1) ∈ V: mun:function-value, from H4, 1.2.5

                             1.2.12.14.2.  y is an end of e(j + 1)
                                           substitute y = v(j) (C5) into line 1.2.12.14.1

                             1.2.12.14.3.  c(j + 1, y) = c(j, y) + 1
                                           mun:count-step-holds k := j, from K2, 1.2.12.14.2, D1
                                           requires y ∈ V: from 1.2.1
                                           requires j + 1 ∈ ℕ₀: mun:nat0-closure, from K2

                             1.2.12.14.4.  c(j, y) is odd
                                           mun:iff-from-right, from 1.2.10, C5

                             1.2.12.14.5.  m ∈ ℤ. c(j, y) = 2m + 1.
                                           obtain m: mun:odd n := c(j, y), from 1.2.12.14.4
                                           requires c(j, y) ∈ ℕ₀: mun:count-nat0 k := j, from D1, K2, 1.2.1

                             1.2.12.14.6.  c(j + 1, y) = (2m + 1) + 1
                                           substitute c(j, y) = 2m + 1 (line 1.2.12.14.5) into line 1.2.12.14.3

                             1.2.12.14.7.  (2m + 1) + 1 = 2(m + 1)
                                           algebra
                                           requires m ∈ ℝ: membership, from 1.2.12.14.5

                             1.2.12.14.8.  c(j + 1, y) = 2(m + 1)
                                           calculation
                                             c(j + 1, y) = (2m + 1) + 1      1.2.12.14.6
                                                         = 2(m + 1)          1.2.12.14.7

                             1.2.12.14.9.  c(j + 1, y) is even
                                           mun:even n := c(j + 1, y), from 1.2.12.14.8
                                           requires j + 1 ∈ ℕ₀: mun:nat0-closure, from K2
                                           requires c(j + 1, y) ∈ ℕ₀: mun:count-nat0 k := j + 1, from D1, 1.2.1
                                           requires m + 1 ∈ ℤ: membership, from 1.2.12.14.5

                             case
                             assume y ≠ v(j)                          (C6)

                             1.2.12.14.10. y is not an end of e(j + 1)
                                           mun:not-an-end a := e(j + 1), u := v(j), w := v(j + 1),
                                             from 1.2.8, C6, C4
                                           requires e(j + 1) ∈ E: mun:function-value, from H3, 1.2.2
                                           requires v(j) ∈ V: mun:function-value, from H4, 1.2.4
                                           requires v(j + 1) ∈ V: mun:function-value, from H4, 1.2.5
                                           requires y ∈ V: from 1.2.1

                             1.2.12.14.11. c(j + 1, y) = c(j, y)
                                           mun:count-step-fails k := j, from K2, 1.2.12.14.10, D1
                                           requires y ∈ V: from 1.2.1
                                           requires j + 1 ∈ ℕ₀: mun:nat0-closure, from K2

                             1.2.12.14.12. c(j, y) is not odd
                                           mun:iff-not-from-right, from 1.2.10, C6

                             1.2.12.14.13. c(j, y) is even or c(j, y) is odd
                                           mun:even-or-odd n := c(j, y)
                                           requires c(j, y) ∈ ℕ₀: mun:count-nat0 k := j, from D1, K2, 1.2.1

                             1.2.12.14.14. c(j, y) is even
                                           mun:disjunctive-syllogism, from 1.2.12.14.13, 1.2.12.14.12

                             1.2.12.14.15. c(j + 1, y) is even
                                           substitute c(j + 1, y) = c(j, y) (line 1.2.12.14.11) into line 1.2.12.14.14

                  1.2.12.15. c(j + 1, y) is not odd
                             mun:not-both n := c(j + 1, y), from 1.2.12.14
                             requires j + 1 ∈ ℕ₀: mun:nat0-closure, from K2
                             requires c(j + 1, y) ∈ ℕ₀: mun:count-nat0 k := j + 1, from D1, 1.2.1

                  1.2.12.16. c(j + 1, y) is odd ↔ y = v(j + 1)
                             mun:iff-both-false, from 1.2.12.15, C4

2.  k ∈ ℕ₀. k ≤ n.
    mun:range0, from H2, H6

3.  For all y ∈ V ∖ {v(0)}, c(k, y) is odd ↔ y = v(k).
    instantiate j := k in line 1, from 2

4.  x ∈ V. x ∉ {v(0)}.
    mun:difference, from H7

5.  c(k, x) is odd ↔ x = v(k)
    instantiate y := x in line 3, from H7
