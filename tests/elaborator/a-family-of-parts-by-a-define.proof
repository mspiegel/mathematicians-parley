import mundane theorem    stdlib/counting/parts-finite
import definition         stdlib/sets/part-builder
import definition         stdlib/sets/set-builder
import mundane theorem    stdlib/sets/set-builder-subset
import mundane theorem    stdlib/sums/range-finite

define K(m, n) := {c ∈ {d ⊆ {1, …, m + n} : |d| = m} : 1 ∈ c}, for m ∈ ℕ₀, n ∈ ℕ₀   (D1)
       reads the parts of the first m + n numbers with m elements that hold 1

theorem a-family-of-parts-is-finite
  note        A member of K(m, n) is unfolded from the line saying it, K read
              as its rule at m and n, and the statement over K is reached
              from the last step's K, whose rule binds its own letters.
  let m ∈ ℕ₀                                                          (H1)
  let n ∈ ℕ₀                                                          (H2)
  then K(m, n) is finite

1.  {1, …, m + n} is finite
    mun:range-finite a := 1, b := m + n

2.  For all c ∈ K(m, n), c ⊆ {1, …, m + n}.
    proof
    let c ∈ K(m, n)                                                   (K1)

    2.1.  c ∈ {d ⊆ {1, …, m + n} : |d| = m}
          def:set-builder u := c, from D1, K1

    2.2.  c ⊆ {1, …, m + n}
          def:part-builder u := c, from 2.1

3.  K(m, n) is finite
    mun:parts-finite A := {1, …, m + n}, K := K(m, n), from 1, 2

theorem a-family-at-zero
  note        K(m, 0) read as its rule writes {1, …, m + 0}, which is
              {1, …, m}; the two set-builders over it bind other letters.
  let m ∈ ℕ                                                           (H1)
  then K(m, 0) ⊆ {e ⊆ {1, …, m} : |e| = m}

1.  K(m, 0) ⊆ {e ⊆ {1, …, m} : |e| = m}
    mun:set-builder-subset X := {e ⊆ {1, …, m} : |e| = m}, from D1

theorem an-instance-whose-condition-is-itself
  note        At k := a + b the condition k = a + b says a + b = a + b,
              which needs no line.
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  assume for all k ∈ ℤ, if k = a + b then a ≤ k                       (H3)
  then a ≤ a + b

1.  a ≤ a + b
    instantiate k := a + b in H3
