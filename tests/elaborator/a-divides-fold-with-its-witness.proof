import definition         stdlib/divisibility/divides

theorem a-divides-fold-with-its-witness
  note        3 divides p² + q² because p² + q² = 3·m², and m² is an
              integer because H2 says m ∈ ℕ: the witness of the "there is"
              divides unfolds to is in ℤ by a line the step names.
  let m ∈ ℝ    (H1)
  assume m ∈ ℕ    (H2)
  assume there are j, k ∈ ℤ with j² + k² = 3m²    (H3)
  then 3 divides 3m²

1.  p ∈ ℤ. q ∈ ℤ. p² + q² = 3m².
    obtain p, q from H3

2.  3 divides p² + q²
    def:divides d := 3, n := p² + q², from H2, 1

3.  3 divides 3m²
    substitute p² + q² = 3m² (line 1) into line 2
