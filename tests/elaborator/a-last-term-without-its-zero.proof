import definition         stdlib/counting/C
import mundane theorem    stdlib/sums/range-difference
import mundane theorem    stdlib/sums/sum-last

theorem a-last-term-without-its-zero
  note        At n := 0, sum-last's last term is t(0 + 1), here C(1 − (0 + 1),
              0 + 1), which is C(1 − 1, 1) once the zeros are dropped: the
              claim is written without them, in the build as in the checker.
  then Σ(k = 0 to 1) C(1 − k, k) = Σ(k = 0 to 0) C(1 − k, k) + C(1 − 1, 1)

1.  For all k ∈ {0, …, 1}, C(1 − k, k) ∈ ℝ.
    proof
    let k ∈ {0, …, 1}                                                 (L)

    1.1.  1 − k ∈ ℕ₀
          mun:range-difference a := 0, n := 1, from L

    1.2.  C(1 − k, k) ∈ ℝ
          membership
          requires 1 − k ∈ ℕ₀: from 1.1

2.  Σ(k = 0 to 1) C(1 − k, k) = Σ(k = 0 to 0) C(1 − k, k) + C(1 − 1, 1)
    mun:sum-last n := 0, from 1
