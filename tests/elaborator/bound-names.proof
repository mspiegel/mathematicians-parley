import mundane definition stdlib/calculus/series-sum
import mundane definition stdlib/divisibility/gcd
import mundane theorem    stdlib/numbers/product-nonzero

theorem series-under-its-own-letters
  assume Σ(k = 1 to n) 1/(k·(k + 1)) → 1 as n → ∞                    (H1)
  then Σ(k = 1 to ∞) 1/(k·(k + 1)) = 1

1.  For all k ∈ ℕ, 1/(k·(k + 1)) ∈ ℝ.
    proof
    let k ∈ ℕ                                                         (K1)

    1.1.  k·(k + 1) ≠ 0
          mun:product-nonzero x := k, y := k + 1
          requires k ≠ 0: from K1
          requires k + 1 ≠ 0: inequalities, from K1

    1.2.  1/(k·(k + 1)) ∈ ℝ
          membership, from 1.1

2.  Σ(k = 1 to ∞) 1/(k·(k + 1)) = 1
    mun:series-sum L := 1, from H1, 1

theorem citation-under-a-bound-name
  let a ∈ ℕ                                                           (H1)
  let b ∈ ℕ                                                           (H2)
  assume for all e ∈ ℕ, e ≤ e                                         (H3)
  then for all e ∈ ℕ, if e divides a and e divides b then e ≤ gcd(a, b)

1.  For all e ∈ ℕ, if e divides a and e divides b then e ≤ gcd(a, b).
    mun:gcd
