import mundane theorem    stdlib/numbers/product-nonzero

theorem a-power-divisor-among-others
  note        (k + 1)² is not zero because k + 1 is not, which a requires
              line says; the step divides by it with 1/k and 1/(k + 1),
              whose denominators are multiplied out together. k is an
              integer the page does not say once is positive, so each
              divisor's ≠ 0 is written.
  let k ∈ ℤ                                                           (H1)
  assume k > 0                                                        (H2)
  then 1/k − 1/(k + 1) − 1/(k + 1)² = 1/(k·(k + 1)²)

1.  k + 1 > 0
    inequalities, from H2

2.  1/k − 1/(k + 1) − 1/(k + 1)² = 1/(k·(k + 1)²)
    algebra
    requires k ≠ 0: weakening, from H2
    requires k + 1 ≠ 0: weakening, from 1

theorem a-product-divisor-among-others
  note        m·(m + 1) is not zero because each factor is not.
  let m ∈ ℤ                                                           (H1)
  assume m > 0                                                        (H2)
  then 1 − 1/m + 1/(m·(m + 1)) = 1 − 1/(m + 1)

1.  m + 1 > 0
    inequalities, from H2

2.  1 − 1/m + 1/(m·(m + 1)) = 1 − 1/(m + 1)
    algebra
    requires m ≠ 0: weakening, from H2
    requires m + 1 ≠ 0: weakening, from 1

theorem a-product-divisor-below-a-line-saying-it
  note        Line 2 says k·(k + 1) ≠ 0 and step 3 does not cite it: step 3
              divides by k·(k + 1) because its requires lines say each
              factor is not zero, and rests on those, not on line 2.
  let k ∈ ℤ                                                           (H1)
  assume k > 0                                                        (H2)
  then k·(k + 1) ≠ 0 and 1/k − 1/(k + 1) = 1/(k·(k + 1))

1.  k + 1 > 0
    inequalities, from H2

2.  k·(k + 1) ≠ 0
    mun:product-nonzero x := k, y := k + 1
    requires k ≠ 0: weakening, from H2
    requires k + 1 ≠ 0: weakening, from 1

3.  1/k − 1/(k + 1) = 1/(k·(k + 1))
    algebra
    requires k ≠ 0: weakening, from H2
    requires k + 1 ≠ 0: weakening, from 1

4.  k·(k + 1) ≠ 0 and 1/k − 1/(k + 1) = 1/(k·(k + 1))
    join 2, 3

theorem a-divisor-of-numerals-below-zero
  note        2 − 5 is a term of numerals alone whose value, −3, is not
              zero, so the page says once that it is not zero, though it is
              no positive integer.
  let c ∈ ℤ                                                           (H1)
  let x ∈ ℝ                                                           (H2)
  then x · ((c − c) / (2 − 5)) = (c − c) / (2 − 5) · x

1.  x · ((c − c) / (2 − 5)) = (c − c) / (2 − 5) · x
    algebra
