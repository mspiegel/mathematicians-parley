import mundane theorem stdlib/numbers/abs-integer
import mundane theorem stdlib/numbers/nat0-nonzero
import mundane theorem stdlib/numbers/nat-real

theorem an-identity-on-a-required-number
  note        Dropping 1 from 1·|A| asks that |A| be a number, which the requires line says; the step rests on that line, not on line 2 it cites.
  let A ∈ ℤ    (H1)
  assume |A| ≠ 0    (H2)
  assume |A| = A²    (H3)
  assume A² = |A|·|A|    (H4)
  then |A|·|A| = 1·|A|

1.  |A| ∈ ℕ₀
    mun:abs-integer z := A

2.  |A| ∈ ℕ
    mun:nat0-nonzero m := |A|, from H2, 1

3.  |A|·|A| = 1·|A|
    algebra, from H3, H4
    requires |A| ∈ ℝ: mun:nat-real m := |A|, from 2
