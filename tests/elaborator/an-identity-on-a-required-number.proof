import mundane theorem stdlib/numbers/nat-real

theorem an-identity-on-a-required-number
  note        Dropping 1 from 1·(b(A)·b(A)) asks that b(A) be a number, which the requires line says; the step rests on that line, not on line 1 it cites.
  let b : ℤ → ℕ    (H1)
  let A ∈ ℤ    (H2)
  then b(A)·b(A) = 1·(b(A)·b(A))

1.  b(A) ∈ ℕ
    membership, from H1

2.  b(A)·b(A) = 1·(b(A)·b(A))
    algebra
    requires b(A) ∈ ℝ: mun:nat-real m := b(A), from 1
