import mundane theorem    stdlib/sums/sum-single
import mundane theorem    stdlib/sums/sum-extended

theorem a-for-all-read-at-a-numeral
  note        A requires line said of every member of {1, …, 1} is read at 1.
  let x ∈ ℝ                                                           (H1)
  assume x > 0                                                        (H2)
  let t(j) = j/x, for j ∈ ℕ                                           (D1)
         reads the j-th term
  then Σ(j = 1 to 1) t(j) = t(1)

1.  For all i ∈ {1, …, 1}, t(i) ∈ ℝ.
    proof
    let i ∈ {1, …, 1}                                                 (K1)

    1.1.  t(i) ∈ ℝ
          membership, from D1
          requires x ≠ 0: weakening, from H2

2.  Σ(j = 1 to 1) t(j) = t(1)
    mun:sum-single a := 1
    requires for all i ∈ {1, …, 1}, t(i) ∈ ℝ: from 1

theorem a-for-all-over-a-wider-set
  note        A line said of every member of ℕ says it of every member of {1, …, k + 1}.
  let k ∈ ℕ                                                           (H1)
  let x ∈ ℝ                                                           (H2)
  assume for all i ∈ ℕ, i/x ∈ ℝ                                       (H3)
  then Σ(j = 1 to k + 1) j/x = Σ(j = 1 to k) j/x + (k + 1)/x

1.  Σ(j = 1 to k + 1) j/x = Σ(j = 1 to k) j/x + (k + 1)/x
    mun:sum-extended a := 1, n := k, from H3
    requires k ≥ 1: inequalities, from H1

theorem a-sum-of-a-defined-function
  note        A defined function's values asked over a range are said of every point, not as a type. Its rule divides by x, which the page does not say once is a positive integer, so its type is not said once.
  let k ∈ ℕ                                                           (H1)
  let x ∈ ℝ                                                           (H2)
  assume x > 0                                                        (H3)
  let t(j) = j/x, for j ∈ ℕ                                           (D1)
         reads the j-th term
  then Σ(j = 1 to k + 1) t(j) = Σ(j = 1 to k) t(j) + t(k + 1)

1.  For all i ∈ {1, …, k + 1}, t(i) ∈ ℝ.
    proof
    let i ∈ {1, …, k + 1}                                             (K1)

    1.1.  t(i) ∈ ℝ
          membership, from D1
          requires x ≠ 0: weakening, from H3

2.  Σ(j = 1 to k + 1) t(j) = Σ(j = 1 to k) t(j) + t(k + 1)
    mun:sum-extended a := 1, n := k
    requires k ≥ 1: inequalities, from H1
    requires for all i ∈ {1, …, k + 1}, t(i) ∈ ℝ: from 1
