theorem an-assume-line-of-several-sentences
  note        An assume line of two sentences says what "A and B" says, as a
              step's claim of two sentences does: each step below takes one
              sentence of it from the one label.
  let a ∈ ℝ                                                           (H1)
  let b ∈ ℝ                                                           (H2)
  assume a = 1. b = 2.                                                (H3)
  then a + b = 3

1.  a + b = 1 + b
    substitute a = 1 (H3)

2.  1 + b = 1 + 2
    substitute b = 2 (H3)

3.  a + b = 3
    calculation
      a + b = 1 + b     1
            = 1 + 2     2
            = 3         arithmetic

theorem an-opening-assume-of-several-sentences
  note        A block's opening assume line of two sentences is the "if" of
              its claim, read as "A and B".
  let a ∈ ℝ                                                           (H1)
  let b ∈ ℝ                                                           (H2)
  then if (a = 1 and b = 2) then a + b = 3

1.  if (a = 1 and b = 2) then a + b = 3
    proof
    assume a = 1. b = 2.                                              (K1)

    1.1.  a + b = 1 + b
          substitute a = 1 (K1)

    1.2.  1 + b = 1 + 2
          substitute b = 2 (K1)

    1.3.  a + b = 3
          calculation
            a + b = 1 + b     1.1
                  = 1 + 2     1.2
                  = 3         arithmetic
