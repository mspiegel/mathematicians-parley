import mundane theorem    stdlib/numbers/square-nonneg

theorem a-square-in-a-divisor-said-nonzero
  note        A requires line saying 1 + x² ≠ 0 says it of the divisor a cited line writes, x² and x^2 being one term.
  let x ∈ ℝ    (H1)
  let y ∈ ℝ    (H2)
  assume y = 1/(1 + x²)    (H3)
  assume 1/(1 + x²) ≥ 0    (H4)
  then y ≥ 0

1.  x² ≥ 0
    mun:square-nonneg

2.  1 + x² > 0
    inequalities, from 1

3.  y ≥ 0
    transitivity, from H3, H4
    requires 1 + x² ≠ 0: weakening, from 2

theorem a-requires-line-at-an-interval-member
  note        The member of a step said of every x ∈ [0, 1] is a real number said once, for its requires lines as for its citation.
  then For all x ∈ [0, 1], 1/(1 + x²) ∈ ℝ.

1.  For all x ∈ [0, 1], 1/(1 + x²) ∈ ℝ.
    membership
    requires x² ≥ 0: mun:square-nonneg
    requires 1 + x² > 0: inequalities
