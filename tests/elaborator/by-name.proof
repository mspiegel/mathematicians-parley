import mundane definition stdlib/divisibility/divides

theorem values-by-name
  let a ∈ ℤ                                                           (H1)
  let c ∈ ℤ                                                           (H2)
  assume c = a·2                                                      (H3)
  assume for all x, y ∈ ℤ, x + y ∈ ℤ                                  (H4)
  then a divides c and a + 1 ∈ ℤ

1.  a divides c
    mun:divides n := c, d := a, from H3

2.  a + 1 ∈ ℤ
    instantiate y := 1, x := a in H4

3.  a divides c and a + 1 ∈ ℤ
    join 1, 2
