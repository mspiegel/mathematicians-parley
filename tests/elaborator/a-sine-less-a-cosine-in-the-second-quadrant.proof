import mundane definition stdlib/trigonometry/cos
import mundane definition stdlib/trigonometry/sin
import theorem            stdlib/trigonometry/cos-add
import mundane theorem    stdlib/trigonometry/sin-nonneg
import mundane theorem    stdlib/trigonometry/sin-cos-squares
import mundane theorem    stdlib/trigonometry/sin-real
import mundane theorem    stdlib/trigonometry/cos-real
import mundane definition stdlib/calculus/interval
import mundane theorem    stdlib/numbers/product-nonneg
import mundane theorem    stdlib/numbers/square-le

theorem a-sine-less-a-cosine-in-the-second-quadrant
  note        Book of Proof 6.13. On [π/2, π] the sine is at least 0, and the
              cosine is −sin(x − π/2), at most 0; so (sin x − cos x)² is
              1 − 2·sin x·cos x, at least 1.
  let x ∈ ℝ                                                           (H1)
  assume π/2 ≤ x                                                      (H2)
  assume x ≤ π                                                        (H3)
  then sin(x) − cos(x) ≥ 1

1.  0 < π/2
    real arithmetic

2.  0 < x
    transitivity, from H2, 1

3.  0 ≤ x
    inequalities
      0 < x                 2
      0 ≤ x                 weakening

4.  x ∈ [0, π]
    mun:interval, from H3, 3

5.  0 ≤ sin(x)
    mun:sin-nonneg a := x, from 4

6.  0 ≤ x − π/2
    inequalities
      π/2 ≤ x                     H2
      π/2 + (−π/2) ≤ x + (−π/2)   adding −π/2
      0 ≤ x − π/2                 algebra

7.  −π/2 ≤ 0
    real arithmetic

8.  x − π/2 ≤ π
    inequalities, from H3, 7

9.  x − π/2 ∈ [0, π]
    mun:interval, from 6, 8

10. 0 ≤ sin(x − π/2)
    mun:sin-nonneg a := x − π/2, from 9

11. cos((x − π/2) + π/2) = cos(x − π/2)·cos(π/2) − sin(x − π/2)·sin(π/2)
    thm:cos-add a := x − π/2, b := π/2

12. (x − π/2) + π/2 = x
    algebra

13. cos((x − π/2) + π/2) = cos(x)
    substitute (x − π/2) + π/2 = x (line 12)

14. cos(π/2) = 0. sin(π/2) = 1.
    real arithmetic

15. cos(x − π/2)·cos(π/2) − sin(x − π/2)·sin(π/2) = cos(x − π/2)·0 − sin(x − π/2)·sin(π/2)
    substitute cos(π/2) = 0 (line 14)

16. cos(x − π/2)·0 − sin(x − π/2)·sin(π/2) = cos(x − π/2)·0 − sin(x − π/2)·1
    substitute sin(π/2) = 1 (line 14)

17. cos(x) = −sin(x − π/2)
    algebra, from 11, 13, 15, 16
    requires cos(x − π/2) ∈ ℝ: mun:cos-real a := x − π/2
    requires sin(x − π/2) ∈ ℝ: mun:sin-real a := x − π/2

18. sin(x − π/2) = −cos(x)
    algebra, from 17
    requires sin(x − π/2) ∈ ℝ: mun:sin-real a := x − π/2

19. 0 ≤ −cos(x)
    transitivity, from 10, 18
    requires cos(x) ∈ ℝ: mun:cos-real a := x

20. 0 ≤ sin(x) − cos(x)
    inequalities, from 5, 19
    requires sin(x) ∈ ℝ: mun:sin-real a := x
    requires cos(x) ∈ ℝ: mun:cos-real a := x

21. sin(x)·sin(x − π/2) ≥ 0
    mun:product-nonneg x := sin(x), y := sin(x − π/2), from 5, 10
    requires sin(x) ∈ ℝ: mun:sin-real a := x
    requires sin(x − π/2) ∈ ℝ: mun:sin-real a := x − π/2

22. sin(x)² + cos(x)² = 1
    mun:sin-cos-squares a := x

23. 1 + 2·sin(x)·sin(x − π/2) = (sin(x) − cos(x))²
    algebra, from 17, 22
    requires sin(x) ∈ ℝ: mun:sin-real a := x
    requires sin(x − π/2) ∈ ℝ: mun:sin-real a := x − π/2

24. 1² ≤ 1 + 2·sin(x)·sin(x − π/2)
    inequalities
      sin(x)·sin(x − π/2) ≥ 0                    21
      2·(sin(x)·sin(x − π/2)) ≥ 2·0              multiplying by 2
      2·(sin(x)·sin(x − π/2)) + 1 ≥ 2·0 + 1      adding 1
      1² ≤ 1 + 2·sin(x)·sin(x − π/2)             algebra
    requires sin(x) ∈ ℝ: mun:sin-real a := x
    requires sin(x − π/2) ∈ ℝ: mun:sin-real a := x − π/2

25. 1² ≤ (sin(x) − cos(x))²
    transitivity, from 23, 24
    requires sin(x) ∈ ℝ: mun:sin-real a := x
    requires sin(x − π/2) ∈ ℝ: mun:sin-real a := x − π/2
    requires cos(x) ∈ ℝ: mun:cos-real a := x

26. 1 ≤ sin(x) − cos(x)
    mun:square-le x := 1, y := sin(x) − cos(x), from 20, 25
    requires 0 ≤ 1: arithmetic
    requires sin(x) ∈ ℝ: mun:sin-real a := x
    requires cos(x) ∈ ℝ: mun:cos-real a := x
