theorem an-equation-from-a-difference-with-a-bound-uncited
  note        a = b follows from b − a = 0 alone, a added to both sides, with an uncited a ≤ b in scope that says one of its bounds.
  let a ∈ ℝ    (H1)
  let b ∈ ℝ    (H2)
  assume a ≤ b    (H3)
  assume b − a = 0    (H4)
  then a = b

1.  a = b
    inequalities
      b − a = 0      H4
      b = a          adding a
      a = b          restate

theorem positive-from-a-natural-with-a-bound-uncited
  note        n > 0 follows from n ∈ ℕ alone, with an uncited line saying 1 ≤ n.
  let n ∈ ℕ    (H1)
  then 1 ≤ n and n > 0

1.  1 ≤ n
    inequalities, from H1

2.  n > 0
    inequalities, from H1

3.  1 ≤ n and n > 0
    join 1, 2
