import definition         stdlib/numbers/sqrt
import mundane theorem    stdlib/geometry/distance-nonneg
import mundane theorem    stdlib/numbers/square-nonneg
import definition         stdlib/trigonometry/cos

theorem a-naming-let-with-a-requires-line
  note        A naming let's reason may cite an item asking for a fact
              nothing above the let says, and a requires line under the
              reason gives it, as one under a step does.
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  assume A ≠ B                                                        (H4)
  assume C ≠ B                                                        (H5)
  assume A ≠ C                                                        (H6)
  then (√(√|AB|))² ≥ 0 and cos(∠ABC)² ≥ 0

let r = √(√|AB|), a real number                                       (D1)
    def:sqrt x := √|AB|
    requires |AB| ≥ 0: mun:distance-nonneg P := A, Q := B
    requires √|AB| ∈ ℝ and √|AB| ≥ 0: def:sqrt x := |AB|
    reads the square root of the square root of the distance from A to B

1.  r² ≥ 0
    mun:square-nonneg

2.  (√(√|AB|))² ≥ 0
    calculation
      (√(√|AB|))² = r²     D1
                  ≥ 0      1

3.  cos(∠ABC)² ≥ 0
    mun:square-nonneg x := cos(∠ABC)

4.  (√(√|AB|))² ≥ 0 and cos(∠ABC)² ≥ 0
    join 2, 3
