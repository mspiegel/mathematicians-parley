theorem a-split-against-a-bound-written-otherwise
  note        The side of x ≠ 2 above 2 is denied by 2·x ≤ 4, written another way.
  let x ∈ ℝ    (H1)
  assume 2·x ≤ 4    (H2)
  assume x ≠ 2    (H3)
  then x < 2

1.  x < 2
    inequalities, from H2, H3

theorem an-equation-from-an-equation
  note        An equation claimed is the two bounds it is made of.
  let x ∈ ℝ    (H1)
  assume x = 2    (H2)
  then 2·x = 4

1.  2·x = 4
    inequalities, from H2

theorem a-bound-by-half-an-equation
  note        One equation scaled by 1/2, its denominator cleared.
  let x ∈ ℝ    (H1)
  assume 2·x = 3    (H2)
  then x ≤ 3/2

1.  x ≤ 3/2
    inequalities, from H2
