import definition         stdlib/numbers/rational

theorem a-rational-letter-unfolded
  note        The membership a let says is never cited, and a definition unfolds it all the same.
  let A ∈ ℚ    (H1)
  then there are p ∈ ℤ and q ∈ ℕ with A = p/q

1.  There are p ∈ ℤ and q ∈ ℕ with A = p/q.
    def:rational x := A
