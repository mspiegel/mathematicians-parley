theorem series_remainder :
    (∀ n : ℕ, Real.pi / 4 - (∑ j ∈ Finset.Icc (0 : ℤ) (n : ℤ), ((-1) ^ j / (2 * (j : ℝ) + 1) : ℝ)) = (-1) ^ (n + 1) * (∫ t in 0..1, (t ^ (2 * (n + 1)) / (1 + t ^ 2) : ℝ))) := by
  -- 1. membership
  have r682_1 : ∀ j : ℕ, 0 < 2 * (j : ℤ) + 1 := by intro j; (first | exact (Parley.Items.Stdlib.Numbers.mun_nat0_successor (k := 2 * j)) | exact ((Parley.Items.Stdlib.Numbers.mun_nat0_successor (k := 2 * j))).symm | simpa using (Parley.Items.Stdlib.Numbers.mun_nat0_successor (k := 2 * j)) | exact_mod_cast (Parley.Items.Stdlib.Numbers.mun_nat0_successor (k := 2 * j)) | (have h := (Parley.Items.Stdlib.Numbers.mun_nat0_successor (k := 2 * j)); parley_side))
  -- 2. induction on n starting at 0
  have s2 : ∀ n : ℕ, Real.pi / 4 - (∑ j ∈ Finset.Icc (0 : ℤ) (n : ℤ), ((-1) ^ j / (2 * (j : ℝ) + 1) : ℝ)) = (-1) ^ (n + 1) * (∫ t in 0..1, (t ^ (2 * (n + 1)) / (1 + t ^ 2) : ℝ)) := by
    intro n
    induction n with
    | zero =>
      -- 2.1. calculation
      have s2_1 : (∑ j ∈ Finset.Icc (0 : ℤ) (0 : ℤ), ((-1) ^ j / (2 * (j : ℚ) + 1) : ℚ)) = 1 := by
        calc (∑ j ∈ Finset.Icc (0 : ℤ) (0 : ℤ), ((-1) ^ j / (2 * (j : ℚ) + 1) : ℚ)) = (-1) ^ 0 / (2 * 0 + 1) := by first | linear_combination (norm := parley_norm) (Parley.Items.Stdlib.Sums.mun_sum_single (t := (fun j : ℤ => (-1) ^ j / (2 * (j : ℚ) + 1))) (a := (0 : ℤ))) | (have h := (Parley.Items.Stdlib.Sums.mun_sum_single (t := (fun j : ℤ => (-1) ^ j / (2 * (j : ℚ) + 1))) (a := (0 : ℤ))); (try push_cast at h); (try push_cast); linear_combination (norm := parley_norm) h) | (have h := (Parley.Items.Stdlib.Sums.mun_sum_single (t := (fun j : ℤ => (-1) ^ j / (2 * (j : ℚ) + 1))) (a := (0 : ℤ))); (try push_cast at h); (try push_cast); linear_combination (norm := parley_norm) -h) | exact_mod_cast (Parley.Items.Stdlib.Sums.mun_sum_single (t := (fun j : ℤ => (-1) ^ j / (2 * (j : ℚ) + 1))) (a := (0 : ℤ))) | exact_mod_cast ((Parley.Items.Stdlib.Sums.mun_sum_single (t := (fun j : ℤ => (-1) ^ j / (2 * (j : ℚ) + 1))) (a := (0 : ℤ)))).symm | (have h := (Parley.Items.Stdlib.Sums.mun_sum_single (t := (fun j : ℤ => (-1) ^ j / (2 * (j : ℚ) + 1))) (a := (0 : ℤ))); rify; linear_combination (norm := parley_norm) h) | (have h := (Parley.Items.Stdlib.Sums.mun_sum_single (t := (fun j : ℤ => (-1) ^ j / (2 * (j : ℚ) + 1))) (a := (0 : ℤ))); qify; linear_combination (norm := parley_norm) h) | (have h := (Parley.Items.Stdlib.Sums.mun_sum_single (t := (fun j : ℤ => (-1) ^ j / (2 * (j : ℚ) + 1))) (a := (0 : ℤ))); parley_int_power h) | (have h := (Parley.Items.Stdlib.Sums.mun_sum_single (t := (fun j : ℤ => (-1) ^ j / (2 * (j : ℚ) + 1))) (a := (0 : ℤ))); parley_side)
          _ = 1 := by norm_num
      -- 2.2. thm:integral-recurrence n := 0
      have s2_2 : (∫ t in 0..1, (t ^ (2 * 1) / (1 + t ^ 2) : ℝ)) = 1 / (2 * 0 + 1) - (∫ t in 0..1, (t ^ (2 * 0) / (1 + t ^ 2) : ℝ)) := by first | linear_combination (norm := parley_norm) (Parley.Proofs.Wiedijk.Leibniz.IntegralRecurrence.integral_recurrence (n := 0)) | (have h := (Parley.Proofs.Wiedijk.Leibniz.IntegralRecurrence.integral_recurrence (n := 0)); (try push_cast at h); (try push_cast); linear_combination (norm := parley_norm) h) | (have h := (Parley.Proofs.Wiedijk.Leibniz.IntegralRecurrence.integral_recurrence (n := 0)); (try push_cast at h); (try push_cast); linear_combination (norm := parley_norm) -h) | exact_mod_cast (Parley.Proofs.Wiedijk.Leibniz.IntegralRecurrence.integral_recurrence (n := 0)) | exact_mod_cast ((Parley.Proofs.Wiedijk.Leibniz.IntegralRecurrence.integral_recurrence (n := 0))).symm | (have h := (Parley.Proofs.Wiedijk.Leibniz.IntegralRecurrence.integral_recurrence (n := 0)); rify; linear_combination (norm := parley_norm) h) | (have h := (Parley.Proofs.Wiedijk.Leibniz.IntegralRecurrence.integral_recurrence (n := 0)); qify; linear_combination (norm := parley_norm) h) | (have h := (Parley.Proofs.Wiedijk.Leibniz.IntegralRecurrence.integral_recurrence (n := 0)); parley_int_power h) | (have h := (Parley.Proofs.Wiedijk.Leibniz.IntegralRecurrence.integral_recurrence (n := 0)); parley_side)
      -- 2.3. substitute
      have s2_3 : (∫ t in 0..1, (t ^ (2 * 1) / (1 + t ^ 2) : ℝ)) = 1 / (2 * 0 + 1) - Real.pi / 4 := by
        have c1 : (∫ t in 0..1, (t ^ (2 * 0) / (1 + t ^ 2) : ℝ)) = Real.pi / 4 := by first | linear_combination (norm := parley_norm) Parley.Proofs.Wiedijk.Leibniz.IntegralOfArctanDerivative.integral_of_arctan_derivative | (have h := Parley.Proofs.Wiedijk.Leibniz.IntegralOfArctanDerivative.integral_of_arctan_derivative; (try push_cast at h); (try push_cast); linear_combination (norm := parley_norm) h) | (have h := Parley.Proofs.Wiedijk.Leibniz.IntegralOfArctanDerivative.integral_of_arctan_derivative; (try push_cast at h); (try push_cast); linear_combination (norm := parley_norm) -h) | exact_mod_cast Parley.Proofs.Wiedijk.Leibniz.IntegralOfArctanDerivative.integral_of_arctan_derivative | exact_mod_cast (Parley.Proofs.Wiedijk.Leibniz.IntegralOfArctanDerivative.integral_of_arctan_derivative).symm | (have h := Parley.Proofs.Wiedijk.Leibniz.IntegralOfArctanDerivative.integral_of_arctan_derivative; rify; linear_combination (norm := parley_norm) h) | (have h := Parley.Proofs.Wiedijk.Leibniz.IntegralOfArctanDerivative.integral_of_arctan_derivative; qify; linear_combination (norm := parley_norm) h) | (have h := Parley.Proofs.Wiedijk.Leibniz.IntegralOfArctanDerivative.integral_of_arctan_derivative; parley_int_power h) | (have h := Parley.Proofs.Wiedijk.Leibniz.IntegralOfArctanDerivative.integral_of_arctan_derivative; parley_side)
        have row1 : (∫ t in 0..1, (t ^ (2 * 1) / (1 + t ^ 2) : ℝ)) = 1 / (2 * 0 + 1) - Real.pi / 4 := by parley_subst_at c1 s2_2
        exact row1
      -- 2.4. calculation
      have s2_4 : Real.pi / 4 - (∑ j ∈ Finset.Icc (0 : ℤ) (0 : ℤ), ((-1) ^ j / (2 * (j : ℝ) + 1) : ℝ)) = -1 * (∫ t in 0..1, (t ^ (2 * 1) / (1 + t ^ 2) : ℝ)) := by
        calc Real.pi / 4 - (∑ j ∈ Finset.Icc (0 : ℤ) (0 : ℤ), ((-1) ^ j / (2 * (j : ℝ) + 1) : ℝ)) = Real.pi / 4 - 1 := by
              have s2_1_w : (∑ j ∈ Finset.Icc (0 : ℤ) (0 : ℤ), ((-1) ^ j / (2 * (j : ℝ) + 1) : ℝ)) = 1 := by have h := congrArg (fun x : ℚ => (x : ℝ)) s2_1; push_cast at h; linear_combination (norm := parley_norm) h
              first | parley_subst s2_1_w | parley_subst s2_1
          _ = -1 * (∫ t in 0..1, (t ^ (2 * 1) / (1 + t ^ 2) : ℝ)) := by linear_combination (norm := parley_norm) ((16) / ((4) * (4))) * s2_3
      all_goals parley_side
    | succ n hIH =>
      -- 2.5. mun:sum-last, from 1
      have s2_5 : (∑ j ∈ Finset.Icc (0 : ℤ) ((n : ℤ) + 1), ((-1) ^ j / (2 * (j : ℚ) + 1) : ℚ)) = (∑ j ∈ Finset.Icc (0 : ℤ) (n : ℤ), ((-1) ^ j / (2 * (j : ℚ) + 1) : ℚ)) + (-1) ^ (n + 1) / (2 * ((n : ℚ) + 1) + 1) := by first | linear_combination (norm := parley_norm) (Parley.Items.Stdlib.Sums.mun_sum_last (t := (fun j : ℤ => (-1) ^ j / (2 * (j : ℚ) + 1))) (n := n)) | (have h := (Parley.Items.Stdlib.Sums.mun_sum_last (t := (fun j : ℤ => (-1) ^ j / (2 * (j : ℚ) + 1))) (n := n)); (try push_cast at h); (try push_cast); linear_combination (norm := parley_norm) h) | (have h := (Parley.Items.Stdlib.Sums.mun_sum_last (t := (fun j : ℤ => (-1) ^ j / (2 * (j : ℚ) + 1))) (n := n)); (try push_cast at h); (try push_cast); linear_combination (norm := parley_norm) -h) | exact_mod_cast (Parley.Items.Stdlib.Sums.mun_sum_last (t := (fun j : ℤ => (-1) ^ j / (2 * (j : ℚ) + 1))) (n := n)) | exact_mod_cast ((Parley.Items.Stdlib.Sums.mun_sum_last (t := (fun j : ℤ => (-1) ^ j / (2 * (j : ℚ) + 1))) (n := n))).symm | (have h := (Parley.Items.Stdlib.Sums.mun_sum_last (t := (fun j : ℤ => (-1) ^ j / (2 * (j : ℚ) + 1))) (n := n)); rify; linear_combination (norm := parley_norm) h) | (have h := (Parley.Items.Stdlib.Sums.mun_sum_last (t := (fun j : ℤ => (-1) ^ j / (2 * (j : ℚ) + 1))) (n := n)); qify; linear_combination (norm := parley_norm) h) | (have h := (Parley.Items.Stdlib.Sums.mun_sum_last (t := (fun j : ℤ => (-1) ^ j / (2 * (j : ℚ) + 1))) (n := n)); parley_int_power h) | (have h := (Parley.Items.Stdlib.Sums.mun_sum_last (t := (fun j : ℤ => (-1) ^ j / (2 * (j : ℚ) + 1))) (n := n)); parley_side)
      -- 2.6. thm:integral-recurrence n := n + 1
      have s2_6 : (∫ t in 0..1, (t ^ (2 * (n + 1 + 1)) / (1 + t ^ 2) : ℝ)) = 1 / (2 * ((n : ℝ) + 1) + 1) - (∫ t in 0..1, (t ^ (2 * (n + 1)) / (1 + t ^ 2) : ℝ)) := by first | linear_combination (norm := parley_norm) (Parley.Proofs.Wiedijk.Leibniz.IntegralRecurrence.integral_recurrence (n := n + 1)) | (have h := (Parley.Proofs.Wiedijk.Leibniz.IntegralRecurrence.integral_recurrence (n := n + 1)); (try push_cast at h); (try push_cast); linear_combination (norm := parley_norm) h) | (have h := (Parley.Proofs.Wiedijk.Leibniz.IntegralRecurrence.integral_recurrence (n := n + 1)); (try push_cast at h); (try push_cast); linear_combination (norm := parley_norm) -h) | exact_mod_cast (Parley.Proofs.Wiedijk.Leibniz.IntegralRecurrence.integral_recurrence (n := n + 1)) | exact_mod_cast ((Parley.Proofs.Wiedijk.Leibniz.IntegralRecurrence.integral_recurrence (n := n + 1))).symm | (have h := (Parley.Proofs.Wiedijk.Leibniz.IntegralRecurrence.integral_recurrence (n := n + 1)); rify; linear_combination (norm := parley_norm) h) | (have h := (Parley.Proofs.Wiedijk.Leibniz.IntegralRecurrence.integral_recurrence (n := n + 1)); qify; linear_combination (norm := parley_norm) h) | (have h := (Parley.Proofs.Wiedijk.Leibniz.IntegralRecurrence.integral_recurrence (n := n + 1)); parley_int_power h) | (have h := (Parley.Proofs.Wiedijk.Leibniz.IntegralRecurrence.integral_recurrence (n := n + 1)); parley_side)
      -- 2.7. mun:exponent-step a := −1, m := n + 1
      have s2_7 : ((-1) ^ (n + 1 + 1) : ℤ) = (-1) ^ (n + 1) * -1 := by first | linear_combination (norm := parley_norm) (Parley.Items.Stdlib.Numbers.mun_exponent_step (a := (-1 : ℤ)) (m := n + 1)) | (have h := (Parley.Items.Stdlib.Numbers.mun_exponent_step (a := (-1 : ℤ)) (m := n + 1)); (try push_cast at h); (try push_cast); linear_combination (norm := parley_norm) h) | (have h := (Parley.Items.Stdlib.Numbers.mun_exponent_step (a := (-1 : ℤ)) (m := n + 1)); (try push_cast at h); (try push_cast); linear_combination (norm := parley_norm) -h) | exact_mod_cast (Parley.Items.Stdlib.Numbers.mun_exponent_step (a := (-1 : ℤ)) (m := n + 1)) | exact_mod_cast ((Parley.Items.Stdlib.Numbers.mun_exponent_step (a := (-1 : ℤ)) (m := n + 1))).symm | (have h := (Parley.Items.Stdlib.Numbers.mun_exponent_step (a := (-1 : ℤ)) (m := n + 1)); rify; linear_combination (norm := parley_norm) h) | (have h := (Parley.Items.Stdlib.Numbers.mun_exponent_step (a := (-1 : ℤ)) (m := n + 1)); qify; linear_combination (norm := parley_norm) h) | (have h := (Parley.Items.Stdlib.Numbers.mun_exponent_step (a := (-1 : ℤ)) (m := n + 1)); parley_int_power h) | (have h := (Parley.Items.Stdlib.Numbers.mun_exponent_step (a := (-1 : ℤ)) (m := n + 1)); parley_side)
      -- 2.8. calculation
      have r721_2 : 0 < 2 * ((n : ℤ) + 1) + 1 := by first | exact (Parley.Items.Stdlib.Numbers.mun_nat0_successor (k := 2 * (n + 1))) | exact ((Parley.Items.Stdlib.Numbers.mun_nat0_successor (k := 2 * (n + 1)))).symm | simpa using (Parley.Items.Stdlib.Numbers.mun_nat0_successor (k := 2 * (n + 1))) | exact_mod_cast (Parley.Items.Stdlib.Numbers.mun_nat0_successor (k := 2 * (n + 1))) | (have h := (Parley.Items.Stdlib.Numbers.mun_nat0_successor (k := 2 * (n + 1))); parley_side)
      have s2_8 : Real.pi / 4 - (∑ j ∈ Finset.Icc (0 : ℤ) ((n : ℤ) + 1), ((-1) ^ j / (2 * (j : ℝ) + 1) : ℝ)) = (-1) ^ (n + 1 + 1) * (∫ t in 0..1, (t ^ (2 * (n + 1 + 1)) / (1 + t ^ 2) : ℝ)) := by
        calc Real.pi / 4 - (∑ j ∈ Finset.Icc (0 : ℤ) ((n : ℤ) + 1), ((-1) ^ j / (2 * (j : ℝ) + 1) : ℝ)) = Real.pi / 4 - ((∑ j ∈ Finset.Icc (0 : ℤ) (n : ℤ), ((-1) ^ j / (2 * (j : ℝ) + 1) : ℝ)) + (-1) ^ (n + 1) / (2 * ((n : ℝ) + 1) + 1)) := by
              have s2_5_w : (∑ j ∈ Finset.Icc (0 : ℤ) ((n : ℤ) + 1), ((-1) ^ j / (2 * (j : ℝ) + 1) : ℝ)) = (∑ j ∈ Finset.Icc (0 : ℤ) (n : ℤ), ((-1) ^ j / (2 * (j : ℝ) + 1) : ℝ)) + (-1) ^ (n + 1) / (2 * ((n : ℝ) + 1) + 1) := by have h := congrArg (fun x : ℚ => (x : ℝ)) s2_5; push_cast at h; linear_combination (norm := parley_norm) h
              first | parley_subst s2_5_w | parley_subst s2_5
          _ = (-1) ^ (n + 1) * (∫ t in 0..1, (t ^ (2 * (n + 1)) / (1 + t ^ 2) : ℝ)) - (-1) ^ (n + 1) / (2 * ((n : ℝ) + 1) + 1) := by linear_combination (norm := parley_field) ((4) / ((4))) * hIH
          _ = (-1) ^ (n + 1) * -1 * (∫ t in 0..1, (t ^ (2 * (n + 1 + 1)) / (1 + t ^ 2) : ℝ)) := by linear_combination (norm := parley_field) ((-1) ^ (n + 1)) * s2_6
          _ = (-1) ^ (n + 1 + 1) * (∫ t in 0..1, (t ^ (2 * (n + 1 + 1)) / (1 + t ^ 2) : ℝ)) := by
              have s2_7_w : ((-1) ^ (n + 1 + 1) : ℝ) = (-1) ^ (n + 1) * -1 := by have h := congrArg (fun x : ℤ => (x : ℝ)) s2_7; push_cast at h; linear_combination (norm := parley_norm) h
              first | parley_subst s2_7_w | parley_subst s2_7
      all_goals parley_side
  all_goals exact s2

