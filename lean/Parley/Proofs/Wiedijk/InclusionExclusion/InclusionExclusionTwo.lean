  -- 2. mun:finite-part X := B, Y := B ∖ A, from H4, 1
  have s2 : (B \ A).Finite := by first | exact (Parley.Items.Stdlib.Counting.mun_finite_part (X := B) (Y := B \ A) hH4 s1) | exact ((Parley.Items.Stdlib.Counting.mun_finite_part (X := B) (Y := B \ A) hH4 s1)).symm | simpa using (Parley.Items.Stdlib.Counting.mun_finite_part (X := B) (Y := B \ A) hH4 s1) | exact_mod_cast (Parley.Items.Stdlib.Counting.mun_finite_part (X := B) (Y := B \ A) hH4 s1) | (have h := (Parley.Items.Stdlib.Counting.mun_finite_part (X := B) (Y := B \ A) hH4 s1); parley_set_side)
  -- 3. mun:intersection-subset Y := A, Z := B
  have s3 : A ∩ B ⊆ A := by first | exact (Parley.Items.Stdlib.Sets.mun_intersection_subset (Y := A) (Z := B)) | exact ((Parley.Items.Stdlib.Sets.mun_intersection_subset (Y := A) (Z := B))).symm | simpa using (Parley.Items.Stdlib.Sets.mun_intersection_subset (Y := A) (Z := B)) | exact_mod_cast (Parley.Items.Stdlib.Sets.mun_intersection_subset (Y := A) (Z := B)) | (have h := (Parley.Items.Stdlib.Sets.mun_intersection_subset (Y := A) (Z := B)); parley_set_side)
  -- 4. mun:finite-part X := A, Y := A ∩ B, from H3, 3
  have s4 : (A ∩ B).Finite := by first | exact (Parley.Items.Stdlib.Counting.mun_finite_part (X := A) (Y := A ∩ B) hH3 s3) | exact ((Parley.Items.Stdlib.Counting.mun_finite_part (X := A) (Y := A ∩ B) hH3 s3)).symm | simpa using (Parley.Items.Stdlib.Counting.mun_finite_part (X := A) (Y := A ∩ B) hH3 s3) | exact_mod_cast (Parley.Items.Stdlib.Counting.mun_finite_part (X := A) (Y := A ∩ B) hH3 s3) | (have h := (Parley.Items.Stdlib.Counting.mun_finite_part (X := A) (Y := A ∩ B) hH3 s3); parley_set_side)
  -- 5. mun:card-nat0 X := A, from H3
  have s5 : 0 ≤ (A.ncard : ℤ) := by first | exact (Parley.Items.Stdlib.Counting.mun_card_nat0 (X := A) hH3) | exact ((Parley.Items.Stdlib.Counting.mun_card_nat0 (X := A) hH3)).symm | simpa using (Parley.Items.Stdlib.Counting.mun_card_nat0 (X := A) hH3) | exact_mod_cast (Parley.Items.Stdlib.Counting.mun_card_nat0 (X := A) hH3) | (have h := (Parley.Items.Stdlib.Counting.mun_card_nat0 (X := A) hH3); parley_set_side)
  -- 6. mun:card-nat0 X := B ∖ A, from 2
  have s6 : 0 ≤ ((B \ A).ncard : ℤ) := by first | exact (Parley.Items.Stdlib.Counting.mun_card_nat0 (X := B \ A) s2) | exact ((Parley.Items.Stdlib.Counting.mun_card_nat0 (X := B \ A) s2)).symm | simpa using (Parley.Items.Stdlib.Counting.mun_card_nat0 (X := B \ A) s2) | exact_mod_cast (Parley.Items.Stdlib.Counting.mun_card_nat0 (X := B \ A) s2) | (have h := (Parley.Items.Stdlib.Counting.mun_card_nat0 (X := B \ A) s2); parley_set_side)
  -- 7. mun:card-nat0 X := A ∩ B, from 4
  have s7 : 0 ≤ ((A ∩ B).ncard : ℤ) := by first | exact (Parley.Items.Stdlib.Counting.mun_card_nat0 (X := A ∩ B) s4) | exact ((Parley.Items.Stdlib.Counting.mun_card_nat0 (X := A ∩ B) s4)).symm | simpa using (Parley.Items.Stdlib.Counting.mun_card_nat0 (X := A ∩ B) s4) | exact_mod_cast (Parley.Items.Stdlib.Counting.mun_card_nat0 (X := A ∩ B) s4) | (have h := (Parley.Items.Stdlib.Counting.mun_card_nat0 (X := A ∩ B) s4); parley_set_side)
  -- 8. mun:disjoint-difference Y := A, Z := B
  have s8 : A ∩ (B \ A) = ∅ := by first | exact (Parley.Items.Stdlib.Sets.mun_disjoint_difference (Y := A) (Z := B)) | exact ((Parley.Items.Stdlib.Sets.mun_disjoint_difference (Y := A) (Z := B))).symm | simpa using (Parley.Items.Stdlib.Sets.mun_disjoint_difference (Y := A) (Z := B)) | exact_mod_cast (Parley.Items.Stdlib.Sets.mun_disjoint_difference (Y := A) (Z := B)) | (have h := (Parley.Items.Stdlib.Sets.mun_disjoint_difference (Y := A) (Z := B)); parley_set_side)
  -- 9. mun:card-disjoint-union X := A, Y := B ∖ A, m := |A|, n := |B ∖ A|, from 5, 6, 8
