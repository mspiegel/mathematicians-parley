  -- 14. substitute B ∩ A = A ∩ B (line 12) into line 13
  have s14 : (A ∩ B) ∩ (B \ A) = ∅ := by parley_subst_at s12 s13
  -- 15. mun:intersection-and-difference Y := B, Z := A
  have s15 : B ∩ A ∪ B \ A = B := by first | exact (Parley.Items.Stdlib.Sets.mun_intersection_and_difference (Y := B) (Z := A)) | exact ((Parley.Items.Stdlib.Sets.mun_intersection_and_difference (Y := B) (Z := A))).symm | simpa using (Parley.Items.Stdlib.Sets.mun_intersection_and_difference (Y := B) (Z := A)) | exact_mod_cast (Parley.Items.Stdlib.Sets.mun_intersection_and_difference (Y := B) (Z := A)) | (have h := (Parley.Items.Stdlib.Sets.mun_intersection_and_difference (Y := B) (Z := A)); parley_set_side)
