  -- 10. mun:union-difference Y := A, Z := B
  have s10 : A ∪ B \ A = A ∪ B := by first | exact (Parley.Items.Stdlib.Sets.mun_union_difference (Y := A) (Z := B)) | exact ((Parley.Items.Stdlib.Sets.mun_union_difference (Y := A) (Z := B))).symm | simpa using (Parley.Items.Stdlib.Sets.mun_union_difference (Y := A) (Z := B)) | exact_mod_cast (Parley.Items.Stdlib.Sets.mun_union_difference (Y := A) (Z := B)) | (have h := (Parley.Items.Stdlib.Sets.mun_union_difference (Y := A) (Z := B)); parley_set_side)
  -- 11. substitute A ∪ (B ∖ A) = A ∪ B (line 10) into line 9
  have s11 : (A ∪ B).encard = A.encard + (B \ A).encard := by parley_subst_at s10 s9
  -- 12. mun:intersection-commutes Y := B, Z := A
