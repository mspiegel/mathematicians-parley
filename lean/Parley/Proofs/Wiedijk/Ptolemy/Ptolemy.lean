theorem ptolemy (a : ℝ) (b : ℝ) (c : ℝ) (d : ℝ) (hH5 : a + b + c + d = Real.pi) :
    Real.sin a * Real.sin b + Real.sin c * Real.sin d = Real.sin (b + c) * Real.sin (a + c) := by
  -- 1. algebra, from H5
  have s1 : d = Real.pi + -(a + b + c) := by linear_combination (norm := parley_norm) hH5
  -- 2. mun:sin-negative a := a + b + c
  have s2 : Real.sin (-(a + b + c)) = -Real.sin (a + b + c) := by first | linear_combination (norm := parley_norm) (Parley.Items.Stdlib.Trigonometry.mun_sin_negative (a := (a : ℂ) + (b : ℂ) + (c : ℂ))) | (have h := (Parley.Items.Stdlib.Trigonometry.mun_sin_negative (a := (a : ℂ) + (b : ℂ) + (c : ℂ))); (try push_cast at h); (try push_cast); linear_combination (norm := parley_norm) h) | (have h := (Parley.Items.Stdlib.Trigonometry.mun_sin_negative (a := (a : ℂ) + (b : ℂ) + (c : ℂ))); (try push_cast at h); (try push_cast); linear_combination (norm := parley_norm) -h) | exact_mod_cast (Parley.Items.Stdlib.Trigonometry.mun_sin_negative (a := (a : ℂ) + (b : ℂ) + (c : ℂ))) | exact_mod_cast ((Parley.Items.Stdlib.Trigonometry.mun_sin_negative (a := (a : ℂ) + (b : ℂ) + (c : ℂ)))).symm | (have h := (Parley.Items.Stdlib.Trigonometry.mun_sin_negative (a := (a : ℂ) + (b : ℂ) + (c : ℂ))); rify; linear_combination (norm := parley_norm) h) | (have h := (Parley.Items.Stdlib.Trigonometry.mun_sin_negative (a := (a : ℂ) + (b : ℂ) + (c : ℂ))); qify; linear_combination (norm := parley_norm) h) | (have h := (Parley.Items.Stdlib.Trigonometry.mun_sin_negative (a := (a : ℂ) + (b : ℂ) + (c : ℂ))); parley_int_power h) | (have h := (Parley.Items.Stdlib.Trigonometry.mun_sin_negative (a := (a : ℂ) + (b : ℂ) + (c : ℂ))); parley_of_complex h) | (have h := (Parley.Items.Stdlib.Trigonometry.mun_sin_negative (a := (a : ℂ) + (b : ℂ) + (c : ℂ))); parley_side)
  -- 3. calculation
  have s3 : Real.sin d = Real.sin (a + b + c) := by
    calc Real.sin d = Real.sin (Real.pi + -(a + b + c)) := by parley_subst s1
      _ = Real.sin Real.pi * Real.cos (-(a + b + c)) + Real.cos Real.pi * Real.sin (-(a + b + c)) := by first | linear_combination (norm := parley_norm) (Parley.Items.Stdlib.Trigonometry.thm_sin_add (a := (Real.pi : ℂ)) (b := -((a : ℂ) + (b : ℂ) + (c : ℂ)))) | (have h := (Parley.Items.Stdlib.Trigonometry.thm_sin_add (a := (Real.pi : ℂ)) (b := -((a : ℂ) + (b : ℂ) + (c : ℂ)))); (try push_cast at h); (try push_cast); linear_combination (norm := parley_norm) h) | (have h := (Parley.Items.Stdlib.Trigonometry.thm_sin_add (a := (Real.pi : ℂ)) (b := -((a : ℂ) + (b : ℂ) + (c : ℂ)))); (try push_cast at h); (try push_cast); linear_combination (norm := parley_norm) -h) | exact_mod_cast (Parley.Items.Stdlib.Trigonometry.thm_sin_add (a := (Real.pi : ℂ)) (b := -((a : ℂ) + (b : ℂ) + (c : ℂ)))) | exact_mod_cast ((Parley.Items.Stdlib.Trigonometry.thm_sin_add (a := (Real.pi : ℂ)) (b := -((a : ℂ) + (b : ℂ) + (c : ℂ))))).symm | (have h := (Parley.Items.Stdlib.Trigonometry.thm_sin_add (a := (Real.pi : ℂ)) (b := -((a : ℂ) + (b : ℂ) + (c : ℂ)))); rify; linear_combination (norm := parley_norm) h) | (have h := (Parley.Items.Stdlib.Trigonometry.thm_sin_add (a := (Real.pi : ℂ)) (b := -((a : ℂ) + (b : ℂ) + (c : ℂ)))); qify; linear_combination (norm := parley_norm) h) | (have h := (Parley.Items.Stdlib.Trigonometry.thm_sin_add (a := (Real.pi : ℂ)) (b := -((a : ℂ) + (b : ℂ) + (c : ℂ)))); parley_int_power h) | (have h := (Parley.Items.Stdlib.Trigonometry.thm_sin_add (a := (Real.pi : ℂ)) (b := -((a : ℂ) + (b : ℂ) + (c : ℂ)))); parley_of_complex h) | (have h := (Parley.Items.Stdlib.Trigonometry.thm_sin_add (a := (Real.pi : ℂ)) (b := -((a : ℂ) + (b : ℂ) + (c : ℂ)))); parley_side)
      _ = 0 * Real.cos (-(a + b + c)) + Real.cos Real.pi * Real.sin (-(a + b + c)) := by parley_real
      _ = 0 * Real.cos (-(a + b + c)) + -1 * Real.sin (-(a + b + c)) := by parley_real
      _ = 0 * Real.cos (-(a + b + c)) + -1 * -Real.sin (a + b + c) := by parley_subst s2
      _ = Real.sin (a + b + c) := by parley_ring
  -- 4. thm:sin-add a := a + b, b := c
  have s4 : Real.sin (a + b + c) = Real.sin (a + b) * Real.cos c + Real.cos (a + b) * Real.sin c := by first | linear_combination (norm := parley_norm) (Parley.Items.Stdlib.Trigonometry.thm_sin_add (a := (a : ℂ) + (b : ℂ)) (b := (c : ℂ))) | (have h := (Parley.Items.Stdlib.Trigonometry.thm_sin_add (a := (a : ℂ) + (b : ℂ)) (b := (c : ℂ))); (try push_cast at h); (try push_cast); linear_combination (norm := parley_norm) h) | (have h := (Parley.Items.Stdlib.Trigonometry.thm_sin_add (a := (a : ℂ) + (b : ℂ)) (b := (c : ℂ))); (try push_cast at h); (try push_cast); linear_combination (norm := parley_norm) -h) | exact_mod_cast (Parley.Items.Stdlib.Trigonometry.thm_sin_add (a := (a : ℂ) + (b : ℂ)) (b := (c : ℂ))) | exact_mod_cast ((Parley.Items.Stdlib.Trigonometry.thm_sin_add (a := (a : ℂ) + (b : ℂ)) (b := (c : ℂ)))).symm | (have h := (Parley.Items.Stdlib.Trigonometry.thm_sin_add (a := (a : ℂ) + (b : ℂ)) (b := (c : ℂ))); rify; linear_combination (norm := parley_norm) h) | (have h := (Parley.Items.Stdlib.Trigonometry.thm_sin_add (a := (a : ℂ) + (b : ℂ)) (b := (c : ℂ))); qify; linear_combination (norm := parley_norm) h) | (have h := (Parley.Items.Stdlib.Trigonometry.thm_sin_add (a := (a : ℂ) + (b : ℂ)) (b := (c : ℂ))); parley_int_power h) | (have h := (Parley.Items.Stdlib.Trigonometry.thm_sin_add (a := (a : ℂ) + (b : ℂ)) (b := (c : ℂ))); parley_of_complex h) | (have h := (Parley.Items.Stdlib.Trigonometry.thm_sin_add (a := (a : ℂ) + (b : ℂ)) (b := (c : ℂ))); parley_side)
  -- 5. thm:sin-add
  have s5 : Real.sin (a + b) = Real.sin a * Real.cos b + Real.cos a * Real.sin b := by first | linear_combination (norm := parley_norm) (Parley.Items.Stdlib.Trigonometry.thm_sin_add (a := (a : ℂ)) (b := (b : ℂ))) | (have h := (Parley.Items.Stdlib.Trigonometry.thm_sin_add (a := (a : ℂ)) (b := (b : ℂ))); (try push_cast at h); (try push_cast); linear_combination (norm := parley_norm) h) | (have h := (Parley.Items.Stdlib.Trigonometry.thm_sin_add (a := (a : ℂ)) (b := (b : ℂ))); (try push_cast at h); (try push_cast); linear_combination (norm := parley_norm) -h) | exact_mod_cast (Parley.Items.Stdlib.Trigonometry.thm_sin_add (a := (a : ℂ)) (b := (b : ℂ))) | exact_mod_cast ((Parley.Items.Stdlib.Trigonometry.thm_sin_add (a := (a : ℂ)) (b := (b : ℂ)))).symm | (have h := (Parley.Items.Stdlib.Trigonometry.thm_sin_add (a := (a : ℂ)) (b := (b : ℂ))); rify; linear_combination (norm := parley_norm) h) | (have h := (Parley.Items.Stdlib.Trigonometry.thm_sin_add (a := (a : ℂ)) (b := (b : ℂ))); qify; linear_combination (norm := parley_norm) h) | (have h := (Parley.Items.Stdlib.Trigonometry.thm_sin_add (a := (a : ℂ)) (b := (b : ℂ))); parley_int_power h) | (have h := (Parley.Items.Stdlib.Trigonometry.thm_sin_add (a := (a : ℂ)) (b := (b : ℂ))); parley_of_complex h) | (have h := (Parley.Items.Stdlib.Trigonometry.thm_sin_add (a := (a : ℂ)) (b := (b : ℂ))); parley_side)
  -- 6. thm:cos-add
  have s6 : Real.cos (a + b) = Real.cos a * Real.cos b - Real.sin a * Real.sin b := by first | linear_combination (norm := parley_norm) (Parley.Items.Stdlib.Trigonometry.thm_cos_add (a := (a : ℂ)) (b := (b : ℂ))) | (have h := (Parley.Items.Stdlib.Trigonometry.thm_cos_add (a := (a : ℂ)) (b := (b : ℂ))); (try push_cast at h); (try push_cast); linear_combination (norm := parley_norm) h) | (have h := (Parley.Items.Stdlib.Trigonometry.thm_cos_add (a := (a : ℂ)) (b := (b : ℂ))); (try push_cast at h); (try push_cast); linear_combination (norm := parley_norm) -h) | exact_mod_cast (Parley.Items.Stdlib.Trigonometry.thm_cos_add (a := (a : ℂ)) (b := (b : ℂ))) | exact_mod_cast ((Parley.Items.Stdlib.Trigonometry.thm_cos_add (a := (a : ℂ)) (b := (b : ℂ)))).symm | (have h := (Parley.Items.Stdlib.Trigonometry.thm_cos_add (a := (a : ℂ)) (b := (b : ℂ))); rify; linear_combination (norm := parley_norm) h) | (have h := (Parley.Items.Stdlib.Trigonometry.thm_cos_add (a := (a : ℂ)) (b := (b : ℂ))); qify; linear_combination (norm := parley_norm) h) | (have h := (Parley.Items.Stdlib.Trigonometry.thm_cos_add (a := (a : ℂ)) (b := (b : ℂ))); parley_int_power h) | (have h := (Parley.Items.Stdlib.Trigonometry.thm_cos_add (a := (a : ℂ)) (b := (b : ℂ))); parley_of_complex h) | (have h := (Parley.Items.Stdlib.Trigonometry.thm_cos_add (a := (a : ℂ)) (b := (b : ℂ))); parley_side)
  -- 7. thm:sin-add a := b, b := c
  have s7 : Real.sin (b + c) = Real.sin b * Real.cos c + Real.cos b * Real.sin c := by first | linear_combination (norm := parley_norm) (Parley.Items.Stdlib.Trigonometry.thm_sin_add (a := (b : ℂ)) (b := (c : ℂ))) | (have h := (Parley.Items.Stdlib.Trigonometry.thm_sin_add (a := (b : ℂ)) (b := (c : ℂ))); (try push_cast at h); (try push_cast); linear_combination (norm := parley_norm) h) | (have h := (Parley.Items.Stdlib.Trigonometry.thm_sin_add (a := (b : ℂ)) (b := (c : ℂ))); (try push_cast at h); (try push_cast); linear_combination (norm := parley_norm) -h) | exact_mod_cast (Parley.Items.Stdlib.Trigonometry.thm_sin_add (a := (b : ℂ)) (b := (c : ℂ))) | exact_mod_cast ((Parley.Items.Stdlib.Trigonometry.thm_sin_add (a := (b : ℂ)) (b := (c : ℂ)))).symm | (have h := (Parley.Items.Stdlib.Trigonometry.thm_sin_add (a := (b : ℂ)) (b := (c : ℂ))); rify; linear_combination (norm := parley_norm) h) | (have h := (Parley.Items.Stdlib.Trigonometry.thm_sin_add (a := (b : ℂ)) (b := (c : ℂ))); qify; linear_combination (norm := parley_norm) h) | (have h := (Parley.Items.Stdlib.Trigonometry.thm_sin_add (a := (b : ℂ)) (b := (c : ℂ))); parley_int_power h) | (have h := (Parley.Items.Stdlib.Trigonometry.thm_sin_add (a := (b : ℂ)) (b := (c : ℂ))); parley_of_complex h) | (have h := (Parley.Items.Stdlib.Trigonometry.thm_sin_add (a := (b : ℂ)) (b := (c : ℂ))); parley_side)
  -- 8. thm:sin-add b := c
  have s8 : Real.sin (a + c) = Real.sin a * Real.cos c + Real.cos a * Real.sin c := by first | linear_combination (norm := parley_norm) (Parley.Items.Stdlib.Trigonometry.thm_sin_add (a := (a : ℂ)) (b := (c : ℂ))) | (have h := (Parley.Items.Stdlib.Trigonometry.thm_sin_add (a := (a : ℂ)) (b := (c : ℂ))); (try push_cast at h); (try push_cast); linear_combination (norm := parley_norm) h) | (have h := (Parley.Items.Stdlib.Trigonometry.thm_sin_add (a := (a : ℂ)) (b := (c : ℂ))); (try push_cast at h); (try push_cast); linear_combination (norm := parley_norm) -h) | exact_mod_cast (Parley.Items.Stdlib.Trigonometry.thm_sin_add (a := (a : ℂ)) (b := (c : ℂ))) | exact_mod_cast ((Parley.Items.Stdlib.Trigonometry.thm_sin_add (a := (a : ℂ)) (b := (c : ℂ)))).symm | (have h := (Parley.Items.Stdlib.Trigonometry.thm_sin_add (a := (a : ℂ)) (b := (c : ℂ))); rify; linear_combination (norm := parley_norm) h) | (have h := (Parley.Items.Stdlib.Trigonometry.thm_sin_add (a := (a : ℂ)) (b := (c : ℂ))); qify; linear_combination (norm := parley_norm) h) | (have h := (Parley.Items.Stdlib.Trigonometry.thm_sin_add (a := (a : ℂ)) (b := (c : ℂ))); parley_int_power h) | (have h := (Parley.Items.Stdlib.Trigonometry.thm_sin_add (a := (a : ℂ)) (b := (c : ℂ))); parley_of_complex h) | (have h := (Parley.Items.Stdlib.Trigonometry.thm_sin_add (a := (a : ℂ)) (b := (c : ℂ))); parley_side)
  -- 9. mun:sin-cos-squares a := c
  have s9 : Real.sin c ^ 2 + Real.cos c ^ 2 = 1 := by first | linear_combination (norm := parley_norm) (Parley.Items.Stdlib.Trigonometry.mun_sin_cos_squares (a := (c : ℂ))) | (have h := (Parley.Items.Stdlib.Trigonometry.mun_sin_cos_squares (a := (c : ℂ))); (try push_cast at h); (try push_cast); linear_combination (norm := parley_norm) h) | (have h := (Parley.Items.Stdlib.Trigonometry.mun_sin_cos_squares (a := (c : ℂ))); (try push_cast at h); (try push_cast); linear_combination (norm := parley_norm) -h) | exact_mod_cast (Parley.Items.Stdlib.Trigonometry.mun_sin_cos_squares (a := (c : ℂ))) | exact_mod_cast ((Parley.Items.Stdlib.Trigonometry.mun_sin_cos_squares (a := (c : ℂ)))).symm | (have h := (Parley.Items.Stdlib.Trigonometry.mun_sin_cos_squares (a := (c : ℂ))); rify; linear_combination (norm := parley_norm) h) | (have h := (Parley.Items.Stdlib.Trigonometry.mun_sin_cos_squares (a := (c : ℂ))); qify; linear_combination (norm := parley_norm) h) | (have h := (Parley.Items.Stdlib.Trigonometry.mun_sin_cos_squares (a := (c : ℂ))); parley_int_power h) | (have h := (Parley.Items.Stdlib.Trigonometry.mun_sin_cos_squares (a := (c : ℂ))); parley_of_complex h) | (have h := (Parley.Items.Stdlib.Trigonometry.mun_sin_cos_squares (a := (c : ℂ))); parley_side)
  -- 10. calculation
  have s10 : Real.sin a * Real.sin b + Real.sin c * Real.sin d = Real.sin (b + c) * Real.sin (a + c) := by
    calc Real.sin a * Real.sin b + Real.sin c * Real.sin d = Real.sin a * Real.sin b + Real.sin c * Real.sin (a + b + c) := by parley_subst s3
