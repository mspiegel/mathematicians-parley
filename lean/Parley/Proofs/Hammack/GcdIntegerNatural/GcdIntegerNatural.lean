      -- 6.10. mun:divides-multiple e := gcd(a, b), a := b, x := q, from 6.9
      have s6_10 : (Int.gcd a (b : ℤ) : ℤ) ∣ (b : ℤ) * q := by first | exact (Parley.Items.Stdlib.Divisibility.mun_divides_multiple (e := (Int.gcd a (b : ℤ) : ℤ)) (a := (b : ℤ)) (x := q) s6_9c) | exact ((Parley.Items.Stdlib.Divisibility.mun_divides_multiple (e := (Int.gcd a (b : ℤ) : ℤ)) (a := (b : ℤ)) (x := q) s6_9c)).symm | simpa using (Parley.Items.Stdlib.Divisibility.mun_divides_multiple (e := (Int.gcd a (b : ℤ) : ℤ)) (a := (b : ℤ)) (x := q) s6_9c) | exact_mod_cast (Parley.Items.Stdlib.Divisibility.mun_divides_multiple (e := (Int.gcd a (b : ℤ) : ℤ)) (a := (b : ℤ)) (x := q) s6_9c) | (have h := (Parley.Items.Stdlib.Divisibility.mun_divides_multiple (e := (Int.gcd a (b : ℤ) : ℤ)) (a := (b : ℤ)) (x := q) s6_9c); parley_side)
      -- 6.11. mun:divides-sum d := gcd(a, b), a := b·q, b := a mod b, from 6.9, 6.10
      have s6_11 : (Int.gcd a (b : ℤ) : ℤ) ∣ (b : ℤ) * q + a % (b : ℤ) := by first | exact (Parley.Items.Stdlib.Divisibility.mun_divides_sum (d := (Int.gcd a (b : ℤ) : ℤ)) (a := (b : ℤ) * q) (b := a % (b : ℤ)) s6_10 s6_9b) | exact ((Parley.Items.Stdlib.Divisibility.mun_divides_sum (d := (Int.gcd a (b : ℤ) : ℤ)) (a := (b : ℤ) * q) (b := a % (b : ℤ)) s6_10 s6_9b)).symm | simpa using (Parley.Items.Stdlib.Divisibility.mun_divides_sum (d := (Int.gcd a (b : ℤ) : ℤ)) (a := (b : ℤ) * q) (b := a % (b : ℤ)) s6_10 s6_9b) | exact_mod_cast (Parley.Items.Stdlib.Divisibility.mun_divides_sum (d := (Int.gcd a (b : ℤ) : ℤ)) (a := (b : ℤ) * q) (b := a % (b : ℤ)) s6_10 s6_9b) | (have h := (Parley.Items.Stdlib.Divisibility.mun_divides_sum (d := (Int.gcd a (b : ℤ) : ℤ)) (a := (b : ℤ) * q) (b := a % (b : ℤ)) s6_10 s6_9b); parley_side)
      -- 6.12. substitute
      have s6_12 : (Int.gcd a (b : ℤ) : ℤ) ∣ a := by
        have c1 : (b : ℤ) * q + a % (b : ℤ) = a := by linear_combination (norm := parley_norm) s4
        have row1 : (Int.gcd a (b : ℤ) : ℤ) ∣ a := by parley_subst_at c1 s6_11
        exact row1
      -- 6.13. join 6.9, 6.12
      have s6_13a : 0 < (Int.gcd a (b : ℤ) : ℤ) := by parley_side
      have s6_13b : (Int.gcd a (b : ℤ) : ℤ) ∣ a := by parley_side
      have s6_13c : (Int.gcd a (b : ℤ) : ℤ) ∣ (b : ℤ) := by parley_side
      all_goals parley_side
  obtain ⟨s6a, s6b, s6c⟩ := s6a_all
  exact ⟨by parley_side, by parley_side, by parley_side⟩

end Parley.Proofs.Hammack.GcdIntegerNatural.GcdIntegerNatural
