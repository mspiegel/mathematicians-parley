theorem prime_divides_binomial (p : ℕ) (hH1 : 0 < p) (k : ℤ) (hH3 : Nat.Prime p) (hH4 : 0 < k) (hH5 : k < (p : ℤ)) :
    (p : ℤ) ∣ (LeanBridges.Counting.choose (p : ℤ) k : ℤ) := by
  -- 1. mun:pos-int-nat m := k, from H4
  have s1 : 0 < k := by first | exact (Parley.Items.Stdlib.Numbers.mun_pos_int_nat (m := k) hH4) | exact ((Parley.Items.Stdlib.Numbers.mun_pos_int_nat (m := k) hH4)).symm | simpa using (Parley.Items.Stdlib.Numbers.mun_pos_int_nat (m := k) hH4) | exact_mod_cast (Parley.Items.Stdlib.Numbers.mun_pos_int_nat (m := k) hH4) | (have h := (Parley.Items.Stdlib.Numbers.mun_pos_int_nat (m := k) hH4); parley_side)
  lift k to ℕ using s1.le
  -- 2. mun:nat-minus-one n := p
  have s2 : 0 ≤ (p : ℤ) - 1 := by first | exact (Parley.Items.Stdlib.Numbers.mun_nat_minus_one (n := p) (by parley_side)) | exact ((Parley.Items.Stdlib.Numbers.mun_nat_minus_one (n := p) (by parley_side))).symm | simpa using (Parley.Items.Stdlib.Numbers.mun_nat_minus_one (n := p) (by parley_side)) | exact_mod_cast (Parley.Items.Stdlib.Numbers.mun_nat_minus_one (n := p) (by parley_side)) | (have h := (Parley.Items.Stdlib.Numbers.mun_nat_minus_one (n := p) (by parley_side)); parley_side)
  -- 3. inequalities, from 1
  have s3 : 1 ≤ (k : ℤ) := by parley_order
  -- 4. inequalities
  have s4 : (k : ℤ) ≤ (p : ℤ) - 1 + 1 := by parley_order
  -- 5. def:range-between a := 1, b := (p − 1) + 1, from 3, 4
  have s5 : (k : ℤ) ∈ Finset.Icc (1 : ℤ) ((p : ℤ) - 1 + 1) := by first | (assumption; done) | exact ((Parley.Items.Stdlib.Sums.def_range_between (k := (k : ℤ)) (a := (1 : ℤ)) (b := (p : ℤ) - 1 + 1))).mpr (by parley_side) | (have h := ((Parley.Items.Stdlib.Sums.def_range_between (k := (k : ℤ)) (a := (1 : ℤ)) (b := (p : ℤ) - 1 + 1))).mpr (by parley_side); parley_side)
  -- 6. thm:weighted-term m := p − 1, from 2, 5
  have s6 : (k : ℤ) * (LeanBridges.Counting.choose ((p : ℤ) - 1 + 1) (k : ℤ) : ℤ) = ((p : ℤ) - 1 + 1) * (LeanBridges.Counting.choose ((p : ℤ) - 1) ((k : ℤ) - 1) : ℤ) := by first | linear_combination (norm := parley_norm) (Int.toNat_of_nonneg (show (0 : ℤ) ≤ ((p : ℤ) - 1) by parley_side) ▸ (Parley.Proofs.Hammack.WeightedBinomialSum.WeightedTerm.weighted_term (m := ((p : ℤ) - 1).toNat) (k := (k : ℤ)) (by (try rw [Int.toNat_of_nonneg (show (0 : ℤ) ≤ ((p : ℤ) - 1) by parley_side)]); parley_side))) | (have h := (Int.toNat_of_nonneg (show (0 : ℤ) ≤ ((p : ℤ) - 1) by parley_side) ▸ (Parley.Proofs.Hammack.WeightedBinomialSum.WeightedTerm.weighted_term (m := ((p : ℤ) - 1).toNat) (k := (k : ℤ)) (by (try rw [Int.toNat_of_nonneg (show (0 : ℤ) ≤ ((p : ℤ) - 1) by parley_side)]); parley_side))); (try push_cast at h); (try push_cast); linear_combination (norm := parley_norm) h) | (have h := (Int.toNat_of_nonneg (show (0 : ℤ) ≤ ((p : ℤ) - 1) by parley_side) ▸ (Parley.Proofs.Hammack.WeightedBinomialSum.WeightedTerm.weighted_term (m := ((p : ℤ) - 1).toNat) (k := (k : ℤ)) (by (try rw [Int.toNat_of_nonneg (show (0 : ℤ) ≤ ((p : ℤ) - 1) by parley_side)]); parley_side))); (try push_cast at h); (try push_cast); linear_combination (norm := parley_norm) -h) | (have h := (Int.toNat_of_nonneg (show (0 : ℤ) ≤ ((p : ℤ) - 1) by parley_side) ▸ (Parley.Proofs.Hammack.WeightedBinomialSum.WeightedTerm.weighted_term (m := ((p : ℤ) - 1).toNat) (k := (k : ℤ)) (by (try rw [Int.toNat_of_nonneg (show (0 : ℤ) ≤ ((p : ℤ) - 1) by parley_side)]); parley_side))); exact_mod_cast h) | (have h := (Int.toNat_of_nonneg (show (0 : ℤ) ≤ ((p : ℤ) - 1) by parley_side) ▸ (Parley.Proofs.Hammack.WeightedBinomialSum.WeightedTerm.weighted_term (m := ((p : ℤ) - 1).toNat) (k := (k : ℤ)) (by (try rw [Int.toNat_of_nonneg (show (0 : ℤ) ≤ ((p : ℤ) - 1) by parley_side)]); parley_side))); exact_mod_cast h.symm) | (have h := (Int.toNat_of_nonneg (show (0 : ℤ) ≤ ((p : ℤ) - 1) by parley_side) ▸ (Parley.Proofs.Hammack.WeightedBinomialSum.WeightedTerm.weighted_term (m := ((p : ℤ) - 1).toNat) (k := (k : ℤ)) (by (try rw [Int.toNat_of_nonneg (show (0 : ℤ) ≤ ((p : ℤ) - 1) by parley_side)]); parley_side))); rify; linear_combination (norm := parley_norm) h) | (have h := (Int.toNat_of_nonneg (show (0 : ℤ) ≤ ((p : ℤ) - 1) by parley_side) ▸ (Parley.Proofs.Hammack.WeightedBinomialSum.WeightedTerm.weighted_term (m := ((p : ℤ) - 1).toNat) (k := (k : ℤ)) (by (try rw [Int.toNat_of_nonneg (show (0 : ℤ) ≤ ((p : ℤ) - 1) by parley_side)]); parley_side))); qify; linear_combination (norm := parley_norm) h) | (have h := (Int.toNat_of_nonneg (show (0 : ℤ) ≤ ((p : ℤ) - 1) by parley_side) ▸ (Parley.Proofs.Hammack.WeightedBinomialSum.WeightedTerm.weighted_term (m := ((p : ℤ) - 1).toNat) (k := (k : ℤ)) (by (try rw [Int.toNat_of_nonneg (show (0 : ℤ) ≤ ((p : ℤ) - 1) by parley_side)]); parley_side))); parley_int_power h) | (have h := (Int.toNat_of_nonneg (show (0 : ℤ) ≤ ((p : ℤ) - 1) by parley_side) ▸ (Parley.Proofs.Hammack.WeightedBinomialSum.WeightedTerm.weighted_term (m := ((p : ℤ) - 1).toNat) (k := (k : ℤ)) (by (try rw [Int.toNat_of_nonneg (show (0 : ℤ) ≤ ((p : ℤ) - 1) by parley_side)]); parley_side))); parley_side)
  -- 7. substitute
  have s7 : (k : ℤ) * (LeanBridges.Counting.choose (p : ℤ) (k : ℤ) : ℤ) = (p : ℤ) * (LeanBridges.Counting.choose ((p : ℤ) - 1) ((k : ℤ) - 1) : ℤ) := by
    have c1 : (p : ℤ) - 1 + 1 = (p : ℤ) := by parley_ring
    have row1 : (k : ℤ) * (LeanBridges.Counting.choose (p : ℤ) (k : ℤ) : ℤ) = (p : ℤ) * (LeanBridges.Counting.choose ((p : ℤ) - 1) ((k : ℤ) - 1) : ℤ) := by parley_subst_at c1 s6
    exact row1
  -- 8. mun:binomial-nat0 n := p − 1, k := k − 1, from 2
  have s8 : 0 ≤ (LeanBridges.Counting.choose ((p : ℤ) - 1) ((k : ℤ) - 1) : ℤ) := by first | exact (Int.toNat_of_nonneg (show (0 : ℤ) ≤ ((p : ℤ) - 1) by parley_side) ▸ (Parley.Items.Stdlib.Counting.mun_binomial_nat0 (n := ((p : ℤ) - 1).toNat) (k := (k : ℤ) - 1))) | exact ((Int.toNat_of_nonneg (show (0 : ℤ) ≤ ((p : ℤ) - 1) by parley_side) ▸ (Parley.Items.Stdlib.Counting.mun_binomial_nat0 (n := ((p : ℤ) - 1).toNat) (k := (k : ℤ) - 1)))).symm | simpa using (Int.toNat_of_nonneg (show (0 : ℤ) ≤ ((p : ℤ) - 1) by parley_side) ▸ (Parley.Items.Stdlib.Counting.mun_binomial_nat0 (n := ((p : ℤ) - 1).toNat) (k := (k : ℤ) - 1))) | exact_mod_cast (Int.toNat_of_nonneg (show (0 : ℤ) ≤ ((p : ℤ) - 1) by parley_side) ▸ (Parley.Items.Stdlib.Counting.mun_binomial_nat0 (n := ((p : ℤ) - 1).toNat) (k := (k : ℤ) - 1))) | (have h := (Int.toNat_of_nonneg (show (0 : ℤ) ≤ ((p : ℤ) - 1) by parley_side) ▸ (Parley.Items.Stdlib.Counting.mun_binomial_nat0 (n := ((p : ℤ) - 1).toNat) (k := (k : ℤ) - 1))); parley_side)
  -- 9. mun:divides-self n := p
  have s9 : (p : ℤ) ∣ (p : ℤ) := by first | exact (Parley.Items.Stdlib.Divisibility.mun_divides_self (n := (p : ℤ))) | exact ((Parley.Items.Stdlib.Divisibility.mun_divides_self (n := (p : ℤ)))).symm | simpa using (Parley.Items.Stdlib.Divisibility.mun_divides_self (n := (p : ℤ))) | exact_mod_cast (Parley.Items.Stdlib.Divisibility.mun_divides_self (n := (p : ℤ))) | (have h := (Parley.Items.Stdlib.Divisibility.mun_divides_self (n := (p : ℤ))); parley_side)
  -- 10. mun:divides-multiple e := p, a := p, x := C(p − 1, k − 1), from 9
  have s10 : (p : ℤ) ∣ (p : ℤ) * (LeanBridges.Counting.choose ((p : ℤ) - 1) ((k : ℤ) - 1) : ℤ) := by first | exact (Parley.Items.Stdlib.Divisibility.mun_divides_multiple (e := (p : ℤ)) (a := (p : ℤ)) (x := (LeanBridges.Counting.choose ((p : ℤ) - 1) ((k : ℤ) - 1) : ℤ)) s9) | exact ((Parley.Items.Stdlib.Divisibility.mun_divides_multiple (e := (p : ℤ)) (a := (p : ℤ)) (x := (LeanBridges.Counting.choose ((p : ℤ) - 1) ((k : ℤ) - 1) : ℤ)) s9)).symm | simpa using (Parley.Items.Stdlib.Divisibility.mun_divides_multiple (e := (p : ℤ)) (a := (p : ℤ)) (x := (LeanBridges.Counting.choose ((p : ℤ) - 1) ((k : ℤ) - 1) : ℤ)) s9) | exact_mod_cast (Parley.Items.Stdlib.Divisibility.mun_divides_multiple (e := (p : ℤ)) (a := (p : ℤ)) (x := (LeanBridges.Counting.choose ((p : ℤ) - 1) ((k : ℤ) - 1) : ℤ)) s9) | (have h := (Parley.Items.Stdlib.Divisibility.mun_divides_multiple (e := (p : ℤ)) (a := (p : ℤ)) (x := (LeanBridges.Counting.choose ((p : ℤ) - 1) ((k : ℤ) - 1) : ℤ)) s9); parley_side)
  -- 11. substitute k·C(p, k) = p·C(p − 1, k − 1) (line 7) into line 10
  have s11 : (p : ℤ) ∣ (k : ℤ) * (LeanBridges.Counting.choose (p : ℤ) (k : ℤ) : ℤ) := by parley_subst_at s7 s10
  -- 12. substitute
  have s12 : (p : ℤ) ∣ (LeanBridges.Counting.choose (p : ℤ) (k : ℤ) : ℤ) * (k : ℤ) := by
    have c1 : (k : ℤ) * (LeanBridges.Counting.choose (p : ℤ) (k : ℤ) : ℤ) = (LeanBridges.Counting.choose (p : ℤ) (k : ℤ) : ℤ) * (k : ℤ) := by parley_ring
    have row1 : (p : ℤ) ∣ (LeanBridges.Counting.choose (p : ℤ) (k : ℤ) : ℤ) * (k : ℤ) := by parley_subst_at c1 s11
    exact row1
  -- 13. contradiction
  have s13 : ¬ (p : ℤ) ∣ (k : ℤ) := by
    by_contra hc_hS
    have hS : (p : ℤ) ∣ (k : ℤ) := by parley_suppose hc_hS
    -- 13.1. mun:divides-le e := p, m := k, from S, 1
    have s13_1 : (p : ℤ) ≤ (k : ℤ) := by first | linarith [(Parley.Items.Stdlib.Divisibility.mun_divides_le (e := p) (by parley_side) (m := k) (by parley_side) (by parley_side))] | (have h := (Parley.Items.Stdlib.Divisibility.mun_divides_le (e := p) (by parley_side) (m := k) (by parley_side) (by parley_side)); push_cast at h; linarith) | exact_mod_cast (Parley.Items.Stdlib.Divisibility.mun_divides_le (e := p) (by parley_side) (m := k) (by parley_side) (by parley_side)) | (have h := (Parley.Items.Stdlib.Divisibility.mun_divides_le (e := p) (by parley_side) (m := k) (by parley_side) (by parley_side)); parley_side)
    -- 13.2. inequalities, from H5
    have s13_2 : ¬ (p : ℤ) ≤ (k : ℤ) := by parley_side
    all_goals parley_side
  -- 14. mun:prime-coprime a := k, from H3, 13
  have s14 : (Int.gcd (p : ℤ) (k : ℤ) : ℤ) = 1 := by first | linear_combination (norm := parley_norm) (Parley.Items.Stdlib.Divisibility.mun_prime_coprime (p := p) (by parley_side) (by parley_side) (a := (k : ℤ)) (by parley_side)) | (have h := (Parley.Items.Stdlib.Divisibility.mun_prime_coprime (p := p) (by parley_side) (by parley_side) (a := (k : ℤ)) (by parley_side)); (try push_cast at h); (try push_cast); linear_combination (norm := parley_norm) h) | (have h := (Parley.Items.Stdlib.Divisibility.mun_prime_coprime (p := p) (by parley_side) (by parley_side) (a := (k : ℤ)) (by parley_side)); (try push_cast at h); (try push_cast); linear_combination (norm := parley_norm) -h) | exact_mod_cast (Parley.Items.Stdlib.Divisibility.mun_prime_coprime (p := p) (by parley_side) (by parley_side) (a := (k : ℤ)) (by parley_side)) | exact_mod_cast ((Parley.Items.Stdlib.Divisibility.mun_prime_coprime (p := p) (by parley_side) (by parley_side) (a := (k : ℤ)) (by parley_side))).symm | (have h := (Parley.Items.Stdlib.Divisibility.mun_prime_coprime (p := p) (by parley_side) (by parley_side) (a := (k : ℤ)) (by parley_side)); rify; linear_combination (norm := parley_norm) h) | (have h := (Parley.Items.Stdlib.Divisibility.mun_prime_coprime (p := p) (by parley_side) (by parley_side) (a := (k : ℤ)) (by parley_side)); qify; linear_combination (norm := parley_norm) h) | (have h := (Parley.Items.Stdlib.Divisibility.mun_prime_coprime (p := p) (by parley_side) (by parley_side) (a := (k : ℤ)) (by parley_side)); parley_int_power h) | (have h := (Parley.Items.Stdlib.Divisibility.mun_prime_coprime (p := p) (by parley_side) (by parley_side) (a := (k : ℤ)) (by parley_side)); parley_side)
  -- 15. substitute
  have s15 : (Int.gcd (k : ℤ) (p : ℤ) : ℤ) = 1 := by
    have c1 : (Int.gcd (p : ℤ) (k : ℤ) : ℤ) = (Int.gcd (k : ℤ) (p : ℤ) : ℤ) := by first | linear_combination (norm := parley_norm) (Parley.Items.Stdlib.Divisibility.mun_gcd_commutes (a := (p : ℤ)) (b := (k : ℤ))) | (have h := (Parley.Items.Stdlib.Divisibility.mun_gcd_commutes (a := (p : ℤ)) (b := (k : ℤ))); (try push_cast at h); (try push_cast); linear_combination (norm := parley_norm) h) | (have h := (Parley.Items.Stdlib.Divisibility.mun_gcd_commutes (a := (p : ℤ)) (b := (k : ℤ))); (try push_cast at h); (try push_cast); linear_combination (norm := parley_norm) -h) | exact_mod_cast (Parley.Items.Stdlib.Divisibility.mun_gcd_commutes (a := (p : ℤ)) (b := (k : ℤ))) | exact_mod_cast ((Parley.Items.Stdlib.Divisibility.mun_gcd_commutes (a := (p : ℤ)) (b := (k : ℤ)))).symm | (have h := (Parley.Items.Stdlib.Divisibility.mun_gcd_commutes (a := (p : ℤ)) (b := (k : ℤ))); rify; linear_combination (norm := parley_norm) h) | (have h := (Parley.Items.Stdlib.Divisibility.mun_gcd_commutes (a := (p : ℤ)) (b := (k : ℤ))); qify; linear_combination (norm := parley_norm) h) | (have h := (Parley.Items.Stdlib.Divisibility.mun_gcd_commutes (a := (p : ℤ)) (b := (k : ℤ))); parley_int_power h) | (have h := (Parley.Items.Stdlib.Divisibility.mun_gcd_commutes (a := (p : ℤ)) (b := (k : ℤ))); parley_side)
    have row1 : (Int.gcd (k : ℤ) (p : ℤ) : ℤ) = 1 := by parley_subst_at c1 s14
    exact row1
  -- 16. thm:coprime-divides x := C(p, k), c := k, n := p, from 12, 15
  have s16 : (p : ℤ) ∣ (LeanBridges.Counting.choose (p : ℤ) (k : ℤ) : ℤ) := by first | exact (Parley.Items.Stdlib.Divisibility.thm_coprime_divides (x := (LeanBridges.Counting.choose (p : ℤ) (k : ℤ) : ℤ)) (c := (k : ℤ)) (n := p) (by parley_side) (by parley_side) (by parley_side)) | exact ((Parley.Items.Stdlib.Divisibility.thm_coprime_divides (x := (LeanBridges.Counting.choose (p : ℤ) (k : ℤ) : ℤ)) (c := (k : ℤ)) (n := p) (by parley_side) (by parley_side) (by parley_side))).symm | simpa using (Parley.Items.Stdlib.Divisibility.thm_coprime_divides (x := (LeanBridges.Counting.choose (p : ℤ) (k : ℤ) : ℤ)) (c := (k : ℤ)) (n := p) (by parley_side) (by parley_side) (by parley_side)) | exact_mod_cast (Parley.Items.Stdlib.Divisibility.thm_coprime_divides (x := (LeanBridges.Counting.choose (p : ℤ) (k : ℤ) : ℤ)) (c := (k : ℤ)) (n := p) (by parley_side) (by parley_side) (by parley_side)) | (have h := (Parley.Items.Stdlib.Divisibility.thm_coprime_divides (x := (LeanBridges.Counting.choose (p : ℤ) (k : ℤ) : ℤ)) (c := (k : ℤ)) (n := p) (by parley_side) (by parley_side) (by parley_side)); parley_side)
