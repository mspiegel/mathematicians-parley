  have s4c : (Int.gcd (2 * n + 1) (4 * n ^ 2 + 1) : ℤ) ∣ 4 * n ^ 2 + 1 := by first | (have h := (Int.toNat_of_nonneg (show (0 : ℤ) ≤ (4 * n ^ 2 + 1) by parley_side) ▸ (Parley.Proofs.Hammack.GcdIntegerNatural.GcdIntegerNatural.gcd_integer_natural (a := 2 * n + 1) (b := (4 * n ^ 2 + 1).toNat) (by (try rw [Int.toNat_of_nonneg (show (0 : ℤ) ≤ (4 * n ^ 2 + 1) by parley_side)]); parley_side))).2.2; exact h) | (have h := (Int.toNat_of_nonneg (show (0 : ℤ) ≤ (4 * n ^ 2 + 1) by parley_side) ▸ (Parley.Proofs.Hammack.GcdIntegerNatural.GcdIntegerNatural.gcd_integer_natural (a := 2 * n + 1) (b := (4 * n ^ 2 + 1).toNat) (by (try rw [Int.toNat_of_nonneg (show (0 : ℤ) ≤ (4 * n ^ 2 + 1) by parley_side)]); parley_side))).2.2; exact h.symm) | (have h := (Int.toNat_of_nonneg (show (0 : ℤ) ≤ (4 * n ^ 2 + 1) by parley_side) ▸ (Parley.Proofs.Hammack.GcdIntegerNatural.GcdIntegerNatural.gcd_integer_natural (a := 2 * n + 1) (b := (4 * n ^ 2 + 1).toNat) (by (try rw [Int.toNat_of_nonneg (show (0 : ℤ) ≤ (4 * n ^ 2 + 1) by parley_side)]); parley_side))).2.2; simpa using h) | (have h := (Int.toNat_of_nonneg (show (0 : ℤ) ≤ (4 * n ^ 2 + 1) by parley_side) ▸ (Parley.Proofs.Hammack.GcdIntegerNatural.GcdIntegerNatural.gcd_integer_natural (a := 2 * n + 1) (b := (4 * n ^ 2 + 1).toNat) (by (try rw [Int.toNat_of_nonneg (show (0 : ℤ) ≤ (4 * n ^ 2 + 1) by parley_side)]); parley_side))).2.2; exact_mod_cast h) | (have h := (Int.toNat_of_nonneg (show (0 : ℤ) ≤ (4 * n ^ 2 + 1) by parley_side) ▸ (Parley.Proofs.Hammack.GcdIntegerNatural.GcdIntegerNatural.gcd_integer_natural (a := 2 * n + 1) (b := (4 * n ^ 2 + 1).toNat) (by (try rw [Int.toNat_of_nonneg (show (0 : ℤ) ≤ (4 * n ^ 2 + 1) by parley_side)]); parley_side))).2.2; simp (disch := parley_side) only [parley_cast_toNat] at h; (try push_cast at h ⊢); exact h) | (have h := (Int.toNat_of_nonneg (show (0 : ℤ) ≤ (4 * n ^ 2 + 1) by parley_side) ▸ (Parley.Proofs.Hammack.GcdIntegerNatural.GcdIntegerNatural.gcd_integer_natural (a := 2 * n + 1) (b := (4 * n ^ 2 + 1).to