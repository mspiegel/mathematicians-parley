    have c1_w : (a : ℚ) - ((b : ℚ) - (c : ℚ)) = (a : ℚ) - (b : ℚ) + (c : ℚ) := by have h := congrArg (fun x : ℤ => (x : ℚ)) c1; push_cast at h; linear_combination (norm := parley_norm) h
