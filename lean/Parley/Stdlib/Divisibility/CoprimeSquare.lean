  -- 1. mun:coprime-square-part, from H4, H5
  have s1 : (s : ℤ) = (Int.gcd (s : ℤ) (w : ℤ) : ℤ) ^ 2 := by first | linear_combination (norm := parley_norm) (Parley.Stdlib.Divisibility.CoprimeSquarePart.coprime_square_part (s := s) (by parley_side) (t := t) (by parley_side) (w := w) (by parley_side) (by parley_side) (by parley_side)) | (have h := (Parley.Stdlib.Divisibility.CoprimeSquarePart.coprime_square_part (s := s) (by parley_side) (t := t) (by parley_side) (w := w) (by parley_side) (by parley_side) (by parley_side)); (try push_cast at h); (try push_cast); linear_combination (norm := parley_norm) h) | (have h := (Parley.Stdlib.Divisibility.CoprimeSquarePart.coprime_square_part (s := s) (by parley_side) (t := t) (by parley_side) (w := w) (by parley_side) (by parley_side) (by parley_side)); (try push_cast at h); (try push_cast); linear_combination (norm := parley_norm) -h) | exact_mod_cast (Parley.Stdlib.Divisibility.CoprimeSquarePart.coprime_square_part (s := s) (by parley_side) (t := t) (by parley_side) (w := w) (by parley_side) (by parley_side) (by parley_side)) | exact_mod_cast ((Parley.Stdlib.Divisibility.CoprimeSquarePart.coprime_square_part (s := s) (by parley_side) (t := t) (by parley_side) (w := w) (by parley_side) (by parley_side) (by parley_side))).symm | (have h := (Parley.Stdlib.Divisibility.CoprimeSquarePart.coprime_square_part (s := s) (by parley_side) (t := t) (by parley_side) (w := w) (by parley_side) (by parley_side) (by parley_side)); rify; linear_combination (norm := parley_norm) h) | (have h := (Parley.Stdlib.Divisibility.CoprimeSquarePart.coprime_square_part (s := s) (by parley_side) (t := t) (by parley_side) (w := w) (by parley_side) (by parley_side) (by parley_side)); qify; linear_combination (norm := parley_norm) h) | (have h := (Parley.Stdlib.Divisibility.CoprimeSquarePart.coprime_square_part (s := s) (by parley_side) (t := t) (by parley_side) (w := w) (by parley_side) (by parley_side) (by parley_side)); parley_int_power h) | (have h := (Parley.Stdlib.Divisibility.CoprimeSquarePart.