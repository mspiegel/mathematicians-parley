theorem a_cube_of_a_product_of_roots :
    (Real.sqrt (2 : ℝ) * Real.sqrt (3 : ℝ)) ^ 3 = 6 * Real.sqrt (2 : ℝ) * Real.sqrt (3 : ℝ) := by
  -- 1. real arithmetic
  have hr2 : Real.sqrt (2 : ℝ) ^ 2 = 2 := Real.sq_sqrt (show (0 : ℝ) ≤ 2 by norm_num)
  have hr3 : Real.sqrt (3 : ℝ) ^ 2 = 3 := Real.sq_sqrt (show (0 : ℝ) ≤ 3 by norm_num)
  linear_combination (Real.sqrt (2 : ℝ) * Real.sqrt (3 : ℝ) ^ 3) * hr2 + (2 * Real.sqrt (2 : ℝ) * Real.sqrt (3 : ℝ)) * hr3

