# Standard library: counting
#
# How many elements a set has, factorials, and binomial coefficients.
#
# One record per item. A record begins at column 0 with its kind, axiom,
# theorem or definition, and its name; `mundane` before the kind marks an
# item a proof takes for granted. A proof imports each item it cites,
# `import <header> stdlib/counting/<name>`, where the header is the
# record's own before its name, as `mundane theorem` or `axiom`. Format is described in DATABASE.md.
#
# An item's statement is written in the theorem form of SYNTAX.md: let and
# assume lines with labels, then a `then` line.
#
# Every item carries at least one of:
#   metamath    a set.mm label or labels supply it
#   open        it is cited but unproved and unbridged
#
# Other fields: target, note.


mundane definition factorial
  then        1! = 1
  let n ∈ ℕ                                                           (H1)
  then        (n + 1)! = n!·(n + 1)
  metamath    fac1, facp1
  target      fac1, facp1
  note        Two `then` groups: the base sentence has no hypothesis and the
              step sentence has H1. See DATABASE.md on recursive definitions.

mundane theorem factorial-nat
  let n ∈ ℕ                                                           (H1)
  then        n! ∈ ℕ
  metamath    faccl, which states it on ℕ0
  target      faccl

mundane theorem factorial-divisible
  let n ∈ ℕ                                                           (H1)
  let m ∈ ℕ                                                           (H2)
  assume m ≤ n                                                        (H3)
  then        m divides n!
  metamath    dvdsfac, which asks m ≤ n as membership of ℤ≥m
  target      dvdsfac

mundane theorem card-zero
  let X be a set                                                      (H1)
  assume |X| = 0                                                      (H2)
  then        X = ∅
  metamath    hasheq0
  target      hasheq0

mundane theorem card-singleton
  let x be an element                                                 (H1)
  then        |{x}| = 1
  metamath    hashsng
  target      hashsng
  note        A singleton has one element only when there is an element for it
              to have: `{ x }` for a proper class x is empty, and `hashsng`
              asks for the set because of it.

mundane theorem card-nonempty
  let X be a set                                                      (H1)
  let k ∈ ℕ₀                                                          (H2)
  assume |X| = k + 1                                                  (H3)
  then        there is a ∈ X
  metamath    hashgt0elex
  target      hashgt0elex with V := X
  note        `hashgt0elex` asks that the size be positive where the
              hypothesis says what the size is, so the size is read as
              k + 1 through that hypothesis before `nn0p1gt0` answers.

mundane theorem card-remove
  let X be a set                                                      (H1)
  let a ∈ X                                                           (H2)
  let k ∈ ℕ₀                                                          (H3)
  assume |X| = k + 1                                                  (H4)
  then        |X ∖ {a}| = k
  metamath    hashdifsnp1
  target      hashdifsnp1 with V := X, N := a, Y := k
  note        `hashdifsnp1` states this item whole, hypotheses included:
              the size is given as k + 1, so nothing asks that X be finite.

mundane theorem card-bijection
  let X be a set                                                      (H1)
  let Y be a set                                                      (H2)
  let m ∈ ℕ₀                                                          (H3)
  assume |X| = m                                                      (H4)
  assume there is a bijection from X to Y                             (H5)
  then        |Y| = m
  metamath    hashen
  target      hashen with A := X, B := Y

mundane theorem card-disjoint-union
  let X be a set                                                      (H1)
  let Y be a set                                                      (H2)
  let m ∈ ℕ₀                                                          (H3)
  let n ∈ ℕ₀                                                          (H4)
  assume |X| = m                                                      (H5)
  assume |Y| = n                                                      (H6)
  assume X ∩ Y = ∅                                                    (H7)
  then        |X ∪ Y| = m + n
  metamath    hashun
  target      hashun with A := X, B := Y

definition C
  sort        number, number → number
  builds      _1 _2 cbc co
  reads       choose
  let n ∈ ℕ₀                                                          (H1)
  then        C(n, −1) = 0
  let k ∈ ℤ                                                           (H2)
  then        if k ∈ {0, …, n} then C(n, k) = n!/((n − k)!·k!).
              if n < k then C(n, k) = 0.
  metamath    bcneg1, bcval2, bcval4
  target      bcneg1, bcval2, bcval4
  note        set.mm defines C(n, k) for every integer k, as 0 outside
              0 … n, and the formula is its value inside. That it is 0 above
              n and at −1 is a convention a writer chooses, so both are
              clauses of the definition and not theorems about it. set.mm
              states the two ways a coefficient is zero as one disjunction,
              k < 0 or n < k, and `bcval4` gives the second.

theorem pascal
  let n ∈ ℕ₀                                                          (H1)
  let k ∈ ℤ                                                           (H2)
  then        C(n, k) + C(n, k − 1) = C(n + 1, k)
  metamath    bcpasc
  target      bcpasc
  note        Holds for every integer k, the ends included, because C(n, k)
              is 0 outside 0 … n.

mundane theorem binomial-zero-index
  let n ∈ ℕ₀                                                          (H1)
  then        C(n, 0) = 1
  metamath    bcn0
  target      bcn0

mundane theorem binomial-nat0
  let n ∈ ℕ₀                                                          (H1)
  let k ∈ ℤ                                                           (H2)
  then        C(n, k) ∈ ℕ₀
  metamath    bccl
  target      bccl

mundane theorem card-empty
  then        |∅| = 0
  metamath    hash0
  target      hash0

mundane theorem factorial-zero
  then        0! = 1
  metamath    fac0
  target      fac0

mundane theorem finite-part
  assume X is finite                                                  (H1)
  assume Y ⊆ X                                                        (H2)
  then        Y is finite
  metamath    ssfi
  target      ssfi

mundane theorem card-nat0
  assume X is finite                                                  (H1)
  then        |X| ∈ ℕ₀
  metamath    hashcl
  target      hashcl

mundane theorem parts-finite
  assume A is finite                                                  (H1)
  assume for all Y ∈ K, Y ⊆ A                                         (H2)
  then        K is finite
  metamath    pwfi and ssfi, which this corpus proves together in
              elaboration/stdlib/proved.mm
  target      gpartsfin
  note        A finite set has finitely many parts, so any set of its parts
              is finite.

mundane theorem card-equal
  assume X is finite                                                  (H1)
  assume there is a bijection from X to Y                             (H2)
  then        |X| = |Y|
  metamath    enfi and hashen, which this corpus proves together in
              elaboration/stdlib/proved.mm
  target      gcardeq
  note        Y is finite because X is, and two finite sets paired off one
              to one have the same number of elements.

mundane theorem partition-count
  let A be a set                                                      (H1)
  let K be a set                                                      (H2)
  let m ∈ ℕ₀                                                          (H3)
  assume A is finite                                                  (H4)
  assume ⋃(Y ∈ K) Y = A                                               (H5)
  assume for all Y, Z ∈ K, for all x ∈ Y ∩ Z, Y = Z                   (H6)
  assume for all Y ∈ K, |Y| = m                                       (H7)
  then        |A| = |K| · m
  metamath    hashiun and fsumconst, which this corpus proves together in
              elaboration/stdlib/proved.mm
  target      gpartcnt
  note        A finite set split into parts that each have m elements has
              (number of parts) · m of them. The parts make up A, and two
              that share a point are the same part.
