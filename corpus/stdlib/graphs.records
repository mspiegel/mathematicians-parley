# Standard library: graphs
#
# Undirected multigraphs: their vertices and edges, an edge joining two
# vertices, the degree of a vertex, and walks that cross every edge once.
#
# One record per item. A record begins at column 0 with its kind, axiom,
# theorem or definition, and its name; `mundane` before the kind marks an
# item a proof takes for granted. A proof imports each item it cites,
# `import <header> stdlib/graphs/<name>`, where the header is the record's
# own before its name, as `mundane theorem` or `definition`. Format is
# described in DATABASE.md.
#
# An item's statement is written in the theorem form of SYNTAX.md: let and
# assume lines with labels, then a `then` line.
#
# Every item carries at least one of:
#   metamath    a set.mm label or labels supply it
#   open        it is cited but unproved and unbridged
#
# Other fields: target, note.
#
# A graph is set.mm's structure, named by its `let` line and never written:
# `let G be an undirected multigraph with vertices V and edges E` gives the
# graph, the set of its vertices and the set of the names of its edges
# (`corpus/db/notation.records`, "Graphs").

definition traversable
  let G be an undirected multigraph with vertices V and edges E      (H1)
  then        G is traversable ↔ there is n ∈ ℕ₀ with there is
              f : {0, …, n − 1} → E with there is v : {0, …, n} → V with
              f : {0, …, n − 1} → E is one-to-one and
              (for all a ∈ E, there is k ∈ {0, …, n − 1} with a = f(k)) and
              (for all k ∈ {0, …, n − 1}, f(k) joins v(k) and v(k + 1))
  metamath    iseupthf1o and upgriswlk, the walk's word of edges read as a
              function on {0, …, n − 1}, which this corpus proves together in
              elaboration/stdlib/proved.mm
  target      gtrav
  note        A walk that crosses every edge exactly once is an Euler path,
              and a graph that has one is traversable (ProofWiki,
              "Characteristics of Traversable Graph"). f(k) is the edge the
              walk crosses after k edges, and v(k) where it is then. The edges
              are counted from 0 here because set.mm counts them so; a proof
              that wants them from 1 renumbers them itself.

definition walk
  let G be an undirected multigraph with vertices V and edges E      (H1)
  let n ∈ ℕ₀                                                          (H2)
  let e : {1, …, n} → E                                               (H3)
  let v : {0, …, n} → V                                               (H4)
  then        v and e form a walk of n edges ↔ for all i ∈ {1, …, n},
              e(i) joins v(i − 1) and v(i)
  metamath    biid, since the notation's target is the joins at every place
  target      biid
  note        A walk is the vertices it passes through, v(0) first, and the
              edges it crosses, e(1) first, each edge joining the vertex
              before it to the vertex after it (Diestel, "Graph Theory",
              §1.3, and ProofWiki, "Definition:Walk (Graph Theory)").

definition euler-path
  let G be an undirected multigraph with vertices V and edges E      (H1)
  let n ∈ ℕ₀                                                          (H2)
  let e : {1, …, n} → E                                               (H3)
  let v : {0, …, n} → V                                               (H4)
  then        v and e form an Euler path of n edges ↔ v and e form a walk of
              n edges and e : {1, …, n} → E is one-to-one and for all a ∈ E,
              there is i ∈ {1, …, n} with a = e(i)
  metamath    biid, since the notation's target is the three conditions
  target      biid
  note        A walk that crosses every edge exactly once: its edges e(1), …,
              e(n) are all different and every edge is one of them (Bondy and
              Murty, "Graph Theory", §3.3; set.mm's `EulerPaths` counts the
              edges from 0, as `def:stdlib/graphs/traversable` does). A
              Hamiltonian path is the same for vertices.

mundane theorem walk-step
  let G be an undirected multigraph with vertices V and edges E      (H1)
  let n ∈ ℕ₀                                                          (H2)
  let e : {1, …, n} → E                                               (H3)
  let v : {0, …, n} → V                                               (H4)
  let i ∈ {1, …, n}                                                   (H5)
  assume v and e form a walk of n edges                               (H6)
  then        e(i) joins v(i − 1) and v(i)
  metamath    rspcv, at the place i, which this corpus proves in
              elaboration/stdlib/proved.mm
  target      gwalkstep
  note        Each edge of a walk joins the vertices on either side of it.

mundane theorem joined-end
  let G be an undirected multigraph with vertices V and edges E      (H1)
  let a ∈ E                                                           (H2)
  let u ∈ V                                                           (H3)
  let w ∈ V                                                           (H4)
  assume a joins u and w                                              (H5)
  then        u is an end of a. w is an end of a.
  metamath    prid1g and prid2g, at the ends iEdg gives, which this corpus
              proves in elaboration/stdlib/proved.mm
  target      gjoinend1, gjoinend2

mundane theorem walk-distinct
  let G be an undirected multigraph with vertices V and edges E      (H1)
  let n ∈ ℕ₀                                                          (H2)
  let e : {1, …, n} → E                                               (H3)
  let v : {0, …, n} → V                                               (H4)
  let i ∈ {1, …, n}                                                   (H5)
  assume v and e form a walk of n edges                               (H6)
  then        v(i − 1) ≠ v(i)
  metamath    umgrnloopv at the edge `walk-step` gives, which this corpus
              proves in elaboration/stdlib/proved.mm
  target      gwalkne
  note        A walk never stays where it is: an edge of a multigraph joins
              two different vertices.

mundane theorem ends-of-joined
  let G be an undirected multigraph with vertices V and edges E      (H1)
  let x ∈ V                                                           (H2)
  assume a joins u and w                                              (H3)
  then        x is an end of a ↔ x = u or x = w
  metamath    elprg, at the ends iEdg gives, which this corpus proves in
              elaboration/stdlib/proved.mm
  target      gends
  note        The ends of an edge that joins u and w are u and w.

mundane theorem not-an-end
  let G be an undirected multigraph with vertices V and edges E      (H1)
  let a ∈ E                                                           (H2)
  let u ∈ V                                                           (H3)
  let w ∈ V                                                           (H4)
  let x ∈ V                                                           (H5)
  assume a joins u and w                                              (H6)
  assume x ≠ u                                                        (H7)
  assume x ≠ w                                                        (H8)
  then        x is not an end of a
  metamath    elpri, at the ends iEdg gives, which this corpus proves in
              elaboration/stdlib/proved.mm
  target      gnotend

mundane theorem join-distinct
  let G be an undirected multigraph with vertices V and edges E      (H1)
  let a ∈ E                                                           (H2)
  let u ∈ V                                                           (H3)
  let w ∈ V                                                           (H4)
  assume a joins u and w                                              (H5)
  then        u ≠ w
  metamath    umgrnloopv, a multigraph having no edge from a vertex to
              itself, which this corpus proves in elaboration/stdlib/proved.mm
  target      gjoinne

mundane definition degree
  let G be an undirected multigraph with vertices V and edges E      (H1)
  let x ∈ V                                                           (H2)
  then        deg(x) = |{a ∈ E : x is an end of a}|
  metamath    vtxdumgrval, with the graph's parts named, which this corpus
              states in elaboration/stdlib/proved.mm
  target      gdeg
  note        The degree of a vertex is how many edges it is an end of. A
              multigraph has no edge from a vertex to itself, so no edge counts
              twice.
