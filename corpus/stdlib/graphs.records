# Standard library: graphs
#
# Undirected multigraphs: their vertices and edges, an edge joining two
# vertices, the degree of a vertex, and walks that cross every edge once.
#
# One record per item. A record begins at column 0 with its kind, axiom,
# theorem or definition, and its name; `mundane` before the kind marks an
# item a proof takes for granted. A proof imports each item it cites,
# `import <header> stdlib/graphs/<name>`, where the header is the record's
# own before its name, as `mundane theorem` or `definition`. Format is
# described in DATABASE.md.
#
# An item's statement is written in the theorem form of SYNTAX.md: let and
# assume lines with labels, then a `then` line.
#
# Every item carries both:
#   metamath-proof  how the Metamath build proves it: a set.mm label, the
#                   full name of a Parley proof or of a bridge, `none` where
#                   it has nothing to prove, or `not yet implemented`
#   lean-proof      the same for the Lean build, a Mathlib proof in place of
#                   a set.mm label
#
# Other fields: note.
#
# A graph is set.mm's structure, named by its `let` line and never written:
# `let G be an undirected multigraph with vertices V and edges E` gives the
# graph, the set of its vertices and the set of the names of its edges
# (`corpus/db/notation.records`, "Graphs").

definition traversable
  let G be an undirected multigraph with vertices V and edges E      (H1)
  then        G is traversable ↔ there is n ∈ ℕ₀ with there is
              e : {1, …, n} → E with there is v : {0, …, n} → V with
              v and e form an Euler path of n edges
  metamath-proof metamath-bridges/graphs/gtrav
  note        A walk that crosses every edge exactly once is an Euler path,
              and a graph that has one is traversable (ProofWiki,
              "Characteristics of Traversable Graph"). The edges are counted
              from 1, as `def:stdlib/graphs/euler-path` counts them; set.mm
              counts them from 0, and `gtrav` carries one count to the other.
  lean-proof  not yet implemented

definition walk
  let G be an undirected multigraph with vertices V and edges E      (H1)
  let n ∈ ℕ₀                                                          (H2)
  let e : {1, …, n} → E                                               (H3)
  let v : {0, …, n} → V                                               (H4)
  then        v and e form a walk of n edges ↔ for all i ∈ {1, …, n},
              e(i) joins v(i − 1) and v(i)
  metamath-proof biid
  note        A walk is the vertices it passes through, v(0) first, and the
              edges it crosses, e(1) first, each edge joining the vertex
              before it to the vertex after it (Diestel, "Graph Theory",
              §1.3, and ProofWiki, "Definition:Walk (Graph Theory)").
  lean-proof  not yet implemented

definition euler-path
  let G be an undirected multigraph with vertices V and edges E      (H1)
  let n ∈ ℕ₀                                                          (H2)
  let e : {1, …, n} → E                                               (H3)
  let v : {0, …, n} → V                                               (H4)
  then        v and e form an Euler path of n edges ↔ v and e form a walk of
              n edges and e : {1, …, n} → E is one-to-one and for all a ∈ E,
              there is i ∈ {1, …, n} with a = e(i)
  metamath-proof biid
  note        A walk that crosses every edge exactly once: its edges e(1), …,
              e(n) are all different and every edge is one of them (Bondy and
              Murty, "Graph Theory", §3.3; set.mm's `EulerPaths` counts the
              edges from 0, and `def:stdlib/graphs/traversable` says the one
              count is the other). A Hamiltonian path is the same for
              vertices.
  lean-proof  not yet implemented

mundane theorem walk-step
  let G be an undirected multigraph with vertices V and edges E      (H1)
  let n ∈ ℕ₀                                                          (H2)
  let e : {1, …, n} → E                                               (H3)
  let v : {0, …, n} → V                                               (H4)
  let i ∈ {1, …, n}                                                   (H5)
  assume v and e form a walk of n edges                               (H6)
  then        e(i) joins v(i − 1) and v(i)
  metamath-proof metamath-bridges/graphs/gwalkstep
  note        Each edge of a walk joins the vertices on either side of it.
  lean-proof  not yet implemented

mundane theorem joined-incident
  let G be an undirected multigraph with vertices V and edges E      (H1)
  let a ∈ E                                                           (H2)
  let u ∈ V                                                           (H3)
  let w ∈ V                                                           (H4)
  assume a joins u and w                                              (H5)
  then        u is incident with a. w is incident with a.
  metamath-proof metamath-bridges/graphs/gjoinend1, metamath-bridges/graphs/gjoinend2
  lean-proof  not yet implemented

mundane theorem walk-distinct
  let G be an undirected multigraph with vertices V and edges E      (H1)
  let n ∈ ℕ₀                                                          (H2)
  let e : {1, …, n} → E                                               (H3)
  let v : {0, …, n} → V                                               (H4)
  let i ∈ {1, …, n}                                                   (H5)
  assume v and e form a walk of n edges                               (H6)
  then        v(i − 1) ≠ v(i)
  metamath-proof metamath-bridges/graphs/gwalkne
  note        A walk never stays where it is: an edge of a multigraph joins
              two different vertices.
  lean-proof  not yet implemented

mundane theorem incident-of-joined
  let G be an undirected multigraph with vertices V and edges E      (H1)
  let x ∈ V                                                           (H2)
  assume a joins u and w                                              (H3)
  then        x is incident with a ↔ x = u or x = w
  metamath-proof metamath-bridges/graphs/gends
  note        The vertices incident with an edge that joins u and w are u
              and w.
  lean-proof  not yet implemented

mundane theorem not-incident
  let G be an undirected multigraph with vertices V and edges E      (H1)
  let a ∈ E                                                           (H2)
  let u ∈ V                                                           (H3)
  let w ∈ V                                                           (H4)
  let x ∈ V                                                           (H5)
  assume a joins u and w                                              (H6)
  assume x ≠ u                                                        (H7)
  assume x ≠ w                                                        (H8)
  then        x is not incident with a
  metamath-proof metamath-bridges/graphs/gnotend
  lean-proof  not yet implemented

mundane theorem join-distinct
  let G be an undirected multigraph with vertices V and edges E      (H1)
  let a ∈ E                                                           (H2)
  let u ∈ V                                                           (H3)
  let w ∈ V                                                           (H4)
  assume a joins u and w                                              (H5)
  then        u ≠ w
  metamath-proof metamath-bridges/graphs/gjoinne
  lean-proof  not yet implemented

definition degree
  let G be an undirected multigraph with vertices V and edges E      (H1)
  let x ∈ V                                                           (H2)
  then        deg(x) = |{a ∈ E : x is incident with a}|
  metamath-proof metamath-bridges/graphs/gdeg
  note        The degree of a vertex is how many edges it is incident with. A
              multigraph has no edge from a vertex to itself, so no edge counts
              twice.
  lean-proof  not yet implemented
