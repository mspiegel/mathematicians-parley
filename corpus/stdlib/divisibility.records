# Standard library: divisibility
#
# Even and odd, divisors, primes, greatest common divisors, division with a
# remainder, and congruence modulo a number.
#
# One record per item. A record begins at column 0 with its kind, axiom,
# theorem or definition, and its name; `mundane` before the kind marks an
# item a proof takes for granted. A proof imports each item it cites,
# `import <header> stdlib/divisibility/<name>`, where the header is the
# record's own before its name, as `mundane theorem` or `axiom`. Format is described in DATABASE.md.
#
# An item's statement is written in the theorem form of SYNTAX.md: let and
# assume lines with labels, then a `then` line.
#
# Every item carries at least one of:
#   metamath    a set.mm label or labels supply it
#   open        it is cited but unproved and unbridged
#
# Other fields: target, note.


mundane definition divides
  let d ∈ ℤ                                                           (H1)
  let n ∈ ℤ                                                           (H2)
  then        d divides n ↔ there is k ∈ ℤ with n = d·k
  metamath    df-dvds, as divides states it
  target      divides, equation reversed
  note        Defined once on ℤ. A proof about ℕ discharges membership of ℤ as a
              dull fact. This is the principle recorded by the primes pilot: a
              relation is defined once, on the widest set where it makes sense.

mundane definition even
  let n ∈ ℤ                                                           (H1)
  then        n is even ↔ there is k ∈ ℤ with n = 2k
  metamath    df-dvds, whose right side is the same existential
  target      divides, equation reversed
  note        set.mm writes 2 ∥ n and has no primitive for "even". This names the
              word. See DATABASE.md on what def: means.

              The field said `dvds`, which is not a label. df-dvds defines ∥ as
              the pairs with an n ∈ ℤ making n·x = y, so the unfolding is the
              same existential this statement writes. Found by checking every
              label the database names against set.mm.

mundane definition odd
  let n ∈ ℤ                                                           (H1)
  then        n is odd ↔ there is k ∈ ℤ with n = 2k + 1
  metamath    not 2 ∥ n
  target      odd2np1, equation reversed

mundane theorem even-or-odd
  let n ∈ ℤ                                                           (H1)
  then        n is even or n is odd
  metamath    exmid
  target      exmid
  note        mun:stdlib/divisibility/odd makes "n is odd" the negation of "n is even", so this
              statement is excluded middle, ( ph or not ph ), and the
              expansion never uses H1. zeo says the same thing for an encoding
              where "odd" means n - 1 is even, which is not the one mun:stdlib/divisibility/odd
              chose.

mundane theorem not-both
  let n ∈ ℤ                                                           (H1)
  assume n is even                                                    (H2)
  then        n is not odd
  metamath    notnot
  target      notnot
  note        mun:stdlib/divisibility/odd makes "n is odd" the negation of H2, so this statement is
              double negation introduction, ( ph -> not not ph ), and the
              expansion never uses H1.

theorem divides-gcd
  let d ∈ ℤ                                                           (H1)
  let a ∈ ℤ                                                           (H2)
  let b ∈ ℤ                                                           (H3)
  assume d divides a                                                  (H4)
  assume d divides b                                                  (H5)
  then        d divides gcd(a, b)
  metamath    dvdsgcd
  target      dvdsgcd

theorem division-algorithm
  let n ∈ ℕ                                                           (H1)
  let d ∈ ℕ                                                           (H2)
  then        there exist q, r ∈ ℤ such that n = q·d + r, 0 ≤ r, and r < d
  metamath    divalg
  target      divalg with N := n, D := d
  note        divalg says exactly one remainder, quantified the other way
              round, bounded by the absolute value, and saying its three
              things in a different order. The elaborator takes its
              existential apart and puts this one back, which is what makes
              the last two of those stop being differences. Nothing fixes
              divalg's own variables, because its conclusion is never
              matched against this claim, so `with` says which is which.

mundane definition prime
  let p ∈ ℕ                                                           (H1)
  then        p is prime ↔ p > 1 and for all d ∈ ℕ, if d divides p then
              d = 1 or d = p
  metamath    isprm2, whose first conjunct is membership of ℤ≥2
  target      isprm2
  note        isprm2 writes p > 1 as p ∈ ℤ≥2, which is not the formula this
              line writes, so unfolding the definition does not land on the
              words of the right side. What carries one to the other is
              eluz2gt1, declared with the rest of what an elaborator may
              lean on. `target` still names the unfolding and nothing else.

mundane definition gcd
  sort        number, number → number
  builds      _1 _2 cgcd co
  reads       the greatest common divisor of
  let a ∈ ℕ                                                           (H1)
  let b ∈ ℕ                                                           (H2)
  then        gcd(a, b) ∈ ℕ. gcd(a, b) divides a. gcd(a, b) divides b.
              For all e ∈ ℕ, if e divides a and e divides b then
              e ≤ gcd(a, b).
  metamath    gcdnncl, gcddvds, dvdslegcd
  target      gcdnncl, gcddvds, dvdslegcd
  note        Four sentences from three lemmas. gcdcl puts a gcd in ℕ₀ and
              this statement puts it in ℕ, which gcdnncl gives because both
              arguments are natural numbers; gcddvds says in one conjunction
              what the second and third sentences say separately; and
              dvdslegcd is the fourth said of one divisor where this says it
              of every e ∈ ℕ.

theorem prime-factor
  let m ∈ ℕ                                                           (H1)
  assume m > 1                                                        (H2)
  then        there is p ∈ ℕ with p is prime and p divides m
  metamath    exprmfct, which quantifies over Prime rather than over ℕ
  target      exprmfct
  note        No target, so an elaborator states this and lists it. exprmfct
              says E. p e. Prime p || N, putting primality in the domain; this
              quantifies over ℕ and says it in the body, which is how a reader
              meets the claim. The two are equivalent and the bridge is a proof
              rather than a field of this file.

mundane theorem divides-sum
  let d ∈ ℤ                                                           (H1)
  let a ∈ ℤ                                                           (H2)
  let b ∈ ℤ                                                           (H3)
  assume d divides a                                                  (H4)
  assume d divides b                                                  (H5)
  then        d divides a + b
  metamath    dvds2add
  target      dvds2add

mundane theorem divides-difference
  let d ∈ ℤ                                                           (H1)
  let a ∈ ℤ                                                           (H2)
  let b ∈ ℤ                                                           (H3)
  assume d divides a                                                  (H4)
  assume d divides b                                                  (H5)
  then        d divides a − b
  metamath    dvds2sub
  target      dvds2sub

mundane theorem divides-one
  let d ∈ ℕ                                                           (H1)
  assume d divides 1                                                  (H2)
  then        d = 1
  metamath    dvds1, read left to right
  target      dvds1

mundane theorem divides-combination
  let e ∈ ℤ                                                           (H1)
  let a ∈ ℤ                                                           (H2)
  let b ∈ ℤ                                                           (H3)
  let x ∈ ℤ                                                           (H4)
  let y ∈ ℤ                                                           (H5)
  assume e divides a                                                  (H6)
  assume e divides b                                                  (H7)
  then        e divides a·x + b·y
  metamath    dvds2ln
  target      dvds2ln with K := e, I := x, M := a, J := y, N := b

mundane theorem divides-le
  let e ∈ ℕ                                                           (H1)
  let m ∈ ℕ                                                           (H2)
  assume e divides m                                                  (H3)
  then        e ≤ m
  metamath    dvdsle
  target      dvdsle

mundane definition congruent-mod
  let n ∈ ℤ                                                           (H1)
  let a ∈ ℤ                                                           (H2)
  let b ∈ ℤ                                                           (H3)
  then        a ≡ b (mod n) ↔ n divides a − b
  metamath    the notation's own target, n ∥ ( a − b )
  note        The two sides are one formula in the kernel, so unfolding it is
              saying the same thing the other way, and nothing is stated: a
              step reading one from a line saying the other has that line's
              proof. It is here so the page may say which it means.

mundane theorem divides-multiple
  let e ∈ ℤ                                                           (H1)
  let a ∈ ℤ                                                           (H2)
  let x ∈ ℤ                                                           (H3)
  assume e divides a                                                  (H4)
  then        e divides a·x
  metamath    dvdsmultr1
  target      dvdsmultr1

mundane theorem congruent-divides
  let m ∈ ℤ                                                           (H1)
  let a ∈ ℤ                                                           (H2)
  let b ∈ ℤ                                                           (H3)
  assume a ≡ b (mod m)                                                (H4)
  then        m divides a ↔ m divides b
  metamath    dvdssub2
  target      dvdssub2
  note        Two numbers congruent modulo m are divisible by m together.

mundane theorem gcd-commutes
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  then        gcd(a, b) = gcd(b, a)
  metamath    gcdcom
  target      gcdcom

mundane theorem gcd-one
  let a ∈ ℤ                                                           (H1)
  then        gcd(a, 1) = 1
  metamath    gcd1
  target      gcd1

mundane theorem gcd-zero
  let n ∈ ℕ₀                                                          (H1)
  then        gcd(n, 0) = n
  metamath    nn0gcdid0
  target      nn0gcdid0

theorem gcd-mod
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℕ                                                           (H2)
  then        gcd(a mod b, b) = gcd(a, b)
  metamath    modgcd
  target      modgcd
  note        One step of Euclid's algorithm keeps the gcd: the remainder
              and the divisor have the gcd the dividend and divisor had.

mundane theorem mod-natural
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℕ                                                           (H2)
  then        a mod b ∈ ℕ₀
  metamath    zmodcl
  target      zmodcl

mundane theorem mod-less
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℕ                                                           (H2)
  then        a mod b < b
  metamath    modlt, said of a real and a positive real, which this corpus
              reaches from an integer and a natural number in
              elaboration/stdlib/proved.mm
  target      gzmodlt

mundane theorem mod-remainder
  let a ∈ ℤ                                                           (H1)
  let m ∈ ℕ                                                           (H2)
  let r ∈ ℕ₀                                                          (H3)
  assume r < m                                                        (H4)
  then        a mod m = r ↔ there is q ∈ ℤ with q·m + r = a
  metamath    modremain
  target      modremain
  note        The remainder is the r left over when a is a whole number of
              m's and r: the last digit of q·10 + r is r, for a digit r.

mundane theorem mod-multiple
  let r ∈ ℤ                                                           (H1)
  let m ∈ ℕ                                                           (H2)
  let q ∈ ℤ                                                           (H3)
  then        (q·m + r) mod m = r mod m
  metamath    muladdmod, said of a real and a positive real, which this
              corpus reaches from integers and a natural number in
              elaboration/stdlib/proved.mm
  target      gmuladdmod
  note        A whole number of m's added changes no remainder: the last
              digit of q·10 + r is the last digit of r.

mundane theorem zero-divides
  let n ∈ ℤ                                                           (H1)
  then        0 divides n ↔ n = 0
  metamath    0dvds
  target      0dvds

mundane theorem divides-self
  let n ∈ ℤ                                                           (H1)
  then        n divides n
  metamath    iddvds
  target      iddvds

mundane theorem prime-nat
  let p ∈ ℤ                                                           (H1)
  assume p is prime                                                   (H2)
  then        p ∈ ℕ
  metamath    prmnn
  target      prmnn

mundane theorem two-prime
  then        2 is prime
  metamath    2prm
  target      2prm

mundane theorem prime-coprime
  let p ∈ ℕ                                                           (H1)
  assume p is prime                                                   (H2)
  let a ∈ ℤ                                                           (H3)
  assume not (p divides a)                                            (H4)
  then        gcd(p, a) = 1
  metamath    coprm, read left to right
  target      coprm
  note        A prime shares a factor with a only by dividing it, since its
              only divisors are 1 and itself.

definition σ
  sort        number → number
  builds      c1 _1 csgm co
  reads       the sum of the divisors of
  let n ∈ ℕ                                                           (H1)
  then        σ(n) = Σ(d ∈ ℕ : d divides n) d
  metamath    sgmval2 with its power 1 written away, which this corpus proves
              in elaboration/stdlib/proved.mm
  target      g1sgmval
  note        set.mm's sigma takes a power first, A sigma n being the sum of
              the A-th powers of the divisors of n, and σ is 1 sigma n.

definition perfect
  let n ∈ ℕ                                                           (H1)
  then        n is perfect ↔ σ(n) = 2n
  metamath    the notation's own target, σ(n) = 2n
  note        The two sides are one formula in the kernel, as for
              mun:stdlib/divisibility/congruent-mod, so unfolding it says the
              same thing the other way. A proof names it: "so n is perfect,
              by definition".

theorem sigma-multiplicative
  let m ∈ ℕ                                                           (H1)
  let n ∈ ℕ                                                           (H2)
  assume gcd(m, n) = 1                                                (H3)
  then        σ(m·n) = σ(m)·σ(n)
  metamath    sgmmul
  target      sgmmul with A := 1

theorem sigma-prime
  let p ∈ ℕ                                                           (H1)
  assume p is prime                                                   (H2)
  then        σ(p) = p + 1
  metamath    1sgmprm
  target      1sgmprm

theorem sigma-prime-power
  let p ∈ ℕ                                                           (H1)
  assume p is prime                                                   (H2)
  let k ∈ ℕ₀                                                          (H3)
  then        σ(p^k) = Σ(j = 0 to k) p^j
  metamath    sgmppw with its power 1 written away, which this corpus proves
              in elaboration/stdlib/proved.mm
  target      g1sgmppw
  note        The divisors of p^k are 1, p, …, p^k, so their sum is a
              geometric series.

theorem prime-powers-unique
  let a ∈ ℕ₀                                                          (H1)
  let b ∈ ℕ₀                                                          (H2)
  let c ∈ ℕ₀                                                          (H3)
  let a′ ∈ ℕ₀                                                         (H4)
  let b′ ∈ ℕ₀                                                         (H5)
  let c′ ∈ ℕ₀                                                         (H6)
  assume 2^a·3^b·5^c = 2^a′·3^b′·5^c′                                 (H7)
  then        a = a′. b = b′. c = c′.
  metamath    g235a, g235b, g235c, which this corpus proves in
              elaboration/stdlib/proved.mm from pcmul, pcidlem and pcexp
  target      g235a, g235b, g235c with A := a, B := b, C := c, D := a′, E := b′, F := c′
  note        A number has one factorisation into primes, so the powers of
              2, 3 and 5 in it are what they are. set.mm counts how many
              times a prime divides a number, pCnt, and the count of 2 in
              2^a·3^b·5^c is a. One target to a sentence.

definition φ
  sort        number → number
  builds      _1 cphi cfv
  reads       Euler's φ, how many whole numbers below n have no factor in common with
  let n ∈ ℕ                                                           (H1)
  then        φ(n) = |{r ∈ {0, …, n − 1} : gcd(r, n) = 1}|
  metamath    dfphi2 with 0 ..^ n read as 0 ... n − 1 by fzoval, which this
              corpus proves in elaboration/stdlib/proved.mm
  target      gphival

mundane theorem phi-natural
  let n ∈ ℕ                                                           (H1)
  then        φ(n) ∈ ℕ
  metamath    phicl
  target      phicl

mundane theorem coprime-product
  let x ∈ ℤ                                                           (H1)
  let y ∈ ℤ                                                           (H2)
  let n ∈ ℕ                                                           (H3)
  assume gcd(x, n) = 1                                                (H4)
  assume gcd(y, n) = 1                                                (H5)
  then        gcd(x·y, n) = 1
  metamath    rpmul, which puts n first in each gcd, and gcdcom, which this
              corpus proves together in elaboration/stdlib/proved.mm
  target      grpmul

theorem congruent-cancel
  let x ∈ ℤ                                                           (H1)
  let y ∈ ℤ                                                           (H2)
  let c ∈ ℤ                                                           (H3)
  let n ∈ ℕ                                                           (H4)
  assume x·c ≡ y·c (mod n)                                            (H5)
  assume gcd(c, n) = 1                                                (H6)
  then        x ≡ y (mod n)
  metamath    subdir and coprmdvds, which this corpus proves together in
              elaboration/stdlib/proved.mm
  target      gcongrcan
  note        A factor with no factor in common with n cancels from both
              sides of a congruence modulo n.

theorem coprime-divides
  let x ∈ ℤ                                                           (H1)
  let c ∈ ℤ                                                           (H2)
  let n ∈ ℕ                                                           (H3)
  assume n divides x·c                                                (H4)
  assume gcd(c, n) = 1                                                (H5)
  then        n divides x
  metamath    coprmdvds, with the coprime factor first, which this corpus
              proves in elaboration/stdlib/proved.mm
  target      gcoprmdvds
  note        A number dividing a product and sharing no factor with one
              of its factors divides the other: Euclid's lemma, said of any
              number and not only of a prime.

mundane theorem congruent-in-range
  let n ∈ ℕ                                                           (H1)
  let x ∈ {0, …, n − 1}                                               (H2)
  let y ∈ {0, …, n − 1}                                               (H3)
  assume x ≡ y (mod n)                                                (H4)
  then        x = y
  metamath    fzocongeq, with 0 ..^ n read as 0 ... n − 1 by fzoval, which
              this corpus proves in elaboration/stdlib/proved.mm
  target      gfzocong0

mundane theorem mod-congruent
  let x ∈ ℤ                                                           (H1)
  let n ∈ ℕ                                                           (H2)
  then        x ≡ x mod n (mod n)
  metamath    moddvds and modabs2, which this corpus proves together in
              elaboration/stdlib/proved.mm
  target      gmodcong

mundane theorem mod-equal-congruent
  let x ∈ ℤ                                                           (H1)
  let y ∈ ℤ                                                           (H2)
  let n ∈ ℕ                                                           (H3)
  assume x mod n = y mod n                                            (H4)
  then        x ≡ y (mod n)
  metamath    moddvds, read one way, which this corpus proves in
              elaboration/stdlib/proved.mm
  target      gmodeqdvds

theorem product-coprime
  let X ⊆ ℤ                                                           (H1)
  assume X is finite                                                  (H2)
  let n ∈ ℕ                                                           (H3)
  assume for all y ∈ X, gcd(y, n) = 1                                 (H4)
  then        gcd(∏(x ∈ X) x, n) = 1
  metamath    gfprodrp, which this corpus proves in
              elaboration/stdlib/proved.mm by induction on the finite set
              (findcard2d), a factor at a time (fprodsplitsn, rpmul)
  target      gfprodrp
  note        A product of numbers with no factor in common with n has none
              in common with n either. set.mm's coprmprod says so only of
              factors that are coprime to each other as well.

theorem product-congruent
  let X ⊆ ℤ                                                           (H1)
  assume X is finite                                                  (H2)
  let c ∈ ℤ                                                           (H3)
  let n ∈ ℕ                                                           (H4)
  let f : X → X                                                       (H5)
  assume for all y ∈ X, y·c ≡ f(y) (mod n)                            (H6)
  then        ∏(x ∈ X) x·c ≡ ∏(x ∈ X) f(x) (mod n)
  metamath    fprodmodd and moddvds, which this corpus proves together in
              elaboration/stdlib/proved.mm
  target      gfprodcong
  note        Congruences multiply: the products of two lists of terms,
              congruent term by term, are congruent.

theorem coprime-square
  let s ∈ ℕ                                                           (H1)
  let t ∈ ℕ                                                           (H2)
  let w ∈ ℕ                                                           (H3)
  assume gcd(s, t) = 1                                                (H4)
  assume w² = s·t                                                     (H5)
  then        s = gcd(s, w)². t = gcd(t, w)².
  metamath    coprimeprodsq and coprimeprodsq2, which ask only that s, t
              and w share no factor all three, and gcd(1, w) = 1 (1gcd);
              this corpus proves them together in
              elaboration/stdlib/proved.mm
  target      gcoprimesq, gcoprimesq2
  note        Two numbers with no factor in common whose product is a
              square are squares themselves, of their common factors with
              the square root.

mundane theorem divides-square
  let d ∈ ℤ                                                           (H1)
  let n ∈ ℤ                                                           (H2)
  then        d divides n ↔ d² divides n²
  metamath    dvdssq
  target      dvdssq

mundane theorem divides-quotient
  let n ∈ ℕ                                                           (H1)
  let d ∈ ℕ                                                           (H2)
  then        d divides n ↔ n/d ∈ ℕ
  metamath    nndivdvds
  target      nndivdvds

mundane theorem gcd-quotients-coprime
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  assume b ≠ 0                                                        (H3)
  then        gcd(a/gcd(a, b), b/gcd(a, b)) = 1
  metamath    divgcdcoprm0
  target      divgcdcoprm0
  note        Dividing two numbers by their greatest common divisor leaves
              two with no factor in common.

mundane theorem divides-transitive
  let d ∈ ℤ                                                           (H1)
  let e ∈ ℤ                                                           (H2)
  let n ∈ ℤ                                                           (H3)
  assume d divides e                                                  (H4)
  assume e divides n                                                  (H5)
  then        d divides n
  metamath    dvdstr
  target      dvdstr

