# Standard library: divisibility
#
# Even and odd, divisors, primes, greatest common divisors, division with a
# remainder, and congruence modulo a number.
#
# One record per item. A record begins at column 0 with its kind, axiom,
# theorem or definition, and its name; `mundane` before the kind marks an
# item a proof takes for granted. A proof imports each item it cites,
# `import <header> stdlib/divisibility/<name>`, where the header is the
# record's own before its name, as `mundane theorem` or `axiom`. Format is described in DATABASE.md.
#
# An item's statement is written in the theorem form of SYNTAX.md: let and
# assume lines with labels, then a `then` line.
#
# Every item carries both:
#   metamath-proof  how the Metamath build proves it: a set.mm label, the
#                   full name of a Parley proof or of a bridge, `none` where
#                   it has nothing to prove, or `not yet implemented`
#   lean-proof      the same for the Lean build, a Mathlib proof in place of
#                   a set.mm label
#
# Other fields: note.


definition divides
  let d ∈ ℤ                                                           (H1)
  let n ∈ ℤ                                                           (H2)
  then        d divides n ↔ there is k ∈ ℤ with n = d·k
  decided     arithmetic, inspection
  metamath-proof divides, equation reversed
  lean-proof Iff.rfl
  note        Defined once on ℤ. A proof about ℕ discharges membership of ℤ as a
              dull fact. This is the principle recorded by the primes pilot: a
              relation is defined once, on the widest set where it makes sense.

definition even
  let n ∈ ℤ                                                           (H1)
  then        n is even ↔ there is k ∈ ℤ with n = 2k
  decided     arithmetic, inspection
  metamath-proof divides, equation reversed
  lean-proof even_iff_exists_two_mul
  note        set.mm writes 2 ∥ n and has no primitive for "even". This names the
              word. See DATABASE.md on what def: means.

              The field said `dvds`, which is not a label. df-dvds defines ∥ as
              the pairs with an n ∈ ℤ making n·x = y, so the unfolding is the
              same existential this statement writes. Found by checking every
              label the database names against set.mm.

definition odd
  let n ∈ ℤ                                                           (H1)
  then        n is odd ↔ there is k ∈ ℤ with n = 2k + 1
  decided     arithmetic, inspection
  metamath-proof metamath-bridges/parity/godd2np1, equation reversed
  lean-proof Iff.rfl
  note        "n is odd" is set.mm's odd integer, n ∈ ℤ and not 2 ∥ n;
              godd2np1 is odd2np1 with the membership joined, and is proved
              in elaboration/stdlib/proved.mm.

mundane theorem even-or-odd
  let n ∈ ℤ                                                           (H1)
  then        n is even or n is odd
  metamath-proof metamath-bridges/parity/gevenodd
  lean-proof Int.even_or_odd n
  note        zeo3 says 2 ∥ n or not 2 ∥ n of an integer; gevenodd joins H1
              to its second case, which is what "n is odd" says.

mundane theorem not-both
  let n ∈ ℤ                                                           (H1)
  assume n is even                                                    (H2)
  then        n is not odd
  metamath-proof metamath-bridges/parity/gnotboth
  lean-proof Int.not_odd_iff_even.mpr h2
  note        "n is odd" says not 2 ∥ n, which H2 denies.

mundane theorem odd-not-even
  let n ∈ ℤ                                                           (H1)
  assume n is odd                                                     (H2)
  then        not (n is even)
  metamath-proof simpr
  note        not-both the other way: "n is not even" is the second part of
              what "n is odd" says.
  lean-proof  Int.not_even_iff_odd.mpr h2

mundane theorem odd-not-divisible
  let n ∈ ℤ                                                           (H1)
  assume n is odd                                                     (H2)
  then        not (2 divides n)
  metamath-proof simpr
  note        "not (2 divides n)" is the second part of what "n is odd"
              says, as for "n is not even".
  lean-proof  by rw [Int.two_dvd_ne_zero]; exact Int.odd_iff.1 h2

mundane theorem odd-plus-odd
  let a ∈ ℤ                                                           (H1)
  assume a is odd                                                     (H2)
  let b ∈ ℤ                                                           (H3)
  assume b is odd                                                     (H4)
  then        a + b is even
  metamath-proof opoe
  note        `proofs/setmm/parity.proof` proves it as its own exercise
              (DATABASE.md).
  lean-proof  Odd.add_odd h2 h4

mundane theorem odd-minus-odd
  let a ∈ ℤ                                                           (H1)
  assume a is odd                                                     (H2)
  let b ∈ ℤ                                                           (H3)
  assume b is odd                                                     (H4)
  then        a − b is even
  metamath-proof omoe
  note        `proofs/setmm/parity.proof` proves it as its own exercise
              (DATABASE.md).
  lean-proof  Odd.sub_odd h2 h4

mundane theorem odd-plus-even
  let a ∈ ℤ                                                           (H1)
  assume a is odd                                                     (H2)
  let b ∈ ℤ                                                           (H3)
  assume b is even                                                    (H4)
  then        a + b is odd
  metamath-proof metamath-bridges/parity/gopeo
  note        opeo concludes not 2 ∥ (a + b); gopeo joins a + b ∈ ℤ, which
              "is odd" says too.
  lean-proof  Odd.add_even h2 h4

mundane theorem odd-minus-even
  let a ∈ ℤ                                                           (H1)
  assume a is odd                                                     (H2)
  let b ∈ ℤ                                                           (H3)
  assume b is even                                                    (H4)
  then        a − b is odd
  metamath-proof metamath-bridges/parity/gomeo
  note        omeo concludes not 2 ∥ (a − b); gomeo joins a − b ∈ ℤ, which
              "is odd" says too.
  lean-proof  Odd.sub_even h2 h4

mundane theorem even-product
  let a ∈ ℤ                                                           (H1)
  assume a is even                                                    (H2)
  let x ∈ ℤ                                                           (H3)
  then        a·x is even
  metamath-proof dvdsmultr1 with K := 2
  lean-proof h2.mul_right x
  note        An even number times any integer is even:
              mun:stdlib/divisibility/divides-multiple at 2, said in the
              words even and odd use.

mundane theorem even-product-factor
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  then        a·b is even ↔ a is even or b is even
  metamath-proof euclemma with P := 2
  lean-proof Int.even_mul
  note        thm:stdlib/divisibility/prime-divides-product at 2, said in
              the words even and odd use. An odd factor of an even product
              leaves the other even.

theorem prime-divides-product
  let p ∈ ℕ                                                           (H1)
  assume p is prime                                                   (H2)
  let m ∈ ℤ                                                           (H3)
  let n ∈ ℤ                                                           (H4)
  then        p divides m·n ↔ p divides m or p divides n
  metamath-proof euclemma
  note        Euclid's lemma. `proofs/setmm/prime-divides-product.proof`
              proves it as its own exercise (DATABASE.md).
  lean-proof  lean-bridges/divisibility/prime-divides-product

theorem prime-divides-power
  let p ∈ ℕ                                                           (H1)
  assume p is prime                                                   (H2)
  let a ∈ ℤ                                                           (H3)
  let n ∈ ℕ                                                           (H4)
  then        p divides a^n ↔ p divides a
  metamath-proof prmdvdsexp
  note        Euclid's lemma over the n factors of a^n.
  lean-proof  by exact ⟨fun h => Int.Prime.dvd_pow' h2 h, fun h => dvd_pow h (Nat.pos_iff_ne_zero.mp h4)⟩

theorem divides-gcd
  let d ∈ ℤ                                                           (H1)
  let a ∈ ℤ                                                           (H2)
  let b ∈ ℤ                                                           (H3)
  assume d divides a                                                  (H4)
  assume d divides b                                                  (H5)
  then        d divides gcd(a, b)
  metamath-proof dvdsgcd
  lean-proof Int.dvd_coe_gcd h4 h5

theorem division-algorithm
  let n ∈ ℕ                                                           (H1)
  let d ∈ ℕ                                                           (H2)
  then        there exist q, r ∈ ℤ such that n = q·d + r, 0 ≤ r, and r < d
  metamath-proof divalg with N := n, D := d
  note        divalg says exactly one remainder, quantified the other way
              round, bounded by the absolute value, and saying its three
              things in a different order. The elaborator takes its
              existential apart and puts this one back, which is what makes
              the last two of those stop being differences. Nothing fixes
              divalg's own variables, because its conclusion is never
              matched against this claim, so `with` says which is which.
  lean-proof  ⟨(n : ℤ) / d, (n : ℤ) % d, ⟨by rw [mul_comm]; exact (Int.mul_ediv_add_emod _ _).symm, Int.emod_nonneg _ (by omega)⟩, Int.emod_lt_of_pos _ (by omega)⟩

definition prime
  let p ∈ ℕ                                                           (H1)
  then        p is prime ↔ p > 1 and for all d ∈ ℕ, if d divides p then
              d = 1 or d = p
  metamath-proof isprm2
  decided     inspection
  note        Whether a number below 841 is prime is seen by inspection, by
              trial division by the primes up to 23 (`METHODS.md`).
              isprm2 writes p > 1 as p ∈ ℤ≥2, which is not the formula this
              line writes, so unfolding the definition does not land on the
              words of the right side. What carries one to the other is
              eluz2gt1, declared with the rest of what an elaborator may
              lean on. `target` still names the unfolding and nothing else.
  lean-proof  lean-bridges/divisibility/prime

definition gcd
  sort        number, number → number
  metamath-builds _1 _2 cgcd co
  reads       the greatest common divisor of
  let a ∈ ℕ                                                           (H1)
  let b ∈ ℕ                                                           (H2)
  then        gcd(a, b) ∈ ℕ. gcd(a, b) divides a. gcd(a, b) divides b.
              For all e ∈ ℕ, if e divides a and e divides b then
              e ≤ gcd(a, b).
  metamath-proof gcdnncl, gcddvds, dvdslegcd
  lean-proof  lean-bridges/divisibility/gcd-1 ; Int.gcd_dvd_left a b ; Int.gcd_dvd_right a b ; lean-bridges/divisibility/gcd-4
  lean-builds ℤ, ℤ → ℕ: Int.gcd _1 _2
  note        Four sentences from three lemmas. gcdcl puts a gcd in ℕ₀ and
              this statement puts it in ℕ, which gcdnncl gives because both
              arguments are natural numbers; gcddvds says in one conjunction
              what the second and third sentences say separately; and
              dvdslegcd is the fourth said of one divisor where this says it
              of every e ∈ ℕ.

definition lcm
  sort        number, number → number
  metamath-builds _1 _2 clcm co
  lean-builds ℤ, ℤ → ℕ: Int.lcm _1 _2
  reads       the least common multiple of
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  then        lcm(a, b) ∈ ℕ₀. a divides lcm(a, b). b divides lcm(a, b).
              For all k ∈ ℤ, if a divides k and b divides k then
              lcm(a, b) divides k.
  metamath-proof lcmcl, dvdslcm, lcmdvds
  lean-proof  lean-bridges/divisibility/lcm-1 ; Int.dvd_lcm_left a b ; Int.dvd_lcm_right a b ; lean-bridges/divisibility/lcm-4
  note        As gcd: four sentences from three lemmas, dvdslcm saying the
              second and third in one conjunction and lcmdvds the fourth of
              one multiple. "Least" is in the divisibility order, as set.mm
              has it, so lcm(a, 0) = 0.

mundane theorem lcm-times-gcd
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  then        lcm(a, b)·gcd(a, b) = |a·b|
  metamath-proof lcmgcd
  lean-proof  by rw [abs_mul, Int.abs_eq_natAbs, Int.abs_eq_natAbs, mul_comm]; exact_mod_cast Int.gcd_mul_lcm a b

theorem prime-factor
  let m ∈ ℕ                                                           (H1)
  assume m > 1                                                        (H2)
  then        there is p ∈ ℕ with p is prime and p divides m
  metamath-proof exprmfct
  note        No target, so an elaborator states this and lists it. exprmfct
              says E. p e. Prime p || N, putting primality in the domain; this
              quantifies over ℕ and says it in the body, which is how a reader
              meets the claim. The two are equivalent and the bridge is a proof
              rather than a field of this file.
  lean-proof  lean-bridges/divisibility/prime-factor

mundane theorem divides-sum
  let d ∈ ℤ                                                           (H1)
  let a ∈ ℤ                                                           (H2)
  let b ∈ ℤ                                                           (H3)
  assume d divides a                                                  (H4)
  assume d divides b                                                  (H5)
  then        d divides a + b
  metamath-proof dvds2add
  lean-proof dvd_add h4 h5

mundane theorem divides-difference
  let d ∈ ℤ                                                           (H1)
  let a ∈ ℤ                                                           (H2)
  let b ∈ ℤ                                                           (H3)
  assume d divides a                                                  (H4)
  assume d divides b                                                  (H5)
  then        d divides a − b
  metamath-proof dvds2sub
  lean-proof dvd_sub h4 h5

mundane theorem divides-one
  let d ∈ ℕ                                                           (H1)
  assume d divides 1                                                  (H2)
  then        d = 1
  metamath-proof dvds1
  lean-proof  lean-bridges/divisibility/divides-one

mundane theorem divides-combination
  let e ∈ ℤ                                                           (H1)
  let a ∈ ℤ                                                           (H2)
  let b ∈ ℤ                                                           (H3)
  let x ∈ ℤ                                                           (H4)
  let y ∈ ℤ                                                           (H5)
  assume e divides a                                                  (H6)
  assume e divides b                                                  (H7)
  then        e divides a·x + b·y
  metamath-proof dvds2ln with K := e, I := x, M := a, J := y, N := b
  lean-proof dvd_add (Dvd.dvd.mul_right h6 x) (Dvd.dvd.mul_right h7 y)

mundane theorem divides-le
  let e ∈ ℕ                                                           (H1)
  let m ∈ ℕ                                                           (H2)
  assume e divides m                                                  (H3)
  then        e ≤ m
  metamath-proof dvdsle
  lean-proof Int.le_of_dvd (by omega) h3

mundane theorem below-not-divisible
  let n ∈ ℕ                                                           (H1)
  let x ∈ ℕ                                                           (H2)
  assume x < n                                                        (H3)
  then        not (n divides x)
  metamath-proof metamath-bridges/divisors/gnndvdslt with N := n, K := x
  note        A natural number below n is too small for n to divide it.
  lean-proof  by intro h; have := Int.le_of_dvd (by omega) h; omega

definition congruent-mod
  let n ∈ ℤ                                                           (H1)
  let a ∈ ℤ                                                           (H2)
  let b ∈ ℤ                                                           (H3)
  then        a ≡ b (mod n) ↔ n divides a − b
  decided     arithmetic
  lean-proof Int.modEq_comm.trans Int.modEq_iff_dvd
  note        The two sides are one formula in the kernel, so unfolding it is
              saying the same thing the other way, and nothing is stated: a
              step reading one from a line saying the other has that line's
              proof. It is here so the page may say which it means.
  metamath-proof none

mundane theorem divides-multiple
  let e ∈ ℤ                                                           (H1)
  let a ∈ ℤ                                                           (H2)
  let x ∈ ℤ                                                           (H3)
  assume e divides a                                                  (H4)
  then        e divides a·x
  metamath-proof dvdsmultr1
  lean-proof Dvd.dvd.mul_right h4 x

mundane theorem congruent-divides
  let m ∈ ℤ                                                           (H1)
  let a ∈ ℤ                                                           (H2)
  let b ∈ ℤ                                                           (H3)
  assume a ≡ b (mod m)                                                (H4)
  then        m divides a ↔ m divides b
  metamath-proof dvdssub2
  note        Two numbers congruent modulo m are divisible by m together.
  lean-proof  Int.ModEq.dvd_iff h4

mundane theorem gcd-integer
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  then        gcd(a, b) ∈ ℕ₀. gcd(a, b) divides a. gcd(a, b) divides b.
  metamath-proof gcdcl, gcddvds
  note        The gcd over the integers, where the definition says it over
              ℕ: it is at least 0, being 0 only for gcd(0, 0), and divides
              both arguments.
  lean-proof  lean-bridges/divisibility/gcd-integer-1 ; Int.gcd_dvd_left a b ; Int.gcd_dvd_right a b

mundane theorem gcd-natural
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  assume not (a = 0 and b = 0)                                        (H3)
  then        gcd(a, b) ∈ ℕ
  metamath-proof gcdn0cl
  lean-proof  by have h0 : Int.gcd a b ≠ 0 := (by intro h0; rw [Int.gcd_eq_zero_iff] at h0; exact h3 h0); omega

mundane theorem gcd-scaled
  let c ∈ ℕ₀                                                          (H1)
  let a ∈ ℤ                                                           (H2)
  let b ∈ ℤ                                                           (H3)
  then        gcd(c·a, c·b) = c·gcd(a, b)
  metamath-proof mulgcd
  lean-proof  by rw [Int.gcd_mul_left]; simp

mundane theorem gcd-scaled-integer
  let c ∈ ℤ                                                           (H1)
  let a ∈ ℤ                                                           (H2)
  let b ∈ ℤ                                                           (H3)
  then        gcd(c·a, c·b) = |c·gcd(a, b)|
  metamath-proof absmulgcd
  note        gcd-scaled for a factor of either sign.
  lean-proof  by rw [Int.gcd_mul_left, abs_mul]; simp

mundane theorem gcd-negative
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  then        gcd(−a, b) = gcd(a, b)
  metamath-proof neggcd
  lean-proof  by (simp_all; done)

mundane theorem gcd-commutes
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  then        gcd(a, b) = gcd(b, a)
  metamath-proof gcdcom
  lean-proof  lean-bridges/divisibility/gcd-commutes

mundane theorem gcd-one
  let a ∈ ℤ                                                           (H1)
  then        gcd(a, 1) = 1
  metamath-proof gcd1
  lean-proof  lean-bridges/divisibility/gcd-one

mundane theorem gcd-zero
  let n ∈ ℕ₀                                                          (H1)
  then        gcd(n, 0) = n
  metamath-proof nn0gcdid0
  lean-proof  lean-bridges/divisibility/gcd-zero

theorem gcd-mod
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℕ                                                           (H2)
  then        gcd(a mod b, b) = gcd(a, b)
  metamath-proof modgcd
  lean-proof  lean-bridges/divisibility/gcd-mod
  note        One step of Euclid's algorithm keeps the gcd: the remainder
              and the divisor have the gcd the dividend and divisor had.

mundane theorem mod-natural
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℕ                                                           (H2)
  then        a mod b ∈ ℕ₀
  metamath-proof zmodcl
  lean-proof  Int.emod_nonneg a (by omega)

mundane theorem mod-less
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℕ                                                           (H2)
  then        a mod b < b
  metamath-proof metamath-bridges/numbers/gzmodlt
  lean-proof  Int.emod_lt_of_pos a (by omega)

mundane theorem mod-remainder
  let a ∈ ℤ                                                           (H1)
  let m ∈ ℕ                                                           (H2)
  let r ∈ ℕ₀                                                          (H3)
  assume r < m                                                        (H4)
  then        a mod m = r ↔ there is q ∈ ℤ with q·m + r = a
  metamath-proof modremain
  lean-proof  lean-bridges/divisibility/mod-remainder
  note        The remainder is the r left over when a is a whole number of
              m's and r: the last digit of q·10 + r is r, for a digit r.

mundane theorem mod-multiple
  let r ∈ ℤ                                                           (H1)
  let m ∈ ℕ                                                           (H2)
  let q ∈ ℤ                                                           (H3)
  then        (q·m + r) mod m = r mod m
  metamath-proof metamath-bridges/numbers/gmuladdmod
  lean-proof  lean-bridges/divisibility/mod-multiple
  note        A whole number of m's added changes no remainder: the last
              digit of q·10 + r is the last digit of r.

mundane theorem mod-real
  let a ∈ ℝ                                                           (H1)
  let b ∈ ℝ                                                           (H2)
  assume b > 0                                                        (H3)
  then        a mod b ∈ ℝ
  metamath-proof metamath-bridges/numbers/gmodcl
  note        A remainder is a number: mod-natural says so of whole numbers,
              this of reals.
  lean-proof  by (simp_all; done)

mundane theorem mod-value
  let a ∈ ℝ                                                           (H1)
  let b ∈ ℝ                                                           (H2)
  assume b > 0                                                        (H3)
  then        a mod b = a − b·⌊a/b⌋
  metamath-proof metamath-bridges/numbers/gmodval
  note        The remainder of any real on dividing by a positive one: as
              many whole b's as fit below a are taken away, so 7.5 mod 2 is
              7.5 − 2·3 = 1.5 and −1 mod 3 is −1 − 3·(−1) = 2. For whole
              numbers it is the remainder mod-remainder describes.
  lean-proof  rfl

mundane theorem mod-below
  let a ∈ ℝ                                                           (H1)
  let b ∈ ℝ                                                           (H2)
  assume 0 ≤ a                                                        (H3)
  assume a < b                                                        (H4)
  then        a mod b = a
  metamath-proof metamath-bridges/numbers/gmodid
  note        A number already below the divisor is its own remainder.
  lean-proof  by unfold LeanBridges.Divisibility.mod; have hb : 0 < b := (by linarith); have h0 : ⌊a / b⌋ = 0 := Int.floor_eq_zero_iff.2 ⟨div_nonneg h3 hb.le, (div_lt_one hb).2 h4⟩; rw [h0]; simp

mundane theorem zero-divides
  let n ∈ ℤ                                                           (H1)
  then        0 divides n ↔ n = 0
  metamath-proof 0dvds
  lean-proof  zero_dvd_iff

mundane theorem divides-self
  let n ∈ ℤ                                                           (H1)
  then        n divides n
  metamath-proof iddvds
  lean-proof dvd_refl n

mundane theorem prime-nat
  let p ∈ ℤ                                                           (H1)
  assume p is prime                                                   (H2)
  then        p ∈ ℕ
  metamath-proof prmnn
  lean-proof  lean-bridges/divisibility/prime-nat

mundane theorem two-prime
  then        2 is prime
  metamath-proof 2prm
  lean-proof  by norm_num at *

mundane theorem prime-coprime
  let p ∈ ℕ                                                           (H1)
  assume p is prime                                                   (H2)
  let a ∈ ℤ                                                           (H3)
  assume not (p divides a)                                            (H4)
  then        gcd(p, a) = 1
  metamath-proof coprm
  note        A prime shares a factor with a only by dividing it, since its
              only divisors are 1 and itself.
  lean-proof  lean-bridges/divisibility/prime-coprime

definition σ
  sort        number → number
  metamath-builds c1 _1 csgm co
  lean-builds ℕ → ℕ: ArithmeticFunction.sigma 1 _1 ; ℤ → ℕ: ArithmeticFunction.sigma 1 _1.toNat
  reads       the sum of the divisors of
  let n ∈ ℕ                                                           (H1)
  then        σ(n) = Σ(d ∈ ℕ : d divides n) d
  metamath-proof metamath-bridges/divisors/g1sgmval
  note        set.mm's sigma takes a power first, A sigma n being the sum of
              the A-th powers of the divisors of n, and σ is 1 sigma n.
  lean-proof  not yet implemented

definition perfect
  let n ∈ ℕ                                                           (H1)
  then        n is perfect ↔ σ(n) = 2n
  note        The two sides are one formula in the kernel, as for
              def:stdlib/divisibility/congruent-mod, so unfolding it says the
              same thing the other way. A proof names it: "so n is perfect,
              by definition".
  metamath-proof none
  lean-proof  by omega

theorem sigma-multiplicative
  let m ∈ ℕ                                                           (H1)
  let n ∈ ℕ                                                           (H2)
  assume gcd(m, n) = 1                                                (H3)
  then        σ(m·n) = σ(m)·σ(n)
  metamath-proof sgmmul with A := 1
  lean-proof  by have hc : Nat.Coprime m n := (by have h := h3; rw [Int.gcd_natCast_natCast] at h; exact_mod_cast h); exact_mod_cast ArithmeticFunction.isMultiplicative_sigma.map_mul_of_coprime hc

theorem sigma-prime
  let p ∈ ℕ                                                           (H1)
  assume p is prime                                                   (H2)
  then        σ(p) = p + 1
  metamath-proof 1sgmprm
  lean-proof  by have h := ArithmeticFunction.sigma_one_apply_prime_pow h2 (i := 1); rw [pow_one] at h; rw [h]; push_cast [Finset.sum_range_succ]; ring

theorem sigma-prime-power
  let p ∈ ℕ                                                           (H1)
  assume p is prime                                                   (H2)
  let k ∈ ℕ₀                                                          (H3)
  then        σ(p^k) = Σ(j = 0 to k) p^j
  metamath-proof metamath-bridges/divisors/g1sgmppw
  note        The divisors of p^k are 1, p, …, p^k, so their sum is a
              geometric series.
  lean-proof  by rw [ArithmeticFunction.sigma_one_apply_prime_pow h2]; push_cast; rw [(show Finset.Icc (0 : ℤ) (k : ℤ) = (Finset.range (k + 1)).map ⟨fun i : ℕ => (i : ℤ), Nat.cast_injective⟩ by ext j; simp only [Finset.mem_Icc, Finset.mem_map, Finset.mem_range, Function.Embedding.coeFn_mk]; constructor; (rintro ⟨h0, hk⟩; exact ⟨j.toNat, by omega, by omega⟩); (rintro ⟨i, hi, rfl⟩; omega))]; simp [zpow_natCast]

mundane theorem sigma-nat
  let n ∈ ℕ                                                           (H1)
  then        σ(n) ∈ ℕ
  metamath-proof sgmnncl with A := 1
  lean-proof  by (simp_all; done)

mundane theorem sigma-part
  let n ∈ ℕ                                                           (H1)
  let Y ⊆ {d ∈ ℕ : d divides n}                                       (H2)
  then        Σ(d ∈ Y) d ≤ σ(n)
  metamath-proof metamath-bridges/divisors/g1sgmpart
  note        A sum of some of the divisors of n is at most the sum of all
              of them: leaving out numbers none of which is below 0 cannot
              make a sum larger.
  lean-proof  by have hD : Y ⊆ ((n.divisors.map ⟨fun i : ℕ => (i : ℤ), Nat.cast_injective⟩ : Finset ℤ) : Set ℤ) := (by intro d hd; obtain ⟨hp, hdv⟩ := h2 hd; simp only [Finset.coe_map, Function.Embedding.coeFn_mk, Set.mem_image, Finset.mem_coe, Nat.mem_divisors]; refine ⟨d.natAbs, ⟨?_, (by omega)⟩, (by omega)⟩; have := Int.natAbs_dvd_natAbs.mpr hdv; simpa using this); have hfin : Y.Finite := (Finset.finite_toSet _).subset hD; rw [finsum_mem_eq_finite_toFinset_sum _ hfin, ArithmeticFunction.sigma_one_apply]; push_cast; have hmap : ∑ x ∈ n.divisors, (x : ℤ) = ∑ x ∈ n.divisors.map ⟨fun i : ℕ => (i : ℤ), Nat.cast_injective⟩, x := (by simp [Finset.sum_map]); rw [hmap]; apply Finset.sum_le_sum_of_subset_of_nonneg; (intro d hd; have := hD ((Set.Finite.mem_toFinset hfin).mp hd); simpa using this); (intro d hd _; simp only [Finset.mem_map, Function.Embedding.coeFn_mk] at hd; obtain ⟨i, _, rfl⟩ := hd; positivity)

mundane theorem one-divides
  let n ∈ ℤ                                                           (H1)
  then        1 divides n
  metamath-proof 1dvds
  lean-proof  by simp_all

mundane theorem coprime-power
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  let k ∈ ℕ₀                                                          (H3)
  assume gcd(a, b) = 1                                                (H4)
  then        gcd(a^k, b) = 1
  metamath-proof rpexp1i
  note        A number sharing no factor with b shares none with b in any
              of its powers.
  lean-proof  by have h : IsCoprime a b := Int.isCoprime_iff_gcd_eq_one.2 (by exact_mod_cast h4); exact_mod_cast Int.isCoprime_iff_gcd_eq_one.1 (h.pow_left (m := k))

definition φ
  sort        number → number
  metamath-builds _1 cphi cfv
  lean-builds ℕ → ℕ: Nat.totient _1
  reads       Euler's φ, how many whole numbers below n have no factor in common with
  let n ∈ ℕ                                                           (H1)
  then        φ(n) = |{r ∈ {0, …, n − 1} : gcd(r, n) = 1}|
  metamath-proof metamath-bridges/totient/gphival
  lean-proof  by rw [Nat.totient_eq_card_coprime]; have e : {r ∈ (Set.Icc (0 : ℤ) ((n : ℤ) - 1) : Set ℤ) | (Int.gcd r (n : ℤ) : ℤ) = 1} = (((Finset.range n).filter n.Coprime).map ⟨fun i : ℕ => (i : ℤ), Nat.cast_injective⟩ : Finset ℤ) := (by ext r; simp only [Set.mem_setOf_eq, Set.mem_Icc, Finset.coe_map, Function.Embedding.coeFn_mk, Set.mem_image, Finset.mem_coe, Finset.mem_filter, Finset.mem_range]; constructor; (rintro ⟨⟨h0, hr⟩, hg⟩; refine ⟨r.toNat, ⟨(by omega), ?_⟩, (by omega)⟩; rw [Nat.coprime_comm, Nat.Coprime, ← Int.gcd_natCast_natCast, Int.toNat_of_nonneg h0]; exact_mod_cast hg); (rintro ⟨i, ⟨hi, hc⟩, rfl⟩; refine ⟨⟨(by omega), (by omega)⟩, ?_⟩; rw [Int.gcd_natCast_natCast, Nat.Coprime.gcd_eq_one (Nat.coprime_comm.mp hc)]; rfl)); rw [e, Set.ncard_coe_finset, Finset.card_map]

mundane theorem phi-natural
  let n ∈ ℕ                                                           (H1)
  then        φ(n) ∈ ℕ
  metamath-proof phicl
  lean-proof  by (simp_all; done)

theorem phi-prime
  let p ∈ ℕ                                                           (H1)
  assume p is prime                                                   (H2)
  then        φ(p) = p − 1
  metamath-proof phiprm
  note        Below a prime p, only 0 shares a factor with p, so p − 1 of
              the p remainders are counted.
  lean-proof  by rw [Nat.totient_prime h2]; push_cast [Nat.cast_sub h2.one_le]; ring

mundane theorem coprime-product
  let x ∈ ℤ                                                           (H1)
  let y ∈ ℤ                                                           (H2)
  let n ∈ ℕ                                                           (H3)
  assume gcd(x, n) = 1                                                (H4)
  assume gcd(y, n) = 1                                                (H5)
  then        gcd(x·y, n) = 1
  metamath-proof metamath-bridges/totient/grpmul
  lean-proof  by have h4' : IsCoprime x (n : ℤ) := Int.isCoprime_iff_gcd_eq_one.2 (by exact_mod_cast h4); have h5' : IsCoprime y (n : ℤ) := Int.isCoprime_iff_gcd_eq_one.2 (by exact_mod_cast h5); exact_mod_cast Int.isCoprime_iff_gcd_eq_one.1 (h4'.mul_left h5')

mundane theorem congruent-in-range
  let n ∈ ℕ                                                           (H1)
  let x ∈ {0, …, n − 1}                                               (H2)
  let y ∈ {0, …, n − 1}                                               (H3)
  assume x ≡ y (mod n)                                                (H4)
  then        x = y
  metamath-proof metamath-bridges/totient/gfzocong0
  lean-proof  by simp only [Finset.mem_Icc] at h2 h3; have h := Int.ModEq.eq h4; rw [Int.emod_eq_of_lt h2.1 (by omega), Int.emod_eq_of_lt h3.1 (by omega)] at h; exact h

mundane theorem mod-congruent
  let x ∈ ℤ                                                           (H1)
  let n ∈ ℕ                                                           (H2)
  then        x ≡ x mod n (mod n)
  metamath-proof metamath-bridges/totient/gmodcong
  lean-proof  Int.ModEq.symm (Int.mod_modEq x ↑n)

mundane theorem minus-one-congruent
  let n ∈ ℕ                                                           (H1)
  then        n − 1 ≡ −1 (mod n)
  metamath-proof metamath-bridges/divisors/gm1cong with N := n
  note        The two sides differ by n.
  lean-proof  Int.modEq_add_modulus_iff.mp rfl

mundane theorem mod-equal-congruent
  let x ∈ ℤ                                                           (H1)
  let y ∈ ℤ                                                           (H2)
  let n ∈ ℕ                                                           (H3)
  assume x mod n = y mod n                                            (H4)
  then        x ≡ y (mod n)
  metamath-proof metamath-bridges/totient/gmodeqdvds
  lean-proof h4


mundane theorem divides-square
  let d ∈ ℤ                                                           (H1)
  let n ∈ ℤ                                                           (H2)
  then        d divides n ↔ d² divides n²
  metamath-proof dvdssq
  lean-proof  by simp_all

mundane theorem divides-quotient
  let n ∈ ℕ                                                           (H1)
  let d ∈ ℕ                                                           (H2)
  then        d divides n ↔ n/d ∈ ℕ
  metamath-proof nndivdvds
  lean-proof  lean-bridges/divisibility/divides-quotient

mundane theorem gcd-quotients-coprime
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  assume b ≠ 0                                                        (H3)
  then        gcd(a/gcd(a, b), b/gcd(a, b)) = 1
  metamath-proof divgcdcoprm0
  note        Dividing two numbers by their greatest common divisor leaves
              two with no factor in common.
  lean-proof  not yet implemented

mundane theorem divides-transitive
  let d ∈ ℤ                                                           (H1)
  let e ∈ ℤ                                                           (H2)
  let n ∈ ℤ                                                           (H3)
  assume d divides e                                                  (H4)
  assume e divides n                                                  (H5)
  then        d divides n
  metamath-proof dvdstr
  lean-proof  Int.dvd_trans h4 h5

theorem least-combination-divides
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℕ                                                           (H2)
  let c ∈ ℤ                                                           (H3)
  let d ∈ ℕ                                                           (H4)
  let u ∈ ℤ                                                           (H5)
  let v ∈ ℤ                                                           (H6)
  let x₀ ∈ ℤ                                                          (H7)
  let y₀ ∈ ℤ                                                          (H8)
  assume c = a·u + b·v                                                (H9)
  assume d = a·x₀ + b·y₀                                              (H10)
  assume for all x, y ∈ ℤ, if a·x + b·y ∈ ℕ then d ≤ a·x + b·y        (H11)
  then        d divides c
  metamath-proof stdlib/divisibility/least-combination-divides
  lean-proof  stdlib/divisibility/least-combination-divides

theorem bezout
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℕ                                                           (H2)
  then        there exist x, y ∈ ℤ such that a·x + b·y = gcd(a, b)
  metamath-proof stdlib/divisibility/bezout
  lean-proof  ⟨Int.gcdA a b, Int.gcdB a b, (Int.gcd_eq_gcd_ab a b).symm⟩

theorem coprime-divides
  let x ∈ ℤ                                                           (H1)
  let c ∈ ℤ                                                           (H2)
  let n ∈ ℕ                                                           (H3)
  assume n divides x·c                                                (H4)
  assume gcd(c, n) = 1                                                (H5)
  then        n divides x
  metamath-proof stdlib/divisibility/coprime-divides
  lean-proof  Int.dvd_of_dvd_mul_left_of_gcd_one h4 (by rw [Int.gcd_comm]; exact_mod_cast h5)

theorem congruent-cancel
  let x ∈ ℤ                                                           (H1)
  let y ∈ ℤ                                                           (H2)
  let c ∈ ℤ                                                           (H3)
  let n ∈ ℕ                                                           (H4)
  assume x·c ≡ y·c (mod n)                                            (H5)
  assume gcd(c, n) = 1                                                (H6)
  then        x ≡ y (mod n)
  metamath-proof stdlib/divisibility/congruent-cancel
  lean-proof  by have h := Int.ModEq.cancel_right_div_gcd (by exact_mod_cast h4 : (0 : ℤ) < n) h5; have hg : Int.gcd (n : ℤ) c = 1 := (by rw [Int.gcd_comm]; exact_mod_cast h6); rw [hg] at h; simpa using h

mundane theorem coprime-square-part
  let s ∈ ℕ                                                           (H1)
  let t ∈ ℕ                                                           (H2)
  let w ∈ ℕ                                                           (H3)
  assume gcd(s, t) = 1                                                (H4)
  assume w² = s·t                                                     (H5)
  then        s = gcd(s, w)²
  metamath-proof stdlib/divisibility/coprime-square-part
  lean-proof  stdlib/divisibility/coprime-square-part

theorem coprime-square
  let s ∈ ℕ                                                           (H1)
  let t ∈ ℕ                                                           (H2)
  let w ∈ ℕ                                                           (H3)
  assume gcd(s, t) = 1                                                (H4)
  assume w² = s·t                                                     (H5)
  then        s = gcd(s, w)². t = gcd(t, w)².
  metamath-proof stdlib/divisibility/coprime-square
  lean-proof  stdlib/divisibility/coprime-square

mundane theorem prime-power-not-less
  let p ∈ ℕ                                                           (H1)
  assume p is prime                                                   (H2)
  let a ∈ ℕ₀                                                          (H3)
  let a′ ∈ ℕ₀                                                         (H4)
  let m ∈ ℤ                                                           (H5)
  let m′ ∈ ℤ                                                          (H6)
  assume gcd(m, p) = 1                                                (H7)
  assume p^a·m = p^a′·m′                                              (H8)
  then        not (a < a′)
  metamath-proof stdlib/divisibility/prime-power-not-less
  lean-proof  by intro hlt; have hp : Prime (p : ℤ) := Nat.prime_iff_prime_int.1 h2; have hle : a + 1 ≤ a' := (by omega); have hdvd : (p : ℤ) ^ (a + 1) ∣ (p : ℤ) ^ a * m := (h8 ▸ Dvd.dvd.mul_right (pow_dvd_pow _ hle) _); rw [pow_succ] at hdvd; have hpm : (p : ℤ) ∣ m := (mul_dvd_mul_iff_left (pow_ne_zero a hp.ne_zero)).1 hdvd; have hc : IsCoprime m (p : ℤ) := Int.isCoprime_iff_gcd_eq_one.2 (by exact_mod_cast h7); exact hp.not_unit (hc.isUnit_of_dvd' hpm (dvd_refl _))

mundane theorem prime-power-unique
  let p ∈ ℕ                                                           (H1)
  assume p is prime                                                   (H2)
  let a ∈ ℕ₀                                                          (H3)
  let a′ ∈ ℕ₀                                                         (H4)
  let m ∈ ℤ                                                           (H5)
  let m′ ∈ ℤ                                                          (H6)
  assume gcd(m, p) = 1                                                (H7)
  assume gcd(m′, p) = 1                                               (H8)
  assume p^a·m = p^a′·m′                                              (H9)
  then        a = a′
  metamath-proof stdlib/divisibility/prime-power-unique
  lean-proof  by by_contra hne; have hne' : a ≠ a' := (by intro e; exact hne (by rw [e])); rcases Nat.lt_or_gt_of_ne hne' with h | h; exacts [mun_prime_power_not_less p h1 h2 a a' m m' h7 h9 (by exact_mod_cast h), mun_prime_power_not_less p h1 h2 a' a m' m h8 h9.symm (by exact_mod_cast h)]

theorem prime-powers-unique
  let a ∈ ℕ₀                                                          (H1)
  let b ∈ ℕ₀                                                          (H2)
  let c ∈ ℕ₀                                                          (H3)
  let a′ ∈ ℕ₀                                                         (H4)
  let b′ ∈ ℕ₀                                                         (H5)
  let c′ ∈ ℕ₀                                                         (H6)
  assume 2^a·3^b·5^c = 2^a′·3^b′·5^c′                                 (H7)
  then        a = a′. b = b′. c = c′.
  metamath-proof stdlib/divisibility/prime-powers-unique
  lean-proof  by have h : 2 ^ a * 3 ^ b * 5 ^ c = 2 ^ a' * 3 ^ b' * 5 ^ c' := (by exact_mod_cast h7); have key : ∀ x y z : ℕ, (2 ^ x * 3 ^ y * 5 ^ z).factorization 2 = x ∧ (2 ^ x * 3 ^ y * 5 ^ z).factorization 3 = y ∧ (2 ^ x * 3 ^ y * 5 ^ z).factorization 5 = z := (by intro x y z; rw [Nat.factorization_mul (by positivity) (by positivity), Nat.factorization_mul (by positivity) (by positivity)]; simp [Nat.factorization_pow, Nat.prime_two.factorization, Nat.prime_three.factorization, Nat.prime_five.factorization, Finsupp.single_apply]); have := (key a b c).1; rw [h, (key a' b' c').1] at this; exact_mod_cast this.symm ; by have h : 2 ^ a * 3 ^ b * 5 ^ c = 2 ^ a' * 3 ^ b' * 5 ^ c' := (by exact_mod_cast h7); have key : ∀ x y z : ℕ, (2 ^ x * 3 ^ y * 5 ^ z).factorization 2 = x ∧ (2 ^ x * 3 ^ y * 5 ^ z).factorization 3 = y ∧ (2 ^ x * 3 ^ y * 5 ^ z).factorization 5 = z := (by intro x y z; rw [Nat.factorization_mul (by positivity) (by positivity), Nat.factorization_mul (by positivity) (by positivity)]; simp [Nat.factorization_pow, Nat.prime_two.factorization, Nat.prime_three.factorization, Nat.prime_five.factorization, Finsupp.single_apply]); have := (key a b c).2.1; rw [h, (key a' b' c').2.1] at this; exact_mod_cast this.symm ; by have h : 2 ^ a * 3 ^ b * 5 ^ c = 2 ^ a' * 3 ^ b' * 5 ^ c' := (by exact_mod_cast h7); have key : ∀ x y z : ℕ, (2 ^ x * 3 ^ y * 5 ^ z).factorization 2 = x ∧ (2 ^ x * 3 ^ y * 5 ^ z).factorization 3 = y ∧ (2 ^ x * 3 ^ y * 5 ^ z).factorization 5 = z := (by intro x y z; rw [Nat.factorization_mul (by positivity) (by positivity), Nat.factorization_mul (by positivity) (by positivity)]; simp [Nat.factorization_pow, Nat.prime_two.factorization, Nat.prime_three.factorization, Nat.prime_five.factorization, Finsupp.single_apply]); have := (key a b c).2.2; rw [h, (key a' b' c').2.2] at this; exact_mod_cast this.symm

theorem product-coprime
  let X ⊆ ℤ                                                           (H1)
  assume X is finite                                                  (H2)
  let n ∈ ℕ                                                           (H3)
  assume for all y ∈ X, gcd(y, n) = 1                                 (H4)
  then        gcd(∏(x ∈ X) x, n) = 1
  metamath-proof stdlib/divisibility/product-coprime
  lean-proof  by rw [finprod_mem_eq_finite_toFinset_prod _ h2]; have h := IsCoprime.prod_left (t := h2.toFinset) (s := fun i : ℤ => i) (fun i hi => Int.isCoprime_iff_gcd_eq_one.2 (by exact_mod_cast h4 i (h2.mem_toFinset.1 hi)) : ∀ i ∈ h2.toFinset, IsCoprime i (n : ℤ)); exact_mod_cast Int.isCoprime_iff_gcd_eq_one.1 h

theorem product-congruent-termwise
  let X be a set                                                      (H1)
  assume X is finite                                                  (H2)
  let n ∈ ℕ                                                           (H3)
  let t : X → ℤ                                                       (H4)
  let u : X → ℤ                                                       (H5)
  assume for all x ∈ X, t(x) ≡ u(x) (mod n)                           (H6)
  then        ∏(x ∈ X) t(x) ≡ ∏(x ∈ X) u(x) (mod n)
  metamath-proof stdlib/divisibility/product-congruent-termwise
  lean-proof  by rw [finprod_mem_eq_finite_toFinset_prod _ h1, finprod_mem_eq_finite_toFinset_prod _ h1]; exact Int.ModEq.prod fun x hx => h3 x ((Set.Finite.mem_toFinset h1).mp hx)

theorem product-congruent
  let X ⊆ ℤ                                                           (H1)
  assume X is finite                                                  (H2)
  let c ∈ ℤ                                                           (H3)
  let n ∈ ℕ                                                           (H4)
  let f : X → X                                                       (H5)
  assume for all y ∈ X, y·c ≡ f(y) (mod n)                            (H6)
  then        ∏(x ∈ X) x·c ≡ ∏(x ∈ X) f(x) (mod n)
  metamath-proof stdlib/divisibility/product-congruent
  lean-proof  by rw [finprod_mem_eq_finite_toFinset_prod _ h2, finprod_mem_eq_finite_toFinset_prod _ h2, ← ZMod.intCast_eq_intCast_iff]; push_cast; exact Finset.prod_congr rfl (fun y hy => (by have h := (ZMod.intCast_eq_intCast_iff _ _ _).2 (h5 y (h2.mem_toFinset.1 hy)); push_cast at h; exact h))
