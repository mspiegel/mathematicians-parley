# Standard library: polynomials
#
# Polynomials with complex coefficients, their values, and division by
# x − a.
#
# One record per item. A record begins at column 0 with its kind, axiom,
# theorem or definition, and its name; `mundane` before the kind marks an
# item a proof takes for granted. A proof imports each item it cites,
# `import <header> stdlib/polynomials/<name>`, where the header is the
# record's own before its name, as `mundane theorem` or `axiom`. Format is described in DATABASE.md.
#
# An item's statement is written in the theorem form of SYNTAX.md: let and
# assume lines with labels, then a `then` line.
#
# Every item carries at least one of:
#   metamath    a set.mm label or labels supply it
#   open        it is cited but unproved and unbridged
#
# Other fields: target, note.


theorem remainder
  let p be a polynomial                                               (H1)
  let a ∈ ℂ                                                           (H2)
  then        there is a polynomial q with p(x) = (x − a)·q(x) + p(a) for all x ∈ ℂ
  metamath    plyrem, read at each x, and quotcl2 for the quotient, which this
              corpus proves together in elaboration/stdlib/proved.mm
  target      gplyrem
  note        The remainder theorem: dividing p by x − a leaves a polynomial
              quotient and the constant remainder p(a).

mundane theorem polynomial-value
  let p be a polynomial                                               (H1)
  let x ∈ ℂ                                                           (H2)
  then        p(x) ∈ ℂ
  metamath    plyf and ffvelcdm, which this corpus proves together in
              elaboration/stdlib/proved.mm
  target      gplyval

definition B
  sort        number, number → number
  builds      _1 _2 cbp co
  reads       the Bernoulli polynomial
  let n ∈ ℕ₀                                                          (H1)
  let x ∈ ℂ                                                           (H2)
  then        B(n, x) = x^n − Σ(k = 0 to n − 1) C(n, k)·(B(k, x)/((n − k) + 1))
  metamath    bpolyval
  target      bpolyval
  note        B(n, x) is the n-th Bernoulli polynomial at x, defined by
              recursion on n: each is x^n less a weighted sum of the ones
              before it.

mundane theorem bernoulli-complex
  let n ∈ ℕ₀                                                          (H1)
  let x ∈ ℂ                                                           (H2)
  then        B(n, x) ∈ ℂ
  metamath    bpolycl
  target      bpolycl

theorem bernoulli-difference
  let n ∈ ℕ                                                           (H1)
  let x ∈ ℂ                                                           (H2)
  then        B(n, x + 1) − B(n, x) = n·x^(n − 1)
  metamath    bpolydif
  target      bpolydif
  note        The property the Bernoulli polynomials are made for: a step
              of 1 in x changes B(n, x) by n·x^(n − 1).

theorem algebraic-root
  let α ∈ ℂ                                                           (H1)
  assume α is algebraic                                               (H2)
  then        there is F : ℂ → ℂ with (F is a polynomial with integer
              coefficients and deg(F) ∈ ℕ and F(α) = 0)
  metamath    elaa, a polynomial other than 0 with a root being of degree
              at least 1, which this corpus proves in
              elaboration/stdlib/proved.mm
  target      galgroot
  note        What being algebraic is: a root of a polynomial with integer
              coefficients, other than 0, so of degree at least 1.

definition transcendental
  let α ∈ ℂ                                                           (H1)
  then        α is transcendental ↔ not (α is algebraic)
  metamath    ibar, of α ∈ ℂ and not α ∈ 𝔸, which this corpus proves in
              elaboration/stdlib/proved.mm
  target      gtransc
  note        A transcendental number is a complex number that is not
              algebraic; of one known complex, that it is not algebraic is
              all there is to say.

theorem integer-polynomial-at-a-fraction
  let F : ℂ → ℂ                                                       (H1)
  assume F is a polynomial with integer coefficients                  (H2)
  let p ∈ ℤ                                                           (H3)
  let q ∈ ℕ                                                           (H4)
  then        q^deg(F)·F(p/q) ∈ ℤ
  metamath    aalioulem1, its two factors turned, which this corpus proves
              in elaboration/stdlib/proved.mm
  target      gaalioulem1
  note        Each term a·(p/q)^k of F(p/q), k at most the degree, times
              q^deg(F) is an integer, so the whole is.

mundane theorem integer-polynomial-real
  let F : ℂ → ℂ                                                       (H1)
  assume F is a polynomial with integer coefficients                  (H2)
  let x ∈ ℝ                                                           (H3)
  then        F(x) ∈ ℝ
  metamath    plyreres, Poly ℤ inside Poly ℝ, which this corpus proves in
              elaboration/stdlib/proved.mm
  target      gplyzre with F := F

theorem roots-isolated
  let F : ℂ → ℂ                                                       (H1)
  assume F is a polynomial with integer coefficients                  (H2)
  let N ∈ ℕ                                                           (H3)
  assume deg(F) = N                                                   (H4)
  let α ∈ ℝ                                                           (H5)
  assume F(α) = 0                                                     (H6)
  δ ranges over ℝ
  then        there exists δ > 0 such that r = α for all r ∈ ℝ with
              (|α − r| ≤ δ and F(r) = 0)
  metamath    fta1, which bounds the roots of F by its degree, which this
              corpus proves into this form in elaboration/stdlib/proved.mm
  target      grootsiso
  note        A polynomial other than 0 has finitely many roots, so the
              others lie some distance from α.

theorem polynomial-on-the-reals
  let F : ℂ → ℂ                                                       (H1)
  assume F is a polynomial with integer coefficients                  (H2)
  let f : ℝ → ℝ                                                       (H3)
  assume for all x ∈ ℝ, f(x) = F(x)                                   (H4)
  then        f is continuous on ℝ. f is differentiable on ℝ.
              f′ : ℝ → ℝ. f′ is continuous on ℝ.
  metamath    plycn, dvply2 and dvcnre, which this corpus proves of F on the
              reals in elaboration/stdlib/proved.mm
  target      gplyrecn, gplyredv, gplyredvf, gplyredvcn
  note        F on the real line: continuous, differentiable everywhere, and
              its derivative is a polynomial too, so continuous.
