# Standard library: geometry
#
# Points, distances and angles in the plane, triangles, and congruence.
#
# One record per item. A record begins at column 0 with its kind, axiom,
# theorem or definition, and its name; `mundane` before the kind marks an
# item a proof takes for granted. A proof imports each item it cites,
# `import <header> stdlib/geometry/<name>`, where the header is the
# record's own before its name, as `mundane theorem` or `axiom`. Format is described in DATABASE.md.
#
# An item's statement is written in the theorem form of SYNTAX.md: let and
# assume lines with labels, then a `then` line.
#
# Every item carries both:
#   metamath-proof  how the Metamath build proves it: a set.mm label, the
#                   full name of a Parley proof or of a bridge, `none` where
#                   it has nothing to prove, or `not yet implemented`
#   lean-proof      the same for the Lean build, a Mathlib proof in place of
#                   a set.mm label
#
# Other fields: note, and for the one definition that
# introduces a symbol, symbol and defines.


definition point
  then        A is a point ↔ A ∈ 𝔼²
  metamath-proof biid
  note        A point is a member of the plane. The plane is ℂ in the kernel,
              which the page never says (GEOMETRY.md).
  lean-proof  not yet implemented

definition angle
  symbol      ang
  defines     vx vy cc cc0 csn cdif cc cc0 csn cdif
              vy cv vx cv cdiv co clog cfv cim cfv cmpo
  note        The angle the corpus writes is unsigned: ∠PQR is the absolute
              value of ang applied to the two differences, which lands in
              0 to π and makes mun:stdlib/geometry/angle-symmetric true. ang itself is
              signed, in −π to π, as set.mm has it. GEOMETRY.md weighs the
              seven candidate geometries and takes this one.

              This is the only definition in the corpus that introduces a
              symbol; every other names a word for something set.mm already
              has. See GOALS.md decision 12. Its statement is `defines`, what
              the symbol stands for, and what follows from that is
              mun:stdlib/geometry/angle-real.
  metamath-proof none
  lean-proof  none

mundane theorem angle-real
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  assume P ≠ Q                                                        (H4)
  assume R ≠ Q                                                        (H5)
  assume P ≠ R                                                        (H6)
  then        ∠PQR ∈ ℝ. ∠PQR ≥ 0.
  metamath-proof metamath-bridges/geometry/gangbnd3
  note        ∠PQR is an absolute value, so it is real and at least 0; what
              makes that a proof is that ang of the two differences is a
              number, which gangrange gives by putting ∠PQR in [0, π].
  lean-proof  not yet implemented

mundane theorem signed-angle-size
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  assume P ≠ Q                                                        (H4)
  assume R ≠ Q                                                        (H5)
  assume P ≠ R                                                        (H6)
  then        |∡PQR| = ∠PQR
  metamath-proof eqid
  note        The angle is the signed angle's size, whichever way it turns.
  lean-proof  not yet implemented

mundane theorem signed-angle-real
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  assume P ≠ Q                                                        (H4)
  assume R ≠ Q                                                        (H5)
  then        ∡PQR ∈ ℝ. −π < ∡PQR. ∡PQR ≤ π.
  metamath-proof metamath-bridges/geometry/gsangcl
  lean-proof  not yet implemented

mundane theorem signed-angle-reverse
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  assume P ≠ Q                                                        (H4)
  assume R ≠ Q                                                        (H5)
  assume ∡PQR ≠ π                                                     (H6)
  then        ∡RQP = −∡PQR
  metamath-proof metamath-bridges/geometry/gsangrev
  note        Turned the other way, the signed angle changes sign; at π, a
              straight angle, it is π both ways.
  lean-proof  not yet implemented

theorem signed-angle-sum
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  assume P ≠ Q                                                        (H4)
  assume Q ≠ R                                                        (H5)
  assume P ≠ R                                                        (H6)
  then        ∡RQP + ∡PRQ + ∡QPR ∈ {−π, π}
  metamath-proof metamath-bridges/geometry/gang180
  note        The signed angles of a triangle, each turned the same way
              around it, add to π or to −π as the triangle runs
              counterclockwise or clockwise. The three points need only be
              apart: on one line the angles are 0, 0 and π.
  lean-proof  not yet implemented

mundane theorem signed-angle-zero
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  assume P ≠ Q                                                        (H3)
  then        ∡PQP = 0
  metamath-proof metamath-bridges/circles/gsangid
  note        A ray turned to itself turns through nothing.
  lean-proof  not yet implemented

mundane theorem three-rays
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let X be a point                                                    (H3)
  let Q be a point                                                    (H4)
  assume A ≠ Q                                                        (H5)
  assume B ≠ Q                                                        (H6)
  assume X ≠ Q                                                        (H7)
  then        there is k ∈ ℤ with ∡AQX + ∡XQB = ∡AQB + 2·k·π
  metamath-proof metamath-bridges/circles/gsang3
  note        Three rays from Q: turning from QA to QX and then on to QB
              turns from QA to QB, give or take whole turns, since each
              signed angle is kept between −π and π.
  lean-proof  not yet implemented

mundane theorem isosceles-signed-angles
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let Q be a point                                                    (H3)
  assume A ≠ Q                                                        (H4)
  assume B ≠ Q                                                        (H5)
  assume A ≠ B                                                        (H6)
  assume |AQ| = |BQ|                                                  (H7)
  then        ∡QAB = ∡ABQ
  metamath-proof metamath-bridges/circles/gisosctr with C := Q
  note        The base angles of an isosceles triangle, each turned the same
              way round it, are equal as signed angles: from AQ to AB at A
              and from BA to BQ at B. isosceles-angles says it unsigned.
  lean-proof  not yet implemented

mundane theorem same-side-turns-alike
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  let D be a point                                                    (H4)
  assume C and D are on the same side of line AB                      (H5)
  then        ∡ACB·∡ADB > 0
  metamath-proof metamath-bridges/circles/gsamesang
  note        Two points on one side of a line see a segment of it turned
              the same way: the signed angle ACB is positive when C is on the
              counterclockwise side of AB and negative on the other.
  lean-proof  not yet implemented

definition collinear
  metamath-proof none
  lean-proof  none
  note        Incidence is a primitive of the geometry, and the readable layer
              cannot state what it is, so the record states nothing. In the
              plane it says P = Q or (R − P)/(Q − P) is real, which is true in
              any order of the three points, so the notation's points stand
              in no order; and subtraction takes numbers while P, Q and R are
              points: the sorts that stop |CA| reading as a product stop this
              too. The notation carries a metamath-builds, so a claim of
              collinearity elaborates; what has no readable statement is the
              equivalence. Named by the merge because
              def:stdlib/geometry/triangle needs a word for what a
              triangle's vertices are not.

definition triangle
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  then        P, Q, R form a triangle ↔ P ≠ Q and Q ≠ R and P ≠ R and
              not (P, Q, R are collinear)
  metamath-proof metamath-bridges/plane/gtridef
  note        set.mm has no single notion. "Form a triangle" and "are
              collinear" are notations whose targets make the two sides one
              formula; what collinearity is in words is
              def:stdlib/geometry/collinear, which this statement does not
              need. That the three are points is the three let lines, not a
              clause of the statement; the sorts carry it.
  lean-proof  not yet implemented

definition congruent
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  let P′ be a point                                                   (H4)
  let Q′ be a point                                                   (H5)
  let R′ be a point                                                   (H6)
  assume P, Q, R form a triangle                                      (H7)
  assume P′, Q′, R′ form a triangle                                   (H8)
  then        triangle PQR ≅ triangle P′Q′R′ ↔ |PQ| = |P′Q′|, |QR| = |Q′R′|,
              |RP| = |R′P′|, ∠PQR = ∠P′Q′R′, ∠QRP = ∠Q′R′P′, and
              ∠RPQ = ∠R′P′Q′
  metamath-proof biid
  note        set.mm has no congruence of triangles, and the notation stands
              for the six equations themselves, so the two sides are one
              formula.
  lean-proof  not yet implemented

definition isosceles
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  then        △PQR is isosceles ↔ P, Q, R form a triangle and
              (|PQ| = |PR| or |QP| = |QR| or |RP| = |RQ|)
  metamath-proof biid
  note        Two sides equal, whichever two: a triangle named by its three
              points has no apex until a proof says which equality holds.
  lean-proof  not yet implemented

definition equilateral
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  then        △PQR is equilateral ↔ P, Q, R form a triangle and |PQ| = |QR|
              and |QR| = |RP|
  metamath-proof biid
  lean-proof  not yet implemented

definition right-angled
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  let V be a point                                                    (H4)
  then        △PQR is right-angled at V ↔ P, Q, R form a triangle and
              ((V = P and ∠QPR = 90°) or (V = Q and ∠PQR = 90°) or
              (V = R and ∠PRQ = 90°))
  metamath-proof biid
  note        V is one of the three vertices and the angle there is right.
  lean-proof  not yet implemented

mundane theorem right-angled-at-vertex
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  then        △PQR is right-angled at R ↔ P, Q, R form a triangle and
              ∠PRQ = 90°
  metamath-proof metamath-bridges/geometry/grightat3
  note        Named at the vertex it writes last, a right angle is the angle
              there: the triangle's R ≠ P and R ≠ Q rule out the other two.
  lean-proof  not yet implemented

mundane theorem distance-symmetric
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  then        |PQ| = |QP|
  metamath-proof abssub
  lean-proof  not yet implemented

mundane theorem angle-symmetric
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  assume P, Q, R form a triangle                                      (H4)
  then        ∠PQR = ∠RQP
  metamath-proof metamath-bridges/geometry/gangsym3
  lean-proof  not yet implemented

mundane theorem angle-turned
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  assume P ≠ Q                                                        (H4)
  assume R ≠ Q                                                        (H5)
  assume P ≠ R                                                        (H6)
  then        ∠PQR = ∠RQP
  metamath-proof metamath-bridges/geometry/gangsym3
  note        As angle-symmetric, for points that may lie on a line: the
              angle between two arms does not depend on which is named first.
  lean-proof  not yet implemented

definition parallel
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  let D be a point                                                    (H4)
  assume A ≠ B                                                        (H5)
  assume C ≠ D                                                        (H6)
  then        line AB ∥ line CD ↔ line AB = line CD or not (there is
              X ∈ 𝔼² with X is on line AB and X is on line CD)
  metamath-proof metamath-bridges/postulates/gpardef
  note        Two lines are parallel when they are one line or never meet,
              as SMSG defines it of distinct lines. Named for the angle sum,
              whose proof draws the parallel to one side through the
              opposite vertex.
  lean-proof  not yet implemented

definition between
  metamath-proof none
  lean-proof  none
  note        In the plane R is between S and T says S ≠ R and
              (T − R)/(S − R) is a negative real: T lies beyond R from S, on
              the same line. The readable layer cannot state it, as for
              def:stdlib/geometry/collinear, so the record states nothing.

definition on-line
  let P be a point                                                    (H1)
  let A be a point                                                    (H2)
  let B be a point                                                    (H3)
  then        P is on line AB ↔ A, B, P are collinear
  metamath-proof biid
  lean-proof  not yet implemented

definition line
  let P be a point                                                    (H1)
  let A be a point                                                    (H2)
  let B be a point                                                    (H3)
  then        P ∈ line AB ↔ P is on line AB
  metamath-proof metamath-bridges/postulates/glinel
  note        The line through A and B as a set, for a statement that
              speaks of the line itself. A ≠ B where it is a line.
  lean-proof  not yet implemented

definition ray
  let P be a point                                                    (H1)
  let A be a point                                                    (H2)
  let B be a point                                                    (H3)
  assume A ≠ B                                                        (H4)
  then        P ∈ ray AB ↔ P = A or P = B or (P is between A and B) or
              (B is between A and P)
  metamath-proof metamath-bridges/postulates/grayel
  note        The ray from A through B: the segment AB and the points
              beyond B.
  lean-proof  not yet implemented

mundane theorem line-turned
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  then        line AB = line BA
  metamath-proof metamath-bridges/postulates/glineturn
  lean-proof  not yet implemented

mundane theorem on-line-cases
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  assume Q ≠ R                                                        (H4)
  assume P is on line QR                                              (H5)
  then        P = Q or (P is between Q and R) or P = R or
              (R is between Q and P) or (Q is between P and R)
  metamath-proof metamath-bridges/plane/gonline
  note        A point of a line through two points is one of them, between
              them, or beyond one of them, which a figure shows and a proof
              takes as the cases there are.
  lean-proof  not yet implemented

definition perpendicular
  metamath-proof none
  lean-proof  none
  note        In the plane line AB ⊥ line CD says A ≠ B, C ≠ D and
              (D − C)/(B − A) has real part 0: the two directions are at a
              right angle. The readable layer cannot state it, as for
              def:stdlib/geometry/parallel, so the record states nothing;
              where the lines meet,
              mun:stdlib/geometry/perpendicular-by-right-angle reads it as
              an angle.

mundane theorem perpendicular-by-right-angle
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  assume P ≠ Q                                                        (H4)
  assume R ≠ Q                                                        (H5)
  assume P ≠ R                                                        (H6)
  then        line QP ⊥ line QR ↔ ∠PQR = 90°
  metamath-proof metamath-bridges/triangles/gperp90
  note        Two lines through Q are perpendicular when the angle between
              them at Q is a right angle.
  lean-proof  not yet implemented

definition midpoint
  let M be a point                                                    (H1)
  let A be a point                                                    (H2)
  let B be a point                                                    (H3)
  then        M is the midpoint of AB ↔ (M is between A and B) and
              |AM| = |MB|
  metamath-proof biid
  note        In the plane the midpoint is (A + B)/2, which the page does not
              write: it adds points.
  lean-proof  not yet implemented

mundane theorem midpoint-unique
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let M be a point                                                    (H3)
  let N be a point                                                    (H4)
  assume M is the midpoint of AB                                      (H5)
  assume N is the midpoint of AB                                      (H6)
  then        M = N
  metamath-proof metamath-bridges/plane/gmiduniq
  note        A segment has one midpoint, which is what "the midpoint of AB"
              takes for granted.
  lean-proof  not yet implemented

mundane theorem midpoint-determines-end
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  let M be a point                                                    (H4)
  assume M is the midpoint of AB                                      (H5)
  assume M is the midpoint of AC                                      (H6)
  then        B = C
  metamath-proof metamath-bridges/plane/gmidend
  note        The reflection of a point through another is one point: B is
              the point beyond M from A at the distance |AM|.
  lean-proof  not yet implemented

definition same-side
  metamath-proof none
  lean-proof  none
  note        Which side of the line through P and Q a point X is on is the
              sign of the imaginary part of (X − P)/(Q − P): positive on one
              side, negative on the other, zero on the line. Two points are on
              the same side when the two signs multiply to a positive number,
              and on opposite sides when to a negative one. The readable
              layer cannot state it, as for def:stdlib/geometry/collinear, so
              the record states nothing. One record for both notations,
              same-side and opposite-sides, since they are one sign read two
              ways.

axiom supplementary-angles
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  let D be a point                                                    (H4)
  assume B is between A and C                                         (H5)
  assume D ≠ B                                                        (H6)
  assume D ≠ A                                                        (H7)
  assume D ≠ C                                                        (H8)
  then        ∠ABD + ∠DBC = 180°
  metamath-proof metamath-bridges/plane/gsupp
  note        Two angles on a line, Euclid I.13: with B on the segment AC,
              the angles ABD and DBC make a straight angle wherever D is.
              SMSG's postulate 14, the supplement postulate: two angles
              that form a linear pair are supplementary.
  lean-proof  not yet implemented

theorem triangle-inequality-points
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  then        |PR| ≤ |PQ| + |QR|
  metamath-proof abs3dif
  lean-proof  not yet implemented

mundane theorem angle-addition
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  let M be a point                                                    (H4)
  assume A, B, C form a triangle                                      (H5)
  assume M is between A and B                                         (H6)
  assume C ≠ M                                                        (H7)
  then        ∠ACM + ∠MCB = ∠ACB
  metamath-proof metamath-bridges/plane/gangadd
  note        A point of the side AB splits the angle at C in two. With T
              the point beyond C from A, angles-on-a-line makes ACM, MCB
              and BCT a straight angle, and supplementary-angles makes ACB
              and BCT one: M and B lie on one side of line CA, and A and B
              on two sides of line CM, which is what the line through M
              does.
  lean-proof  not yet implemented

mundane theorem distance-nonneg
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  then        |PQ| ≥ 0
  metamath-proof metamath-bridges/plane/gdistnn
  lean-proof  not yet implemented

axiom distance-positive
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  assume P ≠ Q                                                        (H3)
  then        |PQ| > 0
  metamath-proof metamath-bridges/plane/gdistpos
  note        SMSG's postulate 2, the distance postulate: two distinct
              points are a positive distance apart.
  lean-proof  not yet implemented

mundane theorem distance-zero
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  then        |PQ| = 0 ↔ P = Q
  metamath-proof metamath-bridges/plane/gdist0
  note        A point is at distance 0 from itself and from no other point.
  lean-proof  not yet implemented

mundane theorem distance-by-coordinates
  let a ∈ ℝ                                                           (H1)
  let b ∈ ℝ                                                           (H2)
  let c ∈ ℝ                                                           (H3)
  let d ∈ ℝ                                                           (H4)
  then        |(a, b)(c, d)| = √((a − c)² + (b − d)²)
  metamath-proof metamath-bridges/plane/gdistco
  lean-proof  not yet implemented

mundane theorem collinear-by-coordinates
  let a ∈ ℝ                                                           (H1)
  let b ∈ ℝ                                                           (H2)
  let c ∈ ℝ                                                           (H3)
  let d ∈ ℝ                                                           (H4)
  let e ∈ ℝ                                                           (H5)
  let f ∈ ℝ                                                           (H6)
  then        (a, b), (c, d), (e, f) are collinear ↔ (c − a)·(f − b) = (e − a)·(d − b)
  metamath-proof metamath-bridges/plane/gcolco
  lean-proof  not yet implemented

mundane theorem between-by-coordinates
  let a ∈ ℝ                                                           (H1)
  let b ∈ ℝ                                                           (H2)
  let c ∈ ℝ                                                           (H3)
  let d ∈ ℝ                                                           (H4)
  let e ∈ ℝ                                                           (H5)
  let f ∈ ℝ                                                           (H6)
  then        (c, d) is between (a, b) and (e, f) ↔ (a − c)·(f − d) = (e − c)·(b − d) and (a − c)·(e − c) + (b − d)·(f − d) < 0
  metamath-proof metamath-bridges/plane/gbetco
  note        The three points are collinear, and the two ends lie on
              opposite sides of the middle one: the differences from it
              point opposite ways, so their dot product is negative.
  lean-proof  not yet implemented

mundane theorem points-apart-by-coordinates
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let a ∈ ℝ                                                           (H3)
  let b ∈ ℝ                                                           (H4)
  let c ∈ ℝ                                                           (H5)
  let d ∈ ℝ                                                           (H6)
  assume A = (a, b)                                                   (H7)
  assume B = (c, d)                                                   (H8)
  then        A ≠ B ↔ (a, b) ≠ (c, d)
  metamath-proof metamath-bridges/plane/gptapart
  note        On the left (a, b) and (c, d) are points, as A and B are;
              on the right they are pairs, which `arithmetic` compares
              coordinate by coordinate (`METHODS.md`, Pairs).
  lean-proof  not yet implemented

mundane theorem distance-of-points-by-coordinates
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let a ∈ ℝ                                                           (H3)
  let b ∈ ℝ                                                           (H4)
  let c ∈ ℝ                                                           (H5)
  let d ∈ ℝ                                                           (H6)
  assume A = (a, b)                                                   (H7)
  assume B = (c, d)                                                   (H8)
  then        |AB| = √((a − c)² + (b − d)²)
  metamath-proof metamath-bridges/plane/gptdist
  note        distance-by-coordinates for two points named by letters, so a
              proof that gives its points coordinates reads each distance
              off in one step.
  lean-proof  not yet implemented

mundane theorem between-symmetric
  let R be a point                                                    (H1)
  let S be a point                                                    (H2)
  let T be a point                                                    (H3)
  assume R is between S and T                                         (H4)
  then        R is between T and S
  metamath-proof metamath-bridges/triangles/gbetsym
  lean-proof  not yet implemented

mundane theorem between-apart
  let R be a point                                                    (H1)
  let S be a point                                                    (H2)
  let T be a point                                                    (H3)
  assume R is between S and T                                         (H4)
  then        S ≠ R. T ≠ R.
  metamath-proof metamath-bridges/plane/gbetne0
  note        A point between two others is apart from both, so the
              angles and triangles at it are defined.
  lean-proof  not yet implemented

mundane theorem between-ends-apart
  let R be a point                                                    (H1)
  let S be a point                                                    (H2)
  let T be a point                                                    (H3)
  assume R is between S and T                                         (H4)
  then        S ≠ T
  metamath-proof metamath-bridges/plane/gbetends
  note        A segment with a point strictly between its ends has two ends.
  lean-proof  not yet implemented

mundane theorem between-collinear
  let R be a point                                                    (H1)
  let S be a point                                                    (H2)
  let T be a point                                                    (H3)
  assume R is between S and T                                         (H4)
  then        T, R, S are collinear
  metamath-proof metamath-bridges/plane/gbetcol
  note        A point between two others is on their line.
  lean-proof  not yet implemented

mundane theorem triangle-on-side
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  let S be a point                                                    (H4)
  assume P, Q, R form a triangle                                      (H5)
  assume S is between Q and R                                         (H6)
  then        P, Q, S form a triangle
  metamath-proof metamath-bridges/triangles/gtriside
  note        A point of the side QR, apart from its ends, makes a smaller
              triangle with the vertex opposite and either end: S lies on
              line QR, which P does not.
  lean-proof  not yet implemented

mundane theorem angle-along-segment
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  let S be a point                                                    (H4)
  assume S is between P and Q                                         (H5)
  assume R ≠ P                                                        (H6)
  assume R ≠ S                                                        (H7)
  assume R ≠ Q                                                        (H8)
  then        ∠SPR = ∠QPR
  metamath-proof metamath-bridges/triangles/gangseg
  note        S on the segment from P to Q is on the ray from P through Q,
              so the angle that ray makes with PR is the same measured to S
              as to Q.
  lean-proof  not yet implemented

mundane theorem segment-addition
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let S be a point                                                    (H3)
  assume S is between P and Q                                         (H4)
  then        |PS| + |SQ| = |PQ|
  metamath-proof metamath-bridges/triangles/gsegadd
  lean-proof  not yet implemented

mundane theorem sine-positive
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  assume P, Q, R form a triangle                                      (H4)
  then        sin(∠PQR) > 0
  metamath-proof metamath-bridges/triangles/gsinpos
  note        An angle of a triangle is strictly between 0° and 180°, where
              the sine is positive.
  lean-proof  not yet implemented

theorem law-of-sines
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  assume P, Q, R form a triangle                                      (H4)
  then        |PQ|·sin(∠PQR) = |PR|·sin(∠QRP)
  metamath-proof metamath-bridges/triangles/glawsin
  note        Each side over the sine of the angle opposite it is the same:
              PR is opposite Q and PQ opposite R, so |PR|/sin(∠PQR) =
              |PQ|/sin(∠QRP), written without division.
  lean-proof  not yet implemented

definition area
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  then        the area of △PQR = (1/2)·(|QR|·|PR|)·|sin(∡QRP)|
  metamath-proof eqid
  note        Half of two sides times the sine of the angle between them,
              the sine's size taken so that the area does not depend on which
              way the triangle runs.
  lean-proof  not yet implemented

theorem area-by-sine
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  assume P ≠ R                                                        (H4)
  assume Q ≠ R                                                        (H5)
  assume Q ≠ P                                                        (H6)
  then        the area of △PQR = (1/2)·(|QR|·|PR|)·sin(∠QRP)
  metamath-proof metamath-bridges/triangles/garea
  lean-proof  not yet implemented

mundane theorem area-real
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  assume P ≠ R                                                        (H4)
  assume Q ≠ R                                                        (H5)
  then        the area of △PQR ∈ ℝ
  metamath-proof metamath-bridges/triangles/gareacl
  lean-proof  not yet implemented

axiom area-positive
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  assume P, Q, R form a triangle                                      (H4)
  then        the area of △PQR > 0
  metamath-proof metamath-bridges/triangles/gareapos
  note        SMSG's postulate 17, said of a triangle: a triangle has a
              positive area.
  lean-proof  not yet implemented

theorem heron
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  let s ∈ ℝ                                                           (H4)
  assume P ≠ R                                                        (H5)
  assume Q ≠ R                                                        (H6)
  assume s = (|QR| + |PR| + |PQ|)/2                                   (H7)
  then        the area of △PQR = √(s·(s − |QR|)·((s − |PR|)·(s − |PQ|)))
  metamath-proof metamath-bridges/triangles/gheron
  note        Heron's formula: the area from the three sides alone, s being
              half the perimeter.
  lean-proof  not yet implemented

theorem law-of-cosines
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  assume P ≠ Q                                                        (H4)
  assume R ≠ Q                                                        (H5)
  assume P ≠ R                                                        (H6)
  then        |RP|² = |PQ|² + |QR|² − 2·(|PQ|·|QR|·cos(∠PQR))
  metamath-proof metamath-bridges/geometry/glawcos
  note        The side opposite Q, from the two sides at Q and the angle
              between them; at a right angle the last term is 0 and it is
              Pythagoras.
  lean-proof  not yet implemented

mundane theorem angle-equal-by-cosine
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  let P′ be a point                                                   (H4)
  let Q′ be a point                                                   (H5)
  let R′ be a point                                                   (H6)
  assume P ≠ Q                                                        (H7)
  assume R ≠ Q                                                        (H8)
  assume P′ ≠ Q′                                                      (H9)
  assume R′ ≠ Q′                                                      (H10)
  assume cos(∠PQR) = cos(∠P′Q′R′)                                     (H11)
  assume P ≠ R                                                        (H12)
  assume P′ ≠ R′                                                      (H13)
  then        ∠PQR = ∠P′Q′R′
  metamath-proof metamath-bridges/geometry/gangeq3
  note        An angle is between 0° and 180°, where the cosine is one-to-one.
  lean-proof  not yet implemented

mundane theorem angle-order-by-cosine
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  let P′ be a point                                                   (H4)
  let Q′ be a point                                                   (H5)
  let R′ be a point                                                   (H6)
  assume P ≠ Q                                                        (H7)
  assume R ≠ Q                                                        (H8)
  assume P′ ≠ Q′                                                      (H9)
  assume R′ ≠ Q′                                                      (H10)
  assume P ≠ R                                                        (H11)
  assume P′ ≠ R′                                                      (H12)
  then        ∠PQR < ∠P′Q′R′ ↔ cos(∠P′Q′R′) < cos(∠PQR)
  metamath-proof metamath-bridges/geometry/gangord3
  note        An angle is between 0° and 180°, where the cosine falls: the
              larger angle has the smaller cosine.
  lean-proof  not yet implemented

mundane theorem right-angle-by-cosine
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  assume P ≠ Q                                                        (H4)
  assume R ≠ Q                                                        (H5)
  assume P ≠ R                                                        (H6)
  then        ∠PQR = 90° ↔ cos(∠PQR) = 0
  metamath-proof metamath-bridges/triangles/gright3
  lean-proof  not yet implemented

mundane theorem right-angle-triangle
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  assume P ≠ Q                                                        (H4)
  assume R ≠ Q                                                        (H5)
  assume ∠PQR = 90°                                                   (H6)
  assume P ≠ R                                                        (H7)
  then        P, Q, R form a triangle
  metamath-proof metamath-bridges/plane/grttri
  note        The arms of a right angle are not on one line.
  lean-proof  not yet implemented

mundane theorem cosine-right-triangle
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  assume P ≠ R                                                        (H4)
  assume Q ≠ R                                                        (H5)
  assume ∠PRQ = 90°                                                   (H6)
  assume P ≠ Q                                                        (H7)
  then        |QR| = |QP|·cos(∠RQP)
  metamath-proof metamath-bridges/plane/gcosrt
  note        In a triangle with a right angle at R, the side QR next to
              the angle at Q is the hypotenuse times that angle's cosine:
              the cosine is the adjacent side over the hypotenuse, which is
              how a school reader meets it.
  lean-proof  not yet implemented

mundane theorem angle-at-most-straight
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  assume P ≠ Q                                                        (H4)
  assume R ≠ Q                                                        (H5)
  assume P ≠ R                                                        (H6)
  then        ∠PQR ≤ 180°
  metamath-proof metamath-bridges/plane/gangle180
  lean-proof  not yet implemented

mundane theorem angle-by-cosine
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  let x ∈ ℝ                                                           (H4)
  assume P ≠ Q                                                        (H5)
  assume R ≠ Q                                                        (H6)
  assume 0 ≤ x                                                        (H7)
  assume x ≤ 180°                                                     (H8)
  assume P ≠ R                                                        (H9)
  then        ∠PQR = x ↔ cos(∠PQR) = cos(x)
  metamath-proof metamath-bridges/plane/gangcos
  note        An angle is read from its cosine, as right-angle-by-cosine
              reads a right angle: on [0°, 180°] the cosine takes each value
              once.
  lean-proof  not yet implemented

axiom side-angle-side
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  let P′ be a point                                                   (H4)
  let Q′ be a point                                                   (H5)
  let R′ be a point                                                   (H6)
  assume P, Q, R form a triangle                                      (H7)
  assume P′, Q′, R′ form a triangle                                   (H8)
  assume |PQ| = |P′Q′|                                                (H9)
  assume ∠PQR = ∠P′Q′R′                                               (H10)
  assume |QR| = |Q′R′|                                                (H11)
  then        triangle PQR ≅ triangle P′Q′R′
  metamath-proof metamath-bridges/geometry/gsas
  note        The isosceles proof instantiates A, B, C, A′, B′, C′, which are not
              this statement's variable names. One of the two must change; the
              merge changed neither. See DATABASE.md.
  lean-proof  not yet implemented

# The postulates of plane geometry: the School Mathematics Study Group's,
# those of the plane, with the area postulates said of triangles. A reader
# takes each as given, and each is proved over ℂ in
# elaboration/stdlib/proved.mm, so that nothing is assumed. Four are
# records above: distance-positive (2), supplementary-angles (14),
# side-angle-side (15) and area-positive (17).

axiom line-uniqueness
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  let D be a point                                                    (H4)
  assume A ≠ B                                                        (H5)
  assume C ≠ D                                                        (H6)
  assume A is on line CD                                              (H7)
  assume B is on line CD                                              (H8)
  then        line AB = line CD
  metamath-proof metamath-bridges/postulates/glineuniq
  note        SMSG's postulate 1: two distinct points lie on exactly one
              line. Lines are said by two of their points, so the postulate
              says that any two distinct points of a line make that line.
  lean-proof  not yet implemented

axiom three-points
  then        there are P, Q, R ∈ 𝔼² with P, Q, R form a triangle
  metamath-proof metamath-bridges/postulates/gthreepts
  note        SMSG's postulate 5, of the plane: it holds three points not on
              one line.
  lean-proof  not yet implemented

axiom angle-measure
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  assume P, Q, R form a triangle                                      (H4)
  then        ∠PQR > 0°. ∠PQR < 180°.
  metamath-proof metamath-bridges/postulates/gangmeas
  note        SMSG's postulate 11: an angle, two rays from one point not on
              one line, has a measure strictly between 0° and 180°.
              mun:stdlib/geometry/angle-real and
              mun:stdlib/geometry/angle-at-most-straight say what holds of
              any three points, the ends apart from the corner.
  lean-proof  not yet implemented

axiom ruler
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  assume A ≠ B                                                        (H3)
  then        there is f : line AB → ℝ with f : line AB → ℝ is one-to-one and
              onto and for all P, Q ∈ line AB, |PQ| = |f(P) − f(Q)|
  metamath-proof metamath-bridges/postulates/gruler
  note        SMSG's postulate 3, the ruler: the points of a line are paired
              with the real numbers so that a distance is a difference of
              coordinates.
  lean-proof  not yet implemented

axiom ruler-placement
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  assume A ≠ B                                                        (H3)
  then        there is f : line AB → ℝ with f : line AB → ℝ is one-to-one and
              onto and f(A) = 0 and f(B) > 0 and for all P, Q ∈ line AB,
              |PQ| = |f(P) − f(Q)|
  metamath-proof metamath-bridges/postulates/grulerplace
  note        SMSG's postulate 4: a ruler may be laid along a line with any
              point of it at 0 and any other on the positive side.
  lean-proof  not yet implemented

axiom parallel-uniqueness
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let P be a point                                                    (H3)
  let C be a point                                                    (H4)
  let D be a point                                                    (H5)
  assume A ≠ B                                                        (H6)
  assume not (P is on line AB)                                        (H7)
  assume P ≠ C                                                        (H8)
  assume P ≠ D                                                        (H9)
  assume line PC ∥ line AB                                            (H10)
  assume line PD ∥ line AB                                            (H11)
  then        line PC = line PD
  metamath-proof metamath-bridges/postulates/gparuniq
  note        SMSG's postulate 16, the parallel postulate: through a point
              not on a line there is at most one line parallel to it. That
              there is one is thm:stdlib/geometry/parallel-through.
  lean-proof  not yet implemented

axiom plane-separation
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let P be a point                                                    (H3)
  let Q be a point                                                    (H4)
  assume A ≠ B                                                        (H5)
  assume not (P is on line AB)                                        (H6)
  assume not (Q is on line AB)                                        (H7)
  then        P and Q are on the same side of line AB or P and Q are on
              opposite sides of line AB
  metamath-proof metamath-bridges/postulates/gplanesep
  note        SMSG's postulate 9, the plane separation postulate, in three
              parts: a line divides the points off it into two sides, each
              side holds a segment between two of its points
              (plane-separation-convex), and a segment between the two
              sides meets the line (plane-separation-crossing).
  lean-proof  not yet implemented

axiom plane-separation-convex
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let P be a point                                                    (H3)
  let Q be a point                                                    (H4)
  let X be a point                                                    (H5)
  assume A ≠ B                                                        (H6)
  assume P and Q are on the same side of line AB                      (H7)
  assume X is between P and Q                                         (H8)
  then        X and P are on the same side of line AB
  metamath-proof metamath-bridges/postulates/gplanesepcvx
  note        SMSG's postulate 9, second part: each side of a line is
              convex.
  lean-proof  not yet implemented

axiom plane-separation-crossing
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let P be a point                                                    (H3)
  let Q be a point                                                    (H4)
  assume A ≠ B                                                        (H5)
  assume P and Q are on opposite sides of line AB                     (H6)
  then        there is X ∈ 𝔼² with X is on line AB and
              (X is between P and Q)
  metamath-proof metamath-bridges/postulates/gplanesepcross
  note        SMSG's postulate 9, third part: a segment joining the two
              sides of a line meets the line.
  lean-proof  not yet implemented

axiom angle-construction
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  let x ∈ ℝ                                                           (H4)
  assume A, B, C form a triangle                                      (H5)
  assume x > 0°                                                       (H6)
  assume x < 180°                                                     (H7)
  then        there is D ∈ 𝔼² with D and C are on the same side of line AB
              and ∠BAD = x
  metamath-proof metamath-bridges/postulates/gangconsm
  note        SMSG's postulate 12, the angle construction postulate: on a
              given side of a line, a ray from a point of it makes each
              angle from 0° to 180° with the line, in two parts. This is
              that there is one; angle-construction-unique that there is
              only one.
  lean-proof  not yet implemented

axiom angle-construction-unique
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  let D be a point                                                    (H4)
  let E be a point                                                    (H5)
  assume A, B, C form a triangle                                      (H6)
  assume D and C are on the same side of line AB                      (H7)
  assume E and C are on the same side of line AB                      (H8)
  assume ∠BAD = ∠BAE                                                  (H9)
  then        E ∈ ray AD
  metamath-proof metamath-bridges/postulates/gangconsuniq
  note        SMSG's postulate 12, second part: the ray is the only one.
  lean-proof  not yet implemented

axiom angle-addition-inside
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  let D be a point                                                    (H4)
  assume A, B, C form a triangle                                      (H5)
  assume D and C are on the same side of line AB                      (H6)
  assume D and B are on the same side of line AC                      (H7)
  then        ∠BAD + ∠DAC = ∠BAC
  metamath-proof metamath-bridges/postulates/gangaddin
  note        SMSG's postulate 13, the angle addition postulate: D is
              inside angle BAC, on C's side of line AB and B's side of line
              AC. mun:stdlib/geometry/angle-addition says the same of a D
              between B and C.
  lean-proof  not yet implemented

axiom area-congruent
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  let P′ be a point                                                   (H4)
  let Q′ be a point                                                   (H5)
  let R′ be a point                                                   (H6)
  assume P, Q, R form a triangle                                      (H7)
  assume P′, Q′, R′ form a triangle                                   (H8)
  assume triangle PQR ≅ triangle P′Q′R′                               (H9)
  then        the area of △PQR = the area of △P′Q′R′
  metamath-proof metamath-bridges/postulates/gareacong
  note        SMSG's postulate 18: congruent triangles have the same area.
  lean-proof  not yet implemented

axiom area-base-height
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  let H be a point                                                    (H4)
  assume P, Q, R form a triangle                                      (H5)
  assume H is on line QR                                              (H6)
  assume line PH ⊥ line QR                                            (H7)
  then        the area of △PQR = (1/2)·|QR|·|PH|
  metamath-proof metamath-bridges/postulates/gareabh
  note        SMSG's postulate 20, said of a triangle: half the base times
              the height, where SMSG says it of a rectangle.
  lean-proof  not yet implemented

axiom area-addition
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  let D be a point                                                    (H4)
  assume P, Q, R form a triangle                                      (H5)
  assume D is between Q and R                                         (H6)
  then        the area of △PQR = the area of △PQD + the area of △PDR
  metamath-proof metamath-bridges/postulates/gareaadd
  note        SMSG's postulate 19, said of a triangle cut in two by a
              segment from a vertex.
  lean-proof  not yet implemented

# Facts of order and of the sides of a line that a proof from the
# postulates takes for granted, as a school text does: each is proved over
# ℂ in elaboration/stdlib/proved.mm.

mundane theorem midpoint-exists
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  assume A ≠ B                                                        (H3)
  then        there is M ∈ 𝔼² with M is the midpoint of AB
  metamath-proof metamath-bridges/postulates/gmidex
  lean-proof  not yet implemented

mundane theorem segment-extension
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let r ∈ ℝ                                                           (H3)
  assume A ≠ B                                                        (H4)
  assume r > 0                                                        (H5)
  then        there is X ∈ 𝔼² with (B is between A and X) and |BX| = r
  metamath-proof metamath-bridges/postulates/gextend
  note        Euclid's second postulate, a segment produced, with the length
              it is produced by.
  lean-proof  not yet implemented

mundane theorem segment-point
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let r ∈ ℝ                                                           (H3)
  assume r > 0                                                        (H4)
  assume r < |AB|                                                     (H5)
  then        there is X ∈ 𝔼² with (X is between A and B) and |AX| = r
  metamath-proof metamath-bridges/postulates/gsegpt
  note        A length shorter than a segment, laid off along it from one
              end.
  lean-proof  not yet implemented

mundane theorem triangle-off-line
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  assume Q ≠ R                                                        (H4)
  assume not (P is on line QR)                                        (H5)
  then        P, Q, R form a triangle
  metamath-proof metamath-bridges/postulates/gtrioff
  lean-proof  not yet implemented

mundane theorem ray-on-line
  let P be a point                                                    (H1)
  let A be a point                                                    (H2)
  let B be a point                                                    (H3)
  assume P ∈ ray AB                                                   (H4)
  then        P is on line AB
  metamath-proof metamath-bridges/postulates/grayline
  note        A ray lies on its line.
  lean-proof  not yet implemented

mundane theorem same-not-opposite
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let P be a point                                                    (H3)
  let Q be a point                                                    (H4)
  assume P and Q are on the same side of line AB                      (H5)
  then        not (P and Q are on opposite sides of line AB)
  metamath-proof metamath-bridges/postulates/gsidenot
  note        The two sides of a line do not meet, which SMSG's plane
              separation postulate says in calling them two sets.
  lean-proof  not yet implemented

mundane theorem parallel-turned
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  let D be a point                                                    (H4)
  assume A ≠ B                                                        (H5)
  assume line AB ∥ line CD                                            (H6)
  then        line CD ∥ line AB
  metamath-proof metamath-bridges/postulates/gparturn
  note        Being parallel goes both ways.
  lean-proof  not yet implemented

mundane theorem perpendicular-turned
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  let D be a point                                                    (H4)
  assume line AB ⊥ line CD                                            (H5)
  then        line BA ⊥ line CD
  metamath-proof metamath-bridges/postulates/gperpturn
  note        Line BA is line AB, so a line perpendicular to the one is
              perpendicular to the other.
  lean-proof  not yet implemented

mundane theorem perpendicular-along
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  let D be a point                                                    (H4)
  let E be a point                                                    (H5)
  let F be a point                                                    (H6)
  assume line AB ⊥ line CD                                            (H7)
  assume E is on line CD                                              (H8)
  assume F is on line CD                                              (H9)
  assume E ≠ F                                                        (H10)
  then        line AB ⊥ line EF
  metamath-proof metamath-bridges/postulates/gperpalong
  note        Being perpendicular belongs to the line, not to the two
              points that name it.
  lean-proof  not yet implemented

mundane theorem area-rotated
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  assume P, Q, R form a triangle                                      (H4)
  then        the area of △PQR = the area of △QRP
  metamath-proof metamath-bridges/postulates/garearot
  note        The area of a triangle does not depend on which vertex is
              named first.
  lean-proof  not yet implemented

mundane theorem same-side-turned
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let P be a point                                                    (H3)
  let Q be a point                                                    (H4)
  assume P and Q are on the same side of line AB                      (H5)
  then        Q and P are on the same side of line AB
  metamath-proof metamath-bridges/postulates/gsameturn
  lean-proof  not yet implemented

mundane theorem opposite-sides-turned
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let P be a point                                                    (H3)
  let Q be a point                                                    (H4)
  assume P and Q are on opposite sides of line AB                     (H5)
  then        Q and P are on opposite sides of line AB
  metamath-proof metamath-bridges/postulates/goppturn
  lean-proof  not yet implemented

mundane theorem same-side-same
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let P be a point                                                    (H3)
  let Q be a point                                                    (H4)
  let R be a point                                                    (H5)
  assume P and Q are on the same side of line AB                      (H6)
  assume Q and R are on the same side of line AB                      (H7)
  then        P and R are on the same side of line AB
  metamath-proof metamath-bridges/postulates/gsametr
  lean-proof  not yet implemented

mundane theorem opposite-opposite-same
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let P be a point                                                    (H3)
  let Q be a point                                                    (H4)
  let R be a point                                                    (H5)
  assume P and Q are on opposite sides of line AB                     (H6)
  assume Q and R are on opposite sides of line AB                     (H7)
  then        P and R are on the same side of line AB
  metamath-proof metamath-bridges/postulates/goppopp
  lean-proof  not yet implemented

mundane theorem same-opposite-opposite
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let P be a point                                                    (H3)
  let Q be a point                                                    (H4)
  let R be a point                                                    (H5)
  assume P and Q are on the same side of line AB                      (H6)
  assume Q and R are on opposite sides of line AB                     (H7)
  then        P and R are on opposite sides of line AB
  metamath-proof metamath-bridges/postulates/gsameopp
  lean-proof  not yet implemented

mundane theorem same-side-of-line
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  let D be a point                                                    (H4)
  let P be a point                                                    (H5)
  let Q be a point                                                    (H6)
  assume A ≠ B                                                        (H7)
  assume C ≠ D                                                        (H8)
  assume C is on line AB                                              (H9)
  assume D is on line AB                                              (H10)
  assume P and Q are on the same side of line AB                      (H11)
  then        P and Q are on the same side of line CD
  metamath-proof metamath-bridges/postulates/gsideline
  note        Which side a point is on belongs to the line, not to the two
              points that name it.
  lean-proof  not yet implemented

mundane theorem opposite-sides-of-line
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  let D be a point                                                    (H4)
  let P be a point                                                    (H5)
  let Q be a point                                                    (H6)
  assume A ≠ B                                                        (H7)
  assume C ≠ D                                                        (H8)
  assume C is on line AB                                              (H9)
  assume D is on line AB                                              (H10)
  assume P and Q are on opposite sides of line AB                     (H11)
  then        P and Q are on opposite sides of line CD
  metamath-proof metamath-bridges/postulates/goppline
  lean-proof  not yet implemented

mundane theorem segment-off-line
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let P be a point                                                    (H3)
  let Q be a point                                                    (H4)
  let X be a point                                                    (H5)
  assume A ≠ B                                                        (H6)
  assume Q is on line AB                                              (H7)
  assume not (P is on line AB)                                        (H8)
  assume X is between P and Q                                         (H9)
  then        X and P are on the same side of line AB
  metamath-proof metamath-bridges/postulates/gsegside
  note        A segment from a point off a line to a point on it stays on
              the first point's side.
  lean-proof  not yet implemented

mundane theorem segment-across-line
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let P be a point                                                    (H3)
  let Q be a point                                                    (H4)
  let M be a point                                                    (H5)
  assume A ≠ B                                                        (H6)
  assume M is on line AB                                              (H7)
  assume not (P is on line AB)                                        (H8)
  assume M is between P and Q                                         (H9)
  then        P and Q are on opposite sides of line AB
  metamath-proof metamath-bridges/postulates/gsegcross
  note        A segment through a point of a line, from a point off it,
              ends on the other side.
  lean-proof  not yet implemented

mundane theorem segment-beyond-off-line
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let P be a point                                                    (H3)
  let Q be a point                                                    (H4)
  let X be a point                                                    (H5)
  assume A ≠ B                                                        (H6)
  assume Q is on line AB                                              (H7)
  assume not (X is on line AB)                                        (H8)
  assume X is between P and Q                                         (H9)
  then        P and X are on the same side of line AB
  metamath-proof metamath-bridges/postulates/gsegbeyond
  note        A segment from a point of a line through a point off it goes
              on, past that point, on its side.
  lean-proof  not yet implemented

mundane theorem same-side-off-line
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let P be a point                                                    (H3)
  let Q be a point                                                    (H4)
  assume P and Q are on the same side of line AB                      (H5)
  then        A ≠ B. not (P is on line AB). not (Q is on line AB).
  metamath-proof metamath-bridges/postulates/gsameoffab, metamath-bridges/postulates/gsameoffp, metamath-bridges/postulates/gsameoffq
  note        One target to a sentence.
  lean-proof  not yet implemented

mundane theorem opposite-sides-off-line
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let P be a point                                                    (H3)
  let Q be a point                                                    (H4)
  assume P and Q are on opposite sides of line AB                     (H5)
  then        A ≠ B. not (P is on line AB). not (Q is on line AB).
  metamath-proof metamath-bridges/postulates/goppoffab, metamath-bridges/postulates/goppoffp, metamath-bridges/postulates/goppoffq
  note        One target to a sentence.
  lean-proof  not yet implemented

mundane theorem on-line-ends
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  then        A is on line AB. B is on line AB.
  metamath-proof metamath-bridges/postulates/gonends1, metamath-bridges/postulates/gonends2
  note        One target to a sentence.
  lean-proof  not yet implemented

mundane theorem triangle-not-on-line
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  assume P, Q, R form a triangle                                      (H4)
  then        not (P is on line QR)
  metamath-proof metamath-bridges/postulates/gtrinot
  lean-proof  not yet implemented

mundane theorem triangle-extension
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  let S be a point                                                    (H4)
  assume P, Q, R form a triangle                                      (H5)
  assume Q is between R and S                                         (H6)
  then        P, Q, S form a triangle
  metamath-proof metamath-bridges/postulates/gtriext
  note        A side produced past a vertex, as triangle-on-side takes a
              point within it.
  lean-proof  not yet implemented

mundane theorem off-line-apart
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let P be a point                                                    (H3)
  assume not (P is on line AB)                                        (H4)
  then        P ≠ A. P ≠ B.
  metamath-proof metamath-bridges/postulates/goffapart1, metamath-bridges/postulates/goffapart2
  note        One target to a sentence.
  lean-proof  not yet implemented

mundane theorem on-off-apart
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let X be a point                                                    (H3)
  let Y be a point                                                    (H4)
  assume X is on line AB                                              (H5)
  assume not (Y is on line AB)                                        (H6)
  then        X ≠ Y
  metamath-proof metamath-bridges/postulates/gonoffapart
  lean-proof  not yet implemented

mundane theorem off-line-through
  let R be a point                                                    (H1)
  let P be a point                                                    (H2)
  let S be a point                                                    (H3)
  let X be a point                                                    (H4)
  assume not (S is on line RP)                                        (H5)
  assume X is on line RS                                              (H6)
  assume X ≠ R                                                        (H7)
  then        not (X is on line RP)
  metamath-proof metamath-bridges/postulates/gofflinethru
  note        Two lines through R meet only at R.
  lean-proof  not yet implemented

mundane theorem line-crossing-between
  let R be a point                                                    (H1)
  let P be a point                                                    (H2)
  let S be a point                                                    (H3)
  let X be a point                                                    (H4)
  assume X is on line RS                                              (H5)
  assume S and X are on opposite sides of line RP                     (H6)
  then        R is between S and X
  metamath-proof metamath-bridges/postulates/glinecrossbet
  note        A line through R crosses another line through R at R, so a
              point of it on the far side is beyond R.
  lean-proof  not yet implemented

mundane theorem angle-same-ray
  let R be a point                                                    (H1)
  let P be a point                                                    (H2)
  let Q be a point                                                    (H3)
  let X be a point                                                    (H4)
  assume X is on line PQ                                              (H5)
  assume X and Q are on the same side of line PR                      (H6)
  then        ∠RPX = ∠RPQ
  metamath-proof metamath-bridges/postulates/gangsameray
  note        A point of line PQ on Q's side of line PR is on the ray from
              P through Q, so it makes the same angle.
  lean-proof  not yet implemented

mundane theorem ray-side-transfer
  let R be a point                                                    (H1)
  let P be a point                                                    (H2)
  let S be a point                                                    (H3)
  let Q be a point                                                    (H4)
  let X be a point                                                    (H5)
  assume X is on line RP                                              (H6)
  assume X and P are on the same side of line RS                      (H7)
  assume not (P is on line RQ)                                        (H8)
  then        X and P are on the same side of line RQ
  metamath-proof metamath-bridges/postulates/graysidetr
  note        A point on the ray from R through P is on P's side of every
              line through R that P is off.
  lean-proof  not yet implemented

mundane theorem parallel-along
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  let D be a point                                                    (H4)
  let E be a point                                                    (H5)
  assume line AB ∥ line CD                                            (H6)
  assume A ≠ B                                                        (H7)
  assume E is on line AB                                              (H8)
  assume E ≠ A                                                        (H9)
  then        line AE ∥ line DC
  metamath-proof metamath-bridges/postulates/gparalong
  note        Being parallel belongs to the two lines, not to the points
              that name them.
  lean-proof  not yet implemented

mundane theorem off-line-swap
  let R be a point                                                    (H1)
  let P be a point                                                    (H2)
  let Q be a point                                                    (H3)
  assume not (Q is on line RP)                                        (H4)
  then        not (P is on line RQ)
  metamath-proof metamath-bridges/postulates/goffswap
  lean-proof  not yet implemented
