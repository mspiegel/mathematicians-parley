# Standard library: trigonometry
#
# The cosine and sine, their values at 0, and the angle-addition formulas.
#
# One record per item. A record begins at column 0 with its kind, axiom,
# theorem or definition, and its name; `mundane` before the kind marks an
# item a proof takes for granted. A proof imports each item it cites,
# `import <header> stdlib/trigonometry/<name>`, where the header is the
# record's own before its name, as `mundane theorem` or `axiom`. Format is described in DATABASE.md.
#
# An item's statement is written in the theorem form of SYNTAX.md: let and
# assume lines with labels, then a `then` line.
#
# Every item carries at least one of:
#   metamath    a set.mm label or labels supply it
#   open        it is cited but unproved and unbridged
#
# Other fields: target, note, and for a function, sort, builds and reads.


mundane definition cos
  sort        number → number
  builds      _1 ccos cfv
  reads       the cosine of
  decided     real arithmetic
  metamath    df-cos, by the exponential function
  note        A reader knows the cosine from school, and set.mm's definition of
              it by the exponential is not what that reader means by it, so
              this definition states nothing but what cos(x) builds; what a
              proof needs of it is in items of its own, as for min and max.

mundane definition sin
  sort        number → number
  builds      _1 csin cfv
  reads       the sine of
  decided     real arithmetic
  metamath    df-sin, by the exponential function
  note        As for cos. Real arithmetic works out the sine and cosine of an
              angle of value 0 or a rational multiple of π whose denominator
              divides 4 or 6 (METHODS.md).

theorem cos-add
  let a ∈ ℂ                                                           (H1)
  let b ∈ ℂ                                                           (H2)
  then        cos(a + b) = cos(a)·cos(b) − sin(a)·sin(b)
  metamath    cosadd
  target      cosadd

theorem sin-add
  let a ∈ ℂ                                                           (H1)
  let b ∈ ℂ                                                           (H2)
  then        sin(a + b) = sin(a)·cos(b) + cos(a)·sin(b)
  metamath    sinadd
  target      sinadd

mundane theorem cos-zero
  then        cos(0) = 1
  metamath    cos0
  target      cos0

mundane theorem sin-zero
  then        sin(0) = 0
  metamath    sin0
  target      sin0

mundane theorem cos-real
  let a ∈ ℝ                                                           (H1)
  then        cos(a) ∈ ℝ
  metamath    recoscl
  target      recoscl

mundane theorem sin-real
  let a ∈ ℝ                                                           (H1)
  then        sin(a) ∈ ℝ
  metamath    resincl
  target      resincl

mundane theorem cos-complex
  let a ∈ ℂ                                                           (H1)
  then        cos(a) ∈ ℂ
  metamath    coscl
  target      coscl
  note        As cos-real, for a complex argument: cos-add and sin-add are
              stated over ℂ, and algebra on what they give asks each value
              to be a number.

mundane theorem sin-complex
  let a ∈ ℂ                                                           (H1)
  then        sin(a) ∈ ℂ
  metamath    sincl
  target      sincl
  note        As cos-complex.

mundane theorem cos-negative
  let a ∈ ℂ                                                           (H1)
  then        cos(−a) = cos(a)
  metamath    cosneg
  target      cosneg
  note        The cosine is even. With cos-add it gives the cosine of a
              difference.

mundane theorem sin-negative
  let a ∈ ℂ                                                           (H1)
  then        sin(−a) = −sin(a)
  metamath    sinneg
  target      sinneg
  note        The sine is odd. With sin-add it gives the sine of a
              difference.

mundane theorem sin-cos-squares
  let a ∈ ℂ                                                           (H1)
  then        sin(a)² + cos(a)² = 1
  metamath    sincossq
  target      sincossq
  note        A school reader takes it from the unit circle. From cos-add
              alone it is cos(a + (−a)) = cos(0), which asks the two items
              above.
