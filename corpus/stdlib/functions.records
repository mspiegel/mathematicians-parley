# Standard library: functions
#
# Functions, their values, and the set of values a function takes.
#
# One record per item. A record begins at column 0 with its kind, axiom,
# theorem or definition, and its name; `mundane` before the kind marks an
# item a proof takes for granted. A proof imports each item it cites,
# `import <header> stdlib/functions/<name>`, where the header is the
# record's own before its name, as `mundane theorem` or `axiom`. Format is described in DATABASE.md.
#
# An item's statement is written in the theorem form of SYNTAX.md: let and
# assume lines with labels, then a `then` line.
#
# Every item carries at least one of:
#   metamath    a set.mm label or labels supply it
#   open        it is cited but unproved and unbridged
#
# Other fields: target, note.


mundane definition set-image
  let Y be a set                                                      (H1)
  let Z be a set                                                      (H2)
  let E : Y → Z                                                       (H3)
  then        u ∈ {E(s) : s ∈ Y} ↔ there is s ∈ Y with u = E(s)
  metamath    elrnmptg
  target      elrnmptg
  note        {E(s) : s ∈ Y} is the range of the map s ↦ E(s) on Y, and
              elrnmptg says what is in that range where every E(s) is a set,
              which a function's value always is (`fvex`).

mundane theorem added-elements-are-new
  let Y be a set                                                      (H1)
  let a be an element                                                 (H2)
  assume for all s ∈ Y, s ∪ {a} ∉ Y                                   (H3)
  then        for all u ∈ {s ∪ {a} : s ∈ Y}, u ∉ Y
  metamath    ralrnmpt
  target      ralrnmpt
  note        Running over the sets with a added is running over the sets and
              adding a, which `ralrnmpt` says of the range of any map written
              on the spot and of any property of its members. Both are
              narrowed here to the one map the corpus writes and the one
              property it asks, because the language can name neither — the
              same gap `notation bijection` records.

mundane theorem function-value
  let f : D → E                                                       (H1)
  let x ∈ D                                                           (H2)
  then        f(x) ∈ E
  metamath    ffvelcdm
  target      ffvelcdm
  note        The intermediate value pilot called this mun:stdlib/functions/function, colliding
              with the Cantor pilot's definition of the same name. Renamed by the
              merge; that proof's three citations are renamed with it.

mundane theorem image-of-injection
  let Y be a set                                                      (H1)
  let a be an element                                                 (H2)
  assume for all S, T ∈ Y, if S ∪ {a} = T ∪ {a} then S = T            (H3)
  then        there is a bijection from Y to {S ∪ {a} : S ∈ Y}
  metamath    f1oeng, over the map f1mpt and f1f1orn show is one-to-one
  target      f1oeng with F := the map sending S ∈ Y to S ∪ {a}
  note        A map that sends no two things to the same place pairs its
              domain off against what comes out of it. Narrowed to the one
              map the corpus builds, as `mun:stdlib/functions/added-elements-are-new` is: the
              readable layer states the property and the `target` names the
              map, because a reader says "if S ∪ {a} = T ∪ {a} then S = T"
              and does not name a function to say it.

mundane theorem added-element-in-image
  let Y be a set                                                      (H1)
  let a be an element                                                 (H2)
  let s ∈ Y                                                           (H3)
  then        s ∪ {a} ∈ {t ∪ {a} : t ∈ Y}
  metamath    elrnmpt1s
  target      elrnmpt1s
  note        Narrowed to the one map the corpus writes, as
              `mun:stdlib/functions/added-elements-are-new` is.

mundane theorem added-elements-stay-inside
  let Y be a set                                                      (H1)
  let a be an element                                                 (H2)
  assume for all s ∈ Y, s ∪ {a} ∈ Z                                   (H3)
  then        {s ∪ {a} : s ∈ Y} ⊆ Z
  metamath    rnmptss
  target      rnmptss
  note        Narrowed to the one map the corpus writes, as
              `mun:stdlib/functions/added-elements-are-new` is.

mundane definition image
  let f : X → W                                                       (H1)
  assume Y ⊆ X                                                        (H2)
  then        u ∈ f[Y] ↔ there is s ∈ Y with u = f(s)
  metamath    fvelimab, with ffn and eqcom, which this corpus proves
              together in elaboration/stdlib/proved.mm
  target      gfvelima
  note        f[Y] is everything f sends Y to, {f(s) : s ∈ Y}. It is the same
              set as `mun:stdlib/functions/set-image` speaks of for a map
              written on the spot; this is the one for a function with a
              name, which a bracket can follow.

mundane theorem image-within
  let f : X → W                                                       (H1)
  then        f[Y] ⊆ W
  metamath    fimass
  target      fimass

mundane theorem image-monotone
  let f : X → W                                                       (H1)
  assume Y ⊆ Z                                                        (H2)
  then        f[Y] ⊆ f[Z]
  metamath    imass2
  target      imass2

mundane theorem function-into
  let E be a function on X                                            (H1)
  assume for all x ∈ X, E(x) ∈ Y                                      (H2)
  then        E : X → Y
  metamath    ffnfv
  target      ffnfv

mundane theorem value-in-image
  let f : X → W                                                       (H1)
  assume Y ⊆ X                                                        (H2)
  let s ∈ Y                                                           (H3)
  then        f(s) ∈ f[Y]
  metamath    fnfvima, with ffn, which this corpus proves together in
              elaboration/stdlib/proved.mm
  target      gfnfvima

mundane definition one-to-one
  let f : X → Y                                                       (H1)
  then        f : X → Y is one-to-one ↔ f : X → Y and for all s, t ∈ X,
              if f(s) = f(t) then s = t
  metamath    dff13
  target      dff13

mundane theorem inverse-value
  let g : Y → X be one-to-one                                         (H1)
  let y ∈ Y                                                           (H2)
  then        g⁻¹(g(y)) = y
  metamath    f1f1orn and f1ocnvfv1, which this corpus proves together in
              elaboration/stdlib/proved.mm
  target      gf1cnvfv1

mundane definition bijection
  let X be a set                                                      (H1)
  let f : X → Y be one-to-one                                         (H2)
  assume for all y ∈ Y, there is x ∈ X with y = f(x)                  (H3)
  then        there is a bijection from X to Y
  metamath    f1f, dffo3, df-f1o and f1oeng, which this corpus proves
              together in elaboration/stdlib/proved.mm
  target      gf1foen
  note        A function that never sends two things to one place and
              reaches every point pairs its domain off against its
              codomain. set.mm calls the reaching onto and the pairing a
              one-to-one correspondence, and the page says neither word.

mundane theorem bijection-onto
  assume there is a bijection from X to Y                             (H1)
  then        there is f : X → Y with for all y ∈ Y, there is x ∈ X with y = f(x)
  metamath    bren, f1ofo and foelrn, with encv and elmapg placing f among
              the functions from X to Y, which this corpus proves together
              in elaboration/stdlib/proved.mm
  target      gbijonto
  note        The way back from `bijection`, as far as a proof needs it: a
              pairing of X with Y is a function from X that reaches every
              point of Y. That it is one-to-one as well is not said, since
              no proof asks it.
