# Standard library: functions
#
# Functions, their values, and the set of values a function takes.
#
# One record per item. A record begins at column 0 with its kind, axiom,
# theorem or definition, and its name; `mundane` before the kind marks an
# item a proof takes for granted. A proof imports each item it cites,
# `import <header> stdlib/functions/<name>`, where the header is the
# record's own before its name, as `mundane theorem` or `axiom`. Format is described in DATABASE.md.
#
# An item's statement is written in the theorem form of SYNTAX.md: let and
# assume lines with labels, then a `then` line.
#
# Every item carries both:
#   metamath-proof  how the Metamath build proves it: a set.mm label, the
#                   full name of a Parley proof or of a bridge, `none` where
#                   it has nothing to prove, or `not yet implemented`
#   lean-proof      the same for the Lean build, a Mathlib proof in place of
#                   a set.mm label
#
# Other fields: note.


definition set-image
  let Y be a set                                                      (H1)
  let Z be a set                                                      (H2)
  let E : Y → Z                                                       (H3)
  then        u ∈ {E(s) : s ∈ Y} ↔ there is s ∈ Y with u = E(s)
  metamath-proof elrnmptg
  note        {E(s) : s ∈ Y} is the range of the map s ↦ E(s) on Y, and
              elrnmptg says what is in that range where every E(s) is a set,
              which a function's value always is (`fvex`).
  lean-proof  lean-bridges/functions/set-image

mundane theorem added-elements-are-new
  let Y be a set                                                      (H1)
  let a be an element                                                 (H2)
  assume for all s ∈ Y, s ∪ {a} ∉ Z                                   (H3)
  then        for all u ∈ {s ∪ {a} : s ∈ Y}, u ∉ Z
  metamath-proof ralrnmpt
  note        Running over the sets with a added is running over the sets and
              adding a, which `ralrnmpt` says of the range of any map written
              on the spot and of any property of its members. Both are
              narrowed here to the one map the corpus writes and the one
              property it asks, being outside a set Z, because the language
              can name neither — the same gap `notation bijection` records.
              Z may be Y itself, as the subsets proof has it.
  lean-proof  not yet implemented

mundane theorem function-value
  let f : D → E                                                       (H1)
  let x ∈ D                                                           (H2)
  then        f(x) ∈ E
  metamath-proof ffvelcdm
  note        The intermediate value pilot called this mun:stdlib/functions/function, colliding
              with the Cantor pilot's definition of the same name. Renamed by the
              merge; that proof's three citations are renamed with it.
  lean-proof  hf h1

mundane theorem image-of-injection
  let Y be a set                                                      (H1)
  let a be an element                                                 (H2)
  assume for all S, T ∈ Y, if S ∪ {a} = T ∪ {a} then S = T            (H3)
  then        there is a bijection from Y to {S ∪ {a} : S ∈ Y}
  metamath-proof f1oeng with F := the map sending S ∈ Y to S ∪ {a}
  note        A map that sends no two things to the same place pairs its
              domain off against what comes out of it. Narrowed to the one
              map the corpus builds, as `mun:stdlib/functions/added-elements-are-new` is: the
              readable layer states the property and the `target` names the
              map, because a reader says "if S ∪ {a} = T ∪ {a} then S = T"
              and does not name a function to say it.
  lean-proof  not yet implemented

mundane theorem added-element-in-image
  let Y be a set                                                      (H1)
  let a be an element                                                 (H2)
  let s ∈ Y                                                           (H3)
  then        s ∪ {a} ∈ {t ∪ {a} : t ∈ Y}
  metamath-proof elrnmpt1s
  note        Narrowed to the one map the corpus writes, as
              `mun:stdlib/functions/added-elements-are-new` is.
  lean-proof  not yet implemented

mundane theorem added-elements-stay-inside
  let Y be a set                                                      (H1)
  let a be an element                                                 (H2)
  assume for all s ∈ Y, s ∪ {a} ∈ Z                                   (H3)
  then        {s ∪ {a} : s ∈ Y} ⊆ Z
  metamath-proof rnmptss
  note        Narrowed to the one map the corpus writes, as
              `mun:stdlib/functions/added-elements-are-new` is.
  lean-proof  not yet implemented

definition image
  let f : X → W                                                       (H1)
  assume Y ⊆ X                                                        (H2)
  then        u ∈ f[Y] ↔ there is s ∈ Y with u = f(s)
  metamath-proof metamath-bridges/functions/gfvelima
  note        f[Y] is everything f sends Y to, {f(s) : s ∈ Y}. It is the same
              set as `def:stdlib/functions/set-image` speaks of for a map
              written on the spot; this is the one for a function with a
              name, which a bracket can follow.
  lean-proof  lean-bridges/functions/image

mundane theorem image-within
  let f : X → W                                                       (H1)
  then        f[Y] ⊆ W
  metamath-proof fimass
  lean-proof  (hf.mono_left Set.inter_subset_left).image_subset

mundane theorem image-monotone
  let f : X → W                                                       (H1)
  assume Y ⊆ Z                                                        (H2)
  then        f[Y] ⊆ f[Z]
  metamath-proof imass2
  lean-proof  Set.image_mono (Set.inter_subset_inter_right X h1)

mundane theorem function-into
  let E be a function on X                                            (H1)
  assume for all x ∈ X, E(x) ∈ Y                                      (H2)
  then        E : X → Y
  metamath-proof ffnfv
  lean-proof  fun x hx => h2 x hx

mundane theorem function-on-domain
  let f : X → Y                                                       (H1)
  then        f is a function on X
  metamath-proof ffn
  note        A function from X into Y is a function on X, which its values
              may then be said to lie in another set.
  lean-proof  not yet implemented

mundane theorem value-in-image
  let f : X → W                                                       (H1)
  assume Y ⊆ X                                                        (H2)
  let s ∈ Y                                                           (H3)
  then        f(s) ∈ f[Y]
  metamath-proof metamath-bridges/functions/gfnfvima
  lean-proof  Set.mem_image_of_mem f ⟨h1 h2, h2⟩

definition one-to-one
  let f : X → Y                                                       (H1)
  then        f : X → Y is one-to-one ↔ f : X → Y and for all s, t ∈ X,
              if f(s) = f(t) then s = t
  metamath-proof dff13
  lean-proof  Iff.rfl

definition onto
  let f : X → Y                                                       (H1)
  then        f : X → Y is onto ↔ f : X → Y and for all y ∈ Y, there is
              x ∈ X with y = f(x)
  metamath-proof dffo3
  lean-proof  lean-bridges/functions/onto

definition one-to-one-onto
  let f : X → Y                                                       (H1)
  then        f : X → Y is one-to-one and onto ↔ f : X → Y is one-to-one
              and f : X → Y is onto
  metamath-proof df-f1o
  lean-proof  lean-bridges/functions/one-to-one-onto

mundane theorem inverse-value
  let g : Y → X be one-to-one                                         (H1)
  let y ∈ Y                                                           (H2)
  then        g⁻¹(g(y)) = y
  metamath-proof metamath-bridges/functions/gf1cnvfv1
  lean-proof  LeanBridges.Functions.inverse_of_value g Y y h1.2 h2

definition preimage
  let f : X → W                                                       (H1)
  then        u ∈ f⁻¹[Z] ↔ u ∈ X and f(u) ∈ Z
  metamath-proof metamath-bridges/functions/gelpreima
  note        f⁻¹[Z] is everything in X that f sends into Z, whether or not
              f has an inverse.
  lean-proof  Iff.rfl

mundane theorem preimage-within
  let f : X → W                                                       (H1)
  then        f⁻¹[Z] ⊆ X
  metamath-proof metamath-bridges/functions/gpreimass
  note        A preimage holds only points of the domain.
  lean-proof  Set.inter_subset_left

mundane theorem inverse-function
  let f : X → Y be one-to-one                                         (H1)
  assume f[X] = Y                                                     (H2)
  then        f⁻¹ : Y → X
  metamath-proof metamath-bridges/functions/gf1cnvf
  note        A one-to-one function that reaches all of Y has an inverse
              that takes Y back to X.
  lean-proof  not yet implemented

mundane theorem composition-function
  let f : X → Y                                                       (H1)
  let g : Y → W                                                       (H2)
  then        g ∘ f : X → W
  metamath-proof fco
  note        f takes X into Y, where g takes over.
  lean-proof  not yet implemented

mundane theorem composition-value
  let f : X → Y                                                       (H1)
  let g : Y → W                                                       (H2)
  let x ∈ X                                                           (H3)
  then        (g ∘ f)(x) = g(f(x))
  metamath-proof fvco3
  lean-proof  rfl

mundane theorem composition-one-to-one
  let f : X → Y be one-to-one                                         (H1)
  let g : Y → W be one-to-one                                         (H2)
  then        g ∘ f : X → W is one-to-one
  metamath-proof f1co
  note        Two different points stay apart under f, and their images
              stay apart under g.
  lean-proof  not yet implemented

definition bijection
  let X be a set                                                      (H1)
  let f : X → Y be one-to-one and onto                                (H2)
  then        there is a bijection from X to Y
  metamath-proof f1oeng
  note        A function that never sends two things to one place and
              reaches every point pairs its domain off against its
              codomain: one such function is what there being a bijection
              between two sets means.
  lean-proof  not yet implemented

mundane theorem bijection-onto
  assume there is a bijection from X to Y                             (H1)
  then        there is f : X → Y with f : X → Y is onto
  metamath-proof metamath-bridges/functions/gbijonto
  note        The way back from `bijection`, as far as a proof needs it: a
              pairing of X with Y is a function from X onto Y. That it is
              one-to-one as well is not said, since no proof asks it.
  lean-proof  not yet implemented
