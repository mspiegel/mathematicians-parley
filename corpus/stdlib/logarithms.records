# Standard library: logarithms
#
# The natural logarithm and the exponential function: their laws, that each
# undoes the other, the order of logarithms, and their signs.
#
# One record per item. A record begins at column 0 with its kind, axiom,
# theorem or definition, and its name; `mundane` before the kind marks an
# item a proof takes for granted. A proof imports each item it cites,
# `import <header> stdlib/logarithms/<name>`, where the header is the
# record's own before its name, as `mundane theorem` or `axiom`. Format is described in DATABASE.md.
#
# An item's statement is written in the theorem form of SYNTAX.md: let and
# assume lines with labels, then a `then` line.
#
# Every item carries both:
#   metamath-proof  how the Metamath build proves it: a set.mm label, the
#                   full name of a Parley proof or of a bridge, `none` where
#                   it has nothing to prove, or `not yet implemented`
#   lean-proof      the same for the Lean build, a Mathlib proof in place of
#                   a set.mm label
#
# Other fields: note, and for a function, sort, metamath-builds, reads and
# decided.


definition ln
  sort        number → number
  metamath-builds _1 clog cfv
  lean-builds ℝ → ℝ: Real.log _1
  reads       the natural logarithm of
  decided     real arithmetic
  note        set.mm's log is taken in ℂ, its value at a negative number having
              an imaginary part; real arithmetic takes it only of a positive
              rational, or one times a whole power of e (METHODS.md), where it
              is the logarithm a reader knows. As for cos, this definition
              states nothing but what ln(x) builds.
  metamath-proof none
  lean-proof  none

definition exp
  sort        number → number
  metamath-builds _1 ce cfv
  lean-builds ℝ → ℝ: Real.exp _1 ; ℂ → ℂ: Complex.exp _1
  reads       the exponential of
  decided     real arithmetic
  note        exp(x) is eˣ, which set.mm defines the other way round, e being
              exp(1) (df-e). Real arithmetic takes it of a whole number of at
              least 0 plus whole multiples of logarithms of primes.
  metamath-proof none
  lean-proof  none

mundane theorem ln-product
  let x ∈ ℝ                                                           (H1)
  let y ∈ ℝ                                                           (H2)
  assume x > 0                                                        (H3)
  assume y > 0                                                        (H4)
  then        ln(x·y) = ln(x) + ln(y)
  metamath-proof relogmul
  lean-proof  Real.log_mul h3.ne' h4.ne'

mundane theorem ln-quotient
  let x ∈ ℝ                                                           (H1)
  let y ∈ ℝ                                                           (H2)
  assume x > 0                                                        (H3)
  assume y > 0                                                        (H4)
  then        ln(x/y) = ln(x) − ln(y)
  metamath-proof relogdiv
  lean-proof  Real.log_div h3.ne' h4.ne'

mundane theorem ln-power
  let x ∈ ℝ                                                           (H1)
  let n ∈ ℤ                                                           (H2)
  assume x > 0                                                        (H3)
  then        ln(x^n) = n·ln(x)
  metamath-proof relogexp
  lean-proof  Real.log_zpow x n

mundane theorem exp-ln
  let x ∈ ℝ                                                           (H1)
  assume x > 0                                                        (H2)
  then        exp(ln(x)) = x
  metamath-proof reeflog
  note        With ln-exp, the logarithm and the exponential undo each other:
              each is one-to-one where the other is defined.
  lean-proof  Real.exp_log h2

mundane theorem ln-exp
  let x ∈ ℝ                                                           (H1)
  then        ln(exp(x)) = x
  metamath-proof relogef
  lean-proof  Real.log_exp x

mundane theorem exp-sum
  let a ∈ ℂ                                                           (H1)
  let b ∈ ℂ                                                           (H2)
  then        exp(a + b) = exp(a)·exp(b)
  metamath-proof efadd
  lean-proof  Complex.exp_add a b

mundane theorem ln-order
  let x ∈ ℝ                                                           (H1)
  let y ∈ ℝ                                                           (H2)
  assume x > 0                                                        (H3)
  assume y > 0                                                        (H4)
  then        x < y ↔ ln(x) < ln(y)
  metamath-proof logltb with A := x, B := y
  lean-proof  (Real.log_lt_log_iff h3 h4).symm

mundane theorem ln-real
  let x ∈ ℝ                                                           (H1)
  assume x > 0                                                        (H2)
  then        ln(x) ∈ ℝ
  metamath-proof relogcl
  lean-proof  trivial

mundane theorem ln-nonzero
  let x ∈ ℝ                                                           (H1)
  assume x > 0                                                        (H2)
  assume x ≠ 1                                                        (H3)
  then        ln(x) ≠ 0
  metamath-proof logne0
  lean-proof  Real.log_ne_zero_of_pos_of_ne_one h2 h3

mundane theorem exp-real
  let x ∈ ℝ                                                           (H1)
  then        exp(x) ∈ ℝ
  metamath-proof reefcl
  lean-proof  not yet implemented

mundane theorem e-power
  let y ∈ ℂ                                                           (H1)
  then        e^y = exp(y)
  metamath-proof ecxp
  note        e to a power that is not whole is the principal power
              (`GRAMMAR.md`), which is exp of the exponent.
  lean-proof  not yet implemented

mundane theorem exp-positive
  let x ∈ ℝ                                                           (H1)
  then        exp(x) > 0
  metamath-proof efgt0
  lean-proof  Real.exp_pos x
