# Standard library: calculus
#
# Intervals of the real line, upper bounds and completeness, continuity,
# derivatives, and integrals.
#
# One record per item. A record begins at column 0 with its kind, axiom,
# theorem or definition, and its name; `mundane` before the kind marks an
# item a proof takes for granted. A proof imports each item it cites,
# `import <header> stdlib/calculus/<name>`, where the header is the
# record's own before its name, as `mundane theorem` or `axiom`. Format is described in DATABASE.md.
#
# An item's statement is written in the theorem form of SYNTAX.md: let and
# assume lines with labels, then a `then` line.
#
# Every item carries both:
#   metamath-proof  how the Metamath build proves it: a set.mm label, the
#                   full name of a Parley proof or of a bridge, `none` where
#                   it has nothing to prove, or `not yet implemented`
#   lean-proof      the same for the Lean build, a Mathlib proof in place of
#                   a set.mm label
#
# Other fields: note.


definition interval
  let a ∈ ℝ                                                           (H1)
  let b ∈ ℝ                                                           (H2)
  then        x ∈ [a, b] ↔ x ∈ ℝ and a ≤ x and x ≤ b
  metamath-proof elicc2
  lean-proof  by simp [Set.mem_Icc]

definition open-interval
  let a ∈ ℝ                                                           (H1)
  let b ∈ ℝ                                                           (H2)
  then        x ∈ (a, b) ↔ x ∈ ℝ and a < x and x < b
  metamath-proof metamath-bridges/calculus/gelioo2
  note        As `interval` says what is in [a, b], with the bounds strict.
              set.mm's `elioo2` takes the ends in the extended reals, and
              `gelioo2` says it of the real ends the page writes.
  lean-proof  by (simp_all; done)

mundane theorem interval-real
  let a ∈ ℝ                                                           (H1)
  let b ∈ ℝ                                                           (H2)
  then        [a, b] ⊆ ℝ
  metamath-proof iccssre
  lean-proof  Set.subset_univ _

mundane theorem open-interval-real
  let a ∈ ℝ                                                           (H1)
  let b ∈ ℝ                                                           (H2)
  then        (a, b) ⊆ ℝ
  metamath-proof ioossre
  lean-proof  by (simp_all; done)

mundane theorem open-within-closed
  let a ∈ ℝ                                                           (H1)
  let b ∈ ℝ                                                           (H2)
  then        (a, b) ⊆ [a, b]
  metamath-proof ioossicc
  lean-proof  Set.Ioo_subset_Icc_self

mundane theorem closed-within-open
  let a ∈ ℝ                                                           (H1)
  let b ∈ ℝ                                                           (H2)
  let p ∈ (a, b)                                                      (H3)
  let q ∈ (a, b)                                                      (H4)
  then        [p, q] ⊆ (a, b)
  metamath-proof iccssioo2
  note        The closed interval between two points of (a, b) lies in it, as
              the mean value theorem asks of an interval inside a function's
              open domain.
  lean-proof  Set.Icc_subset_Ioo h3.1 h4.2

mundane theorem open-interval-open
  let a ∈ ℝ                                                           (H1)
  let b ∈ ℝ                                                           (H2)
  then        (a, b) is open
  metamath-proof iooretop
  lean-proof  isOpen_Ioo

mundane theorem open-without-point
  let U ⊆ ℝ                                                           (H1)
  assume U is open                                                    (H2)
  let c ∈ U                                                           (H3)
  then        U ∖ {c} is open
  metamath-proof metamath-bridges/calculus/gopndifsn
  note        A point is a closed set, the interval [c, c], and an open set
              with a closed one taken out is open: (a, b) ∖ {c} is open, as a
              derivative there asks.
  lean-proof  h2.sdiff isClosed_singleton

mundane theorem reals-open
  then        ℝ is open
  metamath-proof reopn
  lean-proof  by (simp_all; done)

definition continuous-on
  let D ⊆ ℝ                                                           (H1)
  let f : D → ℝ                                                       (H2)
  ε, δ range over ℝ
  then        f is continuous on D ↔ for all c ∈ D, for all ε > 0, there
              exists δ > 0 such that |f(x) − f(c)| < ε for all x ∈ D with
              |x − c| < δ
  metamath-proof metamath-bridges/calculus/gcncfre
  note        `elcncf2` quantifies over ℝ⁺ where the page says ε > 0 with ε
              ranging over ℝ, and `rules.STANDARD` reads the one as the other. It
              also says f : D → ℝ on its right side, where the page puts it
              in the hypothesis, and that conjunct is set aside.
  lean-proof  lean-bridges/calculus/continuous-on

definition limit-at
  let D ⊆ ℝ                                                           (H1)
  let f : D → ℝ                                                       (H2)
  let c ∈ ℝ                                                           (H3)
  let L ∈ ℝ                                                           (H4)
  ε, δ range over ℝ
  then        f tends to L at c ↔ for all ε > 0, there exists δ > 0 such
              that |f(x) − L| < ε for all x ∈ D with (x ≠ c and |x − c| < δ)
  metamath-proof metamath-bridges/calculus/glimcre
  note        f(x) is within ε of L wherever x is within δ of c, c itself
              left out: the value at c, if f has one, says nothing of the
              limit.
  lean-proof  lean-bridges/calculus/limit-at

definition tends-to
  let x : ℕ → ℝ                                                       (H1)
  let L ∈ ℝ                                                           (H2)
  ε ranges over ℝ
  n ranges over ℕ
  then        x(n) → L as n → ∞ ↔ for all ε > 0, there exists N ∈ ℕ such
              that |x(n) − L| < ε for all n ≥ N
  metamath-proof metamath-bridges/series/climnnre
  note        A sequence tends to L when, however small a distance ε is
              named, its terms from some N on are all within ε of L. set.mm's
              `clim2` says it over ℝ⁺ and the upper integers, with every term
              complex, and names its index apart from the sequence's, so it
              cannot read a sequence the page writes as a rule in n.
              `climnnre` says it as the page does.
  lean-proof  lean-bridges/calculus/tends-to

definition series-sum
  let t : ℕ → ℝ                                                       (H1)
  let L ∈ ℝ                                                           (H2)
  assume Σ(k = 1 to n) t(k) → L as n → ∞                              (H3)
  then        Σ(k = 1 to ∞) t(k) = L
  metamath-proof metamath-bridges/series/sersumlim
  note        The value of a series is the limit of its partial sums, which
              is how a textbook defines it. set.mm defines an infinite sum
              through a sequence of its own, and `sersumlim` is the join,
              proved below the readable layer from `isumclim3` and `climuni`.
  lean-proof  lean-bridges/calculus/series-sum

definition series-sum-from-zero
  let t : ℕ₀ → ℝ                                                      (H1)
  let L ∈ ℝ                                                           (H2)
  assume Σ(k = 0 to n) t(k) → L as n → ∞                              (H3)
  then        Σ(k = 0 to ∞) t(k) = L
  metamath-proof metamath-bridges/series/sersumlim0
  note        series-sum, for a series whose first term is the 0th, as
              1 − 1/3 + 1/5 − … is written.
  lean-proof  lean-bridges/calculus/series-sum-from-zero

axiom completeness
  assume S ⊆ ℝ                                                        (H1)
  assume there is s ∈ S                                               (H2)
  assume there is u ∈ ℝ with u is an upper bound of S                 (H3)
  then        there is c ∈ ℝ with c is a least upper bound of S
  metamath-proof suprcl, suprub, suprleub with c := sup S
  note        The least upper bound is set.mm's supremum, and each thing the
              page asks of it is a lemma: that it is real, that nothing in S
              is above it, and that it is at most anything nothing in S is
              above. The `with` names what the claim binds, so it is the
              witness rather than what a lemma's variable stands for.
  lean-proof  by obtain ⟨s, hs, -⟩ := h2; obtain ⟨u, hu⟩ := h3; exact ⟨sSup S, fun x hx => le_csSup ⟨u, fun y hy => hu y hy⟩ hx, fun v hv => csSup_le ⟨s, hs⟩ (fun y hy => hv y hy)⟩

mundane theorem integer-sup-member
  let S ⊆ ℤ                                                           (H1)
  assume there is s ∈ S                                               (H2)
  assume there is u ∈ ℤ with u is an upper bound of S                 (H3)
  then        sup S ∈ S
  metamath-proof suprzcl2
  note        A set of whole numbers with an element and an upper bound has
              a largest element, and it is the least upper bound: below the
              bound there are only finitely many whole numbers to pass.
  lean-proof  not yet implemented

mundane theorem integer-sup-above
  let S ⊆ ℤ                                                           (H1)
  assume there is u ∈ ℤ with u is an upper bound of S                 (H2)
  let x ∈ S                                                           (H3)
  then        x ≤ sup S
  metamath-proof suprzub
  note        No element of a set of whole numbers bounded above is above
              its least upper bound.
  lean-proof  not yet implemented

theorem rolle
  let a ∈ ℝ                                                           (H1)
  let b ∈ ℝ                                                           (H2)
  assume a < b                                                        (H3)
  let f : [a, b] → ℝ                                                  (H4)
  assume f is continuous on [a, b]                                    (H5)
  assume f is differentiable on (a, b)                                (H6)
  assume f(a) = f(b)                                                  (H7)
  then        there is c ∈ (a, b) with f′(c) = 0
  metamath-proof metamath-bridges/calculus/grolleres
  note        rolle asks that f′ be defined on exactly (a, b); the page says
              on (a, b), and for f on [a, b] the two agree (gdvdmicc).
  lean-proof  exists_deriv_eq_zero h3 h4 h6

theorem rolle-on-part
  let D ⊆ ℝ                                                           (H1)
  let a ∈ ℝ                                                           (H2)
  let b ∈ ℝ                                                           (H3)
  assume a < b                                                        (H4)
  assume [a, b] ⊆ D                                                   (H5)
  let f : D → ℝ                                                       (H6)
  assume f is continuous on [a, b]                                    (H7)
  assume f is differentiable on (a, b)                                (H8)
  assume f(a) = f(b)                                                  (H9)
  then        there is c ∈ (a, b) with f′(c) = 0
  metamath-proof metamath-bridges/calculus/grollepart with D := D
  note        Rolle's theorem for a function on a larger set D: f restricted
              to [a, b] has f′ for its derivative on (a, b), the interior of
              [a, b] (dvres, iccntr), and f's values at the ends.
  lean-proof  exists_deriv_eq_zero h4 h6 h8

mundane theorem derivative-real
  let a ∈ ℝ                                                           (H1)
  let b ∈ ℝ                                                           (H2)
  let f : [a, b] → ℝ                                                  (H3)
  assume f is differentiable on (a, b)                                (H4)
  let x ∈ (a, b)                                                      (H5)
  then        f′(x) ∈ ℝ
  metamath-proof metamath-bridges/calculus/gdvre with A := a, B := b
  note        A and B are only in the hypotheses of `gdvre`, so the `with`
              says which they are rather than leaving them to the first
              real numbers the step's facts hold.
  lean-proof  by (simp_all; done)

mundane theorem derivative-real-on
  let D ⊆ ℝ                                                           (H1)
  let U ⊆ D                                                           (H2)
  let f : D → ℝ                                                       (H3)
  assume f is differentiable on U                                     (H4)
  let x ∈ U                                                           (H5)
  then        f′(x) ∈ ℝ
  metamath-proof metamath-bridges/calculus/gdvrepart with D := D, U := U
  note        derivative-real, for a function on any set of reals.
  lean-proof  by (simp_all; done)

theorem continuous-sum
  let D ⊆ ℝ                                                           (H1)
  let F : D → ℝ                                                       (H2)
  let f : D → ℝ                                                       (H3)
  let g : D → ℝ                                                       (H4)
  assume for all x ∈ D, F(x) = f(x) + g(x)                            (H5)
  assume f is continuous on D                                         (H6)
  assume g is continuous on D                                         (H7)
  then        F is continuous on D
  metamath-proof metamath-bridges/calculus/gcncfaddres with F := f, G := g
  lean-proof  (h3.add h4).congr (fun x hx => h2 x hx)

theorem continuous-difference
  let D ⊆ ℝ                                                           (H1)
  let F : D → ℝ                                                       (H2)
  let f : D → ℝ                                                       (H3)
  let g : D → ℝ                                                       (H4)
  assume for all x ∈ D, F(x) = f(x) − g(x)                            (H5)
  assume f is continuous on D                                         (H6)
  assume g is continuous on D                                         (H7)
  then        F is continuous on D
  metamath-proof metamath-bridges/calculus/gcncfsubres with F := f, G := g
  lean-proof  (h3.sub h4).congr (fun x hx => h2 x hx)

theorem continuous-linear
  let D ⊆ ℝ                                                           (H1)
  let m ∈ ℝ                                                           (H2)
  let g : D → ℝ                                                       (H3)
  assume for all x ∈ D, g(x) = m·x                                    (H4)
  then        g is continuous on D
  metamath-proof metamath-bridges/calculus/gcncflinres with M := m
  lean-proof  (show Continuous fun x : ℝ => m * x by fun_prop).continuousOn.congr (fun x hx => h3 x hx)

theorem continuous-square
  let D ⊆ ℝ                                                           (H1)
  let g : D → ℝ                                                       (H2)
  assume for all x ∈ D, g(x) = x²                                     (H3)
  then        g is continuous on D
  metamath-proof metamath-bridges/calculus/gcncfsqres
  lean-proof  (show Continuous fun x : ℝ => x ^ 2 by fun_prop).continuousOn.congr (fun x hx => h2 x hx)

theorem continuous-constant
  let D ⊆ ℝ                                                           (H1)
  let c ∈ ℝ                                                           (H2)
  let g : D → ℝ                                                       (H3)
  assume for all x ∈ D, g(x) = c                                      (H4)
  then        g is continuous on D
  metamath-proof metamath-bridges/calculus/gcncfconstres with C := c
  lean-proof  (show Continuous fun _ : ℝ => c by fun_prop).continuousOn.congr (fun x hx => h3 x hx)

theorem continuous-power
  let D ⊆ ℝ                                                           (H1)
  let n ∈ ℕ₀                                                          (H2)
  let g : D → ℝ                                                       (H3)
  assume for all x ∈ D, g(x) = x^n                                    (H4)
  then        g is continuous on D
  metamath-proof metamath-bridges/calculus/gcncfexpres with N := n
  lean-proof  (show Continuous fun x : ℝ => x ^ n by fun_prop).continuousOn.congr (fun x hx => h3 x hx)

theorem continuous-scaled
  let D ⊆ ℝ                                                           (H1)
  let c ∈ ℝ                                                           (H2)
  let F : D → ℝ                                                       (H3)
  let f : D → ℝ                                                       (H4)
  assume for all x ∈ D, F(x) = c·f(x)                                 (H5)
  assume f is continuous on D                                         (H6)
  then        F is continuous on D
  metamath-proof metamath-bridges/calculus/gcncfmulcres with C := c, F := f
  lean-proof  (continuousOn_const.mul h4).congr (fun x hx => h3 x hx)

theorem continuous-quotient
  let D ⊆ ℝ                                                           (H1)
  let F : D → ℝ                                                       (H2)
  let f : D → ℝ                                                       (H3)
  let g : D → ℝ                                                       (H4)
  assume for all x ∈ D, g(x) ≠ 0                                      (H5)
  assume for all x ∈ D, F(x) = f(x)/g(x)                              (H6)
  assume f is continuous on D                                         (H7)
  assume g is continuous on D                                         (H8)
  then        F is continuous on D
  metamath-proof metamath-bridges/calculus/gcncfdivres with F := f, G := g
  lean-proof  (h4.div h5 h2).congr (fun x hx => h3 x hx)

mundane theorem continuous-on-part
  let D ⊆ ℝ                                                           (H1)
  let f : D → ℝ                                                       (H2)
  let S ⊆ D                                                           (H3)
  assume f is continuous on D                                         (H4)
  then        f is continuous on S
  metamath-proof metamath-bridges/calculus/gcncfpart
  note        A function continuous on a set is continuous on any part of
              it, as the mean value theorem asks of f on [c, x] inside its
              domain.
  lean-proof  ContinuousOn.congr_mono h3 (fun ⦃x⦄ => congrFun rfl) h2

mundane theorem map-continuous-on-part
  let D ⊆ ℝ                                                           (H1)
  let S ⊆ D                                                           (H2)
  let f : D → ℝ                                                       (H3)
  assume f is continuous on S                                         (H4)
  then        (x ∈ S ↦ f(x)) is continuous on S
  metamath-proof metamath-bridges/calculus/gcncfmappart with D := D
  note        "f is continuous on S" says f restricted to S is, and that
              restriction is the map sending each x ∈ S to f(x).
  lean-proof  not yet implemented

theorem continuous-bounded
  let a ∈ ℝ                                                           (H1)
  let b ∈ ℝ                                                           (H2)
  let f : [a, b] → ℝ                                                  (H3)
  assume f is continuous on [a, b]                                    (H4)
  then        there exists M ∈ ℝ such that |f(x)| ≤ M for all x ∈ [a, b]
  metamath-proof metamath-bridges/calculus/gcncfbdd
  note        A function continuous on a closed interval is bounded there.
  lean-proof  by obtain ⟨M, hM⟩ := isCompact_Icc.exists_bound_of_continuousOn h3; exact ⟨M, fun x hx => by simpa [Real.norm_eq_abs] using hM x hx⟩

mundane theorem differentiable-on-part
  let D ⊆ ℝ                                                           (H1)
  let U ⊆ D                                                           (H2)
  let S ⊆ U                                                           (H3)
  let f : D → ℝ                                                       (H4)
  assume f is differentiable on U                                     (H5)
  then        f is differentiable on S
  metamath-proof sstr
  note        Differentiable on U says f′ is defined at every point of U, so
              at every point of a part of U.
  lean-proof  fun x hx => h4 x (h3 hx)

mundane theorem derivative-local
  let D ⊆ ℝ                                                           (H1)
  let E ⊆ ℝ                                                           (H2)
  let U ⊆ D                                                           (H3)
  assume U ⊆ E                                                        (H4)
  assume U is open                                                    (H5)
  let f : D → ℝ                                                       (H6)
  let F : E → ℝ                                                       (H7)
  assume for all x ∈ U, F(x) = f(x)                                   (H8)
  assume f is differentiable on U                                     (H9)
  then        F is differentiable on U.
              For all x ∈ U, F′(x) = f′(x).
  metamath-proof metamath-bridges/calculus/gdvloc, metamath-bridges/calculus/gdvlocv with D := D, E := E, F := f
  note        A derivative at a point sees only the function near it, so two
              functions equal on an open set have one derivative there: each
              restricted to U has its derivative restricted to U (dvres), U
              being its own interior.
  lean-proof  fun x hx => ⟨Filter.mem_of_superset (h5.mem_nhds hx) h4, (h7 x hx).2.congr_of_eventuallyEq (Filter.eventually_of_mem (h5.mem_nhds hx) (fun y hy => h6 y hy))⟩ ; fun x hx => Filter.EventuallyEq.deriv_eq (Filter.eventually_of_mem (h5.mem_nhds hx) (fun y hy => h6 y hy))

theorem continuous-extension
  let U ⊆ ℝ                                                           (H1)
  assume U is open                                                    (H2)
  let c ∈ U                                                           (H3)
  let L ∈ ℝ                                                           (H4)
  let f : U ∖ {c} → ℝ                                                 (H5)
  let F : U → ℝ                                                       (H6)
  assume for all x ∈ U ∖ {c}, F(x) = f(x)                             (H7)
  assume F(c) = L                                                     (H8)
  assume f is differentiable on U ∖ {c}                               (H9)
  assume f tends to L at c                                            (H10)
  then        F is continuous on U
  metamath-proof metamath-bridges/calculus/gcncfext with C := c, L := L, F := f
  note        f extended to c by its limit there: F is continuous at c,
              since it tends to its value, and at every other point, since
              it is differentiable there (dvcnp2), agreeing with f on the
              open U ∖ {c}.
  lean-proof  by intro x hx; by_cases hxc : x = c; (subst hxc; rw [← continuousWithinAt_sdiff_self, ContinuousWithinAt, h6]; rw [(show (U \ ({x} : Set ℝ)) \ {x} = U \ {x} by ext y; simp)] at h8; exact h8.congr' (eventually_nhdsWithin_of_forall (fun y hy => (h5 y hy).symm))); have hmem : x ∈ U \ ({c} : Set ℝ) := ⟨hx, hxc⟩; exact (((h7 x hmem).2.continuousAt).congr (Filter.eventually_of_mem ((h2.sdiff isClosed_singleton).mem_nhds hmem) (fun y hy => (h5 y hy).symm))).continuousWithinAt

theorem derivative-sum
  let D ⊆ ℝ                                                           (H1)
  let U ⊆ D                                                           (H2)
  let F : D → ℝ                                                       (H3)
  let f : D → ℝ                                                       (H4)
  let g : D → ℝ                                                       (H5)
  assume for all x ∈ D, F(x) = f(x) + g(x)                            (H6)
  assume f is differentiable on U                                     (H7)
  assume g is differentiable on U                                     (H8)
  then        F is differentiable on U.
              For all x ∈ U, F′(x) = f′(x) + g′(x).
  metamath-proof metamath-bridges/calculus/gdvadd, metamath-bridges/calculus/gdvaddv with D := D, F := f, G := g
  note        One target to a sentence, as completeness has. A sum is
              differentiable at each point both its parts are, so U may be any
              set: (a, b) inside [a, b], or ℝ itself.
  lean-proof  fun x hx => ⟨(h4 x hx).1, ((h4 x hx).2.add (h5 x hx).2).congr_of_eventuallyEq (Filter.eventually_of_mem (h4 x hx).1 (fun y hy => h3 y hy))⟩ ; fun x hx => by rw [Filter.EventuallyEq.deriv_eq (Filter.eventually_of_mem (h4 x hx).1 (fun y hy => h3 y hy))]; exact deriv_add (h4 x hx).2 (h5 x hx).2

theorem derivative-difference
  let D ⊆ ℝ                                                           (H1)
  let U ⊆ D                                                           (H2)
  let F : D → ℝ                                                       (H3)
  let f : D → ℝ                                                       (H4)
  let g : D → ℝ                                                       (H5)
  assume for all x ∈ D, F(x) = f(x) − g(x)                            (H6)
  assume f is differentiable on U                                     (H7)
  assume g is differentiable on U                                     (H8)
  then        F is differentiable on U.
              For all x ∈ U, F′(x) = f′(x) − g′(x).
  metamath-proof metamath-bridges/calculus/gdvdif, metamath-bridges/calculus/gdvdifv with D := D, F := f, G := g
  note        As derivative-sum, at each point both parts are differentiable.
              set.mm has no rule for a difference at a point; f − g is
              f + (−1)·g (ofnegsub), and the constant −1 has derivative 0
              wherever a neighbourhood lies in D.
  lean-proof  fun x hx => ⟨(h4 x hx).1, ((h4 x hx).2.sub (h5 x hx).2).congr_of_eventuallyEq (Filter.eventually_of_mem (h4 x hx).1 (fun y hy => h3 y hy))⟩ ; fun x hx => by rw [Filter.EventuallyEq.deriv_eq (Filter.eventually_of_mem (h4 x hx).1 (fun y hy => h3 y hy))]; exact deriv_sub (h4 x hx).2 (h5 x hx).2

theorem derivative-linear
  let D ⊆ ℝ                                                           (H1)
  let U ⊆ D                                                           (H2)
  assume U is open                                                    (H3)
  let m ∈ ℝ                                                           (H4)
  let g : D → ℝ                                                       (H5)
  assume for all x ∈ D, g(x) = m·x                                    (H6)
  then        g is differentiable on U.
              For all x ∈ U, g′(x) = m.
  metamath-proof metamath-bridges/calculus/gdvlin, metamath-bridges/calculus/gdvlinv with D := D, M := m
  note        U is open because a line on [a, b] has no derivative at a or b:
              the derivative is taken where a neighbourhood lies in the domain.
  lean-proof  fun x hx => ⟨Filter.mem_of_superset (h3.mem_nhds hx) h2, (show DifferentiableAt ℝ (fun y : ℝ => m * y) x by fun_prop).congr_of_eventuallyEq (Filter.eventually_of_mem (Filter.mem_of_superset (h3.mem_nhds hx) h2) (fun y hy => h5 y hy))⟩ ; fun x hx => by rw [Filter.EventuallyEq.deriv_eq (Filter.eventually_of_mem (Filter.mem_of_superset (h3.mem_nhds hx) h2) (fun y hy => h5 y hy))]; simpa using ((hasDerivAt_id x).const_mul m).deriv

theorem derivative-square
  let D ⊆ ℝ                                                           (H1)
  let U ⊆ D                                                           (H2)
  assume U is open                                                    (H3)
  let g : D → ℝ                                                       (H4)
  assume for all x ∈ D, g(x) = x²                                     (H5)
  then        g is differentiable on U.
              For all x ∈ U, g′(x) = 2x.
  metamath-proof metamath-bridges/calculus/gdvsq, metamath-bridges/calculus/gdvsqv with D := D
  note        set.mm's dvexp is the power rule over ℂ; the page asks it of a
              function on a set of reals, named apart from its values, as
              derivative-linear does.
  lean-proof  fun x hx => ⟨Filter.mem_of_superset (h3.mem_nhds hx) h2, (show DifferentiableAt ℝ (fun y : ℝ => y ^ 2) x by fun_prop).congr_of_eventuallyEq (Filter.eventually_of_mem (Filter.mem_of_superset (h3.mem_nhds hx) h2) (fun y hy => h4 y hy))⟩ ; fun x hx => by rw [Filter.EventuallyEq.deriv_eq (Filter.eventually_of_mem (Filter.mem_of_superset (h3.mem_nhds hx) h2) (fun y hy => h4 y hy))]; simpa using (hasDerivAt_pow 2 x).deriv

theorem derivative-power
  let D ⊆ ℝ                                                           (H1)
  let U ⊆ D                                                           (H2)
  assume U is open                                                    (H3)
  let n ∈ ℕ₀                                                          (H4)
  let g : D → ℝ                                                       (H5)
  assume for all x ∈ D, g(x) = x^(n + 1)                              (H6)
  then        g is differentiable on U.
              For all x ∈ U, g′(x) = (n + 1)·x^n.
  metamath-proof metamath-bridges/calculus/gdvexp, metamath-bridges/calculus/gdvexpv with D := D, N := n
  note        The power rule, as derivative-square has it for n = 1. It is
              written for the power n + 1 so that the derivative's exponent
              is n itself, a number a power's exponent may be.
  lean-proof  fun x hx => ⟨Filter.mem_of_superset (h3.mem_nhds hx) h2, (show DifferentiableAt ℝ (fun y : ℝ => y ^ (n + 1)) x by fun_prop).congr_of_eventuallyEq (Filter.eventually_of_mem (Filter.mem_of_superset (h3.mem_nhds hx) h2) (fun y hy => h5 y hy))⟩ ; fun x hx => by rw [Filter.EventuallyEq.deriv_eq (Filter.eventually_of_mem (Filter.mem_of_superset (h3.mem_nhds hx) h2) (fun y hy => h5 y hy))]; simpa using (hasDerivAt_pow (n + 1) x).deriv

theorem derivative-scaled
  let D ⊆ ℝ                                                           (H1)
  let U ⊆ D                                                           (H2)
  let c ∈ ℝ                                                           (H3)
  let F : D → ℝ                                                       (H4)
  let f : D → ℝ                                                       (H5)
  assume for all x ∈ D, F(x) = c·f(x)                                 (H6)
  assume f is differentiable on U                                     (H7)
  then        F is differentiable on U.
              For all x ∈ U, F′(x) = c·f′(x).
  metamath-proof metamath-bridges/calculus/gdvmulc, metamath-bridges/calculus/gdvmulcv with D := D, C := c, F := f
  note        As derivative-sum, at each point f is differentiable.
  lean-proof  fun x hx => ⟨(h5 x hx).1, ((h5 x hx).2.const_mul c).congr_of_eventuallyEq (Filter.eventually_of_mem (h5 x hx).1 (fun y hy => h4 y hy))⟩ ; fun x hx => by rw [Filter.EventuallyEq.deriv_eq (Filter.eventually_of_mem (h5 x hx).1 (fun y hy => h4 y hy))]; exact deriv_const_mul c (h5 x hx).2

theorem area-function
  let a ∈ ℝ                                                           (H1)
  let b ∈ ℝ                                                           (H2)
  assume a < b                                                        (H3)
  let f : [a, b] → ℝ                                                  (H4)
  assume f is continuous on [a, b]                                    (H5)
  let G : [a, b] → ℝ                                                  (H6)
  assume for all x ∈ [a, b], G(x) = ∫(a to x) f(t) dt                 (H7)
  then        G is continuous on [a, b].
              G is differentiable on (a, b).
              For all x ∈ (a, b), G′(x) = f(x).
  metamath-proof metamath-bridges/calculus/gftc1cres, metamath-bridges/calculus/gftc1res, metamath-bridges/calculus/gftc1vres with A := a, B := b, F := f, G := G
  note        The fundamental theorem of calculus, part one: the integral
              of f from a up to x, as x moves, has derivative f. set.mm's
              ftc1 asks f be integrable, which a function continuous on
              [a, b] is (cniccibl), so the page never says it; and its
              integral is over (a, x), which the directed one is where a ≤ x
              (ditgpos).
  lean-proof  by have hi : MeasureTheory.IntegrableOn f (Set.uIcc a b) := (by rw [Set.uIcc_of_le h3.le]; exact h4.integrableOn_Icc); have hc := intervalIntegral.continuousOn_primitive_interval hi; rw [Set.uIcc_of_le h3.le] at hc; exact hc.congr (fun x hx => h5 x hx) ; fun x hx => ⟨Icc_mem_nhds hx.1 hx.2, ((intervalIntegral.integral_hasDerivAt_right ((h4.mono (Set.Icc_subset_Icc le_rfl hx.2.le)).intervalIntegrable_of_Icc hx.1.le) ((h4.mono Set.Ioo_subset_Icc_self).stronglyMeasurableAtFilter isOpen_Ioo x hx) (h4.continuousAt (Icc_mem_nhds hx.1 hx.2))).congr_of_eventuallyEq (Filter.eventually_of_mem (Icc_mem_nhds hx.1 hx.2) (fun y hy => h5 y hy))).differentiableAt⟩ ; fun x hx => ((intervalIntegral.integral_hasDerivAt_right ((h4.mono (Set.Icc_subset_Icc le_rfl hx.2.le)).intervalIntegrable_of_Icc hx.1.le) ((h4.mono Set.Ioo_subset_Icc_self).stronglyMeasurableAtFilter isOpen_Ioo x hx) (h4.continuousAt (Icc_mem_nhds hx.1 hx.2))).congr_of_eventuallyEq (Filter.eventually_of_mem (Icc_mem_nhds hx.1 hx.2) (fun y hy => h5 y hy))).deriv

mundane theorem integral-real
  let a ∈ ℝ                                                           (H1)
  let b ∈ ℝ                                                           (H2)
  assume a < b                                                        (H3)
  let f : [a, b] → ℝ                                                  (H4)
  assume f is continuous on [a, b]                                    (H5)
  let x ∈ [a, b]                                                      (H6)
  then        ∫(a to x) f(t) dt ∈ ℝ
  metamath-proof metamath-bridges/calculus/gditgreres with A := a, B := b, F := f, C := x
  note        The integral of a real function continuous on [a, b], from a
              to a point of [a, b], is a real number: f is integrable there
              because it is continuous (cniccibl), and real where it is
              integrated.
  lean-proof  by (simp_all; done)

mundane theorem integral-point
  let a ∈ ℝ                                                           (H1)
  let f : X → ℝ                                                       (H2)
  then        ∫(a to a) f(t) dt = 0
  metamath-proof ditg0
  note        An integral from a point to itself is 0, whatever the
              integrand: set.mm's directed integral over [a, a] is the
              integral over the empty interval (a, a).
  lean-proof  by (simp_all; done)

theorem integral-difference
  let a ∈ ℝ                                                           (H1)
  let b ∈ ℝ                                                           (H2)
  assume a < b                                                        (H3)
  let f : [a, b] → ℝ                                                  (H4)
  let g : [a, b] → ℝ                                                  (H5)
  let h : [a, b] → ℝ                                                  (H6)
  assume for all x ∈ [a, b], h(x) = f(x) − g(x)                       (H7)
  assume f is continuous on [a, b]                                    (H8)
  assume g is continuous on [a, b]                                    (H9)
  then        ∫(a to b) h(t) dt = ∫(a to b) f(t) dt − ∫(a to b) g(t) dt
  metamath-proof metamath-bridges/calculus/gditgsubres with A := a, B := b, F := f, G := g
  note        The integral of a difference is the difference of the
              integrals. Each is integrable because it is continuous on
              [a, b] (cniccibl), so the page never says it.
  lean-proof  by rw [← intervalIntegral.integral_sub (h5.intervalIntegrable_of_Icc h3.le) (h6.intervalIntegrable_of_Icc h3.le)]; apply intervalIntegral.integral_congr; intro x hx; rw [Set.uIcc_of_le h3.le] at hx; exact h4 x hx

theorem integral-order
  let a ∈ ℝ                                                           (H1)
  let b ∈ ℝ                                                           (H2)
  assume a < b                                                        (H3)
  let f : [a, b] → ℝ                                                  (H4)
  let g : [a, b] → ℝ                                                  (H5)
  assume for all x ∈ [a, b], f(x) ≤ g(x)                              (H6)
  assume f is continuous on [a, b]                                    (H7)
  assume g is continuous on [a, b]                                    (H8)
  then        ∫(a to b) f(t) dt ≤ ∫(a to b) g(t) dt
  metamath-proof metamath-bridges/calculus/gditgleres with A := a, B := b, F := f, G := g
  note        A smaller function has the smaller integral. set.mm states it
              of the integral over (a, b), which the directed one is where
              a ≤ b (ditgpos).
  lean-proof  intervalIntegral.integral_mono_on h3.le (h5.intervalIntegrable_of_Icc h3.le) (h6.intervalIntegrable_of_Icc h3.le) h4

theorem integral-nonneg
  let a ∈ ℝ                                                           (H1)
  let b ∈ ℝ                                                           (H2)
  assume a < b                                                        (H3)
  let f : [a, b] → ℝ                                                  (H4)
  assume for all x ∈ [a, b], f(x) ≥ 0                                 (H5)
  assume f is continuous on [a, b]                                    (H6)
  then        ∫(a to b) f(t) dt ≥ 0
  metamath-proof metamath-bridges/calculus/gditgge0res with A := a, B := b, F := f
  note        A function that is never negative has an integral that is
              not negative.
  lean-proof  intervalIntegral.integral_nonneg h3.le h4

theorem cauchy-mean-value
  let D ⊆ ℝ                                                           (H1)
  let a ∈ ℝ                                                           (H2)
  let b ∈ ℝ                                                           (H3)
  assume a < b                                                        (H4)
  assume [a, b] ⊆ D                                                   (H5)
  let f : D → ℝ                                                       (H6)
  let g : D → ℝ                                                       (H7)
  assume f is continuous on [a, b]                                    (H8)
  assume g is continuous on [a, b]                                    (H9)
  assume f is differentiable on (a, b)                                (H10)
  assume g is differentiable on (a, b)                                (H11)
  then        there is c ∈ (a, b) with (f(b) − f(a))·g′(c) = (g(b) − g(a))·f′(c)
  metamath-proof stdlib/calculus/cauchy-mean-value
  lean-proof  exists_ratio_deriv_eq_ratio_slope g h4 h7 (fun x hx => (h9 x hx).2.differentiableWithinAt) f h6 (fun x hx => (h8 x hx).2.differentiableWithinAt)

theorem limit-at-most
  n ranges over ℕ
  let x : ℕ → ℝ                                                       (H1)
  let L ∈ ℝ                                                           (H2)
  assume x(n) → L as n → ∞                                            (H3)
  let B ∈ ℝ                                                           (H4)
  let N ∈ ℕ                                                           (H5)
  assume x(n) ≤ B for all n ≥ N                                       (H6)
  then        L ≤ B
  metamath-proof stdlib/calculus/limit-at-most
  lean-proof  le_of_tendsto h2 (Filter.eventually_atTop.2 ⟨N, fun n hn => h5 n (by omega) (by exact_mod_cast hn)⟩)

theorem limit-at-least
  n ranges over ℕ
  let x : ℕ → ℝ                                                       (H1)
  let L ∈ ℝ                                                           (H2)
  assume x(n) → L as n → ∞                                            (H3)
  let B ∈ ℝ                                                           (H4)
  let N ∈ ℕ                                                           (H5)
  assume B ≤ x(n) for all n ≥ N                                       (H6)
  then        B ≤ L
  metamath-proof stdlib/calculus/limit-at-least
  lean-proof  ge_of_tendsto h2 (Filter.eventually_atTop.2 ⟨N, fun n hn => h5 n (by omega) (by exact_mod_cast hn)⟩)

mundane theorem first-terms-bounded
  let x : ℕ → ℝ                                                       (H1)
  then        for all K ∈ ℕ, there is C ∈ ℝ with for all m ∈ {1, …, K}, |x(m)| ≤ C
  metamath-proof stdlib/calculus/first-terms-bounded
  lean-proof  fun K _ => ⟨∑ m ∈ Finset.Icc 1 (K : ℤ), |x m|, fun m hm => Finset.single_le_sum (f := fun m => |x m|) (fun i _ => abs_nonneg _) hm⟩

theorem convergent-abs-bounded
  let x : ℕ → ℝ                                                       (H1)
  let L ∈ ℝ                                                           (H2)
  assume x(n) → L as n → ∞                                            (H3)
  then        there exists B ∈ ℝ such that for all m ∈ ℕ, |x(m)| ≤ B
  metamath-proof stdlib/calculus/convergent-abs-bounded
  lean-proof  by obtain ⟨C, hC⟩ := isBounded_iff_forall_norm_le.1 (Metric.isBounded_range_of_tendsto _ h2); exact ⟨C, fun m _ => by simpa [Real.norm_eq_abs] using hC _ ⟨m, rfl⟩⟩

theorem convergent-bounded
  let x : ℕ → ℝ                                                       (H1)
  let L ∈ ℝ                                                           (H2)
  assume x(n) → L as n → ∞                                            (H3)
  then        there exists B ∈ ℝ such that for all m ∈ ℕ, x(m) ≤ B
  metamath-proof stdlib/calculus/convergent-bounded
  lean-proof  by obtain ⟨C, hC⟩ := isBounded_iff_forall_norm_le.1 (Metric.isBounded_range_of_tendsto _ h2); exact ⟨C, fun m _ => le_trans (le_abs_self _) (by simpa [Real.norm_eq_abs] using hC _ ⟨m, rfl⟩)⟩

mundane theorem increasing-terms
  let x : ℕ → ℝ                                                       (H1)
  assume for all n ∈ ℕ, x(n) ≤ x(n + 1)                               (H2)
  then        for all n ∈ ℕ, for all m ∈ ℕ, if m ≤ n then x(m) ≤ x(n)
  metamath-proof stdlib/calculus/increasing-terms
  lean-proof  stdlib/calculus/increasing-terms

theorem monotone-limit
  let x : ℕ → ℝ                                                       (H1)
  assume for all n ∈ ℕ, x(n) ≤ x(n + 1)                               (H2)
  let B ∈ ℝ                                                           (H3)
  assume for all n ∈ ℕ, x(n) ≤ B                                      (H4)
  then        there is L ∈ ℝ with x(n) → L as n → ∞
  metamath-proof stdlib/calculus/monotone-limit
  lean-proof  by have hmono : Monotone (fun n : ℕ => x ((n : ℤ) + 1)) := (monotone_nat_of_le_succ (fun n => by have h := h1 (n + 1) (by omega); push_cast at h; exact h)); have hbdd : BddAbove (Set.range fun n : ℕ => x ((n : ℤ) + 1)) := ⟨B, by rintro _ ⟨n, rfl⟩; have h := h3 (n + 1) (by omega); push_cast at h; exact h⟩; exact ⟨⨆ n : ℕ, x ((n : ℤ) + 1), (Filter.tendsto_add_atTop_iff_nat 1).1 (by simpa [Nat.cast_add, Nat.cast_one] using tendsto_atTop_ciSup hmono hbdd)⟩
