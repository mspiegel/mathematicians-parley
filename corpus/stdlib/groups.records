# Standard library: groups
#
# A group, its laws, its subgroups, and cosets.
#
# One record per item. A record begins at column 0 with its kind, axiom,
# theorem or definition, and its name; `mundane` before the kind marks an
# item a proof takes for granted. A proof imports each item it cites,
# `import <header> stdlib/groups/<name>`, where the header is the
# record's own before its name, as `mundane theorem` or `axiom`. Format is described in DATABASE.md.
#
# An item's statement is written in the theorem form of SYNTAX.md: let and
# assume lines with labels, then a `then` line. A group is let as
# `let G be a group with operation · and identity e`, and set.mm's structure
# beneath it is never written (`GRAMMAR.md`, the group introduction).
#
# Every item carries at least one of:
#   metamath-counterpart  a set.mm label or labels supply it
#   open        it is cited but unproved and unbridged
#
# Other fields: metamath-proof, lean-proof, note.


axiom group-closed
  let G be a group with operation · and identity e                    (H1)
  let a ∈ G                                                           (H2)
  let b ∈ G                                                           (H3)
  then        a·b ∈ G
  metamath-counterpart grpcl
  metamath-proof grpcl

axiom group-associative
  let G be a group with operation · and identity e                    (H1)
  let a ∈ G                                                           (H2)
  let b ∈ G                                                           (H3)
  let c ∈ G                                                           (H4)
  then        (a·b)·c = a·(b·c)
  metamath-counterpart grpass
  metamath-proof grpass

axiom group-identity
  let G be a group with operation · and identity e                    (H1)
  let a ∈ G                                                           (H2)
  then        a·e = a
  metamath-counterpart grprid
  metamath-proof grprid

axiom group-identity-closed
  let G be a group with operation · and identity e                    (H1)
  then        e ∈ G
  metamath-counterpart grpidcl
  metamath-proof grpidcl

axiom group-inverse
  let G be a group with operation · and identity e                    (H1)
  let a ∈ G                                                           (H2)
  then        a·a⁻¹ = e
  metamath-counterpart grprinv
  metamath-proof grprinv

axiom group-inverse-closed
  let G be a group with operation · and identity e                    (H1)
  let a ∈ G                                                           (H2)
  then        a⁻¹ ∈ G
  metamath-counterpart grpinvcl
  metamath-proof grpinvcl

theorem group-cancel
  let G be a group with operation · and identity e                    (H1)
  let a ∈ G                                                           (H2)
  let b ∈ G                                                           (H3)
  let g ∈ G                                                           (H4)
  assume g·a = g·b                                                    (H5)
  then        a = b
  metamath-counterpart grplcan
  metamath-proof grplcan

mundane theorem subgroup-within
  let G be a group with operation · and identity e                    (H1)
  assume H is a subgroup of G                                         (H2)
  then        H ⊆ G
  metamath-counterpart subgss
  metamath-proof subgss

mundane theorem subgroup-identity
  let G be a group with operation · and identity e                    (H1)
  assume H is a subgroup of G                                         (H2)
  then        e ∈ H
  metamath-counterpart subg0cl
  metamath-proof subg0cl

mundane theorem subgroup-closed
  let G be a group with operation · and identity e                    (H1)
  assume H is a subgroup of G                                         (H2)
  let a ∈ H                                                           (H3)
  let b ∈ H                                                           (H4)
  then        a·b ∈ H
  metamath-counterpart subgcl
  metamath-proof subgcl

mundane theorem subgroup-inverse
  let G be a group with operation · and identity e                    (H1)
  assume H is a subgroup of G                                         (H2)
  let a ∈ H                                                           (H3)
  then        a⁻¹ ∈ H
  metamath-counterpart subginvcl
  metamath-proof subginvcl

definition coset
  let G be a group with operation · and identity e                    (H1)
  assume H is a subgroup of G                                         (H2)
  let g ∈ G                                                           (H3)
  then        u ∈ gH ↔ there is h ∈ H with u = g·h
  metamath-counterpart lsmelvalx and rexsng, which this corpus proves together in
              elaboration/stdlib/proved.mm
  metamath-proof gelcoset
  note        gH is everything g combines with a member of H to give. set.mm
              writes it as the sum of two subsets, {g} and H, and a school
              reader writes gH.
