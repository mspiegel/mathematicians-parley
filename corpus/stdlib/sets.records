# Standard library: sets
#
# Subsets, sets built from a property, unions, differences and the power set.
#
# One record per item. A record begins at column 0 with its kind and name:
# axiom, theorem, mundane, definition or function. A proof imports each item
# it cites, `import <kind> stdlib/sets/<name>`, where the keyword is
# the item's kind. Format is described in DATABASE.md.
#
# An item's statement is written in the theorem form of SYNTAX.md: let and
# assume lines with labels, then a `then` line.
#
# Every item carries at least one of:
#   metamath    a set.mm label or labels supply it
#   open        it is cited but unproved and unbridged
#
# Other fields: target, note.


definition subset
  then        X ⊆ Y ↔ for all t ∈ X, t ∈ Y
  metamath    df-ss, ssel
  target      dfss3

definition set-builder
  let X be a set                                                      (H1)
  let P be a property of the elements of X                            (H2)
  then        u ∈ {t ∈ X : P(t)} ↔ u ∈ X and P(u)
  metamath    rabid, elrab
  target      rabid, elrab
  note        P(t) says the property holds of t. The line above says what P is
              a property of and never mentions t, because the braces are what
              introduce t: it does not exist until they open. See the
              `holds-of` notation for why this is not a function applied to an
              argument.

              The element is u and the braces bind t, as def:stdlib/functions/set-image writes
              them. Both were t until the conclusion check went in, and a
              statement that uses one letter for a free name and for the name
              the braces bind cannot be matched against a use of it: the free
              one binds to the element and the bound one then has to be the
              element too.

definition part-builder
  let X be a set                                                      (H1)
  let P be a property of the elements of 𝒫X                           (H2)
  then        u ∈ {t ⊆ X : P(t)} ↔ u ⊆ X and P(u)
  metamath    elrab over the power set, and elpw2g, which this corpus
              proves together in elaboration/stdlib/proved.mm
  target      gelrabpw
  note        The parts of X with a property: `def:stdlib/sets/set-builder`
              over 𝒫X, with being in 𝒫X said as being a part of X.

mundane set-builder-subset
  let X be a set                                                      (H1)
  let P be a property of the elements of X                            (H2)
  then        {t ∈ X : P(t)} ⊆ X
  metamath    ssrab2
  target      ssrab2

mundane subset-transitive
  assume X ⊆ Y                                                        (H1)
  assume Y ⊆ Z                                                        (H2)
  then        X ⊆ Z
  metamath    sstr
  target      sstr

definition powerset
  let A be a set                                                      (H1)
  then        S ∈ 𝒫A ↔ S ⊆ A
  metamath    elpw, elpwg
  target      elpwg

mundane powerset-empty
  then        𝒫∅ = {∅}
  metamath    pw0
  target      pw0

mundane difference-set
  let X be a set                                                      (H1)
  let a be an element                                                 (H2)
  then        X ∖ {a} is a set
  metamath    difexg
  target      difexg

mundane subset-of-difference
  let a be an element                                                 (H1)
  assume Y ⊆ X ∖ {a}                                                  (H2)
  then        a ∉ Y
  metamath    ssdifsn
  target      ssdifsn
  note        The half of `ssdifsn` the corpus wants. Being inside X ∖ {a}
              says two things at once, and this is the second of them.

mundane difference-of-union
  let a be an element                                                 (H1)
  then        (Y ∪ {a}) ∖ {a} = Y ∖ {a}
  metamath    difun2
  target      difun2

mundane difference-absent
  let a ∉ Y                                                           (H1)
  then        Y ∖ {a} = Y
  metamath    difsn
  target      difsn

mundane not-in-subset
  let a ∉ Z                                                           (H1)
  assume Y ⊆ Z                                                        (H2)
  then        a ∉ Y
  metamath    ssneld
  target      ssneld

mundane in-union-singleton
  let a be an element                                                 (H1)
  then        a ∈ Y ∪ {a}
  metamath    elun2, over the singleton snidg puts a in
  target      elun2

mundane disjoint-empty
  assume for all s ∈ Z, s ∉ Y                                         (H1)
  then        Y ∩ Z = ∅
  metamath    disjr
  target      disjr
  note        Two sets are disjoint when nothing in one is in the other, which
              is what a reader proves. set.mm says it twice, over the first set
              in `disj` and over the second in `disjr`, and the second is the
              one the subsets proof has: what it can run over is the part it
              built, not the part it split off.

mundane not-in-difference
  let X be a set                                                      (H1)
  let a be an element                                                 (H2)
  then        a ∉ X ∖ {a}
  metamath    neldifsn
  target      neldifsn
  note        Added because thm:proofs/subsets/add-element-bijection assumes the element it
              adds is not already there, and the subsets proof adds it back to
              X ∖ {a} without ever saying so.

mundane subset-antisymmetric
  assume X ⊆ Y                                                        (H1)
  assume Y ⊆ X                                                        (H2)
  then        X = Y
  metamath    eqss
  target      eqss

mundane union-subset
  assume X ⊆ Z                                                        (H1)
  assume Y ⊆ Z                                                        (H2)
  then        X ∪ Y ⊆ Z
  metamath    unss
  target      unss

mundane in-union-left
  assume u ∈ Y                                                        (H1)
  then        u ∈ Y ∪ Z
  metamath    elun1
  target      elun1

mundane in-union-right
  assume u ∈ Z                                                        (H1)
  then        u ∈ Y ∪ Z
  metamath    elun2
  target      elun2

mundane difference-subset
  then        X ∖ Y ⊆ X
  metamath    difss
  target      difss

mundane difference-shrinks
  assume Y ⊆ X                                                        (H1)
  then        Y ∖ Z ⊆ X ∖ Z
  metamath    ssdif
  target      ssdif

mundane subset-into-difference
  let a be an element                                                 (H1)
  assume Y ⊆ X                                                        (H2)
  assume a ∉ Y                                                        (H3)
  then        Y ⊆ X ∖ {a}
  metamath    ssdifsn
  target      ssdifsn
  note        The other half of `ssdifsn` from `mun:stdlib/sets/subset-of-difference`:
              inside X and without a is inside X ∖ {a}.

mundane remove-and-restore
  let a ∈ Y                                                           (H1)
  then        (Y ∖ {a}) ∪ {a} = Y
  metamath    difsnid
  target      difsnid

mundane singleton-subset
  let a ∈ X                                                           (H1)
  then        {a} ⊆ X
  metamath    snssi
  target      snssi

mundane powerset-monotone
  assume Y ⊆ X                                                        (H1)
  then        𝒫Y ⊆ 𝒫X
  metamath    sspw
  target      sspw

mundane intersection-member
  then        u ∈ Y ∩ Z ↔ u ∈ Y and u ∈ Z
  metamath    elin
  target      elin

mundane union-member
  then        u ∈ Y ∪ Z ↔ u ∈ Y or u ∈ Z
  metamath    elun
  target      elun

mundane remove-member
  let Y be a set                                                      (H1)
  let a be an element                                                 (H2)
  let u be an element                                                 (H3)
  then        u ∈ Y ∖ {a} ↔ u ∈ Y and u ≠ a
  metamath    eldifsn
  target      eldifsn

mundane intersection-commutes
  then        Y ∩ Z = Z ∩ Y
  metamath    incom
  target      incom

mundane union-commutes
  then        Y ∪ Z = Z ∪ Y
  metamath    uncom
  target      uncom

mundane intersection-self
  then        Y ∩ Y = Y
  metamath    inidm
  target      inidm

mundane union-self
  then        Y ∪ Y = Y
  metamath    unidm
  target      unidm

mundane union-empty
  then        Y ∪ ∅ = Y
  metamath    un0
  target      un0

mundane intersection-empty
  then        Y ∩ ∅ = ∅
  metamath    in0
  target      in0

mundane difference-self
  then        Y ∖ Y = ∅
  metamath    difid
  target      difid

mundane difference-empty
  then        Y ∖ ∅ = Y
  metamath    dif0
  target      dif0

mundane intersection-distributes
  then        X ∩ (Y ∪ Z) = (X ∩ Y) ∪ (X ∩ Z)
  metamath    indi
  target      indi

mundane subset-empty
  then        Y ⊆ ∅ ↔ Y = ∅
  metamath    ss0b
  target      ss0b

mundane difference-member
  then        u ∈ Y ∖ Z ↔ u ∈ Y and u ∉ Z
  metamath    eldif
  target      eldif

mundane in-subset
  assume X ⊆ Y                                                        (H1)
  assume u ∈ X                                                        (H2)
  then        u ∈ Y
  metamath    ssel2
  target      ssel2

mundane difference-reverses
  assume X ⊆ Y                                                        (H1)
  then        Z ∖ Y ⊆ Z ∖ X
  metamath    sscon
  target      sscon

mundane complement-swap
  assume X ⊆ Z                                                        (H1)
  assume Y ⊆ Z                                                        (H2)
  then        X ⊆ Z ∖ Y ↔ Y ⊆ Z ∖ X
  metamath    ssconb
  target      ssconb

mundane complement-swap-outside
  then        Z ∖ Y ⊆ X ↔ Z ∖ X ⊆ Y
  metamath    difcom
  target      difcom

mundane equal-subset
  assume X = Y                                                        (H1)
  then        X ⊆ Y
  metamath    eqimss
  target      eqimss

mundane disjoint-within
  assume X ⊆ Y                                                        (H1)
  assume Y ∩ Z = ∅                                                    (H2)
  then        X ∩ Z = ∅
  metamath    ssdisj
  target      ssdisj

mundane disjoint-member
  assume Y ∩ Z = ∅                                                    (H1)
  assume u ∈ Y                                                        (H2)
  then        u ∉ Z
  metamath    disjel
  target      disjel

mundane disjoint-difference
  then        Y ∩ (Z ∖ Y) = ∅
  metamath    disjdif
  target      disjdif

definition indexed-union
  then        u ∈ ⋃(X ∈ D) X ↔ there is X ∈ D with u ∈ X
  metamath    eliun
  target      eliun

mundane union-contains-member
  assume Y ∈ D                                                        (H1)
  then        Y ⊆ ⋃(X ∈ D) X
  metamath    ssiun2s
  target      ssiun2s with C := Y
  note        ssiun2 says it with one letter for the member and the union's
              index; ssiun2s keeps them apart, as the page does, and ties
              them by its hypothesis that the two sets agree where they are
              equal.

mundane union-within
  assume for all X ∈ D, X ⊆ Z                                         (H1)
  then        ⋃(X ∈ D) X ⊆ Z
  metamath    iunss
  target      iunss
