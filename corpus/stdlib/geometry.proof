import mundane theorem    stdlib/reasoning/or-left
import mundane theorem    stdlib/reasoning/or-right
import mundane theorem    stdlib/reasoning/disjunctive-syllogism
import mundane theorem    stdlib/reasoning/disjunctive-syllogism-left
import axiom              stdlib/numbers/trichotomy
import axiom              stdlib/reasoning/excluded-middle
import mundane theorem    stdlib/reasoning/modus-ponens
import mundane theorem    stdlib/numbers/multiply-cancel
import mundane theorem    stdlib/numbers/nonneg-or-neg
import mundane theorem    stdlib/numbers/factor-positive
import mundane theorem    stdlib/numbers/integer-step
import mundane theorem    stdlib/numbers/less-scaled
import mundane theorem    stdlib/trigonometry/pi-positive
import definition         stdlib/sets/pair

theorem vertical-angles
  note        Euclid I.15. Each of ∠AOB and ∠COD makes 180° with ∠BOC, since
              O is between A and C and between B and D.
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  let D be a point                                                    (H4)
  let O be a point                                                    (H5)
  assume O is between A and C                                         (H6)
  assume O is between B and D                                         (H7)
  assume A, O, B form a triangle                                      (H8)
  assume C, O, D form a triangle                                      (H9)
  then ∠AOB = ∠COD

1.  B, O, C form a triangle.
    mun:triangle-extension P := B, Q := O, R := A, S := C, from H6, H8

2.  ∠AOB + ∠BOC = 180°
    axi:supplementary-angles B := O, D := B, from H6, H8, 1

3.  ∠BOC + ∠COD = 180°
    axi:supplementary-angles A := B, B := O, C := D, D := C, from H7, H9, 1

4.  ∠AOB = ∠COD
    algebra, from 2, 3

theorem exterior-angle-greater
  note        Euclid I.16, which needs no parallels. Let M be the midpoint of
              AC and produce BM past M to E with ME = BM. The triangles AMB
              and CME agree in two sides and the angle between them, so
              ∠BAC = ∠ECA; and E is inside the exterior angle at C, so that
              angle is ∠ACE and more.
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  let D be a point                                                    (H4)
  assume A, B, C form a triangle                                      (H5)
  assume C is between B and D                                         (H6)
  assume A, C, D form a triangle                                      (H7)
  then ∠ACD > ∠BAC

1.  M ∈ 𝔼². M is the midpoint of AC.
    obtain M: mun:midpoint-exists B := C, from H5

2.  M is between A and C. |AM| = |MC|.
    def:midpoint, from 1

3.  M is between C and A.
    mun:between-symmetric R := M, S := A, T := C, from 2

4.  B, A, M form a triangle.
    mun:triangle-on-side P := B, Q := A, R := C, S := M, from H5, 2

5.  B, C, M form a triangle.
    mun:triangle-on-side P := B, Q := C, R := A, S := M, from H5, 3

6.  |BM| > 0
    axi:distance-positive P := B, Q := M, from 4

7.  E ∈ 𝔼². M is between B and E. |ME| = |BM|.
    obtain E: mun:segment-extension A := B, B := M, r := |BM|, from 4, 6

8.  C, M, E form a triangle.
    mun:triangle-extension P := C, Q := M, R := B, S := E, from 5, 7

9.  ∠AMB = ∠CME
    thm:vertical-angles O := M, D := E, from 2, 4, 7, 8

10. |MB| = |ME|
    restate 7

11. triangle AMB ≅ triangle CME
    axi:side-angle-side P := A, Q := M, R := B, P′ := C, Q′ := M, R′ := E,
      from 2, 4, 8, 9, 10

12. M ≠ A. M ≠ C.
    mun:between-apart R := M, S := A, T := C, from 2

13. E, M, A form a triangle.
    mun:triangle-extension P := E, Q := M, R := C, S := A, from 3, 8

14. ∠ACE = ∠ECA
    mun:angle-turned P := A, Q := C, R := E, from H5, 8, 13

15. ∠BAC = ∠ECA
    calculation
      ∠BAC = ∠CAB       mun:angle-turned P := B, Q := A, R := C, from H5
           = ∠MAB       mun:angle-along-segment P := A, Q := C, S := M, R := B, from H5, 2, 4
           = ∠BAM       mun:angle-turned P := M, Q := A, R := B, from 4
           = ∠ECM       def:congruent, from 4, 8, 11
           = ∠MCE       mun:angle-turned P := E, Q := C, R := M, from 8
           = ∠ACE       mun:angle-along-segment P := C, Q := A, S := M, R := E, from 3, 8, 13
           = ∠ECA       14

16. B is not on line CA
    mun:triangle-not-on-line P := B, Q := C, R := A, from H5

17. C, M, A are collinear.
    mun:between-collinear R := M, S := A, T := C, from 2

18. M is on line CA.
    def:on-line P := M, A := C, B := A, from 17

19. C is on line CA.
    mun:on-line-ends A := C, B := A

20. B and E are on opposite sides of line CA.
    mun:segment-across-line A := C, B := A, P := B, Q := E,
      from H5, 7, 16, 18

21. B and D are on opposite sides of line CA.
    mun:segment-across-line A := C, B := A, P := B, Q := D, M := C,
      from H5, H6, 16, 19

22. E and B are on opposite sides of line CA.
    mun:opposite-sides-turned A := C, B := A, P := B, Q := E, from 20

23. E and D are on the same side of line CA.
    mun:opposite-opposite-same A := C, B := A, P := E, Q := B, R := D,
      from 21, 22

24. A, C, D form a triangle.
    mun:triangle-extension P := A, Q := C, R := B, S := D, from H5, H6

25. A is not on line CD
    mun:triangle-not-on-line P := A, Q := C, R := D, from 24

26. C is on line CD.
    mun:on-line-ends A := C, B := D

27. M and A are on the same side of line CD.
    mun:segment-off-line A := C, B := D, P := A, Q := C, X := M,
      from 2, 24, 25, 26

28. M is not on line CD
    mun:same-side-off-line A := C, B := D, P := M, Q := A, from 27

29. D, C, B are collinear.
    mun:between-collinear R := C, S := B, T := D, from H6

30. B is on line CD.
    def:on-line P := B, A := C, B := D, from 29

31. M is between E and B.
    mun:between-symmetric R := M, S := B, T := E, from 7

32. E and M are on the same side of line CD.
    mun:segment-beyond-off-line A := C, B := D, P := E, Q := B, X := M,
      from 24, 28, 30, 31

33. E and A are on the same side of line CD.
    mun:same-side-same A := C, B := D, P := E, Q := M, R := A, from 27, 32

34. E is not on line CD
    mun:same-side-off-line A := C, B := D, P := E, Q := A, from 33

35. E, C, D form a triangle.
    mun:triangle-off-line P := E, Q := C, R := D, from 24, 34

36. ∠ACE + ∠ECD = ∠ACD
    axi:angle-addition-inside A := C, B := A, C := D, D := E,
      from 23, 24, 33

37. ∠ECD > 0°. ∠ECD < 180°.
    axi:angle-measure P := E, Q := C, R := D, from 35

38. ∠ACE + ∠ECD > ∠ACE
    inequalities
      ∠ECD > 0°                       37
      ∠ACE + ∠ECD > ∠ACE + 0°         adding ∠ACE
      ∠ACE + ∠ECD > ∠ACE              algebra

39. ∠ACD = ∠ACE + ∠ECD
    restate 36

40. ∠ECA = ∠BAC
    restate 15

41. ∠ACD > ∠BAC
    calculation
      ∠ACD = ∠ACE + ∠ECD       39
           > ∠ACE              38
           = ∠ECA              14
           = ∠BAC              40

theorem exterior-angle-greater-other
  note        Euclid I.16, the other remote angle. Produce AC past C to E:
              the angle BCE is the exterior angle at C read from the other
              side, and equals ∠ACD (vertical-angles).
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  let D be a point                                                    (H4)
  assume A, B, C form a triangle                                      (H5)
  assume C is between B and D                                         (H6)
  assume A, C, D form a triangle                                      (H7)
  then ∠ACD > ∠ABC

1.  |AC| > 0
    axi:distance-positive P := A, Q := C, from H5

2.  E ∈ 𝔼². C is between A and E. |CE| = |AC|.
    obtain E: mun:segment-extension B := C, r := |AC|, from H5, 1

3.  C is between E and A
    mun:between-symmetric R := C, S := A, T := E, from 2

4.  ∠ACD > ∠ABC
    calculation
      ∠ACD = ∠DCA       mun:angle-turned P := D, Q := C, R := A, from H7
           = ∠BCE       thm:vertical-angles A := B, B := E, C := D, D := A, O := C, from H6, H7, 3
           > ∠ABC       thm:exterior-angle-greater A := B, B := A, D := E, from H5, 2
    requires B, C, E form a triangle: mun:triangle-extension P := B, Q := C, R := A, S := E, from H5, 2

theorem isosceles-angles
  note        Euclid I.5. Read the triangle as ACB and as BCA. Two sides and
              the angle between them agree, |CA| = |CB| and the angle at C,
              so the two are congruent and the angles at A and at B match.
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  assume A, B, C form a triangle                                      (H4)
  assume |CA| = |CB|                                                  (H5)
  then ∠CAB = ∠CBA

1.  ∠ACB = ∠BCA
    mun:angle-symmetric P := A, Q := C, R := B, from H4

2.  triangle ACB ≅ triangle BCA
    axi:side-angle-side P := A, Q := C, R := B, P′ := B, Q′ := C, R′ := A,
      from H4, H5, 1

3.  ∠CAB = ∠CBA
    calculation
      ∠CAB = ∠BAC       mun:angle-symmetric P := C, Q := A, R := B, from H4
           = ∠ABC       def:congruent, from H4, 2
           = ∠CBA       mun:angle-symmetric P := A, Q := B, R := C, from H4

theorem greater-side-greater-angle
  note        Euclid I.18. Lay off AB along AC to D. The triangle ABD is
              isosceles, so ∠ABD = ∠ADB; ∠ABC is ∠ABD and more, since D is
              inside it; and ∠ADB, outside the triangle BCD at D, is greater
              than the angle at C.
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  assume A, B, C form a triangle                                      (H4)
  assume |AC| > |AB|                                                  (H5)
  then ∠ABC > ∠ACB

1.  |AB| > 0
    axi:distance-positive P := A, Q := B, from H4

2.  D ∈ 𝔼². D is between A and C. |AD| = |AB|.
    obtain D: mun:segment-point B := C, r := |AB|, from H5, 1

3.  D is between C and A
    mun:between-symmetric R := D, S := A, T := C, from 2

4.  B, A, D form a triangle.
    mun:triangle-on-side P := B, Q := A, R := C, S := D, from H4, 2

5.  B, C, D form a triangle.
    mun:triangle-on-side P := B, Q := C, R := A, S := D, from H4, 3

6.  |AB| = |AD|
    restate 2

7.  C is not on line BA
    mun:triangle-not-on-line P := C, Q := B, R := A, from H4

8.  A is on line BA
    mun:on-line-ends A := B, B := A

9.  D and C are on the same side of line BA
    mun:segment-off-line A := B, B := A, P := C, Q := A, X := D,
      from H4, 3, 7, 8

10. A is not on line BC
    mun:triangle-not-on-line P := A, Q := B, R := C, from H4

11. C is on line BC
    mun:on-line-ends A := B, B := C

12. D and A are on the same side of line BC
    mun:segment-off-line A := B, B := C, P := A, Q := C, X := D,
      from H4, 2, 10, 11

13. ∠ABD + ∠DBC = ∠ABC
    axi:angle-addition-inside A := B, B := A, from H4, 9, 12

14. ∠DBC > 0°. ∠DBC < 180°.
    axi:angle-measure P := D, Q := B, R := C, from 5

15. A ≠ D. C ≠ D.
    mun:between-apart R := D, S := A, T := C, from 2

16. ∠ABD + ∠DBC > ∠ABD
    inequalities
      ∠DBC > 0°                       14
      ∠ABD + ∠DBC > ∠ABD + 0°         adding ∠ABD
      ∠ABD + ∠DBC > ∠ABD              algebra

17. ∠BDA > ∠BCD
    thm:exterior-angle-greater-other A := B, B := C, C := D, D := A,
      from 3, 5
    requires B, D, A form a triangle: mun:triangle-extension P := B, Q := D, R := C, S := A, from 3, 5

18. ∠ABC = ∠ABD + ∠DBC
    restate 13

19. ∠ABC > ∠ACB
    calculation
      ∠ABC = ∠ABD + ∠DBC       18
           > ∠ABD              16
           = ∠ADB              thm:isosceles-angles A := B, B := D, C := A, from 4, 6
           = ∠BDA              mun:angle-turned P := A, Q := D, R := B, from H4, 5, 15
           > ∠BCD              17
           = ∠DCB              mun:angle-turned P := B, Q := C, R := D, from 5
           = ∠ACB              mun:angle-along-segment P := C, Q := A, S := D, R := B, from H4, 3, 5

theorem alternate-angles-converse
  note        Euclid I.27. Were line RS and line PQ to meet at X, RPX would be
              a triangle with one of the two equal angles outside it at one
              vertex and the other inside it at another, and the outside one
              is the greater (exterior-angle-greater).
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  let S be a point                                                    (H4)
  assume P, Q, R form a triangle                                      (H5)
  assume S and Q are on opposite sides of line RP                     (H6)
  assume ∠SRP = ∠RPQ                                                  (H7)
  then line RS ∥ line PQ

1.  R ≠ P. S is not on line RP. Q is not on line RP.
    mun:opposite-sides-off-line A := R, B := P, P := S, from H6

2.  S ≠ R. S ≠ P.
    mun:off-line-apart A := R, B := P, P := S, from 1

3.  R is not on line PQ
    mun:triangle-not-on-line P := R, Q := P, R := Q, from H5

4.  not (there is X ∈ 𝔼² with X is on line RS and X is on line PQ)
    contradiction
    suppose there is X ∈ 𝔼² with X is on line RS and X is on line PQ  (S1)

    4.1.  there is X ∈ 𝔼² with X is on line RS and X is on line PQ
          restate S1

    4.2.  X ∈ 𝔼². X is on line RS. X is on line PQ.
          obtain X from line 4.1

    4.3.  X ≠ R
          mun:on-off-apart A := P, B := Q, Y := R, from 3, 4.2

    4.4.  X is not on line RP
          mun:off-line-through, from 1, 4.2, 4.3

    4.5.  X ≠ R. X ≠ P.
          mun:off-line-apart A := R, B := P, P := X, from 4.4

    4.6.  R is on line RP. P is on line RP.
          mun:on-line-ends A := R, B := P

    4.7.  Q and S are on opposite sides of line RP
          mun:opposite-sides-turned A := R, B := P, P := S, from H6

    4.8.  X and Q are on the same side of line RP or X and Q are on
          opposite sides of line RP
          axi:plane-separation A := R, B := P, P := X, from 1, 4.4

    4.9.  ∠SRP ≠ ∠RPQ
          cases, from 4.8

          case
          assume X and Q are on the same side of line RP              (C1)

          4.9.1.  X and S are on opposite sides of line RP
                  mun:same-opposite-opposite A := R, B := P, P := X, R := S,
                    from C1, 4.7

          4.9.2.  S and X are on opposite sides of line RP
                  mun:opposite-sides-turned A := R, B := P, P := X, Q := S,
                    from 4.9.1

          4.9.3.  R is between S and X
                  mun:line-crossing-between, from 4.2, 4.9.2

          4.9.4.  R is between X and S
                  mun:between-symmetric T := X, from 4.9.3

          4.9.5.  X, R, P form a triangle.
                  mun:triangle-off-line P := X, Q := R, R := P, from H5, 4.4

          4.9.6.  ∠PRS > ∠XPR
                  thm:exterior-angle-greater A := P, B := X, C := R, D := S,
                    from 4.9.4, 4.9.5
                  requires P, R, S form a triangle: mun:triangle-extension Q := R, R := X, from 4.9.4, 4.9.5

          4.9.7.  X and Q are on the same side of line PR
                  mun:same-side-of-line A := R, B := P, C := P, D := R,
                    P := X, from C1, H5, 4.6

          4.9.8.  ∠SRP > ∠RPQ
                  calculation
                    ∠SRP = ∠PRS       mun:angle-turned P := S, Q := R, R := P, from H5, 2
                         > ∠XPR       4.9.6
                         = ∠RPX       mun:angle-turned P := X, Q := P, from H5, 4.5
                         = ∠RPQ       mun:angle-same-ray, from 4.2, 4.9.7

          4.9.9.  ∠SRP ≠ ∠RPQ
                  inequalities
                    ∠SRP > ∠RPQ       4.9.8
                    ∠SRP ≠ ∠RPQ       weakening

          case
          assume X and Q are on opposite sides of line RP             (C2)

          4.9.10. X and S are on the same side of line RP
                  mun:opposite-opposite-same A := R, B := P, P := X, R := S,
                    from C2, 4.7

          4.9.11. Q and X are on opposite sides of line RP
                  mun:opposite-sides-turned A := R, B := P, P := X, from C2

          4.9.12. Q and X are on opposite sides of line PR
                  mun:opposite-sides-of-line A := R, B := P, C := P, D := R,
                    P := Q, Q := X, from H5, 4.6, 4.9.11

          4.9.13. P is between Q and X
                  mun:line-crossing-between R := P, P := R, S := Q,
                    from 4.2, 4.9.12

          4.9.14. P is between X and Q
                  mun:between-symmetric R := P, S := Q, T := X, from 4.9.13

          4.9.15. R, X, P form a triangle.
                  mun:triangle-off-line P := X, Q := R, R := P, from H5, 4.4

          4.9.16. ∠RPQ > ∠XRP
                  thm:exterior-angle-greater A := R, B := X, C := P, D := Q,
                    from 4.9.14, 4.9.15
                  requires R, P, Q form a triangle: mun:triangle-extension P := R, Q := P, R := X, S := Q, from 4.9.14, 4.9.15

          4.9.17. ∠RPQ > ∠SRP
                  calculation
                    ∠RPQ > ∠XRP       4.9.16
                         = ∠PRX       mun:angle-turned P := X, Q := R, R := P, from H5, 4.5
                         = ∠PRS       mun:angle-same-ray R := P, P := R, Q := S, from 4.2, 4.9.10
                         = ∠SRP       mun:angle-turned Q := R, R := S, from H5, 2

          4.9.18. ∠SRP ≠ ∠RPQ
                  inequalities
                    ∠RPQ > ∠SRP       4.9.17
                    ∠SRP < ∠RPQ       restate
                    ∠SRP ≠ ∠RPQ       weakening

    4.10. ∠SRP ≠ ∠RPQ
          inequalities, from 4.9, contradicting H7

5.  line RS = line PQ or not (there is X ∈ 𝔼² with X is on line RS and
    X is on line PQ)
    mun:or-right, from 4

6.  line RS ∥ line PQ
    def:parallel A := R, B := S, C := P, D := Q, from H5, 2, 5

theorem alternate-angles
  note        Euclid I.29. The line RP crosses the two parallels RS and PQ,
              and the angles it makes with them on opposite sides are equal.
              Copy the angle at P to R on S's side: the line it gives is
              parallel to PQ (alternate-angles-converse), so by the parallel
              postulate it is line RS, and S is on its ray.
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  let S be a point                                                    (H4)
  assume P, Q, R form a triangle                                      (H5)
  assume line RS ∥ line PQ                                            (H6)
  assume S and Q are on opposite sides of line RP                     (H7)
  then ∠SRP = ∠RPQ

1.  S is not on line RP
    mun:opposite-sides-off-line A := R, B := P, P := S, from H7

2.  S ≠ R. S ≠ P.
    mun:off-line-apart A := R, B := P, P := S, from 1

3.  S, R, P form a triangle.
    mun:triangle-off-line P := S, Q := R, R := P, from H5, 1

4.  ∠RPQ > 0°. ∠RPQ < 180°.
    axi:angle-measure P := R, Q := P, R := Q, from H5

5.  T ∈ 𝔼². T and S are on the same side of line RP. ∠PRT = ∠RPQ.
    obtain T: axi:angle-construction A := R, B := P, C := S, x := ∠RPQ,
      from 3, 4

6.  T and Q are on opposite sides of line RP
    mun:same-opposite-opposite A := R, B := P, P := T, Q := S, R := Q,
      from H7, 5

7.  T is not on line RP
    mun:opposite-sides-off-line A := R, B := P, P := T, from 6

8.  T ≠ R. T ≠ P.
    mun:off-line-apart A := R, B := P, P := T, from 7

9.  ∠TRP = ∠RPQ
    calculation
      ∠TRP = ∠PRT       mun:angle-turned P := T, Q := R, R := P, from H5, 8
           = ∠RPQ       5

10. line RT ∥ line PQ
    thm:alternate-angles-converse S := T, from H5, 6, 9

11. R is not on line PQ
    mun:triangle-not-on-line P := R, Q := P, R := Q, from H5

12. line RS = line RT
    axi:parallel-uniqueness A := P, B := Q, P := R, C := S, D := T,
      from H5, H6, 2, 8, 10, 11

13. T is on line RT
    mun:on-line-ends A := R, B := T

14. T is on line RS
    substitute line RS = line RT (line 12) into line 13

15. ∠SRP = ∠RPQ
    calculation
      ∠SRP = ∠PRS       mun:angle-turned P := S, Q := R, R := P, from H5, 2
           = ∠PRT       mun:angle-same-ray R := P, P := R, Q := S, X := T, from 5, 14
           = ∠RPQ       5

theorem angles-on-a-line
  note        The three angles at R between S, P, Q and T, in that order,
              make up the straight line ST. ∠SRQ and ∠QRT are a linear pair,
              and P is inside ∠SRQ, so ∠SRQ is ∠SRP and ∠PRQ: H7 puts P and Q
              on one side of line RS, and the segment SQ crosses line RP on
              P's side of it, which puts P on S's side of line RQ.
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  let S be a point                                                    (H4)
  let T be a point                                                    (H5)
  assume R is between S and T                                         (H6)
  assume P and Q are on the same side of line RS                      (H7)
  assume S and Q are on opposite sides of line RP                     (H8)
  assume Q, R, T form a triangle                                      (H9)
  then ∠SRP + ∠PRQ + ∠TRQ = 180°

1.  R ≠ S. P is not on line RS. Q is not on line RS.
    mun:same-side-off-line A := R, B := S, from H7

2.  R ≠ P. S is not on line RP. Q is not on line RP.
    mun:opposite-sides-off-line A := R, B := P, P := S, from H8

3.  Q ≠ R. Q ≠ S.
    mun:off-line-apart A := R, B := S, P := Q, from 1

4.  Q, R, S form a triangle.
    mun:triangle-off-line P := Q, Q := R, R := S, from 1

5.  ∠SRQ + ∠QRT = 180°
    axi:supplementary-angles A := S, B := R, C := T, D := Q, from H6, H9, 3

6.  X ∈ 𝔼². X is on line RP. X is between S and Q.
    obtain X: axi:plane-separation-crossing A := R, B := P, P := S,
      from H8, 2

7.  S is on line RS
    mun:on-line-ends A := R, B := S

8.  X is between Q and S
    mun:between-symmetric R := X, T := Q, from 6

9.  X and Q are on the same side of line RS
    mun:segment-off-line A := R, B := S, P := Q, Q := S, from 1, 7, 8

10. Q and P are on the same side of line RS
    mun:same-side-turned A := R, B := S, from H7

11. X and P are on the same side of line RS
    mun:same-side-same A := R, B := S, P := X, R := P, from 9, 10

12. P is not on line RQ
    mun:off-line-swap, from 2

13. X and P are on the same side of line RQ
    mun:ray-side-transfer, from 6, 11, 12

14. Q is on line RQ
    mun:on-line-ends A := R, B := Q

15. S is not on line RQ
    mun:off-line-swap P := S, from 1

16. X and S are on the same side of line RQ
    mun:segment-off-line A := R, B := Q, P := S, from 3, 6, 14, 15

17. P and X are on the same side of line RQ
    mun:same-side-turned A := R, B := Q, P := X, Q := P, from 13

18. P and S are on the same side of line RQ
    mun:same-side-same A := R, B := Q, Q := X, R := S, from 16, 17

19. ∠SRP + ∠PRQ = ∠SRQ
    axi:angle-addition-inside A := R, B := S, C := Q, D := P, from H7, 4, 18

20. ∠TRQ = ∠QRT
    mun:angle-turned P := T, Q := R, R := Q, from H9

21. ∠SRP + ∠PRQ + ∠TRQ = 180°
    algebra, from 5, 19, 20

theorem parallel-through
  note        The line through R parallel to PQ, with a point on it each side
              of R: D on P's side and E on Q's. Produce QR past R to Q′, and
              copy the angle at P to R on Q′'s side of line RP: the line it
              gives is parallel to PQ (alternate-angles-converse). What a
              figure shows of that line is written out.
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  assume P, Q, R form a triangle                                      (H4)
  then there are D, E ∈ 𝔼² with line RD ∥ line PQ, line RE ∥ line QP, (R is between D and E), D and Q are on opposite sides of line RP, E and P are on opposite sides of line RQ, and P and Q are on the same side of line RD

1.  |QR| > 0
    axi:distance-positive P := Q, Q := R, from H4

2.  Q′ ∈ 𝔼². R is between Q and Q′. |RQ′| = |QR|.
    obtain Q′: mun:segment-extension A := Q, B := R, r := |QR|, from H4, 1

3.  Q is not on line RP
    mun:triangle-not-on-line P := Q, Q := R, R := P, from H4

4.  R is on line RP. P is on line RP.
    mun:on-line-ends A := R, B := P

5.  Q and Q′ are on opposite sides of line RP
    mun:segment-across-line A := R, B := P, P := Q, Q := Q′, M := R,
      from H4, 2, 3, 4

6.  Q′ is not on line RP
    mun:opposite-sides-off-line A := R, B := P, P := Q, Q := Q′, from 5

7.  Q′, R, P form a triangle.
    mun:triangle-off-line P := Q′, Q := R, R := P, from H4, 6

8.  ∠RPQ > 0°. ∠RPQ < 180°.
    axi:angle-measure P := R, Q := P, R := Q, from H4

9.  D ∈ 𝔼². D and Q′ are on the same side of line RP. ∠PRD = ∠RPQ.
    obtain D: axi:angle-construction A := R, B := P, C := Q′, x := ∠RPQ,
      from 7, 8

10. Q′ and Q are on opposite sides of line RP
    mun:opposite-sides-turned A := R, B := P, P := Q, Q := Q′, from 5

11. D and Q are on opposite sides of line RP
    mun:same-opposite-opposite A := R, B := P, P := D, Q := Q′, R := Q,
      from 9, 10

12. D is not on line RP
    mun:opposite-sides-off-line A := R, B := P, P := D, from 11

13. D ≠ R. D ≠ P.
    mun:off-line-apart A := R, B := P, P := D, from 12

14. ∠DRP = ∠RPQ
    calculation
      ∠DRP = ∠PRD       mun:angle-turned P := D, Q := R, R := P, from H4, 13
           = ∠RPQ       9

15. line RD ∥ line PQ
    thm:alternate-angles-converse S := D, from H4, 11, 14

16. |DR| > 0
    axi:distance-positive P := D, Q := R, from 13

17. E ∈ 𝔼². R is between D and E. |RE| = |DR|.
    obtain E: mun:segment-extension A := D, B := R, r := |DR|, from 13, 16

18. E, R, D are collinear.
    mun:between-collinear S := D, T := E, from 17

19. E is on line RD
    def:on-line P := E, A := R, B := D, from 18

20. D ≠ R. E ≠ R.
    mun:between-apart S := D, T := E, from 17

21. line RE ∥ line QP
    mun:parallel-along A := R, B := D, C := P, D := Q, from 15, 19, 20

22. R is not on line PQ
    mun:triangle-not-on-line P := R, Q := P, R := Q, from H4

23. line RD = line PQ or not (there is X ∈ 𝔼² with X is on line RD and
    X is on line PQ)
    def:parallel A := R, B := D, C := P, D := Q, from H4, 13, 15

24. R is on line RD
    mun:on-line-ends A := R, B := D

25. not (line RD = line PQ)
    contradiction
    suppose line RD = line PQ                                         (S1)

    25.1. R is on line PQ
          substitute line RD = line PQ (S1) into line 24, contradicting 22

26. not (there is X ∈ 𝔼² with X is on line RD and X is on line PQ)
    mun:disjunctive-syllogism-left, from 23, 25

27. P is on line PQ. Q is on line PQ.
    mun:on-line-ends A := P, B := Q

28. P is not on line RD
    contradiction
    suppose P is on line RD                                           (S2)

    28.1. there is X ∈ 𝔼² with X is on line RD and X is on line PQ
          exhibit, from S2, 27, contradicting 26

29. Q is not on line RD
    contradiction
    suppose Q is on line RD                                           (S3)

    29.1. there is X ∈ 𝔼² with X is on line RD and X is on line PQ
          exhibit, from S3, 27, contradicting 26

30. P and Q are on the same side of line RD or P and Q are on opposite
    sides of line RD
    axi:plane-separation A := R, B := D, from 13, 28, 29

31. not (P and Q are on opposite sides of line RD)
    contradiction
    suppose P and Q are on opposite sides of line RD                  (S4)

    31.1. X ∈ 𝔼². X is on line RD. X is between P and Q.
          obtain X: axi:plane-separation-crossing A := R, B := D, from S4, 13

    31.2. Q, X, P are collinear.
          mun:between-collinear R := X, S := P, T := Q, from 31.1

    31.3. X is on line PQ
          def:on-line P := X, A := P, B := Q, from 31.2

    31.4. there is X ∈ 𝔼² with X is on line RD and X is on line PQ
          exhibit, from 31.1, 31.3, contradicting 26

32. P and Q are on the same side of line RD
    mun:disjunctive-syllogism, from 30, 31

33. Q and Q′ are on opposite sides of line RD
    mun:segment-across-line A := R, B := D, P := Q, Q := Q′, M := R,
      from 2, 13, 24, 29

34. P and Q′ are on opposite sides of line RD
    mun:same-opposite-opposite A := R, B := D, R := Q′,
      from 32, 33

35. Q′ is not on line RD
    mun:opposite-sides-off-line A := R, B := D, Q := Q′, from 34

36. D is not on line RQ′
    mun:off-line-swap P := D, Q := Q′, from 35

37. Y ∈ 𝔼². Y is on line RD. Y is between P and Q′.
    obtain Y: axi:plane-separation-crossing A := R, B := D, Q := Q′,
      from 13, 34

38. Y is between Q′ and P
    mun:between-symmetric R := Y, S := P, T := Q′, from 37

39. Y and Q′ are on the same side of line RP
    mun:segment-off-line A := R, B := P, P := Q′, Q := P, X := Y,
      from H4, 4, 6, 38

40. Q′ and D are on the same side of line RP
    mun:same-side-turned A := R, B := P, P := D, Q := Q′, from 9

41. Y and D are on the same side of line RP
    mun:same-side-same A := R, B := P, P := Y, Q := Q′, R := D, from 39, 40

42. Y and D are on the same side of line RQ′
    mun:ray-side-transfer P := D, S := P, Q := Q′, X := Y,
      from 36, 37, 41

43. Q ≠ R. Q′ ≠ R.
    mun:between-apart S := Q, T := Q′, from 2

44. R is on line RQ′. Q′ is on line RQ′.
    mun:on-line-ends A := R, B := Q′

45. P is not on line RQ′
    mun:off-line-swap Q := Q′, from 6

46. Y and P are on the same side of line RQ′
    mun:segment-off-line A := R, B := Q′, Q := Q′, X := Y,
      from 37, 43, 44, 45

47. D and Y are on the same side of line RQ′
    mun:same-side-turned A := R, B := Q′, P := Y, Q := D, from 42

48. D and P are on the same side of line RQ′
    mun:same-side-same A := R, B := Q′, P := D, Q := Y, R := P, from 46, 47

49. D and E are on opposite sides of line RQ′
    mun:segment-across-line A := R, B := Q′, P := D, Q := E, M := R,
      from 17, 36, 43, 44

50. P and D are on the same side of line RQ′
    mun:same-side-turned A := R, B := Q′, P := D, Q := P, from 48

51. P and E are on opposite sides of line RQ′
    mun:same-opposite-opposite A := R, B := Q′, Q := D, R := E,
      from 49, 50

52. Q′, R, Q are collinear.
    mun:between-collinear S := Q, T := Q′, from 2

53. Q is on line RQ′
    def:on-line P := Q, A := R, B := Q′, from 52

54. P and E are on opposite sides of line RQ
    mun:opposite-sides-of-line A := R, B := Q′, C := R, D := Q, Q := E,
      from 43, 44, 51, 53

55. E and P are on opposite sides of line RQ
    mun:opposite-sides-turned A := R, B := Q, Q := E, from 54

56. there are D, E ∈ 𝔼² with line RD ∥ line PQ, line RE ∥ line QP,
    (R is between D and E), D and Q are on opposite sides of line RP, E and P are
    on opposite sides of line RQ, and P and Q are on the same side of
    line RD
    exhibit, from 11, 15, 17, 21, 32, 55

theorem greater-angle-greater-side
  note        Euclid I.19. Were |AC| = |AB| the angles at B and at C would be
              equal (isosceles-angles), and were |AC| < |AB| the angle at C
              would be the greater (greater-side-greater-angle).
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  assume A, B, C form a triangle                                      (H4)
  assume ∠ABC > ∠ACB                                                  (H5)
  then |AC| > |AB|

1.  |AC| − |AB| < 0 or |AC| − |AB| = 0 or 0 < |AC| − |AB|
    axi:trichotomy x := |AC| − |AB|

2.  |AC| > |AB|
    cases, from 1

    case
    assume |AC| − |AB| < 0                                            (C1)

    2.1.  |AB| > |AC|
          inequalities
            |AC| − |AB| < 0   C1
            |AC| < |AB|       adding |AB|
            |AB| > |AC|       restate

    2.2.  ∠ACB > ∠ABC
          thm:greater-side-greater-angle B := C, C := B, from H4, 2.1

    2.3.  ∠ABC ≤ ∠ACB
          inequalities
            ∠ACB > ∠ABC       2.2
            ∠ABC < ∠ACB       restate
            ∠ABC ≤ ∠ACB       weakening

    2.4.  not (∠ABC > ∠ACB)
          inequalities, from 2.3, contradicting H5

    case
    assume |AC| − |AB| = 0                                            (C2)

    2.5.  |AB| = |AC|
          algebra, from C2

    2.6.  ∠ABC = ∠ACB
          thm:isosceles-angles A := B, B := C, C := A, from H4, 2.5

    2.7.  ∠ABC ≤ ∠ACB
          inequalities
            ∠ABC = ∠ACB       2.6
            ∠ABC ≤ ∠ACB       weakening

    2.8.  not (∠ABC > ∠ACB)
          inequalities, from 2.7, contradicting H5

    case
    assume 0 < |AC| − |AB|                                            (C3)

    2.9.  |AC| > |AB|
          inequalities
            0 < |AC| − |AB|   C3
            |AB| < |AC|       adding |AB|
            |AC| > |AB|       restate

theorem triangle-inequality-strict
  note        Euclid I.20. Produce PQ past Q to D with |QD| = |QR|. The
              triangle QRD is isosceles, so ∠QRD = ∠QDR; Q is inside the
              angle PRD, so ∠PRD is ∠QRD and more; so in the triangle PRD
              the side PD, opposite the greater angle, is the longer
              (greater-angle-greater-side), and |PD| = |PQ| + |QR|.
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  assume P, Q, R form a triangle                                      (H4)
  then |PR| < |PQ| + |QR|

1.  |QR| > 0
    axi:distance-positive P := Q, Q := R, from H4

2.  D ∈ 𝔼². Q is between P and D. |QD| = |QR|.
    obtain D: mun:segment-extension A := P, B := Q, r := |QR|, from H4, 1

3.  |QR| = |QD|
    restate 2

4.  R, Q, D form a triangle.
    mun:triangle-extension P := R, R := P, S := D, from H4, 2

5.  Q is not on line PR
    mun:triangle-not-on-line P := Q, Q := P, from H4

6.  D, Q, P are collinear.
    mun:between-collinear R := Q, S := P, T := D, from 2

7.  D is on line PQ
    def:on-line P := D, A := P, B := Q, from 6

8.  P ≠ D
    mun:between-ends-apart R := Q, S := P, T := D, from 2

9.  D is not on line PR
    mun:off-line-through R := P, P := R, S := Q, X := D, from 5, 7, 8

10. D, P, R form a triangle.
    mun:triangle-off-line P := D, Q := P, from H4, 9

11. ∠PRQ + ∠QRD = ∠PRD
    mun:angle-addition A := P, B := D, C := R, M := Q, from H4, 2, 10

12. ∠PRQ > 0°. ∠PRQ < 180°.
    axi:angle-measure Q := R, R := Q, from H4

13. ∠PRQ + ∠QRD > ∠QRD
    inequalities
      ∠PRQ > 0°                       12
      ∠QRD + ∠PRQ > ∠QRD + 0°         adding ∠QRD
      ∠PRQ + ∠QRD > ∠QRD              algebra

14. ∠PRD = ∠PRQ + ∠QRD
    restate 11

15. Q is between D and P
    mun:between-symmetric R := Q, S := P, T := D, from 2

16. ∠PRD > ∠PDR
    calculation
      ∠PRD = ∠PRQ + ∠QRD       14
           > ∠QRD              13
           = ∠QDR              thm:isosceles-angles A := R, B := D, C := Q, from 3, 4
           = ∠PDR              mun:angle-along-segment P := D, Q := P, S := Q, from H4, 4, 15

17. |PQ| + |QD| = |PD|
    mun:segment-addition Q := D, S := Q, from 2

18. |PQ| + |QR| > |PR|
    calculation
      |PQ| + |QR| = |PD|       algebra, from 3, 17
                  > |PR|       thm:greater-angle-greater-side A := P, B := R, C := D, from 10, 16

19. |PR| < |PQ| + |QR|
    inequalities
      |PQ| + |QR| > |PR|       18
      |PR| < |PQ| + |QR|       restate

theorem triangle-equality-between
  note        The equality case of I.20. P and R are apart, since the way
              from P through Q has length; Q is on line PR, since off it
              PQR is a triangle and I.20 makes the way through Q longer; and
              of the places on the line, only between P and R keeps the
              lengths, as beyond either end one of the two sides would be
              nothing.
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  assume P ≠ Q                                                        (H4)
  assume Q ≠ R                                                        (H5)
  assume |PQ| + |QR| = |PR|                                           (H6)
  then Q is between P and R

1.  |PQ| > 0
    axi:distance-positive, from H4

2.  |QR| > 0
    axi:distance-positive P := Q, Q := R, from H5

3.  P ≠ R
    contradiction
    suppose P = R                                                     (S)

    3.1.  |PQ| + |QR| > 0
          inequalities, from 1, 2

    3.2.  |PR| > 0
          substitute |PQ| + |QR| = |PR| (H6) into line 3.1

    3.3.  0 > 0, which is impossible
          substitute
            |PR| > 0      3.2
            0 > 0         mun:distance-zero Q := R, from S

4.  Q is on line PR
    contradiction
    suppose Q is not on line PR                                     (S)

    4.1.  Q, P, R form a triangle.
          mun:triangle-off-line P := Q, Q := P, from S, 3

    4.2.  |PR| < |PQ| + |QR|
          thm:triangle-inequality-strict, from 4.1

    4.3.  |PR| < |PR|
          substitute |PQ| + |QR| = |PR| (H6) into line 4.2

    4.4.  0 < 0, which is impossible
          inequalities
            |PR| < |PR|         4.3
            0 < 0               adding −|PR|

5.  Q = P or (Q is between P and R) or Q = R or (R is between P and Q) or
    (P is between Q and R)
    mun:on-line-cases P := Q, Q := P, from 3, 4

6.  Q is between P and R
    cases, from 5

    case
    assume Q = P                                                      (C1)

    6.1.  P ≠ Q
          restate H4, contradicting C1

    case
    assume Q is between P and R, which is the claim                   (C2)

    case
    assume Q = R                                                      (C3)

    6.2.  Q ≠ R
          restate H5, contradicting C3

    case
    assume R is between P and Q                                       (C4)

    6.3.  |PR| + |RQ| = |PQ|
          mun:segment-addition S := R, from C4

    6.4.  0 > 0, which is impossible
          substitute
            |QR| > 0      2
            0 > 0         algebra, from H6, 6.3

    case
    assume P is between Q and R                                       (C5)

    6.5.  |QP| + |PR| = |QR|
          mun:segment-addition P := Q, Q := R, S := P, from C5

    6.6.  0 > 0, which is impossible
          substitute
            |PQ| > 0      1
            0 > 0         algebra, from H6, 6.5

theorem chord-midpoint-right-angle
  note        Euclid III.3. The line from the centre O of a circle through
              the midpoint M of a chord AB meets the chord at a right angle.
              O is off the chord's line, since on it O would be an end, the
              midpoint, or beyond an end, and none keeps |AO| = |BO| with
              O ≠ M. So AMO and BMO are triangles with their sides equal,
              congruent by SSS, and the two angles at M, equal and
              supplementary, are right angles. O ≠ M because a chord through
              the centre has its midpoint there, and no angle at M.
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let M be a point                                                    (H3)
  let O be a point                                                    (H4)
  assume M is the midpoint of AB                                      (H5)
  assume |AO| = |BO|                                                  (H6)
  assume O ≠ M                                                        (H7)
  assume M ≠ B                                                        (H8)
  assume O ≠ B                                                        (H9)
  then ∠OMB = 90°

1.  M is between A and B. |AM| = |MB|.
    def:midpoint, from H5

2.  A ≠ B
    mun:between-ends-apart R := M, S := A, T := B, from 1

3.  A ≠ M. B ≠ M.
    mun:between-apart R := M, S := A, T := B, from 1

4.  O is not on line AB
    contradiction
    suppose O is on line AB                                           (S)

    4.1.  O = A or (O is between A and B) or O = B or
          (B is between A and O) or (A is between O and B)
          mun:on-line-cases P := O, Q := A, R := B, from S, 2

    4.2.  A = B
          cases, from 4.1

          case
          assume O = A                                                (C1)

          4.2.1.  |OA| = 0
                  mun:distance-zero P := O, Q := A, from C1

          4.2.2.  |BO| = 0
                  transitivity, from H6, 4.2.1

          4.2.3.  B = O
                  mun:distance-zero P := B, Q := O, from 4.2.2

          4.2.4.  A = B
                  transitivity, from C1, 4.2.3

          case
          assume O is between A and B                                 (C2)

          4.2.5.  O is the midpoint of AB
                  def:midpoint M := O, from C2, H6

          4.2.6.  O = M
                  mun:midpoint-unique M := O, N := M, from H5, 4.2.5

          4.2.7.  O ≠ M
                  restate H7, contradicting 4.2.6

          case
          assume O = B                                                (C3)

          4.2.8.  |OB| = 0
                  mun:distance-zero P := O, Q := B, from C3

          4.2.9.  |AO| = 0
                  transitivity, from H6, 4.2.8

          4.2.10. A = O
                  mun:distance-zero P := A, Q := O, from 4.2.9

          4.2.11. A = B
                  transitivity, from C3, 4.2.10

          case
          assume B is between A and O                                 (C4)

          4.2.12. |AB| + |BO| = |AO|
                  mun:segment-addition P := A, Q := O, S := B, from C4

          4.2.13. |AB| = 0
                  algebra, from H6, 4.2.12

          4.2.14. A = B
                  mun:distance-zero P := A, Q := B, from 4.2.13

          case
          assume A is between O and B                                 (C5)

          4.2.15. |OA| + |AB| = |OB|
                  mun:segment-addition P := O, Q := B, S := A, from C5

          4.2.16. |AB| = 0
                  algebra, from H6, 4.2.15

          4.2.17. A = B
                  mun:distance-zero P := A, Q := B, from 4.2.16

    4.3.  A ≠ B
          restate 2, contradicting 4.2

5.  O, A, B form a triangle.
    mun:triangle-off-line P := O, Q := A, R := B, from 2, 4

6.  O, A, M form a triangle.
    mun:triangle-on-side P := O, Q := A, R := B, S := M, from 1, 5

7.  M is between B and A
    mun:between-symmetric R := M, S := A, T := B, from 1

8.  O, B, M form a triangle.
    mun:triangle-on-side P := O, Q := B, R := A, S := M, from 5, 7

9.  triangle AMO ≅ triangle BMO
    thm:side-side-side B := M, C := O, D := B, E := M, F := O,
      from H6, 1, 6, 8

10. |AM| = |BM|, |MO| = |MO|, |OA| = |OB|, ∠AMO = ∠BMO, ∠MOA = ∠MOB,
    and ∠OAM = ∠OBM.
    def:congruent P := A, Q := M, R := O, P′ := B, Q′ := M, R′ := O,
      from 6, 8, 9

11. ∠AMO + ∠OMB = 180°
    axi:supplementary-angles B := M, C := B, D := O, from H7, 1, 5

12. ∠BMO = ∠OMB
    mun:angle-turned P := B, Q := M, R := O, from H7, 3, 5

13. ∠OMB = 90°
    algebra, from 10, 11, 12

theorem perpendicular-foot
  note        Euclid I.12, the perpendicular from P to the line QR. Copy the
              angle RQP to the other side of the line, and lay off |QP| along
              its arm to P′; the line crosses PP′ at H. Where H is not Q, the
              triangles PQH and P′QH agree in two sides and the angle between
              them, so the angles at H are equal, and being supplementary
              they are right angles; where H is Q, the angles at Q are. The
              right angle to R follows along the line (right-angle-along).
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  assume P, Q, R form a triangle                                      (H4)
  then there is H ∈ 𝔼² with H is on line QR, P ≠ H, (if H ≠ Q then ∠PHQ = 90°), and (if H ≠ R then ∠PHR = 90°)

1.  |PQ| > 0
    axi:distance-positive, from H4

2.  X ∈ 𝔼². Q is between P and X. |QX| = |PQ|.
    obtain X: mun:segment-extension A := P, B := Q, r := |PQ|, from H4, 1

3.  Q is on line QR. R is on line QR.
    mun:on-line-ends A := Q, B := R

4.  P is not on line QR
    mun:triangle-not-on-line, from H4

5.  P and X are on opposite sides of line QR
    mun:segment-across-line A := Q, B := R, Q := X, M := Q, from H4, 2, 3, 4

6.  Q ≠ R. P is not on line QR. X is not on line QR.
    mun:opposite-sides-off-line A := Q, B := R, Q := X, from 5

7.  X, Q, R form a triangle.
    mun:triangle-off-line P := X, from 6

8.  ∠RQP > 0°. ∠RQP < 180°.
    axi:angle-measure P := R, R := P, from H4

9.  D ∈ 𝔼². D and X are on the same side of line QR and ∠RQD = ∠RQP.
    obtain D: axi:angle-construction A := Q, B := R, C := X, x := ∠RQP,
      from 7, 8

10. Q ≠ R. D is not on line QR. X is not on line QR.
    mun:same-side-off-line A := Q, B := R, P := D, Q := X, from 9

11. D, Q, R form a triangle.
    mun:triangle-off-line P := D, from 10

12. P′ ∈ 𝔼². P′ is on line QD, P′ and D are on the same side of line QR,
    and |QP′| = |PQ|.
    obtain P′: mun:ray-point A := Q, B := D, C := R, r := |PQ|, from 1, 11

13. ∠RQP′ = ∠RQD
    mun:angle-same-ray P := Q, Q := D, X := P′, from 12

14. ∠RQP′ = ∠RQP
    transitivity, from 13, 9

15. P′ and X are on the same side of line QR
    mun:same-side-same A := Q, B := R, P := P′, Q := D, R := X, from 9, 12

16. X and P are on opposite sides of line QR
    mun:opposite-sides-turned A := Q, B := R, Q := X, from 5

17. P′ and P are on opposite sides of line QR
    mun:same-opposite-opposite A := Q, B := R, P := P′, Q := X, R := P,
      from 15, 16

18. P and P′ are on opposite sides of line QR
    mun:opposite-sides-turned A := Q, B := R, P := P′, Q := P, from 17

19. H ∈ 𝔼². H is on line QR. H is between P and P′.
    obtain H: axi:plane-separation-crossing A := Q, B := R, Q := P′,
      from H4, 18

20. P ≠ H
    mun:on-off-apart A := Q, B := R, X := H, Y := P, from 4, 19

21. Q ≠ R. P is not on line QR. P′ is not on line QR.
    mun:opposite-sides-off-line A := Q, B := R, Q := P′, from 18

22. ∠PQR = ∠RQP
    mun:angle-turned, from H4

23. Q ≠ P′
    mun:on-off-apart A := Q, B := R, X := Q, Y := P′, from 3, 21

24. R ≠ P′
    mun:on-off-apart A := Q, B := R, X := R, Y := P′, from 3, 21

25. H ≠ P′
    mun:on-off-apart A := Q, B := R, X := H, Y := P′, from 19, 21

26. ∠P′QR = ∠RQP′
    mun:angle-turned P := P′, from H4, 23, 24

27. H is between P and P′
    restate 19

28. If H ≠ Q then ∠PHQ = 90°.
    proof
    assume H ≠ Q                                                      (K1)

    28.1. H = Q or (H is between Q and R) or H = R or
          (R is between Q and H) or (Q is between H and R)
          mun:on-line-cases P := H, from H4, 19

    28.2. ∠HQP = ∠HQP′
          cases, from 28.1

          case
          assume H = Q                                                (C1)

          28.2.1. H ≠ Q
                  restate K1, contradicting C1

          case
          assume H is between Q and R                                 (C2)

          28.2.2. ∠HQP = ∠RQP
                  mun:angle-along-segment P := Q, Q := R, S := H, R := P,
                    from C2, H4, 20

          28.2.3. ∠HQP′ = ∠RQP′
                  mun:angle-along-segment P := Q, Q := R, S := H, R := P′,
                    from C2, 23, 24, 25

          28.2.4. ∠HQP = ∠HQP′
                  calculation
                    ∠HQP = ∠RQP        28.2.2
                         = ∠RQP′       14
                         = ∠HQP′       28.2.3

          case
          assume H = R                                                (C3)

          28.2.5. ∠HQP′ = ∠HQP
                  substitute H = R (C3) into line 14

          28.2.6. ∠HQP = ∠HQP′
                  restate 28.2.5

          case
          assume R is between Q and H                                 (C4)

          28.2.7. ∠RQP = ∠HQP
                  mun:angle-along-segment P := Q, Q := H, S := R, R := P,
                    from C4, H4, 20

          28.2.8. ∠RQP′ = ∠HQP′
                  mun:angle-along-segment P := Q, Q := H, S := R, R := P′,
                    from C4, 23, 24, 25

          28.2.9. ∠HQP = ∠HQP′
                  calculation
                    ∠HQP = ∠RQP        28.2.7
                         = ∠RQP′       14
                         = ∠HQP′       28.2.8

          case
          assume Q is between H and R                                 (C5)

          28.2.10. ∠HQP + ∠PQR = 180°
                   axi:supplementary-angles A := H, B := Q, C := R, D := P,
                     from C5, H4, 20

          28.2.11. ∠HQP′ + ∠P′QR = 180°
                   axi:supplementary-angles A := H, B := Q, C := R, D := P′,
                     from C5, 23, 24, 25

          28.2.12. ∠HQP = ∠HQP′
                   algebra, from 14, 22, 26, 28.2.10, 28.2.11

    28.3. ∠PQH = ∠P′QH
          calculation
            ∠PQH = ∠HQP        mun:angle-turned R := H, from H4, K1, 20
                 = ∠HQP′       28.2
                 = ∠P′QH       mun:angle-turned P := P′, R := H, from K1, 23, 25

    28.4. P is not on line QH
          mun:off-line-along A := Q, B := R, X := H, from H4, K1, 4, 19

    28.5. P′ is not on line QH
          mun:off-line-along A := Q, B := R, X := H, P := P′, from K1, 19, 21

    28.6. P, Q, H form a triangle.
          mun:triangle-off-line R := H, from K1, 28.4

    28.7. P′, Q, H form a triangle.
          mun:triangle-off-line P := P′, R := H, from K1, 28.5

    28.8.  triangle PQH ≅ triangle P′QH
           axi:side-angle-side R := H, Q′ := Q, R′ := H, from 12, 28.3, 28.6,
             28.7

    28.9.  |PQ| = |P′Q|, |QH| = |QH|, |HP| = |HP′|, ∠PQH = ∠P′QH,
           ∠QHP = ∠QHP′, and ∠HPQ = ∠HP′Q.
           def:congruent R := H, Q′ := Q, R′ := H, from 28.6, 28.7, 28.8

    28.10. ∠PHQ + ∠QHP′ = 180°
           axi:supplementary-angles A := P, B := H, C := P′, D := Q, from H4, K1, 23, 27

    28.11. ∠PHQ = ∠QHP
           mun:angle-turned Q := H, R := Q, from H4, K1, 20

    28.12. ∠PHQ = 90°
           algebra, from 28.9, 28.10, 28.11

29. If H ≠ R then ∠PHR = 90°.
    proof
    assume H ≠ R                                                      (K2)

    29.1. H = Q or not (H = Q)
          axi:excluded-middle P := H = Q

    29.2. ∠PHR = 90°
          cases, from 29.1

          case
          assume H = Q                                                (C6)

          29.2.1. Q is between P and P′
                  substitute H = Q (C6) into line 27

          29.2.2. ∠PQR + ∠RQP′ = 180°
                  axi:supplementary-angles A := P, B := Q, C := P′, D := R,
                    from H4, 24, 29.2.1

          29.2.3. ∠PQR = 90°
                  algebra, from 14, 22, 29.2.2

          29.2.4. ∠PHR = 90°
                  substitute H = Q (C6) into line 29.2.3

          case
          assume not (H = Q)                                          (C7)

          29.2.5. ∠PHQ = 90°
                  mun:modus-ponens, from C7, 28

          29.2.6. line HQ = line QR
                  axi:line-uniqueness A := H, B := Q, C := Q, D := R,
                    from C7, H4, 3, 19

          29.2.7. R is on line HQ
                  substitute line HQ = line QR (line 29.2.6) into line 3

          29.2.8. ∠PHR = 90°
                  mun:right-angle-along S := Q, T := R, from 29.2.5, 29.2.7
                  requires P, H, Q form a triangle: mun:right-angle-triangle Q := H, R := Q, from C7, H4, 20, 29.2.5
                  requires P is not on line HQ: mun:triangle-not-on-line Q := H, R := Q
                  requires P is not on line HR: mun:off-line-along A := H, B := Q, X := R, from C7, K2, 29.2.7
                   requires P, H, R form a triangle: mun:triangle-off-line Q := H, from K2

30. there is H ∈ 𝔼² with H is on line QR, P ≠ H, (if H ≠ Q then ∠PHQ = 90°),
    and (if H ≠ R then ∠PHR = 90°)
    exhibit, from 19, 20, 28, 29

theorem altitude-foot
  note        The perpendicular from the right angle meets the hypotenuse
              between its ends, and splits the triangle into two right
              triangles. The other two angles are less than a right angle,
              each less than the right angle outside R (I.16). So the foot D
              of the perpendicular from R is neither P nor Q, which would
              make one of them right, nor beyond either, where the angle
              there, outside the right-angled triangle at D, would be more
              than a right angle.
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  assume P, Q, R form a triangle                                      (H4)
  assume ∠PRQ = 90°                                                   (H5)
  then there is D ∈ 𝔼² with (D is between P and Q), P, D, R form a triangle, Q, D, R form a triangle, ∠PDR = 90°, and ∠QDR = 90°

1.  |QR| > 0
    axi:distance-positive P := Q, Q := R, from H4

2.  Y ∈ 𝔼². R is between Q and Y. |RY| = |QR|.
    obtain Y: mun:segment-extension A := Q, B := R, r := |QR|, from H4, 1

3.  P, R, Y form a triangle.
    mun:triangle-extension Q := R, R := Q, S := Y, from H4, 2

4.  ∠QRP + ∠PRY = 180°
    axi:supplementary-angles A := Q, B := R, C := Y, D := P, from H4, 2, 3

5.  ∠PRQ = ∠QRP
    mun:angle-turned Q := R, R := Q, from H4

6.  ∠PRY > ∠QPR
    thm:exterior-angle-greater A := P, B := Q, C := R, D := Y, from H4, 2, 3

7.  90° > ∠QPR
    substitute
      ∠PRY > ∠QPR      6
      90° > ∠QPR       algebra, from H5, 4, 5

8.  90° > ∠RPQ
    substitute
      90° > ∠QPR      7
      90° > ∠RPQ      mun:angle-turned P := Q, Q := P, from H4

9.  |PR| > 0
    axi:distance-positive Q := R, from H4

10. Z ∈ 𝔼². R is between P and Z. |RZ| = |PR|.
    obtain Z: mun:segment-extension A := P, B := R, r := |PR|, from H4, 9

11. Q, R, Z form a triangle.
    mun:triangle-extension P := Q, Q := R, R := P, S := Z, from H4, 10

12. ∠PRQ + ∠QRZ = 180°
    axi:supplementary-angles A := P, B := R, C := Z, D := Q, from H4, 10, 11

13. ∠QRZ > ∠PQR
    thm:exterior-angle-greater A := Q, B := P, C := R, D := Z, from H4, 10, 11

14. 90° > ∠PQR
    substitute
      ∠QRZ > ∠PQR      13
      90° > ∠PQR       algebra, from H5, 12

15. 90° > ∠RQP
    substitute
      90° > ∠PQR      14
      90° > ∠RQP      mun:angle-turned, from H4

16. D ∈ 𝔼². D is on line PQ. R ≠ D. If D ≠ P then ∠RDP = 90°.
    If D ≠ Q then ∠RDQ = 90°.
    obtain D: thm:perpendicular-foot P := R, Q := P, R := Q, from H4

17. D = P or (D is between P and Q) or D = Q or (Q is between P and D) or
    (P is between D and Q)
    mun:on-line-cases P := D, Q := P, R := Q, from H4, 16

18. D is between P and Q
    cases, from 17

    case
    assume D = P                                                      (C1)

    18.1. D ≠ Q
          contradiction
          suppose D = Q                                               (S1)

          18.1.1. P = Q
                  transitivity, from C1, S1

          18.1.2. P ≠ Q
                  def:triangle, from H4, contradicting 18.1.1

    18.2. ∠RDQ = 90°
          mun:modus-ponens, from 16, 18.1

    18.3. ∠RPQ = 90°
          substitute D = P (C1) into line 18.2

    18.4. 90° > 90°, which is impossible
          substitute ∠RPQ = 90° (line 18.3) into line 8

    case
    assume D is between P and Q, which is the claim                   (C2)

    case
    assume D = Q                                                      (C3)

    18.5. D ≠ P
          contradiction
          suppose D = P                                               (S2)

          18.5.1. P = Q
                  transitivity, from C3, S2

          18.5.2. P ≠ Q
                  def:triangle, from H4, contradicting 18.5.1

    18.6. ∠RDP = 90°
          mun:modus-ponens, from 16, 18.5

    18.7. ∠RQP = 90°
          substitute D = Q (C3) into line 18.6

    18.8. 90° > 90°, which is impossible
          substitute ∠RQP = 90° (line 18.7) into line 15

    case
    assume Q is between P and D                                       (C4)

    18.9. P ≠ Q. D ≠ Q.
          mun:between-apart R := Q, S := P, T := D, from C4

    18.10. ∠RDQ = 90°
           mun:modus-ponens, from 16, 18.9

    18.11. R, D, Q form a triangle.
           mun:right-angle-triangle P := R, Q := D, R := Q, from H4, 16, 18.9,
             18.10

    18.12. Q is between D and P
           mun:between-symmetric R := Q, S := P, T := D, from C4

    18.13. ∠RQP > ∠RDQ
           thm:exterior-angle-greater-other A := R, B := D, C := Q, D := P,
             from 18.11, 18.12
           requires R, Q, P form a triangle: mun:triangle-extension P := R, R := D, S := P, from 18.11, 18.12

    18.14. ∠RQP > 90°
           substitute ∠RDQ = 90° (line 18.10) into line 18.13

    18.15. ∠RQP > ∠RQP
           transitivity, from 18.14, 15

    18.16. 0 > 0, which is impossible
           inequalities
             ∠RQP > ∠RQP     18.15
             0 > 0           adding −∠RQP

    case
    assume P is between D and Q                                       (C5)

    18.17. D ≠ P. Q ≠ P.
           mun:between-apart R := P, S := D, T := Q, from C5

    18.18. ∠RDP = 90°
           mun:modus-ponens, from 16, 18.17

    18.19. R, D, P form a triangle.
           mun:right-angle-triangle P := R, Q := D, R := P, from H4, 16, 18.17,
             18.18

    18.20. ∠RPQ > ∠RDP
           thm:exterior-angle-greater-other A := R, B := D, C := P, D := Q,
             from C5, 18.19
           requires R, P, Q form a triangle: mun:triangle-extension P := R, Q := P, R := D, S := Q, from C5, 18.19

    18.21. ∠RPQ > 90°
           substitute ∠RDP = 90° (line 18.18) into line 18.20

    18.22. ∠RPQ > ∠RPQ
           transitivity, from 18.21, 8

    18.23. 0 > 0, which is impossible
           inequalities
             ∠RPQ > ∠RPQ     18.22
             0 > 0           adding −∠RPQ

19. P ≠ D. Q ≠ D.
    mun:between-apart R := D, S := P, T := Q, from 18

20. ∠RDP = 90°
    mun:modus-ponens, from 16, 19

21. ∠RDQ = 90°
    mun:modus-ponens, from 16, 19

22. ∠PDR = ∠RDP
    mun:angle-turned Q := D, from H4, 16, 19

23. ∠PDR = 90°
    transitivity, from 22, 20

24. ∠QDR = ∠RDQ
    mun:angle-turned P := Q, Q := D, from H4, 16, 19

25. ∠QDR = 90°
    transitivity, from 24, 21

26. P, D, R form a triangle.
    mun:right-angle-triangle Q := D, from H4, 16, 19, 23

27. Q, D, R form a triangle.
    mun:right-angle-triangle P := Q, Q := D, from H4, 16, 19, 25

28. there is D ∈ 𝔼² with (D is between P and Q), P, D, R form a triangle,
    Q, D, R form a triangle, ∠PDR = 90°, and ∠QDR = 90°
    exhibit, from 18, 23, 25, 26, 27

theorem pythagoras
  note        Euclid I.47, by similar triangles. Drop the altitude from C to
              its foot D on AB. The two smaller triangles are each similar to
              ABC, which gives |AD|·|AB| = |AC|² and |DB|·|AB| = |BC|².
              Adding, with |AD| + |DB| = |AB|, gives |AB|².
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  assume A, B, C form a triangle                                      (H4)
  assume ∠ACB = 90°                                                   (H5)
  then |AB|² = |AC|² + |BC|²

1.  D ∈ 𝔼². D is between A and B. A, D, C form a triangle.
    B, D, C form a triangle. ∠ADC = 90°. ∠BDC = 90°.
    obtain D: thm:altitude-foot P := A, Q := B, R := C, from H4, H5

2.  ∠DAC = ∠CAB
    calculation
      ∠DAC = ∠BAC       mun:angle-along-segment P := A, Q := B, R := C, S := D, from 1
           = ∠CAB       mun:angle-symmetric P := B, Q := A, R := C, from H4

3.  ∠ADC = ∠ACB
    calculation
      ∠ADC = 90°        1
           = ∠ACB       H5

4.  |AD|·|AB| = |AC|·|AC|
    thm:angle-angle-similar P := A, Q := D, R := C, P′ := A, Q′ := C,
      R′ := B, from H4, 1, 2, 3

5.  D is between B and A
    mun:between-symmetric R := D, S := A, T := B, from 1

6.  ∠DBC = ∠CBA
    calculation
      ∠DBC = ∠ABC       mun:angle-along-segment P := B, Q := A, R := C, S := D, from 1, 5
           = ∠CBA       mun:angle-symmetric P := A, Q := B, R := C, from H4

7.  ∠BDC = ∠BCA
    calculation
      ∠BDC = 90°        1
           = ∠ACB       H5
           = ∠BCA       mun:angle-symmetric P := B, Q := C, R := A, from H4

8.  |BD|·|BA| = |BC|·|BC|
    thm:angle-angle-similar P := B, Q := D, R := C, P′ := B, Q′ := C,
      R′ := A, from H4, 1, 6, 7

9.  |AD| + |DB| = |AB|
    mun:segment-addition P := A, Q := B, S := D, from 1

10. |AB|² = |AC|² + |BC|²
    algebra, from 4, 8, 9

mundane theorem on-line-other
  note        Line XY, for two points X and Y of line AB, is line AB
              (line-uniqueness), so a point of the one is on the other.
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let X be a point                                                    (H3)
  let Y be a point                                                    (H4)
  let Z be a point                                                    (H5)
  assume A ≠ B                                                        (H6)
  assume X ≠ Y                                                        (H7)
  assume X is on line AB                                              (H8)
  assume Y is on line AB                                              (H9)
  assume Z is on line AB                                              (H10)
  then Z is on line XY

1.  Z is on line XY
    substitute
      Z ∈ line AB      H10
      Z ∈ line XY      axi:line-uniqueness A := X, B := Y, C := A, D := B, from H6, H7, H8, H9

mundane theorem off-line-other
  note        Line XY, for two points X and Y of line AB, is line AB, so a
              point off the one is off the other.
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let X be a point                                                    (H3)
  let Y be a point                                                    (H4)
  let O be a point                                                    (H5)
  assume A ≠ B                                                        (H6)
  assume X ≠ Y                                                        (H7)
  assume X is on line AB                                              (H8)
  assume Y is on line AB                                              (H9)
  assume O is not on line AB                                          (H10)
  then O is not on line XY

1.  A is on line AB. B is on line AB.
    mun:on-line-ends

2.  O is not on line XY
    contradiction
    suppose O is on line XY                                           (S)

    2.1.  A is on line XY
          mun:on-line-other Z := A, from H6, H7, H8, H9, 1

    2.2.  B is on line XY
          mun:on-line-other Z := B, from H6, H7, H8, H9, 1

    2.3.  O is on line AB
          mun:on-line-other A := X, B := Y, X := A, Y := B, Z := O,
            from H6, H7, S, 2.1, 2.2

    2.4.  O is not on line AB
          restate H10, contradicting 2.3

mundane theorem point-off-line
  note        A line is not the whole plane. Of the three points of a
              triangle (three-points) one is off any line: were all three on
              it, the line through two of them would hold the third.
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  assume A ≠ B                                                        (H3)
  then there is O ∈ 𝔼² with O is not on line AB

1.  U ∈ 𝔼². V ∈ 𝔼². W ∈ 𝔼². U, V, W form a triangle.
    obtain U, V, W: axi:three-points

2.  U is not on line VW
    mun:triangle-not-on-line P := U, Q := V, R := W, from 1

3.  U is on line AB or U is not on line AB
    axi:excluded-middle P := U is on line AB

4.  there is O ∈ 𝔼² with O is not on line AB
    cases, from 3

    case
    assume U is on line AB                                            (C1)

    4.1.  V is on line AB or V is not on line AB
          axi:excluded-middle P := V is on line AB

    4.2.  there is O ∈ 𝔼² with O is not on line AB
          cases, from 4.1

          case
          assume V is on line AB                                      (C2)

          4.2.1.  W is on line AB or W is not on line AB
                  axi:excluded-middle P := W is on line AB

          4.2.2.  there is O ∈ 𝔼² with O is not on line AB
                  cases, from 4.2.1

                  case
                  assume W is on line AB                              (C3)

                  4.2.2.1.  U is on line VW
                            mun:on-line-other X := V, Y := W, Z := U,
                              from C1, C2, C3, H3, 1

                  4.2.2.2.  U is not on line VW
                            restate 2, contradicting 4.2.2.1

                  case
                  assume W is not on line AB                          (C4)

                  4.2.2.3.  there is O ∈ 𝔼² with O is not on line AB
                            exhibit, from C4

          case
          assume V is not on line AB                                  (C5)

          4.2.3.  there is O ∈ 𝔼² with O is not on line AB
                  exhibit, from C5

    case
    assume U is not on line AB                                        (C6)

    4.3.  there is O ∈ 𝔼² with O is not on line AB
          exhibit, from C6

mundane theorem between-split
  note        Two points between A and B are one, or one of them is between
              A and the other or between the other and B. Through P, a point
              O off the line makes a line separating A from B; M is on A's
              side or on B's, and on that side it is past P from the other
              end, since any other place on the line would put it on the
              wrong side.
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let M be a point                                                    (H3)
  let P be a point                                                    (H4)
  assume M is between A and B                                         (H5)
  assume P is between A and B                                         (H6)
  then P = M or (P is between A and M) or (P is between M and B)

1.  A ≠ B
    mun:between-ends-apart R := M, S := A, T := B, from H5

2.  A ≠ M. B ≠ M.
    mun:between-apart R := M, S := A, T := B, from H5

3.  A ≠ P. B ≠ P.
    mun:between-apart R := P, S := A, T := B, from H6

4.  B, M, A are collinear.
    mun:between-collinear R := M, S := A, T := B, from H5

5.  M is on line AB
    def:on-line P := M, from 4

6.  B, P, A are collinear.
    mun:between-collinear R := P, S := A, T := B, from H6

7.  P is on line AB
    def:on-line, from 6

8.  A is on line AB. B is on line AB.
    mun:on-line-ends

9.  O ∈ 𝔼². O is not on line AB.
    obtain O: mun:point-off-line, from 1

10. P ≠ O
    mun:on-off-apart X := P, Y := O, from 7, 9

11. P = M or not (P = M)
    axi:excluded-middle P := P = M

12. P = M or (P is between A and M) or (P is between M and B)
    cases, from 11

    case
    assume P = M                                                      (C1)

    12.1. P = M or (P is between A and M)
          mun:or-left, from C1

    12.2. P = M or (P is between A and M) or (P is between M and B)
          mun:or-left, from 12.1

    case
    assume not (P = M)                                                (C2)

    12.3. O is not on line PA
          mun:off-line-other X := P, Y := A, from 1, 3, 7, 8, 9

    12.4. A is not on line PO
          mun:off-line-swap R := P, P := A, Q := O, from 12.3

    12.5. O is not on line PB
          mun:off-line-other X := P, Y := B, from 1, 3, 7, 8, 9

    12.6. B is not on line PO
          mun:off-line-swap R := P, P := B, Q := O, from 12.5

    12.7. O is not on line PM
          mun:off-line-other X := P, Y := M, from C2, 1, 5, 7, 9

    12.8. M is not on line PO
          mun:off-line-swap R := P, P := M, Q := O, from 12.7

    12.9. P is on line PO. O is on line PO.
          mun:on-line-ends A := P, B := O

    12.10. A and B are on opposite sides of line PO
           mun:segment-across-line A := P, B := O, P := A, Q := B, M := P,
             from H6, 10, 12.4, 12.9

    12.11. M and A are on the same side of line PO or M and A are on
           opposite sides of line PO
           axi:plane-separation A := P, B := O, P := M, Q := A,
             from 10, 12.4, 12.8

    12.12. M is on line PB
           mun:on-line-other X := P, Y := B, Z := M, from 1, 3, 5, 7, 8

    12.13. M is on line PA
           mun:on-line-other X := P, Y := A, Z := M, from 1, 3, 5, 7, 8

    12.14. P = M or (P is between A and M) or (P is between M and B)
           cases, from 12.11

           case
           assume M and A are on the same side of line PO             (C3)

           12.14.1. M and B are on opposite sides of line PO
                    mun:same-opposite-opposite A := P, B := O, P := M,
                      Q := A, R := B, from C3, 12.10

           12.14.2. M = P or (M is between P and B) or M = B or
                    (B is between P and M) or (P is between M and B)
                    mun:on-line-cases P := M, Q := P, R := B, from 3, 12.12

           12.14.3. P is between M and B
                    cases, from 12.14.2

                    case
                    assume M = P                                      (C4)

                    12.14.3.1. not (P = M)
                               restate C2, contradicting C4

                    case
                    assume M is between P and B                       (C5)

                    12.14.3.2. M is between B and P
                               mun:between-symmetric R := M, S := P, T := B,
                                 from C5

                    12.14.3.3. M and B are on the same side of line PO
                               mun:segment-off-line A := P, B := O, P := B,
                                 Q := P, X := M, from 10, 12.6, 12.9, 12.14.3.2

                    12.14.3.4. not (M and B are on opposite sides of line PO)
                               mun:same-not-opposite A := P, B := O, P := M,
                                 Q := B, from 12.14.3.3

                    12.14.3.5. M and B are on opposite sides of line PO
                               restate 12.14.1, contradicting 12.14.3.4

                    case
                    assume M = B                                      (C6)

                    12.14.3.6. B ≠ M
                               restate 2, contradicting C6

                    case
                    assume B is between P and M                       (C7)

                    12.14.3.7. B is between M and P
                               mun:between-symmetric R := B, S := P, T := M,
                                 from C7

                    12.14.3.8. M and B are on the same side of line PO
                               mun:segment-beyond-off-line A := P, B := O,
                                 P := M, Q := P, X := B, from 10, 12.6, 12.9,
                                 12.14.3.7

                    12.14.3.9. not (M and B are on opposite sides of line PO)
                               mun:same-not-opposite A := P, B := O, P := M,
                                 Q := B, from 12.14.3.8

                    12.14.3.10. M and B are on opposite sides of line PO
                                restate 12.14.1, contradicting 12.14.3.9

                    case
                    assume P is between M and B, which is the claim   (C8)

           12.14.4. P = M or (P is between A and M) or (P is between M and B)
                    mun:or-right, from 12.14.3

           case
           assume M and A are on opposite sides of line PO            (C9)

           12.14.5. M = P or (M is between P and A) or M = A or
                    (A is between P and M) or (P is between M and A)
                    mun:on-line-cases P := M, Q := P, R := A, from 3, 12.13

           12.14.6. P is between M and A
                    cases, from 12.14.5

                    case
                    assume M = P                                      (C10)

                    12.14.6.1. not (P = M)
                               restate C2, contradicting C10

                    case
                    assume M is between P and A                       (C11)

                    12.14.6.2. M is between A and P
                               mun:between-symmetric R := M, S := P, T := A,
                                 from C11

                    12.14.6.3. M and A are on the same side of line PO
                               mun:segment-off-line A := P, B := O, P := A,
                                 Q := P, X := M, from 10, 12.4, 12.9, 12.14.6.2

                    12.14.6.4. not (M and A are on opposite sides of line PO)
                               mun:same-not-opposite A := P, B := O, P := M,
                                 Q := A, from 12.14.6.3

                    12.14.6.5. M and A are on opposite sides of line PO
                               restate C9, contradicting 12.14.6.4

                    case
                    assume M = A                                      (C12)

                    12.14.6.6. A ≠ M
                               restate 2, contradicting C12

                    case
                    assume A is between P and M                       (C13)

                    12.14.6.7. A is between M and P
                               mun:between-symmetric R := A, S := P, T := M,
                                 from C13

                    12.14.6.8. M and A are on the same side of line PO
                               mun:segment-beyond-off-line A := P, B := O,
                                 P := M, Q := P, X := A, from 10, 12.4, 12.9,
                                 12.14.6.7

                    12.14.6.9. not (M and A are on opposite sides of line PO)
                               mun:same-not-opposite A := P, B := O, P := M,
                                 Q := A, from 12.14.6.8

                    12.14.6.10. M and A are on opposite sides of line PO
                                restate C9, contradicting 12.14.6.9

                    case
                    assume P is between M and A, which is the claim   (C14)

           12.14.7. P is between A and M
                    mun:between-symmetric R := P, S := M, T := A, from 12.14.6

           12.14.8. P = M or (P is between A and M)
                    mun:or-right, from 12.14.7

           12.14.9. P = M or (P is between A and M) or (P is between M and B)
                    mun:or-left, from 12.14.8

theorem power-of-a-point
  note        Euclid's way to III.35. For P on a chord AB of a circle with
              centre O, |AO|² − |PO|² = |PA|·|PB|. With M the midpoint of AB,
              OM is perpendicular to the chord (III.3), and Pythagoras in the
              right triangles OMA and OMP makes |AO|² − |PO|² = |AM|² − |PM|²;
              P is M or on one side of it (between-split), so |PA| and |PB|
              are |AM| less |PM| and |AM| more, whose product is the same. A
              chord through O has its midpoint there, and the distances to
              M are the distances to O.
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let P be a point                                                    (H3)
  let O be a point                                                    (H4)
  assume P is between A and B                                         (H5)
  assume |AO| = |BO|                                                  (H6)
  then |AO|² − |PO|² = |PA|·|PB|

1.  A ≠ B
    mun:between-ends-apart R := P, S := A, T := B, from H5

2.  M ∈ 𝔼². M is the midpoint of AB.
    obtain M: mun:midpoint-exists, from 1

3.  M is between A and B. |AM| = |MB|.
    def:midpoint, from 2

4.  A ≠ M. B ≠ M.
    mun:between-apart R := M, S := A, T := B, from 3

5.  |AP| + |PB| = |AB|
    mun:segment-addition P := A, Q := B, S := P, from H5

6.  |AM| + |MB| = |AB|
    mun:segment-addition P := A, Q := B, S := M, from 3

7.  O = M or not (O = M)
    axi:excluded-middle P := O = M

8.  |AO|² − |PO|² = |AM|² − |PM|²
    cases, from 7

    case
    assume O = M                                                      (C1)

    8.1.  |AM|² − |PM|² = |AM|² − |PM|²
          algebra

    8.2.  |AO|² − |PO|² = |AM|² − |PM|²
          substitute O = M (C1) into line 8.1

    case
    assume not (O = M)                                                (C2)

    8.3.  A ≠ O
          mun:circle-centre-apart X := A, Y := B, from H6, 1

    8.4.  B ≠ O
          mun:circle-centre-apart X := B, Y := A, from H6, 1

    8.5.  ∠OMB = 90°
          thm:chord-midpoint-right-angle, from C2, H6, 2, 4, 8.4

    8.6.  ∠AMO + ∠OMB = 180°
          axi:supplementary-angles B := M, C := B, D := O, from C2, 3, 8.3, 8.4

    8.7.  ∠OMA = ∠AMO
          mun:angle-turned P := O, Q := M, R := A, from C2, 4, 8.3

    8.8.  ∠OMA = 90°
          algebra, from 8.5, 8.6, 8.7

    8.9.  O, M, A form a triangle.
          mun:right-angle-triangle P := O, Q := M, R := A, from C2, 4, 8.3, 8.8

    8.10. |OA|² = |OM|² + |AM|²
          thm:pythagoras A := O, B := A, C := M, from 8.8, 8.9

    8.11. P = M or not (P = M)
          axi:excluded-middle P := P = M

    8.12. |PO|² = |OM|² + |PM|²
          cases, from 8.11

          case
          assume P = M                                                (C3)

          8.12.1. |PM| = 0
                  mun:distance-zero Q := M, from C3

          8.12.2. |MO|² = |OM|² + |PM|²
                  algebra, from 8.12.1

          8.12.3. |PO|² = |OM|² + |PM|²
                  substitute P = M (C3) into line 8.12.2

          case
          assume not (P = M)                                          (C4)

          8.12.4. B, M, A are collinear.
                  mun:between-collinear R := M, S := A, T := B, from 3

          8.12.5. M is on line AB
                  def:on-line P := M, from 8.12.4

          8.12.6. B, P, A are collinear.
                  mun:between-collinear R := P, S := A, T := B, from H5

          8.12.7. P is on line AB
                  def:on-line, from 8.12.6

          8.12.8. A is on line AB. B is on line AB.
                  mun:on-line-ends

          8.12.9. P is on line MB
                  mun:on-line-other X := M, Y := B, Z := P,
                    from 1, 4, 8.12.5, 8.12.7, 8.12.8

          8.12.10. O, M, B form a triangle.
                   mun:right-angle-triangle P := O, Q := M, R := B,
                     from C2, 4, 8.4, 8.5

          8.12.11. O is not on line MB
                   mun:triangle-not-on-line P := O, Q := M, R := B, from 8.12.10

          8.12.12. P ≠ O
                   mun:on-off-apart A := M, X := P, Y := O,
                     from 8.12.9, 8.12.11

          8.12.13. ∠OMP = 90°
                   mun:right-angle-along P := O, H := M, S := B, T := P,
                     from 4, 8.4, 8.5, 8.12.9
                   requires O is not on line MP: mun:off-line-along A := M, X := P, P := O, from C4, 4, 8.12.9, 8.12.11
                   requires O, M, P form a triangle: mun:triangle-off-line P := O, Q := M, R := P, from C4

          8.12.14. O, M, P form a triangle.
                   mun:right-angle-triangle P := O, Q := M, R := P,
                     from C2, C4, 8.12.12, 8.12.13

          8.12.15. |OP|² = |OM|² + |PM|²
                   thm:pythagoras A := O, B := P, C := M, from 8.12.13,
                     8.12.14

    8.13. |AO|² − |PO|² = |AM|² − |PM|²
          algebra, from 8.10, 8.12

9.  P = M or (P is between A and M) or (P is between M and B)
    mun:between-split, from H5, 3

10. |PA|·|PB| = |AM|² − |PM|²
    cases, from 9

    case
    assume P = M                                                      (C5)

    10.1. |PM| = 0
          mun:distance-zero Q := M, from C5

    10.2. |MA|·|MB| = |AM|²
          algebra, from 3

    10.3. |MA|·|MB| = |AM|² − |PM|²
          algebra, from 10.1, 10.2

    10.4. |PA|·|PB| = |AM|² − |PM|²
          substitute P = M (C5) into line 10.3

    case
    assume P is between A and M                                       (C6)

    10.5. |AP| + |PM| = |AM|
          mun:segment-addition P := A, Q := M, S := P, from C6

    10.6. |PA| = |AM| − |PM|
          algebra, from 10.5

    10.7. |PB| = |AM| + |PM|
          algebra, from 3, 5, 6, 10.5

    10.8. |PA|·|PB| = (|AM| − |PM|)·|PB|
          algebra, from 10.6

    10.9. (|AM| − |PM|)·|PB| = |AM|² − |PM|²
          algebra, from 10.7

    10.10. |PA|·|PB| = |AM|² − |PM|²
           transitivity, from 10.8, 10.9

    case
    assume P is between M and B                                       (C7)

    10.11. |MP| + |PB| = |MB|
           mun:segment-addition P := M, Q := B, S := P, from C7

    10.12. |PB| = |AM| − |PM|
           algebra, from 3, 10.11

    10.13. |PA| = |AM| + |PM|
           algebra, from 5, 6, 10.11

    10.14. |PA|·|PB| = (|AM| + |PM|)·|PB|
           algebra, from 10.13

    10.15. (|AM| + |PM|)·|PB| = |AM|² − |PM|²
           algebra, from 10.12

    10.16. |PA|·|PB| = |AM|² − |PM|²
           transitivity, from 10.14, 10.15

11. |AO|² − |PO|² = |PA|·|PB|
    transitivity, from 8, 10

theorem intersecting-chords
  note        Two chords AB and CD of a circle with centre O, crossing at P,
              cut each other into parts with equal products (Euclid III.35):
              each product is |AO|² − |PO|² (power-of-a-point). The circle is
              said by the four distances to O.
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  let D be a point                                                    (H4)
  let P be a point                                                    (H5)
  let O be a point                                                    (H6)
  assume P is between A and B                                         (H7)
  assume P is between C and D                                         (H8)
  assume |AO| = |BO|                                                  (H9)
  assume |AO| = |CO|                                                  (H10)
  assume |AO| = |DO|                                                  (H11)
  then |PA|·|PB| = |PC|·|PD|

1.  |AO|² − |PO|² = |PA|·|PB|
    thm:power-of-a-point, from H7, H9

2.  |CO| = |DO|
    transitivity, from H10, H11

3.  |CO|² − |PO|² = |PC|·|PD|
    thm:power-of-a-point A := C, B := D, from H8, 2

4.  |PA|·|PB| = |PC|·|PD|
    algebra, from H10, 1, 3

theorem angle-sum
  note        Euclid I.32. Draw through B the line parallel to AC. The angles
              it makes with BA and BC equal the triangle's angles at A and at
              C (alternate angles), and with the angle at B they make a
              straight line.
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  assume A, B, C form a triangle                                      (H4)
  then ∠BAC + ∠ABC + ∠BCA = 180°

1.  D ∈ 𝔼². E ∈ 𝔼². line BD ∥ line AC. line BE ∥ line CA.
    B is between D and E.
    D and C are on opposite sides of line BA.
    E and A are on opposite sides of line BC.
    A and C are on the same side of line BD.
    obtain D, E: thm:parallel-through P := A, Q := C, R := B, from H4

2.  ∠DBA = ∠BAC
    thm:alternate-angles P := A, Q := C, R := B, S := D, from H4, 1

3.  ∠EBC = ∠BCA
    thm:alternate-angles P := C, Q := A, R := B, S := E, from H4, 1

4.  ∠BAC + ∠ABC + ∠BCA = 180°
    calculation
      ∠BAC + ∠ABC + ∠BCA = ∠DBA + ∠ABC + ∠BCA      substitute line 2
                         = ∠DBA + ∠ABC + ∠EBC      substitute line 3
                         = 180°                    thm:angles-on-a-line P := A, Q := C, R := B, S := D, T := E, from 1
    requires B ≠ C: mun:opposite-sides-off-line A := B, B := C, P := E, Q := A, from 1
    requires E is not on line BC: mun:opposite-sides-off-line A := B, B := C, P := E, Q := A, from 1
    requires C, B, E form a triangle: mun:triangle-off-line P := E, Q := B, R := C

mundane theorem ray-point
  note        A length r laid off from A along the ray toward B: short of B,
              at B, or past it, as r is less than |AB|, equal to it or more.
              The point is on line AB, and on B's side of any other line
              through A.
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  let r ∈ ℝ                                                           (H4)
  assume A, B, C form a triangle                                      (H5)
  assume r > 0                                                        (H6)
  then there is X ∈ 𝔼² with X is on line AB, X and B are on the same side of line AC, and |AX| = r

1.  B is not on line AC
    mun:triangle-not-on-line P := B, Q := A, R := C, from H5

2.  A is on line AC
    mun:on-line-ends B := C

3.  B is on line AB
    mun:on-line-ends

4.  r − |AB| < 0 or r − |AB| = 0 or 0 < r − |AB|
    axi:trichotomy x := r − |AB|

5.  there is X ∈ 𝔼² with X is on line AB, X and B are on the same side of
    line AC, and |AX| = r
    cases, from 4

    case
    assume r − |AB| < 0                                               (C1)

    5.1.  r < |AB|
          inequalities
            r − |AB| < 0      C1
            r < |AB|          adding |AB|

    5.2.  X ∈ 𝔼². X is between A and B. |AX| = r.
          obtain X: mun:segment-point, from H6, 5.1

    5.3.  X is between B and A
          mun:between-symmetric R := X, S := A, T := B, from 5.2

    5.4.  X and B are on the same side of line AC
          mun:segment-off-line B := C, P := B, Q := A, from H5, 1, 2, 5.3

    5.5.  B, X, A are collinear.
          mun:between-collinear R := X, S := A, T := B, from 5.2

    5.6.  X is on line AB
          def:on-line P := X, from 5.5

    5.7.  there is X ∈ 𝔼² with X is on line AB, X and B are on the same
          side of line AC, and |AX| = r
          exhibit, from 5.2, 5.4, 5.6

    case
    assume r − |AB| = 0                                               (C2)

    5.8.  |AB| = r
          algebra, from C2

    5.9.  M ∈ 𝔼². M is the midpoint of AB.
          obtain M: mun:midpoint-exists, from H5

    5.10. M is between A and B. |AM| = |MB|.
          def:midpoint, from 5.9

    5.11. M is between B and A
          mun:between-symmetric R := M, S := A, T := B, from 5.10

    5.12. M and B are on the same side of line AC
          mun:segment-off-line B := C, P := B, Q := A, X := M,
            from H5, 1, 2, 5.11

    5.13. B and M are on the same side of line AC
          mun:same-side-turned B := C, P := M, Q := B, from 5.12

    5.14. B and B are on the same side of line AC
          mun:same-side-same B := C, P := B, Q := M, R := B, from 5.12, 5.13

    5.15. there is X ∈ 𝔼² with X is on line AB, X and B are on the same
          side of line AC, and |AX| = r
          exhibit, from 3, 5.8, 5.14

    case
    assume 0 < r − |AB|                                               (C3)

    5.16. r − |AB| > 0
          inequalities
            0 < r − |AB|      C3
            r − |AB| > 0      restate

    5.17. X ∈ 𝔼². B is between A and X. |BX| = r − |AB|.
          obtain X: mun:segment-extension r := r − |AB|, from H5, 5.16

    5.18. |AB| + |BX| = |AX|
          mun:segment-addition P := A, Q := X, S := B, from 5.17

    5.19. |AX| = r
          algebra, from 5.17, 5.18

    5.20. X, B, A are collinear.
          mun:between-collinear R := B, S := A, T := X, from 5.17

    5.21. X is on line AB
          def:on-line P := X, from 5.20

    5.22. B is between X and A
          mun:between-symmetric R := B, S := A, T := X, from 5.17

    5.23. X and B are on the same side of line AC
          mun:segment-beyond-off-line B := C, P := X, Q := A, X := B,
            from H5, 1, 2, 5.22

    5.24. there is X ∈ 𝔼² with X is on line AB, X and B are on the same
          side of line AC, and |AX| = r
          exhibit, from 5.19, 5.21, 5.23

theorem angle-side-angle
  note        Euclid I.26, the side between the two angles. Lay off |AC| from
              D along DF to G. The triangles BAC and EDG agree in two sides
              and the angle between them, so ∠DEG = ∠ABC = ∠DEF; G and F
              are on one side of line DE, so G is on the ray EF
              (angle-construction-unique), and on line DF, and the two lines
              meet only at F.
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  let D be a point                                                    (H4)
  let E be a point                                                    (H5)
  let F be a point                                                    (H6)
  assume A, B, C form a triangle                                      (H7)
  assume D, E, F form a triangle                                      (H8)
  assume ∠CAB = ∠FDE                                                  (H9)
  assume |AB| = |DE|                                                  (H10)
  assume ∠ABC = ∠DEF                                                  (H11)
  then triangle ABC ≅ triangle DEF

1.  |AC| > 0
    axi:distance-positive P := A, Q := C, from H7

2.  G ∈ 𝔼². G is on line DF. G and F are on the same side of line DE.
    |DG| = |AC|.
    obtain G: mun:ray-point A := D, B := F, C := E, r := |AC|, from H8, 1

3.  G is not on line DE
    mun:same-side-off-line A := D, B := E, P := G, Q := F, from 2

4.  G ≠ D. G ≠ E.
    mun:off-line-apart A := D, B := E, P := G, from 3

5.  G, D, E form a triangle.
    mun:triangle-off-line P := G, Q := D, R := E, from H8, 3

6.  ∠BAC = ∠EDG
    calculation
      ∠BAC = ∠CAB       mun:angle-turned P := B, Q := A, R := C, from H7
           = ∠FDE       H9
           = ∠EDF       mun:angle-turned P := F, Q := D, R := E, from H8
           = ∠EDG       mun:angle-same-ray R := E, P := D, Q := F, X := G, from 2

7.  |BA| = |ED|
    restate H10

8.  |AC| = |DG|
    restate 2

9.  triangle BAC ≅ triangle EDG
    axi:side-angle-side P := B, Q := A, R := C, P′ := E, Q′ := D, R′ := G,
      from H7, 5, 6, 7, 8

10. ∠DEF = ∠DEG
    calculation
      ∠DEF = ∠ABC       H11
           = ∠CBA       mun:angle-turned P := A, Q := B, R := C, from H7
           = ∠GED       def:congruent, from H7, 5, 9
           = ∠DEG       mun:angle-turned P := D, Q := E, R := G, from H8, 4

11. D is on line DE. E is on line DE.
    mun:on-line-ends A := D, B := E

12. G and F are on the same side of line ED
    mun:same-side-of-line A := D, B := E, C := E, P := G, Q := F,
      from H8, 2, 11

13. F and G are on the same side of line ED
    mun:same-side-turned A := E, B := D, P := G, Q := F, from 12

14. F and F are on the same side of line ED
    mun:same-side-same A := E, B := D, P := F, Q := G, R := F, from 12, 13

15. G ∈ ray EF
    axi:angle-construction-unique A := E, B := D, C := F, D := F, E := G,
      from H8, 10, 12, 14

16. G is on line EF
    mun:ray-on-line P := G, A := E, B := F, from 15

17. D is not on line EF
    mun:triangle-not-on-line P := D, Q := E, R := F, from H8

18. G = F
    contradiction
    suppose G ≠ F                                                     (S1)

    18.1. F is on line EF
          mun:on-line-ends A := E, B := F

    18.2. line GF = line EF
          axi:line-uniqueness A := G, B := F, C := E, D := F,
            from H8, S1, 16, 18.1

    18.3. D is on line DF. F is on line DF.
          mun:on-line-ends A := D, B := F

    18.4. line GF = line DF
          axi:line-uniqueness A := G, B := F, C := D, D := F,
            from H8, S1, 2, 18.3

    18.5. line DF = line EF
          calculation
            line DF = line GF       18.4
                    = line EF       18.2

    18.6. D is on line EF
          substitute line DF = line EF (line 18.5) into line 18.3, contradicting 17

19. triangle BAC ≅ triangle EDF
    substitute G = F (line 18) into line 9

20. |AC| = |DF|. |CB| = |FE|. ∠ACB = ∠DFE.
    def:congruent, from H7, H8, 19

21. |BC| = |EF|
    restate 20

22. |CA| = |FD|
    restate 20

23. ∠BCA = ∠EFD
    calculation
      ∠BCA = ∠ACB       mun:angle-turned P := B, Q := C, R := A, from H7
           = ∠DFE       20
           = ∠EFD       mun:angle-turned P := D, Q := F, R := E, from H8

24. triangle ABC ≅ triangle DEF
    def:congruent P := A, Q := B, R := C, P′ := D, Q′ := E, R′ := F,
      from H7, H8, H9, H10, H11, 21, 22, 23

theorem angle-angle-side
  note        Euclid I.26, a side opposite one of the two angles. Lay off |BA|
              from E along ED to G. The triangles ABC and GEF agree in two
              sides and the angle between them, so ∠FGE = ∠CAB = ∠FDE. Were G
              not D, one of the two would be between E and the other, and the
              triangle they make with F would have an angle outside it equal
              to an angle inside it opposite (exterior-angle-greater-other).
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  let D be a point                                                    (H4)
  let E be a point                                                    (H5)
  let F be a point                                                    (H6)
  assume A, B, C form a triangle                                      (H7)
  assume D, E, F form a triangle                                      (H8)
  assume ∠CAB = ∠FDE                                                  (H9)
  assume ∠ABC = ∠DEF                                                  (H10)
  assume |BC| = |EF|                                                  (H11)
  then triangle ABC ≅ triangle DEF

1.  |BA| > 0
    axi:distance-positive P := B, Q := A, from H7

2.  G ∈ 𝔼². G is on line ED. G and D are on the same side of line EF.
    |EG| = |BA|.
    obtain G: mun:ray-point A := E, B := D, C := F, r := |BA|, from H8, 1

3.  G is not on line EF
    mun:same-side-off-line A := E, B := F, P := G, Q := D, from 2

4.  G ≠ E. G ≠ F.
    mun:off-line-apart A := E, B := F, P := G, from 3

5.  G, E, F form a triangle.
    mun:triangle-off-line P := G, Q := E, R := F, from H8, 3

6.  |AB| = |GE|
    restate 2

7.  ∠ABC = ∠GEF
    calculation
      ∠ABC = ∠DEF       H10
           = ∠FED       mun:angle-turned P := F, Q := E, R := D, from H8
           = ∠FEG       mun:angle-same-ray R := F, P := E, Q := D, X := G, from 2
           = ∠GEF       mun:angle-turned P := G, Q := E, R := F, from H8, 4

8.  triangle ABC ≅ triangle GEF
    axi:side-angle-side P′ := G, Q′ := E, R′ := F, from H7, H11, 5, 6, 7

9.  ∠FGE = ∠FDE
    calculation
      ∠FGE = ∠CAB       def:congruent, from H7, 5, 8
           = ∠FDE       H9

10. E is on line EF
    mun:on-line-ends A := E, B := F

11. G = D
    contradiction
    suppose G ≠ D                                                     (S1)

    11.1. G = E or (G is between E and D) or G = D or
          (D is between E and G) or (E is between G and D)
          mun:on-line-cases P := G, Q := E, R := D, from H8, 2

    11.2. ∠FGE ≠ ∠FDE
          cases, from 11.1

          case
          assume G = E                                                (C1)

          11.2.1. G ≠ E
                  restate 4, contradicting C1

          case
          assume G is between E and D                                 (C2)

          11.2.2. G is between D and E
                  mun:between-symmetric R := G, S := E, T := D, from C2

          11.2.3. F, D, G form a triangle.
                  mun:triangle-on-side P := F, Q := D, R := E, S := G,
                    from H8, 11.2.2

          11.2.4. ∠FGE > ∠FDG
                  thm:exterior-angle-greater-other A := F, B := D, C := G,
                    D := E, from 11.2.2, 11.2.3
                  requires F, G, E form a triangle: mun:triangle-on-side P := F, Q := E, R := D, S := G, from C2, H8

          11.2.5. ∠GDF = ∠EDF
                  mun:angle-along-segment P := D, Q := E, S := G, R := F,
                    from H8, 4, 11.2.2

          11.2.6. ∠FGE > ∠FDE
                  calculation
                    ∠FGE > ∠FDG       11.2.4
                         = ∠GDF       mun:angle-turned P := F, Q := D, R := G, from H8, S1, 4
                         = ∠EDF       11.2.5
                         = ∠FDE       mun:angle-turned P := E, Q := D, R := F, from H8

          11.2.7.  ∠FGE ≠ ∠FDE
                   inequalities
                     ∠FGE > ∠FDE       11.2.6
                     ∠FGE ≠ ∠FDE       weakening

          case
          assume G = D                                               (C3)

          11.2.8.  G ≠ D
                   restate S1, contradicting C3

          case
          assume D is between E and G                                 (C4)

          11.2.9.  D is between G and E
                   mun:between-symmetric R := D, S := E, T := G, from C4

          11.2.10. F, G, D form a triangle.
                   mun:triangle-on-side P := F, Q := G, R := E, S := D,
                     from 5, 11.2.9

          11.2.11. ∠FDE > ∠FGD
                   thm:exterior-angle-greater-other A := F, B := G, C := D,
                     D := E, from H8, 11.2.9, 11.2.10

          11.2.12. ∠DGF = ∠EGF
                   mun:angle-along-segment P := G, Q := E, S := D, R := F,
                     from H8, 4, 11.2.9

          11.2.13. ∠FDE > ∠FGE
                   calculation
                     ∠FDE > ∠FGD       11.2.11
                          = ∠DGF       mun:angle-turned P := F, Q := G, R := D, from H8, S1, 4
                          = ∠EGF       11.2.12
                          = ∠FGE       mun:angle-turned P := E, Q := G, R := F, from H8, 4

          11.2.14. ∠FGE ≠ ∠FDE
                   inequalities
                     ∠FDE > ∠FGE       11.2.13
                     ∠FGE < ∠FDE       restate
                     ∠FGE ≠ ∠FDE       weakening

          case
          assume E is between G and D                                 (C5)

          11.2.15. G and D are on opposite sides of line EF
                   mun:segment-across-line A := E, B := F, P := G, Q := D,
                     M := E, from C5, H8, 3, 10

          11.2.16. not (G and D are on opposite sides of line EF)
                   mun:same-not-opposite A := E, B := F, P := G, Q := D,
                     from 2, contradicting 11.2.15

    11.3. ∠FGE ≠ ∠FDE
          restate 11.2, contradicting 9

12. triangle ABC ≅ triangle DEF
    substitute G = D (line 11) into line 8

mundane theorem off-line-along
  note        Line AX, for X a point of line AB other than A, is line AB
              (line-uniqueness), so a point off the one is off the other.
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let X be a point                                                    (H3)
  let P be a point                                                    (H4)
  assume A ≠ B                                                        (H5)
  assume X is on line AB                                              (H6)
  assume X ≠ A                                                        (H7)
  assume P is not on line AB                                          (H8)
  then P is not on line AX

1.  A is on line AB
    mun:on-line-ends

2.  line AX = line AB
    axi:line-uniqueness B := X, C := A, D := B, from H5, H6, H7, 1

3.  P is not on line AX
    substitute line AX = line AB (line 2) into H8

mundane theorem crossing-triangle
  note        X is where the segment DG crosses line EF, and E is another
              point of that line: E is not on line DG, since the segment
              from D past X to G stays on X's side of line DE.
  let D be a point                                                    (H1)
  let E be a point                                                    (H2)
  let F be a point                                                    (H3)
  let G be a point                                                    (H4)
  let X be a point                                                    (H5)
  assume D, E, F form a triangle                                      (H6)
  assume X is on line EF                                              (H7)
  assume X is between D and G                                         (H8)
  assume X ≠ E                                                        (H9)
  then D, G, E form a triangle

1.  D is not on line EF
    mun:triangle-not-on-line P := D, Q := E, R := F, from H6

2.  D is not on line EX
    mun:off-line-along A := E, B := F, P := D, from H6, H7, H9, 1

3.  D, E, X form a triangle.
    mun:triangle-off-line P := D, Q := E, R := X, from H9, 2

4.  X is not on line DE
    mun:triangle-not-on-line P := X, Q := D, R := E, from 3

5.  D is on line DE
    mun:on-line-ends A := D, B := E

6.  X is between G and D
    mun:between-symmetric R := X, S := D, T := G, from H8

7.  G and X are on the same side of line DE
    mun:segment-beyond-off-line A := D, B := E, P := G, Q := D,
      from H6, 4, 5, 6

8.  G is not on line DE
    mun:same-side-off-line A := D, B := E, P := G, Q := X, from 7

9.  E is not on line DG
    mun:off-line-swap R := D, P := E, Q := G, from 8

10. D ≠ G
    mun:between-ends-apart R := X, S := D, T := G, from H8

11. E, D, G form a triangle.
    mun:triangle-off-line P := E, Q := D, R := G, from 9, 10

theorem isosceles-base-point
  note        Euclid I.5 read at a point X of the base DG: the rays DX and GX
              are the rays DG and GD, so the base angles are ∠EDX and ∠EGX.
  let D be a point                                                    (H1)
  let G be a point                                                    (H2)
  let E be a point                                                    (H3)
  let X be a point                                                    (H4)
  assume D, G, E form a triangle                                      (H5)
  assume |ED| = |EG|                                                  (H6)
  assume X is between D and G                                         (H7)
  assume E, D, X form a triangle                                      (H8)
  then ∠EDX = ∠EGX

1.  D ≠ X. G ≠ X.
    mun:between-apart R := X, S := D, T := G, from H7

2.  X is between G and D
    mun:between-symmetric R := X, S := D, T := G, from H7

3.  ∠EDX = ∠EGX
    calculation
      ∠EDX = ∠XDE       mun:angle-turned P := E, Q := D, R := X, from H8
           = ∠GDE       mun:angle-along-segment P := D, Q := G, S := X, R := E, from H5, H7, H8
           = ∠EDG       mun:angle-turned P := G, Q := D, R := E, from H5
           = ∠EGD       thm:isosceles-angles A := D, B := G, C := E, from H5, H6
           = ∠DGE       mun:angle-turned P := E, Q := G, R := D, from H5
           = ∠XGE       mun:angle-along-segment P := G, Q := D, S := X, R := E, from H5, H8, 2
           = ∠EGX       mun:angle-turned P := X, Q := G, R := E, from H5, H8, 1

theorem kite-angles
  note        D and G on two sides of line EF, each as far from E as the other
              and as far from F. The segment DG crosses line EF at X, and at X
              each of the triangles DEG and DFG has its base angles equal
              (isosceles-base-point). Where X falls on the line, at E, between
              E and F, at F or beyond one of them, ∠EDF and ∠EGF are the two
              base angles added or one taken from the other.
  let D be a point                                                    (H1)
  let E be a point                                                    (H2)
  let F be a point                                                    (H3)
  let G be a point                                                    (H4)
  assume D, E, F form a triangle                                      (H5)
  assume D and G are on opposite sides of line EF                     (H6)
  assume |ED| = |EG|                                                  (H7)
  assume |FD| = |FG|                                                  (H8)
  then ∠EDF = ∠EGF

1.  X ∈ 𝔼². X is on line EF. X is between D and G.
    obtain X: axi:plane-separation-crossing A := E, B := F, P := D, Q := G,
      from H5, H6

2.  G is not on line EF
    mun:opposite-sides-off-line A := E, B := F, P := D, Q := G, from H6

3.  G ≠ E. G ≠ F.
    mun:off-line-apart A := E, B := F, P := G, from 2

4.  D ≠ X. G ≠ X.
    mun:between-apart R := X, S := D, T := G, from 1

5.  G, E, F form a triangle.
    mun:triangle-off-line P := G, Q := E, R := F, from H5, 2

6.  D is not on line EF
    mun:triangle-not-on-line P := D, Q := E, R := F, from H5

7.  D is not on line FE
    mun:triangle-not-on-line P := D, Q := F, R := E, from H5

8.  G is not on line FE
    mun:triangle-not-on-line P := G, Q := F, R := E, from 5

9.  X = E or (X is between E and F) or X = F or (F is between E and X) or
    (E is between X and F)
    mun:on-line-cases P := X, Q := E, R := F, from H5, 1

10. ∠EDF = ∠EGF
    cases, from 9

    case
    assume X = E                                                      (C1)

    10.1.  E is between D and G
           substitute X = E (C1) into line 1

    10.2.  E is on line FE
           mun:on-line-ends A := F, B := E

    10.3.  D, G, F form a triangle.
           mun:crossing-triangle E := F, F := E, X := E,
             from H5, 10.1, 10.2

    10.4.  ∠EDF = ∠EGF
           calculation
             ∠EDF = ∠FDE       mun:angle-turned P := E, Q := D, R := F, from H5
                  = ∠FGE       thm:isosceles-base-point E := F, X := E, from H5, H8, 10.1, 10.3
                  = ∠EGF       mun:angle-turned P := F, Q := G, R := E, from H5, 3

    case
    assume X is between E and F                                       (C2)

    10.5.  E ≠ X. F ≠ X.
           mun:between-apart R := X, S := E, T := F, from C2

    10.6.  D, G, E form a triangle.
           mun:crossing-triangle, from H5, 1, 10.5

    10.7.  F, X, E are collinear.
           mun:between-collinear R := X, S := E, T := F, from C2

    10.8.  X is on line FE
           def:on-line P := X, A := F, B := E, from 10.7

    10.9.  D, G, F form a triangle.
           mun:crossing-triangle E := F, F := E, from H5, 1, 10.5, 10.8

    10.10. ∠EDX = ∠EGX
           thm:isosceles-base-point, from H7, 1, 10.6
           requires E, D, X form a triangle: mun:triangle-on-side P := D, Q := E, R := F, S := X, from C2, H5

    10.11. ∠FDX = ∠FGX
           thm:isosceles-base-point E := F, from H8, 1, 10.9
           requires X is between F and E: mun:between-symmetric R := X, S := E, T := F, from C2
           requires F, D, X form a triangle: mun:triangle-on-side P := D, Q := F, R := E, S := X, from H5

    10.12. ∠EDX + ∠XDF = ∠EDF
           mun:angle-addition A := E, B := F, C := D, M := X, from C2, H5, 4

    10.13. ∠EGX + ∠XGF = ∠EGF
           mun:angle-addition A := E, B := F, C := G, M := X, from C2, 4, 5

    10.14. ∠XDF = ∠FDX
           mun:angle-turned P := X, Q := D, R := F, from H5, 4, 10.5

    10.15. ∠XGF = ∠FGX
           mun:angle-turned P := X, Q := G, R := F, from 3, 4, 10.5

    10.16. ∠EDF = ∠EGF
           algebra, from 10.10, 10.11, 10.12, 10.13, 10.14, 10.15

    case
    assume X = F                                                      (C3)

    10.17. F is between D and G
           substitute X = F (C3) into line 1

    10.18. F is on line EF
           mun:on-line-ends A := E, B := F

    10.19. D, G, E form a triangle.
           mun:crossing-triangle X := F, from H5, 10.17, 10.18

    10.20. ∠EDF = ∠EGF
           thm:isosceles-base-point X := F, from H5, H7, 10.17, 10.19

    case
    assume F is between E and X                                       (C4)

    10.21. E ≠ X
           mun:between-ends-apart R := F, S := E, T := X, from C4

    10.22. E ≠ F. X ≠ F.
           mun:between-apart R := F, S := E, T := X, from C4

    10.23. D, G, E form a triangle.
           mun:crossing-triangle, from H5, 1, 10.21

    10.24. X, F, E are collinear.
           mun:between-collinear R := F, S := E, T := X, from C4

    10.25. X is on line FE
           def:on-line P := X, A := F, B := E, from 10.24

    10.26. D, G, F form a triangle.
           mun:crossing-triangle E := F, F := E, from H5, 1, 10.22, 10.25

    10.27. ∠EDX = ∠EGX
           thm:isosceles-base-point, from H7, 1, 10.23
           requires D is not on line EX: mun:off-line-along A := E, B := F, P := D, from H5, 1, 6, 10.21
           requires E, D, X form a triangle: mun:triangle-off-line P := D, Q := E, R := X, from 10.21

    10.28. ∠FDX = ∠FGX
           thm:isosceles-base-point E := F, from H8, 1, 10.26
           requires F, D, X form a triangle: mun:triangle-extension P := D, Q := F, R := E, S := X, from C4, H5

    10.29. D is not on line EX
           mun:off-line-along A := E, B := F, P := D, from H5, 1, 6, 10.21

    10.30. D, E, X form a triangle.
           mun:triangle-off-line P := D, Q := E, R := X, from 10.21, 10.29

    10.31. G is not on line EX
           mun:off-line-along A := E, B := F, P := G, from H5, 1, 2, 10.21

    10.32. G, E, X form a triangle.
           mun:triangle-off-line P := G, Q := E, R := X, from 10.21, 10.31

    10.33. ∠EDF + ∠FDX = ∠EDX
           mun:angle-addition A := E, B := X, C := D, M := F, from C4, H5, 10.30

    10.34. ∠EGF + ∠FGX = ∠EGX
           mun:angle-addition A := E, B := X, C := G, M := F, from C4, 3, 10.32

    10.35. ∠EDF = ∠EGF
           algebra, from 10.27, 10.28, 10.33, 10.34

    case
    assume E is between X and F                                       (C5)

    10.36. X ≠ E. F ≠ E.
           mun:between-apart R := E, S := X, T := F, from C5

    10.37. X ≠ F
           mun:between-ends-apart R := E, S := X, T := F, from C5

    10.38. D, G, E form a triangle.
           mun:crossing-triangle, from H5, 1, 10.36

    10.39. F, E, X are collinear.
           mun:between-collinear R := E, S := X, T := F, from C5

    10.40. X is on line FE
           def:on-line P := X, A := F, B := E, from 10.39

    10.41. D, G, F form a triangle.
           mun:crossing-triangle E := F, F := E, from H5, 1, 10.37, 10.40

    10.42. ∠EDX = ∠EGX
           thm:isosceles-base-point, from H7, 1, 10.38
           requires E is between F and X: mun:between-symmetric R := E, S := X, T := F, from C5
           requires E, D, X form a triangle: mun:triangle-extension P := D, Q := E, R := F, S := X, from H5

    10.43. ∠FDX = ∠FGX
           thm:isosceles-base-point E := F, from H8, 1, 10.41
           requires D is not on line FX: mun:off-line-along A := F, B := E, P := D, from H5, 7, 10.37, 10.40
           requires F, D, X form a triangle: mun:triangle-off-line P := D, Q := F, R := X, from 10.37

    10.44. D is not on line FX
           mun:off-line-along A := F, B := E, P := D, from H5, 7, 10.37, 10.40

    10.45. D, F, X form a triangle.
           mun:triangle-off-line P := D, Q := F, R := X, from 10.37, 10.44

    10.46. G is not on line FX
           mun:off-line-along A := F, B := E, P := G, from H5, 8, 10.37, 10.40

    10.47. G, F, X form a triangle.
           mun:triangle-off-line P := G, Q := F, R := X, from 10.37, 10.46

    10.48. ∠XDE + ∠EDF = ∠XDF
           mun:angle-addition A := X, B := F, C := D, M := E, from C5, H5, 10.45

    10.49. ∠XGE + ∠EGF = ∠XGF
           mun:angle-addition A := X, B := F, C := G, M := E, from C5, 3, 10.47

    10.50. ∠XDE = ∠EDX
           mun:angle-turned P := X, Q := D, R := E, from H5, 4, 10.36

    10.51. ∠XGE = ∠EGX
           mun:angle-turned P := X, Q := G, R := E, from 3, 4, 10.36

    10.52. ∠XDF = ∠FDX
           mun:angle-turned P := X, Q := D, R := F, from H5, 4, 10.37

    10.53. ∠XGF = ∠FGX
           mun:angle-turned P := X, Q := G, R := F, from 3, 4, 10.37

    10.54. ∠EDF = ∠EGF
           algebra, from 10.42, 10.43, 10.48, 10.49, 10.50, 10.51, 10.52,
             10.53

theorem side-side-side
  note        Euclid I.8, by SMSG's way. Copy the angle at B to E on the other
              side of line EF from D, and lay off |BA| along its arm to G. The
              triangles ABC and GEF agree in two sides and the angle between
              them, so G is as far from E and from F as D is, and the kite
              DEGF has ∠EDF = ∠EGF (kite-angles); then DEF and GEF agree in two
              sides and the angle between them too.
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  let D be a point                                                    (H4)
  let E be a point                                                    (H5)
  let F be a point                                                    (H6)
  assume A, B, C form a triangle                                      (H7)
  assume D, E, F form a triangle                                      (H8)
  assume |AB| = |DE|                                                  (H9)
  assume |BC| = |EF|                                                  (H10)
  assume |CA| = |FD|                                                  (H11)
  then triangle ABC ≅ triangle DEF

1.  |DE| > 0
    axi:distance-positive P := D, Q := E, from H8

2.  H ∈ 𝔼². E is between D and H. |EH| = |DE|.
    obtain H: mun:segment-extension A := D, B := E, r := |DE|, from H8, 1

3.  E is on line EF
    mun:on-line-ends A := E, B := F

4.  D is not on line EF
    mun:triangle-not-on-line P := D, Q := E, R := F, from H8

5.  D and H are on opposite sides of line EF
    mun:segment-across-line A := E, B := F, P := D, Q := H, M := E,
      from H8, 2, 3, 4

6.  H is not on line EF
    mun:opposite-sides-off-line A := E, B := F, P := D, Q := H, from 5

7.  H, E, F form a triangle.
    mun:triangle-off-line P := H, Q := E, R := F, from H8, 6

8.  ∠ABC > 0°. ∠ABC < 180°.
    axi:angle-measure, from H7

9.  G′ ∈ 𝔼². G′ and H are on the same side of line EF. ∠FEG′ = ∠ABC.
    obtain G′: axi:angle-construction A := E, B := F, C := H, x := ∠ABC,
      from 7, 8

10. G′ is not on line EF
    mun:same-side-off-line A := E, B := F, P := G′, Q := H, from 9

11. G′, E, F form a triangle.
    mun:triangle-off-line P := G′, Q := E, R := F, from H8, 10

12. |BA| > 0
    axi:distance-positive P := B, Q := A, from H7

13. G ∈ 𝔼². G is on line EG′. G and G′ are on the same side of line EF.
    |EG| = |BA|.
    obtain G: mun:ray-point A := E, B := G′, C := F, r := |BA|, from 11, 12

14. G and H are on the same side of line EF
    mun:same-side-same A := E, B := F, P := G, Q := G′, R := H, from 9, 13

15. H and D are on opposite sides of line EF
    mun:opposite-sides-turned A := E, B := F, P := D, Q := H, from 5

16. G and D are on opposite sides of line EF
    mun:same-opposite-opposite A := E, B := F, P := G, Q := H, R := D,
      from 14, 15

17. D and G are on opposite sides of line EF
    mun:opposite-sides-turned A := E, B := F, P := G, Q := D, from 16

18. G is not on line EF
    mun:same-side-off-line A := E, B := F, P := G, Q := H, from 14

19. G ≠ E. G ≠ F.
    mun:off-line-apart A := E, B := F, P := G, from 18

20. G, E, F form a triangle.
    mun:triangle-off-line P := G, Q := E, R := F, from H8, 18

21. ∠FEG = ∠GEF
    mun:angle-turned P := F, Q := E, R := G, from H8, 19

22. ∠ABC = ∠GEF
    calculation
      ∠ABC = ∠FEG′      9
           = ∠FEG       mun:angle-same-ray R := F, P := E, Q := G′, X := G, from 13
           = ∠GEF       21

23. |AB| = |GE|
    restate 13

24. triangle ABC ≅ triangle GEF
    axi:side-angle-side P′ := G, Q′ := E, R′ := F, from H7, H10, 20, 22, 23

25. |CA| = |FG|. ∠BCA = ∠EFG. ∠CAB = ∠FGE.
    def:congruent, from H7, 20, 24

26. |ED| = |EG|
    transitivity, from H9, 13

27. |FD| = |FG|
    transitivity, from H11, 25

28. ∠EDF = ∠EGF
    thm:kite-angles, from H8, 17, 26, 27

29. |DF| = |GF|
    restate 27

30. triangle EDF ≅ triangle EGF
    axi:side-angle-side P := E, Q := D, R := F, P′ := E, Q′ := G, R′ := F,
      from H8, 20, 26, 28, 29

31. ∠DFE = ∠GFE. ∠FED = ∠FEG.
    def:congruent, from H8, 20, 30

32. ∠ABC = ∠DEF
    calculation
      ∠ABC = ∠GEF       22
           = ∠FEG       21
           = ∠FED       31
           = ∠DEF       mun:angle-turned P := F, Q := E, R := D, from H8

33. ∠BCA = ∠EFD
    calculation
      ∠BCA = ∠EFG       25
           = ∠GFE       mun:angle-turned P := E, Q := F, R := G, from H8, 19
           = ∠DFE       31
           = ∠EFD       mun:angle-turned P := D, Q := F, R := E, from H8

34. ∠CAB = ∠FDE
    calculation
      ∠CAB = ∠FGE       25
           = ∠EGF       mun:angle-turned P := F, Q := G, R := E, from H8, 19
           = ∠EDF       28
           = ∠FDE       mun:angle-turned P := E, Q := D, R := F, from H8

35. triangle ABC ≅ triangle DEF
    def:congruent P := A, Q := B, R := C, P′ := D, Q′ := E, R′ := F,
      from H7, H8, H9, H10, H11, 32, 33, 34

mundane theorem right-angle-along
  note        A right angle at H to one point of a line through H is a right
              angle to every other: the point is on the same ray, or on the
              ray opposite, whose angle is the supplement.
  let P be a point                                                    (H1)
  let H be a point                                                    (H2)
  let S be a point                                                    (H3)
  let T be a point                                                    (H4)
  assume P ≠ H                                                        (H5)
  assume S ≠ H                                                        (H6)
  assume ∠PHS = 90°                                                   (H7)
  assume T is on line HS                                              (H8)
  assume T ≠ H                                                        (H9)
  assume P ≠ S                                                        (H10)
  assume P, H, T form a triangle                                      (H11)
  then ∠PHT = 90°

1.  T = H or (T is between H and S) or T = S or (S is between H and T) or
    (H is between T and S)
    mun:on-line-cases P := T, Q := H, R := S, from H6, H8

2.  ∠PHT = ∠THP
    mun:angle-turned Q := H, R := T, from H11

3.  ∠SHP = ∠PHS
    mun:angle-turned P := S, Q := H, R := P, from H5, H6, H10

4.  ∠PHT = 90°
    cases, from 1

    case
    assume T = H                                                      (C1)

    4.1.  T ≠ H
          restate H9, contradicting C1

    case
    assume T is between H and S                                       (C2)

    4.2.  ∠PHT = 90°
          calculation
            ∠PHT = ∠THP       2
                 = ∠SHP       mun:angle-along-segment P := H, Q := S, S := T, R := P, from C2, H10, H11
                 = ∠PHS       3
                 = 90°        H7

    case
    assume T = S                                                      (C3)

    4.3.  ∠PHT = 90°
          substitute T = S (C3) into H7

    case
    assume S is between H and T                                       (C4)

    4.4.  ∠PHT = 90°
          calculation
            ∠PHT = ∠THP       2
                 = ∠SHP       mun:angle-along-segment P := H, Q := T, R := P, from C4, H10, H11
                 = ∠PHS       3
                 = 90°        H7

    case
    assume H is between T and S                                       (C5)

    4.5.  ∠THP + ∠PHS = 180°
          axi:supplementary-angles A := T, B := H, C := S, D := P, from C5, H10, H11

    4.6.  ∠PHT = 90°
          algebra, from H7, 2, 4.5

mundane theorem height-area
  note        The area postulate with the height read off a right angle at its
              foot H: the lines PH and HS are perpendicular, and line HS is
              line QR.
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  let H be a point                                                    (H4)
  let S be a point                                                    (H5)
  assume P, Q, R form a triangle                                      (H6)
  assume H is on line QR                                              (H7)
  assume S is on line QR                                              (H8)
  assume S ≠ H                                                        (H9)
  assume P ≠ H                                                        (H10)
  assume P ≠ S                                                        (H11)
  assume ∠PHS = 90°                                                   (H12)
  then the area of △PQR = (1/2)·|QR|·|PH|

1.  line HP ⊥ line HS
    mun:perpendicular-by-right-angle Q := H, R := S, from H9, H10, H11, H12

2.  line PH ⊥ line HS
    mun:perpendicular-turned A := H, B := P, C := H, D := S, from 1

3.  line HS = line QR
    axi:line-uniqueness A := H, B := S, C := Q, D := R, from H6, H7, H8, H9

4.  Q is on line QR. R is on line QR.
    mun:on-line-ends A := Q, B := R

5.  Q is on line HS
    substitute line HS = line QR (line 3) into line 4

6.  R is on line HS
    substitute line HS = line QR (line 3) into line 4

7.  line PH ⊥ line QR
    mun:perpendicular-along A := P, B := H, C := H, D := S, E := Q, F := R,
      from H6, 2, 5, 6

8.  the area of △PQR = (1/2)·|QR|·|PH|
    axi:area-base-height, from H6, H7, 7

mundane theorem foot
  note        The foot H of the perpendicular from P to line QR, with a second
              point S of the line to read the right angle against: Q, unless
              H is Q, and then R.
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  assume P, Q, R form a triangle                                      (H4)
  then there are H, S ∈ 𝔼² with H is on line QR, S is on line QR, S ≠ H, P ≠ H, P ≠ S, and ∠PHS = 90°

1.  H ∈ 𝔼². H is on line QR. P ≠ H. If H ≠ Q then ∠PHQ = 90°.
    If H ≠ R then ∠PHR = 90°.
    obtain H: thm:perpendicular-foot, from H4

2.  Q is on line QR. R is on line QR.
    mun:on-line-ends A := Q, B := R

3.  H = Q or not (H = Q)
    axi:excluded-middle P := H = Q

4.  there are H, S ∈ 𝔼² with H is on line QR, S is on line QR, S ≠ H,
    P ≠ H, P ≠ S, and ∠PHS = 90°
    cases, from 3

    case
    assume H = Q                                                      (C1)

    4.1.  H ≠ R
          contradiction
          suppose H = R                                               (S1)

          4.1.1.  Q = R
                  calculation, contradicting H4
                    Q = H       C1
                      = R       S1

    4.2.  ∠PHR = 90°
          mun:modus-ponens, from 1, 4.1

    4.3.  there are H, S ∈ 𝔼² with H is on line QR, S is on line QR,
          S ≠ H, P ≠ H, P ≠ S, and ∠PHS = 90°
          exhibit, from H4, 1, 2, 4.1, 4.2

    case
    assume not (H = Q)                                                (C2)

    4.4.  ∠PHQ = 90°
          mun:modus-ponens, from C2, 1

    4.5.  there are H, S ∈ 𝔼² with H is on line QR, S is on line QR,
          S ≠ H, P ≠ H, P ≠ S, and ∠PHS = 90°
          exhibit, from C2, H4, 1, 2, 4.4

mundane theorem parallel-off
  note        Two parallel lines that are not one line share no point, so a
              point of the one is off the other.
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  let D be a point                                                    (H4)
  let X be a point                                                    (H5)
  assume A ≠ B                                                        (H6)
  assume C ≠ D                                                        (H7)
  assume line AB ∥ line CD                                            (H8)
  assume A is not on line CD                                          (H9)
  assume X is on line AB                                              (H10)
  then X is not on line CD

1.  line AB = line CD or not (there is Y ∈ 𝔼² with Y is on line AB and
    Y is on line CD)
    def:parallel, from H6, H7, H8

2.  A is on line AB
    mun:on-line-ends

3.  not (line AB = line CD)
    contradiction
    suppose line AB = line CD                                         (S1)

    3.1.  A is on line CD
          substitute line AB = line CD (S1) into line 2, contradicting H9

4.  not (there is Y ∈ 𝔼² with Y is on line AB and Y is on line CD)
    mun:disjunctive-syllogism-left, from 1, 3

5.  X is not on line CD
    contradiction
    suppose X is on line CD                                           (S2)

    5.1.  there is Y ∈ 𝔼² with Y is on line AB and Y is on line CD
          exhibit, from H10, S2, contradicting 4

mundane theorem parallel-same-side
  note        A segment between two points of one of two parallel lines
              never meets the other, so the two points are on one side of
              it (plane-separation-crossing).
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  let D be a point                                                    (H4)
  let X be a point                                                    (H5)
  assume A ≠ B                                                        (H6)
  assume C ≠ D                                                        (H7)
  assume line AB ∥ line CD                                            (H8)
  assume A is not on line CD                                          (H9)
  assume X is on line AB                                              (H10)
  assume X ≠ A                                                        (H11)
  then X and A are on the same side of line CD

1.  X is not on line CD
    mun:parallel-off, from H6, H7, H8, H9, H10

2.  X and A are on the same side of line CD or X and A are on opposite
    sides of line CD
    axi:plane-separation A := C, B := D, P := X, Q := A, from H7, H9, 1

3.  A is on line AB
    mun:on-line-ends

4.  line AX = line AB
    axi:line-uniqueness B := X, C := A, D := B, from H6, H10, H11, 3

5.  not (X and A are on opposite sides of line CD)
    contradiction
    suppose X and A are on opposite sides of line CD                  (S1)

    5.1.  Y ∈ 𝔼². Y is on line CD. Y is between X and A.
          obtain Y: axi:plane-separation-crossing A := C, B := D, P := X,
            Q := A, from H7, S1

    5.2.  A, Y, X are collinear.
          mun:between-collinear R := Y, S := X, T := A, from 5.1

    5.3.  Y is on line AX
          def:on-line P := Y, B := X, from 5.2

    5.4.  Y is on line AB
          substitute line AX = line AB (line 4) into line 5.3

    5.5.  Y is not on line CD
          mun:parallel-off X := Y, from H6, H7, H8, H9, 5.4,
            contradicting 5.1

6.  X and A are on the same side of line CD
    mun:disjunctive-syllogism, from 2, 5

theorem parallel-equidistant
  note        A and B on a line parallel to line HK, with right angles at H
              and K. Let M be the midpoint of AK and produce HM past M to Z
              with MZ = HM. The triangles HMK and ZMA, and HMA and ZMK, agree
              in two sides and the vertical angles between them, so |ZK| =
              |AH|, line AZ is parallel to line HK and so is line AB, and
              line ZK is parallel to line HA, which makes ∠HKZ a right angle.
              Then Z is the point of line AB where the perpendicular at K
              meets it, which is B.
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let H be a point                                                    (H3)
  let K be a point                                                    (H4)
  assume A ≠ B                                                        (H5)
  assume A and B are on the same side of line HK                      (H6)
  assume line AB ∥ line HK                                            (H7)
  assume ∠AHK = 90°                                                   (H8)
  assume ∠BKH = 90°                                                   (H9)
  then |AH| = |BK|

1.  H ≠ K. A is not on line HK. B is not on line HK.
    mun:same-side-off-line A := H, B := K, P := A, Q := B, from H6

2.  A ≠ H. A ≠ K.
    mun:off-line-apart A := H, B := K, P := A, from 1

3.  B ≠ H. B ≠ K.
    mun:off-line-apart A := H, B := K, P := B, from 1

4.  M ∈ 𝔼². M is the midpoint of AK.
    obtain M: mun:midpoint-exists B := K, from 2

5.  M is between A and K. |AM| = |MK|.
    def:midpoint B := K, from 4

6.  H is on line HK. K is on line HK.
    mun:on-line-ends A := H, B := K

7.  M and A are on the same side of line HK
    mun:segment-off-line A := H, B := K, P := A, Q := K, X := M,
      from 1, 5, 6

8.  M is not on line HK
    mun:same-side-off-line A := H, B := K, P := M, Q := A, from 7

9.  H ≠ M
    mun:on-off-apart A := H, B := K, X := H, Y := M, from 6, 8

10. |HM| > 0
    axi:distance-positive P := H, Q := M, from 9

11. Z ∈ 𝔼². M is between H and Z. |MZ| = |HM|.
    obtain Z: mun:segment-extension A := H, B := M, r := |HM|, from 9, 10

12. M is between K and A
    mun:between-symmetric R := M, S := A, T := K, from 5

13. M, H, K form a triangle.
    mun:triangle-off-line P := M, Q := H, R := K, from 1, 8

14. H, M, A form a triangle.
    mun:triangle-extension P := H, Q := M, R := K, S := A, from 12, 13

15. K, M, Z form a triangle.
    mun:triangle-extension P := K, Q := M, R := H, S := Z, from 11, 13

16. A, M, Z form a triangle.
    mun:triangle-extension P := A, Q := M, R := H, S := Z, from 11, 14

17. ∠HMK = ∠ZMA
    thm:vertical-angles A := H, B := K, C := Z, D := A, O := M, from 11, 12, 13, 16

18. ∠HMA = ∠ZMK
    thm:vertical-angles A := H, B := A, C := Z, D := K, O := M, from 5, 11, 14, 15

19. |HM| = |ZM|
    restate 11

20. |MK| = |MA|
    restate 5

21. triangle HMK ≅ triangle ZMA
    axi:side-angle-side P := H, Q := M, R := K, P′ := Z, Q′ := M, R′ := A,
      from 13, 16, 17, 19, 20

22. |KH| = |AZ|. ∠MKH = ∠MAZ.
    def:congruent, from 13, 16, 21

23. triangle HMA ≅ triangle ZMK
    axi:side-angle-side P := H, Q := M, R := A, P′ := Z, Q′ := M, R′ := K,
      from 14, 15, 18, 19, 20

24. |AH| = |KZ|. ∠MAH = ∠MKZ. ∠AHM = ∠KZM.
    def:congruent, from 14, 15, 23

25. ∠ZAK = ∠AKH
    calculation
      ∠ZAK = ∠KAZ       mun:angle-turned P := K, Q := A, R := Z, from 2, 15, 16
           = ∠MAZ       mun:angle-along-segment P := A, Q := K, S := M, R := Z, from 5, 15, 16
           = ∠MKH       22
           = ∠AKH       mun:angle-along-segment P := K, Q := A, S := M, R := H, from 1, 2, 9, 12

26. A, H, K form a triangle.
    mun:triangle-off-line P := A, Q := H, R := K, from 1

27. H is not on line AK
    mun:triangle-not-on-line P := H, Q := A, R := K, from 26

28. K, M, A are collinear.
    mun:between-collinear R := M, S := A, T := K, from 5

29. M is on line AK
    def:on-line P := M, B := K, from 28

30. H and Z are on opposite sides of line AK
    mun:segment-across-line B := K, P := H, Q := Z,
      from 2, 11, 27, 29

31. Z and H are on opposite sides of line AK
    mun:opposite-sides-turned B := K, P := H, Q := Z, from 30

32. line AZ ∥ line KH
    thm:alternate-angles-converse P := K, Q := H, R := A, S := Z,
      from 25, 26, 31

33. B is on line AB
    mun:on-line-ends

34. line AB ∥ line KH
    mun:parallel-along C := H, D := K, E := B, from H5, H7, 33

35. A is not on line KH
    mun:triangle-not-on-line P := A, Q := K, R := H, from 26

36. line AZ = line AB
    axi:parallel-uniqueness A := K, B := H, P := A, C := Z, D := B,
      from H5, 1, 16, 32, 34, 35

37. A is on line AZ. Z is on line AZ.
    mun:on-line-ends B := Z

38. Z is on line AB
    substitute line AZ = line AB (line 36) into line 37

39. Z and A are on the same side of line HK
    mun:parallel-same-side C := H, D := K, X := Z, from H5, H7, 1, 16, 38

40. Z and B are on the same side of line HK
    mun:same-side-same A := H, B := K, P := Z, Q := A, R := B, from H6, 39

41. H ≠ Z
    mun:between-ends-apart R := M, S := H, T := Z, from 11

42. M is between Z and H
    mun:between-symmetric R := M, S := H, T := Z, from 11

43. H, M, Z are collinear.
    mun:between-collinear R := M, S := H, T := Z, from 11

44. Z is on line HM
    def:on-line P := Z, A := H, B := M, from 43

45. A is not on line HM
    mun:triangle-not-on-line P := A, Q := H, R := M, from 14

46. A is not on line HZ
    mun:off-line-along A := H, B := M, X := Z, P := A, from 9, 41, 44, 45

47. M is on line HZ
    def:on-line P := M, A := H, B := Z, from 43

48. A and K are on opposite sides of line HZ
    mun:segment-across-line A := H, B := Z, P := A, Q := K,
      from 5, 41, 46, 47

49. K is not on line ZM
    mun:triangle-not-on-line P := K, Q := Z, R := M, from 15

50. H is on line ZM
    def:on-line P := H, A := Z, B := M, from 43

51. K is not on line ZH
    mun:off-line-along A := Z, B := M, X := H, P := K, from 15, 41, 49, 50

52. K, Z, H form a triangle.
    mun:triangle-off-line P := K, Q := Z, R := H, from 41, 51

53. ∠AHZ = ∠HZK
    calculation
      ∠AHZ = ∠ZHA       mun:angle-turned P := A, Q := H, R := Z, from 2, 16, 41
           = ∠MHA       mun:angle-along-segment P := H, Q := Z, S := M, R := A, from 2, 11, 16
           = ∠AHM       mun:angle-turned P := A, Q := H, R := M, from 2, 9, 16
           = ∠KZM       24
           = ∠MZK       mun:angle-turned P := K, Q := Z, R := M, from 15
           = ∠HZK       mun:angle-along-segment P := Z, Q := H, S := M, R := K, from 1, 15, 42

54. line HA ∥ line ZK
    thm:alternate-angles-converse P := Z, Q := K, R := H, S := A,
      from 48, 52, 53

55. H is on line HA. A is on line HA.
    mun:on-line-ends A := H, B := A

56. line HA ∥ line KZ
    mun:parallel-along A := H, B := A, C := Z, D := K, E := A, from 2, 54, 55

57. line KZ ∥ line HA
    mun:parallel-turned A := H, B := A, C := K, D := Z, from 2, 56

58. |ZK| > 0
    axi:distance-positive P := Z, Q := K, from 15

59. W ∈ 𝔼². K is between Z and W. |KW| = |ZK|.
    obtain W: mun:segment-extension A := Z, B := K, r := |ZK|, from 15, 58

60. Z ≠ K. W ≠ K.
    mun:between-apart R := K, S := Z, T := W, from 59

61. W, K, Z are collinear.
    mun:between-collinear R := K, S := Z, T := W, from 59

62. W is on line KZ
    def:on-line P := W, A := K, B := Z, from 61

63. line KW ∥ line AH
    mun:parallel-along A := K, B := Z, C := H, D := A, E := W,
      from 57, 60, 62

64. W is on line KW
    mun:on-line-ends A := K, B := W

65. line KW ∥ line HA
    mun:parallel-along A := K, B := W, C := A, D := H, E := W,
      from 60, 63, 64

66. Z is not on line HK
    mun:same-side-off-line A := H, B := K, P := Z, Q := A, from 39

67. Z and W are on opposite sides of line HK
    mun:segment-across-line A := H, B := K, P := Z, Q := W, M := K,
      from 1, 6, 59, 66

68.  A and Z are on the same side of line HK
     mun:same-side-turned A := H, B := K, P := Z, Q := A, from 39

69.  A and W are on opposite sides of line HK
     mun:same-opposite-opposite A := H, B := K, P := A, Q := Z, R := W,
       from 67, 68

70.  W and A are on opposite sides of line HK
     mun:opposite-sides-turned A := H, B := K, P := A, Q := W, from 69

71.  W and A are on opposite sides of line KH
     mun:opposite-sides-of-line A := H, B := K, C := K, D := H, P := W,
       Q := A, from 1, 6, 70

72.  ∠WKH = ∠KHA
     thm:alternate-angles P := H, Q := A, R := K, S := W, from 26, 65, 71

73.  ∠KHA = ∠AHK
     mun:angle-turned P := K, Q := H, R := A, from 1, 2

74.  ∠ZKH + ∠HKW = 180°
     axi:supplementary-angles A := Z, B := K, C := W, D := H, from 1, 59
     requires H ≠ Z: mun:off-line-apart A := H, B := K, P := Z, from 66
     requires W is not on line HK: mun:opposite-sides-off-line A := H, B := K, P := Z, Q := W, from 67
     requires H ≠ W: mun:off-line-apart A := H, B := K, P := W

75.  ∠HKW = ∠WKH
     mun:angle-turned P := H, Q := K, R := W, from 1, 60
     requires W is not on line HK: mun:opposite-sides-off-line A := H, B := K, P := Z, Q := W, from 67
     requires H ≠ W: mun:off-line-apart A := H, B := K, P := W

76.  ∠HKZ = ∠ZKH
     mun:angle-turned P := H, Q := K, R := Z, from 1, 60
     requires H ≠ Z: mun:off-line-apart A := H, B := K, P := Z, from 66

77.  ∠HKB = ∠HKZ
     calculation
       ∠HKB = ∠BKH       mun:angle-turned P := H, Q := K, R := B, from 1, 3
            = 90°        H9
            = ∠HKZ       algebra, from H8, 72, 73, 74, 75, 76
     requires Z ≠ H: mun:between-ends-apart R := M, S := H, T := Z, from 11

78.  B, H, K form a triangle.
     mun:triangle-off-line P := B, Q := H, R := K, from 1

79.  Z and B are on the same side of line KH
     mun:same-side-of-line A := H, B := K, C := K, D := H, P := Z, Q := B,
       from 1, 6, 40

80.  B and Z are on the same side of line KH
     mun:same-side-turned A := K, B := H, P := Z, Q := B, from 79

81.  B and B are on the same side of line KH
     mun:same-side-same A := K, B := H, P := B, Q := Z, R := B, from 79, 80

82.  Z ∈ ray KB
     axi:angle-construction-unique A := K, B := H, C := B, D := B, E := Z,
       from 77, 78, 79, 81

83.  Z is on line KB
     mun:ray-on-line P := Z, A := K, from 82

84.  Z = B
     contradiction
     suppose Z ≠ B                                                    (S1)

     84.1.  line ZB = line AB
            axi:line-uniqueness A := Z, C := A, D := B,
              from H5, S1, 33, 38

     84.2.  K is on line KB. B is on line KB.
            mun:on-line-ends A := K

     84.3.  line ZB = line KB
            axi:line-uniqueness A := Z, C := K, D := B,
              from S1, 3, 83, 84.2

     84.4.  line AB = line KB
            calculation
              line AB = line ZB       84.1
                      = line KB       84.3

     84.5.  K is on line AB
            substitute line AB = line KB (line 84.4) into line 84.2

     84.6.  K is not on line HK
            mun:parallel-off C := H, D := K, X := K, from H5, H7, 1, 84.5,
              contradicting 6

85.  |AH| = |KB|
     substitute Z = B (line 84) into line 24

86.  |AH| = |BK|
     restate 85

mundane theorem area-turned
  note        Both are half the base QR times the height from P, at the one
              foot of the perpendicular.
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  assume P, Q, R form a triangle                                      (H4)
  then the area of △PQR = the area of △PRQ

1.  H ∈ 𝔼². S ∈ 𝔼². H is on line QR. S is on line QR. S ≠ H. P ≠ H.
    P ≠ S. ∠PHS = 90°.
    obtain H, S: mun:foot, from H4

2.  Q, R, H are collinear.
    def:on-line P := H, A := Q, B := R, from 1

3.  H is on line RQ
    def:on-line P := H, A := R, B := Q, from 2

4.  Q, R, S are collinear.
    def:on-line P := S, A := Q, B := R, from 1

5.  S is on line RQ
    def:on-line P := S, A := R, B := Q, from 4

6.  the area of △PQR = the area of △PRQ
    calculation
      the area of △PQR = (1/2)·|QR|·|PH|       mun:height-area, from H4, 1
                       = (1/2)·|RQ|·|PH|       algebra
                       = the area of △PRQ      mun:height-area Q := R, R := Q, from H4, 1, 3, 5

theorem same-height
  note        Euclid VI.1, by the height: a triangle with apex P and its base
              QS on line QR has the height of PQR, at the one foot H.
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  let S be a point                                                    (H4)
  let H be a point                                                    (H5)
  let T be a point                                                    (H6)
  assume P, Q, R form a triangle                                      (H7)
  assume S is on line QR                                              (H8)
  assume S ≠ Q                                                        (H9)
  assume H is on line QR                                              (H10)
  assume T is on line QR                                              (H11)
  assume T ≠ H                                                        (H12)
  assume P ≠ H                                                        (H13)
  assume P ≠ T                                                        (H14)
  assume ∠PHT = 90°                                                   (H15)
  then the area of △PQS = (1/2)·|QS|·|PH|

1.  Q is on line QR
    mun:on-line-ends A := Q, B := R

2.  line QS = line QR
    axi:line-uniqueness A := Q, B := S, C := Q, D := R, from H7, H8, H9, 1

3.  H is on line QS
    substitute line QS = line QR (line 2) into H10

4.  T is on line QS
    substitute line QS = line QR (line 2) into H11

5.  P is not on line QR
    mun:triangle-not-on-line, from H7

6.  P is not on line QS
    mun:off-line-along A := Q, B := R, X := S, from H7, H8, H9, 5

7.  P, Q, S form a triangle.
    mun:triangle-off-line R := S, from H9, 6

8.  the area of △PQS = (1/2)·|QS|·|PH|
    mun:height-area R := S, S := T, from H12, H13, H14, H15, 3, 4, 7

theorem parallel-heights
  note        Q and R on a line parallel to line XY have one height above it:
              the feet H and K of their perpendiculars are two points, since
              the perpendicular at one point of a line is one line, and then
              parallel-equidistant.
  let Q be a point                                                    (H1)
  let R be a point                                                    (H2)
  let X be a point                                                    (H3)
  let Y be a point                                                    (H4)
  let H be a point                                                    (H5)
  let S be a point                                                    (H6)
  let K be a point                                                    (H7)
  let T be a point                                                    (H8)
  assume Q ≠ R                                                        (H9)
  assume X ≠ Y                                                        (H10)
  assume line QR ∥ line XY                                            (H11)
  assume Q is not on line XY                                          (H12)
  assume H is on line XY                                              (H13)
  assume S is on line XY                                              (H14)
  assume S ≠ H                                                        (H15)
  assume ∠QHS = 90°                                                   (H16)
  assume K is on line XY                                              (H17)
  assume T is on line XY                                              (H18)
  assume T ≠ K                                                        (H19)
  assume ∠RKT = 90°                                                   (H20)
  assume Q ≠ H                                                        (H21)
  assume Q ≠ S                                                        (H22)
  assume R ≠ K                                                        (H23)
  assume R ≠ T                                                        (H24)
  then |QH| = |RK|

1.  R is on line QR
    mun:on-line-ends A := Q, B := R

2.  R is not on line XY
    mun:parallel-off A := Q, B := R, C := X, D := Y, X := R,
      from H9, H10, H11, H12, 1

3.  R and Q are on the same side of line XY
    mun:parallel-same-side A := Q, B := R, C := X, D := Y, X := R,
      from H9, H10, H11, H12, 1

4.  Q and R are on the same side of line XY
    mun:same-side-turned A := X, B := Y, P := R, from 3

5.  line HS = line XY
    axi:line-uniqueness A := H, B := S, C := X, D := Y,
      from H10, H13, H14, H15

6.  line KT = line XY
    axi:line-uniqueness A := K, B := T, C := X, D := Y,
      from H10, H17, H18, H19

7.  H ≠ K
    contradiction
    suppose H = K                                                     (S1)

    7.1.  S ≠ K
          substitute H = K (S1) into H15

    7.2.  K ≠ Q
          substitute H = K (S1) into H21

    7.3.  ∠QKS = 90°
          substitute H = K (S1) into H16

    7.4.  S is on line KT
          substitute line KT = line XY (line 6) into H14

    7.5.  Q and R are on the same side of line KS
          mun:same-side-of-line A := X, B := Y, C := K, D := S, P := Q,
            Q := R, from H10, H14, H17, 4, 7.1

    7.6.  ∠RKS = 90°
          mun:right-angle-along P := R, H := K, S := T, T := S,
            from H19, H20, H24, 7.4
          requires R is not on line KS: mun:same-side-off-line A := K, B := S, P := Q, Q := R, from 7.5
          requires R, K, S form a triangle: mun:triangle-off-line P := R, Q := K, R := S, from 7.1

    7.7.  ∠SKQ = ∠SKR
          calculation
            ∠SKQ = ∠QKS       mun:angle-turned P := S, Q := K, R := Q, from H22, 7.1, 7.2
                 = 90°        7.3
                 = ∠RKS       7.6
                 = ∠SKR       mun:angle-turned P := S, Q := K, from H23, 7.1
          requires S ≠ R: mun:on-off-apart A := X, B := Y, X := S, Y := R, from H14, 2

    7.8.  R and Q are on the same side of line KS
          mun:same-side-turned A := K, B := S, P := Q, Q := R, from 7.5

    7.9.  Q and Q are on the same side of line KS
          mun:same-side-same A := K, B := S, P := Q, Q := R, R := Q,
            from 7.5, 7.8

    7.10. Q is not on line KS
          mun:same-side-off-line A := K, B := S, P := Q, Q := R, from 7.5

    7.11. Q, K, S form a triangle.
          mun:triangle-off-line P := Q, Q := K, R := S, from 7.1, 7.10

    7.12. R ∈ ray KQ
          axi:angle-construction-unique A := K, B := S, C := Q, D := Q,
            E := R, from 7.7, 7.8, 7.9, 7.11

    7.13. R is on line KQ
          mun:ray-on-line P := R, A := K, B := Q, from 7.12

    7.14. K is on line KQ. Q is on line KQ.
          mun:on-line-ends A := K, B := Q

    7.15. line QR = line KQ
          axi:line-uniqueness A := Q, B := R, C := K, D := Q,
            from H9, 7.2, 7.13, 7.14

    7.16. K is on line QR
          substitute line QR = line KQ (line 7.15) into line 7.14

    7.17. K is not on line XY
          mun:parallel-off A := Q, B := R, C := X, D := Y, X := K,
            from H9, H10, H11, H12, 7.16, contradicting H17

8.  line HK = line XY
    axi:line-uniqueness A := H, B := K, C := X, D := Y,
      from H10, H13, H17, 7

9.  K is on line HS
    substitute line HS = line XY (line 5) into H17

10. ∠QHK = 90°
    mun:right-angle-along P := Q, T := K, from H16, 9
    requires Q, H, S form a triangle: mun:right-angle-triangle P := Q, Q := H, R := S, from H15, H16, H21, H22
    requires Q is not on line HS: mun:triangle-not-on-line P := Q, Q := H, R := S
    requires Q is not on line HK: mun:off-line-along A := H, B := S, X := K, P := Q, from H15, 7, 9
    requires Q, H, K form a triangle: mun:triangle-off-line P := Q, Q := H, R := K, from 7

11. H is on line KT
    substitute line KT = line XY (line 6) into H13

12. ∠RKH = 90°
    mun:right-angle-along P := R, H := K, S := T, T := H, from H20, 11
    requires R, K, T form a triangle: mun:right-angle-triangle P := R, Q := K, R := T, from H19, H20, H23, H24
    requires R is not on line KT: mun:triangle-not-on-line P := R, Q := K, R := T
    requires R is not on line KH: mun:off-line-along A := K, B := T, X := H, P := R, from H19, 7, 11
    requires R, K, H form a triangle: mun:triangle-off-line P := R, Q := K, R := H, from 7

13. Q and R are on the same side of line HK
    mun:same-side-of-line A := X, B := Y, C := H, D := K, P := Q, Q := R,
      from H10, H13, H17, 4, 7

14. not (there is Z ∈ 𝔼² with Z is on line QR and Z is on line HK)
    contradiction
    suppose there is Z ∈ 𝔼² with Z is on line QR and Z is on line HK  (S2)

    14.1. Z ∈ 𝔼². Z is on line QR. Z is on line HK.
          obtain Z from S2

    14.2. Z is on line XY
          substitute line HK = line XY (line 8) into line 14.1

    14.3. Z is not on line XY
          mun:parallel-off A := Q, B := R, C := X, D := Y, X := Z,
            from H9, H10, H11, H12, 14.1, contradicting 14.2

15. line QR = line HK or not (there is Z ∈ 𝔼² with Z is on line QR and
    Z is on line HK)
    mun:or-right, from 14

16. line QR ∥ line HK
    def:parallel A := Q, B := R, C := H, D := K, from H9, 7, 15

17. |QH| = |RK|
    thm:parallel-equidistant A := Q, B := R, from H9, 10, 12, 13, 16

theorem same-base-area
  note        Euclid I.37: triangles on one base XY with their apexes Q and R
              on a line parallel to it have one height (parallel-heights), so
              one area.
  let Q be a point                                                    (H1)
  let R be a point                                                    (H2)
  let X be a point                                                    (H3)
  let Y be a point                                                    (H4)
  assume Q ≠ R                                                        (H5)
  assume Q, X, Y form a triangle                                      (H6)
  assume R, X, Y form a triangle                                      (H7)
  assume line XY ∥ line QR                                            (H8)
  then the area of △QXY = the area of △RXY

1.  H ∈ 𝔼². S ∈ 𝔼². H is on line XY. S is on line XY. S ≠ H. Q ≠ H.
    Q ≠ S. ∠QHS = 90°.
    obtain H, S: mun:foot P := Q, Q := X, R := Y, from H6

2.  K ∈ 𝔼². T ∈ 𝔼². K is on line XY. T is on line XY. T ≠ K. R ≠ K.
    R ≠ T. ∠RKT = 90°.
    obtain K, T: mun:foot P := R, Q := X, R := Y, from H7

3.  line QR ∥ line XY
    mun:parallel-turned A := X, B := Y, C := Q, D := R, from H6, H8

4.  Q is not on line XY
    mun:triangle-not-on-line P := Q, Q := X, R := Y, from H6

5.  |QH| = |RK|
    thm:parallel-heights, from H5, H6, 1, 2, 3, 4

6.  the area of △QXY = the area of △RXY
    calculation
      the area of △QXY = (1/2)·|XY|·|QH|         mun:height-area P := Q, Q := X, R := Y, from H6, 1
                       = (1/2)·|XY|·|RK|         substitute line 5
                       = the area of △RXY        mun:height-area P := R, Q := X, R := Y, H := K, S := T, from H7, 2

theorem proportional-segments
  note        Euclid VI.2. The triangles QXY and RXY have the base XY and
              Q and R on a parallel to it, so one area (same-base-area,
              Euclid I.37). Adding PXY to each, YPQ and XPR have one
              area too. Measured from the heights of Y over line PQ and of X
              over line PR, the areas give |PQ| : |PX| = |PR| : |PY|.
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  let X be a point                                                    (H4)
  let Y be a point                                                    (H5)
  assume P, Q, R form a triangle                                      (H6)
  assume X is between P and Q                                         (H7)
  assume Y is between P and R                                         (H8)
  assume line XY ∥ line QR                                            (H9)
  then |PX|·|PR| = |PY|·|PQ|

1.  Q, P, Y form a triangle.
    mun:triangle-on-side P := Q, Q := P, S := Y, from H6, H8

2.  R, P, X form a triangle.
    mun:triangle-on-side P := R, Q := P, R := Q, S := X, from H6, H7

3.  the area of △YPQ = the area of △YPX + the area of △YXQ
    axi:area-addition P := Y, Q := P, R := Q, D := X, from H7, 1

4.  X is between Q and P
    mun:between-symmetric R := X, S := P, T := Q, from H7

5.  Y, Q, X form a triangle.
    mun:triangle-on-side P := Y, R := P, S := X, from 1, 4

6.  Y is between R and P
    mun:between-symmetric R := Y, S := P, T := R, from H8

7.  X, R, Y form a triangle.
    mun:triangle-on-side P := X, Q := R, R := P, S := Y, from 2, 6

8.  Y, P, X form a triangle.
    mun:triangle-on-side P := Y, Q := P, R := Q, S := X, from H7, 1

9.  the area of △YXQ = the area of △XYR
    calculation
      the area of △YXQ = the area of △XQY        mun:area-rotated P := Y, Q := X, R := Q, from 5
                       = the area of △QYX        mun:area-rotated P := X, R := Y, from 5
                       = the area of △QXY        mun:area-turned Q := Y, R := X, from 5
                       = the area of △RXY        thm:same-base-area, from H6, H9, 5, 7
                       = the area of △YRX        mun:area-rotated P := Y, Q := R, R := X, from 7
                       = the area of △XYR        mun:area-rotated P := X, Q := Y, from 7

10. the area of △YPX = the area of △XPY
    calculation
      the area of △YPX = the area of △PXY        mun:area-rotated P := Y, Q := P, R := X, from 8
                       = the area of △XYP        mun:area-rotated Q := X, R := Y, from 8
                       = the area of △XPY        mun:area-turned P := X, Q := Y, R := P, from 8

11. the area of △YPQ = the area of △XPY + the area of △XYR
    substitute
      the area of △YPQ = the area of △YPX + the area of △YXQ      3
      the area of △YPQ = the area of △XPY + the area of △YXQ      substitute line 10
      the area of △YPQ = the area of △XPY + the area of △XYR      substitute line 9

12. the area of △YPQ = the area of △XPR
    calculation
      the area of △YPQ = the area of △XPY + the area of △XYR      11
                       = the area of △XPR                         axi:area-addition P := X, Q := P, D := Y, from H8, 2

13. M ∈ 𝔼². U ∈ 𝔼². M is on line PQ. U is on line PQ. U ≠ M. Y ≠ M.
    Y ≠ U. ∠YMU = 90°.
    obtain M, U: mun:foot P := Y, Q := P, R := Q, from 1

14. N ∈ 𝔼². V ∈ 𝔼². N is on line PR. V is on line PR. V ≠ N. X ≠ N.
    X ≠ V. ∠XNV = 90°.
    obtain N, V: mun:foot P := X, Q := P, from 2

15. Q, X, P are collinear.
    mun:between-collinear R := X, S := P, T := Q, from H7

16. X is on line PQ
    def:on-line P := X, A := P, B := Q, from 15

17. P ≠ X. Q ≠ X.
    mun:between-apart R := X, S := P, T := Q, from H7

18. the area of △YPX = (1/2)·|PX|·|YM|
    thm:same-height P := Y, Q := P, R := Q, S := X, H := M, T := U,
      from 1, 13, 16, 17

19. R, Y, P are collinear.
    mun:between-collinear R := Y, S := P, T := R, from H8

20. Y is on line PR
    def:on-line P := Y, A := P, B := R, from 19

21. P ≠ Y. R ≠ Y.
    mun:between-apart R := Y, S := P, T := R, from H8

22. the area of △XPY = (1/2)·|PY|·|XN|
    thm:same-height P := X, Q := P, S := Y, H := N, T := V,
      from 2, 14, 20, 21

23. (1/2)·|PQ|·|YM| = (1/2)·|PR|·|XN|
    calculation
      (1/2)·|PQ|·|YM| = the area of △YPQ      mun:height-area P := Y, Q := P, R := Q, H := M, S := U, from 1, 13
                      = the area of △XPR      12
                      = (1/2)·|PR|·|XN|       mun:height-area P := X, Q := P, H := N, S := V, from 2, 14

24. (1/2)·|PX|·|YM| = (1/2)·|PY|·|XN|
    calculation
      (1/2)·|PX|·|YM| = the area of △YPX      18
                      = the area of △XPY      10
                      = (1/2)·|PY|·|XN|       22

25. (1/2)·|PQ|·|YM|·|PX| = (1/2)·|PR|·|XN|·|PX|
    algebra, from 23

26. (1/2)·|PX|·|YM|·|PQ| = (1/2)·|PY|·|XN|·|PQ|
    algebra, from 24

27. (1/2)·|PX|·|PR|·|XN| = (1/2)·|PY|·|PQ|·|XN|
    algebra, from 25, 26

28. |XN| > 0
    axi:distance-positive P := X, Q := N, from 14

29. (1/2)·|PX|·|PR| = (1/2)·|PY|·|PQ|
    mun:multiply-cancel a := (1/2)·|PX|·|PR|, b := (1/2)·|PY|·|PQ|,
      c := |XN|, from 27
    requires |XN| ≠ 0: weakening, from 28

30. |PX|·|PR| = |PY|·|PQ|
    algebra, from 29

theorem corresponding-angles-converse
  note        Euclid I.28. Produce YX past X to W: ∠WXQ is ∠PXY (vertical
              angles), which is ∠PQR, and W and R are on two sides of line
              XQ, so line XW is parallel to line QR (alternate-angles-converse).
  let P be a point                                                    (H1)
  let X be a point                                                    (H2)
  let Q be a point                                                    (H3)
  let Y be a point                                                    (H4)
  let R be a point                                                    (H5)
  assume X is between P and Q                                         (H6)
  assume Y and R are on the same side of line PQ                      (H7)
  assume ∠PXY = ∠PQR                                                  (H8)
  assume X ≠ Y                                                        (H9)
  then line XY ∥ line QR

1.  P ≠ X. Q ≠ X.
    mun:between-apart R := X, S := P, T := Q, from H6

2.  P ≠ Q. Y is not on line PQ. R is not on line PQ.
    mun:same-side-off-line A := P, B := Q, P := Y, Q := R, from H7

3.  Q, X, P are collinear.
    mun:between-collinear R := X, S := P, T := Q, from H6

4.  X is on line PQ
    def:on-line P := X, A := P, B := Q, from 3

5.  P is on line PQ. Q is on line PQ.
    mun:on-line-ends A := P, B := Q

6.  X is on line XQ. Q is on line XQ.
    mun:on-line-ends A := X, B := Q

7.  Y and R are on the same side of line XQ
    mun:same-side-of-line A := P, B := Q, C := X, D := Q, P := Y, Q := R,
      from H7, 1, 2, 4, 5

8.  Y is not on line XQ. R is not on line XQ.
    mun:same-side-off-line A := X, B := Q, P := Y, Q := R, from 7

9.  Y, P, Q form a triangle.
    mun:triangle-off-line P := Y, Q := P, R := Q, from 2

10. |YX| > 0
    axi:distance-positive P := Y, Q := X, from H9

11. W ∈ 𝔼². X is between Y and W. |XW| = |YX|.
    obtain W: mun:segment-extension A := Y, B := X, r := |YX|, from H9, 10

12. X is between Q and P
    mun:between-symmetric R := X, S := P, T := Q, from H6

13. Q ≠ R
    mun:on-off-apart A := P, B := Q, X := Q, Y := R, from 2, 5

14. Y and W are on opposite sides of line XQ
    mun:segment-across-line A := X, B := Q, P := Y, Q := W, M := X,
      from 1, 6, 8, 11

15. ∠WXQ = ∠XQR
    calculation
      ∠WXQ = ∠YXP       thm:vertical-angles A := Y, B := P, C := W, D := Q, O := X, from H6, 11
           = ∠PXY       mun:angle-turned Q := X, R := Y
           = ∠PQR       H8
           = ∠XQR       mun:angle-along-segment P := Q, Q := P, S := X, from 12, 13
    requires Y, P, X form a triangle: mun:triangle-on-side P := Y, Q := P, R := Q, S := X, from H6, 9
    requires R ≠ X: mun:off-line-apart A := X, B := Q, P := R, from 8
    requires R ≠ P: mun:off-line-apart A := P, B := Q, P := R, from 2
    requires W is not on line XQ: mun:opposite-sides-off-line A := X, B := Q, P := Y, Q := W, from 14
    requires W, X, Q form a triangle: mun:triangle-off-line P := W, Q := X, R := Q, from 1

16. R and Y are on the same side of line XQ
    mun:same-side-turned A := X, B := Q, P := Y, Q := R, from 7

17. R and W are on opposite sides of line XQ
    mun:same-opposite-opposite A := X, B := Q, P := R, Q := Y, R := W,
      from 14, 16

18. W and R are on opposite sides of line XQ
    mun:opposite-sides-turned A := X, B := Q, P := R, Q := W, from 17

19. R, X, Q form a triangle.
    mun:triangle-off-line P := R, Q := X, R := Q, from 1, 8

20. line XW ∥ line QR
    thm:alternate-angles-converse P := Q, Q := R, R := X, S := W,
      from 15, 18, 19

21. W, X, Y are collinear.
    mun:between-collinear R := X, S := Y, T := W, from 11

22. Y is on line XW
    def:on-line P := Y, A := X, B := W, from 21

23. Y ≠ X. W ≠ X.
    mun:between-apart R := X, S := Y, T := W, from 11

24. line XY ∥ line RQ
    mun:parallel-along A := X, B := W, C := Q, D := R, E := Y,
      from 20, 22, 23

25. Y is on line XY
    mun:on-line-ends A := X, B := Y

26. line XY ∥ line QR
    mun:parallel-along A := X, B := Y, C := R, D := Q, E := Y,
      from 23, 24, 25

theorem parallel-between
  note        The line through a point X of the side PQ parallel to QR meets
              line PR at a point Y on R's side of line PQ: Y is between P and
              R, since R beyond Y would put Q and R on two sides of line XY,
              and the segment QR would meet it.
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  let X be a point                                                    (H4)
  let Y be a point                                                    (H5)
  assume P, Q, R form a triangle                                      (H6)
  assume X is between P and Q                                         (H7)
  assume Y is on line PR                                              (H8)
  assume Y and R are on the same side of line PQ                      (H9)
  assume line XY ∥ line QR                                            (H10)
  then Y is between P and R

1.  Y is not on line PQ
    mun:same-side-off-line A := P, B := Q, P := Y, Q := R, from H9

2.  P is on line PQ. Q is on line PQ.
    mun:on-line-ends A := P, B := Q

3.  X is between Q and P
    mun:between-symmetric R := X, S := P, T := Q, from H7

4.  R, Q, X form a triangle.
    mun:triangle-on-side P := R, R := P, S := X, from H6, 3

5.  X is not on line QR
    mun:triangle-not-on-line P := X, from 4

6.  Q, X, P are collinear.
    mun:between-collinear R := X, S := P, T := Q, from H7

7.  X is on line PQ
    def:on-line P := X, A := P, B := Q, from 6

8.  X ≠ Y
    mun:on-off-apart A := P, B := Q, from 1, 7

9.  X is on line XY. Y is on line XY.
    mun:on-line-ends A := X, B := Y

10. Y is not on line QR
    mun:parallel-off A := X, B := Y, C := Q, D := R, X := Y,
      from H6, H10, 5, 8, 9

11. P ≠ X. Q ≠ X.
    mun:between-apart R := X, S := P, T := Q, from H7

12. Y and R are on the same side of line XQ
    mun:same-side-of-line A := P, B := Q, C := X, D := Q, P := Y, Q := R,
      from H6, H9, 2, 4, 7

13. Y is not on line XQ
    mun:same-side-off-line A := X, B := Q, P := Y, Q := R, from 12

14. P is on line XQ
    def:on-line A := X, B := Q, from 6

15. Y is not on line XP
    mun:off-line-along A := X, B := Q, X := P, P := Y, from 11, 13, 14

16. P is not on line XY
    mun:off-line-swap R := X, Q := Y, from 15

17. P and Q are on opposite sides of line XY
    mun:segment-across-line A := X, B := Y, M := X,
      from H7, 8, 9, 16

18. Y = P or (Y is between P and R) or Y = R or (R is between P and Y) or
    (P is between Y and R)
    mun:on-line-cases P := Y, Q := P, from H6, H8

19. Y is between P and R
    cases, from 18

    case
    assume Y = P                                                      (C1)

    19.1. P is not on line PQ
          substitute Y = P (C1) into line 1, contradicting 2

    case
    assume Y is between P and R                                       (C2)

    19.2. Y is between P and R
          restate C2

    case
    assume Y = R                                                      (C3)

    19.3. R is on line QR
          mun:on-line-ends A := Q, B := R

    19.4. R is not on line QR
          substitute Y = R (C3) into line 10, contradicting 19.3

    case
    assume R is between P and Y                                       (C4)

    19.5. Y is on line XY
          restate 9

    19.6. R and P are on the same side of line XY
          mun:segment-off-line A := X, B := Y, Q := Y, X := R,
            from C4, 8, 16, 19.5

    19.7. R and Q are on opposite sides of line XY
          mun:same-opposite-opposite A := X, B := Y, P := R, Q := P, R := Q,
            from 17, 19.6

    19.8. Z ∈ 𝔼². Z is on line XY. Z is between R and Q.
          obtain Z: axi:plane-separation-crossing A := X, B := Y, P := R,
            from 8, 19.7

    19.9. Q, Z, R are collinear.
          mun:between-collinear R := Z, S := R, T := Q, from 19.8

    19.10. Z is on line QR
           def:on-line P := Z, A := Q, B := R, from 19.9

    19.11. Z is not on line QR
           mun:parallel-off A := X, B := Y, C := Q, D := R, X := Z,
             from H6, H10, 5, 8, 19.8, contradicting 19.10

    case
    assume P is between Y and R                                       (C5)

    19.12. Y and R are on opposite sides of line PQ
           mun:segment-across-line A := P, B := Q, P := Y, Q := R, M := P,
             from C5, H6, 1, 2

    19.13. not (Y and R are on opposite sides of line PQ)
           mun:same-not-opposite A := P, B := Q, P := Y, Q := R, from H9,
             contradicting 19.12

theorem angle-angle-similar
  note        Two triangles with two angles equal have their sides about the
              first angle in proportion. Lay off |P′Q′| along PQ to X and
              |P′R′| along PR to Y: PXY and P′Q′R′ agree in two sides and
              the angle between them, so ∠PXY = ∠PQR, and XY is parallel to
              QR (corresponding-angles-converse). Then Euclid VI.2, from
              whichever of X and Q is nearer P; and X at Q puts Y at R.
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  let P′ be a point                                                   (H4)
  let Q′ be a point                                                   (H5)
  let R′ be a point                                                   (H6)
  assume P, Q, R form a triangle                                      (H7)
  assume P′, Q′, R′ form a triangle                                   (H8)
  assume ∠QPR = ∠Q′P′R′                                               (H9)
  assume ∠PQR = ∠P′Q′R′                                               (H10)
  then |PQ|·|P′R′| = |P′Q′|·|PR|

1.  |P′Q′| > 0
    axi:distance-positive P := P′, Q := Q′, from H8

2.  |P′R′| > 0
    axi:distance-positive P := P′, Q := R′, from H8

3.  X ∈ 𝔼². X is on line PQ. X and Q are on the same side of line PR.
    |PX| = |P′Q′|.
    obtain X: mun:ray-point A := P, B := Q, C := R, r := |P′Q′|, from H7, 1

4.  Y ∈ 𝔼². Y is on line PR. Y and R are on the same side of line PQ.
    |PY| = |P′R′|.
    obtain Y: mun:ray-point A := P, B := R, C := Q, r := |P′R′|, from H7, 2

5.  X is not on line PR
    mun:same-side-off-line A := P, B := R, P := X, from 3

6.  X ≠ P. X ≠ R.
    mun:off-line-apart A := P, B := R, P := X, from 5

7.  P is on line PQ. Q is on line PQ.
    mun:on-line-ends A := P, B := Q

8.  Y and R are on the same side of line PX
    mun:same-side-of-line A := P, B := Q, C := P, D := X, P := Y, Q := R,
      from H7, 3, 4, 6, 7

9.  ∠XPY = ∠QPR
    calculation
      ∠XPY = ∠XPR       mun:angle-same-ray R := X, Q := R, X := Y, from 4, 8
           = ∠RPX       mun:angle-turned P := X, Q := P, from H7, 6
           = ∠RPQ       mun:angle-same-ray, from 3
           = ∠QPR       mun:angle-turned P := R, Q := P, R := Q, from H7

10. Y is not on line PQ
    mun:same-side-off-line A := P, B := Q, P := Y, Q := R, from 4

11. Y ≠ P. Y ≠ Q.
    mun:off-line-apart A := P, B := Q, P := Y, from 10

12. X is not on line PY
    mun:off-line-along A := P, B := R, X := Y, P := X, from H7, 4, 5, 11

13. X, P, Y form a triangle.
    mun:triangle-off-line P := X, Q := P, R := Y, from 11, 12

14. ∠Q′P′R′ = ∠XPY
    calculation
      ∠Q′P′R′ = ∠QPR       H9
              = ∠XPY       9

15. |PX| = |P′Q′|
    restate 3

16. |PY| = |P′R′|
    restate 4

17. |Q′P′| = |XP|
    restate 15

18. |P′R′| = |PY|
    restate 16

19. triangle Q′P′R′ ≅ triangle XPY
    axi:side-angle-side P := Q′, Q := P′, R := R′, P′ := X, Q′ := P, R′ := Y,
      from H8, 13, 14, 17, 18

20. ∠PXY = ∠PQR
    calculation
      ∠PXY = ∠YXP         mun:angle-turned Q := X, R := Y, from 13
           = ∠R′Q′P′      def:congruent, from H8, 13, 19
           = ∠P′Q′R′      mun:angle-turned P := R′, Q := Q′, R := P′, from H8
           = ∠PQR         H10

21. X = P or (X is between P and Q) or X = Q or (Q is between P and X) or
    (P is between X and Q)
    mun:on-line-cases P := X, Q := P, R := Q, from H7, 3

22. |PQ|·|P′R′| = |P′Q′|·|PR|
    cases, from 21

    case
    assume X = P                                                      (C1)

    22.1. X ≠ P
          def:triangle P := X, Q := P, R := Y, from 13, contradicting C1

    case
    assume X is between P and Q                                       (C2)

    22.2. line XY ∥ line QR
          thm:corresponding-angles-converse, from C2, 4, 13, 20

    22.3. Y is between P and R
          thm:parallel-between, from C2, H7, 4, 22.2

    22.4. |PX|·|PR| = |PY|·|PQ|
          thm:proportional-segments, from C2, H7, 22.2, 22.3

    22.5. |P′Q′|·|PR| = |P′R′|·|PQ|
          substitute
            |PX|·|PR| = |PY|·|PQ|          22.4
            |P′Q′|·|PR| = |PY|·|PQ|        substitute line 15
            |P′Q′|·|PR| = |P′R′|·|PQ|      substitute line 16

    22.6. |PQ|·|P′R′| = |P′Q′|·|PR|
          algebra, from 22.5

    case
    assume X = Q                                                      (C3)

    22.7. ∠PQY = ∠PQR
          substitute X = Q (C3) into line 20

    22.8.  Y and R are on the same side of line QP
           mun:same-side-of-line A := P, B := Q, C := Q, D := P, P := Y,
             Q := R, from H7, 4, 7

    22.9.  R and Y are on the same side of line QP
           mun:same-side-turned A := Q, B := P, P := Y, Q := R, from 22.8

    22.10. R and R are on the same side of line QP
           mun:same-side-same A := Q, B := P, P := R, Q := Y,
             from 22.8, 22.9

    22.11. Y ∈ ray QR
           axi:angle-construction-unique A := Q, B := P, C := R, D := R,
             E := Y, from H7, 22.7, 22.8, 22.10

    22.12. Y is on line QR
           mun:ray-on-line P := Y, A := Q, B := R, from 22.11

    22.13. Y = R
           contradiction
           suppose Y ≠ R                                              (S1)

           22.13.1. R is on line PR
                    mun:on-line-ends A := P, B := R

           22.13.2. line YR = line PR
                    axi:line-uniqueness A := Y, B := R, C := P, D := R,
                      from H7, S1, 4, 22.13.1

           22.13.3. R is on line QR
                    mun:on-line-ends A := Q, B := R

           22.13.4. line YR = line QR
                    axi:line-uniqueness A := Y, B := R, C := Q, D := R,
                      from H7, S1, 22.12, 22.13.3

           22.13.5. line PR = line QR
                    calculation
                      line PR = line YR       22.13.2
                              = line QR       22.13.4

           22.13.6. P is on line PR
                    mun:on-line-ends A := P, B := R

           22.13.7. P is on line QR
                    substitute line PR = line QR (line 22.13.5) into line 22.13.6

           22.13.8. P is not on line QR
                    mun:triangle-not-on-line, from H7,
                      contradicting 22.13.7

    22.14. |PQ| = |P′Q′|
           substitute X = Q (C3) into line 15

    22.15. |PR| = |P′R′|
           substitute Y = R (line 22.13) into line 16

    22.16. |PQ|·|P′R′| = |P′Q′|·|P′R′|
           algebra, from 22.14

    22.17. |P′Q′|·|PR| = |P′Q′|·|P′R′|
           algebra, from 22.15

    22.18. |PQ|·|P′R′| = |P′Q′|·|PR|
           transitivity, from 22.16, 22.17

    case
    assume Q is between P and X                                       (C4)

    22.19. R and Y are on the same side of line PQ
           mun:same-side-turned A := P, B := Q, P := Y, Q := R, from 4

    22.20. R and Y are on the same side of line PX
           mun:same-side-of-line A := P, B := Q, C := P, D := X, P := R,
             Q := Y, from H7, 3, 6, 7, 22.19

    22.21. ∠PQR = ∠PXY
           calculation
             ∠PQR = ∠PXY       20

    22.22. line QR ∥ line XY
           thm:corresponding-angles-converse X := Q, Q := X, Y := R, R := Y,
             from C4, H7, 22.20, 22.21

    22.23. R is on line PR
           mun:on-line-ends A := P, B := R

    22.24. P is on line PR
           mun:on-line-ends A := P, B := R

    22.25. line PY = line PR
           axi:line-uniqueness A := P, B := Y, C := P, D := R,
             from H7, 4, 13, 22.24

    22.26. R is on line PY
           substitute line PY = line PR (line 22.25) into line 22.23

    22.27. R and Y are on the same side of line PX
           restate 22.20

    22.28. R is between P and Y
           thm:parallel-between Q := X, R := Y, X := Q, Y := R,
             from C4, 13, 22.22, 22.26, 22.27

    22.29. |PQ|·|PY| = |PR|·|PX|
           thm:proportional-segments Q := X, R := Y, X := Q, Y := R,
             from C4, 13, 22.22, 22.28

    22.30. |PQ|·|P′R′| = |PR|·|P′Q′|
           substitute
             |PQ|·|PY| = |PR|·|PX|          22.29
             |PQ|·|P′R′| = |PR|·|PX|        substitute line 16
             |PQ|·|P′R′| = |PR|·|P′Q′|      substitute line 15

    22.31. |PQ|·|P′R′| = |P′Q′|·|PR|
           algebra, from 22.30

    case
    assume P is between X and Q                                       (C5)

    22.32. P is on line PR
           mun:on-line-ends A := P, B := R

    22.33. X and Q are on opposite sides of line PR
           mun:segment-across-line A := P, B := R, P := X, M := P,
             from C5, H7, 5, 22.32

    22.34. not (X and Q are on opposite sides of line PR)
           mun:same-not-opposite A := P, B := R, P := X, from 3,
             contradicting 22.33

mundane theorem circle-centre-apart
  note        Two different points at one distance from O are not O: were X
              at O, its distance would be 0, and so would Y's, putting Y at
              O as well.
  let X be a point                                                    (H1)
  let Y be a point                                                    (H2)
  let O be a point                                                    (H3)
  assume X ≠ Y                                                        (H4)
  assume |XO| = |YO|                                                  (H5)
  then X ≠ O

1.  X ≠ O
    contradiction
    suppose X = O                                                     (S)

    1.1.  |XO| = 0
          mun:distance-zero P := X, Q := O, from S

    1.2.  |YO| = 0
          substitute |XO| = |YO| (H5) into line 1.1

    1.3.  X = Y
          calculation, contradicting H4
            X = O          S
              = Y          mun:distance-zero P := Y, Q := O, from 1.2

mundane theorem half-turn
  note        A sum the signed angles of a triangle make, −π or π, is an odd
              number of half turns: −π is (2·(−1) + 1)·π and π is
              (2·0 + 1)·π.
  let x ∈ ℝ                                                           (H1)
  assume x ∈ {−π, π}                                                  (H2)
  then there is j ∈ ℤ with x = (2·j + 1)·π

1.  x = −π or x = π
    def:pair u := −π, w := π, from H2

2.  There is j ∈ ℤ with x = (2·j + 1)·π.
    cases, from 1

    case
    assume x = −π                                                     (C1)

    2.1.  x = (2·(−1) + 1)·π
          algebra, from C1

    2.2.  There is j ∈ ℤ with x = (2·j + 1)·π.
          exhibit, from 2.1

    case
    assume x = π                                                      (C2)

    2.3.  x = (2·0 + 1)·π
          algebra, from C2

    2.4.  There is j ∈ ℤ with x = (2·j + 1)·π.
          exhibit, from 2.3

theorem angle-at-centre
  note        Euclid III.20: the angle at the centre O of a circle is twice
              the angle at the circle on the same arc. Said of signed
              angles, it holds wherever O lies, up to whole turns. The
              triangles OAC and OBC are isosceles, so in each the angles at
              the circle are equal, and the angle at O makes a half turn
              with twice either; the rays from O and from C then add up.
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  let O be a point                                                    (H4)
  assume A ≠ C                                                        (H5)
  assume B ≠ C                                                        (H6)
  assume |AO| = |BO|                                                  (H7)
  assume |AO| = |CO|                                                  (H8)
  then there is k ∈ ℤ with ∡AOB = 2·∡ACB + 2·k·π

1.  A ≠ O
    mun:circle-centre-apart X := A, Y := C, from H5, H8

2.  C ≠ O
    mun:circle-centre-apart X := C, Y := A, from H5, H8

3.  |BO| = |CO|
    calculation
      |BO| = |AO|    H7
           = |CO|    H8

4.  B ≠ O
    mun:circle-centre-apart X := B, Y := C, from H6, 3

5.  ∡OAC = ∡ACO
    mun:isosceles-signed-angles B := C, Q := O, from H5, H8, 1, 2

6.  ∡OCB = ∡CBO
    mun:isosceles-signed-angles A := C, Q := O, from H6, 2, 3, 4

7.  ∡COA + ∡ACO + ∡OAC ∈ {−π, π}
    thm:signed-angle-sum P := A, Q := O, R := C, from H5, 1, 2

8.  ∡BOC + ∡CBO + ∡OCB ∈ {−π, π}
    thm:signed-angle-sum P := C, Q := O, R := B, from H6, 2, 4

9.  i ∈ ℤ. ∡AOC + ∡COB = ∡AOB + 2·i·π.
    obtain i: mun:three-rays Q := O, X := C, from 1, 2, 4

10. j ∈ ℤ. ∡ACO + ∡OCB = ∡ACB + 2·j·π.
    obtain j: mun:three-rays Q := C, X := O, from H5, H6, 2

11. m ∈ ℤ. ∡AOC + ∡COA = ∡AOA + 2·m·π.
    obtain m: mun:three-rays B := A, Q := O, X := C, from 1, 2

12. p ∈ ℤ. ∡COB + ∡BOC = ∡COC + 2·p·π.
    obtain p: mun:three-rays A := C, B := C, Q := O, X := B, from 2, 4

13. ∡AOA = 0
    mun:signed-angle-zero P := A, Q := O, from 1

14. ∡COC = 0
    mun:signed-angle-zero P := C, Q := O, from 2

15. ∡AOB ∈ ℝ
    mun:signed-angle-real P := A, Q := O, R := B, from 1, 4

16. ∡ACB ∈ ℝ
    mun:signed-angle-real P := A, Q := C, R := B, from H5, H6

17. ∡AOC ∈ ℝ
    mun:signed-angle-real P := A, Q := O, R := C, from 1, 2

18. ∡COB ∈ ℝ
    mun:signed-angle-real P := C, Q := O, R := B, from 2, 4

19. ∡COA ∈ ℝ
    mun:signed-angle-real P := C, Q := O, R := A, from 1, 2

20. ∡ACO ∈ ℝ
    mun:signed-angle-real P := A, Q := C, R := O, from H5, 2

21. ∡OAC ∈ ℝ
    mun:signed-angle-real P := O, Q := A, R := C, from H5, 1

22. ∡BOC ∈ ℝ
    mun:signed-angle-real P := B, Q := O, R := C, from 2, 4

23. ∡CBO ∈ ℝ
    mun:signed-angle-real P := C, Q := B, R := O, from H6, 4

24. ∡OCB ∈ ℝ
    mun:signed-angle-real P := O, Q := C, R := B, from H6, 2

25. q ∈ ℤ. ∡COA + ∡ACO + ∡OAC = (2·q + 1)·π.
    obtain q: mun:half-turn x := ∡COA + ∡ACO + ∡OAC, from 7
    requires ∡COA + ∡ACO + ∡OAC ∈ ℝ: membership, from 19, 20, 21

26. r ∈ ℤ. ∡BOC + ∡CBO + ∡OCB = (2·r + 1)·π.
    obtain r: mun:half-turn x := ∡BOC + ∡CBO + ∡OCB, from 8
    requires ∡BOC + ∡CBO + ∡OCB ∈ ℝ: membership, from 22, 23, 24

27. ∡COA + ∡ACO + ∡ACO = (2·q + 1)·π
    substitute ∡OAC = ∡ACO (line 5) into line 25

28. ∡BOC + ∡OCB + ∡OCB = (2·r + 1)·π
    substitute ∡CBO = ∡OCB (line 6) into line 26

29. ∡AOC + ∡COA = 0 + 2·m·π
    substitute ∡AOA = 0 (line 13) into line 11

30. ∡COB + ∡BOC = 0 + 2·p·π
    substitute ∡COC = 0 (line 14) into line 12

31. ∡AOB = ∡AOC + ∡COB − 2·i·π
    algebra, from 9
    requires ∡AOB ∈ ℝ: from 15
    requires ∡AOC ∈ ℝ: from 17
    requires ∡COB ∈ ℝ: from 18

32. ∡AOB = 2·m·π − ∡COA + ∡COB − 2·i·π
    substitute
      ∡AOB = ∡AOC + ∡COB − 2·i·π              31
      ∡AOB = 2·m·π − ∡COA + ∡COB − 2·i·π      algebra, from 29
    requires ∡AOC ∈ ℝ: from 17
    requires ∡COA ∈ ℝ: from 19

33. ∡AOB = 2·m·π − ∡COA + (2·p·π − ∡BOC) − 2·i·π
    substitute
      ∡AOB = 2·m·π − ∡COA + ∡COB − 2·i·π                32
      ∡AOB = 2·m·π − ∡COA + (2·p·π − ∡BOC) − 2·i·π      algebra, from 30
    requires ∡COB ∈ ℝ: from 18
    requires ∡BOC ∈ ℝ: from 22

34. ∡AOB = 2·m·π − ((2·q + 1)·π − 2·∡ACO) + (2·p·π − ∡BOC) − 2·i·π
    substitute
      ∡AOB = 2·m·π − ∡COA + (2·p·π − ∡BOC) − 2·i·π                        33
      ∡AOB = 2·m·π − ((2·q + 1)·π − 2·∡ACO) + (2·p·π − ∡BOC) − 2·i·π      algebra, from 27
    requires ∡COA ∈ ℝ: from 19
    requires ∡ACO ∈ ℝ: from 20

35. ∡AOB = 2·m·π − ((2·q + 1)·π − 2·∡ACO) + (2·p·π − ((2·r + 1)·π − 2·∡OCB)) − 2·i·π
    substitute
      ∡AOB = 2·m·π − ((2·q + 1)·π − 2·∡ACO) + (2·p·π − ∡BOC) − 2·i·π                        34
      ∡AOB = 2·m·π − ((2·q + 1)·π − 2·∡ACO) + (2·p·π − ((2·r + 1)·π − 2·∡OCB)) − 2·i·π      algebra, from 28
    requires ∡BOC ∈ ℝ: from 22
    requires ∡OCB ∈ ℝ: from 24

36. ∡AOB = 2·(∡ACO + ∡OCB) + 2·(m + p − i − q − r − 1)·π
    algebra, from 35
    requires ∡ACO ∈ ℝ: from 20
    requires ∡OCB ∈ ℝ: from 24

37. ∡AOB = 2·(∡ACB + 2·j·π) + 2·(m + p − i − q − r − 1)·π
    substitute ∡ACO + ∡OCB = ∡ACB + 2·j·π (line 10) into line 36

38. ∡AOB = 2·∡ACB + 2·(2·j + m + p − i − q − r − 1)·π
    algebra, from 37
    requires ∡ACB ∈ ℝ: from 16

39. There is k ∈ ℤ with ∡AOB = 2·∡ACB + 2·k·π.
    exhibit, from 38

theorem same-arc-angles
  note        Euclid III.21: angles at the circle on one arc are equal. By
              the angle at the centre, twice each is ∡AOB up to whole turns,
              so the two differ by a whole number of half turns; on one side
              of AB both turn the same way, each between −π and π, so they
              differ by less than a half turn, and so by none.
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  let D be a point                                                    (H4)
  let O be a point                                                    (H5)
  assume |AO| = |BO|                                                  (H6)
  assume |AO| = |CO|                                                  (H7)
  assume |AO| = |DO|                                                  (H8)
  assume C and D are on the same side of line AB                      (H9)
  then ∠ACB = ∠ADB

1.  C is not on line AB
    mun:same-side-off-line P := C, Q := D, from H9

2.  D is not on line AB
    mun:same-side-off-line P := C, Q := D, from H9

3.  C ≠ A
    mun:off-line-apart P := C, from 1

4.  C ≠ B
    mun:off-line-apart P := C, from 1

5.  D ≠ A
    mun:off-line-apart P := D, from 2

6.  D ≠ B
    mun:off-line-apart P := D, from 2

7.  i ∈ ℤ. ∡AOB = 2·∡ACB + 2·i·π.
    obtain i: thm:angle-at-centre, from H6, H7, 3, 4

8.  j ∈ ℤ. ∡AOB = 2·∡ADB + 2·j·π.
    obtain j: thm:angle-at-centre C := D, from H6, H8, 5, 6

9.  ∡ACB ∈ ℝ
    mun:signed-angle-real P := A, Q := C, R := B, from 3, 4

10. −π < ∡ACB
    mun:signed-angle-real P := A, Q := C, R := B, from 3, 4

11. ∡ACB ≤ π
    mun:signed-angle-real P := A, Q := C, R := B, from 3, 4

12. ∡ADB ∈ ℝ
    mun:signed-angle-real P := A, Q := D, R := B, from 5, 6

13. −π < ∡ADB
    mun:signed-angle-real P := A, Q := D, R := B, from 5, 6

14. ∡ADB ≤ π
    mun:signed-angle-real P := A, Q := D, R := B, from 5, 6

15. 2·∡ACB + 2·i·π = 2·∡ADB + 2·j·π
    calculation
      2·∡ACB + 2·i·π = ∡AOB                 7
                     = 2·∡ADB + 2·j·π       8

16. ∡ACB − ∡ADB = (j − i)·π
    algebra, from 15
    requires ∡ACB ∈ ℝ: from 9
    requires ∡ADB ∈ ℝ: from 12

17. ∡ACB·∡ADB > 0
    mun:same-side-turns-alike, from H9

18. ∡ACB ≥ 0 or ∡ACB < 0
    mun:nonneg-or-neg x := ∡ACB, from 9

19. −π < ∡ACB − ∡ADB and ∡ACB − ∡ADB < π
    cases, from 18

    case
    assume ∡ACB ≥ 0                                                   (C1)

    19.1. ∡ADB > 0
          mun:factor-positive a := ∡ACB, b := ∡ADB, from C1, 9, 12, 17

    19.2. ∡ADB·∡ACB > 0
          inequalities
            ∡ACB·∡ADB > 0        17
            ∡ADB·∡ACB > 0        algebra
          requires ∡ACB ∈ ℝ: from 9
          requires ∡ADB ∈ ℝ: from 12

    19.3. ∡ACB > 0
          mun:factor-positive a := ∡ADB, b := ∡ACB, from 9, 19.2
          requires ∡ADB ∈ ℝ: from 12
          requires ∡ADB ≥ 0: weakening, from 19.1

    19.4. ∡ACB − ∡ADB > −∡ADB
          inequalities
            ∡ACB > 0                 19.3
            ∡ACB − ∡ADB > −∡ADB      adding −∡ADB
          requires ∡ACB ∈ ℝ: from 9
          requires ∡ADB ∈ ℝ: from 12

    19.5. −∡ADB ≥ −π
          inequalities
            ∡ADB ≤ π                 14
            −∡ADB ≥ −π               multiplying by −1
          requires ∡ADB ∈ ℝ: from 12

    19.6. −π < ∡ACB − ∡ADB
          transitivity, from 19.5, 19.4
          requires ∡ACB ∈ ℝ: from 9
          requires ∡ADB ∈ ℝ: from 12

    19.7. ∡ACB − ∡ADB < ∡ACB
          inequalities
            ∡ADB > 0                 19.1
            −∡ADB < 0                multiplying by −1
            ∡ACB − ∡ADB < ∡ACB       adding ∡ACB
          requires ∡ACB ∈ ℝ: from 9
          requires ∡ADB ∈ ℝ: from 12

    19.8. ∡ACB − ∡ADB < π
          transitivity, from 19.7, 11
          requires ∡ACB ∈ ℝ: from 9
          requires ∡ADB ∈ ℝ: from 12

    19.9. −π < ∡ACB − ∡ADB and ∡ACB − ∡ADB < π
          join 19.6, 19.8

    case
    assume ∡ACB < 0                                                   (C2)

    19.10. −∡ACB ≥ 0
           inequalities
             ∡ACB < 0       C2
             −∡ACB > 0      multiplying by −1
             −∡ACB ≥ 0      weakening
           requires ∡ACB ∈ ℝ: from 9

    19.11. (−∡ACB)·(−∡ADB) > 0
           inequalities
             ∡ACB·∡ADB > 0               17
             (−∡ACB)·(−∡ADB) > 0         algebra
           requires ∡ACB ∈ ℝ: from 9
           requires ∡ADB ∈ ℝ: from 12

    19.12. −∡ADB > 0
           mun:factor-positive a := −∡ACB, b := −∡ADB, from 19.10, 19.11
           requires −∡ACB ∈ ℝ: membership, from 9
           requires −∡ADB ∈ ℝ: membership, from 12

    19.13. ∡ACB − ∡ADB > ∡ACB
           inequalities
             −∡ADB > 0                   19.12
             ∡ACB − ∡ADB > ∡ACB          adding ∡ACB
           requires ∡ACB ∈ ℝ: from 9
           requires ∡ADB ∈ ℝ: from 12

    19.14. −π < ∡ACB − ∡ADB
           transitivity, from 10, 19.13
           requires ∡ACB ∈ ℝ: from 9
           requires ∡ADB ∈ ℝ: from 12

    19.15. ∡ACB − ∡ADB < −∡ADB
           inequalities
             ∡ACB < 0                    C2
             ∡ACB − ∡ADB < −∡ADB         adding −∡ADB
           requires ∡ACB ∈ ℝ: from 9
           requires ∡ADB ∈ ℝ: from 12

    19.16. −∡ADB < π
           inequalities
             −π < ∡ADB                   13
             π > −∡ADB                   multiplying by −1
             −∡ADB < π                   restate
           requires ∡ADB ∈ ℝ: from 12

    19.17. ∡ACB − ∡ADB < π
           transitivity, from 19.15, 19.16
           requires ∡ACB ∈ ℝ: from 9
           requires ∡ADB ∈ ℝ: from 12

    19.18. −π < ∡ACB − ∡ADB and ∡ACB − ∡ADB < π
           join 19.14, 19.17

20. −π < (j − i)·π
    substitute ∡ACB − ∡ADB = (j − i)·π (line 16) into line 19

21. (j − i)·π < π
    substitute ∡ACB − ∡ADB = (j − i)·π (line 16) into line 19

22. π > 0
    mun:pi-positive

23. π·(−1) < π·(j − i)
    inequalities
      −π < (j − i)·π           20
      π·(−1) < π·(j − i)       algebra

24. −1 < j − i
    mun:less-scaled x := −1, y := j − i, c := π, from 22, 23

25. π·(j − i) < π·1
    inequalities
      (j − i)·π < π            21
      π·(j − i) < π·1          algebra

26. j − i < 1
    mun:less-scaled x := j − i, y := 1, c := π, from 22, 25

27. −1 + 1 ≤ j − i
    mun:integer-step m := −1, n := j − i, from 24

28. 0 ≤ j − i
    inequalities
      −1 + 1 ≤ j − i           27
      0 ≤ j − i                algebra

29. j − i + 1 ≤ 1
    mun:integer-step m := j − i, n := 1, from 26

30. j − i ≤ 0
    inequalities
      j − i + 1 ≤ 1            29
      j − i ≤ 0                adding −1

31. j − i = 0
    antisymmetry, from 28, 30

32. ∡ACB − ∡ADB = 0·π
    substitute j − i = 0 (line 31) into line 16

33. ∡ACB = ∡ADB
    algebra, from 32
    requires ∡ACB ∈ ℝ: from 9
    requires ∡ADB ∈ ℝ: from 12

34. ∠ACB = ∠ADB
    calculation
      ∠ACB = |∡ACB|        mun:signed-angle-size P := A, Q := C, R := B, from 3, 4
           = |∡ADB|        substitute line 33
           = ∠ADB          mun:signed-angle-size P := A, Q := D, R := B, from 5, 6
    requires A ≠ B: mun:same-side-off-line P := C, Q := D, from H9
