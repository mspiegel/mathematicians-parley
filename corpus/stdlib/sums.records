# Standard library: sums
#
# Sums over a range of whole numbers, Σ(k = a to b), and the ranges
# {a, …, b} they run over.
#
# One record per item. A record begins at column 0 with its kind, axiom,
# theorem or definition, and its name; `mundane` before the kind marks an
# item a proof takes for granted. A proof imports each item it cites,
# `import <header> stdlib/sums/<name>`, where the header is the
# record's own before its name, as `mundane theorem` or `axiom`. Format is described in DATABASE.md.
#
# An item's statement is written in the theorem form of SYNTAX.md: let and
# assume lines with labels, then a `then` line.
#
# Every item carries both:
#   metamath-proof  how the Metamath build proves it: a set.mm label, the
#                   full name of a Parley proof or of a bridge, `none` where
#                   it has nothing to prove, or `not yet implemented`
#   lean-proof      the same for the Lean build, a Mathlib proof in place of
#                   a set.mm label
#
# Other fields: note.


mundane theorem sum-divisible
  let n ∈ ℕ₀                                                          (H1)
  let m ∈ ℤ                                                           (H2)
  let t : ℕ₀ → ℤ                                                      (H3)
  assume for all k ∈ ℕ₀, m divides t(k)                               (H4)
  then        m divides Σ(k = 0 to n) t(k)
  metamath-proof fsumdvds
  note        A number dividing every term divides the sum. set.mm asks it
              only of the terms the sum takes, k from 0 to n; asked of every
              k ∈ ℕ₀ it asks more, which is what a proof that fixes an
              arbitrary k has.
  lean-proof  by apply Finset.dvd_sum; intro k hk; rw [Finset.mem_Icc] at hk; exact h3 k hk.1

mundane theorem sum-integer
  let n ∈ ℕ₀                                                          (H1)
  let t : ℕ₀ → ℤ                                                      (H2)
  then        Σ(k = 0 to n) t(k) ∈ ℤ
  metamath-proof fsumzcl
  lean-proof  by simp_all

mundane theorem sum-difference
  let n ∈ ℕ₀                                                          (H1)
  let t : ℕ₀ → ℤ                                                      (H2)
  let u : ℕ₀ → ℤ                                                      (H3)
  then        Σ(k = 0 to n) (t(k) − u(k)) = Σ(k = 0 to n) t(k) − Σ(k = 0 to n) u(k)
  metamath-proof fsumsub
  lean-proof  by simp_all

mundane theorem sum-single
  let a ∈ ℤ                                                           (H1)
  let t : {a, …, a} → ℝ                                               (H2)
  then        Σ(k = a to a) t(k) = t(a)
  metamath-proof fsum1
  lean-proof  lean-bridges/sums/sum-single

mundane theorem sum-last
  let n ∈ ℕ₀                                                          (H1)
  let t : {0, …, n + 1} → ℝ                                           (H2)
  then        Σ(k = 0 to n + 1) t(k) = Σ(k = 0 to n) t(k) + t(n + 1)
  metamath-proof fsump1
  lean-proof  lean-bridges/sums/sum-last

mundane theorem sum-extended
  let a ∈ ℤ                                                           (H1)
  let n ∈ ℤ                                                           (H2)
  assume n ≥ a                                                        (H3)
  let t : {a, …, n + 1} → ℝ                                           (H4)
  then        Σ(k = a to n + 1) t(k) = Σ(k = a to n) t(k) + t(n + 1)
  metamath-proof fsump1
  lean-proof  lean-bridges/sums/sum-extended
  note        `sum-last` from a start of the proof's own choosing: the sum
              formula counts from 1, where `sum-last` counts from 0.

theorem sum-telescopes
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  assume b + 1 ≥ a                                                    (H3)
  let t : {a, …, b + 1} → ℝ                                           (H4)
  then        Σ(k = a to b) (t(k) − t(k + 1)) = t(a) − t(b + 1)
  metamath-proof telfsum
  note        A telescoping sum: each term's second half cancels the next
              term's first, and what is left is the first and the last.
  lean-proof  by obtain ⟨n, hn⟩ : ∃ n : ℕ, b = a - 1 + n := ⟨(b - (a - 1)).toNat, by omega⟩; subst hn; clear h3; induction n with | zero => (simp only [Nat.cast_zero, add_zero]; rw [Finset.Icc_eq_empty_of_lt (by omega)]; simp) | succ k ih => (rw [(show a - 1 + ((k + 1 : ℕ) : ℤ) = (a - 1 + k) + 1 by push_cast; ring), (show Finset.Icc a (a - 1 + k + 1) = insert (a - 1 + k + 1) (Finset.Icc a (a - 1 + k)) by ext x; simp only [Finset.mem_Icc, Finset.mem_insert]; omega), Finset.sum_insert (by simp), ih]; ring)

theorem sum-telescopes-up
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  assume b + 1 ≥ a                                                    (H3)
  let t : {a, …, b + 1} → ℂ                                           (H4)
  then        Σ(k = a to b) (t(k + 1) − t(k)) = t(b + 1) − t(a)
  metamath-proof telfsum2
  note        The telescoping sum with each term's differences taken the
              other way, each value less the one before, over ℂ as set.mm
              states it: what is left is the last less the first.
  lean-proof  by have key : ∀ n : ℕ, ∑ k ∈ Finset.Icc a (a - 1 + n), (t (k + 1) - t k) = t (a - 1 + n + 1) - t a := (by intro n; induction n with | zero => (rw [Nat.cast_zero, add_zero, Finset.Icc_eq_empty_of_lt (by omega)]; simp) | succ n ih => (rw [(show a - 1 + ((n + 1 : ℕ) : ℤ) = (a - 1 + n) + 1 by push_cast; ring), ← Finset.insert_Icc_right_eq_Icc_add_one (by omega), Finset.sum_insert (by simp), ih]; ring)); have := key (b + 1 - a).toNat; rwa [(show a - 1 + ((b + 1 - a).toNat : ℤ) = b by omega)] at this

mundane theorem sum-first
  let n ∈ ℕ₀                                                          (H1)
  let t : {0, …, n} → ℝ                                               (H2)
  then        Σ(k = 0 to n) t(k) = t(0) + Σ(k = 0 + 1 to n) t(k)
  metamath-proof fsum1p
  note        The rest of the sum starts at 0 + 1, as set.mm writes it; a
              proof that wants 1 there substitutes.
  lean-proof  lean-bridges/sums/sum-first

mundane theorem sum-shift
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  let c ∈ ℤ                                                           (H3)
  let t : {a, …, b} → ℝ                                               (H4)
  then        Σ(k = a to b) t(k) = Σ(k = a + c to b + c) t(k − c)
  metamath-proof fsumshft
  note        The same terms counted from a different start: the term the
              left side takes at k, the right side takes at k + c.
  lean-proof  lean-bridges/sums/sum-shift

mundane theorem sum-scaled
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  let c ∈ ℝ                                                           (H3)
  let t : {a, …, b} → ℝ                                               (H4)
  then        c·(Σ(k = a to b) t(k)) = Σ(k = a to b) c·t(k)
  metamath-proof fsummulc2
  lean-proof  Finset.mul_sum _ _ _

mundane theorem sum-add
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  let t : {a, …, b} → ℝ                                               (H3)
  let u : {a, …, b} → ℝ                                               (H4)
  then        Σ(k = a to b) (t(k) + u(k)) = Σ(k = a to b) t(k) + Σ(k = a to b) u(k)
  metamath-proof fsumadd
  lean-proof  Finset.sum_add_distrib

mundane theorem sum-termwise
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  let t : {a, …, b} → ℝ                                               (H3)
  let u : {a, …, b} → ℝ                                               (H4)
  assume for all k ∈ {a, …, b}, t(k) = u(k)                           (H5)
  then        Σ(k = a to b) t(k) = Σ(k = a to b) u(k)
  metamath-proof sumeq2dv
  lean-proof  Finset.sum_congr rfl h3
  note        Two sums over one range are equal when their terms are, index
              by index. The terms need agree only where the sum takes them,
              which is what lets a term be rewritten by a fact that holds on
              the range and nowhere else.

mundane theorem sum-termwise-complex
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  let t : {a, …, b} → ℂ                                               (H3)
  let u : {a, …, b} → ℂ                                               (H4)
  assume for all k ∈ {a, …, b}, t(k) = u(k)                           (H5)
  then        Σ(k = a to b) t(k) = Σ(k = a to b) u(k)
  metamath-proof sumeq2dv
  lean-proof  Finset.sum_congr rfl h3
  note        `sum-termwise` for terms that are complex numbers.

mundane theorem sum-real
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  let t : {a, …, b} → ℝ                                               (H3)
  then        Σ(k = a to b) t(k) ∈ ℝ
  metamath-proof fsumrecl
  lean-proof  trivial

mundane theorem product-real
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  let t : {a, …, b} → ℝ                                               (H3)
  then        ∏(k ∈ {a, …, b}) t(k) ∈ ℝ
  metamath-proof fprodrecl
  lean-proof  trivial

mundane theorem product-range-nonneg
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  let t : {a, …, b} → ℝ                                               (H3)
  assume for all k ∈ {a, …, b}, t(k) ≥ 0                              (H4)
  then        ∏(k ∈ {a, …, b}) t(k) ≥ 0
  metamath-proof metamath-bridges/ranges/gfprodge0
  note        As sum-nonneg, for a product: factors none of them negative
              have a product that is not negative.
  lean-proof  Finset.prod_nonneg h3

mundane theorem product-single
  let a ∈ ℤ                                                           (H1)
  let t : {a, …, a} → ℝ                                               (H2)
  then        ∏(k ∈ {a, …, a}) t(k) = t(a)
  metamath-proof fprod1
  lean-proof  lean-bridges/sums/product-single

mundane theorem product-extended
  let a ∈ ℤ                                                           (H1)
  let n ∈ ℤ                                                           (H2)
  assume n ≥ a                                                        (H3)
  let t : {a, …, n + 1} → ℝ                                           (H4)
  then        ∏(k ∈ {a, …, n + 1}) t(k) = (∏(k ∈ {a, …, n}) t(k))·t(n + 1)
  metamath-proof fprodp1
  note        As sum-extended, for a product: the last factor split off.
  lean-proof  lean-bridges/sums/product-extended

mundane theorem product-first
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  assume a ≤ b                                                        (H3)
  let t : {a, …, b} → ℝ                                               (H4)
  then        ∏(k = a to b) t(k) = t(a)·∏(k = a + 1 to b) t(k)
  metamath-proof fprod1p
  note        As sum-first, for a product: the first factor split off.
  lean-proof  by rw [(show Finset.Icc a b = insert a (Finset.Icc (a + 1) b) by ext x; simp only [Finset.mem_Icc, Finset.mem_insert]; omega), Finset.prod_insert (by simp)]

mundane theorem product-termwise
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  let t : X → Z                                                       (H3)
  let u : Y → W                                                       (H4)
  assume for all k ∈ {a, …, b}, t(k) = u(k)                           (H5)
  then        ∏(k ∈ {a, …, b}) t(k) = ∏(k ∈ {a, …, b}) u(k)
  metamath-proof prodeq2dv
  note        As sum-termwise, for a product: two products over one range
              are equal when their factors are, index by index. The two
              functions need agree only on the range, and either may be
              defined beyond it, as a list extended by one place is.
  lean-proof  Finset.prod_congr rfl h3

mundane theorem range-difference
  let a ∈ ℤ                                                           (H1)
  let n ∈ ℤ                                                           (H2)
  let k ∈ {a, …, n}                                                   (H3)
  then        n − k ∈ ℕ₀
  metamath-proof fznn0sub
  lean-proof  lean-bridges/sums/range-difference
  note        An index no greater than n leaves a whole number when taken
              from n, which is what lets x^(n − k) be a power with a natural
              exponent.

mundane theorem range-integer
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  let k ∈ {a, …, b}                                                   (H3)
  then        k ∈ ℤ
  metamath-proof elfzelz
  lean-proof  by simp_all

mundane theorem range-nat0
  let n ∈ ℤ                                                           (H1)
  let k ∈ {0, …, n}                                                   (H2)
  then        k ∈ ℕ₀
  metamath-proof elfznn0
  lean-proof  (Finset.mem_Icc.mp h2).1

mundane theorem range-nat
  let n ∈ ℤ                                                           (H1)
  let k ∈ {1, …, n}                                                   (H2)
  then        k ∈ ℕ
  metamath-proof elfznn
  note        No proof cites it: a line saying k ∈ {1, …, n} says k ∈ ℕ as
              well, and a line said of every k ∈ ℕ answers a hypothesis over
              the range (`SYNTAX.md`), both by this lemma.
  lean-proof  by (aesop)

definition range
  let n ∈ ℤ                                                           (H1)
  then        k ∈ {1, …, n} ↔ k ∈ ℕ and k ≤ n
  metamath-proof fznn
  lean-proof  by rw [Finset.mem_Icc]; omega

definition range0
  let n ∈ ℕ₀                                                          (H1)
  then        k ∈ {0, …, n} ↔ k ∈ ℕ₀ and k ≤ n
  metamath-proof fznn0
  lean-proof  Finset.mem_Icc

mundane theorem range-single
  let m ∈ ℤ                                                           (H1)
  then        {m, …, m} = {m}
  metamath-proof fzsn
  lean-proof  by (simp_all; done)

mundane theorem range-empty
  then        {1, …, 0} = ∅
  metamath-proof fz10
  lean-proof  by (simp_all; done)

mundane theorem range-split
  let k ∈ {m, …, n}                                                   (H1)
  then        {m, …, n} = {m, …, k} ∪ {k + 1, …, n}
  metamath-proof fzsplit
  lean-proof  by simp only [Finset.mem_Icc] at h1; ext x; simp only [Set.mem_union, Set.mem_Icc]; omega

mundane theorem range-extended
  let k ∈ {a, …, b}                                                   (H1)
  then        k ∈ {a, …, b + 1}
  metamath-proof fzelp1
  lean-proof  by simp only [Finset.mem_Icc] at h1 ⊢; omega

mundane theorem range-without-last
  let n ∈ ℕ                                                           (H1)
  then        {1, …, n} = {1, …, n + 1} ∖ {n + 1}
  metamath-proof fzdifsuc with M := 1, N := n
  note        The numbers up to n are the numbers up to n + 1 but the last.
  lean-proof  by aesop

mundane theorem range-end
  let n ∈ ℕ                                                           (H1)
  then        n ∈ {1, …, n}
  metamath-proof elfz1end
  note        The last of the numbers from 1 to n is n.
  lean-proof  by aesop

mundane theorem range-within
  let a ∈ ℤ                                                           (H1)
  let k ∈ ℤ                                                           (H2)
  let n ∈ ℤ                                                           (H3)
  assume k ≤ n                                                        (H4)
  then        {a, …, k} ⊆ {a, …, n}
  metamath-proof fzss2 with M := a, K := k, N := n
  note        A range that stops sooner lies inside one that stops later.
  lean-proof  Set.Icc_subset_Icc_right h4

mundane theorem range-inside
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  let c ∈ ℤ                                                           (H3)
  let d ∈ ℤ                                                           (H4)
  assume c ≤ a                                                        (H5)
  assume b ≤ d                                                        (H6)
  then        {a, …, b} ⊆ {c, …, d}
  metamath-proof metamath-bridges/ranges/gfzss with K := c, M := a, N := b, L := d
  note        A range whose ends lie within another's lies inside it.
  lean-proof  Set.Icc_subset_Icc h5 h6

definition range-between
  let k ∈ ℤ                                                           (H1)
  let a ∈ ℤ                                                           (H2)
  let b ∈ ℤ                                                           (H3)
  then        k ∈ {a, …, b} ↔ a ≤ k and k ≤ b
  metamath-proof elfz
  lean-proof Finset.mem_Icc
  note        A whole number is in a range when it lies between the ends,
              whatever the ends are: {0, …, n − 1} is read so at n = 0, where
              it is empty, as well as at every other n.

mundane theorem range-bounds
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  let k ∈ {a, …, b}                                                   (H3)
  then        a ≤ k. k ≤ b.
  metamath-proof elfzle1, elfzle2
  lean-proof  (Finset.mem_Icc.mp h3).1 ; (Finset.mem_Icc.mp h3).2

mundane theorem sum-split
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  let c ∈ ℤ                                                           (H3)
  assume a ≤ b + 1                                                    (H4)
  assume b ≤ c                                                        (H5)
  let t : {a, …, c} → ℝ                                               (H6)
  then        Σ(k = a to c) t(k) = Σ(k = a to b) t(k) + Σ(k = b + 1 to c) t(k)
  metamath-proof metamath-bridges/ranges/gfsumsplit
  note        A sum over a range is the sum over its first part and the sum
              over the rest.
  lean-proof  lean-bridges/sums/sum-split

mundane theorem sum-le
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  let t : {a, …, b} → ℝ                                               (H3)
  let u : {a, …, b} → ℝ                                               (H4)
  assume for all k ∈ {a, …, b}, t(k) ≤ u(k)                           (H5)
  then        Σ(k = a to b) t(k) ≤ Σ(k = a to b) u(k)
  metamath-proof fsumle
  note        A sum whose every term is at most another's, index by index,
              is at most the other sum.
  lean-proof  Finset.sum_le_sum h3

mundane theorem sum-constant
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  assume a ≤ b                                                        (H3)
  let c ∈ ℝ                                                           (H4)
  then        Σ(k = a to b) c = (b − a + 1)·c
  metamath-proof metamath-bridges/ranges/gfsumconst
  note        The same term b − a + 1 times.
  lean-proof  lean-bridges/sums/sum-constant

mundane theorem sum-constant-over
  let X be a set                                                      (H1)
  assume X is finite                                                  (H2)
  let c ∈ ℂ                                                           (H3)
  then        Σ(x ∈ X) c = |X|·c
  metamath-proof fsumconst
  note        The same term once for each member of X, whatever X holds.
  lean-proof  by rw [finsum_mem_eq_finite_toFinset_sum _ h1, Finset.sum_const, nsmul_eq_mul, Set.ncard_eq_toFinset_card _ h1]

mundane theorem sum-empty-range
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  assume b < a                                                        (H3)
  let t : {a, …, b} → ℝ                                               (H4)
  then        Σ(k = a to b) t(k) = 0
  metamath-proof metamath-bridges/ranges/gfsum0
  note        A range that ends before it starts has no terms, and their sum
              is 0: Σ(k = 1 to 0) (2k − 1) = 0 is the base case of an
              induction from 0 over a sum from 1.
  lean-proof  by (simp_all; done)

mundane theorem sum-empty-set
  let t : ℤ → ℝ                                                       (H1)
  then        Σ(k ∈ ∅) t(k) = 0
  metamath-proof sum0
  note        A sum over a set with no members is 0.
  lean-proof  by exact finsum_mem_empty

mundane theorem sum-of-three
  let a ∈ ℝ                                                           (H1)
  let b ∈ ℝ                                                           (H2)
  let c ∈ ℝ                                                           (H3)
  assume a ≠ b                                                        (H4)
  assume a ≠ c                                                        (H5)
  assume b ≠ c                                                        (H6)
  then        Σ(d ∈ {a, b, c}) d = a + b + c
  metamath-proof sumtp with V := ℝ, W := ℝ, X := ℝ
  note        Three different numbers listed, summed. sumtp asks each
              number to lie in some set, and ℝ is the one they lie in.
  lean-proof  by rw [finsum_mem_insert _ (by simp [h4, h5]) (Set.toFinite _), finsum_mem_pair h6]; ring

mundane theorem sum-nonneg
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  let t : {a, …, b} → ℝ                                               (H3)
  assume for all k ∈ {a, …, b}, t(k) ≥ 0                              (H4)
  then        Σ(k = a to b) t(k) ≥ 0
  metamath-proof fsumge0
  lean-proof  Finset.sum_nonneg h3

mundane theorem sum-zero-terms
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  let t : {a, …, b} → ℝ                                               (H3)
  assume for all k ∈ {a, …, b}, t(k) ≥ 0                              (H4)
  assume Σ(k = a to b) t(k) = 0                                       (H5)
  then        for all k ∈ {a, …, b}, t(k) = 0
  metamath-proof fsum00
  note        A sum of terms none of them negative is 0 only where every
              term is.
  lean-proof  by exact (Finset.sum_eq_zero_iff_of_nonneg h3).mp h4

mundane theorem range-finite
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  then        {a, …, b} is finite
  metamath-proof fzfi
  lean-proof  by simp_all

mundane theorem range-in-integers
  let a ∈ ℤ                                                           (H1)
  let b ∈ ℤ                                                           (H2)
  then        {a, …, b} ⊆ ℤ
  metamath-proof fzssz
  lean-proof  by simp_all

mundane theorem range-from-bounds
  let m ∈ ℕ                                                           (H1)
  let x ∈ ℕ₀                                                          (H2)
  assume x < m                                                        (H3)
  then        x ∈ {0, …, m − 1}
  metamath-proof metamath-bridges/totient/gelfz0m1
  lean-proof  lean-bridges/sums/range-from-bounds

mundane theorem product-integer
  let X ⊆ ℤ                                                           (H1)
  assume X is finite                                                  (H2)
  then        ∏(x ∈ X) x ∈ ℤ
  metamath-proof metamath-bridges/totient/gfprodz
  lean-proof  by (simp_all; done)

mundane theorem product-split
  let X be a set                                                      (H1)
  assume X is finite                                                  (H2)
  assume X = Y ∪ Z                                                    (H3)
  assume Y ∩ Z = ∅                                                    (H4)
  let t : X → ℝ                                                       (H5)
  then        ∏(x ∈ X) t(x) = (∏(x ∈ Y) t(x))·∏(x ∈ Z) t(x)
  metamath-proof fprodsplit
  note        A finite set made of two parts with nothing in common: the
              product over it is the product over one part times the
              product over the other.
  lean-proof  by subst h2; exact finprod_mem_union (Set.disjoint_iff_inter_eq_empty.mpr h3) (h1.subset Set.subset_union_left) (h1.subset Set.subset_union_right)

mundane theorem product-reindex
  let Y be a set                                                      (H1)
  assume Y is finite                                                  (H2)
  let g : Y → Z be one-to-one and onto                                (H3)
  let t : Z → ℝ                                                       (H4)
  then        ∏(z ∈ Z) t(z) = ∏(y ∈ Y) t(g(y))
  metamath-proof metamath-bridges/totient/gfprodf1o
  note        g pairs each member of Y with one of Z, so the factors over
              Z are those over Y, counted through g.
  lean-proof  by rw [← h2.2.2.image_eq_of_mapsTo h2.1]; exact finprod_mem_image h2.2.1

mundane theorem product-of-products
  let X be a set                                                      (H1)
  assume X is finite                                                  (H2)
  let t : X → ℝ                                                       (H3)
  let u : X → ℝ                                                       (H4)
  then        ∏(x ∈ X) t(x)·u(x) = (∏(x ∈ X) t(x))·∏(x ∈ X) u(x)
  metamath-proof fprodmul
  note        Each factor a product of two: the two kinds of factor may be
              multiplied out separately.
  lean-proof  by exact finprod_mem_mul_distrib h1

mundane theorem product-of-ones
  let X be a set                                                      (H1)
  assume X is finite                                                  (H2)
  then        ∏(x ∈ X) 1 = 1
  metamath-proof prod1
  lean-proof  by (simp_all; done)

mundane theorem product-empty
  let X be a set                                                      (H1)
  let t : X → ℝ                                                       (H2)
  then        ∏(x ∈ ∅) t(x) = 1
  metamath-proof prod0
  note        A product over a set with no members is 1, the base of an
              induction over the parts of a finite set.
  lean-proof  by exact finprod_mem_empty

mundane theorem product-add-one
  let X be a set                                                      (H1)
  let Y ⊆ X                                                           (H2)
  assume Y is finite                                                  (H3)
  let a ∈ X                                                           (H4)
  assume a ∉ Y                                                        (H5)
  let t : X → ℝ                                                       (H6)
  then        ∏(x ∈ Y ∪ {a}) t(x) = (∏(x ∈ Y) t(x))·t(a)
  metamath-proof metamath-bridges/induction/gprodaddone
  note        A member added to a finite set multiplies the product by its
              term, the step of an induction over the parts of a finite set.
  lean-proof  by rw [Set.union_singleton, finprod_mem_insert _ h4 h2, mul_comm]

mundane theorem product-integer-terms
  let X be a set                                                      (H1)
  assume X is finite                                                  (H2)
  let t : X → ℤ                                                       (H3)
  then        for all Y ⊆ X, ∏(x ∈ Y) t(x) ∈ ℤ
  metamath-proof stdlib/sums/product-integer-terms
  lean-proof  by exact fun _ _ => trivial

mundane theorem product-constant
  let X be a set                                                      (H1)
  assume X is finite                                                  (H2)
  let c ∈ ℝ                                                           (H3)
  then        ∏(x ∈ X) c = c^|X|
  metamath-proof stdlib/sums/product-constant
  lean-proof  by rw [finprod_mem_eq_finite_toFinset_prod _ h1, Finset.prod_const, Set.ncard_eq_toFinset_card _ h1]

theorem product-factor
  let X ⊆ ℤ                                                           (H1)
  assume X is finite                                                  (H2)
  let c ∈ ℤ                                                           (H3)
  then        ∏(x ∈ X) x·c = c^|X|·∏(x ∈ X) x
  metamath-proof stdlib/sums/product-factor
  lean-proof  by rw [finprod_mem_eq_finite_toFinset_prod _ h2, finprod_mem_eq_finite_toFinset_prod _ h2, Finset.prod_mul_distrib, Finset.prod_const, Set.ncard_eq_toFinset_card _ h2]; ring

theorem product-reorder
  let X ⊆ ℤ                                                           (H1)
  assume X is finite                                                  (H2)
  let f : X → X be one-to-one                                         (H3)
  then        ∏(x ∈ X) f(x) = ∏(x ∈ X) x
  metamath-proof stdlib/sums/product-reorder
  lean-proof  by have hb := (h2.injOn_iff_bijOn_of_mapsTo h3.1).mp h3.2; have hi := finprod_mem_image (f := fun y : ℤ => y) h3.2; rw [← hi, hb.image_eq]
