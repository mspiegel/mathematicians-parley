lemma galtang
  |- ( P e. CC -> ( Q e. CC -> ( R e. CC -> ( S e. CC -> ( -. Q = P -> ( -. R = P -> ( ( ( S - R ) /
      ( Q - P ) ) e. RR -> ( ( ( Im ` ( ( S - R ) / ( P - R ) ) ) x. ( Im ` ( ( Q - R ) / ( P - R )
      ) ) ) < 0 -> ( abs ` ( ( S - R ) ang ( P - R ) ) ) = ( abs ` ( ( R - P ) ang ( Q - P ) ) ) ) )
      ) ) ) ) ) )
