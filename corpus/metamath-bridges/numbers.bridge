# Numbers, for `proved.mm`.
#
# What the proofs ask of whole numbers that set.mm says only of a wider
# system, each reached by `zre` and `nnrp`: a remainder on dividing an
# integer by a natural number is less than the divisor (`modlt`, for
# `mun:stdlib/divisibility/mod-less`), and adding a multiple of the divisor
# leaves the remainder as it was (`muladdmod`, for
# `mun:stdlib/divisibility/mod-multiple`). And what set.mm says of a
# positive real divisor, said of a real one greater than 0 and reached by
# `elrpd`: the remainder's value (`modval`, for
# `mun:stdlib/divisibility/mod-value`), that it is real (`modcl`, for
# `mun:stdlib/divisibility/mod-real`), and a real below the divisor its own
# remainder (`modid`, for `mun:stdlib/divisibility/mod-below`). And an
# integer's sign, the half of `elznn0` a proof reaches for (for
# `mun:stdlib/numbers/integer-sign`).

$( Numbers: a remainder is less than its divisor, a multiple of the
   divisor added leaves it as it was, a real's remainder on dividing by a
   positive real is what is left after its whole multiples, a real below
   the divisor is its own remainder, an integer or its negative is a
   whole number, and a positive real's real power is positive. $)

# ( ( A e. ZZ /\ B e. NN ) -> ( A mod B ) < B )
lemma gzmodlt
  |- ( ( A e. ZZ /\ B e. NN ) -> ( A mod B ) < B )
  1 zre |- ( A e. ZZ -> A e. RR )
  2 nnrp |- ( B e. NN -> B e. RR+ )
  3 modlt |- ( ( A e. RR /\ B e. RR+ ) -> ( A mod B ) < B )
  4 syl2an 1 2 3 |- ( ( A e. ZZ /\ B e. NN ) -> ( A mod B ) < B )

# ( ( A e. ZZ /\ M e. NN /\ N e. ZZ ) -> ( ( ( N x. M ) + A ) mod M ) = ( A mod M ) )
lemma gmuladdmod
  |- ( ( A e. ZZ /\ M e. NN /\ N e. ZZ ) -> ( ( ( N x. M ) + A ) mod M ) = ( A mod M ) )
  1 zre |- ( A e. ZZ -> A e. RR )
  2 nnrp |- ( M e. NN -> M e. RR+ )
  3 id |- ( N e. ZZ -> N e. ZZ )
  4 muladdmod |- ( ( A e. RR /\ M e. RR+ /\ N e. ZZ ) -> ( ( ( N x. M ) + A ) mod M ) = ( A mod M )
      )
  5 syl3an 1 2 3 4 |- ( ( A e. ZZ /\ M e. NN /\ N e. ZZ ) -> ( ( ( N x. M ) + A ) mod M ) = ( A mod
      M ) )

# ( ( A e. RR /\ B e. RR /\ 0 < B ) -> ( A mod B ) = ( A - ( B x. ( |_ ` ( A / B ) ) ) ) )
lemma gmodval
  |- ( ( A e. RR /\ B e. RR /\ 0 < B ) -> ( A mod B ) = ( A - ( B x. ( |_ ` ( A / B ) ) ) ) )
  1 simp1 |- ( ( A e. RR /\ B e. RR /\ 0 < B ) -> A e. RR )
  2 simp2 |- ( ( A e. RR /\ B e. RR /\ 0 < B ) -> B e. RR )
  3 simp3 |- ( ( A e. RR /\ B e. RR /\ 0 < B ) -> 0 < B )
  4 elrpd 2 3 |- ( ( A e. RR /\ B e. RR /\ 0 < B ) -> B e. RR+ )
  5 modval |- ( ( A e. RR /\ B e. RR+ ) -> ( A mod B ) = ( A - ( B x. ( |_ ` ( A / B ) ) ) ) )
  6 syl2anc 1 4 5 |- ( ( A e. RR /\ B e. RR /\ 0 < B ) -> ( A mod B ) = ( A - ( B x. ( |_ ` ( A /
      B ) ) ) ) )

# ( ( A e. RR /\ B e. RR /\ 0 < B ) -> ( A mod B ) e. RR ), `modcl` said of a
# real greater than 0, as `gmodval` is.
lemma gmodcl
  |- ( ( A e. RR /\ B e. RR /\ 0 < B ) -> ( A mod B ) e. RR )
  1 simp1 |- ( ( A e. RR /\ B e. RR /\ 0 < B ) -> A e. RR )
  2 simp2 |- ( ( A e. RR /\ B e. RR /\ 0 < B ) -> B e. RR )
  3 simp3 |- ( ( A e. RR /\ B e. RR /\ 0 < B ) -> 0 < B )
  4 elrpd 2 3 |- ( ( A e. RR /\ B e. RR /\ 0 < B ) -> B e. RR+ )
  5 modcl |- ( ( A e. RR /\ B e. RR+ ) -> ( A mod B ) e. RR )
  6 syl2anc 1 4 5 |- ( ( A e. RR /\ B e. RR /\ 0 < B ) -> ( A mod B ) e. RR )

# ( ( ( A e. RR /\ B e. RR ) /\ ( 0 <_ A /\ A < B ) ) -> ( A mod B ) = A )
lemma gmodid
  |- ( ( ( A e. RR /\ B e. RR ) /\ ( 0 <_ A /\ A < B ) ) -> ( A mod B ) = A )
  1 simpll |- ( ( ( A e. RR /\ B e. RR ) /\ ( 0 <_ A /\ A < B ) ) -> A e. RR )
  2 simplr |- ( ( ( A e. RR /\ B e. RR ) /\ ( 0 <_ A /\ A < B ) ) -> B e. RR )
  3 simprl |- ( ( ( A e. RR /\ B e. RR ) /\ ( 0 <_ A /\ A < B ) ) -> 0 <_ A )
  4 simprr |- ( ( ( A e. RR /\ B e. RR ) /\ ( 0 <_ A /\ A < B ) ) -> A < B )
  5 0red |- ( ( ( A e. RR /\ B e. RR ) /\ ( 0 <_ A /\ A < B ) ) -> 0 e. RR )
  6 lelttrd 5 1 2 3 4 |- ( ( ( A e. RR /\ B e. RR ) /\ ( 0 <_ A /\ A < B ) ) -> 0 < B )
  7 elrpd 2 6 |- ( ( ( A e. RR /\ B e. RR ) /\ ( 0 <_ A /\ A < B ) ) -> B e. RR+ )
  8 simpr |- ( ( ( A e. RR /\ B e. RR ) /\ ( 0 <_ A /\ A < B ) ) -> ( 0 <_ A /\ A < B ) )
  9 modid |- ( ( ( A e. RR /\ B e. RR+ ) /\ ( 0 <_ A /\ A < B ) ) -> ( A mod B ) = A )
  10 syl21anc 1 7 8 9 |- ( ( ( A e. RR /\ B e. RR ) /\ ( 0 <_ A /\ A < B ) ) -> ( A mod B ) = A )

# ( N e. ZZ -> ( N e. NN0 \/ -u N e. NN0 ) ), the second part of `elznn0`.
lemma gznn0neg
  |- ( N e. ZZ -> ( N e. NN0 \/ -u N e. NN0 ) )
  1 elznn0 |- ( N e. ZZ <-> ( N e. RR /\ ( N e. NN0 \/ -u N e. NN0 ) ) )
  2 simprbi 1 |- ( N e. ZZ -> ( N e. NN0 \/ -u N e. NN0 ) )

# ( ( N e. ZZ /\ N =/= 0 ) -> 1 <_ ( abs ` N ) ): an integer other than 0
# has a whole number for its absolute value (`nnabscl`), and a whole
# number is at least 1 (`nnge1`), for `mun:stdlib/numbers/nonzero-integer-abs`.
lemma gzabsge1
  |- ( ( N e. ZZ /\ N =/= 0 ) -> 1 <_ ( abs ` N ) )
  1 nnabscl |- ( ( N e. ZZ /\ N =/= 0 ) -> ( abs ` N ) e. NN )
  2 nnge1 |- ( ( abs ` N ) e. NN -> 1 <_ ( abs ` N ) )
  3 syl 1 2 |- ( ( N e. ZZ /\ N =/= 0 ) -> 1 <_ ( abs ` N ) )

# ( ( A e. RR /\ 0 < A /\ B e. RR ) -> 0 < ( A ^c B ) ), `cxpgt0d` said of
# a real greater than 0, as `gmodval` is (for
# `mun:stdlib/numbers/real-power-positive`).
lemma gcxpgt0
  |- ( ( A e. RR /\ 0 < A /\ B e. RR ) -> 0 < ( A ^c B ) )
  1 simp1 |- ( ( A e. RR /\ 0 < A /\ B e. RR ) -> A e. RR )
  2 simp2 |- ( ( A e. RR /\ 0 < A /\ B e. RR ) -> 0 < A )
  3 simp3 |- ( ( A e. RR /\ 0 < A /\ B e. RR ) -> B e. RR )
  4 elrpd 1 2 |- ( ( A e. RR /\ 0 < A /\ B e. RR ) -> A e. RR+ )
  5 cxpgt0d 4 3 |- ( ( A e. RR /\ 0 < A /\ B e. RR ) -> 0 < ( A ^c B ) )

