# Functions and their images, for `proved.mm`.
#
# What Schröder–Bernstein asks of functions that set.mm says in two steps
# and the page in one. Each lemma is a chain of two or three set.mm lemmas:
#
# - what is in an image: `fvelimab` says it of a function on A, which `ffn`
#   reads off f : A → B, with its equation turned by `eqcom` to the page's
#   u = f(s), for `def:stdlib/functions/image`;
# - a value lies in the image of a set holding its point: `fnfvima`, with
#   `ffn` the same way, for `mun:stdlib/functions/value-in-image`;
# - a one-to-one function's inverse undoes it: `f1f1orn` makes it a
#   bijection onto its range, where `f1ocnvfv1` applies, for
#   `mun:stdlib/functions/inverse-value`;
# - a function that is one-to-one and reaches every point is a bijection:
#   `dffo3` reads the reaching as onto, `df-f1o` puts the two together, and
#   `f1oeng` gives the bijection, for `def:stdlib/functions/bijection`;
# - a bijection gives a function that reaches every point: `bren` gives
#   one that is one-to-one and onto, `f1ofo` and `foelrn` say it reaches
#   each point, and `encv` with `elmapg` puts it among the functions from
#   A to B, which `df-rex` says is the "there is" over them, for
#   `mun:stdlib/functions/bijection-onto`;
# - a map sends its domain into a set exactly when each value lies there:
#   `fmpt` says it of a name for the map, and `eqid` names the map itself,
#   for `mun:stdlib/functions/function-into`;
# - two names for one function are one-to-one together: `f1eq1` with its
#   antecedent given, which set.mm states as an implication only, where it
#   has `feq1i` and `fneq1i` for the other two function predicates. It is
#   what carries a renaming of a map's bound letter up through
#   "is one-to-one";
# - a function into one class is a function into an equal one: `feq3`
#   with its antecedent given, which set.mm has only as an implication. It
#   carries a renaming of a bound letter in a codomain, as ⋃(Y ∈ C) Y, up
#   through f : A → B;
# - what is in a preimage: `elpreima` says it of a function on A, which
#   `ffn` reads off f : A → B, for `def:stdlib/functions/preimage`;
# - a one-to-one function onto B has an inverse from B to A: `f1f1orn`
#   and `f1ocnv` turn it round onto its range, `fnima` makes the range
#   f[A], which is B, for `mun:stdlib/functions/inverse-function`.

$( Functions: images, inverses, a bijection from one-to-one and onto,
   and an onto function from a bijection. $)
$d f x y A $.
$d f x y B $.
$d x y F $.
$d x D $.
$d x S $.

# ( ( F : A --> B /\ S C_ A ) -> ( D e. ( F " S ) <-> E. x e. S D = ( F ` x ) ) )
lemma gfvelima
  |- ( ( F : A --> B /\ S C_ A ) -> ( D e. ( F " S ) <-> E. x e. S D = ( F ` x ) ) )
  1 ffn |- ( F : A --> B -> F Fn A )
  2 fvelimab |- ( ( F Fn A /\ S C_ A ) -> ( D e. ( F " S ) <-> E. x e. S ( F ` x ) = D ) )
  3 sylan 1 2 |- ( ( F : A --> B /\ S C_ A ) -> ( D e. ( F " S ) <-> E. x e. S ( F ` x ) = D ) )
  4 eqcom |- ( ( F ` x ) = D <-> D = ( F ` x ) )
  5 rexbii 4 |- ( E. x e. S ( F ` x ) = D <-> E. x e. S D = ( F ` x ) )
  6 bitrdi 3 5 |- ( ( F : A --> B /\ S C_ A ) -> ( D e. ( F " S ) <-> E. x e. S D = ( F ` x ) ) )

# ( F : A -1-1-> B <-> G : A -1-1-> B ), from F = G
lemma gf1eq1i
  hypothesis gf1eq1i.1 |- F = G
  |- ( F : A -1-1-> B <-> G : A -1-1-> B )
  1 f1eq1 |- ( F = G -> ( F : A -1-1-> B <-> G : A -1-1-> B ) )
  2 ax-mp gf1eq1i.1 1 |- ( F : A -1-1-> B <-> G : A -1-1-> B )

# ( F : A -onto-> B <-> G : A -onto-> B ), from F = G
lemma gfoeq1i
  hypothesis gfoeq1i.1 |- F = G
  |- ( F : A -onto-> B <-> G : A -onto-> B )
  1 foeq1 |- ( F = G -> ( F : A -onto-> B <-> G : A -onto-> B ) )
  2 ax-mp gfoeq1i.1 1 |- ( F : A -onto-> B <-> G : A -onto-> B )

# ( F : C --> A <-> F : C --> B ), from A = B
lemma gfeq3i
  hypothesis gfeq3i.1 |- A = B
  |- ( F : C --> A <-> F : C --> B )
  1 feq3 |- ( A = B -> ( F : C --> A <-> F : C --> B ) )
  2 ax-mp gfeq3i.1 1 |- ( F : C --> A <-> F : C --> B )

# ( ( F : A -1-1-> B /\ C e. A ) -> ( `' F ` ( F ` C ) ) = C )
lemma gf1cnvfv1
  |- ( ( F : A -1-1-> B /\ C e. A ) -> ( `' F ` ( F ` C ) ) = C )
  1 f1f1orn |- ( F : A -1-1-> B -> F : A -1-1-onto-> ran F )
  2 f1ocnvfv1 |- ( ( F : A -1-1-onto-> ran F /\ C e. A ) -> ( `' F ` ( F ` C ) ) = C )
  3 sylan 1 2 |- ( ( F : A -1-1-> B /\ C e. A ) -> ( `' F ` ( F ` C ) ) = C )

# ( F : A --> B -> ( C e. ( `' F " D ) <-> ( C e. A /\ ( F ` C ) e. D ) ) ):
# what is in a preimage, `elpreima` said of a function the page types.
lemma gelpreima
  |- ( F : A --> B -> ( C e. ( `' F " D ) <-> ( C e. A /\ ( F ` C ) e. D ) ) )
  1 ffn |- ( F : A --> B -> F Fn A )
  2 elpreima |- ( F Fn A -> ( C e. ( `' F " D ) <-> ( C e. A /\ ( F ` C ) e. D ) ) )
  3 syl 1 2 |- ( F : A --> B -> ( C e. ( `' F " D ) <-> ( C e. A /\ ( F ` C ) e. D ) ) )

# ( F : A --> B -> ( `' F " C ) C_ A ): a preimage lies in the domain,
# `cnvimass` with the domain `fdm` reads off the function's type.
lemma gpreimass
  |- ( F : A --> B -> ( `' F " C ) C_ A )
  1 cnvimass |- ( `' F " C ) C_ dom F
  2 fdm |- ( F : A --> B -> dom F = A )
  3 sseqtrid 1 2 |- ( F : A --> B -> ( `' F " C ) C_ A )

# ( ( F : A -1-1-> B /\ ( F " A ) = B ) -> `' F : B --> A ): a one-to-one
# function onto B has an inverse from B back to A. `f1f1orn` makes F onto
# its range, `f1ocnv` turns it round, and its range is F[A], which is B.
lemma gf1cnvf
  |- ( ( F : A -1-1-> B /\ ( F " A ) = B ) -> `' F : B --> A )
  1 simpl |- ( ( F : A -1-1-> B /\ ( F " A ) = B ) -> F : A -1-1-> B )
  2 f1f1orn |- ( F : A -1-1-> B -> F : A -1-1-onto-> ran F )
  3 syl 1 2 |- ( ( F : A -1-1-> B /\ ( F " A ) = B ) -> F : A -1-1-onto-> ran F )
  4 f1ocnv |- ( F : A -1-1-onto-> ran F -> `' F : ran F -1-1-onto-> A )
  5 syl 3 4 |- ( ( F : A -1-1-> B /\ ( F " A ) = B ) -> `' F : ran F -1-1-onto-> A )
  6 f1of |- ( `' F : ran F -1-1-onto-> A -> `' F : ran F --> A )
  7 syl 5 6 |- ( ( F : A -1-1-> B /\ ( F " A ) = B ) -> `' F : ran F --> A )
  8 f1fn |- ( F : A -1-1-> B -> F Fn A )
  9 syl 1 8 |- ( ( F : A -1-1-> B /\ ( F " A ) = B ) -> F Fn A )
  10 fnima |- ( F Fn A -> ( F " A ) = ran F )
  11 syl 9 10 |- ( ( F : A -1-1-> B /\ ( F " A ) = B ) -> ( F " A ) = ran F )
  12 simpr |- ( ( F : A -1-1-> B /\ ( F " A ) = B ) -> ( F " A ) = B )
  13 eqtr3d 11 12 |- ( ( F : A -1-1-> B /\ ( F " A ) = B ) -> ran F = B )
  14 feq2d 13 |- ( ( F : A -1-1-> B /\ ( F " A ) = B ) -> ( `' F : ran F --> A <-> `' F : B --> A ) )
  15 mpbid 7 14 |- ( ( F : A -1-1-> B /\ ( F " A ) = B ) -> `' F : B --> A )

# ( A ~~ B -> E. f e. ( B ^m A ) f : A -onto-> B )
lemma gbijonto
  |- ( A ~~ B -> E. f e. ( B ^m A ) f : A -onto-> B )
  1 bren |- ( A ~~ B <-> E. f f : A -1-1-onto-> B )
  2 biimpi 1 |- ( A ~~ B -> E. f f : A -1-1-onto-> B )
  3 simpr |- ( ( A ~~ B /\ f : A -1-1-onto-> B ) -> f : A -1-1-onto-> B )
  4 f1of |- ( f : A -1-1-onto-> B -> f : A --> B )
  5 syl 3 4 |- ( ( A ~~ B /\ f : A -1-1-onto-> B ) -> f : A --> B )
  6 encv |- ( A ~~ B -> ( A e. _V /\ B e. _V ) )
  7 pm3.22 |- ( ( A e. _V /\ B e. _V ) -> ( B e. _V /\ A e. _V ) )
  8 syl 6 7 |- ( A ~~ B -> ( B e. _V /\ A e. _V ) )
  9 elmapg |- ( ( B e. _V /\ A e. _V ) -> ( f e. ( B ^m A ) <-> f : A --> B ) )
  10 syl 8 9 |- ( A ~~ B -> ( f e. ( B ^m A ) <-> f : A --> B ) )
  11 adantr 10 |- ( ( A ~~ B /\ f : A -1-1-onto-> B ) -> ( f e. ( B ^m A ) <-> f : A --> B ) )
  12 mpbird 5 11 |- ( ( A ~~ B /\ f : A -1-1-onto-> B ) -> f e. ( B ^m A ) )
  13 f1ofo |- ( f : A -1-1-onto-> B -> f : A -onto-> B )
  14 syl 3 13 |- ( ( A ~~ B /\ f : A -1-1-onto-> B ) -> f : A -onto-> B )
  15 jca 12 14 |- ( ( A ~~ B /\ f : A -1-1-onto-> B ) -> ( f e. ( B ^m A ) /\ f : A -onto-> B ) )
  16 ex 15 |- ( A ~~ B -> ( f : A -1-1-onto-> B -> ( f e. ( B ^m A ) /\ f : A -onto-> B ) ) )
  17 eximdv 16 |- ( A ~~ B -> ( E. f f : A -1-1-onto-> B -> E. f ( f e. ( B ^m A ) /\ f : A -onto-> B
      ) ) )
  18 mpd 2 17 |- ( A ~~ B -> E. f ( f e. ( B ^m A ) /\ f : A -onto-> B ) )
  19 df-rex |- ( E. f e. ( B ^m A ) f : A -onto-> B <-> E. f ( f e. ( B ^m A ) /\ f : A -onto-> B ) )
  20 sylibr 18 19 |- ( A ~~ B -> E. f e. ( B ^m A ) f : A -onto-> B )

# ( A. x e. A C e. B <-> ( x e. A |-> C ) : A --> B )
lemma gfmpt
  |- ( A. x e. A C e. B <-> ( x e. A |-> C ) : A --> B )
  1 eqid |- ( x e. A |-> C ) = ( x e. A |-> C )
  2 fmpt 1 |- ( A. x e. A C e. B <-> ( x e. A |-> C ) : A --> B )

# ( ( F : A --> B /\ S C_ A /\ D e. S ) -> ( F ` D ) e. ( F " S ) )
lemma gfnfvima
  |- ( ( F : A --> B /\ S C_ A /\ D e. S ) -> ( F ` D ) e. ( F " S ) )
  1 ffn |- ( F : A --> B -> F Fn A )
  2 fnfvima |- ( ( F Fn A /\ S C_ A /\ D e. S ) -> ( F ` D ) e. ( F " S ) )
  3 syl3an1 1 2 |- ( ( F : A --> B /\ S C_ A /\ D e. S ) -> ( F ` D ) e. ( F " S ) )

