# Parity and transcendence, for `proved.mm`.
#
# The page's "n is odd" is set.mm's odd integer, n ∈ ℤ and not 2 ∥ n, the
# antecedent `opoe` and `m1expo` state; and "α is transcendental" is a
# complex number that is not algebraic. Each word carries its domain, so a
# lemma set.mm states of the bare negation is said here with the
# membership joined:
#
# - odd unfolds to 2k + 1: `odd2np1`, with the membership put in by `ibar`,
#   for `mun:stdlib/divisibility/odd`;
# - an integer is even or odd: `zeo3`, its second case joined to the
#   membership, for `mun:stdlib/divisibility/even-or-odd`;
# - an even number is not odd: the denial of the second conjunct, for
#   `mun:stdlib/divisibility/not-both`;
# - odd plus or minus even is odd: `opeo` and `omeo`, with the result's
#   membership by `zaddcl` and `zsubcl`;
# - a complex number is transcendental exactly when it is not algebraic:
#   `ibar`, for `mun:stdlib/polynomials/transcendental`.

$( Parity and transcendence: odd as an integer not divisible by 2, and
   transcendental as a complex number not algebraic. $)
$d n N $.

# ( N e. ZZ -> ( ( N e. ZZ /\ -. 2 || N ) <-> E. n e. ZZ ( ( 2 x. n ) + 1 ) = N ) )
lemma godd2np1
  |- ( N e. ZZ -> ( ( N e. ZZ /\ -. 2 || N ) <-> E. n e. ZZ ( ( 2 x. n ) + 1 ) = N ) )
  1 ibar |- ( N e. ZZ -> ( -. 2 || N <-> ( N e. ZZ /\ -. 2 || N ) ) )
  2 odd2np1 |- ( N e. ZZ -> ( -. 2 || N <-> E. n e. ZZ ( ( 2 x. n ) + 1 ) = N ) )
  3 bitr3d 1 2 |- ( N e. ZZ -> ( ( N e. ZZ /\ -. 2 || N ) <-> E. n e. ZZ ( ( 2 x. n ) + 1 ) = N ) )

# ( N e. ZZ -> ( 2 || N \/ ( N e. ZZ /\ -. 2 || N ) ) )
lemma gevenodd
  |- ( N e. ZZ -> ( 2 || N \/ ( N e. ZZ /\ -. 2 || N ) ) )
  1 zeo3 |- ( N e. ZZ -> ( 2 || N \/ -. 2 || N ) )
  2 pm3.2 |- ( N e. ZZ -> ( -. 2 || N -> ( N e. ZZ /\ -. 2 || N ) ) )
  3 orim2d 2 |- ( N e. ZZ -> ( ( 2 || N \/ -. 2 || N ) -> ( 2 || N \/ ( N e. ZZ /\ -. 2 || N ) ) ) )
  4 mpd 1 3 |- ( N e. ZZ -> ( 2 || N \/ ( N e. ZZ /\ -. 2 || N ) ) )

# ( 2 || N -> -. ( N e. ZZ /\ -. 2 || N ) )
lemma gnotboth
  |- ( 2 || N -> -. ( N e. ZZ /\ -. 2 || N ) )
  1 simpr |- ( ( N e. ZZ /\ -. 2 || N ) -> -. 2 || N )
  2 con2i 1 |- ( 2 || N -> -. ( N e. ZZ /\ -. 2 || N ) )

# ( ( ( A e. ZZ /\ -. 2 || A ) /\ ( B e. ZZ /\ 2 || B ) ) ->
#   ( ( A + B ) e. ZZ /\ -. 2 || ( A + B ) ) )
lemma gopeo
  |- ( ( ( A e. ZZ /\ -. 2 || A ) /\ ( B e. ZZ /\ 2 || B ) ) -> ( ( A + B ) e. ZZ /\ -. 2 || ( A + B ) ) )
  1 simpll |- ( ( ( A e. ZZ /\ -. 2 || A ) /\ ( B e. ZZ /\ 2 || B ) ) -> A e. ZZ )
  2 simprl |- ( ( ( A e. ZZ /\ -. 2 || A ) /\ ( B e. ZZ /\ 2 || B ) ) -> B e. ZZ )
  3 zaddcl |- ( ( A e. ZZ /\ B e. ZZ ) -> ( A + B ) e. ZZ )
  4 syl2anc 1 2 3 |- ( ( ( A e. ZZ /\ -. 2 || A ) /\ ( B e. ZZ /\ 2 || B ) ) -> ( A + B ) e. ZZ )
  5 opeo |- ( ( ( A e. ZZ /\ -. 2 || A ) /\ ( B e. ZZ /\ 2 || B ) ) -> -. 2 || ( A + B ) )
  6 jca 4 5 |- ( ( ( A e. ZZ /\ -. 2 || A ) /\ ( B e. ZZ /\ 2 || B ) ) -> ( ( A + B ) e. ZZ /\ -. 2 || ( A + B ) ) )

# ( ( ( A e. ZZ /\ -. 2 || A ) /\ ( B e. ZZ /\ 2 || B ) ) ->
#   ( ( A - B ) e. ZZ /\ -. 2 || ( A - B ) ) )
lemma gomeo
  |- ( ( ( A e. ZZ /\ -. 2 || A ) /\ ( B e. ZZ /\ 2 || B ) ) -> ( ( A - B ) e. ZZ /\ -. 2 || ( A - B ) ) )
  1 simpll |- ( ( ( A e. ZZ /\ -. 2 || A ) /\ ( B e. ZZ /\ 2 || B ) ) -> A e. ZZ )
  2 simprl |- ( ( ( A e. ZZ /\ -. 2 || A ) /\ ( B e. ZZ /\ 2 || B ) ) -> B e. ZZ )
  3 zsubcl |- ( ( A e. ZZ /\ B e. ZZ ) -> ( A - B ) e. ZZ )
  4 syl2anc 1 2 3 |- ( ( ( A e. ZZ /\ -. 2 || A ) /\ ( B e. ZZ /\ 2 || B ) ) -> ( A - B ) e. ZZ )
  5 omeo |- ( ( ( A e. ZZ /\ -. 2 || A ) /\ ( B e. ZZ /\ 2 || B ) ) -> -. 2 || ( A - B ) )
  6 jca 4 5 |- ( ( ( A e. ZZ /\ -. 2 || A ) /\ ( B e. ZZ /\ 2 || B ) ) -> ( ( A - B ) e. ZZ /\ -. 2 || ( A - B ) ) )

# ( A e. CC -> ( ( A e. CC /\ -. A e. AA ) <-> -. A e. AA ) )
lemma gtransc
  |- ( A e. CC -> ( ( A e. CC /\ -. A e. AA ) <-> -. A e. AA ) )
  1 ibar |- ( A e. CC -> ( -. A e. AA <-> ( A e. CC /\ -. A e. AA ) ) )
  2 bicomd 1 |- ( A e. CC -> ( ( A e. CC /\ -. A e. AA ) <-> -. A e. AA ) )
