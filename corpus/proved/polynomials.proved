# A polynomial of degree at least 1 is not 0 (`dgr0`), so its roots are
# finitely many (`fta1`), and `gfiniso` isolates each real one.
lemma grootsiso
  hypothesis grootsiso.1 |- ( ph -> F e. ( Poly ` ZZ ) )
  hypothesis grootsiso.2 |- ( ph -> N e. NN )
  hypothesis grootsiso.3 |- ( ph -> ( deg ` F ) = N )
  hypothesis grootsiso.4 |- ( ph -> A e. RR )
  |- ( ph -> E. d e. RR ( 0 < d /\ A. r e. RR ( ( ( abs ` ( A - r ) ) <_ d /\ ( F ` r ) = 0 ) -> r = A ) ) )
  1 nnne0d grootsiso.2 |- ( ph -> N =/= 0 )
  2 eqnetrd grootsiso.3 1 |- ( ph -> ( deg ` F ) =/= 0 )
