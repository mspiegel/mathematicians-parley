# Two points given by coordinates differ where a coordinate does (`cru`),
# which is how the page says it: a ≠ c or b ≠ d.
lemma gptne
  |- ( ( ( A e. RR /\ B e. RR ) /\ ( C e. RR /\ D e. RR ) ) -> ( ( A =/= C \/ B =/= D ) -> ( A + ( _i x. B ) ) =/= ( C + ( _i x. D ) ) ) )
