  24 crred 3 4 |- ( ( ( A e. RR /\ B e. RR ) /\ ( C e. RR /\ D e. RR ) ) -> ( Re ` ( C + ( _i x. D )
      ) ) = C )
  25 eqtrd 23 24 |- ( ( ( A e. RR /\ B e. RR ) /\ ( C e. RR /\ D e. RR ) ) -> ( Re ` ( * ` ( C + ( _i
      x. D ) ) ) ) = C )
  26 oveq12d 17 25 |- ( ( ( A e. RR /\ B e. RR ) /\ ( C e. RR /\ D e. RR ) ) -> ( ( Re ` ( A + ( _i
      x. B ) ) ) x. ( Re ` ( * ` ( C + ( _i x. D ) ) ) ) ) = ( A x. C ) )
