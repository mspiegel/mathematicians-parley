# The value of an angle between two nonzero numbers is real.
lemma gangre
  |- ( ( ( X e. CC /\ X =/= 0 ) /\ ( Y e. CC /\ Y =/= 0 ) ) -> ( X ang Y ) e. RR )
  1 simpll |- ( ( ( X e. CC /\ X =/= 0 ) /\ ( Y e. CC /\ Y =/= 0 ) ) -> X e. CC )
  2 simplr |- ( ( ( X e. CC /\ X =/= 0 ) /\ ( Y e. CC /\ Y =/= 0 ) ) -> X =/= 0 )
  3 simprl |- ( ( ( X e. CC /\ X =/= 0 ) /\ ( Y e. CC /\ Y =/= 0 ) ) -> Y e. CC )
  4 simprr |- ( ( ( X e. CC /\ X =/= 0 ) /\ ( Y e. CC /\ Y =/= 0 ) ) -> Y =/= 0 )
  5 df-ang |- ang = ( x e. ( CC \ { 0 } ) , y e. ( CC \ { 0 } ) |-> ( Im ` ( log ` ( y / x ) ) ) )
  6 angcld 5 1 2 3 4 |- ( ( ( X e. CC /\ X =/= 0 ) /\ ( Y e. CC /\ Y =/= 0 ) ) -> ( X ang Y ) e. ( -u _pi (,] _pi ) )
  7 pire |- _pi e. RR
  8 renegcli 7 |- -u _pi e. RR
  9 rexri 8 |- -u _pi e. RR*
  10 iocssre |- ( ( -u _pi e. RR* /\ _pi e. RR ) -> ( -u _pi (,] _pi ) C_ RR )
  11 mp2an 9 7 10 |- ( -u _pi (,] _pi ) C_ RR
  12 sselid 11 6 |- ( ( ( X e. CC /\ X =/= 0 ) /\ ( Y e. CC /\ Y =/= 0 ) ) -> ( X ang Y ) e. RR )

# Supplementary angles: where B is between A and C, the angles ABD and DBC
# make a straight angle. C - B is a negative multiple k(A - B), which is
# (-k)(-(A - B)) with -k positive, so the angle DBC is the angle from
# -(A - B) to D - B; that has the cosine opposite to the angle ABD's
# (`cosangneg2d`), which is the cosine of pi less it, and on [0, pi] the
# cosine takes each value once (`cos11`).
lemma gsupp
  |- ( ( ( A e. CC /\ B e. CC ) /\ ( C e. CC /\ D e. CC ) ) -> ( ( A =/= B /\ ( ( C - B ) / ( A - B ) ) e. RR /\ ( ( C - B ) / ( A - B ) ) < 0 ) -> ( D =/= B -> ( ( abs ` ( ( A - B ) ang ( D - B ) ) ) + ( abs ` ( ( D - B ) ang ( C - B ) ) ) ) = ( ( ; ; 1 8 0 x. _pi ) / ; ; 1 8 0 ) ) ) )
