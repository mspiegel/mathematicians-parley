  26 oveq12d 17 22 |- ( ( ( A e. RR /\ B e. RR ) /\ ( C e. RR /\ D e. RR ) ) -> ( ( Re ` ( A + ( _i
      x. B ) ) ) x. ( Im ` ( * ` ( C + ( _i x. D ) ) ) ) ) = ( A x. -u D ) )
  27 oveq12d 18 25 |- ( ( ( A e. RR /\ B e. RR ) /\ ( C e. RR /\ D e. RR ) ) -> ( ( Im ` ( A + ( _i
      x. B ) ) ) x. ( Re ` ( * ` ( C + ( _i x. D ) ) ) ) ) = ( B x. C ) )
