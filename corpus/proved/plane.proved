# The addition of angles. With the vertex at C, let x = A - C, y = B - C
# and z = M - C. M between A and B makes y - z = k(x - z) with k < 0, so
# y = kx + (1 - k)z, and dividing by x and by z, Im(y/x) = (1 - k) Im(z/x)
# and Im(y/z) = k Im(x/z) (`glinim`). Those are the two sides `gline` asks
# for: M and B on one side of line CA, A and B on two sides of line CM.
lemma glinim
  |- ( ( V e. CC /\ R e. RR /\ S e. RR ) -> ( Im ` ( R + ( S x. V ) ) ) = ( S x. ( Im ` V ) ) )
  1 simp1 |- ( ( V e. CC /\ R e. RR /\ S e. RR ) -> V e. CC )
  2 simp2 |- ( ( V e. CC /\ R e. RR /\ S e. RR ) -> R e. RR )
  3 simp3 |- ( ( V e. CC /\ R e. RR /\ S e. RR ) -> S e. RR )
  4 recnd 2 |- ( ( V e. CC /\ R e. RR /\ S e. RR ) -> R e. CC )
  5 recnd 3 |- ( ( V e. CC /\ R e. RR /\ S e. RR ) -> S e. CC )
  6 mulcld 5 1 |- ( ( V e. CC /\ R e. RR /\ S e. RR ) -> ( S x. V ) e. CC )
  7 imaddd 4 6 |- ( ( V e. CC /\ R e. RR /\ S e. RR ) -> ( Im ` ( R + ( S x. V ) ) ) = ( ( Im ` R ) + ( Im ` ( S x. V ) ) ) )
  8 reim0d 2 |- ( ( V e. CC /\ R e. RR /\ S e. RR ) -> ( Im ` R ) = 0 )
  9 immul2d 3 1 |- ( ( V e. CC /\ R e. RR /\ S e. RR ) -> ( Im ` ( S x. V ) ) = ( S x. ( Im ` V ) ) )
  10 oveq12d 8 9 |- ( ( V e. CC /\ R e. RR /\ S e. RR ) -> ( ( Im ` R ) + ( Im ` ( S x. V ) ) ) = ( 0 + ( S x. ( Im ` V ) ) ) )
  11 imcld 1 |- ( ( V e. CC /\ R e. RR /\ S e. RR ) -> ( Im ` V ) e. RR )
  12 remulcld 3 11 |- ( ( V e. CC /\ R e. RR /\ S e. RR ) -> ( S x. ( Im ` V ) ) e. RR )
  13 recnd 12 |- ( ( V e. CC /\ R e. RR /\ S e. RR ) -> ( S x. ( Im ` V ) ) e. CC )
  14 addlidd 13 |- ( ( V e. CC /\ R e. RR /\ S e. RR ) -> ( 0 + ( S x. ( Im ` V ) ) ) = ( S x. ( Im ` V ) ) )
  15 eqtrd 7 10 |- ( ( V e. CC /\ R e. RR /\ S e. RR ) -> ( Im ` ( R + ( S x. V ) ) ) = ( 0 + ( S x. ( Im ` V ) ) ) )
