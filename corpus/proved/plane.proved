# The cosine of a supplement is the opposite of the cosine (`cospim`),
# with 180 degrees written as pi.
lemma gcossupp
  |- ( X e. RR -> ( cos ` ( ( ( ; ; 1 8 0 x. _pi ) / ; ; 1 8 0 ) - X ) ) = -u ( cos ` X ) )
  1 g180 |- ( ( ; ; 1 8 0 x. _pi ) / ; ; 1 8 0 ) = _pi
  2 oveq1i 1 |- ( ( ( ; ; 1 8 0 x. _pi ) / ; ; 1 8 0 ) - X ) = ( _pi - X )
  3 fveq2i 2 |- ( cos ` ( ( ( ; ; 1 8 0 x. _pi ) / ; ; 1 8 0 ) - X ) ) = ( cos ` ( _pi - X ) )
  4 recn |- ( X e. RR -> X e. CC )
  5 cospim |- ( X e. CC -> ( cos ` ( _pi - X ) ) = -u ( cos ` X ) )
  6 syl 4 5 |- ( X e. RR -> ( cos ` ( _pi - X ) ) = -u ( cos ` X ) )
  7 eqtrid 3 6 |- ( X e. RR -> ( cos ` ( ( ( ; ; 1 8 0 x. _pi ) / ; ; 1 8 0 ) - X ) ) = -u ( cos ` X ) )
