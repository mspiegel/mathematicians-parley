# Angle addition: for a triangle ABC and M between A and B, the angles ACM
# and MCB make up the angle ACB. With T = 2C - A, C is between A and T, so
# `gline` gives ACM + MCB + TCB = 180 degrees and `gsupp` gives
# ACB + BCT = 180 degrees.
lemma gangadd
  |- ( ( ( A e. CC /\ B e. CC ) /\ ( C e. CC /\ M e. CC ) ) -> ( ( ( ( -. A = B /\ -. B = C ) /\ -. A = C ) /\ -. ( ( C - A ) / ( B - A ) ) e. RR ) -> ( ( A =/= M /\ ( ( B - M ) / ( A - M ) ) e. RR /\ ( ( B - M ) / ( A - M ) ) < 0 ) -> ( ( abs ` ( ( A - C ) ang ( M - C ) ) ) + ( abs ` ( ( M - C ) ang ( B - C ) ) ) ) = ( abs ` ( ( A - C ) ang ( B - C ) ) ) ) ) )
  1 simpll |- ( ( ( ( ( A e. CC /\ B e. CC ) /\ ( C e. CC /\ M e. CC ) ) /\ ( ( ( -. A = B /\ -. B = C ) /\ -. A = C ) /\ -. ( ( C - A ) / ( B - A ) ) e. RR ) ) /\ ( A =/= M /\ ( ( B - M ) / ( A - M ) ) e. RR /\ ( ( B - M ) / ( A - M ) ) < 0 ) ) -> ( ( A e. CC /\ B e. CC ) /\ ( C e. CC /\ M e. CC ) ) )
