      ( * ` W ) ) ) = 0 ) )
  19 bitrd 14 18 |- ( ( Z e. CC /\ W e. CC /\ W =/= 0 ) -> ( ( Z / W ) e. RR <-> ( Im ` ( Z x. ( * `
      W ) ) ) = 0 ) )

lemma gdivneg
  |- ( ( Z e. CC /\ W e. CC /\ W =/= 0 ) -> ( ( ( Z / W ) e. RR /\ ( Z / W ) < 0 ) <-> ( ( Im ` ( Z
      x. ( * ` W ) ) ) = 0 /\ ( Re ` ( Z x. ( * ` W ) ) ) < 0 ) ) )
  1 simp1 |- ( ( Z e. CC /\ W e. CC /\ W =/= 0 ) -> Z e. CC )
