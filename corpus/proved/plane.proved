  13 mulcld 10 8 |- ( ( ( A e. RR /\ B e. RR ) /\ ( C e. RR /\ D e. RR ) ) -> ( _i x. D ) e. CC )
  14 addcld 7 13 |- ( ( ( A e. RR /\ B e. RR ) /\ ( C e. RR /\ D e. RR ) ) -> ( C + ( _i x. D ) ) e.
      CC )
  15 cjcld 14 |- ( ( ( A e. RR /\ B e. RR ) /\ ( C e. RR /\ D e. RR ) ) -> ( * ` ( C + ( _i x. D ) ) )
      e. CC )
  16 immuld 12 15 |- ( ( ( A e. RR /\ B e. RR ) /\ ( C e. RR /\ D e. RR ) ) -> ( Im ` ( ( A + ( _i x.
      B ) ) x. ( * ` ( C + ( _i x. D ) ) ) ) ) = ( ( ( Re ` ( A + ( _i x. B ) ) ) x. ( Im ` ( * ` ( C
      + ( _i x. D ) ) ) ) ) + ( ( Im ` ( A + ( _i x. B ) ) ) x. ( Re ` ( * ` ( C + ( _i x. D ) ) ) ) )
      ) )
  17 crred 1 2 |- ( ( ( A e. RR /\ B e. RR ) /\ ( C e. RR /\ D e. RR ) ) -> ( Re ` ( A + ( _i x. B )
      ) ) = A )
  18 crimd 1 2 |- ( ( ( A e. RR /\ B e. RR ) /\ ( C e. RR /\ D e. RR ) ) -> ( Im ` ( A + ( _i x. B )
      ) ) = B )
  19 imcjd 14 |- ( ( ( A e. RR /\ B e. RR ) /\ ( C e. RR /\ D e. RR ) ) -> ( Im ` ( * ` ( C + ( _i x.
      D ) ) ) ) = -u ( Im ` ( C + ( _i x. D ) ) ) )
  20 crimd 3 4 |- ( ( ( A e. RR /\ B e. RR ) /\ ( C e. RR /\ D e. RR ) ) -> ( Im ` ( C + ( _i x. D )
      ) ) = D )
  21 negeqd 20 |- ( ( ( A e. RR /\ B e. RR ) /\ ( C e. RR /\ D e. RR ) ) -> -u ( Im ` ( C + ( _i x. D
      ) ) ) = -u D )
  22 eqtrd 19 21 |- ( ( ( A e. RR /\ B e. RR ) /\ ( C e. RR /\ D e. RR ) ) -> ( Im ` ( * ` ( C + ( _i
      x. D ) ) ) ) = -u D )
  23 recjd 14 |- ( ( ( A e. RR /\ B e. RR ) /\ ( C e. RR /\ D e. RR ) ) -> ( Re ` ( * ` ( C + ( _i x.
      D ) ) ) ) = ( Re ` ( C + ( _i x. D ) ) ) )
  24 crred 3 4 |- ( ( ( A e. RR /\ B e. RR ) /\ ( C e. RR /\ D e. RR ) ) -> ( Re ` ( C + ( _i x. D )
      ) ) = C )
  25 eqtrd 23 24 |- ( ( ( A e. RR /\ B e. RR ) /\ ( C e. RR /\ D e. RR ) ) -> ( Re ` ( * ` ( C + ( _i
      x. D ) ) ) ) = C )
  26 oveq12d 17 22 |- ( ( ( A e. RR /\ B e. RR ) /\ ( C e. RR /\ D e. RR ) ) -> ( ( Re ` ( A + ( _i
      x. B ) ) ) x. ( Im ` ( * ` ( C + ( _i x. D ) ) ) ) ) = ( A x. -u D ) )
  27 oveq12d 18 25 |- ( ( ( A e. RR /\ B e. RR ) /\ ( C e. RR /\ D e. RR ) ) -> ( ( Im ` ( A + ( _i
      x. B ) ) ) x. ( Re ` ( * ` ( C + ( _i x. D ) ) ) ) ) = ( B x. C ) )
  28 oveq12d 26 27 |- ( ( ( A e. RR /\ B e. RR ) /\ ( C e. RR /\ D e. RR ) ) -> ( ( ( Re ` ( A + (
      _i x. B ) ) ) x. ( Im ` ( * ` ( C + ( _i x. D ) ) ) ) ) + ( ( Im ` ( A + ( _i x. B ) ) ) x. (
      Re ` ( * ` ( C + ( _i x. D ) ) ) ) ) ) = ( ( A x. -u D ) + ( B x. C ) ) )
  29 eqtrd 16 28 |- ( ( ( A e. RR /\ B e. RR ) /\ ( C e. RR /\ D e. RR ) ) -> ( Im ` ( ( A + ( _i x.
      B ) ) x. ( * ` ( C + ( _i x. D ) ) ) ) ) = ( ( A x. -u D ) + ( B x. C ) ) )
  30 mulneg2d 5 8 |- ( ( ( A e. RR /\ B e. RR ) /\ ( C e. RR /\ D e. RR ) ) -> ( A x. -u D ) = -u (
      A x. D ) )
  31 oveq1d 30 |- ( ( ( A e. RR /\ B e. RR ) /\ ( C e. RR /\ D e. RR ) ) -> ( ( A x. -u D ) + ( B x.
      C ) ) = ( -u ( A x. D ) + ( B x. C ) ) )
  32 mulcld 5 8 |- ( ( ( A e. RR /\ B e. RR ) /\ ( C e. RR /\ D e. RR ) ) -> ( A x. D ) e. CC )
  33 negcld 32 |- ( ( ( A e. RR /\ B e. RR ) /\ ( C e. RR /\ D e. RR ) ) -> -u ( A x. D ) e. CC )
  34 mulcld 6 7 |- ( ( ( A e. RR /\ B e. RR ) /\ ( C e. RR /\ D e. RR ) ) -> ( B x. C ) e. CC )
  35 addcomd 33 34 |- ( ( ( A e. RR /\ B e. RR ) /\ ( C e. RR /\ D e. RR ) ) -> ( -u ( A x. D ) + (
