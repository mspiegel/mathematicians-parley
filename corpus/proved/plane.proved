  2 necon3abid 1 |- ( ( ( A e. RR /\ B e. RR ) /\ ( C e. RR /\ D e. RR ) ) -> ( ( A + ( _i x. B ) ) =/= ( C + ( _i x. D ) ) <-> -. ( A = C /\ B = D ) ) )
  3 neorian |- ( ( A =/= C \/ B =/= D ) <-> -. ( A = C /\ B = D ) )
  4 bitr4di 2 3 |- ( ( ( A e. RR /\ B e. RR ) /\ ( C e. RR /\ D e. RR ) ) -> ( ( A + ( _i x. B ) ) =/= ( C + ( _i x. D ) ) <-> ( A =/= C \/ B =/= D ) ) )
  5 biimprd 4 |- ( ( ( A e. RR /\ B e. RR ) /\ ( C e. RR /\ D e. RR ) ) -> ( ( A =/= C \/ B =/= D ) -> ( A + ( _i x. B ) ) =/= ( C + ( _i x. D ) ) ) )

