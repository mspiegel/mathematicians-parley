  7 absne0d 2 3 |- ( ( Z e. CC /\ W e. CC /\ W =/= 0 ) -> ( abs ` W ) =/= 0 )
  8 sqgt0d 5 7 |- ( ( Z e. CC /\ W e. CC /\ W =/= 0 ) -> 0 < ( ( abs ` W ) ^ 2 ) )
  9 gt0ne0d 8 |- ( ( Z e. CC /\ W e. CC /\ W =/= 0 ) -> ( ( abs ` W ) ^ 2 ) =/= 0 )
  10 mulre |- ( ( ( Z / W ) e. CC /\ ( ( abs ` W ) ^ 2 ) e. RR /\ ( ( abs ` W ) ^ 2 ) =/= 0 ) -> ( (
      Z / W ) e. RR <-> ( ( ( abs ` W ) ^ 2 ) x. ( Z / W ) ) e. RR ) )
  11 syl3anc 4 6 9 10 |- ( ( Z e. CC /\ W e. CC /\ W =/= 0 ) -> ( ( Z / W ) e. RR <-> ( ( ( abs ` W
      ) ^ 2 ) x. ( Z / W ) ) e. RR ) )
  12 gdivcj |- ( ( Z e. CC /\ W e. CC /\ W =/= 0 ) -> ( ( ( abs ` W ) ^ 2 ) x. ( Z / W ) ) = ( Z x. (
      * ` W ) ) )
  13 eleq1d 12 |- ( ( Z e. CC /\ W e. CC /\ W =/= 0 ) -> ( ( ( ( abs ` W ) ^ 2 ) x. ( Z / W ) ) e. RR
      <-> ( Z x. ( * ` W ) ) e. RR ) )
  14 bitrd 11 13 |- ( ( Z e. CC /\ W e. CC /\ W =/= 0 ) -> ( ( Z / W ) e. RR <-> ( Z x. ( * ` W ) )
      e. RR ) )
  15 cjcld 2 |- ( ( Z e. CC /\ W e. CC /\ W =/= 0 ) -> ( * ` W ) e. CC )
  16 mulcld 1 15 |- ( ( Z e. CC /\ W e. CC /\ W =/= 0 ) -> ( Z x. ( * ` W ) ) e. CC )
  17 reim0b |- ( ( Z x. ( * ` W ) ) e. CC -> ( ( Z x. ( * ` W ) ) e. RR <-> ( Im ` ( Z x. ( * ` W ) )
      ) = 0 ) )
