  36 negsubd 34 32 |- ( ( ( A e. RR /\ B e. RR ) /\ ( C e. RR /\ D e. RR ) ) -> ( ( B x. C ) + -u (
      A x. D ) ) = ( ( B x. C ) - ( A x. D ) ) )
  37 eqtrd 31 35 |- ( ( ( A e. RR /\ B e. RR ) /\ ( C e. RR /\ D e. RR ) ) -> ( ( A x. -u D ) + ( B
      x. C ) ) = ( ( B x. C ) + -u ( A x. D ) ) )
  38 eqtrd 37 36 |- ( ( ( A e. RR /\ B e. RR ) /\ ( C e. RR /\ D e. RR ) ) -> ( ( A x. -u D ) + ( B
      x. C ) ) = ( ( B x. C ) - ( A x. D ) ) )
  39 eqtrd 29 38 |- ( ( ( A e. RR /\ B e. RR ) /\ ( C e. RR /\ D e. RR ) ) -> ( Im ` ( ( A + ( _i x.
      B ) ) x. ( * ` ( C + ( _i x. D ) ) ) ) ) = ( ( B x. C ) - ( A x. D ) ) )

lemma gremcj
  |- ( ( ( A e. RR /\ B e. RR ) /\ ( C e. RR /\ D e. RR ) ) -> ( Re ` ( ( A + ( _i x. B ) ) x. ( * `
      ( C + ( _i x. D ) ) ) ) ) = ( ( A x. C ) + ( B x. D ) ) )
  1 simpll |- ( ( ( A e. RR /\ B e. RR ) /\ ( C e. RR /\ D e. RR ) ) -> A e. RR )
  2 simplr |- ( ( ( A e. RR /\ B e. RR ) /\ ( C e. RR /\ D e. RR ) ) -> B e. RR )
  3 simprl |- ( ( ( A e. RR /\ B e. RR ) /\ ( C e. RR /\ D e. RR ) ) -> C e. RR )
  4 simprr |- ( ( ( A e. RR /\ B e. RR ) /\ ( C e. RR /\ D e. RR ) ) -> D e. RR )
  5 recnd 1 |- ( ( ( A e. RR /\ B e. RR ) /\ ( C e. RR /\ D e. RR ) ) -> A e. CC )
  6 recnd 2 |- ( ( ( A e. RR /\ B e. RR ) /\ ( C e. RR /\ D e. RR ) ) -> B e. CC )
  7 recnd 3 |- ( ( ( A e. RR /\ B e. RR ) /\ ( C e. RR /\ D e. RR ) ) -> C e. CC )
  8 recnd 4 |- ( ( ( A e. RR /\ B e. RR ) /\ ( C e. RR /\ D e. RR ) ) -> D e. CC )
  9 ax-icn |- _i e. CC
  10 a1i 9 |- ( ( ( A e. RR /\ B e. RR ) /\ ( C e. RR /\ D e. RR ) ) -> _i e. CC )
  11 mulcld 10 6 |- ( ( ( A e. RR /\ B e. RR ) /\ ( C e. RR /\ D e. RR ) ) -> ( _i x. B ) e. CC )
  12 addcld 5 11 |- ( ( ( A e. RR /\ B e. RR ) /\ ( C e. RR /\ D e. RR ) ) -> ( A + ( _i x. B ) ) e.
      CC )
  13 mulcld 10 8 |- ( ( ( A e. RR /\ B e. RR ) /\ ( C e. RR /\ D e. RR ) ) -> ( _i x. D ) e. CC )
  14 addcld 7 13 |- ( ( ( A e. RR /\ B e. RR ) /\ ( C e. RR /\ D e. RR ) ) -> ( C + ( _i x. D ) ) e.
      CC )
  15 cjcld 14 |- ( ( ( A e. RR /\ B e. RR ) /\ ( C e. RR /\ D e. RR ) ) -> ( * ` ( C + ( _i x. D ) ) )
      e. CC )
  16 remuld 12 15 |- ( ( ( A e. RR /\ B e. RR ) /\ ( C e. RR /\ D e. RR ) ) -> ( Re ` ( ( A + ( _i x.
      B ) ) x. ( * ` ( C + ( _i x. D ) ) ) ) ) = ( ( ( Re ` ( A + ( _i x. B ) ) ) x. ( Re ` ( * ` ( C
      + ( _i x. D ) ) ) ) ) - ( ( Im ` ( A + ( _i x. B ) ) ) x. ( Im ` ( * ` ( C + ( _i x. D ) ) ) ) )
