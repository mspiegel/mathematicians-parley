      B ) ) x. ( * ` ( C + ( _i x. D ) ) ) ) ) = ( ( A x. C ) + ( B x. D ) ) )

# |w|^2 times z/w is z conj(w), and |w|^2 is a positive real; so z/w is
# real just where z conj(w) is, and negative just where z conj(w) is real
# and negative.
lemma gdivcj
  |- ( ( Z e. CC /\ W e. CC /\ W =/= 0 ) -> ( ( ( abs ` W ) ^ 2 ) x. ( Z / W ) ) = ( Z x. ( * ` W ) )
      )
  1 simp1 |- ( ( Z e. CC /\ W e. CC /\ W =/= 0 ) -> Z e. CC )
  2 simp2 |- ( ( Z e. CC /\ W e. CC /\ W =/= 0 ) -> W e. CC )
  3 simp3 |- ( ( Z e. CC /\ W e. CC /\ W =/= 0 ) -> W =/= 0 )
  4 divcld 1 2 3 |- ( ( Z e. CC /\ W e. CC /\ W =/= 0 ) -> ( Z / W ) e. CC )
  5 absvalsqd 2 |- ( ( Z e. CC /\ W e. CC /\ W =/= 0 ) -> ( ( abs ` W ) ^ 2 ) = ( W x. ( * ` W ) ) )
  6 oveq1d 5 |- ( ( Z e. CC /\ W e. CC /\ W =/= 0 ) -> ( ( ( abs ` W ) ^ 2 ) x. ( Z / W ) ) = ( ( W
      x. ( * ` W ) ) x. ( Z / W ) ) )
  7 cjcld 2 |- ( ( Z e. CC /\ W e. CC /\ W =/= 0 ) -> ( * ` W ) e. CC )
  8 mulcld 2 7 |- ( ( Z e. CC /\ W e. CC /\ W =/= 0 ) -> ( W x. ( * ` W ) ) e. CC )
  9 mulcomd 8 4 |- ( ( Z e. CC /\ W e. CC /\ W =/= 0 ) -> ( ( W x. ( * ` W ) ) x. ( Z / W ) ) = ( (
      Z / W ) x. ( W x. ( * ` W ) ) ) )
  10 mulassd 4 2 7 |- ( ( Z e. CC /\ W e. CC /\ W =/= 0 ) -> ( ( ( Z / W ) x. W ) x. ( * ` W ) ) = (
      ( Z / W ) x. ( W x. ( * ` W ) ) ) )
  11 eqtr4d 9 10 |- ( ( Z e. CC /\ W e. CC /\ W =/= 0 ) -> ( ( W x. ( * ` W ) ) x. ( Z / W ) ) = ( (
      ( Z / W ) x. W ) x. ( * ` W ) ) )
  12 divcan1d 1 2 3 |- ( ( Z e. CC /\ W e. CC /\ W =/= 0 ) -> ( ( Z / W ) x. W ) = Z )
  13 oveq1d 12 |- ( ( Z e. CC /\ W e. CC /\ W =/= 0 ) -> ( ( ( Z / W ) x. W ) x. ( * ` W ) ) = ( Z
      x. ( * ` W ) ) )
  14 eqtrd 6 11 |- ( ( Z e. CC /\ W e. CC /\ W =/= 0 ) -> ( ( ( abs ` W ) ^ 2 ) x. ( Z / W ) ) = ( (
      ( Z / W ) x. W ) x. ( * ` W ) ) )
  15 eqtrd 14 13 |- ( ( Z e. CC /\ W e. CC /\ W =/= 0 ) -> ( ( ( abs ` W ) ^ 2 ) x. ( Z / W ) ) = ( Z
      x. ( * ` W ) ) )

