# Signed angles, for `proved.mm`, as the circle theorems ask of them.
#
# The angle at the centre and the angles on one arc are proved on the page
# from four facts about the signed angle, which the page cannot state the
# reasons for, since each is about the argument of a complex number:
#
# - an angle from a ray to itself is 0 (`gsangid`);
# - three rays from one point: the angle from the first to the second and
#   from the second to the third add to the angle from the first to the
#   third, up to whole turns (`gsang3`). The two quotients multiply to the
#   third, so their logarithms add to its logarithm up to a multiple of
#   2·pi·i (`eflogeq`);
# - the base angles of an isosceles triangle, turned the same way round it,
#   are equal (`gisosctr`, set.mm's `isosctr`);
# - two points on one side of a line see a segment of it turned the same
#   way (`gsamesang`): the sign of the angle ACB is the side C is on
#   (`gsideang`).

$( Circles: the signed angle of a ray to itself, three rays from one point,
   the isosceles triangle's base angles turned one way, and the side of a
   line read off a signed angle. $)
$( The whole number of turns n is apart from the points and the
   hypotheses; `df-ang` binds x and y, apart from the points. $)
$d n ph $.  $d n A $.  $d n B $.  $d n X $.  $d n Q $.
$d x y $.
$d x A $.  $d y A $.
$d x B $.  $d y B $.
$d x C $.  $d y C $.

# `gsangid`: the angle from a ray to itself. The quotient is 1, whose
# logarithm is 0.
lemma gsangid
  hypothesis gsangid.1 |- ( ph -> P e. CC )
  hypothesis gsangid.2 |- ( ph -> Q e. CC )
  hypothesis gsangid.3 |- ( ph -> P =/= Q )
  |- ( ph -> ( ( P - Q ) ang ( P - Q ) ) = 0 )
  1 subcld gsangid.1 gsangid.2 |- ( ph -> ( P - Q ) e. CC )
  2 subne0d gsangid.1 gsangid.2 gsangid.3 |- ( ph -> ( P - Q ) =/= 0 )
  3 jca 1 2 |- ( ph -> ( ( P - Q ) e. CC /\ ( P - Q ) =/= 0 ) )
  4 jca 3 3 |- ( ph -> ( ( ( P - Q ) e. CC /\ ( P - Q ) =/= 0 ) /\ ( ( P - Q ) e. CC /\ ( P - Q ) =/= 0 ) ) )
  5 gangval |- ( ( ( ( P - Q ) e. CC /\ ( P - Q ) =/= 0 ) /\ ( ( P - Q ) e. CC /\ ( P - Q ) =/= 0 ) ) -> ( ( P - Q ) ang ( P - Q ) ) = ( Im ` ( log ` ( ( P - Q ) / ( P - Q ) ) ) ) )
  6 syl 4 5 |- ( ph -> ( ( P - Q ) ang ( P - Q ) ) = ( Im ` ( log ` ( ( P - Q ) / ( P - Q ) ) ) ) )
  7 dividd 1 2 |- ( ph -> ( ( P - Q ) / ( P - Q ) ) = 1 )
  8 fveq2d 7 |- ( ph -> ( log ` ( ( P - Q ) / ( P - Q ) ) ) = ( log ` 1 ) )
  9 log1 |- ( log ` 1 ) = 0
  10 eqtrdi 8 9 |- ( ph -> ( log ` ( ( P - Q ) / ( P - Q ) ) ) = 0 )
  11 fveq2d 10 |- ( ph -> ( Im ` ( log ` ( ( P - Q ) / ( P - Q ) ) ) ) = ( Im ` 0 ) )
  12 im0 |- ( Im ` 0 ) = 0
  13 eqtrdi 11 12 |- ( ph -> ( Im ` ( log ` ( ( P - Q ) / ( P - Q ) ) ) ) = 0 )
  14 eqtrd 6 13 |- ( ph -> ( ( P - Q ) ang ( P - Q ) ) = 0 )

# `gsang3`: three rays from Q, toward A, X and B. With U, W and V the three
# directions, W/U times V/W is V/U, so the logarithms of the first two add
# to the logarithm of the third and a whole number n of turns 2·pi·i
# (`eflogeq`); the imaginary parts are the three angles and 2·n·pi.
lemma gsang3
  hypothesis gsang3.1 |- ( ph -> A e. CC )
  hypothesis gsang3.2 |- ( ph -> B e. CC )
  hypothesis gsang3.3 |- ( ph -> X e. CC )
  hypothesis gsang3.4 |- ( ph -> Q e. CC )
  hypothesis gsang3.5 |- ( ph -> A =/= Q )
  hypothesis gsang3.6 |- ( ph -> B =/= Q )
  hypothesis gsang3.7 |- ( ph -> X =/= Q )
  |- ( ph -> E. n e. ZZ ( ( ( A - Q ) ang ( X - Q ) ) + ( ( X - Q ) ang ( B - Q ) ) ) = ( ( ( A - Q ) ang ( B - Q ) ) + ( ( 2 x. n ) x. _pi ) ) )
  1 subcld gsang3.1 gsang3.4 |- ( ph -> ( A - Q ) e. CC )
  2 subcld gsang3.2 gsang3.4 |- ( ph -> ( B - Q ) e. CC )
  3 subcld gsang3.3 gsang3.4 |- ( ph -> ( X - Q ) e. CC )
  4 subne0d gsang3.1 gsang3.4 gsang3.5 |- ( ph -> ( A - Q ) =/= 0 )
  5 subne0d gsang3.2 gsang3.4 gsang3.6 |- ( ph -> ( B - Q ) =/= 0 )
  6 subne0d gsang3.3 gsang3.4 gsang3.7 |- ( ph -> ( X - Q ) =/= 0 )
