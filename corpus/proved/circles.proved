# `gisosctr`: set.mm's `isosctr`, of the corpus's angle. In a triangle with
# |AC| = |BC| the angle at A from AC to AB and the angle at B from BA to BC
# are equal, each turned the same way round the triangle.
lemma gisosctr
  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= C /\ B =/= C /\ A =/= B ) /\ ( abs ` ( A - C ) ) = ( abs ` ( B - C ) ) ) -> ( ( C - A ) ang ( B - A ) ) = ( ( A - B ) ang ( C - B ) ) )
  1 df-ang |- ang = ( x e. ( CC \ { 0 } ) , y e. ( CC \ { 0 } ) |-> ( Im ` ( log ` ( y / x ) ) ) )
  2 isosctr 1 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= C /\ B =/= C /\ A =/= B ) /\ ( abs ` ( A - C ) ) = ( abs ` ( B - C ) ) ) -> ( ( C - A ) ang ( B - A ) ) = ( ( A - B ) ang ( C - B ) ) )

# `gsideang`: C off the line AB, on the side the sign of
# Im((C − A)/(B − A)) says, sees AB turned that way. With z the quotient
# (B − C)/(A − C), the side's quotient is 1/(1 − z), whose imaginary part
# has the sign of Im z (`grecsgn`), and the angle ACB is the argument of z,
# whose sign is that of Im z (`gargsgn`). C is apart from A and from B,
# since there the side's quotient is 0 or 1, which are real.
lemma gsideang
  hypothesis gsideang.1 |- ( ph -> A e. CC )
  hypothesis gsideang.2 |- ( ph -> B e. CC )
  hypothesis gsideang.3 |- ( ph -> C e. CC )
  hypothesis gsideang.4 |- ( ph -> A =/= B )
  hypothesis gsideang.5 |- ( ph -> ( Im ` ( ( C - A ) / ( B - A ) ) ) =/= 0 )
  |- ( ph -> ( ( ( A - C ) ang ( B - C ) ) e. RR /\ 0 < ( ( ( A - C ) ang ( B - C ) ) x. ( Im ` ( ( C - A ) / ( B - A ) ) ) ) ) )
  1 necomd gsideang.4 |- ( ph -> B =/= A )
  2 subcld gsideang.2 gsideang.1 |- ( ph -> ( B - A ) e. CC )
  3 subne0d gsideang.2 gsideang.1 1 |- ( ph -> ( B - A ) =/= 0 )
  4 simpr |- ( ( ph /\ C = A ) -> C = A )
