# `gsamesang`: C and D on one side of line AB see AB turned the same way:
# each angle has the sign of its point's side (`gsideang`), and the two
# sides have one sign.
lemma gsamesang
  hypothesis gsamesang.1 |- ( ph -> A e. CC )
  hypothesis gsamesang.2 |- ( ph -> B e. CC )
  hypothesis gsamesang.3 |- ( ph -> C e. CC )
  hypothesis gsamesang.4 |- ( ph -> D e. CC )
  hypothesis gsamesang.5 |- ( ph -> 0 < ( ( Im ` ( ( C - A ) / ( B - A ) ) ) x. ( Im ` ( ( D - A ) / ( B - A ) ) ) ) )
  |- ( ph -> 0 < ( ( ( A - C ) ang ( B - C ) ) x. ( ( A - D ) ang ( B - D ) ) ) )
  1 jca gsamesang.1 gsamesang.2 |- ( ph -> ( A e. CC /\ B e. CC ) )
  2 jca 1 gsamesang.3 |- ( ph -> ( ( A e. CC /\ B e. CC ) /\ C e. CC ) )
