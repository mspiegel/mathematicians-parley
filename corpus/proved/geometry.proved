      -> -. -u ( B / A ) e. RR+ )
  36 arginv 33 34 35 |- ( ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) /\ -. -u ( B / A )
      e. RR+ ) -> ( Im ` ( log ` ( 1 / ( B / A ) ) ) ) = -u ( Im ` ( log ` ( B / A ) ) ) )
  37 fveq2d 36 |- ( ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) /\ -. -u ( B / A ) e. RR+
      ) -> ( abs ` ( Im ` ( log ` ( 1 / ( B / A ) ) ) ) ) = ( abs ` -u ( Im ` ( log ` ( B / A ) ) )
      ) )
  38 logcld 33 34 |- ( ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) /\ -. -u ( B / A ) e.
      RR+ ) -> ( log ` ( B / A ) ) e. CC )
  39 imcl |- ( ( log ` ( B / A ) ) e. CC -> ( Im ` ( log ` ( B / A ) ) ) e. RR )
  40 syl 38 39 |- ( ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) /\ -. -u ( B / A ) e. RR+
      ) -> ( Im ` ( log ` ( B / A ) ) ) e. RR )
  41 recn |- ( ( Im ` ( log ` ( B / A ) ) ) e. RR -> ( Im ` ( log ` ( B / A ) ) ) e. CC )
  42 syl 40 41 |- ( ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) /\ -. -u ( B / A ) e. RR+
      ) -> ( Im ` ( log ` ( B / A ) ) ) e. CC )
  43 absneg |- ( ( Im ` ( log ` ( B / A ) ) ) e. CC -> ( abs ` -u ( Im ` ( log ` ( B / A ) ) ) ) = (
      abs ` ( Im ` ( log ` ( B / A ) ) ) ) )
  44 syl 42 43 |- ( ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) /\ -. -u ( B / A ) e. RR+
      ) -> ( abs ` -u ( Im ` ( log ` ( B / A ) ) ) ) = ( abs ` ( Im ` ( log ` ( B / A ) ) ) ) )
  45 eqtrd 37 44 |- ( ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) /\ -. -u ( B / A ) e.
      RR+ ) -> ( abs ` ( Im ` ( log ` ( 1 / ( B / A ) ) ) ) ) = ( abs ` ( Im ` ( log ` ( B / A ) ) )
