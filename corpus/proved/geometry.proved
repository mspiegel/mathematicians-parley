  5 simpl |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> ( A e. CC /\ A =/= 0 ) )
  6 jca 4 5 |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> ( ( B e. CC /\ B =/= 0 ) /\
      ( A e. CC /\ A =/= 0 ) ) )
  7 recdiv |- ( ( ( B e. CC /\ B =/= 0 ) /\ ( A e. CC /\ A =/= 0 ) ) -> ( 1 / ( B / A ) ) = ( A / B
      ) )
  8 syl 6 7 |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> ( 1 / ( B / A ) ) = ( A / B
      ) )
  9 eqcomd 8 |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> ( A / B ) = ( 1 / ( B / A
      ) ) )
  10 fveq2d 9 |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> ( log ` ( A / B ) ) = (
      log ` ( 1 / ( B / A ) ) ) )
  11 fveq2d 10 |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> ( Im ` ( log ` ( A / B )
      ) ) = ( Im ` ( log ` ( 1 / ( B / A ) ) ) ) )
  12 eqtrd 3 11 |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> ( B ang A ) = ( Im ` (
      log ` ( 1 / ( B / A ) ) ) ) )

# The angle from A to B and the angle from B to A have one size.
#
# `ang` is signed and lands in −pi to pi, so the two are not equal; the
# corpus writes the unsigned angle, which is this one's absolute value, and
# those do agree. Off the branch cut that is `arginv`, which says the signed
# angle of an inverse is the negative of the angle. On the cut `arginv`
# does not apply and nothing is negated: `lognegb` says a number whose
# negative is a positive real has angle pi exactly, and the inverse of such
# a number is another, so both angles are pi.
lemma gangsym
  |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> ( abs ` ( A ang B ) ) = ( abs ` ( B
      ang A ) ) )
  1 simpr |- ( ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) /\ -u ( B / A ) e. RR+ ) -> -u
      ( B / A ) e. RR+ )
  2 simpr |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> ( B e. CC /\ B =/= 0 ) )
  3 simpld 2 |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> B e. CC )
  4 simpl |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> ( A e. CC /\ A =/= 0 ) )
  5 simpld 4 |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> A e. CC )
  6 simprd 4 |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> A =/= 0 )
  7 divcl |- ( ( B e. CC /\ A e. CC /\ A =/= 0 ) -> ( B / A ) e. CC )
  8 syl3anc 3 5 6 7 |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> ( B / A ) e. CC )
  9 adantr 8 |- ( ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) /\ -u ( B / A ) e. RR+ ) ->
      ( B / A ) e. CC )
