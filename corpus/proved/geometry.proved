      /\ -. ( ( C - A ) / ( B - A ) ) e. RR ) ) -> ( -. ( ( C - A ) / ( B - A ) ) e. RR -> -. ( ( A
      - B ) / ( C - B ) ) e. RR ) )
  37 mpd 14 36 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( ( -. A = B /\ -. B = C ) /\ -. A = C
      ) /\ -. ( ( C - A ) / ( B - A ) ) e. RR ) ) -> -. ( ( A - B ) / ( C - B ) ) e. RR )
  38 jca 13 37 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( ( -. A = B /\ -. B = C ) /\ -. A = C
