      /\ -. ( ( C - A ) / ( B - A ) ) e. RR ) ) -> -. ( ( C - A ) / ( B - A ) ) e. RR )
  15 simpl |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( ( -. A = B /\ -. B = C ) /\ -. A = C ) /\
      -. ( ( C - A ) / ( B - A ) ) e. RR ) ) -> ( A e. CC /\ B e. CC /\ C e. CC ) )
  16 simp1 |- ( ( A e. CC /\ B e. CC /\ C e. CC ) -> A e. CC )
  17 adantr 16 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( ( -. A = B /\ -. B = C ) /\ -. A = C
      ) /\ -. ( ( C - A ) / ( B - A ) ) e. RR ) ) -> A e. CC )
  18 simp2 |- ( ( A e. CC /\ B e. CC /\ C e. CC ) -> B e. CC )
  19 adantr 18 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( ( -. A = B /\ -. B = C ) /\ -. A = C
