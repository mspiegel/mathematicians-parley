lemma gangval
  |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> ( A ang B ) = ( Im ` ( log ` ( B / A
      ) ) ) )
  1 df-ang |- ang = ( x e. ( CC \ { 0 } ) , y e. ( CC \ { 0 } ) |-> ( Im ` ( log ` ( y / x ) ) ) )
  2 angval 1 |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> ( A ang B ) = ( Im ` ( log
      ` ( B / A ) ) ) )

lemma gangrec
  |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> ( B ang A ) = ( Im ` ( log ` ( 1 / (
      B / A ) ) ) ) )
  1 df-ang |- ang = ( x e. ( CC \ { 0 } ) , y e. ( CC \ { 0 } ) |-> ( Im ` ( log ` ( y / x ) ) ) )
  2 angval 1 |- ( ( ( B e. CC /\ B =/= 0 ) /\ ( A e. CC /\ A =/= 0 ) ) -> ( B ang A ) = ( Im ` ( log
      ` ( A / B ) ) ) )
  3 ancoms 2 |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> ( B ang A ) = ( Im ` ( log
      ` ( A / B ) ) ) )
