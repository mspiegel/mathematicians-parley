  54 syl 10 53 |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> ( 1 / ( B / A ) ) = ( A
      / B ) )
  55 eqcomd 54 |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> ( A / B ) = ( 1 / ( B /
      A ) ) )
  56 fveq2d 55 |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> ( log ` ( A / B ) ) = (
      log ` ( 1 / ( B / A ) ) ) )
  57 fveq2d 56 |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> ( Im ` ( log ` ( A / B )
