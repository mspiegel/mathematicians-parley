  46 eqcomd 45 |- ( ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) /\ -. -u ( B / A ) e. RR+
      ) -> ( abs ` ( Im ` ( log ` ( B / A ) ) ) ) = ( abs ` ( Im ` ( log ` ( 1 / ( B / A ) ) ) ) ) )
  47 pm2.61dan 32 46 |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> ( abs ` ( Im ` (
      log ` ( B / A ) ) ) ) = ( abs ` ( Im ` ( log ` ( 1 / ( B / A ) ) ) ) ) )
  48 df-ang |- ang = ( x e. ( CC \ { 0 } ) , y e. ( CC \ { 0 } ) |-> ( Im ` ( log ` ( y / x ) ) ) )
  49 angval 48 |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> ( A ang B ) = ( Im ` (
      log ` ( B / A ) ) ) )
  50 fveq2d 49 |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> ( abs ` ( A ang B ) ) =
