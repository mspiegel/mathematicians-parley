# The geometry facts this corpus needs and set.mm lacks, for `proved.mm`.
#
# The corpus supplies an item in one of two ways: a set.mm label, or a
# proof file in the readable layer. Some of the geometry items can take
# neither. set.mm has no theorem stating them, and the readable layer
# cannot state them either, because saying what they say means dividing
# one point by another and naming the branch cut of the complex logarithm.
# Those are the ℂ encoding, which `GEOMETRY.md` chose on the understanding
# that it would reach the reader as dull facts and not as case splits
# inside an argument.
#
# So they are proved here, below the readable layer, beside the other
# library proofs and after `definitions.mm`'s `df-ang`. A proof file
# includes what that writes; the database names these labels in a `target`
# the way it names a set.mm label.

$( Geometry: what this corpus needs of the plane and set.mm does not
   state. Points are complex numbers, distance is the absolute value of a
   difference, and the angle is the constant definitions.mm introduces,
   so everything here is a theorem rather than an axiom: CC is a model
   and nothing in it has to be assumed.  GEOMETRY.md takes that
   decision and says what it costs. $)

$( `angval` reads a value of the angle by substituting for the two names
   `df-ang` binds, and asks that they be free of what is substituted. They
   appear in no statement here, only inside the proofs. The pairs are
   written one at a time because `$d x y A B` would also hold A and B
   apart, and the lemmas below are applied at terms that share names. $)
$d x y $.
$d x A $.  $d y A $.
$d x B $.  $d y B $.
$d x C $.  $d y C $.
$d x P $.  $d y P $.
$d x Q $.  $d y Q $.
$d x R $.  $d y R $.
$d x S $.  $d y S $.
$d x T $.  $d y T $.
$d x U $.  $d y U $.

# Reordering a triangle's vertices, and the fact underneath it.
#
# A triangle is three distinct points that are not collinear, and in the
# plane the three being collinear is (R − P)/(Q − P) being real. Swapping
# two vertices inverts that quotient and rotating them replaces it by
# (1 − t)/(−t); neither leaves the reals, so neither makes a triangle
# collinear. `gtrirec` is the inversion and the rest is bookkeeping.
lemma gtrirec
  |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> ( ( A / B ) e. RR -> ( B / A ) e. RR
      ) )
  1 recdiv |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> ( 1 / ( A / B ) ) = ( B / A
      ) )
  2 adantr 1 |- ( ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) /\ ( A / B ) e. RR ) -> ( 1
      / ( A / B ) ) = ( B / A ) )
  3 simpr |- ( ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) /\ ( A / B ) e. RR ) -> ( A /
      B ) e. RR )
  4 divne0 |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> ( A / B ) =/= 0 )
  5 adantr 4 |- ( ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) /\ ( A / B ) e. RR ) -> ( A
      / B ) =/= 0 )
  6 jca 3 5 |- ( ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) /\ ( A / B ) e. RR ) -> ( (
      A / B ) e. RR /\ ( A / B ) =/= 0 ) )
  7 rereccl |- ( ( ( A / B ) e. RR /\ ( A / B ) =/= 0 ) -> ( 1 / ( A / B ) ) e. RR )
  8 syl 6 7 |- ( ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) /\ ( A / B ) e. RR ) -> ( 1
      / ( A / B ) ) e. RR )
  9 eqeltrrd 2 8 |- ( ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) /\ ( A / B ) e. RR ) ->
      ( B / A ) e. RR )
  10 ex 9 |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> ( ( A / B ) e. RR -> ( B / A
      ) e. RR ) )

# Reordering a triangle's vertices, and the fact underneath it.
#
# A triangle is three distinct points that are not collinear, and in the
# plane the three being collinear is (R − P)/(Q − P) being real. Swapping
# two vertices inverts that quotient and rotating them replaces it by
# (1 − t)/(−t); neither leaves the reals, so neither makes a triangle
# collinear. `gtrirec` is the inversion and the rest is bookkeeping.
lemma gtriswap
  |- ( ( A e. CC /\ B e. CC /\ C e. CC ) -> ( ( ( ( -. A = B /\ -. B = C ) /\ -. A = C ) /\ -. ( ( C
      - A ) / ( B - A ) ) e. RR ) -> ( ( ( -. A = C /\ -. C = B ) /\ -. A = B ) /\ -. ( ( B - A ) /
      ( C - A ) ) e. RR ) ) )
  1 simpr |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( ( -. A = B /\ -. B = C ) /\ -. A = C ) /\
      -. ( ( C - A ) / ( B - A ) ) e. RR ) ) -> ( ( ( -. A = B /\ -. B = C ) /\ -. A = C ) /\ -. ( (
      C - A ) / ( B - A ) ) e. RR ) )
  2 simpld 1 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( ( -. A = B /\ -. B = C ) /\ -. A = C )
      /\ -. ( ( C - A ) / ( B - A ) ) e. RR ) ) -> ( ( -. A = B /\ -. B = C ) /\ -. A = C ) )
  3 simprd 2 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( ( -. A = B /\ -. B = C ) /\ -. A = C )
      /\ -. ( ( C - A ) / ( B - A ) ) e. RR ) ) -> -. A = C )
  4 simpld 2 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( ( -. A = B /\ -. B = C ) /\ -. A = C )
      /\ -. ( ( C - A ) / ( B - A ) ) e. RR ) ) -> ( -. A = B /\ -. B = C ) )
  5 simprd 4 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( ( -. A = B /\ -. B = C ) /\ -. A = C )
      /\ -. ( ( C - A ) / ( B - A ) ) e. RR ) ) -> -. B = C )
  6 neqned 5 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( ( -. A = B /\ -. B = C ) /\ -. A = C )
      /\ -. ( ( C - A ) / ( B - A ) ) e. RR ) ) -> B =/= C )
  7 necomd 6 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( ( -. A = B /\ -. B = C ) /\ -. A = C )
      /\ -. ( ( C - A ) / ( B - A ) ) e. RR ) ) -> C =/= B )
  8 neneqd 7 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( ( -. A = B /\ -. B = C ) /\ -. A = C )
      /\ -. ( ( C - A ) / ( B - A ) ) e. RR ) ) -> -. C = B )
  9 simpld 4 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( ( -. A = B /\ -. B = C ) /\ -. A = C )
      /\ -. ( ( C - A ) / ( B - A ) ) e. RR ) ) -> -. A = B )
  10 jca31 3 8 9 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( ( -. A = B /\ -. B = C ) /\ -. A =
      C ) /\ -. ( ( C - A ) / ( B - A ) ) e. RR ) ) -> ( ( -. A = C /\ -. C = B ) /\ -. A = B ) )
  11 simprd 1 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( ( -. A = B /\ -. B = C ) /\ -. A = C )
      /\ -. ( ( C - A ) / ( B - A ) ) e. RR ) ) -> -. ( ( C - A ) / ( B - A ) ) e. RR )
  12 simp2 |- ( ( A e. CC /\ B e. CC /\ C e. CC ) -> B e. CC )
  13 adantr 12 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( ( -. A = B /\ -. B = C ) /\ -. A = C
      ) /\ -. ( ( C - A ) / ( B - A ) ) e. RR ) ) -> B e. CC )
  14 simp1 |- ( ( A e. CC /\ B e. CC /\ C e. CC ) -> A e. CC )
  15 adantr 14 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( ( -. A = B /\ -. B = C ) /\ -. A = C
      ) /\ -. ( ( C - A ) / ( B - A ) ) e. RR ) ) -> A e. CC )
  16 subcld 13 15 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( ( -. A = B /\ -. B = C ) /\ -. A =
      C ) /\ -. ( ( C - A ) / ( B - A ) ) e. RR ) ) -> ( B - A ) e. CC )
  17 neqned 9 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( ( -. A = B /\ -. B = C ) /\ -. A = C )
      /\ -. ( ( C - A ) / ( B - A ) ) e. RR ) ) -> A =/= B )
  18 necomd 17 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( ( -. A = B /\ -. B = C ) /\ -. A = C
      ) /\ -. ( ( C - A ) / ( B - A ) ) e. RR ) ) -> B =/= A )
  19 neneqd 18 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( ( -. A = B /\ -. B = C ) /\ -. A = C
      ) /\ -. ( ( C - A ) / ( B - A ) ) e. RR ) ) -> -. B = A )
  20 neqned 19 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( ( -. A = B /\ -. B = C ) /\ -. A = C
      ) /\ -. ( ( C - A ) / ( B - A ) ) e. RR ) ) -> B =/= A )
  21 subeq0ad 13 15 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( ( -. A = B /\ -. B = C ) /\ -. A
      = C ) /\ -. ( ( C - A ) / ( B - A ) ) e. RR ) ) -> ( ( B - A ) = 0 <-> B = A ) )
  22 necon3bid 21 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( ( -. A = B /\ -. B = C ) /\ -. A =
      C ) /\ -. ( ( C - A ) / ( B - A ) ) e. RR ) ) -> ( ( B - A ) =/= 0 <-> B =/= A ) )
  23 mpbird 20 22 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( ( -. A = B /\ -. B = C ) /\ -. A =
      C ) /\ -. ( ( C - A ) / ( B - A ) ) e. RR ) ) -> ( B - A ) =/= 0 )
  24 jca 16 23 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( ( -. A = B /\ -. B = C ) /\ -. A = C
      ) /\ -. ( ( C - A ) / ( B - A ) ) e. RR ) ) -> ( ( B - A ) e. CC /\ ( B - A ) =/= 0 ) )
  25 simp3 |- ( ( A e. CC /\ B e. CC /\ C e. CC ) -> C e. CC )
  26 adantr 25 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( ( -. A = B /\ -. B = C ) /\ -. A = C
      ) /\ -. ( ( C - A ) / ( B - A ) ) e. RR ) ) -> C e. CC )
  27 subcld 26 15 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( ( -. A = B /\ -. B = C ) /\ -. A =
      C ) /\ -. ( ( C - A ) / ( B - A ) ) e. RR ) ) -> ( C - A ) e. CC )
  28 neqned 3 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( ( -. A = B /\ -. B = C ) /\ -. A = C )
      /\ -. ( ( C - A ) / ( B - A ) ) e. RR ) ) -> A =/= C )
  29 necomd 28 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( ( -. A = B /\ -. B = C ) /\ -. A = C
      ) /\ -. ( ( C - A ) / ( B - A ) ) e. RR ) ) -> C =/= A )
  30 neneqd 29 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( ( -. A = B /\ -. B = C ) /\ -. A = C
      ) /\ -. ( ( C - A ) / ( B - A ) ) e. RR ) ) -> -. C = A )
  31 neqned 30 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( ( -. A = B /\ -. B = C ) /\ -. A = C
      ) /\ -. ( ( C - A ) / ( B - A ) ) e. RR ) ) -> C =/= A )
  32 subeq0ad 26 15 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( ( -. A = B /\ -. B = C ) /\ -. A
      = C ) /\ -. ( ( C - A ) / ( B - A ) ) e. RR ) ) -> ( ( C - A ) = 0 <-> C = A ) )
  33 necon3bid 32 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( ( -. A = B /\ -. B = C ) /\ -. A =
      C ) /\ -. ( ( C - A ) / ( B - A ) ) e. RR ) ) -> ( ( C - A ) =/= 0 <-> C =/= A ) )
  34 mpbird 31 33 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( ( -. A = B /\ -. B = C ) /\ -. A =
      C ) /\ -. ( ( C - A ) / ( B - A ) ) e. RR ) ) -> ( C - A ) =/= 0 )
  35 jca 27 34 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( ( -. A = B /\ -. B = C ) /\ -. A = C
      ) /\ -. ( ( C - A ) / ( B - A ) ) e. RR ) ) -> ( ( C - A ) e. CC /\ ( C - A ) =/= 0 ) )
  36 jca 24 35 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( ( -. A = B /\ -. B = C ) /\ -. A = C
      ) /\ -. ( ( C - A ) / ( B - A ) ) e. RR ) ) -> ( ( ( B - A ) e. CC /\ ( B - A ) =/= 0 ) /\ ( (
      C - A ) e. CC /\ ( C - A ) =/= 0 ) ) )
  37 gtrirec |- ( ( ( ( B - A ) e. CC /\ ( B - A ) =/= 0 ) /\ ( ( C - A ) e. CC /\ ( C - A ) =/= 0 )
      ) -> ( ( ( B - A ) / ( C - A ) ) e. RR -> ( ( C - A ) / ( B - A ) ) e. RR ) )
  38 syl 36 37 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( ( -. A = B /\ -. B = C ) /\ -. A = C
      ) /\ -. ( ( C - A ) / ( B - A ) ) e. RR ) ) -> ( ( ( B - A ) / ( C - A ) ) e. RR -> ( ( C - A
      ) / ( B - A ) ) e. RR ) )
  39 con3d 38 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( ( -. A = B /\ -. B = C ) /\ -. A = C )
      /\ -. ( ( C - A ) / ( B - A ) ) e. RR ) ) -> ( -. ( ( C - A ) / ( B - A ) ) e. RR -> -. ( ( B
      - A ) / ( C - A ) ) e. RR ) )
  40 mpd 11 39 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( ( -. A = B /\ -. B = C ) /\ -. A = C
      ) /\ -. ( ( C - A ) / ( B - A ) ) e. RR ) ) -> -. ( ( B - A ) / ( C - A ) ) e. RR )
  41 jca 10 40 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( ( -. A = B /\ -. B = C ) /\ -. A = C
      ) /\ -. ( ( C - A ) / ( B - A ) ) e. RR ) ) -> ( ( ( -. A = C /\ -. C = B ) /\ -. A = B ) /\
      -. ( ( B - A ) / ( C - A ) ) e. RR ) )
  42 ex 41 |- ( ( A e. CC /\ B e. CC /\ C e. CC ) -> ( ( ( ( -. A = B /\ -. B = C ) /\ -. A = C ) /\
      -. ( ( C - A ) / ( B - A ) ) e. RR ) -> ( ( ( -. A = C /\ -. C = B ) /\ -. A = B ) /\ -. ( ( B
      - A ) / ( C - A ) ) e. RR ) ) )

# Rotating the vertices, which moves the quotient rather than inverting.
#
# Swapping two vertices takes (C − A)/(B − A) to its own inverse, but
# rotating them takes it to 1 − (C − B)/(A − B), so the step is an
# identity of the field rather than one fact about reciprocals. The
# identity holds because (A − B) − (C − B) is A − C, and dividing that by
# A − B splits into the two quotients.
lemma gtricol
  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( A - B ) =/= 0 /\ ( C - B ) =/= 0 ) ) -> ( ( ( A -
      B ) / ( C - B ) ) e. RR -> ( ( C - A ) / ( B - A ) ) e. RR ) )
  1 simp1 |- ( ( A e. CC /\ B e. CC /\ C e. CC ) -> A e. CC )
  2 adantr 1 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( A - B ) =/= 0 /\ ( C - B ) =/= 0 ) ) ->
      A e. CC )
  3 adantr 2 |- ( ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( A - B ) =/= 0 /\ ( C - B ) =/= 0 ) )
      /\ ( ( A - B ) / ( C - B ) ) e. RR ) -> A e. CC )
  4 simp3 |- ( ( A e. CC /\ B e. CC /\ C e. CC ) -> C e. CC )
  5 adantr 4 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( A - B ) =/= 0 /\ ( C - B ) =/= 0 ) ) ->
      C e. CC )
  6 adantr 5 |- ( ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( A - B ) =/= 0 /\ ( C - B ) =/= 0 ) )
      /\ ( ( A - B ) / ( C - B ) ) e. RR ) -> C e. CC )
  7 subcld 3 6 |- ( ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( A - B ) =/= 0 /\ ( C - B ) =/= 0 )
      ) /\ ( ( A - B ) / ( C - B ) ) e. RR ) -> ( A - C ) e. CC )
  8 simp2 |- ( ( A e. CC /\ B e. CC /\ C e. CC ) -> B e. CC )
  9 adantr 8 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( A - B ) =/= 0 /\ ( C - B ) =/= 0 ) ) ->
      B e. CC )
  10 adantr 9 |- ( ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( A - B ) =/= 0 /\ ( C - B ) =/= 0 ) )
      /\ ( ( A - B ) / ( C - B ) ) e. RR ) -> B e. CC )
  11 subcld 3 10 |- ( ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( A - B ) =/= 0 /\ ( C - B ) =/= 0
      ) ) /\ ( ( A - B ) / ( C - B ) ) e. RR ) -> ( A - B ) e. CC )
  12 simpl |- ( ( ( A - B ) =/= 0 /\ ( C - B ) =/= 0 ) -> ( A - B ) =/= 0 )
  13 adantl 12 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( A - B ) =/= 0 /\ ( C - B ) =/= 0 ) )
      -> ( A - B ) =/= 0 )
  14 adantr 13 |- ( ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( A - B ) =/= 0 /\ ( C - B ) =/= 0 )
      ) /\ ( ( A - B ) / ( C - B ) ) e. RR ) -> ( A - B ) =/= 0 )
  15 div2neg |- ( ( ( A - C ) e. CC /\ ( A - B ) e. CC /\ ( A - B ) =/= 0 ) -> ( -u ( A - C ) / -u (
      A - B ) ) = ( ( A - C ) / ( A - B ) ) )
  16 syl3anc 7 11 14 15 |- ( ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( A - B ) =/= 0 /\ ( C - B )
      =/= 0 ) ) /\ ( ( A - B ) / ( C - B ) ) e. RR ) -> ( -u ( A - C ) / -u ( A - B ) ) = ( ( A - C
      ) / ( A - B ) ) )
  17 negsubdi2 |- ( ( A e. CC /\ C e. CC ) -> -u ( A - C ) = ( C - A ) )
  18 syl2anc 3 6 17 |- ( ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( A - B ) =/= 0 /\ ( C - B ) =/=
      0 ) ) /\ ( ( A - B ) / ( C - B ) ) e. RR ) -> -u ( A - C ) = ( C - A ) )
  19 negsubdi2 |- ( ( A e. CC /\ B e. CC ) -> -u ( A - B ) = ( B - A ) )
  20 syl2anc 3 10 19 |- ( ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( A - B ) =/= 0 /\ ( C - B )
      =/= 0 ) ) /\ ( ( A - B ) / ( C - B ) ) e. RR ) -> -u ( A - B ) = ( B - A ) )
  21 oveq12d 18 20 |- ( ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( A - B ) =/= 0 /\ ( C - B ) =/=
      0 ) ) /\ ( ( A - B ) / ( C - B ) ) e. RR ) -> ( -u ( A - C ) / -u ( A - B ) ) = ( ( C - A ) /
      ( B - A ) ) )
  22 nnncan2 |- ( ( A e. CC /\ C e. CC /\ B e. CC ) -> ( ( A - B ) - ( C - B ) ) = ( A - C ) )
  23 syl3anc 3 6 10 22 |- ( ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( A - B ) =/= 0 /\ ( C - B )
      =/= 0 ) ) /\ ( ( A - B ) / ( C - B ) ) e. RR ) -> ( ( A - B ) - ( C - B ) ) = ( A - C ) )
  24 oveq1d 23 |- ( ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( A - B ) =/= 0 /\ ( C - B ) =/= 0 )
      ) /\ ( ( A - B ) / ( C - B ) ) e. RR ) -> ( ( ( A - B ) - ( C - B ) ) / ( A - B ) ) = ( ( A -
      C ) / ( A - B ) ) )
  25 subcld 6 10 |- ( ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( A - B ) =/= 0 /\ ( C - B ) =/= 0
      ) ) /\ ( ( A - B ) / ( C - B ) ) e. RR ) -> ( C - B ) e. CC )
  26 jca 11 14 |- ( ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( A - B ) =/= 0 /\ ( C - B ) =/= 0 )
      ) /\ ( ( A - B ) / ( C - B ) ) e. RR ) -> ( ( A - B ) e. CC /\ ( A - B ) =/= 0 ) )
  27 divsubdir |- ( ( ( A - B ) e. CC /\ ( C - B ) e. CC /\ ( ( A - B ) e. CC /\ ( A - B ) =/= 0 ) )
      -> ( ( ( A - B ) - ( C - B ) ) / ( A - B ) ) = ( ( ( A - B ) / ( A - B ) ) - ( ( C - B ) / ( A
      - B ) ) ) )
  28 syl3anc 11 25 26 27 |- ( ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( A - B ) =/= 0 /\ ( C - B
      ) =/= 0 ) ) /\ ( ( A - B ) / ( C - B ) ) e. RR ) -> ( ( ( A - B ) - ( C - B ) ) / ( A - B ) )
      = ( ( ( A - B ) / ( A - B ) ) - ( ( C - B ) / ( A - B ) ) ) )
  29 divid |- ( ( ( A - B ) e. CC /\ ( A - B ) =/= 0 ) -> ( ( A - B ) / ( A - B ) ) = 1 )
  30 syl2anc 11 14 29 |- ( ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( A - B ) =/= 0 /\ ( C - B )
      =/= 0 ) ) /\ ( ( A - B ) / ( C - B ) ) e. RR ) -> ( ( A - B ) / ( A - B ) ) = 1 )
  31 oveq1d 30 |- ( ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( A - B ) =/= 0 /\ ( C - B ) =/= 0 )
      ) /\ ( ( A - B ) / ( C - B ) ) e. RR ) -> ( ( ( A - B ) / ( A - B ) ) - ( ( C - B ) / ( A - B
      ) ) ) = ( 1 - ( ( C - B ) / ( A - B ) ) ) )
  32 eqtrd 28 31 |- ( ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( A - B ) =/= 0 /\ ( C - B ) =/= 0
      ) ) /\ ( ( A - B ) / ( C - B ) ) e. RR ) -> ( ( ( A - B ) - ( C - B ) ) / ( A - B ) ) = ( 1 -
      ( ( C - B ) / ( A - B ) ) ) )
  33 eqtr3d 24 32 |- ( ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( A - B ) =/= 0 /\ ( C - B ) =/= 0
      ) ) /\ ( ( A - B ) / ( C - B ) ) e. RR ) -> ( ( A - C ) / ( A - B ) ) = ( 1 - ( ( C - B ) / (
      A - B ) ) ) )
  34 3eqtr3d 16 21 33 |- ( ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( A - B ) =/= 0 /\ ( C - B )
      =/= 0 ) ) /\ ( ( A - B ) / ( C - B ) ) e. RR ) -> ( ( C - A ) / ( B - A ) ) = ( 1 - ( ( C - B
      ) / ( A - B ) ) ) )
  35 1re |- 1 e. RR
  36 a1i 35 |- ( ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( A - B ) =/= 0 /\ ( C - B ) =/= 0 ) )
      /\ ( ( A - B ) / ( C - B ) ) e. RR ) -> 1 e. RR )
  37 simpr |- ( ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( A - B ) =/= 0 /\ ( C - B ) =/= 0 ) ) /\
