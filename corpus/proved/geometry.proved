  39 adantl 38 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( A - B ) =/= 0 /\ ( C - B ) =/= 0 ) )
      -> ( C - B ) =/= 0 )
  40 adantr 39 |- ( ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( ( A - B ) =/= 0 /\ ( C - B ) =/= 0 )
