      ) -> ( 1 / ( B / A ) ) =/= 0 )
  28 lognegb |- ( ( ( 1 / ( B / A ) ) e. CC /\ ( 1 / ( B / A ) ) =/= 0 ) -> ( -u ( 1 / ( B / A ) )
      e. RR+ <-> ( Im ` ( log ` ( 1 / ( B / A ) ) ) ) = _pi ) )
  29 syl2anc 26 27 28 |- ( ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) /\ -u ( B / A ) e.
      RR+ ) -> ( -u ( 1 / ( B / A ) ) e. RR+ <-> ( Im ` ( log ` ( 1 / ( B / A ) ) ) ) = _pi ) )
  30 mpbid 25 29 |- ( ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) /\ -u ( B / A ) e. RR+
      ) -> ( Im ` ( log ` ( 1 / ( B / A ) ) ) ) = _pi )
  31 fveq2d 30 |- ( ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) /\ -u ( B / A ) e. RR+ )
      -> ( abs ` ( Im ` ( log ` ( 1 / ( B / A ) ) ) ) ) = ( abs ` _pi ) )
  32 eqtr4d 17 31 |- ( ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) /\ -u ( B / A ) e. RR+
      ) -> ( abs ` ( Im ` ( log ` ( B / A ) ) ) ) = ( abs ` ( Im ` ( log ` ( 1 / ( B / A ) ) ) ) ) )
  33 adantr 8 |- ( ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) /\ -. -u ( B / A ) e. RR+
      ) -> ( B / A ) e. CC )
  34 adantr 12 |- ( ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) /\ -. -u ( B / A ) e. RR+
