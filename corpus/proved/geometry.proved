# Two laws of cosines with the same sides say the same cosine.
#
# Both sides of the comparison have the shape Z − 2(K·X), where Z is the
# two squares added and K the two sides multiplied. What is wanted is X, so
# Z comes off by `subcan` and the two factors by `mulcan`. K is a product of
# two lengths and is nonzero because neither vertex meets the one the angle
# sits at.
lemma gcoscan
  |- ( ( ( X e. CC /\ Y e. CC /\ Z e. CC ) /\ ( K e. CC /\ K =/= 0 ) ) -> ( ( Z - ( 2 x. ( K x. X )
      ) ) = ( Z - ( 2 x. ( K x. Y ) ) ) -> X = Y ) )
  1 simpl |- ( ( ( X e. CC /\ Y e. CC /\ Z e. CC ) /\ ( K e. CC /\ K =/= 0 ) ) -> ( X e. CC /\ Y e.
      CC /\ Z e. CC ) )
  2 simp3 |- ( ( X e. CC /\ Y e. CC /\ Z e. CC ) -> Z e. CC )
  3 syl 1 2 |- ( ( ( X e. CC /\ Y e. CC /\ Z e. CC ) /\ ( K e. CC /\ K =/= 0 ) ) -> Z e. CC )
  4 2cn |- 2 e. CC
  5 a1i 4 |- ( ( ( X e. CC /\ Y e. CC /\ Z e. CC ) /\ ( K e. CC /\ K =/= 0 ) ) -> 2 e. CC )
  6 simpr |- ( ( ( X e. CC /\ Y e. CC /\ Z e. CC ) /\ ( K e. CC /\ K =/= 0 ) ) -> ( K e. CC /\ K =/=
      0 ) )
  7 simpld 6 |- ( ( ( X e. CC /\ Y e. CC /\ Z e. CC ) /\ ( K e. CC /\ K =/= 0 ) ) -> K e. CC )
  8 simp1 |- ( ( X e. CC /\ Y e. CC /\ Z e. CC ) -> X e. CC )
  9 syl 1 8 |- ( ( ( X e. CC /\ Y e. CC /\ Z e. CC ) /\ ( K e. CC /\ K =/= 0 ) ) -> X e. CC )
  10 mulcld 7 9 |- ( ( ( X e. CC /\ Y e. CC /\ Z e. CC ) /\ ( K e. CC /\ K =/= 0 ) ) -> ( K x. X )
      e. CC )
  11 mulcld 5 10 |- ( ( ( X e. CC /\ Y e. CC /\ Z e. CC ) /\ ( K e. CC /\ K =/= 0 ) ) -> ( 2 x. ( K
      x. X ) ) e. CC )
  12 simp2 |- ( ( X e. CC /\ Y e. CC /\ Z e. CC ) -> Y e. CC )
  13 syl 1 12 |- ( ( ( X e. CC /\ Y e. CC /\ Z e. CC ) /\ ( K e. CC /\ K =/= 0 ) ) -> Y e. CC )
  14 mulcld 7 13 |- ( ( ( X e. CC /\ Y e. CC /\ Z e. CC ) /\ ( K e. CC /\ K =/= 0 ) ) -> ( K x. Y )
      e. CC )
  15 mulcld 5 14 |- ( ( ( X e. CC /\ Y e. CC /\ Z e. CC ) /\ ( K e. CC /\ K =/= 0 ) ) -> ( 2 x. ( K
      x. Y ) ) e. CC )
  16 subcan |- ( ( Z e. CC /\ ( 2 x. ( K x. X ) ) e. CC /\ ( 2 x. ( K x. Y ) ) e. CC ) -> ( ( Z - (
      2 x. ( K x. X ) ) ) = ( Z - ( 2 x. ( K x. Y ) ) ) <-> ( 2 x. ( K x. X ) ) = ( 2 x. ( K x. Y )
      ) ) )
  17 syl3anc 3 11 15 16 |- ( ( ( X e. CC /\ Y e. CC /\ Z e. CC ) /\ ( K e. CC /\ K =/= 0 ) ) -> ( (
      Z - ( 2 x. ( K x. X ) ) ) = ( Z - ( 2 x. ( K x. Y ) ) ) <-> ( 2 x. ( K x. X ) ) = ( 2 x. ( K
      x. Y ) ) ) )
  18 biimpd 17 |- ( ( ( X e. CC /\ Y e. CC /\ Z e. CC ) /\ ( K e. CC /\ K =/= 0 ) ) -> ( ( Z - ( 2
      x. ( K x. X ) ) ) = ( Z - ( 2 x. ( K x. Y ) ) ) -> ( 2 x. ( K x. X ) ) = ( 2 x. ( K x. Y ) ) )
      )
  19 2ne0 |- 2 =/= 0
  20 a1i 19 |- ( ( ( X e. CC /\ Y e. CC /\ Z e. CC ) /\ ( K e. CC /\ K =/= 0 ) ) -> 2 =/= 0 )
  21 jca 5 20 |- ( ( ( X e. CC /\ Y e. CC /\ Z e. CC ) /\ ( K e. CC /\ K =/= 0 ) ) -> ( 2 e. CC /\ 2
      =/= 0 ) )
  22 mulcan |- ( ( ( K x. X ) e. CC /\ ( K x. Y ) e. CC /\ ( 2 e. CC /\ 2 =/= 0 ) ) -> ( ( 2 x. ( K
      x. X ) ) = ( 2 x. ( K x. Y ) ) <-> ( K x. X ) = ( K x. Y ) ) )
  23 syl3anc 10 14 21 22 |- ( ( ( X e. CC /\ Y e. CC /\ Z e. CC ) /\ ( K e. CC /\ K =/= 0 ) ) -> ( (
      2 x. ( K x. X ) ) = ( 2 x. ( K x. Y ) ) <-> ( K x. X ) = ( K x. Y ) ) )
  24 sylibd 18 23 |- ( ( ( X e. CC /\ Y e. CC /\ Z e. CC ) /\ ( K e. CC /\ K =/= 0 ) ) -> ( ( Z - (
      2 x. ( K x. X ) ) ) = ( Z - ( 2 x. ( K x. Y ) ) ) -> ( K x. X ) = ( K x. Y ) ) )
  25 mulcan |- ( ( X e. CC /\ Y e. CC /\ ( K e. CC /\ K =/= 0 ) ) -> ( ( K x. X ) = ( K x. Y ) <-> X
      = Y ) )
  26 syl3anc 9 13 6 25 |- ( ( ( X e. CC /\ Y e. CC /\ Z e. CC ) /\ ( K e. CC /\ K =/= 0 ) ) -> ( ( K
      x. X ) = ( K x. Y ) <-> X = Y ) )
  27 sylibd 24 26 |- ( ( ( X e. CC /\ Y e. CC /\ Z e. CC ) /\ ( K e. CC /\ K =/= 0 ) ) -> ( ( Z - (
      2 x. ( K x. X ) ) ) = ( Z - ( 2 x. ( K x. Y ) ) ) -> X = Y ) )

# Two laws of cosines with the same sides say the same cosine.
#
# Both sides of the comparison have the shape Z − 2(K·X), where Z is the
# two squares added and K the two sides multiplied. What is wanted is X, so
# Z comes off by `subcan` and the two factors by `mulcan`. K is a product of
# two lengths and is nonzero because neither vertex meets the one the angle
# sits at.
lemma gangeq
  |- ( ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) /\ ( ( C e. CC /\ C =/= 0 ) /\ ( D e.
      CC /\ D =/= 0 ) ) ) -> ( ( cos ` ( abs ` ( A ang B ) ) ) = ( cos ` ( abs ` ( C ang D ) ) ) ->
      ( abs ` ( A ang B ) ) = ( abs ` ( C ang D ) ) ) )
  1 simpl |- ( ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) /\ ( ( C e. CC /\ C =/= 0 ) /\
      ( D e. CC /\ D =/= 0 ) ) ) -> ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) )
  2 gangrange |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> ( abs ` ( A ang B ) ) e.
      ( 0 [,] _pi ) )
  3 syl 1 2 |- ( ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) /\ ( ( C e. CC /\ C =/= 0 )
      /\ ( D e. CC /\ D =/= 0 ) ) ) -> ( abs ` ( A ang B ) ) e. ( 0 [,] _pi ) )
  4 simpr |- ( ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) /\ ( ( C e. CC /\ C =/= 0 ) /\
      ( D e. CC /\ D =/= 0 ) ) ) -> ( ( C e. CC /\ C =/= 0 ) /\ ( D e. CC /\ D =/= 0 ) ) )
  5 gangrange |- ( ( ( C e. CC /\ C =/= 0 ) /\ ( D e. CC /\ D =/= 0 ) ) -> ( abs ` ( C ang D ) ) e.
      ( 0 [,] _pi ) )
  6 syl 4 5 |- ( ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) /\ ( ( C e. CC /\ C =/= 0 )
      /\ ( D e. CC /\ D =/= 0 ) ) ) -> ( abs ` ( C ang D ) ) e. ( 0 [,] _pi ) )
  7 cos11 |- ( ( ( abs ` ( A ang B ) ) e. ( 0 [,] _pi ) /\ ( abs ` ( C ang D ) ) e. ( 0 [,] _pi ) )
      -> ( ( abs ` ( A ang B ) ) = ( abs ` ( C ang D ) ) <-> ( cos ` ( abs ` ( A ang B ) ) ) = ( cos
      ` ( abs ` ( C ang D ) ) ) ) )
  8 syl2anc 3 6 7 |- ( ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) /\ ( ( C e. CC /\ C
      =/= 0 ) /\ ( D e. CC /\ D =/= 0 ) ) ) -> ( ( abs ` ( A ang B ) ) = ( abs ` ( C ang D ) ) <-> (
      cos ` ( abs ` ( A ang B ) ) ) = ( cos ` ( abs ` ( C ang D ) ) ) ) )
  9 biimprd 8 |- ( ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) /\ ( ( C e. CC /\ C =/= 0
      ) /\ ( D e. CC /\ D =/= 0 ) ) ) -> ( ( cos ` ( abs ` ( A ang B ) ) ) = ( cos ` ( abs ` ( C ang
      D ) ) ) -> ( abs ` ( A ang B ) ) = ( abs ` ( C ang D ) ) ) )

# Two sides and the angle between them fix the triangle.
#
# An axiom in Euclid and in Hilbert, because a synthetic geometry has no
# coordinates to compute with and congruence has to be stipulated. Over CC
# it is a theorem, and this is the proof: the law of cosines at each of the
# three vertices, six applications in all, which are three cyclic rotations
# of `glawcos` in each triangle.
#
# The third side comes first, from the law at the given angle's vertex,
# since equal sides and equal cosines make equal squares and a length is
# not negative. With all three sides equal the other two angles follow the
# other way round: the law at each of the remaining vertices has the same
# sides on both sides of the comparison, so `gcoscan` leaves the cosines
# equal and `gangeq` turns that back into the angles.
lemma gsas
  |- ( ( ( P e. CC /\ Q e. CC /\ R e. CC ) /\ ( S e. CC /\ T e. CC /\ U e. CC ) ) -> ( ( ( ( -. P =
      Q /\ -. Q = R ) /\ -. P = R ) /\ -. ( ( R - P ) / ( Q - P ) ) e. RR ) -> ( ( ( ( -. S = T /\
      -. T = U ) /\ -. S = U ) /\ -. ( ( U - S ) / ( T - S ) ) e. RR ) -> ( ( abs ` ( P - Q ) ) = (
      abs ` ( S - T ) ) -> ( ( abs ` ( ( P - Q ) ang ( R - Q ) ) ) = ( abs ` ( ( S - T ) ang ( U - T
      ) ) ) -> ( ( abs ` ( Q - R ) ) = ( abs ` ( T - U ) ) -> ( ( ( ( ( ( abs ` ( P - Q ) ) = ( abs
      ` ( S - T ) ) /\ ( abs ` ( Q - R ) ) = ( abs ` ( T - U ) ) ) /\ ( abs ` ( R - P ) ) = ( abs `
      ( U - S ) ) ) /\ ( abs ` ( ( P - Q ) ang ( R - Q ) ) ) = ( abs ` ( ( S - T ) ang ( U - T ) ) )
      ) /\ ( abs ` ( ( Q - R ) ang ( P - R ) ) ) = ( abs ` ( ( T - U ) ang ( S - U ) ) ) ) /\ ( abs
      ` ( ( R - P ) ang ( Q - P ) ) ) = ( abs ` ( ( U - S ) ang ( T - S ) ) ) ) ) ) ) ) ) )
  1 simpr |- ( ( ( ( ( ( P e. CC /\ Q e. CC /\ R e. CC ) /\ ( S e. CC /\ T e. CC /\ U e. CC ) ) /\ (
      ( ( -. P = Q /\ -. Q = R ) /\ -. P = R ) /\ -. ( ( R - P ) / ( Q - P ) ) e. RR ) ) /\ ( ( ( -.
      S = T /\ -. T = U ) /\ -. S = U ) /\ -. ( ( U - S ) / ( T - S ) ) e. RR ) ) /\ ( abs ` ( P - Q
      ) ) = ( abs ` ( S - T ) ) ) -> ( abs ` ( P - Q ) ) = ( abs ` ( S - T ) ) )
  2 adantr 1 |- ( ( ( ( ( ( ( P e. CC /\ Q e. CC /\ R e. CC ) /\ ( S e. CC /\ T e. CC /\ U e. CC ) )
      /\ ( ( ( -. P = Q /\ -. Q = R ) /\ -. P = R ) /\ -. ( ( R - P ) / ( Q - P ) ) e. RR ) ) /\ ( (
      ( -. S = T /\ -. T = U ) /\ -. S = U ) /\ -. ( ( U - S ) / ( T - S ) ) e. RR ) ) /\ ( abs ` (
      P - Q ) ) = ( abs ` ( S - T ) ) ) /\ ( abs ` ( ( P - Q ) ang ( R - Q ) ) ) = ( abs ` ( ( S - T
      ) ang ( U - T ) ) ) ) -> ( abs ` ( P - Q ) ) = ( abs ` ( S - T ) ) )
  3 adantr 2 |- ( ( ( ( ( ( ( ( P e. CC /\ Q e. CC /\ R e. CC ) /\ ( S e. CC /\ T e. CC /\ U e. CC )
      ) /\ ( ( ( -. P = Q /\ -. Q = R ) /\ -. P = R ) /\ -. ( ( R - P ) / ( Q - P ) ) e. RR ) ) /\ (
      ( ( -. S = T /\ -. T = U ) /\ -. S = U ) /\ -. ( ( U - S ) / ( T - S ) ) e. RR ) ) /\ ( abs `
      ( P - Q ) ) = ( abs ` ( S - T ) ) ) /\ ( abs ` ( ( P - Q ) ang ( R - Q ) ) ) = ( abs ` ( ( S -
      T ) ang ( U - T ) ) ) ) /\ ( abs ` ( Q - R ) ) = ( abs ` ( T - U ) ) ) -> ( abs ` ( P - Q ) )
      = ( abs ` ( S - T ) ) )
  4 simpr |- ( ( ( ( ( ( ( ( P e. CC /\ Q e. CC /\ R e. CC ) /\ ( S e. CC /\ T e. CC /\ U e. CC ) )
      /\ ( ( ( -. P = Q /\ -. Q = R ) /\ -. P = R ) /\ -. ( ( R - P ) / ( Q - P ) ) e. RR ) ) /\ ( (
      ( -. S = T /\ -. T = U ) /\ -. S = U ) /\ -. ( ( U - S ) / ( T - S ) ) e. RR ) ) /\ ( abs ` (
      P - Q ) ) = ( abs ` ( S - T ) ) ) /\ ( abs ` ( ( P - Q ) ang ( R - Q ) ) ) = ( abs ` ( ( S - T
      ) ang ( U - T ) ) ) ) /\ ( abs ` ( Q - R ) ) = ( abs ` ( T - U ) ) ) -> ( abs ` ( Q - R ) ) =
      ( abs ` ( T - U ) ) )
  5 oveq1d 3 |- ( ( ( ( ( ( ( ( P e. CC /\ Q e. CC /\ R e. CC ) /\ ( S e. CC /\ T e. CC /\ U e. CC )
      ) /\ ( ( ( -. P = Q /\ -. Q = R ) /\ -. P = R ) /\ -. ( ( R - P ) / ( Q - P ) ) e. RR ) ) /\ (
      ( ( -. S = T /\ -. T = U ) /\ -. S = U ) /\ -. ( ( U - S ) / ( T - S ) ) e. RR ) ) /\ ( abs `
      ( P - Q ) ) = ( abs ` ( S - T ) ) ) /\ ( abs ` ( ( P - Q ) ang ( R - Q ) ) ) = ( abs ` ( ( S -
      T ) ang ( U - T ) ) ) ) /\ ( abs ` ( Q - R ) ) = ( abs ` ( T - U ) ) ) -> ( ( abs ` ( P - Q )
      ) ^ 2 ) = ( ( abs ` ( S - T ) ) ^ 2 ) )
  6 oveq1d 4 |- ( ( ( ( ( ( ( ( P e. CC /\ Q e. CC /\ R e. CC ) /\ ( S e. CC /\ T e. CC /\ U e. CC )
      ) /\ ( ( ( -. P = Q /\ -. Q = R ) /\ -. P = R ) /\ -. ( ( R - P ) / ( Q - P ) ) e. RR ) ) /\ (
      ( ( -. S = T /\ -. T = U ) /\ -. S = U ) /\ -. ( ( U - S ) / ( T - S ) ) e. RR ) ) /\ ( abs `
      ( P - Q ) ) = ( abs ` ( S - T ) ) ) /\ ( abs ` ( ( P - Q ) ang ( R - Q ) ) ) = ( abs ` ( ( S -
      T ) ang ( U - T ) ) ) ) /\ ( abs ` ( Q - R ) ) = ( abs ` ( T - U ) ) ) -> ( ( abs ` ( Q - R )
      ) ^ 2 ) = ( ( abs ` ( T - U ) ) ^ 2 ) )
  7 oveq12d 5 6 |- ( ( ( ( ( ( ( ( P e. CC /\ Q e. CC /\ R e. CC ) /\ ( S e. CC /\ T e. CC /\ U e.
      CC ) ) /\ ( ( ( -. P = Q /\ -. Q = R ) /\ -. P = R ) /\ -. ( ( R - P ) / ( Q - P ) ) e. RR ) )
      /\ ( ( ( -. S = T /\ -. T = U ) /\ -. S = U ) /\ -. ( ( U - S ) / ( T - S ) ) e. RR ) ) /\ (
      abs ` ( P - Q ) ) = ( abs ` ( S - T ) ) ) /\ ( abs ` ( ( P - Q ) ang ( R - Q ) ) ) = ( abs ` (
      ( S - T ) ang ( U - T ) ) ) ) /\ ( abs ` ( Q - R ) ) = ( abs ` ( T - U ) ) ) -> ( ( ( abs ` (
      P - Q ) ) ^ 2 ) + ( ( abs ` ( Q - R ) ) ^ 2 ) ) = ( ( ( abs ` ( S - T ) ) ^ 2 ) + ( ( abs ` (
      T - U ) ) ^ 2 ) ) )
  8 oveq12d 3 4 |- ( ( ( ( ( ( ( ( P e. CC /\ Q e. CC /\ R e. CC ) /\ ( S e. CC /\ T e. CC /\ U e.
      CC ) ) /\ ( ( ( -. P = Q /\ -. Q = R ) /\ -. P = R ) /\ -. ( ( R - P ) / ( Q - P ) ) e. RR ) )
      /\ ( ( ( -. S = T /\ -. T = U ) /\ -. S = U ) /\ -. ( ( U - S ) / ( T - S ) ) e. RR ) ) /\ (
      abs ` ( P - Q ) ) = ( abs ` ( S - T ) ) ) /\ ( abs ` ( ( P - Q ) ang ( R - Q ) ) ) = ( abs ` (
      ( S - T ) ang ( U - T ) ) ) ) /\ ( abs ` ( Q - R ) ) = ( abs ` ( T - U ) ) ) -> ( ( abs ` ( P
      - Q ) ) x. ( abs ` ( Q - R ) ) ) = ( ( abs ` ( S - T ) ) x. ( abs ` ( T - U ) ) ) )
  9 simpr |- ( ( ( ( ( ( ( P e. CC /\ Q e. CC /\ R e. CC ) /\ ( S e. CC /\ T e. CC /\ U e. CC ) ) /\
      ( ( ( -. P = Q /\ -. Q = R ) /\ -. P = R ) /\ -. ( ( R - P ) / ( Q - P ) ) e. RR ) ) /\ ( ( (
      -. S = T /\ -. T = U ) /\ -. S = U ) /\ -. ( ( U - S ) / ( T - S ) ) e. RR ) ) /\ ( abs ` ( P
      - Q ) ) = ( abs ` ( S - T ) ) ) /\ ( abs ` ( ( P - Q ) ang ( R - Q ) ) ) = ( abs ` ( ( S - T )
      ang ( U - T ) ) ) ) -> ( abs ` ( ( P - Q ) ang ( R - Q ) ) ) = ( abs ` ( ( S - T ) ang ( U - T
      ) ) ) )
  10 adantr 9 |- ( ( ( ( ( ( ( ( P e. CC /\ Q e. CC /\ R e. CC ) /\ ( S e. CC /\ T e. CC /\ U e. CC
      ) ) /\ ( ( ( -. P = Q /\ -. Q = R ) /\ -. P = R ) /\ -. ( ( R - P ) / ( Q - P ) ) e. RR ) ) /\
      ( ( ( -. S = T /\ -. T = U ) /\ -. S = U ) /\ -. ( ( U - S ) / ( T - S ) ) e. RR ) ) /\ ( abs
      ` ( P - Q ) ) = ( abs ` ( S - T ) ) ) /\ ( abs ` ( ( P - Q ) ang ( R - Q ) ) ) = ( abs ` ( ( S
      - T ) ang ( U - T ) ) ) ) /\ ( abs ` ( Q - R ) ) = ( abs ` ( T - U ) ) ) -> ( abs ` ( ( P - Q
      ) ang ( R - Q ) ) ) = ( abs ` ( ( S - T ) ang ( U - T ) ) ) )
  11 fveq2d 10 |- ( ( ( ( ( ( ( ( P e. CC /\ Q e. CC /\ R e. CC ) /\ ( S e. CC /\ T e. CC /\ U e. CC
      ) ) /\ ( ( ( -. P = Q /\ -. Q = R ) /\ -. P = R ) /\ -. ( ( R - P ) / ( Q - P ) ) e. RR ) ) /\
      ( ( ( -. S = T /\ -. T = U ) /\ -. S = U ) /\ -. ( ( U - S ) / ( T - S ) ) e. RR ) ) /\ ( abs
      ` ( P - Q ) ) = ( abs ` ( S - T ) ) ) /\ ( abs ` ( ( P - Q ) ang ( R - Q ) ) ) = ( abs ` ( ( S
      - T ) ang ( U - T ) ) ) ) /\ ( abs ` ( Q - R ) ) = ( abs ` ( T - U ) ) ) -> ( cos ` ( abs ` (
      ( P - Q ) ang ( R - Q ) ) ) ) = ( cos ` ( abs ` ( ( S - T ) ang ( U - T ) ) ) ) )
  12 oveq12d 8 11 |- ( ( ( ( ( ( ( ( P e. CC /\ Q e. CC /\ R e. CC ) /\ ( S e. CC /\ T e. CC /\ U e.
      CC ) ) /\ ( ( ( -. P = Q /\ -. Q = R ) /\ -. P = R ) /\ -. ( ( R - P ) / ( Q - P ) ) e. RR ) )
      /\ ( ( ( -. S = T /\ -. T = U ) /\ -. S = U ) /\ -. ( ( U - S ) / ( T - S ) ) e. RR ) ) /\ (
