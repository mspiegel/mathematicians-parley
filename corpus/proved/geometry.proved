      RR+ ) -> ( -u ( B / A ) e. RR+ <-> ( Im ` ( log ` ( B / A ) ) ) = _pi ) )
  16 mpbid 1 15 |- ( ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) /\ -u ( B / A ) e. RR+ )
      -> ( Im ` ( log ` ( B / A ) ) ) = _pi )
  17 fveq2d 16 |- ( ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) /\ -u ( B / A ) e. RR+ )
      -> ( abs ` ( Im ` ( log ` ( B / A ) ) ) ) = ( abs ` _pi ) )
  18 ax-1cn |- 1 e. CC
  19 a1i 18 |- ( ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) /\ -u ( B / A ) e. RR+ ) ->
