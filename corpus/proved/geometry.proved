      ( abs ` ( Im ` ( log ` ( 1 / ( B / A ) ) ) ) ) )
  60 3eqtr4d 47 50 59 |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> ( abs ` ( A ang B
      ) ) = ( abs ` ( B ang A ) ) )

# The angle from A to B and the angle from B to A have one size.
#
# `ang` is signed and lands in −pi to pi, so the two are not equal; the
# corpus writes the unsigned angle, which is this one's absolute value, and
# those do agree. Off the branch cut that is `arginv`, which says the signed
# angle of an inverse is the negative of the angle. On the cut `arginv`
# does not apply and nothing is negated: `lognegb` says a number whose
# negative is a positive real has angle pi exactly, and the inverse of such
# a number is another, so both angles are pi.
lemma gangsym3
  |- ( ( A e. CC /\ B e. CC /\ C e. CC ) -> ( ( -. A = B /\ -. C = B ) -> ( abs ` ( ( A - B ) ang (
      C - B ) ) ) = ( abs ` ( ( C - B ) ang ( A - B ) ) ) ) )
  1 simp1 |- ( ( A e. CC /\ B e. CC /\ C e. CC ) -> A e. CC )
  2 adantr 1 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( -. A = B /\ -. C = B ) ) -> A e. CC )
  3 simp2 |- ( ( A e. CC /\ B e. CC /\ C e. CC ) -> B e. CC )
  4 adantr 3 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( -. A = B /\ -. C = B ) ) -> B e. CC )
  5 subcld 2 4 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( -. A = B /\ -. C = B ) ) -> ( A - B )
      e. CC )
  6 simpl |- ( ( -. A = B /\ -. C = B ) -> -. A = B )
  7 adantl 6 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( -. A = B /\ -. C = B ) ) -> -. A = B )
  8 neqned 7 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( -. A = B /\ -. C = B ) ) -> A =/= B )
  9 subeq0ad 2 4 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( -. A = B /\ -. C = B ) ) -> ( ( A - B
      ) = 0 <-> A = B ) )
  10 necon3bid 9 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( -. A = B /\ -. C = B ) ) -> ( ( A - B
      ) =/= 0 <-> A =/= B ) )
  11 mpbird 8 10 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( -. A = B /\ -. C = B ) ) -> ( A - B )
      =/= 0 )
  12 jca 5 11 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( -. A = B /\ -. C = B ) ) -> ( ( A - B )
      e. CC /\ ( A - B ) =/= 0 ) )
  13 simp3 |- ( ( A e. CC /\ B e. CC /\ C e. CC ) -> C e. CC )
  14 adantr 13 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( -. A = B /\ -. C = B ) ) -> C e. CC )
  15 subcld 14 4 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( -. A = B /\ -. C = B ) ) -> ( C - B )
      e. CC )
  16 simpr |- ( ( -. A = B /\ -. C = B ) -> -. C = B )
  17 adantl 16 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( -. A = B /\ -. C = B ) ) -> -. C = B )
  18 neqned 17 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( -. A = B /\ -. C = B ) ) -> C =/= B )
  19 subeq0ad 14 4 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( -. A = B /\ -. C = B ) ) -> ( ( C -
      B ) = 0 <-> C = B ) )
  20 necon3bid 19 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( -. A = B /\ -. C = B ) ) -> ( ( C -
      B ) =/= 0 <-> C =/= B ) )
  21 mpbird 18 20 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( -. A = B /\ -. C = B ) ) -> ( C - B
      ) =/= 0 )
  22 jca 15 21 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( -. A = B /\ -. C = B ) ) -> ( ( C - B )
      e. CC /\ ( C - B ) =/= 0 ) )
  23 jca 12 22 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( -. A = B /\ -. C = B ) ) -> ( ( ( A - B
      ) e. CC /\ ( A - B ) =/= 0 ) /\ ( ( C - B ) e. CC /\ ( C - B ) =/= 0 ) ) )
  24 gangsym |- ( ( ( ( A - B ) e. CC /\ ( A - B ) =/= 0 ) /\ ( ( C - B ) e. CC /\ ( C - B ) =/= 0 )
      ) -> ( abs ` ( ( A - B ) ang ( C - B ) ) ) = ( abs ` ( ( C - B ) ang ( A - B ) ) ) )
  25 syl 23 24 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( -. A = B /\ -. C = B ) ) -> ( abs ` ( (
      A - B ) ang ( C - B ) ) ) = ( abs ` ( ( C - B ) ang ( A - B ) ) ) )
  26 ex 25 |- ( ( A e. CC /\ B e. CC /\ C e. CC ) -> ( ( -. A = B /\ -. C = B ) -> ( abs ` ( ( A - B
      ) ang ( C - B ) ) ) = ( abs ` ( ( C - B ) ang ( A - B ) ) ) ) )

# Where the unsigned angle lives, and what cosine makes of it.
#
# Two facts the law of cosines needs. `lawcos` states itself with the
# signed angle, and the corpus writes the unsigned one, so a step that
# carries an angle between the two has to know that cosine cannot tell them
# apart, and that going back is possible because cosine is one to one on
# the range the unsigned angle occupies.
lemma gcosabs
  |- ( A e. RR -> ( cos ` ( abs ` A ) ) = ( cos ` A ) )
  1 0re |- 0 e. RR
  2 a1i 1 |- ( A e. RR -> 0 e. RR )
  3 id |- ( A e. RR -> A e. RR )
  4 absid |- ( ( A e. RR /\ 0 <_ A ) -> ( abs ` A ) = A )
  5 fveq2d 4 |- ( ( A e. RR /\ 0 <_ A ) -> ( cos ` ( abs ` A ) ) = ( cos ` A ) )
  6 absnid |- ( ( A e. RR /\ A <_ 0 ) -> ( abs ` A ) = -u A )
  7 fveq2d 6 |- ( ( A e. RR /\ A <_ 0 ) -> ( cos ` ( abs ` A ) ) = ( cos ` -u A ) )
  8 simpl |- ( ( A e. RR /\ A <_ 0 ) -> A e. RR )
  9 recnd 8 |- ( ( A e. RR /\ A <_ 0 ) -> A e. CC )
  10 cosneg |- ( A e. CC -> ( cos ` -u A ) = ( cos ` A ) )
  11 syl 9 10 |- ( ( A e. RR /\ A <_ 0 ) -> ( cos ` -u A ) = ( cos ` A ) )
  12 eqtrd 7 11 |- ( ( A e. RR /\ A <_ 0 ) -> ( cos ` ( abs ` A ) ) = ( cos ` A ) )
  13 lecasei 2 3 5 12 |- ( A e. RR -> ( cos ` ( abs ` A ) ) = ( cos ` A ) )

# Where the unsigned angle lives, and what cosine makes of it.
#
# Two facts the law of cosines needs. `lawcos` states itself with the
# signed angle, and the corpus writes the unsigned one, so a step that
# carries an angle between the two has to know that cosine cannot tell them
# apart, and that going back is possible because cosine is one to one on
# the range the unsigned angle occupies.
lemma gangrange
  |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> ( abs ` ( A ang B ) ) e. ( 0 [,] _pi
      ) )
  1 gangval |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> ( A ang B ) = ( Im ` ( log
      ` ( B / A ) ) ) )
  2 fveq2d 1 |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> ( abs ` ( A ang B ) ) = (
      abs ` ( Im ` ( log ` ( B / A ) ) ) ) )
  3 simpr |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> ( B e. CC /\ B =/= 0 ) )
  4 simpld 3 |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> B e. CC )
  5 simpl |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> ( A e. CC /\ A =/= 0 ) )
  6 simpld 5 |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> A e. CC )
  7 simprd 5 |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> A =/= 0 )
  8 divcl |- ( ( B e. CC /\ A e. CC /\ A =/= 0 ) -> ( B / A ) e. CC )
  9 syl3anc 4 6 7 8 |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> ( B / A ) e. CC )
  10 jca 3 5 |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> ( ( B e. CC /\ B =/= 0 )
      /\ ( A e. CC /\ A =/= 0 ) ) )
  11 divne0 |- ( ( ( B e. CC /\ B =/= 0 ) /\ ( A e. CC /\ A =/= 0 ) ) -> ( B / A ) =/= 0 )
  12 syl 10 11 |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> ( B / A ) =/= 0 )
  13 logcld 9 12 |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> ( log ` ( B / A ) ) e.
      CC )
  14 imcld 13 |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> ( Im ` ( log ` ( B / A )
      ) ) e. RR )
  15 recnd 14 |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> ( Im ` ( log ` ( B / A )
      ) ) e. CC )
  16 abscl |- ( ( Im ` ( log ` ( B / A ) ) ) e. CC -> ( abs ` ( Im ` ( log ` ( B / A ) ) ) ) e. RR )
  17 syl 15 16 |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> ( abs ` ( Im ` ( log ` (
      B / A ) ) ) ) e. RR )
  18 absge0 |- ( ( Im ` ( log ` ( B / A ) ) ) e. CC -> 0 <_ ( abs ` ( Im ` ( log ` ( B / A ) ) ) ) )
  19 syl 15 18 |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> 0 <_ ( abs ` ( Im ` (
      log ` ( B / A ) ) ) ) )
  20 pire |- _pi e. RR
  21 renegcl |- ( _pi e. RR -> -u _pi e. RR )
  22 ax-mp 20 21 |- -u _pi e. RR
  23 a1i 22 |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> -u _pi e. RR )
  24 logimcl |- ( ( ( B / A ) e. CC /\ ( B / A ) =/= 0 ) -> ( -u _pi < ( Im ` ( log ` ( B / A ) ) )
      /\ ( Im ` ( log ` ( B / A ) ) ) <_ _pi ) )
  25 syl2anc 9 12 24 |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> ( -u _pi < ( Im `
      ( log ` ( B / A ) ) ) /\ ( Im ` ( log ` ( B / A ) ) ) <_ _pi ) )
  26 simpld 25 |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> -u _pi < ( Im ` ( log `
      ( B / A ) ) ) )
  27 ltled 23 14 26 |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> -u _pi <_ ( Im ` (
      log ` ( B / A ) ) ) )
  28 simprd 25 |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> ( Im ` ( log ` ( B / A )
      ) ) <_ _pi )
  29 a1i 20 |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> _pi e. RR )
  30 absle |- ( ( ( Im ` ( log ` ( B / A ) ) ) e. RR /\ _pi e. RR ) -> ( ( abs ` ( Im ` ( log ` ( B
      / A ) ) ) ) <_ _pi <-> ( -u _pi <_ ( Im ` ( log ` ( B / A ) ) ) /\ ( Im ` ( log ` ( B / A ) )
      ) <_ _pi ) ) )
  31 syl2anc 14 29 30 |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> ( ( abs ` ( Im `
      ( log ` ( B / A ) ) ) ) <_ _pi <-> ( -u _pi <_ ( Im ` ( log ` ( B / A ) ) ) /\ ( Im ` ( log `
      ( B / A ) ) ) <_ _pi ) ) )
  32 mpbir2and 27 28 31 |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> ( abs ` ( Im `
      ( log ` ( B / A ) ) ) ) <_ _pi )
  33 0re |- 0 e. RR
  34 a1i 33 |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> 0 e. RR )
  35 elicc2 |- ( ( 0 e. RR /\ _pi e. RR ) -> ( ( abs ` ( Im ` ( log ` ( B / A ) ) ) ) e. ( 0 [,] _pi
      ) <-> ( ( abs ` ( Im ` ( log ` ( B / A ) ) ) ) e. RR /\ 0 <_ ( abs ` ( Im ` ( log ` ( B / A )
      ) ) ) /\ ( abs ` ( Im ` ( log ` ( B / A ) ) ) ) <_ _pi ) ) )
  36 syl2anc 34 29 35 |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> ( ( abs ` ( Im `
      ( log ` ( B / A ) ) ) ) e. ( 0 [,] _pi ) <-> ( ( abs ` ( Im ` ( log ` ( B / A ) ) ) ) e. RR /\
      0 <_ ( abs ` ( Im ` ( log ` ( B / A ) ) ) ) /\ ( abs ` ( Im ` ( log ` ( B / A ) ) ) ) <_ _pi )
      ) )
  37 mpbir3and 17 19 32 36 |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> ( abs ` ( Im
      ` ( log ` ( B / A ) ) ) ) e. ( 0 [,] _pi ) )
  38 eqeltrd 2 37 |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> ( abs ` ( A ang B ) )
      e. ( 0 [,] _pi ) )

# The unsigned angle on three points is real and at least 0.
#
# What `mun:stdlib/geometry/angle-real` says, stated as the corpus states an
# angle: at B, between the two differences, B apart from the other two. It
# is the first two of the three things `gangrange` says, read off the
# closed interval by `elicc2`.
lemma gangbnd3
  |- ( ( A e. CC /\ B e. CC /\ C e. CC ) -> ( ( -. A = B /\ -. C = B ) -> ( ( abs ` ( ( A - B ) ang
      ( C - B ) ) ) e. RR /\ 0 <_ ( abs ` ( ( A - B ) ang ( C - B ) ) ) ) ) )
  1 simp1 |- ( ( A e. CC /\ B e. CC /\ C e. CC ) -> A e. CC )
  2 adantr 1 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( -. A = B /\ -. C = B ) ) -> A e. CC )
  3 simp2 |- ( ( A e. CC /\ B e. CC /\ C e. CC ) -> B e. CC )
  4 adantr 3 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( -. A = B /\ -. C = B ) ) -> B e. CC )
  5 subcld 2 4 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( -. A = B /\ -. C = B ) ) -> ( A - B )
      e. CC )
  6 simpl |- ( ( -. A = B /\ -. C = B ) -> -. A = B )
  7 adantl 6 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( -. A = B /\ -. C = B ) ) -> -. A = B )
  8 neqned 7 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( -. A = B /\ -. C = B ) ) -> A =/= B )
  9 subeq0ad 2 4 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( -. A = B /\ -. C = B ) ) -> ( ( A - B
      ) = 0 <-> A = B ) )
  10 necon3bid 9 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( -. A = B /\ -. C = B ) ) -> ( ( A - B
      ) =/= 0 <-> A =/= B ) )
  11 mpbird 8 10 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( -. A = B /\ -. C = B ) ) -> ( A - B )
      =/= 0 )
  12 jca 5 11 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( -. A = B /\ -. C = B ) ) -> ( ( A - B )
      e. CC /\ ( A - B ) =/= 0 ) )
  13 simp3 |- ( ( A e. CC /\ B e. CC /\ C e. CC ) -> C e. CC )
  14 adantr 13 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( -. A = B /\ -. C = B ) ) -> C e. CC )
  15 subcld 14 4 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( -. A = B /\ -. C = B ) ) -> ( C - B )
      e. CC )
  16 simpr |- ( ( -. A = B /\ -. C = B ) -> -. C = B )
  17 adantl 16 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( -. A = B /\ -. C = B ) ) -> -. C = B )
  18 neqned 17 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( -. A = B /\ -. C = B ) ) -> C =/= B )
  19 subeq0ad 14 4 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( -. A = B /\ -. C = B ) ) -> ( ( C -
      B ) = 0 <-> C = B ) )
  20 necon3bid 19 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( -. A = B /\ -. C = B ) ) -> ( ( C -
      B ) =/= 0 <-> C =/= B ) )
  21 mpbird 18 20 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( -. A = B /\ -. C = B ) ) -> ( C - B
      ) =/= 0 )
  22 jca 15 21 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( -. A = B /\ -. C = B ) ) -> ( ( C - B )
      e. CC /\ ( C - B ) =/= 0 ) )
  23 jca 12 22 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( -. A = B /\ -. C = B ) ) -> ( ( ( A - B
      ) e. CC /\ ( A - B ) =/= 0 ) /\ ( ( C - B ) e. CC /\ ( C - B ) =/= 0 ) ) )
  24 gangrange |- ( ( ( ( A - B ) e. CC /\ ( A - B ) =/= 0 ) /\ ( ( C - B ) e. CC /\ ( C - B ) =/= 0
      ) ) -> ( abs ` ( ( A - B ) ang ( C - B ) ) ) e. ( 0 [,] _pi ) )
  25 syl 23 24 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( -. A = B /\ -. C = B ) ) -> ( abs ` ( (
      A - B ) ang ( C - B ) ) ) e. ( 0 [,] _pi ) )
  26 0re |- 0 e. RR
  27 a1i 26 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( -. A = B /\ -. C = B ) ) -> 0 e. RR )
  28 pire |- _pi e. RR
  29 a1i 28 |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( -. A = B /\ -. C = B ) ) -> _pi e. RR )
  30 elicc2 |- ( ( 0 e. RR /\ _pi e. RR ) -> ( ( abs ` ( ( A - B ) ang ( C - B ) ) ) e. ( 0 [,] _pi
