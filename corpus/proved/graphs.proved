# {0 + 1, …, (n − 1) + 1} is {1, …, n}: `0p1e1` and `npcan`.
lemma gtravfz
  |- ( n e. ZZ -> ( ( 0 + 1 ) ... ( ( n - 1 ) + 1 ) ) = ( 1 ... n ) )
  1 0p1e1 |- ( 0 + 1 ) = 1
  2 a1i 1 |- ( n e. ZZ -> ( 0 + 1 ) = 1 )
  3 zcn |- ( n e. ZZ -> n e. CC )
  4 1cnd |- ( n e. ZZ -> 1 e. CC )
  5 npcan |- ( ( n e. CC /\ 1 e. CC ) -> ( ( n - 1 ) + 1 ) = n )
  6 syl2anc 3 4 5 |- ( n e. ZZ -> ( ( n - 1 ) + 1 ) = n )
  7 oveq12d 2 6 |- ( n e. ZZ -> ( ( 0 + 1 ) ... ( ( n - 1 ) + 1 ) ) = ( 1 ... n ) )

