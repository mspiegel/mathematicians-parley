  7 gtravfz |- ( n e. ZZ -> ( ( 0 + 1 ) ... ( ( n - 1 ) + 1 ) ) = ( 1 ... n ) )
  8 syl 1 7 |- ( n e. NN0 -> ( ( 0 + 1 ) ... ( ( n - 1 ) + 1 ) ) = ( 1 ... n ) )
  9 mpteq1d 8 |- ( n e. NN0 -> ( i e. ( ( 0 + 1 ) ... ( ( n - 1 ) + 1 ) ) |-> ( i - 1 ) ) = ( i e. ( 1 ... n ) |-> ( i - 1 ) ) )
