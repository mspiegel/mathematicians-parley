# Graphs, for `proved.mm`.
#
# The page says an edge a joins u and w, which set.mm says as the ends
# `iEdg` gives a being the pair: ( ( iEdg ` G ) ` A ) = { U , W }. A vertex is
# an end of a when it is in that pair.
#
# - each of u and w is an end of a: `prid1g` and `prid2g`, carried to the
#   ends by the equation, for `mun:stdlib/graphs/joined-end`;
# - a vertex that is neither is not an end: `elpri` says a member of the
#   pair is one of the two, for `mun:stdlib/graphs/not-an-end`;
# - the two ends are different: `umgrnloopv`, a multigraph having no edge
#   from a vertex to itself, for `mun:stdlib/graphs/join-distinct`;
# - a vertex is an end of a exactly when it is u or w: `elprg` at the pair,
#   for `mun:stdlib/graphs/ends-of-joined`;
# - each edge of a walk joins the vertices on either side of it: `rspcv`
#   at its place, for `mun:stdlib/graphs/walk-step`;
# - a walk never stays at a vertex: the edge at a place joins two different
#   vertices, by `umgrnloopv`, for `mun:stdlib/graphs/walk-distinct`;
# - the degree of a vertex is the number of edges it is an end of:
#   `vtxdumgrval`, for `mun:stdlib/graphs/degree`;
# - a multigraph is traversable exactly when there is n and a walk f of n
#   edges, counted from 0, one-to-one and reaching every edge, with vertices
#   v: `iseupthf1o` and `upgriswlk`, the word of edges read as a function on
#   {0, …, n − 1} by `wrdmap` and `fzoval`;
# - and exactly when there is such a walk e with its edges counted from 1,
#   e(j) being f(j − 1): the shift j ↦ j − 1 takes {1, …, n} one to one
#   onto {0, …, n − 1} (`mptfzshft`), so e is f composed with it, one-to-one
#   and reaching every edge when f is (`f1oco`), and the edges join the same
#   vertices with the range of the "for all" shifted (`fzshftral`), for
#   `def:stdlib/graphs/traversable`, which counts from 1 as
#   `def:stdlib/graphs/euler-path` does.

$( Graphs: the ends of an edge of a multigraph, the degree of a vertex, and
   a graph that has an Euler path. $)
$( The degree's set-builder binds x, apart from the graph and the vertex.
   The walk's length n, its edges f, its vertices v and the letters a and k
   the page's conditions bind are kept apart from the graph and each
   other; so are the walk's edges e counted from 1, the letters y and z the
   page binds for it, and the places i and j the shift between the two
   countings runs over. $)
$d x G $.  $d x U $.
$d z F $.  $d z G $.  $d z I $.  $d z N $.  $d z P $.  $d z ph $.
$d a k n f v G $.
$d a e f i j k n v y z G $.

# ( ph -> the edge at place I joins the vertices on either side of it ),
# from a walk and I among its places: `rspcv`, the instance tied by
# `fveq2`, `oveq1` and `preq12d`.
lemma gwalkstep
  hypothesis gwalkstep.1 |- ( ph -> A. z e. ( 1 ... N ) ( ( iEdg ` G ) ` ( F ` z ) ) = { ( P ` ( z - 1 ) ) , ( P ` z ) } )
  hypothesis gwalkstep.2 |- ( ph -> I e. ( 1 ... N ) )
  |- ( ph -> ( ( iEdg ` G ) ` ( F ` I ) ) = { ( P ` ( I - 1 ) ) , ( P ` I ) } )
  1 fveq2 |- ( z = I -> ( F ` z ) = ( F ` I ) )
  2 fveq2d 1 |- ( z = I -> ( ( iEdg ` G ) ` ( F ` z ) ) = ( ( iEdg ` G ) ` ( F ` I ) ) )
  3 oveq1 |- ( z = I -> ( z - 1 ) = ( I - 1 ) )
  4 fveq2d 3 |- ( z = I -> ( P ` ( z - 1 ) ) = ( P ` ( I - 1 ) ) )
  5 fveq2 |- ( z = I -> ( P ` z ) = ( P ` I ) )
  6 preq12d 4 5 |- ( z = I -> { ( P ` ( z - 1 ) ) , ( P ` z ) } = { ( P ` ( I - 1 ) ) , ( P ` I ) } )
  7 eqeq12d 2 6 |- ( z = I -> ( ( ( iEdg ` G ) ` ( F ` z ) ) = { ( P ` ( z - 1 ) ) , ( P ` z ) } <-> ( ( iEdg ` G ) ` ( F ` I ) ) = { ( P ` ( I - 1 ) ) , ( P ` I ) } ) )
  8 rspcv 7 |- ( I e. ( 1 ... N ) -> ( A. z e. ( 1 ... N ) ( ( iEdg ` G ) ` ( F ` z ) ) = { ( P ` ( z - 1 ) ) , ( P ` z ) } -> ( ( iEdg ` G ) ` ( F ` I ) ) = { ( P ` ( I - 1 ) ) , ( P ` I ) } ) )
  9 sylc gwalkstep.2 gwalkstep.1 8 |- ( ph -> ( ( iEdg ` G ) ` ( F ` I ) ) = { ( P ` ( I - 1 ) ) , ( P ` I ) } )

# The degree of U, the edges U is an end of counted: `vtxdumgrval` with the
# graph's parts named by `eqid`.
lemma gdeg
  |- ( ( G e. UMGraph /\ U e. ( Vtx ` G ) ) -> ( ( VtxDeg ` G ) ` U ) = ( # ` { x e. dom ( iEdg ` G ) | U e. ( ( iEdg ` G ) ` x ) } ) )
  1 eqid |- ( Vtx ` G ) = ( Vtx ` G )
  2 eqid |- ( iEdg ` G ) = ( iEdg ` G )
  3 eqid |- dom ( iEdg ` G ) = dom ( iEdg ` G )
  4 eqid |- ( VtxDeg ` G ) = ( VtxDeg ` G )
  5 vtxdumgrval 1 2 3 4 |- ( ( G e. UMGraph /\ U e. ( Vtx ` G ) ) -> ( ( VtxDeg ` G ) ` U ) = ( # ` { x e. dom ( iEdg ` G ) | U e. ( ( iEdg ` G ) ` x ) } ) )

# ( ph -> U e. ( ( iEdg ` G ) ` A ) ), from the edge joining U and W.
lemma gjoinend1
  hypothesis gjoinend1.1 |- ( ph -> U e. ( Vtx ` G ) )
  hypothesis gjoinend1.2 |- ( ph -> ( ( iEdg ` G ) ` A ) = { U , W } )
  |- ( ph -> U e. ( ( iEdg ` G ) ` A ) )
  1 prid1g |- ( U e. ( Vtx ` G ) -> U e. { U , W } )
  2 syl gjoinend1.1 1 |- ( ph -> U e. { U , W } )
  3 eleqtrrd 2 gjoinend1.2 |- ( ph -> U e. ( ( iEdg ` G ) ` A ) )

# ( ph -> W e. ( ( iEdg ` G ) ` A ) ), from the edge joining U and W.
lemma gjoinend2
  hypothesis gjoinend2.1 |- ( ph -> W e. ( Vtx ` G ) )
  hypothesis gjoinend2.2 |- ( ph -> ( ( iEdg ` G ) ` A ) = { U , W } )
  |- ( ph -> W e. ( ( iEdg ` G ) ` A ) )
  1 prid2g |- ( W e. ( Vtx ` G ) -> W e. { U , W } )
  2 syl gjoinend2.1 1 |- ( ph -> W e. { U , W } )
  3 eleqtrrd 2 gjoinend2.2 |- ( ph -> W e. ( ( iEdg ` G ) ` A ) )

# ( ph -> -. X e. ( ( iEdg ` G ) ` A ) ), from the edge joining U and W and
# X being neither.
lemma gnotend
  hypothesis gnotend.1 |- ( ph -> ( ( iEdg ` G ) ` A ) = { U , W } )
  hypothesis gnotend.2 |- ( ph -> X =/= U )
  hypothesis gnotend.3 |- ( ph -> X =/= W )
  |- ( ph -> -. X e. ( ( iEdg ` G ) ` A ) )
  1 jca gnotend.2 gnotend.3 |- ( ph -> ( X =/= U /\ X =/= W ) )
  2 neanior |- ( ( X =/= U /\ X =/= W ) <-> -. ( X = U \/ X = W ) )
  3 sylib 1 2 |- ( ph -> -. ( X = U \/ X = W ) )
  4 elpri |- ( X e. { U , W } -> ( X = U \/ X = W ) )
  5 con3i 4 |- ( -. ( X = U \/ X = W ) -> -. X e. { U , W } )
  6 syl 3 5 |- ( ph -> -. X e. { U , W } )
  7 eleq2d gnotend.1 |- ( ph -> ( X e. ( ( iEdg ` G ) ` A ) <-> X e. { U , W } ) )
  8 notbid 7 |- ( ph -> ( -. X e. ( ( iEdg ` G ) ` A ) <-> -. X e. { U , W } ) )
  9 mpbird 6 8 |- ( ph -> -. X e. ( ( iEdg ` G ) ` A ) )

# ( ph -> U =/= W ), from G a multigraph and an edge joining U and W.
lemma gjoinne
  hypothesis gjoinne.1 |- ( ph -> G e. UMGraph )
  hypothesis gjoinne.2 |- ( ph -> U e. ( Vtx ` G ) )
  hypothesis gjoinne.3 |- ( ph -> ( ( iEdg ` G ) ` A ) = { U , W } )
  |- ( ph -> U =/= W )
  1 eqid |- ( iEdg ` G ) = ( iEdg ` G )
  2 umgrnloopv 1 |- ( ( G e. UMGraph /\ U e. ( Vtx ` G ) ) -> ( ( ( iEdg ` G ) ` A ) = { U , W } -> U =/= W ) )
  3 syl2anc gjoinne.1 gjoinne.2 2 |- ( ph -> ( ( ( iEdg ` G ) ` A ) = { U , W } -> U =/= W ) )
  4 mpd gjoinne.3 3 |- ( ph -> U =/= W )

# ( ph -> X is an end of A exactly when it is U or W ), from the edge
# joining U and W: the ends are the pair, and `elprg` says who is in it.
lemma gends
  hypothesis gends.1 |- ( ph -> X e. ( Vtx ` G ) )
  hypothesis gends.2 |- ( ph -> ( ( iEdg ` G ) ` A ) = { U , W } )
  |- ( ph -> ( X e. ( ( iEdg ` G ) ` A ) <-> ( X = U \/ X = W ) ) )
  1 eleq2d gends.2 |- ( ph -> ( X e. ( ( iEdg ` G ) ` A ) <-> X e. { U , W } ) )
  2 elprg |- ( X e. ( Vtx ` G ) -> ( X e. { U , W } <-> ( X = U \/ X = W ) ) )
  3 syl gends.1 2 |- ( ph -> ( X e. { U , W } <-> ( X = U \/ X = W ) ) )
  4 bitrd 1 3 |- ( ph -> ( X e. ( ( iEdg ` G ) ` A ) <-> ( X = U \/ X = W ) ) )

# ( ph -> the vertices on either side of place I differ ), from a walk in a
# multigraph: the edge at I joins them (`gwalkstep`), the one before I is a
# vertex because I − 1 is a place of v, and `gjoinne` keeps the two apart.
lemma gwalkne
  hypothesis gwalkne.1 |- ( ph -> G e. UMGraph )
  hypothesis gwalkne.2 |- ( ph -> P : ( 0 ... N ) --> ( Vtx ` G ) )
  hypothesis gwalkne.3 |- ( ph -> A. z e. ( 1 ... N ) ( ( iEdg ` G ) ` ( F ` z ) ) = { ( P ` ( z - 1 ) ) , ( P ` z ) } )
  hypothesis gwalkne.4 |- ( ph -> I e. ( 1 ... N ) )
  |- ( ph -> ( P ` ( I - 1 ) ) =/= ( P ` I ) )
  1 gwalkstep gwalkne.3 gwalkne.4 |- ( ph -> ( ( iEdg ` G ) ` ( F ` I ) ) = { ( P ` ( I - 1 ) ) , ( P ` I ) } )
  2 fz1fzo0m1 |- ( I e. ( 1 ... N ) -> ( I - 1 ) e. ( 0 ..^ N ) )
  3 syl gwalkne.4 2 |- ( ph -> ( I - 1 ) e. ( 0 ..^ N ) )
  4 fzossfz |- ( 0 ..^ N ) C_ ( 0 ... N )
  5 sselid 4 3 |- ( ph -> ( I - 1 ) e. ( 0 ... N ) )
  6 ffvelcdmd gwalkne.2 5 |- ( ph -> ( P ` ( I - 1 ) ) e. ( Vtx ` G ) )
  7 gjoinne gwalkne.1 6 1 |- ( ph -> ( P ` ( I - 1 ) ) =/= ( P ` I ) )

# A one-to-one correspondence of {0, …, n − 1} with the edges is a
# one-to-one function that reaches every edge: `df-f1o` and `dffo3`, the
# function's type dropped since one-to-one says it.
lemma gtravf1o
  |- ( f : ( 0 ... ( n - 1 ) ) -1-1-onto-> dom ( iEdg ` G ) <-> ( f : ( 0 ... ( n - 1 ) ) -1-1-> dom ( iEdg ` G ) /\ A. a e. dom ( iEdg ` G ) E. k e. ( 0 ... ( n - 1 ) ) a = ( f ` k ) ) )
  1 df-f1o |- ( f : ( 0 ... ( n - 1 ) ) -1-1-onto-> dom ( iEdg ` G ) <-> ( f : ( 0 ... ( n - 1 ) ) -1-1-> dom ( iEdg ` G ) /\ f : ( 0 ... ( n - 1 ) ) -onto-> dom ( iEdg ` G ) ) )
  2 dffo3 |- ( f : ( 0 ... ( n - 1 ) ) -onto-> dom ( iEdg ` G ) <-> ( f : ( 0 ... ( n - 1 ) ) --> dom ( iEdg ` G ) /\ A. a e. dom ( iEdg ` G ) E. k e. ( 0 ... ( n - 1 ) ) a = ( f ` k ) ) )
  3 anbi2i 2 |- ( ( f : ( 0 ... ( n - 1 ) ) -1-1-> dom ( iEdg ` G ) /\ f : ( 0 ... ( n - 1 ) ) -onto-> dom ( iEdg ` G ) ) <-> ( f : ( 0 ... ( n - 1 ) ) -1-1-> dom ( iEdg ` G ) /\ ( f : ( 0 ... ( n - 1 ) ) --> dom ( iEdg ` G ) /\ A. a e. dom ( iEdg ` G ) E. k e. ( 0 ... ( n - 1 ) ) a = ( f ` k ) ) ) )
  4 f1f |- ( f : ( 0 ... ( n - 1 ) ) -1-1-> dom ( iEdg ` G ) -> f : ( 0 ... ( n - 1 ) ) --> dom ( iEdg ` G ) )
  5 pm4.71i 4 |- ( f : ( 0 ... ( n - 1 ) ) -1-1-> dom ( iEdg ` G ) <-> ( f : ( 0 ... ( n - 1 ) ) -1-1-> dom ( iEdg ` G ) /\ f : ( 0 ... ( n - 1 ) ) --> dom ( iEdg ` G ) ) )
  6 anbi1i 5 |- ( ( f : ( 0 ... ( n - 1 ) ) -1-1-> dom ( iEdg ` G ) /\ A. a e. dom ( iEdg ` G ) E. k e. ( 0 ... ( n - 1 ) ) a = ( f ` k ) ) <-> ( ( f : ( 0 ... ( n - 1 ) ) -1-1-> dom ( iEdg ` G ) /\ f : ( 0 ... ( n - 1 ) ) --> dom ( iEdg ` G ) ) /\ A. a e. dom ( iEdg ` G ) E. k e. ( 0 ... ( n - 1 ) ) a = ( f ` k ) ) )
  7 anass |- ( ( ( f : ( 0 ... ( n - 1 ) ) -1-1-> dom ( iEdg ` G ) /\ f : ( 0 ... ( n - 1 ) ) --> dom ( iEdg ` G ) ) /\ A. a e. dom ( iEdg ` G ) E. k e. ( 0 ... ( n - 1 ) ) a = ( f ` k ) ) <-> ( f : ( 0 ... ( n - 1 ) ) -1-1-> dom ( iEdg ` G ) /\ ( f : ( 0 ... ( n - 1 ) ) --> dom ( iEdg ` G ) /\ A. a e. dom ( iEdg ` G ) E. k e. ( 0 ... ( n - 1 ) ) a = ( f ` k ) ) ) )
  8 bitri 6 7 |- ( ( f : ( 0 ... ( n - 1 ) ) -1-1-> dom ( iEdg ` G ) /\ A. a e. dom ( iEdg ` G ) E. k e. ( 0 ... ( n - 1 ) ) a = ( f ` k ) ) <-> ( f : ( 0 ... ( n - 1 ) ) -1-1-> dom ( iEdg ` G ) /\ ( f : ( 0 ... ( n - 1 ) ) --> dom ( iEdg ` G ) /\ A. a e. dom ( iEdg ` G ) E. k e. ( 0 ... ( n - 1 ) ) a = ( f ` k ) ) ) )
  9 bitri 1 3 |- ( f : ( 0 ... ( n - 1 ) ) -1-1-onto-> dom ( iEdg ` G ) <-> ( f : ( 0 ... ( n - 1 ) ) -1-1-> dom ( iEdg ` G ) /\ ( f : ( 0 ... ( n - 1 ) ) --> dom ( iEdg ` G ) /\ A. a e. dom ( iEdg ` G ) E. k e. ( 0 ... ( n - 1 ) ) a = ( f ` k ) ) ) )
  10 bitr4i 9 8 |- ( f : ( 0 ... ( n - 1 ) ) -1-1-onto-> dom ( iEdg ` G ) <-> ( f : ( 0 ... ( n - 1 ) ) -1-1-> dom ( iEdg ` G ) /\ A. a e. dom ( iEdg ` G ) E. k e. ( 0 ... ( n - 1 ) ) a = ( f ` k ) ) )

# ( ph -> f is an Euler path with v, said as the page says it ), where the
# path has n edges: `iseupthf1o` and `upgriswlk`, with the word's indices
# {0, …, #f − 1} read as {0, …, n − 1} by `fzoval`.
lemma gtravq
  hypothesis gtravq.1 |- ( ph -> G e. UMGraph )
  hypothesis gtravq.2 |- ( ph -> n e. NN0 )
  hypothesis gtravq.3 |- ( ph -> ( # ` f ) = n )
  |- ( ph -> ( f ( EulerPaths ` G ) v <-> ( ( f e. Word dom ( iEdg ` G ) /\ v : ( 0 ... n ) --> ( Vtx ` G ) ) /\ ( ( f : ( 0 ... ( n - 1 ) ) -1-1-> dom ( iEdg ` G ) /\ A. a e. dom ( iEdg ` G ) E. k e. ( 0 ... ( n - 1 ) ) a = ( f ` k ) ) /\ A. k e. ( 0 ... ( n - 1 ) ) ( ( iEdg ` G ) ` ( f ` k ) ) = { ( v ` k ) , ( v ` ( k + 1 ) ) } ) ) ) )
  1 eqid |- ( iEdg ` G ) = ( iEdg ` G )
  2 iseupthf1o 1 |- ( f ( EulerPaths ` G ) v <-> ( f ( Walks ` G ) v /\ f : ( 0 ..^ ( # ` f ) ) -1-1-onto-> dom ( iEdg ` G ) ) )
  3 eqid |- ( Vtx ` G ) = ( Vtx ` G )
  4 upgriswlk 3 1 |- ( G e. UPGraph -> ( f ( Walks ` G ) v <-> ( f e. Word dom ( iEdg ` G ) /\ v : ( 0 ... ( # ` f ) ) --> ( Vtx ` G ) /\ A. k e. ( 0 ..^ ( # ` f ) ) ( ( iEdg ` G ) ` ( f ` k ) ) = { ( v ` k ) , ( v ` ( k + 1 ) ) } ) ) )
  5 umgrupgr |- ( G e. UMGraph -> G e. UPGraph )
  6 syl gtravq.1 5 |- ( ph -> G e. UPGraph )
  7 syl 6 4 |- ( ph -> ( f ( Walks ` G ) v <-> ( f e. Word dom ( iEdg ` G ) /\ v : ( 0 ... ( # ` f ) ) --> ( Vtx ` G ) /\ A. k e. ( 0 ..^ ( # ` f ) ) ( ( iEdg ` G ) ` ( f ` k ) ) = { ( v ` k ) , ( v ` ( k + 1 ) ) } ) ) )
  8 oveq2d gtravq.3 |- ( ph -> ( 0 ..^ ( # ` f ) ) = ( 0 ..^ n ) )
  9 nn0zd gtravq.2 |- ( ph -> n e. ZZ )
  10 fzoval |- ( n e. ZZ -> ( 0 ..^ n ) = ( 0 ... ( n - 1 ) ) )
  11 syl 9 10 |- ( ph -> ( 0 ..^ n ) = ( 0 ... ( n - 1 ) ) )
  12 eqtrd 8 11 |- ( ph -> ( 0 ..^ ( # ` f ) ) = ( 0 ... ( n - 1 ) ) )
  13 oveq2d gtravq.3 |- ( ph -> ( 0 ... ( # ` f ) ) = ( 0 ... n ) )
  14 feq2d 13 |- ( ph -> ( v : ( 0 ... ( # ` f ) ) --> ( Vtx ` G ) <-> v : ( 0 ... n ) --> ( Vtx ` G ) ) )
  15 raleqdv 12 |- ( ph -> ( A. k e. ( 0 ..^ ( # ` f ) ) ( ( iEdg ` G ) ` ( f ` k ) ) = { ( v ` k ) , ( v ` ( k + 1 ) ) } <-> A. k e. ( 0 ... ( n - 1 ) ) ( ( iEdg ` G ) ` ( f ` k ) ) = { ( v ` k ) , ( v ` ( k + 1 ) ) } ) )
  16 3anbi23d 14 15 |- ( ph -> ( ( f e. Word dom ( iEdg ` G ) /\ v : ( 0 ... ( # ` f ) ) --> ( Vtx ` G ) /\ A. k e. ( 0 ..^ ( # ` f ) ) ( ( iEdg ` G ) ` ( f ` k ) ) = { ( v ` k ) , ( v ` ( k + 1 ) ) } ) <-> ( f e. Word dom ( iEdg ` G ) /\ v : ( 0 ... n ) --> ( Vtx ` G ) /\ A. k e. ( 0 ... ( n - 1 ) ) ( ( iEdg ` G ) ` ( f ` k ) ) = { ( v ` k ) , ( v ` ( k + 1 ) ) } ) ) )
  17 bitrd 7 16 |- ( ph -> ( f ( Walks ` G ) v <-> ( f e. Word dom ( iEdg ` G ) /\ v : ( 0 ... n ) --> ( Vtx ` G ) /\ A. k e. ( 0 ... ( n - 1 ) ) ( ( iEdg ` G ) ` ( f ` k ) ) = { ( v ` k ) , ( v ` ( k + 1 ) ) } ) ) )
  18 f1oeq2 |- ( ( 0 ..^ ( # ` f ) ) = ( 0 ... ( n - 1 ) ) -> ( f : ( 0 ..^ ( # ` f ) ) -1-1-onto-> dom ( iEdg ` G ) <-> f : ( 0 ... ( n - 1 ) ) -1-1-onto-> dom ( iEdg ` G ) ) )
  19 syl 12 18 |- ( ph -> ( f : ( 0 ..^ ( # ` f ) ) -1-1-onto-> dom ( iEdg ` G ) <-> f : ( 0 ... ( n - 1 ) ) -1-1-onto-> dom ( iEdg ` G ) ) )
  20 gtravf1o |- ( f : ( 0 ... ( n - 1 ) ) -1-1-onto-> dom ( iEdg ` G ) <-> ( f : ( 0 ... ( n - 1 ) ) -1-1-> dom ( iEdg ` G ) /\ A. a e. dom ( iEdg ` G ) E. k e. ( 0 ... ( n - 1 ) ) a = ( f ` k ) ) )
  21 bitrdi 19 20 |- ( ph -> ( f : ( 0 ..^ ( # ` f ) ) -1-1-onto-> dom ( iEdg ` G ) <-> ( f : ( 0 ... ( n - 1 ) ) -1-1-> dom ( iEdg ` G ) /\ A. a e. dom ( iEdg ` G ) E. k e. ( 0 ... ( n - 1 ) ) a = ( f ` k ) ) ) )
  22 anbi12d 17 21 |- ( ph -> ( ( f ( Walks ` G ) v /\ f : ( 0 ..^ ( # ` f ) ) -1-1-onto-> dom ( iEdg ` G ) ) <-> ( ( f e. Word dom ( iEdg ` G ) /\ v : ( 0 ... n ) --> ( Vtx ` G ) /\ A. k e. ( 0 ... ( n - 1 ) ) ( ( iEdg ` G ) ` ( f ` k ) ) = { ( v ` k ) , ( v ` ( k + 1 ) ) } ) /\ ( f : ( 0 ... ( n - 1 ) ) -1-1-> dom ( iEdg ` G ) /\ A. a e. dom ( iEdg ` G ) E. k e. ( 0 ... ( n - 1 ) ) a = ( f ` k ) ) ) ) )
  23 bitrid 2 22 |- ( ph -> ( f ( EulerPaths ` G ) v <-> ( ( f e. Word dom ( iEdg ` G ) /\ v : ( 0 ... n ) --> ( Vtx ` G ) /\ A. k e. ( 0 ... ( n - 1 ) ) ( ( iEdg ` G ) ` ( f ` k ) ) = { ( v ` k ) , ( v ` ( k + 1 ) ) } ) /\ ( f : ( 0 ... ( n - 1 ) ) -1-1-> dom ( iEdg ` G ) /\ A. a e. dom ( iEdg ` G ) E. k e. ( 0 ... ( n - 1 ) ) a = ( f ` k ) ) ) ) )
  24 df-3an |- ( ( f e. Word dom ( iEdg ` G ) /\ v : ( 0 ... n ) --> ( Vtx ` G ) /\ A. k e. ( 0 ... ( n - 1 ) ) ( ( iEdg ` G ) ` ( f ` k ) ) = { ( v ` k ) , ( v ` ( k + 1 ) ) } ) <-> ( ( f e. Word dom ( iEdg ` G ) /\ v : ( 0 ... n ) --> ( Vtx ` G ) ) /\ A. k e. ( 0 ... ( n - 1 ) ) ( ( iEdg ` G ) ` ( f ` k ) ) = { ( v ` k ) , ( v ` ( k + 1 ) ) } ) )
