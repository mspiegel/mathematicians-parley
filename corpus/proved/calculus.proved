# Calculus, for `proved.mm`.
#
# The mean value theorem asks what a textbook calls the sum rules: a sum of
# continuous functions is continuous, a line is, and the derivative of a sum
# is the sum of the derivatives, of a line its slope. set.mm says each of a
# map written out, `( x e. X |-> A )`, or of functions added pointwise,
# `( F oF + G )`, and the page says it of functions named apart from their
# values, F with F(x) = f(x) + g(x) for every x. Each lemma here is the
# page's form: the function is its map (`dffn5`) or the pointwise sum
# (`offval`), and set.mm's rule is applied to that.
#
# The derivative rules hold on any D ⊆ ℝ. A sum is differentiable at each
# point both its parts are (`dvaddbr`), so its rule asks nothing of the set
# U it is said on. A line is differentiable at a point of D only where a
# neighbourhood of it lies in D, so its rule asks U be open (`dvres`,
# `isopn3i`), as a textbook's does.
#
# A function on [a, b] is differentiable on (a, b) at most, since a
# derivative is taken only where a neighbourhood lies in the domain
# (`dvbssntr`, `iccntr`, `gdvsub`). The page's "differentiable on (a, b)"
# says (a, b) lies within the derivative's domain, and for a function on
# [a, b] that makes the two equal (`gdvdmicc`), which is what set.mm's
# `rolle` asks (`grolle`). Derivatives are into ℂ in set.mm, and a real
# function's are real (`dvfre`).
#
# Continuity in set.mm is into a set named by the space, `D -cn-> CC` for
# the rules and `D -cn-> RR` for the page; `cncfss` widens one to the other
# and `cncfcdm` narrows a continuous function into ℝ when its values are.

$( Calculus: continuity and derivatives of a sum and of a line, as the
   page says them of functions named apart from their values. $)
$d x ph $.
$d x A $.
$d x B $.
$d x D $.
$d x F $.
$d x G $.
$d x H $.
$d x I $.
$d x M $.
$d x U $.
$d x V $.
$d x y $.
$d x z $.
$d y z $.
$d y ph $.
$d z ph $.
$d y D $.
$d z D $.
$d y G $.
$d z G $.
$d x C $.
$d y A $.
$d y B $.
$d y C $.
$d y F $.
$d t x $.
$d t y $.
$d t ph $.
$d t A $.
$d t B $.
$d t C $.
$d t F $.

lemma gdvdm
  hypothesis gdvdm.1 |- ( ph -> D = ( x e. I |-> E ) )
  hypothesis gdvdm.2 |- ( ( ph /\ x e. I ) -> E e. V )
  |- ( ph -> I C_ dom D )
  1 dmeqd gdvdm.1 |- ( ph -> dom D = dom ( x e. I |-> E ) )
  2 ralrimiva gdvdm.2 |- ( ph -> A. x e. I E e. V )
  3 dmmptg |- ( A. x e. I E e. V -> dom ( x e. I |-> E ) = I )
  4 syl 2 3 |- ( ph -> dom ( x e. I |-> E ) = I )
  5 eqtrd 1 4 |- ( ph -> dom D = I )
  6 eqcomd 5 |- ( ph -> I = dom D )
  7 eqimssd 6 |- ( ph -> I C_ dom D )

lemma gdvval
  hypothesis gdvval.1 |- ( ph -> D = ( x e. I |-> E ) )
  hypothesis gdvval.2 |- ( ( ph /\ x e. I ) -> E e. V )
  |- ( ph -> A. x e. I ( D ` x ) = E )
  1 adantr gdvval.1 |- ( ( ph /\ x e. I ) -> D = ( x e. I |-> E ) )
  2 fveq1d 1 |- ( ( ph /\ x e. I ) -> ( D ` x ) = ( ( x e. I |-> E ) ` x ) )
  3 simpr |- ( ( ph /\ x e. I ) -> x e. I )
  4 eqid |- ( x e. I |-> E ) = ( x e. I |-> E )
  5 fvmpt2 4 |- ( ( x e. I /\ E e. V ) -> ( ( x e. I |-> E ) ` x ) = E )
  6 syl2anc 3 gdvval.2 5 |- ( ( ph /\ x e. I ) -> ( ( x e. I |-> E ) ` x ) = E )
  7 eqtrd 2 6 |- ( ( ph /\ x e. I ) -> ( D ` x ) = E )
  8 ralrimiva 7 |- ( ph -> A. x e. I ( D ` x ) = E )

lemma gdvsub
  hypothesis gdvsub.1 |- ( ph -> A e. RR )
  hypothesis gdvsub.2 |- ( ph -> B e. RR )
  hypothesis gdvsub.3 |- ( ph -> F : ( A [,] B ) --> CC )
  |- ( ph -> dom ( RR _D F ) C_ ( A (,) B ) )
  1 ax-resscn |- RR C_ CC
  2 a1i 1 |- ( ph -> RR C_ CC )
  3 iccssre |- ( ( A e. RR /\ B e. RR ) -> ( A [,] B ) C_ RR )
  4 syl2anc gdvsub.1 gdvsub.2 3 |- ( ph -> ( A [,] B ) C_ RR )
  5 eqid |- ( TopOpen ` CCfld ) = ( TopOpen ` CCfld )
  6 tgioo2 5 |- ( topGen ` ran (,) ) = ( ( TopOpen ` CCfld ) |`t RR )
  7 dvbssntr 2 gdvsub.3 4 6 5 |- ( ph -> dom ( RR _D F ) C_ ( ( int ` ( topGen ` ran (,) ) ) ` ( A
      [,] B ) ) )
  8 iccntr |- ( ( A e. RR /\ B e. RR ) -> ( ( int ` ( topGen ` ran (,) ) ) ` ( A [,] B ) ) = ( A (,)
      B ) )
  9 syl2anc gdvsub.1 gdvsub.2 8 |- ( ph -> ( ( int ` ( topGen ` ran (,) ) ) ` ( A [,] B ) ) = ( A
      (,) B ) )
  10 sseqtrd 7 9 |- ( ph -> dom ( RR _D F ) C_ ( A (,) B ) )

lemma gdvdmicc
  hypothesis gdvdmicc.1 |- ( ph -> A e. RR )
  hypothesis gdvdmicc.2 |- ( ph -> B e. RR )
  hypothesis gdvdmicc.3 |- ( ph -> F : ( A [,] B ) --> CC )
  hypothesis gdvdmicc.4 |- ( ph -> ( A (,) B ) C_ dom ( RR _D F ) )
  |- ( ph -> dom ( RR _D F ) = ( A (,) B ) )
  1 gdvsub gdvdmicc.1 gdvdmicc.2 gdvdmicc.3 |- ( ph -> dom ( RR _D F ) C_ ( A (,) B ) )
  2 eqssd 1 gdvdmicc.4 |- ( ph -> dom ( RR _D F ) = ( A (,) B ) )

lemma grolle
  hypothesis grolle.1 |- ( ph -> A e. RR )
  hypothesis grolle.2 |- ( ph -> B e. RR )
  hypothesis grolle.3 |- ( ph -> A < B )
  hypothesis grolle.4 |- ( ph -> F e. ( ( A [,] B ) -cn-> RR ) )
  hypothesis grolle.5 |- ( ph -> ( A (,) B ) C_ dom ( RR _D F ) )
  hypothesis grolle.6 |- ( ph -> ( F ` A ) = ( F ` B ) )
  |- ( ph -> E. x e. ( A (,) B ) ( ( RR _D F ) ` x ) = 0 )
  1 cncff |- ( F e. ( ( A [,] B ) -cn-> RR ) -> F : ( A [,] B ) --> RR )
  2 syl grolle.4 1 |- ( ph -> F : ( A [,] B ) --> RR )
  3 ax-resscn |- RR C_ CC
  4 a1i 3 |- ( ph -> RR C_ CC )
  5 fssd 2 4 |- ( ph -> F : ( A [,] B ) --> CC )
  6 gdvdmicc grolle.1 grolle.2 5 grolle.5 |- ( ph -> dom ( RR _D F ) = ( A (,) B ) )
  7 rolle grolle.1 grolle.2 grolle.3 grolle.4 6 grolle.6 |- ( ph -> E. x e. ( A (,) B ) ( ( RR _D F
      ) ` x ) = 0 )

lemma gdvf
  hypothesis gdvf.1 |- ( ph -> A e. RR )
  hypothesis gdvf.2 |- ( ph -> B e. RR )
  hypothesis gdvf.3 |- ( ph -> F : ( A [,] B ) --> RR )
  hypothesis gdvf.4 |- ( ph -> ( A (,) B ) C_ dom ( RR _D F ) )
  |- ( ph -> ( RR _D F ) : ( A (,) B ) --> RR )
