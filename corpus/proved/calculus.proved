  25 sstrd 6 gcncfext.1 |- ( ph -> ( U \ { C } ) C_ RR )
  26 ssidd |- ( ph -> ( U \ { C } ) C_ ( U \ { C } ) )
  27 gdvloc 25 gcncfext.1 26 6 24 gcncfext.5 gcncfext.6 gcncfext.7 gcncfext.9 |- ( ph -> ( U \ { C
      } ) C_ dom ( RR _D G ) )
