  6 a1i 5 |- ( ph -> RR C_ CC )
  7 fssd gdvf.3 6 |- ( ph -> F : ( A [,] B ) --> CC )
  8 gdvdmicc gdvf.1 gdvf.2 7 gdvf.4 |- ( ph -> dom ( RR _D F ) = ( A (,) B ) )
  9 feq2d 8 |- ( ph -> ( ( RR _D F ) : dom ( RR _D F ) --> RR <-> ( RR _D F ) : ( A (,) B ) --> RR )
      )
  10 mpbid 4 9 |- ( ph -> ( RR _D F ) : ( A (,) B ) --> RR )

lemma gdvre
  hypothesis gdvre.1 |- ( ph -> A e. RR )
  hypothesis gdvre.2 |- ( ph -> B e. RR )
  hypothesis gdvre.3 |- ( ph -> F : ( A [,] B ) --> RR )
  hypothesis gdvre.4 |- ( ph -> ( A (,) B ) C_ dom ( RR _D F ) )
  hypothesis gdvre.5 |- ( ph -> C e. ( A (,) B ) )
  |- ( ph -> ( ( RR _D F ) ` C ) e. RR )
  1 gdvf gdvre.1 gdvre.2 gdvre.3 gdvre.4 |- ( ph -> ( RR _D F ) : ( A (,) B ) --> RR )
  2 ffvelcdmd 1 gdvre.5 |- ( ph -> ( ( RR _D F ) ` C ) e. RR )

lemma gdvaddof
  hypothesis gdvaddof.1 |- ( ph -> D C_ RR )
  hypothesis gdvaddof.2 |- ( ph -> H : D --> RR )
  hypothesis gdvaddof.3 |- ( ph -> F : D --> RR )
  hypothesis gdvaddof.4 |- ( ph -> G : D --> RR )
  hypothesis gdvaddof.5 |- ( ph -> A. x e. D ( H ` x ) = ( ( F ` x ) + ( G ` x ) ) )
  |- ( ph -> H = ( F oF + G ) )
  1 ffnd gdvaddof.2 |- ( ph -> H Fn D )
  2 dffn5 |- ( H Fn D <-> H = ( x e. D |-> ( H ` x ) ) )
  3 sylib 1 2 |- ( ph -> H = ( x e. D |-> ( H ` x ) ) )
  4 r19.21bi gdvaddof.5 |- ( ( ph /\ x e. D ) -> ( H ` x ) = ( ( F ` x ) + ( G ` x ) ) )
  5 mpteq2dva 4 |- ( ph -> ( x e. D |-> ( H ` x ) ) = ( x e. D |-> ( ( F ` x ) + ( G ` x ) ) ) )
  6 eqtrd 3 5 |- ( ph -> H = ( x e. D |-> ( ( F ` x ) + ( G ` x ) ) ) )
  7 ffnd gdvaddof.3 |- ( ph -> F Fn D )
  8 ffnd gdvaddof.4 |- ( ph -> G Fn D )
  9 reex |- RR e. _V
  10 a1i 9 |- ( ph -> RR e. _V )
  11 ssexd 10 gdvaddof.1 |- ( ph -> D e. _V )
  12 inidm |- ( D i^i D ) = D
  13 eqidd |- ( ( ph /\ x e. D ) -> ( F ` x ) = ( F ` x ) )
  14 eqidd |- ( ( ph /\ x e. D ) -> ( G ` x ) = ( G ` x ) )
  15 offval 7 8 11 11 12 13 14 |- ( ph -> ( F oF + G ) = ( x e. D |-> ( ( F ` x ) + ( G ` x ) ) ) )
  16 eqtr4d 6 15 |- ( ph -> H = ( F oF + G ) )

