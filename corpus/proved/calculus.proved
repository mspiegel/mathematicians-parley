  2 a1i 1 |- ( ph -> RR C_ CC )
  3 fssd gcncfext.6 2 |- ( ph -> G : U --> CC )
  4 sstrd gcncfext.1 2 |- ( ph -> U C_ CC )
  5 difss |- ( U \ { C } ) C_ U
  6 a1i 5 |- ( ph -> ( U \ { C } ) C_ U )
  7 ffnd gcncfext.6 |- ( ph -> G Fn U )
  8 fnssres |- ( ( G Fn U /\ ( U \ { C } ) C_ U ) -> ( G |` ( U \ { C } ) ) Fn ( U \ { C } ) )
