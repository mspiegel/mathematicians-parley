# `glimcre`: a real L is the limit of a real function F on A ⊆ ℝ at a real
# B exactly when the ε–δ condition holds, said over ℝ with ε > 0 and δ > 0
# as the page says it. `ellimc3` says it of a function into ℂ on a part of
# ℂ, which `fssd` and `sstrd` widen the page's ℝ to, and adds L ∈ ℂ on its
# right, which `recnd` gives and `biantrurd` drops; `ralrp` and `rexrp`
# read its ℝ⁺ as the reals above 0.
lemma glimcre
  hypothesis glimcre.1 |- ( ph -> A C_ RR )
  hypothesis glimcre.2 |- ( ph -> F : A --> RR )
  hypothesis glimcre.3 |- ( ph -> B e. RR )
  hypothesis glimcre.4 |- ( ph -> C e. RR )
  |- ( ph -> ( C e. ( F limCC B ) <-> A. x e. RR ( 0 < x -> E. y e. RR ( 0 < y /\ A. z e. A ( ( z =/= B /\ ( abs ` ( z - B ) ) < y ) -> ( abs ` ( ( F ` z ) - C ) ) < x ) ) ) ) )
  1 ax-resscn |- RR C_ CC
  2 a1i 1 |- ( ph -> RR C_ CC )
  3 fssd glimcre.2 2 |- ( ph -> F : A --> CC )
  4 sstrd glimcre.1 2 |- ( ph -> A C_ CC )
  5 recnd glimcre.3 |- ( ph -> B e. CC )
  6 ellimc3 3 4 5 |- ( ph -> ( C e. ( F limCC B ) <-> ( C e. CC /\ A. x e. RR+ E. y e. RR+ A. z e. A ( ( z =/= B /\ ( abs ` ( z - B ) ) < y ) -> ( abs ` ( ( F ` z ) - C ) ) < x ) ) ) )
  7 recnd glimcre.4 |- ( ph -> C e. CC )
  8 biantrurd 7 |- ( ph -> ( A. x e. RR+ E. y e. RR+ A. z e. A ( ( z =/= B /\ ( abs ` ( z - B ) ) < y ) -> ( abs ` ( ( F ` z ) - C ) ) < x ) <-> ( C e. CC /\ A. x e. RR+ E. y e. RR+ A. z e. A ( ( z =/= B /\ ( abs ` ( z - B ) ) < y ) -> ( abs ` ( ( F ` z ) - C ) ) < x ) ) ) )
  9 bitr4d 6 8 |- ( ph -> ( C e. ( F limCC B ) <-> A. x e. RR+ E. y e. RR+ A. z e. A ( ( z =/= B /\ ( abs ` ( z - B ) ) < y ) -> ( abs ` ( ( F ` z ) - C ) ) < x ) ) )
  10 rexrp |- ( E. y e. RR+ A. z e. A ( ( z =/= B /\ ( abs ` ( z - B ) ) < y ) -> ( abs ` ( ( F ` z ) - C ) ) < x ) <-> E. y e. RR ( 0 < y /\ A. z e. A ( ( z =/= B /\ ( abs ` ( z - B ) ) < y ) -> ( abs ` ( ( F ` z ) - C ) ) < x ) ) )
  11 ralbii 10 |- ( A. x e. RR+ E. y e. RR+ A. z e. A ( ( z =/= B /\ ( abs ` ( z - B ) ) < y ) -> ( abs ` ( ( F ` z ) - C ) ) < x ) <-> A. x e. RR+ E. y e. RR ( 0 < y /\ A. z e. A ( ( z =/= B /\ ( abs ` ( z - B ) ) < y ) -> ( abs ` ( ( F ` z ) - C ) ) < x ) ) )
  12 ralrp |- ( A. x e. RR+ E. y e. RR ( 0 < y /\ A. z e. A ( ( z =/= B /\ ( abs ` ( z - B ) ) < y ) -> ( abs ` ( ( F ` z ) - C ) ) < x ) ) <-> A. x e. RR ( 0 < x -> E. y e. RR ( 0 < y /\ A. z e. A ( ( z =/= B /\ ( abs ` ( z - B ) ) < y ) -> ( abs ` ( ( F ` z ) - C ) ) < x ) ) ) )
  13 bitri 11 12 |- ( A. x e. RR+ E. y e. RR+ A. z e. A ( ( z =/= B /\ ( abs ` ( z - B ) ) < y ) -> ( abs ` ( ( F ` z ) - C ) ) < x ) <-> A. x e. RR ( 0 < x -> E. y e. RR ( 0 < y /\ A. z e. A ( ( z =/= B /\ ( abs ` ( z - B ) ) < y ) -> ( abs ` ( ( F ` z ) - C ) ) < x ) ) ) )
  14 bitrdi 9 13 |- ( ph -> ( C e. ( F limCC B ) <-> A. x e. RR ( 0 < x -> E. y e. RR ( 0 < y /\ A. z e. A ( ( z =/= B /\ ( abs ` ( z - B ) ) < y ) -> ( abs ` ( ( F ` z ) - C ) ) < x ) ) ) ) )

# The page's "f is continuous on S" says it of f restricted to S, `( F |` S
# ) e. ( S -cn-> RR )`, so that S may be a part of f's domain: the mean
# value theorem on [c, x] inside f's (a, b). Where S is the whole domain,
# f restricted to it is f (`fnresdm`), and the rules above, said of F
# itself, are said here of the restriction.
lemma gcncfres
  hypothesis gcncfres.1 |- ( ph -> F : A --> RR )
  |- ( ph -> ( ( F |` A ) e. ( A -cn-> RR ) <-> F e. ( A -cn-> RR ) ) )
  1 ffnd gcncfres.1 |- ( ph -> F Fn A )
  2 fnresdm |- ( F Fn A -> ( F |` A ) = F )
  3 syl 1 2 |- ( ph -> ( F |` A ) = F )
  4 eleq1d 3 |- ( ph -> ( ( F |` A ) e. ( A -cn-> RR ) <-> F e. ( A -cn-> RR ) ) )

