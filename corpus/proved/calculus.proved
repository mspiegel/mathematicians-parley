  8 syl 2 7 |- ( ph -> F e. ( ( A [,] B ) -cn-> CC ) )
  9 cniccbdd |- ( ( A e. RR /\ B e. RR /\ F e. ( ( A [,] B ) -cn-> CC ) ) -> E. x e. RR A. y e. ( A [,] B ) ( abs ` ( F ` y ) ) <_ x )
  10 syl3anc gcncfbdd.1 gcncfbdd.2 8 9 |- ( ph -> E. x e. RR A. y e. ( A [,] B ) ( abs ` ( F ` y ) ) <_ x )

lemma gftc1cres
  hypothesis gftc1cres.1 |- ( ph -> A e. RR )
  hypothesis gftc1cres.2 |- ( ph -> B e. RR )
  hypothesis gftc1cres.3 |- ( ph -> A < B )
