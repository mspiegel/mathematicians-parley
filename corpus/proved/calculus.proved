  2 syl2anc gdvf.1 gdvf.2 1 |- ( ph -> ( A [,] B ) C_ RR )
  3 dvfre |- ( ( F : ( A [,] B ) --> RR /\ ( A [,] B ) C_ RR ) -> ( RR _D F ) : dom ( RR _D F ) -->
      RR )
  4 syl2anc gdvf.3 2 3 |- ( ph -> ( RR _D F ) : dom ( RR _D F ) --> RR )
