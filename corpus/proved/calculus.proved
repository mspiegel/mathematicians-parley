  41 syl2anc 38 39 40 |- ( ( ph /\ x e. ( U \ { C } ) ) -> ( G e. ( ( ( ( TopOpen ` CCfld ) |`t U )
      CnP ( TopOpen ` CCfld ) ) ` x ) <-> ( G : U --> CC /\ ( G ` x ) e. ( G limCC x ) ) ) )
  42 mpbid 37 41 |- ( ( ph /\ x e. ( U \ { C } ) ) -> ( G : U --> CC /\ ( G ` x ) e. ( G limCC x )
      ) )
  43 simprd 42 |- ( ( ph /\ x e. ( U \ { C } ) ) -> ( G ` x ) e. ( G limCC x ) )
  44 ralrimiva 43 |- ( ph -> A. x e. ( U \ { C } ) ( G ` x ) e. ( G limCC x ) )
  45 fveq2 |- ( x = C -> ( G ` x ) = ( G ` C ) )
  46 oveq2 |- ( x = C -> ( G limCC x ) = ( G limCC C ) )
  47 eleq12d 45 46 |- ( x = C -> ( ( G ` x ) e. ( G limCC x ) <-> ( G ` C ) e. ( G limCC C ) ) )
  48 ralsng 47 |- ( C e. U -> ( A. x e. { C } ( G ` x ) e. ( G limCC x ) <-> ( G ` C ) e. ( G
      limCC C ) ) )
  49 syl gcncfext.3 48 |- ( ph -> ( A. x e. { C } ( G ` x ) e. ( G limCC x ) <-> ( G ` C ) e. ( G
      limCC C ) ) )
  50 mpbird 23 49 |- ( ph -> A. x e. { C } ( G ` x ) e. ( G limCC x ) )
  51 jca 44 50 |- ( ph -> ( A. x e. ( U \ { C } ) ( G ` x ) e. ( G limCC x ) /\ A. x e. { C } ( G
      ` x ) e. ( G limCC x ) ) )
  52 ralunb |- ( A. x e. ( ( U \ { C } ) u. { C } ) ( G ` x ) e. ( G limCC x ) <-> ( A. x e. ( U
      \ { C } ) ( G ` x ) e. ( G limCC x ) /\ A. x e. { C } ( G ` x ) e. ( G limCC x ) ) )
  53 sylibr 51 52 |- ( ph -> A. x e. ( ( U \ { C } ) u. { C } ) ( G ` x ) e. ( G limCC x ) )
  54 difsnid |- ( C e. U -> ( ( U \ { C } ) u. { C } ) = U )
  55 syl gcncfext.3 54 |- ( ph -> ( ( U \ { C } ) u. { C } ) = U )
  56 raleqdv 55 |- ( ph -> ( A. x e. ( ( U \ { C } ) u. { C } ) ( G ` x ) e. ( G limCC x ) <-> A.
      x e. U ( G ` x ) e. ( G limCC x ) ) )
  57 mpbid 53 56 |- ( ph -> A. x e. U ( G ` x ) e. ( G limCC x ) )
  58 cnlimc |- ( U C_ CC -> ( G e. ( U -cn-> CC ) <-> ( G : U --> CC /\ A. x e. U ( G ` x ) e. ( G
      limCC x ) ) ) )
  59 syl 4 58 |- ( ph -> ( G e. ( U -cn-> CC ) <-> ( G : U --> CC /\ A. x e. U ( G ` x ) e. ( G
      limCC x ) ) ) )
  60 mpbir2and 3 57 59 |- ( ph -> G e. ( U -cn-> CC ) )
  61 cncfcdm |- ( ( RR C_ CC /\ G e. ( U -cn-> CC ) ) -> ( G e. ( U -cn-> RR ) <-> G : U --> RR ) )
  62 syl2anc 2 60 61 |- ( ph -> ( G e. ( U -cn-> RR ) <-> G : U --> RR ) )
  63 mpbird gcncfext.6 62 |- ( ph -> G e. ( U -cn-> RR ) )
  64 gcncfres gcncfext.6 |- ( ph -> ( ( G |` U ) e. ( U -cn-> RR ) <-> G e. ( U -cn-> RR ) ) )
  65 mpbird 63 64 |- ( ph -> ( G |` U ) e. ( U -cn-> RR ) )

# Restricted to [ A , B ] inside its domain, a function has its own
# derivative on ( A , B ), the interior of [ A , B ] (`dvres`, `iccntr`).
# So the theorems set.mm states of a function on [ A , B ] say it of a
# function on any domain holding [ A , B ].
lemma gdviccres
  hypothesis gdviccres.1 |- ( ph -> D C_ RR )
  hypothesis gdviccres.2 |- ( ph -> A e. RR )
  hypothesis gdviccres.3 |- ( ph -> B e. RR )
  hypothesis gdviccres.4 |- ( ph -> F : D --> RR )
  |- ( ph -> ( RR _D ( F |` ( A [,] B ) ) ) = ( ( RR _D F ) |` ( A (,) B ) ) )
  1 ax-resscn |- RR C_ CC
  2 a1i 1 |- ( ph -> RR C_ CC )
  3 fssd gdviccres.4 2 |- ( ph -> F : D --> CC )
  4 iccssre |- ( ( A e. RR /\ B e. RR ) -> ( A [,] B ) C_ RR )
  5 syl2anc gdviccres.2 gdviccres.3 4 |- ( ph -> ( A [,] B ) C_ RR )
  6 eqid |- ( TopOpen ` CCfld ) = ( TopOpen ` CCfld )
  7 tgioo2 6 |- ( topGen ` ran (,) ) = ( ( TopOpen ` CCfld ) |`t RR )
  8 dvres 6 7 |- ( ( ( RR C_ CC /\ F : D --> CC ) /\ ( D C_ RR /\ ( A [,] B ) C_ RR ) ) -> ( RR _D
      ( F |` ( A [,] B ) ) ) = ( ( RR _D F ) |` ( ( int ` ( topGen ` ran (,) ) ) ` ( A [,] B ) ) ) )
  9 syl22anc 2 3 gdviccres.1 5 8 |- ( ph -> ( RR _D ( F |` ( A [,] B ) ) ) = ( ( RR _D F ) |` ( (
      int ` ( topGen ` ran (,) ) ) ` ( A [,] B ) ) ) )
  10 iccntr |- ( ( A e. RR /\ B e. RR ) -> ( ( int ` ( topGen ` ran (,) ) ) ` ( A [,] B ) ) = ( A
      (,) B ) )
  11 syl2anc gdviccres.2 gdviccres.3 10 |- ( ph -> ( ( int ` ( topGen ` ran (,) ) ) ` ( A [,] B ) ) =
      ( A (,) B ) )
  12 reseq2d 11 |- ( ph -> ( ( RR _D F ) |` ( ( int ` ( topGen ` ran (,) ) ) ` ( A [,] B ) ) ) = ( (
      RR _D F ) |` ( A (,) B ) ) )
  13 eqtrd 9 12 |- ( ph -> ( RR _D ( F |` ( A [,] B ) ) ) = ( ( RR _D F ) |` ( A (,) B ) ) )

lemma gdviccdm
  hypothesis gdviccdm.1 |- ( ph -> D C_ RR )
  hypothesis gdviccdm.2 |- ( ph -> A e. RR )
  hypothesis gdviccdm.3 |- ( ph -> B e. RR )
  hypothesis gdviccdm.4 |- ( ph -> F : D --> RR )
  hypothesis gdviccdm.5 |- ( ph -> ( A (,) B ) C_ dom ( RR _D F ) )
  |- ( ph -> dom ( RR _D ( F |` ( A [,] B ) ) ) = ( A (,) B ) )
  1 gdviccres gdviccdm.1 gdviccdm.2 gdviccdm.3 gdviccdm.4 |- ( ph -> ( RR _D ( F |` ( A [,] B ) ) )
      = ( ( RR _D F ) |` ( A (,) B ) ) )
  2 dmeqd 1 |- ( ph -> dom ( RR _D ( F |` ( A [,] B ) ) ) = dom ( ( RR _D F ) |` ( A (,) B ) ) )
  3 ssdmres |- ( ( A (,) B ) C_ dom ( RR _D F ) <-> dom ( ( RR _D F ) |` ( A (,) B ) ) = ( A (,) B
      ) )
  4 sylib gdviccdm.5 3 |- ( ph -> dom ( ( RR _D F ) |` ( A (,) B ) ) = ( A (,) B ) )
  5 eqtrd 2 4 |- ( ph -> dom ( RR _D ( F |` ( A [,] B ) ) ) = ( A (,) B ) )

lemma gdviccv
  hypothesis gdviccv.1 |- ( ph -> D C_ RR )
  hypothesis gdviccv.2 |- ( ph -> A e. RR )
  hypothesis gdviccv.3 |- ( ph -> B e. RR )
  hypothesis gdviccv.4 |- ( ph -> F : D --> RR )
  |- ( ( ph /\ x e. ( A (,) B ) ) -> ( ( RR _D ( F |` ( A [,] B ) ) ) ` x ) = ( ( RR _D F ) ` x ) )
  1 gdviccres gdviccv.1 gdviccv.2 gdviccv.3 gdviccv.4 |- ( ph -> ( RR _D ( F |` ( A [,] B ) ) ) = (
      ( RR _D F ) |` ( A (,) B ) ) )
  2 adantr 1 |- ( ( ph /\ x e. ( A (,) B ) ) -> ( RR _D ( F |` ( A [,] B ) ) ) = ( ( RR _D F ) |`
      ( A (,) B ) ) )
  3 fveq1d 2 |- ( ( ph /\ x e. ( A (,) B ) ) -> ( ( RR _D ( F |` ( A [,] B ) ) ) ` x ) = ( ( ( RR
      _D F ) |` ( A (,) B ) ) ` x ) )
  4 fvres |- ( x e. ( A (,) B ) -> ( ( ( RR _D F ) |` ( A (,) B ) ) ` x ) = ( ( RR _D F ) ` x ) )
  5 adantl 4 |- ( ( ph /\ x e. ( A (,) B ) ) -> ( ( ( RR _D F ) |` ( A (,) B ) ) ` x ) = ( ( RR _D
      F ) ` x ) )
  6 eqtrd 3 5 |- ( ( ph /\ x e. ( A (,) B ) ) -> ( ( RR _D ( F |` ( A [,] B ) ) ) ` x ) = ( ( RR _D
      F ) ` x ) )

# The ends of [ A , B ] are in it, so a function restricted to it has its
# own values there.
lemma gfvicc
  hypothesis gfvicc.1 |- ( ph -> A e. RR )
  hypothesis gfvicc.2 |- ( ph -> B e. RR )
  hypothesis gfvicc.3 |- ( ph -> A < B )
  |- ( ph -> ( ( ( F |` ( A [,] B ) ) ` A ) = ( F ` A ) /\ ( ( F |` ( A [,] B ) ) ` B ) = ( F ` B
      ) ) )
  1 rexrd gfvicc.1 |- ( ph -> A e. RR* )
  2 rexrd gfvicc.2 |- ( ph -> B e. RR* )
  3 ltled gfvicc.1 gfvicc.2 gfvicc.3 |- ( ph -> A <_ B )
  4 lbicc2 |- ( ( A e. RR* /\ B e. RR* /\ A <_ B ) -> A e. ( A [,] B ) )
  5 syl3anc 1 2 3 4 |- ( ph -> A e. ( A [,] B ) )
  6 ubicc2 |- ( ( A e. RR* /\ B e. RR* /\ A <_ B ) -> B e. ( A [,] B ) )
  7 syl3anc 1 2 3 6 |- ( ph -> B e. ( A [,] B ) )
  8 fvresd 5 |- ( ph -> ( ( F |` ( A [,] B ) ) ` A ) = ( F ` A ) )
  9 fvresd 7 |- ( ph -> ( ( F |` ( A [,] B ) ) ` B ) = ( F ` B ) )
  10 jca 8 9 |- ( ph -> ( ( ( F |` ( A [,] B ) ) ` A ) = ( F ` A ) /\ ( ( F |` ( A [,] B ) ) ` B ) =
      ( F ` B ) ) )

# Cauchy's mean value theorem, `cmvth`, said of functions on any domain D
# holding [ A , B ]: set.mm's asks for functions on [ A , B ] whose
# derivative is defined on exactly ( A , B ), which their restrictions are
# (`gdviccdm`), with the same values at the ends and the same derivative.
lemma gcmvthres
  hypothesis gcmvthres.1 |- ( ph -> D C_ RR )
  hypothesis gcmvthres.2 |- ( ph -> A e. RR )
  hypothesis gcmvthres.3 |- ( ph -> B e. RR )
  hypothesis gcmvthres.4 |- ( ph -> A < B )
  hypothesis gcmvthres.5 |- ( ph -> ( A [,] B ) C_ D )
  hypothesis gcmvthres.6 |- ( ph -> F : D --> RR )
  hypothesis gcmvthres.7 |- ( ph -> G : D --> RR )
  hypothesis gcmvthres.8 |- ( ph -> ( F |` ( A [,] B ) ) e. ( ( A [,] B ) -cn-> RR ) )
  hypothesis gcmvthres.9 |- ( ph -> ( G |` ( A [,] B ) ) e. ( ( A [,] B ) -cn-> RR ) )
  hypothesis gcmvthres.10 |- ( ph -> ( A (,) B ) C_ dom ( RR _D F ) )
  hypothesis gcmvthres.11 |- ( ph -> ( A (,) B ) C_ dom ( RR _D G ) )
  |- ( ph -> E. x e. ( A (,) B ) ( ( ( F ` B ) - ( F ` A ) ) x. ( ( RR _D G ) ` x ) ) = ( ( ( G `
      B ) - ( G ` A ) ) x. ( ( RR _D F ) ` x ) ) )
  1 gdviccdm gcmvthres.1 gcmvthres.2 gcmvthres.3 gcmvthres.6 gcmvthres.10 |- ( ph -> dom ( RR _D (
      F |` ( A [,] B ) ) ) = ( A (,) B ) )
  2 gdviccdm gcmvthres.1 gcmvthres.2 gcmvthres.3 gcmvthres.7 gcmvthres.11 |- ( ph -> dom ( RR _D (
      G |` ( A [,] B ) ) ) = ( A (,) B ) )
  3 cmvth gcmvthres.2 gcmvthres.3 gcmvthres.4 gcmvthres.8 gcmvthres.9 1 2 |- ( ph -> E. x e. ( A
      (,) B ) ( ( ( ( F |` ( A [,] B ) ) ` B ) - ( ( F |` ( A [,] B ) ) ` A ) ) x. ( ( RR _D ( G
      |` ( A [,] B ) ) ) ` x ) ) = ( ( ( ( G |` ( A [,] B ) ) ` B ) - ( ( G |` ( A [,] B ) ) ` A
      ) ) x. ( ( RR _D ( F |` ( A [,] B ) ) ) ` x ) ) )
  4 gfvicc gcmvthres.2 gcmvthres.3 gcmvthres.4 |- ( ph -> ( ( ( F |` ( A [,] B ) ) ` A ) = ( F `
      A ) /\ ( ( F |` ( A [,] B ) ) ` B ) = ( F ` B ) ) )
  5 simprd 4 |- ( ph -> ( ( F |` ( A [,] B ) ) ` B ) = ( F ` B ) )
  6 simpld 4 |- ( ph -> ( ( F |` ( A [,] B ) ) ` A ) = ( F ` A ) )
  7 oveq12d 5 6 |- ( ph -> ( ( ( F |` ( A [,] B ) ) ` B ) - ( ( F |` ( A [,] B ) ) ` A ) ) = ( (
      F ` B ) - ( F ` A ) ) )
  8 gfvicc gcmvthres.2 gcmvthres.3 gcmvthres.4 |- ( ph -> ( ( ( G |` ( A [,] B ) ) ` A ) = ( G `
      A ) /\ ( ( G |` ( A [,] B ) ) ` B ) = ( G ` B ) ) )
  9 simprd 8 |- ( ph -> ( ( G |` ( A [,] B ) ) ` B ) = ( G ` B ) )
  10 simpld 8 |- ( ph -> ( ( G |` ( A [,] B ) ) ` A ) = ( G ` A ) )
  11 oveq12d 9 10 |- ( ph -> ( ( ( G |` ( A [,] B ) ) ` B ) - ( ( G |` ( A [,] B ) ) ` A ) ) = ( (
      G ` B ) - ( G ` A ) ) )
  12 adantr 7 |- ( ( ph /\ x e. ( A (,) B ) ) -> ( ( ( F |` ( A [,] B ) ) ` B ) - ( ( F |` ( A [,]
      B ) ) ` A ) ) = ( ( F ` B ) - ( F ` A ) ) )
  13 gdviccv gcmvthres.1 gcmvthres.2 gcmvthres.3 gcmvthres.7 |- ( ( ph /\ x e. ( A (,) B ) ) -> ( (
      RR _D ( G |` ( A [,] B ) ) ) ` x ) = ( ( RR _D G ) ` x ) )
  14 oveq12d 12 13 |- ( ( ph /\ x e. ( A (,) B ) ) -> ( ( ( ( F |` ( A [,] B ) ) ` B ) - ( ( F |`
      ( A [,] B ) ) ` A ) ) x. ( ( RR _D ( G |` ( A [,] B ) ) ) ` x ) ) = ( ( ( F ` B ) - ( F `
      A ) ) x. ( ( RR _D G ) ` x ) ) )
  15 adantr 11 |- ( ( ph /\ x e. ( A (,) B ) ) -> ( ( ( G |` ( A [,] B ) ) ` B ) - ( ( G |` ( A [,]
      B ) ) ` A ) ) = ( ( G ` B ) - ( G ` A ) ) )
  16 gdviccv gcmvthres.1 gcmvthres.2 gcmvthres.3 gcmvthres.6 |- ( ( ph /\ x e. ( A (,) B ) ) -> ( (
      RR _D ( F |` ( A [,] B ) ) ) ` x ) = ( ( RR _D F ) ` x ) )
  17 oveq12d 15 16 |- ( ( ph /\ x e. ( A (,) B ) ) -> ( ( ( ( G |` ( A [,] B ) ) ` B ) - ( ( G |`
      ( A [,] B ) ) ` A ) ) x. ( ( RR _D ( F |` ( A [,] B ) ) ) ` x ) ) = ( ( ( G ` B ) - ( G `
      A ) ) x. ( ( RR _D F ) ` x ) ) )
  18 eqeq12d 14 17 |- ( ( ph /\ x e. ( A (,) B ) ) -> ( ( ( ( ( F |` ( A [,] B ) ) ` B ) - ( ( F
      |` ( A [,] B ) ) ` A ) ) x. ( ( RR _D ( G |` ( A [,] B ) ) ) ` x ) ) = ( ( ( ( G |` ( A [,]
      B ) ) ` B ) - ( ( G |` ( A [,] B ) ) ` A ) ) x. ( ( RR _D ( F |` ( A [,] B ) ) ) ` x ) ) <->
      ( ( ( F ` B ) - ( F ` A ) ) x. ( ( RR _D G ) ` x ) ) = ( ( ( G ` B ) - ( G ` A ) ) x. ( (
      RR _D F ) ` x ) ) ) )
  19 rexbidva 18 |- ( ph -> ( E. x e. ( A (,) B ) ( ( ( ( F |` ( A [,] B ) ) ` B ) - ( ( F |` ( A
      [,] B ) ) ` A ) ) x. ( ( RR _D ( G |` ( A [,] B ) ) ) ` x ) ) = ( ( ( ( G |` ( A [,] B ) )
      ` B ) - ( ( G |` ( A [,] B ) ) ` A ) ) x. ( ( RR _D ( F |` ( A [,] B ) ) ) ` x ) ) <-> E. x
      e. ( A (,) B ) ( ( ( F ` B ) - ( F ` A ) ) x. ( ( RR _D G ) ` x ) ) = ( ( ( G ` B ) - ( G
      ` A ) ) x. ( ( RR _D F ) ` x ) ) ) )
  20 mpbid 3 19 |- ( ph -> E. x e. ( A (,) B ) ( ( ( F ` B ) - ( F ` A ) ) x. ( ( RR _D G ) ` x
      ) ) = ( ( ( G ` B ) - ( G ` A ) ) x. ( ( RR _D F ) ` x ) ) )

# Rolle's theorem, `grolle`, said in the same way of a function on any
# domain holding [ A , B ].
lemma grollepart
  hypothesis grollepart.1 |- ( ph -> D C_ RR )
  hypothesis grollepart.2 |- ( ph -> A e. RR )
  hypothesis grollepart.3 |- ( ph -> B e. RR )
  hypothesis grollepart.4 |- ( ph -> A < B )
  hypothesis grollepart.5 |- ( ph -> ( A [,] B ) C_ D )
  hypothesis grollepart.6 |- ( ph -> F : D --> RR )
  hypothesis grollepart.7 |- ( ph -> ( F |` ( A [,] B ) ) e. ( ( A [,] B ) -cn-> RR ) )
  hypothesis grollepart.8 |- ( ph -> ( A (,) B ) C_ dom ( RR _D F ) )
  hypothesis grollepart.9 |- ( ph -> ( F ` A ) = ( F ` B ) )
  |- ( ph -> E. x e. ( A (,) B ) ( ( RR _D F ) ` x ) = 0 )
  1 gdviccdm grollepart.1 grollepart.2 grollepart.3 grollepart.6 grollepart.8 |- ( ph -> dom ( RR
      _D ( F |` ( A [,] B ) ) ) = ( A (,) B ) )
  2 gfvicc grollepart.2 grollepart.3 grollepart.4 |- ( ph -> ( ( ( F |` ( A [,] B ) ) ` A ) = ( F
      ` A ) /\ ( ( F |` ( A [,] B ) ) ` B ) = ( F ` B ) ) )
  3 simpld 2 |- ( ph -> ( ( F |` ( A [,] B ) ) ` A ) = ( F ` A ) )
  4 simprd 2 |- ( ph -> ( ( F |` ( A [,] B ) ) ` B ) = ( F ` B ) )
  5 3eqtr4d grollepart.9 3 4 |- ( ph -> ( ( F |` ( A [,] B ) ) ` A ) = ( ( F |` ( A [,] B ) ) ` B
      ) )
  6 rolle grollepart.2 grollepart.3 grollepart.4 grollepart.7 1 5 |- ( ph -> E. x e. ( A (,) B ) (
      ( RR _D ( F |` ( A [,] B ) ) ) ` x ) = 0 )
  7 gdviccv grollepart.1 grollepart.2 grollepart.3 grollepart.6 |- ( ( ph /\ x e. ( A (,) B ) ) ->
      ( ( RR _D ( F |` ( A [,] B ) ) ) ` x ) = ( ( RR _D F ) ` x ) )
  8 eqeq1d 7 |- ( ( ph /\ x e. ( A (,) B ) ) -> ( ( ( RR _D ( F |` ( A [,] B ) ) ) ` x ) = 0 <-> (
      ( RR _D F ) ` x ) = 0 ) )
  9 rexbidva 8 |- ( ph -> ( E. x e. ( A (,) B ) ( ( RR _D ( F |` ( A [,] B ) ) ) ` x ) = 0 <-> E. x
      e. ( A (,) B ) ( ( RR _D F ) ` x ) = 0 ) )
  10 mpbid 6 9 |- ( ph -> E. x e. ( A (,) B ) ( ( RR _D F ) ` x ) = 0 )

# `geliccre`: a member of a closed interval between two reals is real
# (`elicc2`). A letter introduced in [a, b] is a real number by it, its
# ends real as the page says them once (`rules::INTERVAL_WITHIN`); one
# introduced in (a, b) is by `elioore`, which asks nothing of the ends.
lemma geliccre
  |- ( ( A e. RR /\ B e. RR /\ C e. ( A [,] B ) ) -> C e. RR )
  1 elicc2 |- ( ( A e. RR /\ B e. RR ) -> ( C e. ( A [,] B ) <-> ( C e. RR /\ A <_ C /\ C <_ B ) ) )
  2 biimp3a 1 |- ( ( A e. RR /\ B e. RR /\ C e. ( A [,] B ) ) -> ( C e. RR /\ A <_ C /\ C <_ B ) )
  3 simp1d 2 |- ( ( A e. RR /\ B e. RR /\ C e. ( A [,] B ) ) -> C e. RR )

# A constant function is continuous (`cncfmptc`), said into RR at once.
lemma gcncfconst
  hypothesis gcncfconst.1 |- ( ph -> D C_ RR )
  hypothesis gcncfconst.2 |- ( ph -> C e. RR )
  hypothesis gcncfconst.3 |- ( ph -> G : D --> RR )
  hypothesis gcncfconst.4 |- ( ph -> A. x e. D ( G ` x ) = C )
  |- ( ph -> G e. ( D -cn-> RR ) )
  1 ffnd gcncfconst.3 |- ( ph -> G Fn D )
  2 dffn5 |- ( G Fn D <-> G = ( x e. D |-> ( G ` x ) ) )
  3 sylib 1 2 |- ( ph -> G = ( x e. D |-> ( G ` x ) ) )
  4 r19.21bi gcncfconst.4 |- ( ( ph /\ x e. D ) -> ( G ` x ) = C )
  5 mpteq2dva 4 |- ( ph -> ( x e. D |-> ( G ` x ) ) = ( x e. D |-> C ) )
  6 eqtrd 3 5 |- ( ph -> G = ( x e. D |-> C ) )
  7 ax-resscn |- RR C_ CC
  8 a1i 7 |- ( ph -> RR C_ CC )
  9 sstrd gcncfconst.1 8 |- ( ph -> D C_ CC )
  10 cncfmptc |- ( ( C e. RR /\ D C_ CC /\ RR C_ CC ) -> ( x e. D |-> C ) e. ( D -cn-> RR ) )
  11 syl3anc gcncfconst.2 9 8 10 |- ( ph -> ( x e. D |-> C ) e. ( D -cn-> RR ) )
  12 eqeltrd 6 11 |- ( ph -> G e. ( D -cn-> RR ) )

lemma gcncfconstres
  hypothesis gcncfconstres.1 |- ( ph -> D C_ RR )
  hypothesis gcncfconstres.2 |- ( ph -> C e. RR )
  hypothesis gcncfconstres.3 |- ( ph -> G : D --> RR )
  hypothesis gcncfconstres.4 |- ( ph -> A. x e. D ( G ` x ) = C )
  |- ( ph -> ( G |` D ) e. ( D -cn-> RR ) )
  1 gcncfconst gcncfconstres.1 gcncfconstres.2 gcncfconstres.3 gcncfconstres.4 |- ( ph -> G e. ( D -cn-> RR ) )
  2 gcncfres gcncfconstres.3 |- ( ph -> ( ( G |` D ) e. ( D -cn-> RR ) <-> G e. ( D -cn-> RR ) ) )
  3 mpbird 1 2 |- ( ph -> ( G |` D ) e. ( D -cn-> RR ) )

# A power with an exponent in NN0 is continuous on CC (`expcncf`), and so on
# any part of it (`rescncf`).
lemma gcncfexp
  hypothesis gcncfexp.1 |- ( ph -> D C_ RR )
  hypothesis gcncfexp.2 |- ( ph -> N e. NN0 )
  hypothesis gcncfexp.3 |- ( ph -> G : D --> RR )
  hypothesis gcncfexp.4 |- ( ph -> A. x e. D ( G ` x ) = ( x ^ N ) )
  |- ( ph -> G e. ( D -cn-> RR ) )
  1 ffnd gcncfexp.3 |- ( ph -> G Fn D )
  2 dffn5 |- ( G Fn D <-> G = ( x e. D |-> ( G ` x ) ) )
