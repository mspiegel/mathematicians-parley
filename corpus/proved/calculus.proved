  7 ax-mp 5 6 |- Fun ( RR _D F )
  8 funfvbrb |- ( Fun ( RR _D F ) -> ( C e. dom ( RR _D F ) <-> C ( RR _D F ) ( ( RR _D F ) ` C ) )
      )
  9 ax-mp 7 8 |- ( C e. dom ( RR _D F ) <-> C ( RR _D F ) ( ( RR _D F ) ` C ) )
  10 sylib gdvaddbr.4 9 |- ( ph -> C ( RR _D F ) ( ( RR _D F ) ` C ) )
  11 dvf |- ( RR _D G ) : dom ( RR _D G ) --> CC
  12 ffun |- ( ( RR _D G ) : dom ( RR _D G ) --> CC -> Fun ( RR _D G ) )
  13 ax-mp 11 12 |- Fun ( RR _D G )
  14 funfvbrb |- ( Fun ( RR _D G ) -> ( C e. dom ( RR _D G ) <-> C ( RR _D G ) ( ( RR _D G ) ` C ) )
      )
  15 ax-mp 13 14 |- ( C e. dom ( RR _D G ) <-> C ( RR _D G ) ( ( RR _D G ) ` C ) )
  16 sylib gdvaddbr.5 15 |- ( ph -> C ( RR _D G ) ( ( RR _D G ) ` C ) )
  17 eqid |- ( TopOpen ` CCfld ) = ( TopOpen ` CCfld )
  18 dvaddbr 3 gdvaddbr.1 4 gdvaddbr.1 2 10 16 17 |- ( ph -> C ( RR _D ( F oF + G ) ) ( ( ( RR _D F
      ) ` C ) + ( ( RR _D G ) ` C ) ) )

lemma gdvadd
  hypothesis gdvadd.1 |- ( ph -> D C_ RR )
  hypothesis gdvadd.2 |- ( ph -> H : D --> RR )
  hypothesis gdvadd.3 |- ( ph -> F : D --> RR )
  hypothesis gdvadd.4 |- ( ph -> G : D --> RR )
  hypothesis gdvadd.5 |- ( ph -> A. x e. D ( H ` x ) = ( ( F ` x ) + ( G ` x ) ) )
  hypothesis gdvadd.6 |- ( ph -> U C_ dom ( RR _D F ) )
  hypothesis gdvadd.7 |- ( ph -> U C_ dom ( RR _D G ) )
  |- ( ph -> U C_ dom ( RR _D H ) )
  1 reldv |- Rel ( RR _D H )
  2 a1i 1 |- ( ( ph /\ x e. U ) -> Rel ( RR _D H ) )
  3 adantr gdvadd.1 |- ( ( ph /\ x e. U ) -> D C_ RR )
  4 adantr gdvadd.3 |- ( ( ph /\ x e. U ) -> F : D --> RR )
  5 adantr gdvadd.4 |- ( ( ph /\ x e. U ) -> G : D --> RR )
  6 adantr gdvadd.6 |- ( ( ph /\ x e. U ) -> U C_ dom ( RR _D F ) )
  7 simpr |- ( ( ph /\ x e. U ) -> x e. U )
  8 sseldd 6 7 |- ( ( ph /\ x e. U ) -> x e. dom ( RR _D F ) )
  9 adantr gdvadd.7 |- ( ( ph /\ x e. U ) -> U C_ dom ( RR _D G ) )
  10 sseldd 9 7 |- ( ( ph /\ x e. U ) -> x e. dom ( RR _D G ) )
  11 gdvaddbr 3 4 5 8 10 |- ( ( ph /\ x e. U ) -> x ( RR _D ( F oF + G ) ) ( ( ( RR _D F ) ` x ) + (
      ( RR _D G ) ` x ) ) )
  12 gdvaddof gdvadd.1 gdvadd.2 gdvadd.3 gdvadd.4 gdvadd.5 |- ( ph -> H = ( F oF + G ) )
  13 adantr 12 |- ( ( ph /\ x e. U ) -> H = ( F oF + G ) )
  14 oveq2d 13 |- ( ( ph /\ x e. U ) -> ( RR _D H ) = ( RR _D ( F oF + G ) ) )
  15 breqd 14 |- ( ( ph /\ x e. U ) -> ( x ( RR _D H ) ( ( ( RR _D F ) ` x ) + ( ( RR _D G ) ` x ) )
      <-> x ( RR _D ( F oF + G ) ) ( ( ( RR _D F ) ` x ) + ( ( RR _D G ) ` x ) ) ) )
  16 mpbird 11 15 |- ( ( ph /\ x e. U ) -> x ( RR _D H ) ( ( ( RR _D F ) ` x ) + ( ( RR _D G ) ` x )
      ) )
  17 releldm |- ( ( Rel ( RR _D H ) /\ x ( RR _D H ) ( ( ( RR _D F ) ` x ) + ( ( RR _D G ) ` x ) ) )
      -> x e. dom ( RR _D H ) )
  18 syl2anc 2 16 17 |- ( ( ph /\ x e. U ) -> x e. dom ( RR _D H ) )
  19 ex 18 |- ( ph -> ( x e. U -> x e. dom ( RR _D H ) ) )
  20 ssrdv 19 |- ( ph -> U C_ dom ( RR _D H ) )

lemma gdvaddv
  hypothesis gdvaddv.1 |- ( ph -> D C_ RR )
  hypothesis gdvaddv.2 |- ( ph -> H : D --> RR )
  hypothesis gdvaddv.3 |- ( ph -> F : D --> RR )
  hypothesis gdvaddv.4 |- ( ph -> G : D --> RR )
