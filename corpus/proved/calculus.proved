  2 reseq1d 1 |- ( ph -> ( F |` U ) = ( ( x e. D |-> ( F ` x ) ) |` U ) )
  3 resmpt |- ( U C_ D -> ( ( x e. D |-> ( F ` x ) ) |` U ) = ( x e. U |-> ( F ` x ) ) )
  4 syl gcncfmappart.2 3 |- ( ph -> ( ( x e. D |-> ( F ` x ) ) |` U ) = ( x e. U |-> ( F ` x ) ) )
  5 eqtrd 2 4 |- ( ph -> ( F |` U ) = ( x e. U |-> ( F ` x ) ) )
