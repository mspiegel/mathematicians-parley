  2 a1i 1 |- ( ph -> RR C_ CC )
  3 sstrd gcncfre.1 2 |- ( ph -> A C_ CC )
  4 elcncf2 |- ( ( A C_ CC /\ RR C_ CC ) -> ( F e. ( A -cn-> RR ) <-> ( F : A --> RR /\ A. x e. A A. y e. RR+ E. z e. RR+ A. t e. A ( ( abs ` ( t - x ) ) < z -> ( abs ` ( ( F ` t ) - ( F ` x ) ) ) < y ) ) ) )
  5 syl2anc 3 2 4 |- ( ph -> ( F e. ( A -cn-> RR ) <-> ( F : A --> RR /\ A. x e. A A. y e. RR+ E. z e. RR+ A. t e. A ( ( abs ` ( t - x ) ) < z -> ( abs ` ( ( F ` t ) - ( F ` x ) ) ) < y ) ) ) )
  6 gcncfres gcncfre.2 |- ( ph -> ( ( F |` A ) e. ( A -cn-> RR ) <-> F e. ( A -cn-> RR ) ) )
  7 bitrd 6 5 |- ( ph -> ( ( F |` A ) e. ( A -cn-> RR ) <-> ( F : A --> RR /\ A. x e. A A. y e. RR+ E. z e. RR+ A. t e. A ( ( abs ` ( t - x ) ) < z -> ( abs ` ( ( F ` t ) - ( F ` x ) ) ) < y ) ) ) )

