lemma gdvatan
  hypothesis gdvatan.1 |- ( ph -> D C_ RR )
  hypothesis gdvatan.2 |- ( ph -> U C_ D )
  hypothesis gdvatan.3 |- ( ph -> U e. ( topGen ` ran (,) ) )
