  hypothesis gdvrepart.3 |- ( ph -> U C_ dom ( RR _D F ) )
  hypothesis gdvrepart.4 |- ( ph -> C e. U )
  |- ( ph -> ( ( RR _D F ) ` C ) e. RR )
