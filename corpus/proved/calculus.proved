# A function F on U ⊆ ℝ open, differentiable off a point C of U and with
# its limit at C its value there, is continuous on U: at C by `cnplimc`
# and `limcdif`, the function off C being F's own; elsewhere because a
# function is continuous where it is differentiable (`dvcnp2`), which G,
# agreeing with F on the open U ∖ { C }, is (`gdvloc`). `cnlimc` puts the
# points together. The page says it of f off c and F on U, here F and G.
lemma gcncfext
  hypothesis gcncfext.1 |- ( ph -> U C_ RR )
  hypothesis gcncfext.2 |- ( ph -> U e. ( topGen ` ran (,) ) )
  hypothesis gcncfext.3 |- ( ph -> C e. U )
  hypothesis gcncfext.4 |- ( ph -> L e. RR )
  hypothesis gcncfext.5 |- ( ph -> F : ( U \ { C } ) --> RR )
  hypothesis gcncfext.6 |- ( ph -> G : U --> RR )
  hypothesis gcncfext.7 |- ( ph -> A. x e. ( U \ { C } ) ( G ` x ) = ( F ` x ) )
  hypothesis gcncfext.8 |- ( ph -> ( G ` C ) = L )
  hypothesis gcncfext.9 |- ( ph -> ( U \ { C } ) C_ dom ( RR _D F ) )
  hypothesis gcncfext.10 |- ( ph -> L e. ( F limCC C ) )
  |- ( ph -> ( G |` U ) e. ( U -cn-> RR ) )
