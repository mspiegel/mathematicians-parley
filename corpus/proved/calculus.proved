  hypothesis gdvaddv.6 |- ( ph -> U C_ dom ( RR _D F ) )
  hypothesis gdvaddv.7 |- ( ph -> U C_ dom ( RR _D G ) )
  |- ( ph -> A. x e. U ( ( RR _D H ) ` x ) = ( ( ( RR _D F ) ` x ) + ( ( RR _D G ) ` x ) ) )
  1 dvf |- ( RR _D H ) : dom ( RR _D H ) --> CC
  2 ffun |- ( ( RR _D H ) : dom ( RR _D H ) --> CC -> Fun ( RR _D H ) )
  3 ax-mp 1 2 |- Fun ( RR _D H )
  4 a1i 3 |- ( ( ph /\ x e. U ) -> Fun ( RR _D H ) )
  5 adantr gdvaddv.1 |- ( ( ph /\ x e. U ) -> D C_ RR )
  6 adantr gdvaddv.3 |- ( ( ph /\ x e. U ) -> F : D --> RR )
  7 adantr gdvaddv.4 |- ( ( ph /\ x e. U ) -> G : D --> RR )
  8 adantr gdvaddv.6 |- ( ( ph /\ x e. U ) -> U C_ dom ( RR _D F ) )
  9 simpr |- ( ( ph /\ x e. U ) -> x e. U )
  10 sseldd 8 9 |- ( ( ph /\ x e. U ) -> x e. dom ( RR _D F ) )
  11 adantr gdvaddv.7 |- ( ( ph /\ x e. U ) -> U C_ dom ( RR _D G ) )
  12 sseldd 11 9 |- ( ( ph /\ x e. U ) -> x e. dom ( RR _D G ) )
  13 gdvaddbr 5 6 7 10 12 |- ( ( ph /\ x e. U ) -> x ( RR _D ( F oF + G ) ) ( ( ( RR _D F ) ` x ) +
      ( ( RR _D G ) ` x ) ) )
  14 gdvaddof gdvaddv.1 gdvaddv.2 gdvaddv.3 gdvaddv.4 gdvaddv.5 |- ( ph -> H = ( F oF + G ) )
  15 adantr 14 |- ( ( ph /\ x e. U ) -> H = ( F oF + G ) )
  16 oveq2d 15 |- ( ( ph /\ x e. U ) -> ( RR _D H ) = ( RR _D ( F oF + G ) ) )
  17 breqd 16 |- ( ( ph /\ x e. U ) -> ( x ( RR _D H ) ( ( ( RR _D F ) ` x ) + ( ( RR _D G ) ` x ) )
      <-> x ( RR _D ( F oF + G ) ) ( ( ( RR _D F ) ` x ) + ( ( RR _D G ) ` x ) ) ) )
  18 mpbird 13 17 |- ( ( ph /\ x e. U ) -> x ( RR _D H ) ( ( ( RR _D F ) ` x ) + ( ( RR _D G ) ` x )
      ) )
  19 funbrfv |- ( Fun ( RR _D H ) -> ( x ( RR _D H ) ( ( ( RR _D F ) ` x ) + ( ( RR _D G ) ` x ) )
      -> ( ( RR _D H ) ` x ) = ( ( ( RR _D F ) ` x ) + ( ( RR _D G ) ` x ) ) ) )
  20 imp 19 |- ( ( Fun ( RR _D H ) /\ x ( RR _D H ) ( ( ( RR _D F ) ` x ) + ( ( RR _D G ) ` x ) ) )
      -> ( ( RR _D H ) ` x ) = ( ( ( RR _D F ) ` x ) + ( ( RR _D G ) ` x ) ) )
  21 syl2anc 4 18 20 |- ( ( ph /\ x e. U ) -> ( ( RR _D H ) ` x ) = ( ( ( RR _D F ) ` x ) + ( ( RR
      _D G ) ` x ) ) )
  22 ralrimiva 21 |- ( ph -> A. x e. U ( ( RR _D H ) ` x ) = ( ( ( RR _D F ) ` x ) + ( ( RR _D G ) `
      x ) ) )

lemma gdvlinres
  hypothesis gdvlinres.1 |- ( ph -> D C_ RR )
  hypothesis gdvlinres.2 |- ( ph -> U C_ D )
  hypothesis gdvlinres.3 |- ( ph -> U e. ( topGen ` ran (,) ) )
  hypothesis gdvlinres.4 |- ( ph -> M e. RR )
  hypothesis gdvlinres.5 |- ( ph -> G : D --> RR )
  hypothesis gdvlinres.6 |- ( ph -> A. x e. D ( G ` x ) = ( M x. x ) )
  |- ( ph -> ( ( RR _D G ) |` U ) = ( x e. U |-> M ) )
  1 ax-resscn |- RR C_ CC
  2 a1i 1 |- ( ph -> RR C_ CC )
  3 fssd gdvlinres.5 2 |- ( ph -> G : D --> CC )
  4 jca 2 3 |- ( ph -> ( RR C_ CC /\ G : D --> CC ) )
  5 sstrd gdvlinres.2 gdvlinres.1 |- ( ph -> U C_ RR )
  6 jca gdvlinres.1 5 |- ( ph -> ( D C_ RR /\ U C_ RR ) )
  7 jca 4 6 |- ( ph -> ( ( RR C_ CC /\ G : D --> CC ) /\ ( D C_ RR /\ U C_ RR ) ) )
  8 eqid |- ( TopOpen ` CCfld ) = ( TopOpen ` CCfld )
  9 tgioo2 8 |- ( topGen ` ran (,) ) = ( ( TopOpen ` CCfld ) |`t RR )
  10 dvres 8 9 |- ( ( ( RR C_ CC /\ G : D --> CC ) /\ ( D C_ RR /\ U C_ RR ) ) -> ( RR _D ( G |` U )
      ) = ( ( RR _D G ) |` ( ( int ` ( topGen ` ran (,) ) ) ` U ) ) )
  11 syl 7 10 |- ( ph -> ( RR _D ( G |` U ) ) = ( ( RR _D G ) |` ( ( int ` ( topGen ` ran (,) ) ) `
      U ) ) )
  12 retop |- ( topGen ` ran (,) ) e. Top
  13 a1i 12 |- ( ph -> ( topGen ` ran (,) ) e. Top )
  14 isopn3i |- ( ( ( topGen ` ran (,) ) e. Top /\ U e. ( topGen ` ran (,) ) ) -> ( ( int ` ( topGen
      ` ran (,) ) ) ` U ) = U )
  15 syl2anc 13 gdvlinres.3 14 |- ( ph -> ( ( int ` ( topGen ` ran (,) ) ) ` U ) = U )
  16 reseq2d 15 |- ( ph -> ( ( RR _D G ) |` ( ( int ` ( topGen ` ran (,) ) ) ` U ) ) = ( ( RR _D G )
      |` U ) )
  17 eqtrd 11 16 |- ( ph -> ( RR _D ( G |` U ) ) = ( ( RR _D G ) |` U ) )
  18 eqcomd 17 |- ( ph -> ( ( RR _D G ) |` U ) = ( RR _D ( G |` U ) ) )
  19 ffnd gdvlinres.5 |- ( ph -> G Fn D )
  20 dffn5 |- ( G Fn D <-> G = ( x e. D |-> ( G ` x ) ) )
  21 sylib 19 20 |- ( ph -> G = ( x e. D |-> ( G ` x ) ) )
  22 r19.21bi gdvlinres.6 |- ( ( ph /\ x e. D ) -> ( G ` x ) = ( M x. x ) )
  23 mpteq2dva 22 |- ( ph -> ( x e. D |-> ( G ` x ) ) = ( x e. D |-> ( M x. x ) ) )
  24 eqtrd 21 23 |- ( ph -> G = ( x e. D |-> ( M x. x ) ) )
  25 reseq1d 24 |- ( ph -> ( G |` U ) = ( ( x e. D |-> ( M x. x ) ) |` U ) )
  26 resmpt |- ( U C_ D -> ( ( x e. D |-> ( M x. x ) ) |` U ) = ( x e. U |-> ( M x. x ) ) )
  27 syl gdvlinres.2 26 |- ( ph -> ( ( x e. D |-> ( M x. x ) ) |` U ) = ( x e. U |-> ( M x. x ) ) )
  28 eqtrd 25 27 |- ( ph -> ( G |` U ) = ( x e. U |-> ( M x. x ) ) )
  29 oveq2d 28 |- ( ph -> ( RR _D ( G |` U ) ) = ( RR _D ( x e. U |-> ( M x. x ) ) ) )
