# A sequence with a limit is bounded, for `proved.mm`.
#
# The page says it as a textbook does: if x(n) → L as n → ∞ then some B is
# at least every term, or at least the absolute value of every term.
# set.mm's `climbdd` bounds the absolute values of a convergent sequence
# over an upper integer set, and ℕ is the upper integers from 1 (`nnuz`);
# that is `gclimbddabs`. Each term is its own absolute value or less
# (`leabs`), which gives `gclimbdd`. The sequence the page writes as a rule in n is set.mm's map
# ( n e. NN |-> B ), and its value at m is B with m for n (`fvmptg`), which
# the lemma asks of the caller as set.mm's own lemmas do, ( n = m -> B = C ).
# The map's letter and the bound's are two, so a scope holding the limit,
# whose map binds n, never meets a condition on n. It is stated as a
# deduction, as `climnnre` is.

$( Bounds: a sequence with a limit is bounded, in absolute value and
   above. $)
$( The map binds n and the bound counts by m, each kept out of what the
   other names; the bound x is apart from all three classes and from the
   hypotheses. $)
$d m n x $.
$d m B $.  $d n C $.
$d x A $.  $d x B $.  $d x C $.
$d m ph $.  $d x ph $.
# `gclimbddabs`: ( ph -> E. x e. RR A. m e. NN ( abs ` C ) <_ x ), from
# every C real, the map ( n e. NN |-> B ) tending to A, and C being B at m.
lemma gclimbddabs
  hypothesis gclimbddabs.1 |- ( ( ph /\ m e. NN ) -> C e. RR )
  hypothesis gclimbddabs.2 |- ( ph -> ( n e. NN |-> B ) ~~> A )
  hypothesis gclimbddabs.3 |- ( n = m -> B = C )
  |- ( ph -> E. x e. RR A. m e. NN ( abs ` C ) <_ x )
  1 1z |- 1 e. ZZ
  2 a1i 1 |- ( ph -> 1 e. ZZ )
  3 climrel |- Rel ~~>
  4 releldmi 3 |- ( ( n e. NN |-> B ) ~~> A -> ( n e. NN |-> B ) e. dom ~~> )
  5 syl gclimbddabs.2 4 |- ( ph -> ( n e. NN |-> B ) e. dom ~~> )
  6 simpr |- ( ( ph /\ m e. NN ) -> m e. NN )
  7 eqid |- ( n e. NN |-> B ) = ( n e. NN |-> B )
  8 fvmptg gclimbddabs.3 7 |- ( ( m e. NN /\ C e. RR ) -> ( ( n e. NN |-> B ) ` m ) = C )
  9 syl2anc 6 gclimbddabs.1 8 |- ( ( ph /\ m e. NN ) -> ( ( n e. NN |-> B ) ` m ) = C )
  10 recnd gclimbddabs.1 |- ( ( ph /\ m e. NN ) -> C e. CC )
  11 eqeltrd 9 10 |- ( ( ph /\ m e. NN ) -> ( ( n e. NN |-> B ) ` m ) e. CC )
  12 ralrimiva 11 |- ( ph -> A. m e. NN ( ( n e. NN |-> B ) ` m ) e. CC )
  13 nnuz |- NN = ( ZZ>= ` 1 )
  14 climbdd 13 |- ( ( 1 e. ZZ /\ ( n e. NN |-> B ) e. dom ~~> /\ A. m e. NN ( ( n e. NN |-> B ) ` m
      ) e. CC ) -> E. x e. RR A. m e. NN ( abs ` ( ( n e. NN |-> B ) ` m ) ) <_ x )
  15 syl3anc 2 5 12 14 |- ( ph -> E. x e. RR A. m e. NN ( abs ` ( ( n e. NN |-> B ) ` m ) ) <_ x )
  16 adantlr 9 |- ( ( ( ph /\ x e. RR ) /\ m e. NN ) -> ( ( n e. NN |-> B ) ` m ) = C )
  17 fveq2d 16 |- ( ( ( ph /\ x e. RR ) /\ m e. NN ) -> ( abs ` ( ( n e. NN |-> B ) ` m ) ) = ( abs
      ` C ) )
  18 breq1d 17 |- ( ( ( ph /\ x e. RR ) /\ m e. NN ) -> ( ( abs ` ( ( n e. NN |-> B ) ` m ) ) <_ x
      <-> ( abs ` C ) <_ x ) )
  19 ralbidva 18 |- ( ( ph /\ x e. RR ) -> ( A. m e. NN ( abs ` ( ( n e. NN |-> B ) ` m ) ) <_ x <->
      A. m e. NN ( abs ` C ) <_ x ) )
  20 rexbidva 19 |- ( ph -> ( E. x e. RR A. m e. NN ( abs ` ( ( n e. NN |-> B ) ` m ) ) <_ x <-> E. x
      e. RR A. m e. NN ( abs ` C ) <_ x ) )
  21 mpbid 15 20 |- ( ph -> E. x e. RR A. m e. NN ( abs ` C ) <_ x )

# `gclimbdd`: ( ph -> E. x e. RR A. m e. NN C <_ x ), the same, each term at
# most its absolute value (`leabs`).
lemma gclimbdd
  hypothesis gclimbdd.1 |- ( ( ph /\ m e. NN ) -> C e. RR )
  hypothesis gclimbdd.2 |- ( ph -> ( n e. NN |-> B ) ~~> A )
  hypothesis gclimbdd.3 |- ( n = m -> B = C )
  |- ( ph -> E. x e. RR A. m e. NN C <_ x )
  1 gclimbddabs gclimbdd.1 gclimbdd.2 gclimbdd.3 |- ( ph -> E. x e. RR A. m e. NN ( abs ` C ) <_ x )
  2 adantlr gclimbdd.1 |- ( ( ( ph /\ x e. RR ) /\ m e. NN ) -> C e. RR )
  3 leabs |- ( C e. RR -> C <_ ( abs ` C ) )
  4 syl 2 3 |- ( ( ( ph /\ x e. RR ) /\ m e. NN ) -> C <_ ( abs ` C ) )
  5 recnd 2 |- ( ( ( ph /\ x e. RR ) /\ m e. NN ) -> C e. CC )
  6 abscld 5 |- ( ( ( ph /\ x e. RR ) /\ m e. NN ) -> ( abs ` C ) e. RR )
  7 simplr |- ( ( ( ph /\ x e. RR ) /\ m e. NN ) -> x e. RR )
  8 letr |- ( ( C e. RR /\ ( abs ` C ) e. RR /\ x e. RR ) -> ( ( C <_ ( abs ` C ) /\ ( abs ` C ) <_ x
      ) -> C <_ x ) )
  9 syl3anc 2 6 7 8 |- ( ( ( ph /\ x e. RR ) /\ m e. NN ) -> ( ( C <_ ( abs ` C ) /\ ( abs ` C ) <_
      x ) -> C <_ x ) )
  10 mpand 4 9 |- ( ( ( ph /\ x e. RR ) /\ m e. NN ) -> ( ( abs ` C ) <_ x -> C <_ x ) )
  11 ralimdva 10 |- ( ( ph /\ x e. RR ) -> ( A. m e. NN ( abs ` C ) <_ x -> A. m e. NN C <_ x ) )
  12 reximdva 11 |- ( ph -> ( E. x e. RR A. m e. NN ( abs ` C ) <_ x -> E. x e. RR A. m e. NN C <_ x
      ) )
  13 mpd 1 12 |- ( ph -> E. x e. RR A. m e. NN C <_ x )

