  16 negcld 15 |- ( ( ( A e. RR /\ N e. NN /\ -. 2 || N ) /\ -. 0 <_ A ) -> -u A e. CC )
  17 adantr 2 |- ( ( ( A e. RR /\ N e. NN /\ -. 2 || N ) /\ -. 0 <_ A ) -> N e. NN )
  18 nnrecred 17 |- ( ( ( A e. RR /\ N e. NN /\ -. 2 || N ) /\ -. 0 <_ A ) -> ( 1 / N ) e. RR )
  19 recnd 18 |- ( ( ( A e. RR /\ N e. NN /\ -. 2 || N ) /\ -. 0 <_ A ) -> ( 1 / N ) e. CC )
