  5 iftrued 4 |- ( ( ( A e. RR /\ N e. NN /\ -. 2 || N ) /\ 0 <_ A ) -> if ( 0 <_ A , ( A ^c ( 1 / N
      ) ) , -u ( -u A ^c ( 1 / N ) ) ) = ( A ^c ( 1 / N ) ) )
  6 oveq1d 5 |- ( ( ( A e. RR /\ N e. NN /\ -. 2 || N ) /\ 0 <_ A ) -> ( if ( 0 <_ A , ( A ^c ( 1 /
      N ) ) , -u ( -u A ^c ( 1 / N ) ) ) ^ N ) = ( ( A ^c ( 1 / N ) ) ^ N ) )
  7 recnd 1 |- ( ( A e. RR /\ N e. NN /\ -. 2 || N ) -> A e. CC )
  8 cxproot |- ( ( A e. CC /\ N e. NN ) -> ( ( A ^c ( 1 / N ) ) ^ N ) = A )
