# Real roots of odd index, for `proved.mm`.
#
# The page's ⁿ√x is the real n-th root: x^(1/n) where x ≥ 0, and
# −((−x)^(1/n)) where x < 0, which set.mm writes with `if`. set.mm's power
# x^c(1/n) is the principal one, which for a negative x is not real, so
# the root is built from it on each side of 0. Where x ≥ 0 the root is
# that power (`iftrue`); it is real for every real x (`recxpcl` on x or
# on −x); for an odd n its n-th power gives x back (`cxproot`, and
# `oexpneg` for a negative x); and the root of xⁿ is x, since xⁿ has x's
# sign when n is odd, and (xⁿ)^(1/n) = x^(n·(1/n)) = x for x > 0
# (`cxpmul`, `cxpexp`, `cxp1`), and 0 for x = 0 (`0exp`, `0cxp`).
#
# Each is proved for a letter index N, then said of the cube root, N = 3,
# with `3nn` and `n2dvds3`: `gcbrtpw` for
# `mun:stdlib/numbers/cube-root-as-power`, `gcbrtre` for
# `mun:stdlib/numbers/cube-root-real`, `gcbrtexp` for
# `mun:stdlib/numbers/cube-root-cubed`, and `gcbrtcube` for
# `mun:stdlib/numbers/cube-root-of-cube`.

$( Roots: the real N-th root of a real number, for an odd N, is real, is
   the principal power ( 1 / N ) of a number at least 0, has N-th power
   the number, and of an N-th power is the number; and so for the cube
   root. $)

# ( ( A e. RR /\ 0 <_ A ) -> R = ( A ^c ( 1 / N ) ) ), the root of a number
# at least 0 its principal power.
lemma grootpw
  |- ( ( A e. RR /\ 0 <_ A ) -> if ( 0 <_ A , ( A ^c ( 1 / N ) ) , -u ( -u A ^c ( 1 / N ) ) ) = ( A
      ^c ( 1 / N ) ) )
  1 simpr |- ( ( A e. RR /\ 0 <_ A ) -> 0 <_ A )
  2 iftrued 1 |- ( ( A e. RR /\ 0 <_ A ) -> if ( 0 <_ A , ( A ^c ( 1 / N ) ) , -u ( -u A ^c ( 1 / N
      ) ) ) = ( A ^c ( 1 / N ) ) )

# ( ( A e. RR /\ N e. NN ) -> R e. RR ), on each side of 0 by `recxpcl`.
lemma grootre
  |- ( ( A e. RR /\ N e. NN ) -> if ( 0 <_ A , ( A ^c ( 1 / N ) ) , -u ( -u A ^c ( 1 / N ) ) ) e. RR
      )
  1 simpl |- ( ( A e. RR /\ N e. NN ) -> A e. RR )
  2 simpr |- ( ( A e. RR /\ N e. NN ) -> N e. NN )
  3 nnrecred 2 |- ( ( A e. RR /\ N e. NN ) -> ( 1 / N ) e. RR )
  4 adantr 1 |- ( ( ( A e. RR /\ N e. NN ) /\ 0 <_ A ) -> A e. RR )
  5 simpr |- ( ( ( A e. RR /\ N e. NN ) /\ 0 <_ A ) -> 0 <_ A )
  6 adantr 3 |- ( ( ( A e. RR /\ N e. NN ) /\ 0 <_ A ) -> ( 1 / N ) e. RR )
  7 recxpcld 4 5 6 |- ( ( ( A e. RR /\ N e. NN ) /\ 0 <_ A ) -> ( A ^c ( 1 / N ) ) e. RR )
  8 adantr 1 |- ( ( ( A e. RR /\ N e. NN ) /\ -. 0 <_ A ) -> A e. RR )
  9 renegcld 8 |- ( ( ( A e. RR /\ N e. NN ) /\ -. 0 <_ A ) -> -u A e. RR )
  10 simpr |- ( ( ( A e. RR /\ N e. NN ) /\ -. 0 <_ A ) -> -. 0 <_ A )
  11 0red |- ( ( ( A e. RR /\ N e. NN ) /\ -. 0 <_ A ) -> 0 e. RR )
  12 ltnled 8 11 |- ( ( ( A e. RR /\ N e. NN ) /\ -. 0 <_ A ) -> ( A < 0 <-> -. 0 <_ A ) )
  13 mpbird 10 12 |- ( ( ( A e. RR /\ N e. NN ) /\ -. 0 <_ A ) -> A < 0 )
  14 lt0neg1d 8 |- ( ( ( A e. RR /\ N e. NN ) /\ -. 0 <_ A ) -> ( A < 0 <-> 0 < -u A ) )
  15 mpbid 13 14 |- ( ( ( A e. RR /\ N e. NN ) /\ -. 0 <_ A ) -> 0 < -u A )
  16 ltled 11 9 15 |- ( ( ( A e. RR /\ N e. NN ) /\ -. 0 <_ A ) -> 0 <_ -u A )
  17 adantr 3 |- ( ( ( A e. RR /\ N e. NN ) /\ -. 0 <_ A ) -> ( 1 / N ) e. RR )
  18 recxpcld 9 16 17 |- ( ( ( A e. RR /\ N e. NN ) /\ -. 0 <_ A ) -> ( -u A ^c ( 1 / N ) ) e. RR )
  19 renegcld 18 |- ( ( ( A e. RR /\ N e. NN ) /\ -. 0 <_ A ) -> -u ( -u A ^c ( 1 / N ) ) e. RR )
  20 ifclda 7 19 |- ( ( A e. RR /\ N e. NN ) -> if ( 0 <_ A , ( A ^c ( 1 / N ) ) , -u ( -u A ^c ( 1
      / N ) ) ) e. RR )

# ( ( A e. RR /\ N e. NN /\ -. 2 || N ) -> ( R ^ N ) = A ), by `cxproot`
# on A or on -u A, and `oexpneg` to bring the sign out of an odd power.
lemma grootexp
  |- ( ( A e. RR /\ N e. NN /\ -. 2 || N ) -> ( if ( 0 <_ A , ( A ^c ( 1 / N ) ) , -u ( -u A ^c ( 1
      / N ) ) ) ^ N ) = A )
