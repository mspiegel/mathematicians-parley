# ( ( A e. RR /\ N e. NN /\ -. 2 || N ) -> R[ ( A ^ N ) ] = A ). Where
# 0 <_ A, ( A ^ N ) is at least 0, and its power ( 1 / N ) is A: by
# `cxpmul`, `cxpexp` and `cxp1` for A > 0, and `0exp` and `0cxp` for A = 0.
# Where A < 0, ( A ^ N ) = -u ( -u A ^ N ) is below 0, and the same holds
# of -u A > 0.
lemma grootexpr
  |- ( ( A e. RR /\ N e. NN /\ -. 2 || N ) -> if ( 0 <_ ( A ^ N ) , ( ( A ^ N ) ^c ( 1 / N ) ) , -u
      ( -u ( A ^ N ) ^c ( 1 / N ) ) ) = A )
