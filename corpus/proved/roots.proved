  10 adantr 9 |- ( ( ( A e. RR /\ N e. NN /\ -. 2 || N ) /\ 0 <_ A ) -> ( ( A ^c ( 1 / N ) ) ^ N ) =
      A )
  11 eqtrd 6 10 |- ( ( ( A e. RR /\ N e. NN /\ -. 2 || N ) /\ 0 <_ A ) -> ( if ( 0 <_ A , ( A ^c ( 1
      / N ) ) , -u ( -u A ^c ( 1 / N ) ) ) ^ N ) = A )
  12 simpr |- ( ( ( A e. RR /\ N e. NN /\ -. 2 || N ) /\ -. 0 <_ A ) -> -. 0 <_ A )
  13 iffalsed 12 |- ( ( ( A e. RR /\ N e. NN /\ -. 2 || N ) /\ -. 0 <_ A ) -> if ( 0 <_ A , ( A ^c (
