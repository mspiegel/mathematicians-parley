  32 ex 31 |- ( ( ( ( A e. ZZ /\ C e. ZZ ) /\ N e. NN ) /\ N || ( A x. C ) ) -> ( ( C gcd N ) = 1 ->
      N || A ) )
  33 ex 32 |- ( ( ( A e. ZZ /\ C e. ZZ ) /\ N e. NN ) -> ( N || ( A x. C ) -> ( ( C gcd N ) = 1 -> N
      || A ) ) )
  34 ex 33 |- ( ( A e. ZZ /\ C e. ZZ ) -> ( N e. NN -> ( N || ( A x. C ) -> ( ( C gcd N ) = 1 -> N
      || A ) ) ) )
  35 ex 34 |- ( A e. ZZ -> ( C e. ZZ -> ( N e. NN -> ( N || ( A x. C ) -> ( ( C gcd N ) = 1 -> N ||
      A ) ) ) ) )

lemma gcongrcan
  |- ( A e. ZZ -> ( B e. ZZ -> ( C e. ZZ -> ( N e. NN -> ( N || ( ( A x. C ) - ( B x. C ) ) -> ( ( C
      gcd N ) = 1 -> N || ( A - B ) ) ) ) ) ) )
  1 simpr |- ( ( ( ( ( A e. ZZ /\ B e. ZZ ) /\ C e. ZZ ) /\ N e. NN ) /\ N || ( ( A x. C ) - ( B x.
      C ) ) ) -> N || ( ( A x. C ) - ( B x. C ) ) )
  2 adantr 1 |- ( ( ( ( ( ( A e. ZZ /\ B e. ZZ ) /\ C e. ZZ ) /\ N e. NN ) /\ N || ( ( A x. C ) - (
      B x. C ) ) ) /\ ( C gcd N ) = 1 ) -> N || ( ( A x. C ) - ( B x. C ) ) )
  3 id |- ( A e. ZZ -> A e. ZZ )
  4 adantr 3 |- ( ( A e. ZZ /\ B e. ZZ ) -> A e. ZZ )
  5 adantr 4 |- ( ( ( A e. ZZ /\ B e. ZZ ) /\ C e. ZZ ) -> A e. ZZ )
  6 adantr 5 |- ( ( ( ( A e. ZZ /\ B e. ZZ ) /\ C e. ZZ ) /\ N e. NN ) -> A e. ZZ )
  7 adantr 6 |- ( ( ( ( ( A e. ZZ /\ B e. ZZ ) /\ C e. ZZ ) /\ N e. NN ) /\ N || ( ( A x. C ) - ( B
      x. C ) ) ) -> A e. ZZ )
  8 adantr 7 |- ( ( ( ( ( ( A e. ZZ /\ B e. ZZ ) /\ C e. ZZ ) /\ N e. NN ) /\ N || ( ( A x. C ) - (
      B x. C ) ) ) /\ ( C gcd N ) = 1 ) -> A e. ZZ )
  9 zcn |- ( A e. ZZ -> A e. CC )
  10 syl 8 9 |- ( ( ( ( ( ( A e. ZZ /\ B e. ZZ ) /\ C e. ZZ ) /\ N e. NN ) /\ N || ( ( A x. C ) - (
      B x. C ) ) ) /\ ( C gcd N ) = 1 ) -> A e. CC )
  11 simpr |- ( ( A e. ZZ /\ B e. ZZ ) -> B e. ZZ )
  12 adantr 11 |- ( ( ( A e. ZZ /\ B e. ZZ ) /\ C e. ZZ ) -> B e. ZZ )
  13 adantr 12 |- ( ( ( ( A e. ZZ /\ B e. ZZ ) /\ C e. ZZ ) /\ N e. NN ) -> B e. ZZ )
  14 adantr 13 |- ( ( ( ( ( A e. ZZ /\ B e. ZZ ) /\ C e. ZZ ) /\ N e. NN ) /\ N || ( ( A x. C ) - (
      B x. C ) ) ) -> B e. ZZ )
  15 adantr 14 |- ( ( ( ( ( ( A e. ZZ /\ B e. ZZ ) /\ C e. ZZ ) /\ N e. NN ) /\ N || ( ( A x. C ) -
      ( B x. C ) ) ) /\ ( C gcd N ) = 1 ) -> B e. ZZ )
  16 zcn |- ( B e. ZZ -> B e. CC )
  17 syl 15 16 |- ( ( ( ( ( ( A e. ZZ /\ B e. ZZ ) /\ C e. ZZ ) /\ N e. NN ) /\ N || ( ( A x. C ) -
      ( B x. C ) ) ) /\ ( C gcd N ) = 1 ) -> B e. CC )
  18 simpr |- ( ( ( A e. ZZ /\ B e. ZZ ) /\ C e. ZZ ) -> C e. ZZ )
  19 adantr 18 |- ( ( ( ( A e. ZZ /\ B e. ZZ ) /\ C e. ZZ ) /\ N e. NN ) -> C e. ZZ )
  20 adantr 19 |- ( ( ( ( ( A e. ZZ /\ B e. ZZ ) /\ C e. ZZ ) /\ N e. NN ) /\ N || ( ( A x. C ) - (
      B x. C ) ) ) -> C e. ZZ )
  21 adantr 20 |- ( ( ( ( ( ( A e. ZZ /\ B e. ZZ ) /\ C e. ZZ ) /\ N e. NN ) /\ N || ( ( A x. C ) -
      ( B x. C ) ) ) /\ ( C gcd N ) = 1 ) -> C e. ZZ )
  22 zcn |- ( C e. ZZ -> C e. CC )
  23 syl 21 22 |- ( ( ( ( ( ( A e. ZZ /\ B e. ZZ ) /\ C e. ZZ ) /\ N e. NN ) /\ N || ( ( A x. C ) -
      ( B x. C ) ) ) /\ ( C gcd N ) = 1 ) -> C e. CC )
