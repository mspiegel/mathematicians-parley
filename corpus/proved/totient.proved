# Euler's φ, congruences, and products over a finite set, for `proved.mm`.
#
# Euler's theorem is proved by the rearrangement argument: multiplying each
# remainder coprime to n by a, and reducing, permutes those remainders, so
# the product of all of them is the same before and after, and a^φ(n)
# cancels from it. set.mm proves the theorem itself (`eulerth`) by the
# same argument over a sequence; the readable layer takes it a step at a
# time, and the items its steps cite are set.mm's lemmas restated, each in
# the shape its record states it:
#
# - φ(n) counts the remainders 0, …, n − 1 coprime to n: `dfphi2`, with
#   `fzoval` reading 0 ..^ n as 0 ... n − 1;
# - two numbers coprime to n have a product coprime to n: `rpmul`, which
#   puts n first in each gcd;
# - equal remainders are a congruence, and a number is congruent to its
#   remainder: `moddvds`, the second with `modabs2`;
# - two remainders that are congruent are equal: `fzocongeq`;
# - a remainder lies in 0 … n − 1: `elfzo0`;
# - a product over a finite set of integers is an integer (`fprodzcl`);
# - a product is unchanged by a bijection of its index set onto another
#   (`fprodf1o`), with each image written as F ` n so that the lemma asks
#   no term the product does not show.

$( Totient: Euler's phi, congruences, and products over a finite set. $)
$( A product binds k, a set-builder binds x, and renaming a product's
   letter binds n. The bound letters are held apart from each other and
   from the classes, and the classes not from each other: a lemma about A
   and N says nothing of A and N sharing a letter. $)
$d k n x $.
$d k A $.  $d k C $.  $d k F $.  $d k N $.  $d k X $.
$d n A $.  $d n C $.  $d n F $.  $d n N $.  $d n X $.
$d x A $.  $d x C $.  $d x F $.  $d x N $.  $d x X $.
$( A deduction's products bind k and n apart from its hypothesis ph. Its
   term B names k and not n, and D names n and not k. $)
$d k ph $.  $d n ph $.  $d n B $.  $d k D $.
lemma gphival
  |- ( N e. NN -> ( phi ` N ) = ( # ` { x e. ( 0 ... ( N - 1 ) ) | ( x gcd N ) = 1 } ) )
  1 dfphi2 |- ( N e. NN -> ( phi ` N ) = ( # ` { x e. ( 0 ..^ N ) | ( x gcd N ) = 1 } ) )
  2 nnz |- ( N e. NN -> N e. ZZ )
  3 fzoval |- ( N e. ZZ -> ( 0 ..^ N ) = ( 0 ... ( N - 1 ) ) )
  4 syl 2 3 |- ( N e. NN -> ( 0 ..^ N ) = ( 0 ... ( N - 1 ) ) )
  5 rabeqdv 4 |- ( N e. NN -> { x e. ( 0 ..^ N ) | ( x gcd N ) = 1 } = { x e. ( 0 ... ( N - 1 ) ) |
      ( x gcd N ) = 1 } )
  6 fveq2d 5 |- ( N e. NN -> ( # ` { x e. ( 0 ..^ N ) | ( x gcd N ) = 1 } ) = ( # ` { x e. ( 0 ... (
      N - 1 ) ) | ( x gcd N ) = 1 } ) )
  7 eqtrd 1 6 |- ( N e. NN -> ( phi ` N ) = ( # ` { x e. ( 0 ... ( N - 1 ) ) | ( x gcd N ) = 1 } ) )

lemma grpmul
  |- ( A e. ZZ -> ( B e. ZZ -> ( N e. NN -> ( ( A gcd N ) = 1 -> ( ( B gcd N ) = 1 -> ( ( A x. B )
      gcd N ) = 1 ) ) ) ) )
  1 id |- ( A e. ZZ -> A e. ZZ )
  2 adantr 1 |- ( ( A e. ZZ /\ B e. ZZ ) -> A e. ZZ )
  3 adantr 2 |- ( ( ( A e. ZZ /\ B e. ZZ ) /\ N e. NN ) -> A e. ZZ )
  4 adantr 3 |- ( ( ( ( A e. ZZ /\ B e. ZZ ) /\ N e. NN ) /\ ( A gcd N ) = 1 ) -> A e. ZZ )
  5 adantr 4 |- ( ( ( ( ( A e. ZZ /\ B e. ZZ ) /\ N e. NN ) /\ ( A gcd N ) = 1 ) /\ ( B gcd N ) = 1
      ) -> A e. ZZ )
  6 simpr |- ( ( A e. ZZ /\ B e. ZZ ) -> B e. ZZ )
  7 adantr 6 |- ( ( ( A e. ZZ /\ B e. ZZ ) /\ N e. NN ) -> B e. ZZ )
  8 adantr 7 |- ( ( ( ( A e. ZZ /\ B e. ZZ ) /\ N e. NN ) /\ ( A gcd N ) = 1 ) -> B e. ZZ )
  9 adantr 8 |- ( ( ( ( ( A e. ZZ /\ B e. ZZ ) /\ N e. NN ) /\ ( A gcd N ) = 1 ) /\ ( B gcd N ) = 1
      ) -> B e. ZZ )
  10 zmulcl |- ( ( A e. ZZ /\ B e. ZZ ) -> ( A x. B ) e. ZZ )
  11 syl2anc 5 9 10 |- ( ( ( ( ( A e. ZZ /\ B e. ZZ ) /\ N e. NN ) /\ ( A gcd N ) = 1 ) /\ ( B gcd N
      ) = 1 ) -> ( A x. B ) e. ZZ )
  12 simpr |- ( ( ( A e. ZZ /\ B e. ZZ ) /\ N e. NN ) -> N e. NN )
  13 adantr 12 |- ( ( ( ( A e. ZZ /\ B e. ZZ ) /\ N e. NN ) /\ ( A gcd N ) = 1 ) -> N e. NN )
  14 adantr 13 |- ( ( ( ( ( A e. ZZ /\ B e. ZZ ) /\ N e. NN ) /\ ( A gcd N ) = 1 ) /\ ( B gcd N ) =
      1 ) -> N e. NN )
  15 nnz |- ( N e. NN -> N e. ZZ )
  16 syl 14 15 |- ( ( ( ( ( A e. ZZ /\ B e. ZZ ) /\ N e. NN ) /\ ( A gcd N ) = 1 ) /\ ( B gcd N ) =
      1 ) -> N e. ZZ )
  17 gcdcom |- ( ( ( A x. B ) e. ZZ /\ N e. ZZ ) -> ( ( A x. B ) gcd N ) = ( N gcd ( A x. B ) ) )
  18 syl2anc 11 16 17 |- ( ( ( ( ( A e. ZZ /\ B e. ZZ ) /\ N e. NN ) /\ ( A gcd N ) = 1 ) /\ ( B gcd
      N ) = 1 ) -> ( ( A x. B ) gcd N ) = ( N gcd ( A x. B ) ) )
  19 gcdcom |- ( ( A e. ZZ /\ N e. ZZ ) -> ( A gcd N ) = ( N gcd A ) )
  20 syl2anc 5 16 19 |- ( ( ( ( ( A e. ZZ /\ B e. ZZ ) /\ N e. NN ) /\ ( A gcd N ) = 1 ) /\ ( B gcd
      N ) = 1 ) -> ( A gcd N ) = ( N gcd A ) )
  21 simpr |- ( ( ( ( A e. ZZ /\ B e. ZZ ) /\ N e. NN ) /\ ( A gcd N ) = 1 ) -> ( A gcd N ) = 1 )
  22 adantr 21 |- ( ( ( ( ( A e. ZZ /\ B e. ZZ ) /\ N e. NN ) /\ ( A gcd N ) = 1 ) /\ ( B gcd N ) =
      1 ) -> ( A gcd N ) = 1 )
  23 eqtr3d 20 22 |- ( ( ( ( ( A e. ZZ /\ B e. ZZ ) /\ N e. NN ) /\ ( A gcd N ) = 1 ) /\ ( B gcd N )
      = 1 ) -> ( N gcd A ) = 1 )
  24 gcdcom |- ( ( B e. ZZ /\ N e. ZZ ) -> ( B gcd N ) = ( N gcd B ) )
  25 syl2anc 9 16 24 |- ( ( ( ( ( A e. ZZ /\ B e. ZZ ) /\ N e. NN ) /\ ( A gcd N ) = 1 ) /\ ( B gcd
      N ) = 1 ) -> ( B gcd N ) = ( N gcd B ) )
  26 simpr |- ( ( ( ( ( A e. ZZ /\ B e. ZZ ) /\ N e. NN ) /\ ( A gcd N ) = 1 ) /\ ( B gcd N ) = 1 )
      -> ( B gcd N ) = 1 )
  27 eqtr3d 25 26 |- ( ( ( ( ( A e. ZZ /\ B e. ZZ ) /\ N e. NN ) /\ ( A gcd N ) = 1 ) /\ ( B gcd N )
      = 1 ) -> ( N gcd B ) = 1 )
  28 jca 23 27 |- ( ( ( ( ( A e. ZZ /\ B e. ZZ ) /\ N e. NN ) /\ ( A gcd N ) = 1 ) /\ ( B gcd N ) =
      1 ) -> ( ( N gcd A ) = 1 /\ ( N gcd B ) = 1 ) )
  29 rpmul |- ( ( N e. ZZ /\ A e. ZZ /\ B e. ZZ ) -> ( ( ( N gcd A ) = 1 /\ ( N gcd B ) = 1 ) -> ( N
      gcd ( A x. B ) ) = 1 ) )
  30 syl3anc 16 5 9 29 |- ( ( ( ( ( A e. ZZ /\ B e. ZZ ) /\ N e. NN ) /\ ( A gcd N ) = 1 ) /\ ( B
      gcd N ) = 1 ) -> ( ( ( N gcd A ) = 1 /\ ( N gcd B ) = 1 ) -> ( N gcd ( A x. B ) ) = 1 ) )
  31 mpd 28 30 |- ( ( ( ( ( A e. ZZ /\ B e. ZZ ) /\ N e. NN ) /\ ( A gcd N ) = 1 ) /\ ( B gcd N ) =
      1 ) -> ( N gcd ( A x. B ) ) = 1 )
  32 eqtrd 18 31 |- ( ( ( ( ( A e. ZZ /\ B e. ZZ ) /\ N e. NN ) /\ ( A gcd N ) = 1 ) /\ ( B gcd N )
      = 1 ) -> ( ( A x. B ) gcd N ) = 1 )
  33 ex 32 |- ( ( ( ( A e. ZZ /\ B e. ZZ ) /\ N e. NN ) /\ ( A gcd N ) = 1 ) -> ( ( B gcd N ) = 1 ->
      ( ( A x. B ) gcd N ) = 1 ) )
  34 ex 33 |- ( ( ( A e. ZZ /\ B e. ZZ ) /\ N e. NN ) -> ( ( A gcd N ) = 1 -> ( ( B gcd N ) = 1 -> (
      ( A x. B ) gcd N ) = 1 ) ) )
  35 ex 34 |- ( ( A e. ZZ /\ B e. ZZ ) -> ( N e. NN -> ( ( A gcd N ) = 1 -> ( ( B gcd N ) = 1 -> ( (
      A x. B ) gcd N ) = 1 ) ) ) )
  36 ex 35 |- ( A e. ZZ -> ( B e. ZZ -> ( N e. NN -> ( ( A gcd N ) = 1 -> ( ( B gcd N ) = 1 -> ( ( A
      x. B ) gcd N ) = 1 ) ) ) ) )

lemma gelfz0m1
  |- ( M e. NN -> ( A e. NN0 -> ( A < M -> A e. ( 0 ... ( M - 1 ) ) ) ) )
  1 simpr |- ( ( M e. NN /\ A e. NN0 ) -> A e. NN0 )
  2 adantr 1 |- ( ( ( M e. NN /\ A e. NN0 ) /\ A < M ) -> A e. NN0 )
  3 id |- ( M e. NN -> M e. NN )
  4 adantr 3 |- ( ( M e. NN /\ A e. NN0 ) -> M e. NN )
  5 adantr 4 |- ( ( ( M e. NN /\ A e. NN0 ) /\ A < M ) -> M e. NN )
  6 simpr |- ( ( ( M e. NN /\ A e. NN0 ) /\ A < M ) -> A < M )
  7 3jca 2 5 6 |- ( ( ( M e. NN /\ A e. NN0 ) /\ A < M ) -> ( A e. NN0 /\ M e. NN /\ A < M ) )
  8 elfzo0 |- ( A e. ( 0 ..^ M ) <-> ( A e. NN0 /\ M e. NN /\ A < M ) )
  9 sylibr 7 8 |- ( ( ( M e. NN /\ A e. NN0 ) /\ A < M ) -> A e. ( 0 ..^ M ) )
  10 nnz |- ( M e. NN -> M e. ZZ )
  11 syl 5 10 |- ( ( ( M e. NN /\ A e. NN0 ) /\ A < M ) -> M e. ZZ )
  12 fzoval |- ( M e. ZZ -> ( 0 ..^ M ) = ( 0 ... ( M - 1 ) ) )
  13 syl 11 12 |- ( ( ( M e. NN /\ A e. NN0 ) /\ A < M ) -> ( 0 ..^ M ) = ( 0 ... ( M - 1 ) ) )
  14 eleqtrd 9 13 |- ( ( ( M e. NN /\ A e. NN0 ) /\ A < M ) -> A e. ( 0 ... ( M - 1 ) ) )
  15 ex 14 |- ( ( M e. NN /\ A e. NN0 ) -> ( A < M -> A e. ( 0 ... ( M - 1 ) ) ) )
  16 ex 15 |- ( M e. NN -> ( A e. NN0 -> ( A < M -> A e. ( 0 ... ( M - 1 ) ) ) ) )

lemma gmodeqdvds
  |- ( A e. ZZ -> ( B e. ZZ -> ( N e. NN -> ( ( A mod N ) = ( B mod N ) -> N || ( A - B ) ) ) ) )
  1 simpr |- ( ( ( ( A e. ZZ /\ B e. ZZ ) /\ N e. NN ) /\ ( A mod N ) = ( B mod N ) ) -> ( A mod N )
      = ( B mod N ) )
  2 simpr |- ( ( ( A e. ZZ /\ B e. ZZ ) /\ N e. NN ) -> N e. NN )
  3 adantr 2 |- ( ( ( ( A e. ZZ /\ B e. ZZ ) /\ N e. NN ) /\ ( A mod N ) = ( B mod N ) ) -> N e. NN
      )
  4 id |- ( A e. ZZ -> A e. ZZ )
  5 adantr 4 |- ( ( A e. ZZ /\ B e. ZZ ) -> A e. ZZ )
  6 adantr 5 |- ( ( ( A e. ZZ /\ B e. ZZ ) /\ N e. NN ) -> A e. ZZ )
  7 adantr 6 |- ( ( ( ( A e. ZZ /\ B e. ZZ ) /\ N e. NN ) /\ ( A mod N ) = ( B mod N ) ) -> A e. ZZ
      )
  8 simpr |- ( ( A e. ZZ /\ B e. ZZ ) -> B e. ZZ )
  9 adantr 8 |- ( ( ( A e. ZZ /\ B e. ZZ ) /\ N e. NN ) -> B e. ZZ )
  10 adantr 9 |- ( ( ( ( A e. ZZ /\ B e. ZZ ) /\ N e. NN ) /\ ( A mod N ) = ( B mod N ) ) -> B e. ZZ
      )
  11 moddvds |- ( ( N e. NN /\ A e. ZZ /\ B e. ZZ ) -> ( ( A mod N ) = ( B mod N ) <-> N || ( A - B
      ) ) )
  12 syl3anc 3 7 10 11 |- ( ( ( ( A e. ZZ /\ B e. ZZ ) /\ N e. NN ) /\ ( A mod N ) = ( B mod N ) )
      -> ( ( A mod N ) = ( B mod N ) <-> N || ( A - B ) ) )
  13 mpbid 1 12 |- ( ( ( ( A e. ZZ /\ B e. ZZ ) /\ N e. NN ) /\ ( A mod N ) = ( B mod N ) ) -> N ||
      ( A - B ) )
  14 ex 13 |- ( ( ( A e. ZZ /\ B e. ZZ ) /\ N e. NN ) -> ( ( A mod N ) = ( B mod N ) -> N || ( A - B
      ) ) )
  15 ex 14 |- ( ( A e. ZZ /\ B e. ZZ ) -> ( N e. NN -> ( ( A mod N ) = ( B mod N ) -> N || ( A - B )
      ) ) )
  16 ex 15 |- ( A e. ZZ -> ( B e. ZZ -> ( N e. NN -> ( ( A mod N ) = ( B mod N ) -> N || ( A - B ) )
      ) ) )

lemma gfzocong0
  |- ( N e. NN -> ( A e. ( 0 ... ( N - 1 ) ) -> ( B e. ( 0 ... ( N - 1 ) ) -> ( N || ( A - B ) -> A
      = B ) ) ) )
  1 id |- ( N e. NN -> N e. NN )
  2 adantr 1 |- ( ( N e. NN /\ A e. ( 0 ... ( N - 1 ) ) ) -> N e. NN )
  3 adantr 2 |- ( ( ( N e. NN /\ A e. ( 0 ... ( N - 1 ) ) ) /\ B e. ( 0 ... ( N - 1 ) ) ) -> N e. NN
      )
  4 adantr 3 |- ( ( ( ( N e. NN /\ A e. ( 0 ... ( N - 1 ) ) ) /\ B e. ( 0 ... ( N - 1 ) ) ) /\ N ||
      ( A - B ) ) -> N e. NN )
  5 nncn |- ( N e. NN -> N e. CC )
  6 syl 4 5 |- ( ( ( ( N e. NN /\ A e. ( 0 ... ( N - 1 ) ) ) /\ B e. ( 0 ... ( N - 1 ) ) ) /\ N || (
      A - B ) ) -> N e. CC )
  7 subid1 |- ( N e. CC -> ( N - 0 ) = N )
  8 syl 6 7 |- ( ( ( ( N e. NN /\ A e. ( 0 ... ( N - 1 ) ) ) /\ B e. ( 0 ... ( N - 1 ) ) ) /\ N || (
      A - B ) ) -> ( N - 0 ) = N )
  9 simpr |- ( ( ( ( N e. NN /\ A e. ( 0 ... ( N - 1 ) ) ) /\ B e. ( 0 ... ( N - 1 ) ) ) /\ N || ( A
      - B ) ) -> N || ( A - B ) )
  10 eqbrtrd 8 9 |- ( ( ( ( N e. NN /\ A e. ( 0 ... ( N - 1 ) ) ) /\ B e. ( 0 ... ( N - 1 ) ) ) /\ N
      || ( A - B ) ) -> ( N - 0 ) || ( A - B ) )
  11 simpr |- ( ( N e. NN /\ A e. ( 0 ... ( N - 1 ) ) ) -> A e. ( 0 ... ( N - 1 ) ) )
  12 adantr 11 |- ( ( ( N e. NN /\ A e. ( 0 ... ( N - 1 ) ) ) /\ B e. ( 0 ... ( N - 1 ) ) ) -> A e.
      ( 0 ... ( N - 1 ) ) )
  13 adantr 12 |- ( ( ( ( N e. NN /\ A e. ( 0 ... ( N - 1 ) ) ) /\ B e. ( 0 ... ( N - 1 ) ) ) /\ N
      || ( A - B ) ) -> A e. ( 0 ... ( N - 1 ) ) )
  14 nnz |- ( N e. NN -> N e. ZZ )
  15 syl 4 14 |- ( ( ( ( N e. NN /\ A e. ( 0 ... ( N - 1 ) ) ) /\ B e. ( 0 ... ( N - 1 ) ) ) /\ N ||
      ( A - B ) ) -> N e. ZZ )
  16 fzoval |- ( N e. ZZ -> ( 0 ..^ N ) = ( 0 ... ( N - 1 ) ) )
  17 syl 15 16 |- ( ( ( ( N e. NN /\ A e. ( 0 ... ( N - 1 ) ) ) /\ B e. ( 0 ... ( N - 1 ) ) ) /\ N
      || ( A - B ) ) -> ( 0 ..^ N ) = ( 0 ... ( N - 1 ) ) )
  18 eleqtrrd 13 17 |- ( ( ( ( N e. NN /\ A e. ( 0 ... ( N - 1 ) ) ) /\ B e. ( 0 ... ( N - 1 ) ) )
      /\ N || ( A - B ) ) -> A e. ( 0 ..^ N ) )
  19 simpr |- ( ( ( N e. NN /\ A e. ( 0 ... ( N - 1 ) ) ) /\ B e. ( 0 ... ( N - 1 ) ) ) -> B e. ( 0
      ... ( N - 1 ) ) )
  20 adantr 19 |- ( ( ( ( N e. NN /\ A e. ( 0 ... ( N - 1 ) ) ) /\ B e. ( 0 ... ( N - 1 ) ) ) /\ N
      || ( A - B ) ) -> B e. ( 0 ... ( N - 1 ) ) )
  21 eleqtrrd 20 17 |- ( ( ( ( N e. NN /\ A e. ( 0 ... ( N - 1 ) ) ) /\ B e. ( 0 ... ( N - 1 ) ) )
      /\ N || ( A - B ) ) -> B e. ( 0 ..^ N ) )
  22 fzocongeq |- ( ( A e. ( 0 ..^ N ) /\ B e. ( 0 ..^ N ) ) -> ( ( N - 0 ) || ( A - B ) <-> A = B )
      )
  23 syl2anc 18 21 22 |- ( ( ( ( N e. NN /\ A e. ( 0 ... ( N - 1 ) ) ) /\ B e. ( 0 ... ( N - 1 ) ) )
      /\ N || ( A - B ) ) -> ( ( N - 0 ) || ( A - B ) <-> A = B ) )
  24 mpbid 10 23 |- ( ( ( ( N e. NN /\ A e. ( 0 ... ( N - 1 ) ) ) /\ B e. ( 0 ... ( N - 1 ) ) ) /\ N
      || ( A - B ) ) -> A = B )
  25 ex 24 |- ( ( ( N e. NN /\ A e. ( 0 ... ( N - 1 ) ) ) /\ B e. ( 0 ... ( N - 1 ) ) ) -> ( N || (
      A - B ) -> A = B ) )
  26 ex 25 |- ( ( N e. NN /\ A e. ( 0 ... ( N - 1 ) ) ) -> ( B e. ( 0 ... ( N - 1 ) ) -> ( N || ( A
      - B ) -> A = B ) ) )
  27 ex 26 |- ( N e. NN -> ( A e. ( 0 ... ( N - 1 ) ) -> ( B e. ( 0 ... ( N - 1 ) ) -> ( N || ( A -
      B ) -> A = B ) ) ) )

lemma gmodcong
  |- ( A e. ZZ -> ( N e. NN -> N || ( A - ( A mod N ) ) ) )
  1 id |- ( A e. ZZ -> A e. ZZ )
  2 adantr 1 |- ( ( A e. ZZ /\ N e. NN ) -> A e. ZZ )
  3 zre |- ( A e. ZZ -> A e. RR )
  4 syl 2 3 |- ( ( A e. ZZ /\ N e. NN ) -> A e. RR )
  5 simpr |- ( ( A e. ZZ /\ N e. NN ) -> N e. NN )
  6 nnrp |- ( N e. NN -> N e. RR+ )
  7 syl 5 6 |- ( ( A e. ZZ /\ N e. NN ) -> N e. RR+ )
  8 modabs2 |- ( ( A e. RR /\ N e. RR+ ) -> ( ( A mod N ) mod N ) = ( A mod N ) )
  9 syl2anc 4 7 8 |- ( ( A e. ZZ /\ N e. NN ) -> ( ( A mod N ) mod N ) = ( A mod N ) )
  10 eqcomd 9 |- ( ( A e. ZZ /\ N e. NN ) -> ( A mod N ) = ( ( A mod N ) mod N ) )
  11 zmodcl |- ( ( A e. ZZ /\ N e. NN ) -> ( A mod N ) e. NN0 )
  12 syl2anc 2 5 11 |- ( ( A e. ZZ /\ N e. NN ) -> ( A mod N ) e. NN0 )
  13 nn0z |- ( ( A mod N ) e. NN0 -> ( A mod N ) e. ZZ )
  14 syl 12 13 |- ( ( A e. ZZ /\ N e. NN ) -> ( A mod N ) e. ZZ )
  15 moddvds |- ( ( N e. NN /\ A e. ZZ /\ ( A mod N ) e. ZZ ) -> ( ( A mod N ) = ( ( A mod N ) mod N
      ) <-> N || ( A - ( A mod N ) ) ) )
  16 syl3anc 5 2 14 15 |- ( ( A e. ZZ /\ N e. NN ) -> ( ( A mod N ) = ( ( A mod N ) mod N ) <-> N ||
      ( A - ( A mod N ) ) ) )
  17 mpbid 10 16 |- ( ( A e. ZZ /\ N e. NN ) -> N || ( A - ( A mod N ) ) )
  18 ex 17 |- ( A e. ZZ -> ( N e. NN -> N || ( A - ( A mod N ) ) ) )

lemma gfprodz
  |- ( X e. ~P ZZ -> ( X e. Fin -> prod_ k e. X k e. ZZ ) )
  1 simpr |- ( ( X e. ~P ZZ /\ X e. Fin ) -> X e. Fin )
  2 id |- ( X e. ~P ZZ -> X e. ~P ZZ )
  3 adantr 2 |- ( ( X e. ~P ZZ /\ X e. Fin ) -> X e. ~P ZZ )
  4 elpwi |- ( X e. ~P ZZ -> X C_ ZZ )
  5 syl 3 4 |- ( ( X e. ~P ZZ /\ X e. Fin ) -> X C_ ZZ )
  6 sselda 5 |- ( ( ( X e. ~P ZZ /\ X e. Fin ) /\ k e. X ) -> k e. ZZ )
  7 fprodzcl 1 6 |- ( ( X e. ~P ZZ /\ X e. Fin ) -> prod_ k e. X k e. ZZ )
  8 ex 7 |- ( X e. ~P ZZ -> ( X e. Fin -> prod_ k e. X k e. ZZ ) )

# `gfprodf1o`: `fprodf1o` with the image of each n under F written as
# F ` n, so the lemma asks no term the product does not show.
lemma gfprodf1o
  hypothesis gfprodf1o.1 |- ( k = ( F ` n ) -> B = D )
  hypothesis gfprodf1o.2 |- ( ph -> C e. Fin )
  hypothesis gfprodf1o.3 |- ( ph -> F : C -1-1-onto-> A )
  hypothesis gfprodf1o.4 |- ( ( ph /\ k e. A ) -> B e. CC )
  |- ( ph -> prod_ k e. A B = prod_ n e. C D )
  1 eqidd |- ( ( ph /\ n e. C ) -> ( F ` n ) = ( F ` n ) )
  2 fprodf1o gfprodf1o.1 gfprodf1o.2 gfprodf1o.3 1 gfprodf1o.4 |- ( ph -> prod_ k e. A B = prod_ n
      e. C D )

