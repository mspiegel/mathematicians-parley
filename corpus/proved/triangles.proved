  |- ( ( A e. CC /\ B e. CC /\ C e. CC ) -> ( ( -. A = B /\ -. C = B ) -> ( ( abs ` ( ( A - B ) ang
      ( C - B ) ) ) = ( ( ; 9 0 x. _pi ) / ; ; 1 8 0 ) <-> ( cos ` ( abs ` ( ( A - B ) ang ( C - B ) )
      ) ) = 0 ) ) )
