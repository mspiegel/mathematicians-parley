  2 adantr 1 |- ( ( P e. CC /\ Q e. CC ) -> P e. CC )
  3 simpr |- ( ( P e. CC /\ Q e. CC ) -> Q e. CC )
  4 subcld 2 3 |- ( ( P e. CC /\ Q e. CC ) -> ( P - Q ) e. CC )
  5 abscld 4 |- ( ( P e. CC /\ Q e. CC ) -> ( abs ` ( P - Q ) ) e. RR )
  6 ex 5 |- ( P e. CC -> ( Q e. CC -> ( abs ` ( P - Q ) ) e. RR ) )

