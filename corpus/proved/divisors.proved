# Divisor sums, for `proved.mm`.
#
# set.mm's sigma takes a power first: A sigma n is the sum of the A-th
# powers of the divisors of n. The page writes σ(n), the sum of the
# divisors themselves, which is 1 sigma n, and set.mm states its value only
# with the power left in. So each lemma here is set.mm's with the power 1
# written away:
#
# - σ(n) is the sum of the divisors of n: `sgmval2` at 1, with each k^1
#   read as k by `exp1`, for `def:stdlib/divisibility/σ`;
# - σ of a prime's power is the sum of the powers up to it: `sgmppw` at 1,
#   with p^c 1 read as p by `cxp1`, for
#   `thm:stdlib/divisibility/sigma-prime-power`.
#
# And coprime factors of a square are squares: set.mm's `coprimeprodsq`
# and `coprimeprodsq2` ask that the two factors and the root share no
# factor all three, which follows from the two sharing none, since
# gcd(1, w) = 1 (`1gcd`), for `thm:stdlib/divisibility/coprime-square`.
#
# And a sum of some of the divisors of N is at most σ(N): `fsumless`, over
# the divisors, a finite set by `dvdsfi`, whose members are in ℕ and so at
# least 0, and σ(N) their sum by `g1sgmval`, for
# `mun:stdlib/divisibility/sigma-part`.

$( Divisors: the sum of the divisors of a number, and of a prime's powers,
   coprime factors of a square, and a sum of some divisors. $)
$d k p B $.
$d k p N $.
$d k P $.
$d k Y $.
$d k ph $.

# ( B e. NN -> ( 1 sigma B ) = sum_ k e. { p e. NN | p || B } k )
lemma g1sgmval
  |- ( B e. NN -> ( 1 sigma B ) = sum_ k e. { p e. NN | p || B } k )
  1 1z |- 1 e. ZZ
  2 sgmval2 |- ( ( 1 e. ZZ /\ B e. NN ) -> ( 1 sigma B ) = sum_ k e. { p e. NN | p || B } ( k ^ 1 )
      )
  3 mpan 1 2 |- ( B e. NN -> ( 1 sigma B ) = sum_ k e. { p e. NN | p || B } ( k ^ 1 ) )
  4 simpr |- ( ( B e. NN /\ k e. { p e. NN | p || B } ) -> k e. { p e. NN | p || B } )
  5 elrabi |- ( k e. { p e. NN | p || B } -> k e. NN )
  6 syl 4 5 |- ( ( B e. NN /\ k e. { p e. NN | p || B } ) -> k e. NN )
  7 nncn |- ( k e. NN -> k e. CC )
  8 syl 6 7 |- ( ( B e. NN /\ k e. { p e. NN | p || B } ) -> k e. CC )
  9 exp1 |- ( k e. CC -> ( k ^ 1 ) = k )
  10 syl 8 9 |- ( ( B e. NN /\ k e. { p e. NN | p || B } ) -> ( k ^ 1 ) = k )
  11 sumeq2dv 10 |- ( B e. NN -> sum_ k e. { p e. NN | p || B } ( k ^ 1 ) = sum_ k e. { p e. NN | p
      || B } k )
  12 eqtrd 3 11 |- ( B e. NN -> ( 1 sigma B ) = sum_ k e. { p e. NN | p || B } k )

# ( ( P e. Prime /\ N e. NN0 ) ->
#   ( 1 sigma ( P ^ N ) ) = sum_ k e. ( 0 ... N ) ( P ^ k ) )
lemma g1sgmppw
  |- ( ( P e. Prime /\ N e. NN0 ) -> ( 1 sigma ( P ^ N ) ) = sum_ k e. ( 0 ... N ) ( P ^ k ) )
  1 ax-1cn |- 1 e. CC
  2 sgmppw |- ( ( 1 e. CC /\ P e. Prime /\ N e. NN0 ) -> ( 1 sigma ( P ^ N ) ) = sum_ k e. ( 0 ... N
      ) ( ( P ^c 1 ) ^ k ) )
  3 mp3an1 1 2 |- ( ( P e. Prime /\ N e. NN0 ) -> ( 1 sigma ( P ^ N ) ) = sum_ k e. ( 0 ... N ) ( (
      P ^c 1 ) ^ k ) )
  4 simpl |- ( ( P e. Prime /\ N e. NN0 ) -> P e. Prime )
  5 prmnn |- ( P e. Prime -> P e. NN )
  6 syl 4 5 |- ( ( P e. Prime /\ N e. NN0 ) -> P e. NN )
  7 nncn |- ( P e. NN -> P e. CC )
  8 syl 6 7 |- ( ( P e. Prime /\ N e. NN0 ) -> P e. CC )
  9 cxp1 |- ( P e. CC -> ( P ^c 1 ) = P )
  10 syl 8 9 |- ( ( P e. Prime /\ N e. NN0 ) -> ( P ^c 1 ) = P )
  11 oveq1d 10 |- ( ( P e. Prime /\ N e. NN0 ) -> ( ( P ^c 1 ) ^ k ) = ( P ^ k ) )
  12 adantr 11 |- ( ( ( P e. Prime /\ N e. NN0 ) /\ k e. ( 0 ... N ) ) -> ( ( P ^c 1 ) ^ k ) = ( P ^
      k ) )
  13 sumeq2dv 12 |- ( ( P e. Prime /\ N e. NN0 ) -> sum_ k e. ( 0 ... N ) ( ( P ^c 1 ) ^ k ) = sum_
      k e. ( 0 ... N ) ( P ^ k ) )
  14 eqtrd 3 13 |- ( ( P e. Prime /\ N e. NN0 ) -> ( 1 sigma ( P ^ N ) ) = sum_ k e. ( 0 ... N ) ( P
      ^ k ) )

lemma gcoprimesq
  |- ( ( ( A e. NN0 /\ B e. ZZ /\ C e. NN0 ) /\ ( A gcd B ) = 1 ) -> ( ( C ^ 2 ) = ( A x. B ) -> A =
      ( ( A gcd C ) ^ 2 ) ) )
  1 simpl |- ( ( ( A e. NN0 /\ B e. ZZ /\ C e. NN0 ) /\ ( A gcd B ) = 1 ) -> ( A e. NN0 /\ B e. ZZ
      /\ C e. NN0 ) )
  2 simpr |- ( ( ( A e. NN0 /\ B e. ZZ /\ C e. NN0 ) /\ ( A gcd B ) = 1 ) -> ( A gcd B ) = 1 )
  3 oveq1d 2 |- ( ( ( A e. NN0 /\ B e. ZZ /\ C e. NN0 ) /\ ( A gcd B ) = 1 ) -> ( ( A gcd B ) gcd C
      ) = ( 1 gcd C ) )
  4 simp3 |- ( ( A e. NN0 /\ B e. ZZ /\ C e. NN0 ) -> C e. NN0 )
  5 nn0z |- ( C e. NN0 -> C e. ZZ )
  6 syl 4 5 |- ( ( A e. NN0 /\ B e. ZZ /\ C e. NN0 ) -> C e. ZZ )
  7 syl 1 6 |- ( ( ( A e. NN0 /\ B e. ZZ /\ C e. NN0 ) /\ ( A gcd B ) = 1 ) -> C e. ZZ )
  8 1gcd |- ( C e. ZZ -> ( 1 gcd C ) = 1 )
  9 syl 7 8 |- ( ( ( A e. NN0 /\ B e. ZZ /\ C e. NN0 ) /\ ( A gcd B ) = 1 ) -> ( 1 gcd C ) = 1 )
  10 eqtrd 3 9 |- ( ( ( A e. NN0 /\ B e. ZZ /\ C e. NN0 ) /\ ( A gcd B ) = 1 ) -> ( ( A gcd B ) gcd
      C ) = 1 )
  11 jca 1 10 |- ( ( ( A e. NN0 /\ B e. ZZ /\ C e. NN0 ) /\ ( A gcd B ) = 1 ) -> ( ( A e. NN0 /\ B
      e. ZZ /\ C e. NN0 ) /\ ( ( A gcd B ) gcd C ) = 1 ) )
  12 coprimeprodsq |- ( ( ( A e. NN0 /\ B e. ZZ /\ C e. NN0 ) /\ ( ( A gcd B ) gcd C ) = 1 ) -> ( (
      C ^ 2 ) = ( A x. B ) -> A = ( ( A gcd C ) ^ 2 ) ) )
  13 syl 11 12 |- ( ( ( A e. NN0 /\ B e. ZZ /\ C e. NN0 ) /\ ( A gcd B ) = 1 ) -> ( ( C ^ 2 ) = ( A
      x. B ) -> A = ( ( A gcd C ) ^ 2 ) ) )

lemma gcoprimesq2
  |- ( ( ( A e. ZZ /\ B e. NN0 /\ C e. NN0 ) /\ ( A gcd B ) = 1 ) -> ( ( C ^ 2 ) = ( A x. B ) -> B =
      ( ( B gcd C ) ^ 2 ) ) )
  1 simpl |- ( ( ( A e. ZZ /\ B e. NN0 /\ C e. NN0 ) /\ ( A gcd B ) = 1 ) -> ( A e. ZZ /\ B e. NN0
      /\ C e. NN0 ) )
  2 simpr |- ( ( ( A e. ZZ /\ B e. NN0 /\ C e. NN0 ) /\ ( A gcd B ) = 1 ) -> ( A gcd B ) = 1 )
  3 oveq1d 2 |- ( ( ( A e. ZZ /\ B e. NN0 /\ C e. NN0 ) /\ ( A gcd B ) = 1 ) -> ( ( A gcd B ) gcd C
      ) = ( 1 gcd C ) )
  4 simp3 |- ( ( A e. ZZ /\ B e. NN0 /\ C e. NN0 ) -> C e. NN0 )
  5 nn0z |- ( C e. NN0 -> C e. ZZ )
  6 syl 4 5 |- ( ( A e. ZZ /\ B e. NN0 /\ C e. NN0 ) -> C e. ZZ )
  7 syl 1 6 |- ( ( ( A e. ZZ /\ B e. NN0 /\ C e. NN0 ) /\ ( A gcd B ) = 1 ) -> C e. ZZ )
  8 1gcd |- ( C e. ZZ -> ( 1 gcd C ) = 1 )
  9 syl 7 8 |- ( ( ( A e. ZZ /\ B e. NN0 /\ C e. NN0 ) /\ ( A gcd B ) = 1 ) -> ( 1 gcd C ) = 1 )
  10 eqtrd 3 9 |- ( ( ( A e. ZZ /\ B e. NN0 /\ C e. NN0 ) /\ ( A gcd B ) = 1 ) -> ( ( A gcd B ) gcd
      C ) = 1 )
  11 jca 1 10 |- ( ( ( A e. ZZ /\ B e. NN0 /\ C e. NN0 ) /\ ( A gcd B ) = 1 ) -> ( ( A e. ZZ /\ B e.
      NN0 /\ C e. NN0 ) /\ ( ( A gcd B ) gcd C ) = 1 ) )
  12 coprimeprodsq2 |- ( ( ( A e. ZZ /\ B e. NN0 /\ C e. NN0 ) /\ ( ( A gcd B ) gcd C ) = 1 ) -> ( (
      C ^ 2 ) = ( A x. B ) -> B = ( ( B gcd C ) ^ 2 ) ) )
  13 syl 11 12 |- ( ( ( A e. ZZ /\ B e. NN0 /\ C e. NN0 ) /\ ( A gcd B ) = 1 ) -> ( ( C ^ 2 ) = ( A
      x. B ) -> B = ( ( B gcd C ) ^ 2 ) ) )

lemma g1sgmpart
  hypothesis g1sgmpart.1 |- ( ph -> N e. NN )
  hypothesis g1sgmpart.2 |- ( ph -> Y e. ~P { p e. NN | p || N } )
  |- ( ph -> sum_ k e. Y k <_ ( 1 sigma N ) )
  1 dvdsfi |- ( N e. NN -> { p e. NN | p || N } e. Fin )
  2 syl g1sgmpart.1 1 |- ( ph -> { p e. NN | p || N } e. Fin )
  3 elrabi |- ( k e. { p e. NN | p || N } -> k e. NN )
  4 adantl 3 |- ( ( ph /\ k e. { p e. NN | p || N } ) -> k e. NN )
  5 nnred 4 |- ( ( ph /\ k e. { p e. NN | p || N } ) -> k e. RR )
  6 nnnn0d 4 |- ( ( ph /\ k e. { p e. NN | p || N } ) -> k e. NN0 )
  7 nn0ge0d 6 |- ( ( ph /\ k e. { p e. NN | p || N } ) -> 0 <_ k )
  8 elpwi |- ( Y e. ~P { p e. NN | p || N } -> Y C_ { p e. NN | p || N } )
  9 syl g1sgmpart.2 8 |- ( ph -> Y C_ { p e. NN | p || N } )
  10 fsumless 2 5 7 9 |- ( ph -> sum_ k e. Y k <_ sum_ k e. { p e. NN | p || N } k )
  11 g1sgmval |- ( N e. NN -> ( 1 sigma N ) = sum_ k e. { p e. NN | p || N } k )
  12 syl g1sgmpart.1 11 |- ( ph -> ( 1 sigma N ) = sum_ k e. { p e. NN | p || N } k )
  13 breqtrrd 10 12 |- ( ph -> sum_ k e. Y k <_ ( 1 sigma N ) )

# `gcongcomd`: a ≡ b (mod n) and b ≡ a (mod n) say the same, the page's
# congruence standing in no order of its two sides (`notation
# congruent-mod`). n divides a − b just when it divides its negation,
# b − a. set.mm's `congsym` is in a mathbox.
lemma gcongcomd
  hypothesis gcongcomd.1 |- ( ph -> N e. ZZ )
  hypothesis gcongcomd.2 |- ( ph -> A e. ZZ )
  hypothesis gcongcomd.3 |- ( ph -> B e. ZZ )
  |- ( ph -> ( N || ( A - B ) <-> N || ( B - A ) ) )
  1 zsubcld gcongcomd.2 gcongcomd.3 |- ( ph -> ( A - B ) e. ZZ )
  2 dvdsnegb |- ( ( N e. ZZ /\ ( A - B ) e. ZZ ) -> ( N || ( A - B ) <-> N || -u ( A - B ) ) )
  3 syl2anc gcongcomd.1 1 2 |- ( ph -> ( N || ( A - B ) <-> N || -u ( A - B ) ) )
  4 zcnd gcongcomd.2 |- ( ph -> A e. CC )
  5 zcnd gcongcomd.3 |- ( ph -> B e. CC )
  6 negsubdi2d 4 5 |- ( ph -> -u ( A - B ) = ( B - A ) )
  7 breq2d 6 |- ( ph -> ( N || -u ( A - B ) <-> N || ( B - A ) ) )
  8 bitrd 3 7 |- ( ph -> ( N || ( A - B ) <-> N || ( B - A ) ) )

# `gnndvdslt`: n does not divide a natural number below it. `fzm1ndvds`
# says it of the range {1, …, n − 1}, which `elfzm11` reads as an integer at
# least 1 and below n.
lemma gnndvdslt
  hypothesis gnndvdslt.1 |- ( ph -> N e. NN )
  hypothesis gnndvdslt.2 |- ( ph -> K e. NN )
  hypothesis gnndvdslt.3 |- ( ph -> K < N )
  |- ( ph -> -. N || K )
  1 nnzd gnndvdslt.2 |- ( ph -> K e. ZZ )
  2 nnge1d gnndvdslt.2 |- ( ph -> 1 <_ K )
  3 1zzd |- ( ph -> 1 e. ZZ )
  4 nnzd gnndvdslt.1 |- ( ph -> N e. ZZ )
  5 elfzm11 |- ( ( 1 e. ZZ /\ N e. ZZ ) -> ( K e. ( 1 ... ( N - 1 ) ) <-> ( K e. ZZ /\ 1 <_ K /\ K < N ) ) )
  6 syl2anc 3 4 5 |- ( ph -> ( K e. ( 1 ... ( N - 1 ) ) <-> ( K e. ZZ /\ 1 <_ K /\ K < N ) ) )
  7 3jca 1 2 gnndvdslt.3 |- ( ph -> ( K e. ZZ /\ 1 <_ K /\ K < N ) )
  8 mpbird 7 6 |- ( ph -> K e. ( 1 ... ( N - 1 ) ) )
  9 fzm1ndvds |- ( ( N e. NN /\ K e. ( 1 ... ( N - 1 ) ) ) -> -. N || K )
  10 syl2anc gnndvdslt.1 8 9 |- ( ph -> -. N || K )

# `gm1cong`: n − 1 ≡ −1 (mod n). The difference of the two sides is n, which
# divides itself.
lemma gm1cong
  hypothesis gm1cong.1 |- ( ph -> N e. NN )
  |- ( ph -> N || ( ( N - 1 ) - -u 1 ) )
  1 nnzd gm1cong.1 |- ( ph -> N e. ZZ )
  2 iddvds |- ( N e. ZZ -> N || N )
  3 syl 1 2 |- ( ph -> N || N )
  4 nncnd gm1cong.1 |- ( ph -> N e. CC )
  5 1cnd |- ( ph -> 1 e. CC )
  6 subcld 4 5 |- ( ph -> ( N - 1 ) e. CC )
  7 subnegd 6 5 |- ( ph -> ( ( N - 1 ) - -u 1 ) = ( ( N - 1 ) + 1 ) )
  8 npcand 4 5 |- ( ph -> ( ( N - 1 ) + 1 ) = N )
  9 eqtrd 7 8 |- ( ph -> ( ( N - 1 ) - -u 1 ) = N )
  10 breqtrrd 3 9 |- ( ph -> N || ( ( N - 1 ) - -u 1 ) )

