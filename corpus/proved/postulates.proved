  hypothesis gareacongd.12 |- ( ph -> ( abs ` ( R - P ) ) = ( abs ` ( U - S ) ) )
  hypothesis gareacongd.13 |- ( ph -> ( abs ` ( ( Q - R ) ang ( P - R ) ) ) = ( abs ` ( ( T - U )
      ang ( S - U ) ) ) )
