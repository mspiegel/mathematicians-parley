# Lines AB and CD that are one set have a real direction quotient: C and D
# are then points of line AB. The context is ps, not ph, since it may hold
# line AB itself, whose bound u the line-uniqueness $d keeps apart from ph.
lemma gpareqr
  hypothesis gpareqr.1 |- ( ps -> A e. CC )
  hypothesis gpareqr.2 |- ( ps -> B e. CC )
  hypothesis gpareqr.3 |- ( ps -> C e. CC )
  hypothesis gpareqr.4 |- ( ps -> D e. CC )
  hypothesis gpareqr.5 |- ( ps -> A =/= B )
  hypothesis gpareqr.6 |- ( ps -> C =/= D )
  hypothesis gpareqr.7 |- ( ps -> { u e. CC | ( A = B \/ ( ( u - A ) / ( B - A ) ) e. RR ) } = { u
      e. CC | ( C = D \/ ( ( u - C ) / ( D - C ) ) e. RR ) } )
  |- ( ps -> ( ( B - A ) / ( D - C ) ) e. RR )
  1 subcld gpareqr.4 gpareqr.3 |- ( ps -> ( D - C ) e. CC )
  2 necomd gpareqr.6 |- ( ps -> D =/= C )
  3 subne0d gpareqr.4 gpareqr.3 2 |- ( ps -> ( D - C ) =/= 0 )
  4 subcld gpareqr.2 gpareqr.1 |- ( ps -> ( B - A ) e. CC )
  5 necomd gpareqr.5 |- ( ps -> B =/= A )
  6 subne0d gpareqr.2 gpareqr.1 5 |- ( ps -> ( B - A ) =/= 0 )
  7 neneqd gpareqr.5 |- ( ps -> -. A = B )
  8 subidd gpareqr.3 |- ( ps -> ( C - C ) = 0 )
  9 oveq1d 8 |- ( ps -> ( ( C - C ) / ( D - C ) ) = ( 0 / ( D - C ) ) )
  10 div0d 1 3 |- ( ps -> ( 0 / ( D - C ) ) = 0 )
  11 eqtrd 9 10 |- ( ps -> ( ( C - C ) / ( D - C ) ) = 0 )
