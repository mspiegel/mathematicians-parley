  4 absrpcld 1 3 |- ( ph -> ( abs ` ( B - A ) ) e. RR+ )
  5 rpred 4 |- ( ph -> ( abs ` ( B - A ) ) e. RR )
  6 rpne0d 4 |- ( ph -> ( abs ` ( B - A ) ) =/= 0 )
  7 rpgt0d 4 |- ( ph -> 0 < ( abs ` ( B - A ) ) )
  8 redivcld gextendd.3 5 6 |- ( ph -> ( K / ( abs ` ( B - A ) ) ) e. RR )
  9 recnd 8 |- ( ph -> ( K / ( abs ` ( B - A ) ) ) e. CC )
  10 mulcld 9 1 |- ( ph -> ( ( K / ( abs ` ( B - A ) ) ) x. ( B - A ) ) e. CC )
  11 oveq1d gextendd.6 |- ( ph -> ( X - B ) = ( ( B + ( ( K / ( abs ` ( B - A ) ) ) x. ( B - A ) )
      ) - B ) )
  12 pncan2d gextendd.2 10 |- ( ph -> ( ( B + ( ( K / ( abs ` ( B - A ) ) ) x. ( B - A ) ) ) - B )
      = ( ( K / ( abs ` ( B - A ) ) ) x. ( B - A ) ) )
  13 eqtrd 11 12 |- ( ph -> ( X - B ) = ( ( K / ( abs ` ( B - A ) ) ) x. ( B - A ) ) )
  14 subcld gextendd.1 gextendd.2 |- ( ph -> ( A - B ) e. CC )
  15 subne0d gextendd.1 gextendd.2 gextendd.4 |- ( ph -> ( A - B ) =/= 0 )
  16 negsubdi2d gextendd.1 gextendd.2 |- ( ph -> -u ( A - B ) = ( B - A ) )
  17 oveq2d 16 |- ( ph -> ( ( K / ( abs ` ( B - A ) ) ) x. -u ( A - B ) ) = ( ( K / ( abs ` ( B - A
      ) ) ) x. ( B - A ) ) )
  18 mulneg2d 9 14 |- ( ph -> ( ( K / ( abs ` ( B - A ) ) ) x. -u ( A - B ) ) = -u ( ( K / ( abs `
      ( B - A ) ) ) x. ( A - B ) ) )
  19 mulneg1d 9 14 |- ( ph -> ( -u ( K / ( abs ` ( B - A ) ) ) x. ( A - B ) ) = -u ( ( K / ( abs `
      ( B - A ) ) ) x. ( A - B ) ) )
  20 eqtr4d 18 19 |- ( ph -> ( ( K / ( abs ` ( B - A ) ) ) x. -u ( A - B ) ) = ( -u ( K / ( abs ` (
      B - A ) ) ) x. ( A - B ) ) )
  21 eqtr3d 17 20 |- ( ph -> ( ( K / ( abs ` ( B - A ) ) ) x. ( B - A ) ) = ( -u ( K / ( abs ` ( B
