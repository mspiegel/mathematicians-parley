      )
  5 eleq1 |- ( ( ( Im ` X ) x. ( Im ` Y ) ) = (/) -> ( ( ( Im ` X ) x. ( Im ` Y ) ) e. RR* <-> (/)
      e. RR* ) )
  6 syl 4 5 |- ( -. ( ( Im ` X ) e. CC /\ ( Im ` Y ) e. CC ) -> ( ( ( Im ` X ) x. ( Im ` Y ) ) e.
      RR* <-> (/) e. RR* ) )
  7 gnelxr |- -. (/) e. RR*
  8 mtbiri 7 6 |- ( -. ( ( Im ` X ) e. CC /\ ( Im ` Y ) e. CC ) -> -. ( ( Im ` X ) x. ( Im ` Y ) )
      e. RR* )
  9 con4i 8 |- ( ( ( Im ` X ) x. ( Im ` Y ) ) e. RR* -> ( ( Im ` X ) e. CC /\ ( Im ` Y ) e. CC ) )
  10 imf |- Im : CC --> RR
  11 fdmi 10 |- dom Im = CC
  12 eleq2i 11 |- ( X e. dom Im <-> X e. CC )
  13 ndmfv |- ( -. X e. dom Im -> ( Im ` X ) = (/) )
  14 sylnbir 12 13 |- ( -. X e. CC -> ( Im ` X ) = (/) )
  15 eleq1 |- ( ( Im ` X ) = (/) -> ( ( Im ` X ) e. CC <-> (/) e. CC ) )
  16 syl 14 15 |- ( -. X e. CC -> ( ( Im ` X ) e. CC <-> (/) e. CC ) )
  17 0ncn |- -. (/) e. CC
  18 mtbiri 17 16 |- ( -. X e. CC -> -. ( Im ` X ) e. CC )
  19 con4i 18 |- ( ( Im ` X ) e. CC -> X e. CC )
  20 eleq2i 11 |- ( Y e. dom Im <-> Y e. CC )
  21 ndmfv |- ( -. Y e. dom Im -> ( Im ` Y ) = (/) )
  22 sylnbir 20 21 |- ( -. Y e. CC -> ( Im ` Y ) = (/) )
  23 eleq1 |- ( ( Im ` Y ) = (/) -> ( ( Im ` Y ) e. CC <-> (/) e. CC ) )
  24 syl 22 23 |- ( -. Y e. CC -> ( ( Im ` Y ) e. CC <-> (/) e. CC ) )
  25 mtbiri 17 24 |- ( -. Y e. CC -> -. ( Im ` Y ) e. CC )
  26 con4i 25 |- ( ( Im ` Y ) e. CC -> Y e. CC )
