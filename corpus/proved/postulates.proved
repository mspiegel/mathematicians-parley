# The ray from A through B, read in the page's words: P is in it just where
# P is A, B, between A and B, or has B between A and itself.
lemma grayel
  |- ( ( ( ( P e. CC /\ A e. CC ) /\ B e. CC ) /\ A =/= B ) -> ( P e. { u e. CC | ( A = B \/ ( ( (
      u - A ) / ( B - A ) ) e. RR /\ 0 <_ ( ( u - A ) / ( B - A ) ) ) ) } <-> ( ( ( P = A \/ P = B
      ) \/ ( A =/= P /\ ( ( B - P ) / ( A - P ) ) e. RR /\ ( ( B - P ) / ( A - P ) ) < 0 ) ) \/ ( A
      =/= B /\ ( ( P - B ) / ( A - B ) ) e. RR /\ ( ( P - B ) / ( A - B ) ) < 0 ) ) ) )
  1 simplll |- ( ( ( ( P e. CC /\ A e. CC ) /\ B e. CC ) /\ A =/= B ) -> P e. CC )
  2 simpllr |- ( ( ( ( P e. CC /\ A e. CC ) /\ B e. CC ) /\ A =/= B ) -> A e. CC )
  3 simplr |- ( ( ( ( P e. CC /\ A e. CC ) /\ B e. CC ) /\ A =/= B ) -> B e. CC )
  4 simpr |- ( ( ( ( P e. CC /\ A e. CC ) /\ B e. CC ) /\ A =/= B ) -> A =/= B )
  5 grayback 1 2 3 4 |- ( ( ( ( P e. CC /\ A e. CC ) /\ B e. CC ) /\ A =/= B ) -> ( ( ( ( P = A \/
      P = B ) \/ ( A =/= P /\ ( ( B - P ) / ( A - P ) ) e. RR /\ ( ( B - P ) / ( A - P ) ) < 0 ) )
      \/ ( A =/= B /\ ( ( P - B ) / ( A - B ) ) e. RR /\ ( ( P - B ) / ( A - B ) ) < 0 ) ) -> ( ( (
      P - A ) / ( B - A ) ) e. RR /\ 0 <_ ( ( P - A ) / ( B - A ) ) ) ) )
