# SMSG's postulate 13, in deduction form. The two same-side conditions put
# (D - A)/(B - A), (C - A)/(B - A) and (C - A)/(D - A) all on one side of
# the real line, and then the arguments add.
lemma gangaddinlem
  hypothesis gangaddinlem.1 |- ( ph -> A e. CC )
  hypothesis gangaddinlem.2 |- ( ph -> B e. CC )
  hypothesis gangaddinlem.3 |- ( ph -> C e. CC )
  hypothesis gangaddinlem.4 |- ( ph -> D e. CC )
  hypothesis gangaddinlem.5 |- ( ph -> -. A = B )
  hypothesis gangaddinlem.6 |- ( ph -> -. A = C )
  hypothesis gangaddinlem.7 |- ( ph -> 0 < ( ( Im ` ( ( D - A ) / ( B - A ) ) ) x. ( Im ` ( ( C - A
      ) / ( B - A ) ) ) ) )
  hypothesis gangaddinlem.8 |- ( ph -> 0 < ( ( Im ` ( ( D - A ) / ( C - A ) ) ) x. ( Im ` ( ( B - A
      ) / ( C - A ) ) ) ) )
  |- ( ph -> ( ( abs ` ( ( B - A ) ang ( D - A ) ) ) + ( abs ` ( ( D - A ) ang ( C - A ) ) ) ) = (
      abs ` ( ( B - A ) ang ( C - A ) ) ) )
  1 subcld gangaddinlem.2 gangaddinlem.1 |- ( ph -> ( B - A ) e. CC )
  2 subcld gangaddinlem.4 gangaddinlem.1 |- ( ph -> ( D - A ) e. CC )
  3 subcld gangaddinlem.3 gangaddinlem.1 |- ( ph -> ( C - A ) e. CC )
  4 df-ne |- ( A =/= B <-> -. A = B )
  5 sylibr gangaddinlem.5 4 |- ( ph -> A =/= B )
  6 necomd 5 |- ( ph -> B =/= A )
  7 subne0d gangaddinlem.2 gangaddinlem.1 6 |- ( ph -> ( B - A ) =/= 0 )
  8 df-ne |- ( A =/= C <-> -. A = C )
  9 sylibr gangaddinlem.6 8 |- ( ph -> A =/= C )
  10 necomd 9 |- ( ph -> C =/= A )
  11 subne0d gangaddinlem.3 gangaddinlem.1 10 |- ( ph -> ( C - A ) =/= 0 )
  12 divcld 2 1 7 |- ( ph -> ( ( D - A ) / ( B - A ) ) e. CC )
