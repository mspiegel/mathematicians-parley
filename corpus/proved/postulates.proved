  11 imf |- Im : CC --> RR
  12 fdmi 11 |- dom Im = CC
  13 eleq2i 12 |- ( (/) e. dom Im <-> (/) e. CC )
  14 0ncn |- -. (/) e. CC
  15 mtbir 14 13 |- -. (/) e. dom Im
  16 ndmfv |- ( -. (/) e. dom Im -> ( Im ` (/) ) = (/) )
  17 ax-mp 15 16 |- ( Im ` (/) ) = (/)
  18 fveq2i 7 |- ( Im ` ( A / 0 ) ) = ( Im ` (/) )
  19 eqtri 18 17 |- ( Im ` ( A / 0 ) ) = (/)
  20 fveq2i 10 |- ( Im ` ( B / 0 ) ) = ( Im ` (/) )
  21 eqtri 20 17 |- ( Im ` ( B / 0 ) ) = (/)
  22 oveq12i 19 21 |- ( ( Im ` ( A / 0 ) ) x. ( Im ` ( B / 0 ) ) ) = ( (/) x. (/) )
  23 ax-mulf |- x. : ( CC X. CC ) --> CC
  24 fdmi 23 |- dom x. = ( CC X. CC )
  25 intnan 14 |- -. ( (/) e. CC /\ (/) e. CC )
  26 ndmov 24 |- ( -. ( (/) e. CC /\ (/) e. CC ) -> ( (/) x. (/) ) = (/) )
  27 ax-mp 25 26 |- ( (/) x. (/) ) = (/)
  28 eqtri 22 27 |- ( ( Im ` ( A / 0 ) ) x. ( Im ` ( B / 0 ) ) ) = (/)

# A product of imaginary parts of quotients by P - R that is an extended
# real, as it is when it is compared with 0, makes P and R two points.
lemma gimprodne
  hypothesis gimprodne.1 |- ( ph -> P e. CC )
  hypothesis gimprodne.2 |- ( ph -> R e. CC )
  hypothesis gimprodne.3 |- ( ph -> ( ( Im ` ( A / ( P - R ) ) ) x. ( Im ` ( B / ( P - R ) ) ) ) e.
      RR* )
  |- ( ph -> P =/= R )
  1 simpr |- ( ( ph /\ P = R ) -> P = R )
  2 oveq1d 1 |- ( ( ph /\ P = R ) -> ( P - R ) = ( R - R ) )
  3 adantr gimprodne.2 |- ( ( ph /\ P = R ) -> R e. CC )
  4 subidd 3 |- ( ( ph /\ P = R ) -> ( R - R ) = 0 )
  5 eqtrd 2 4 |- ( ( ph /\ P = R ) -> ( P - R ) = 0 )
  6 oveq2d 5 |- ( ( ph /\ P = R ) -> ( A / ( P - R ) ) = ( A / 0 ) )
  7 fveq2d 6 |- ( ( ph /\ P = R ) -> ( Im ` ( A / ( P - R ) ) ) = ( Im ` ( A / 0 ) ) )
  8 oveq2d 5 |- ( ( ph /\ P = R ) -> ( B / ( P - R ) ) = ( B / 0 ) )
  9 fveq2d 8 |- ( ( ph /\ P = R ) -> ( Im ` ( B / ( P - R ) ) ) = ( Im ` ( B / 0 ) ) )
  10 oveq12d 7 9 |- ( ( ph /\ P = R ) -> ( ( Im ` ( A / ( P - R ) ) ) x. ( Im ` ( B / ( P - R ) ) )
      ) = ( ( Im ` ( A / 0 ) ) x. ( Im ` ( B / 0 ) ) ) )
  11 gimdivz |- ( ( Im ` ( A / 0 ) ) x. ( Im ` ( B / 0 ) ) ) = (/)
  12 eqtrdi 10 11 |- ( ( ph /\ P = R ) -> ( ( Im ` ( A / ( P - R ) ) ) x. ( Im ` ( B / ( P - R ) )
      ) ) = (/) )
  13 adantr gimprodne.3 |- ( ( ph /\ P = R ) -> ( ( Im ` ( A / ( P - R ) ) ) x. ( Im ` ( B / ( P -
      R ) ) ) ) e. RR* )
  14 eqeltrrd 12 13 |- ( ( ph /\ P = R ) -> (/) e. RR* )
  15 gemptynxr |- -. (/) e. RR*
  16 a1i 15 |- ( ( ph /\ P = R ) -> -. (/) e. RR* )
  17 pm2.65da 14 16 |- ( ph -> -. P = R )
  18 neqned 17 |- ( ph -> P =/= R )

# A quotient (S - R)/D whose imaginary part is not 0 makes S and R two
# points: S = R makes the quotient 0.
lemma gimne
  hypothesis gimne.1 |- ( ph -> R e. CC )
  hypothesis gimne.2 |- ( ph -> D e. CC )
  hypothesis gimne.3 |- ( ph -> D =/= 0 )
  hypothesis gimne.4 |- ( ph -> ( Im ` ( ( S - R ) / D ) ) =/= 0 )
  |- ( ph -> S =/= R )
  1 simpr |- ( ( ph /\ S = R ) -> S = R )
  2 oveq1d 1 |- ( ( ph /\ S = R ) -> ( S - R ) = ( R - R ) )
  3 adantr gimne.1 |- ( ( ph /\ S = R ) -> R e. CC )
  4 subidd 3 |- ( ( ph /\ S = R ) -> ( R - R ) = 0 )
  5 eqtrd 2 4 |- ( ( ph /\ S = R ) -> ( S - R ) = 0 )
  6 oveq1d 5 |- ( ( ph /\ S = R ) -> ( ( S - R ) / D ) = ( 0 / D ) )
  7 adantr gimne.2 |- ( ( ph /\ S = R ) -> D e. CC )
  8 adantr gimne.3 |- ( ( ph /\ S = R ) -> D =/= 0 )
  9 div0d 7 8 |- ( ( ph /\ S = R ) -> ( 0 / D ) = 0 )
  10 eqtrd 6 9 |- ( ( ph /\ S = R ) -> ( ( S - R ) / D ) = 0 )
  11 fveq2d 10 |- ( ( ph /\ S = R ) -> ( Im ` ( ( S - R ) / D ) ) = ( Im ` 0 ) )
  12 im0 |- ( Im ` 0 ) = 0
  13 eqtrdi 11 12 |- ( ( ph /\ S = R ) -> ( Im ` ( ( S - R ) / D ) ) = 0 )
  14 adantr gimne.4 |- ( ( ph /\ S = R ) -> ( Im ` ( ( S - R ) / D ) ) =/= 0 )
  15 neneqd 14 |- ( ( ph /\ S = R ) -> -. ( Im ` ( ( S - R ) / D ) ) = 0 )
  16 pm2.65da 13 15 |- ( ph -> -. S = R )
  17 neqned 16 |- ( ph -> S =/= R )

# X's place over D is its place along the way from R to S times S's place
# over D.
lemma glinemul
  hypothesis glinemul.1 |- ( ph -> X e. CC )
  hypothesis glinemul.2 |- ( ph -> R e. CC )
  hypothesis glinemul.3 |- ( ph -> S e. CC )
  hypothesis glinemul.4 |- ( ph -> D e. CC )
  hypothesis glinemul.5 |- ( ph -> D =/= 0 )
  hypothesis glinemul.6 |- ( ph -> S =/= R )
  |- ( ph -> ( ( X - R ) / D ) = ( ( ( X - R ) / ( S - R ) ) x. ( ( S - R ) / D ) ) )
  1 subcld glinemul.1 glinemul.2 |- ( ph -> ( X - R ) e. CC )
  2 subcld glinemul.3 glinemul.2 |- ( ph -> ( S - R ) e. CC )
  3 subne0d glinemul.3 glinemul.2 glinemul.6 |- ( ph -> ( S - R ) =/= 0 )
  4 divcld 1 2 3 |- ( ph -> ( ( X - R ) / ( S - R ) ) e. CC )
  5 divassd 4 2 glinemul.4 glinemul.5 |- ( ph -> ( ( ( ( X - R ) / ( S - R ) ) x. ( S - R ) ) / D )
      = ( ( ( X - R ) / ( S - R ) ) x. ( ( S - R ) / D ) ) )
  6 divcan1d 1 2 3 |- ( ph -> ( ( ( X - R ) / ( S - R ) ) x. ( S - R ) ) = ( X - R ) )
  7 oveq1d 6 |- ( ph -> ( ( ( ( X - R ) / ( S - R ) ) x. ( S - R ) ) / D ) = ( ( X - R ) / D ) )
  8 eqtr3d 7 5 |- ( ph -> ( ( X - R ) / D ) = ( ( ( X - R ) / ( S - R ) ) x. ( ( S - R ) / D ) ) )


# Line RS meets line RP only at R, when S is off line RP: a point X of
# line RS other than R is X - R = t (S - R) with t real and not 0, so its
# place over P - R is t times S's, which is not real.
lemma gofflinethrud
  hypothesis gofflinethrud.1 |- ( ph -> R e. CC )
  hypothesis gofflinethrud.2 |- ( ph -> P e. CC )
  hypothesis gofflinethrud.3 |- ( ph -> S e. CC )
  hypothesis gofflinethrud.4 |- ( ph -> X e. CC )
