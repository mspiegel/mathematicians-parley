  hypothesis gsegbeyd.9 |- ( ph -> ( P =/= X /\ ( ( Q - X ) / ( P - X ) ) e. RR /\ ( ( Q - X ) / (
      P - X ) ) < 0 ) )
  |- ( ph -> 0 < ( ( Im ` ( ( P - A ) / ( B - A ) ) ) x. ( Im ` ( ( X - A ) / ( B - A ) ) ) ) )
