      ) e. RR ) ) -> P =/= A )
  11 adantr 1 |- ( ( ( ( ( A e. CC /\ B e. CC ) /\ P e. CC ) /\ -. ( A = B \/ ( ( P - A ) / ( B - A
      ) ) e. RR ) ) /\ P = B ) -> A e. CC )
  12 adantr 2 |- ( ( ( ( ( A e. CC /\ B e. CC ) /\ P e. CC ) /\ -. ( A = B \/ ( ( P - A ) / ( B - A
