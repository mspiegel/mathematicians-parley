# The area of triangle XYZ as half the base YZ times the height: the
# height is |YZ| times the size of the imaginary part of X's place along
# line YZ, the sine of the signed angle at Z being that imaginary part
# over the place's size (`efiarg`).
lemma gareaim
  hypothesis gareaim.1 |- ( ph -> X e. CC )
  hypothesis gareaim.2 |- ( ph -> Y e. CC )
  hypothesis gareaim.3 |- ( ph -> Z e. CC )
  hypothesis gareaim.4 |- ( ph -> X =/= Z )
  hypothesis gareaim.5 |- ( ph -> Y =/= Z )
  |- ( ph -> ( ( ( 1 / 2 ) x. ( ( abs ` ( Y - Z ) ) x. ( abs ` ( X - Z ) ) ) ) x. ( abs ` ( sin ` (
      ( Y - Z ) ang ( X - Z ) ) ) ) ) = ( ( ( 1 / 2 ) x. ( abs ` ( Y - Z ) ) ) x. ( ( abs ` ( Y - Z
      ) ) x. ( abs ` ( Im ` ( ( X - Z ) / ( Y - Z ) ) ) ) ) ) )
  1 subcld gareaim.1 gareaim.3 |- ( ph -> ( X - Z ) e. CC )
  2 subcld gareaim.2 gareaim.3 |- ( ph -> ( Y - Z ) e. CC )
  3 subne0d gareaim.1 gareaim.3 gareaim.4 |- ( ph -> ( X - Z ) =/= 0 )
  4 subne0d gareaim.2 gareaim.3 gareaim.5 |- ( ph -> ( Y - Z ) =/= 0 )
  5 gangval |- ( ( ( ( Y - Z ) e. CC /\ ( Y - Z ) =/= 0 ) /\ ( ( X - Z ) e. CC /\ ( X - Z ) =/= 0 )
      ) -> ( ( Y - Z ) ang ( X - Z ) ) = ( Im ` ( log ` ( ( X - Z ) / ( Y - Z ) ) ) ) )
  6 jca 2 4 |- ( ph -> ( ( Y - Z ) e. CC /\ ( Y - Z ) =/= 0 ) )
  7 jca 1 3 |- ( ph -> ( ( X - Z ) e. CC /\ ( X - Z ) =/= 0 ) )
  8 jca 6 7 |- ( ph -> ( ( ( Y - Z ) e. CC /\ ( Y - Z ) =/= 0 ) /\ ( ( X - Z ) e. CC /\ ( X - Z )
      =/= 0 ) ) )
  9 syl 8 5 |- ( ph -> ( ( Y - Z ) ang ( X - Z ) ) = ( Im ` ( log ` ( ( X - Z ) / ( Y - Z ) ) ) ) )
  10 divcld 1 2 4 |- ( ph -> ( ( X - Z ) / ( Y - Z ) ) e. CC )
  11 divne0d 1 2 3 4 |- ( ph -> ( ( X - Z ) / ( Y - Z ) ) =/= 0 )
  12 logcld 10 11 |- ( ph -> ( log ` ( ( X - Z ) / ( Y - Z ) ) ) e. CC )
  13 imcld 12 |- ( ph -> ( Im ` ( log ` ( ( X - Z ) / ( Y - Z ) ) ) ) e. RR )
  14 resinval |- ( ( Im ` ( log ` ( ( X - Z ) / ( Y - Z ) ) ) ) e. RR -> ( sin ` ( Im ` ( log ` ( (
      X - Z ) / ( Y - Z ) ) ) ) ) = ( Im ` ( exp ` ( _i x. ( Im ` ( log ` ( ( X - Z ) / ( Y - Z ) )
      ) ) ) ) ) )
  15 syl 13 14 |- ( ph -> ( sin ` ( Im ` ( log ` ( ( X - Z ) / ( Y - Z ) ) ) ) ) = ( Im ` ( exp ` (
      _i x. ( Im ` ( log ` ( ( X - Z ) / ( Y - Z ) ) ) ) ) ) ) )
  16 efiarg |- ( ( ( ( X - Z ) / ( Y - Z ) ) e. CC /\ ( ( X - Z ) / ( Y - Z ) ) =/= 0 ) -> ( exp `
      ( _i x. ( Im ` ( log ` ( ( X - Z ) / ( Y - Z ) ) ) ) ) ) = ( ( ( X - Z ) / ( Y - Z ) ) / (
      abs ` ( ( X - Z ) / ( Y - Z ) ) ) ) )
  17 jca 10 11 |- ( ph -> ( ( ( X - Z ) / ( Y - Z ) ) e. CC /\ ( ( X - Z ) / ( Y - Z ) ) =/= 0 ) )
  18 syl 17 16 |- ( ph -> ( exp ` ( _i x. ( Im ` ( log ` ( ( X - Z ) / ( Y - Z ) ) ) ) ) ) = ( ( (
