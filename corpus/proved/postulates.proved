# Two lines through P parallel to line AB are one line: both run the way
# B - A does, so D - P is a real multiple of C - P.
lemma gparuniqd
  hypothesis gparuniqd.1 |- ( ph -> A e. CC )
  hypothesis gparuniqd.2 |- ( ph -> B e. CC )
  hypothesis gparuniqd.3 |- ( ph -> P e. CC )
  hypothesis gparuniqd.4 |- ( ph -> C e. CC )
  hypothesis gparuniqd.5 |- ( ph -> D e. CC )
  hypothesis gparuniqd.6 |- ( ph -> A =/= B )
  hypothesis gparuniqd.7 |- ( ph -> P =/= C )
  hypothesis gparuniqd.8 |- ( ph -> P =/= D )
  hypothesis gparuniqd.9 |- ( ph -> ( ( C - P ) / ( B - A ) ) e. RR )
  hypothesis gparuniqd.10 |- ( ph -> ( ( D - P ) / ( B - A ) ) e. RR )
  |- ( ph -> { u e. CC | ( P = C \/ ( ( u - P ) / ( C - P ) ) e. RR ) } = { u e. CC | ( P = D \/ (
      ( u - P ) / ( D - P ) ) e. RR ) } )
  1 subcld gparuniqd.2 gparuniqd.1 |- ( ph -> ( B - A ) e. CC )
  2 necomd gparuniqd.6 |- ( ph -> B =/= A )
  3 subne0d gparuniqd.2 gparuniqd.1 2 |- ( ph -> ( B - A ) =/= 0 )
  4 subcld gparuniqd.4 gparuniqd.3 |- ( ph -> ( C - P ) e. CC )
  5 necomd gparuniqd.7 |- ( ph -> C =/= P )
  6 subne0d gparuniqd.4 gparuniqd.3 5 |- ( ph -> ( C - P ) =/= 0 )
  7 subcld gparuniqd.5 gparuniqd.3 |- ( ph -> ( D - P ) e. CC )
  8 divcan7d 7 4 1 6 3 |- ( ph -> ( ( ( D - P ) / ( B - A ) ) / ( ( C - P ) / ( B - A ) ) ) = ( ( D
      - P ) / ( C - P ) ) )
  9 divne0d 4 1 6 3 |- ( ph -> ( ( C - P ) / ( B - A ) ) =/= 0 )
  10 redivcld gparuniqd.10 gparuniqd.9 9 |- ( ph -> ( ( ( D - P ) / ( B - A ) ) / ( ( C - P ) / ( B
      - A ) ) ) e. RR )
  11 eqeltrrd 8 10 |- ( ph -> ( ( D - P ) / ( C - P ) ) e. RR )
  12 olcd 11 |- ( ph -> ( P = C \/ ( ( D - P ) / ( C - P ) ) e. RR ) )
  13 subidd gparuniqd.3 |- ( ph -> ( P - P ) = 0 )
  14 oveq1d 13 |- ( ph -> ( ( P - P ) / ( C - P ) ) = ( 0 / ( C - P ) ) )
  15 div0d 4 6 |- ( ph -> ( 0 / ( C - P ) ) = 0 )
  16 eqtrd 14 15 |- ( ph -> ( ( P - P ) / ( C - P ) ) = 0 )
  17 0re |- 0 e. RR
  18 a1i 17 |- ( ph -> 0 e. RR )
  19 eqeltrd 16 18 |- ( ph -> ( ( P - P ) / ( C - P ) ) e. RR )
  20 olcd 19 |- ( ph -> ( P = C \/ ( ( P - P ) / ( C - P ) ) e. RR ) )
  21 glineud gparuniqd.3 gparuniqd.5 gparuniqd.3 gparuniqd.4 gparuniqd.8 gparuniqd.7 20 12 |- ( ph
      -> { u e. CC | ( P = D \/ ( ( u - P ) / ( D - P ) ) e. RR ) } = { u e. CC | ( P = C \/ ( ( u
      - P ) / ( C - P ) ) e. RR ) } )
  22 eqcomd 21 |- ( ph -> { u e. CC | ( P = C \/ ( ( u - P ) / ( C - P ) ) e. RR ) } = { u e. CC |
      ( P = D \/ ( ( u - P ) / ( D - P ) ) e. RR ) } )

# SMSG's postulate 16, the parallel postulate: through a point not on a
# line there is at most one line parallel to it.
lemma gparuniq
  |- ( ( ( ( ( ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ P e. CC ) /\ C e. CC ) /\ D e. CC ) /\ A =/= B )
      /\ -. ( A = B \/ ( ( P - A ) / ( B - A ) ) e. RR ) ) /\ P =/= C ) /\ P =/= D ) /\ ( ( C - P )
      / ( B - A ) ) e. RR ) /\ ( ( D - P ) / ( B - A ) ) e. RR ) -> { u e. CC | ( P = C \/ ( ( u -
      P ) / ( C - P ) ) e. RR ) } = { u e. CC | ( P = D \/ ( ( u - P ) / ( D - P ) ) e. RR ) } )
  1 simp-10l |- ( ( ( ( ( ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ P e. CC ) /\ C e. CC ) /\ D e. CC )
      /\ A =/= B ) /\ -. ( A = B \/ ( ( P - A ) / ( B - A ) ) e. RR ) ) /\ P =/= C ) /\ P =/= D )
      /\ ( ( C - P ) / ( B - A ) ) e. RR ) /\ ( ( D - P ) / ( B - A ) ) e. RR ) -> A e. CC )
  2 simp-10r |- ( ( ( ( ( ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ P e. CC ) /\ C e. CC ) /\ D e. CC )
      /\ A =/= B ) /\ -. ( A = B \/ ( ( P - A ) / ( B - A ) ) e. RR ) ) /\ P =/= C ) /\ P =/= D )
      /\ ( ( C - P ) / ( B - A ) ) e. RR ) /\ ( ( D - P ) / ( B - A ) ) e. RR ) -> B e. CC )
  3 simp-9r |- ( ( ( ( ( ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ P e. CC ) /\ C e. CC ) /\ D e. CC ) /\
      A =/= B ) /\ -. ( A = B \/ ( ( P - A ) / ( B - A ) ) e. RR ) ) /\ P =/= C ) /\ P =/= D ) /\ (
      ( C - P ) / ( B - A ) ) e. RR ) /\ ( ( D - P ) / ( B - A ) ) e. RR ) -> P e. CC )
  4 simp-8r |- ( ( ( ( ( ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ P e. CC ) /\ C e. CC ) /\ D e. CC ) /\
      A =/= B ) /\ -. ( A = B \/ ( ( P - A ) / ( B - A ) ) e. RR ) ) /\ P =/= C ) /\ P =/= D ) /\ (
      ( C - P ) / ( B - A ) ) e. RR ) /\ ( ( D - P ) / ( B - A ) ) e. RR ) -> C e. CC )
  5 simp-7r |- ( ( ( ( ( ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ P e. CC ) /\ C e. CC ) /\ D e. CC ) /\
      A =/= B ) /\ -. ( A = B \/ ( ( P - A ) / ( B - A ) ) e. RR ) ) /\ P =/= C ) /\ P =/= D ) /\ (
      ( C - P ) / ( B - A ) ) e. RR ) /\ ( ( D - P ) / ( B - A ) ) e. RR ) -> D e. CC )
  6 simp-6r |- ( ( ( ( ( ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ P e. CC ) /\ C e. CC ) /\ D e. CC ) /\
      A =/= B ) /\ -. ( A = B \/ ( ( P - A ) / ( B - A ) ) e. RR ) ) /\ P =/= C ) /\ P =/= D ) /\ (
      ( C - P ) / ( B - A ) ) e. RR ) /\ ( ( D - P ) / ( B - A ) ) e. RR ) -> A =/= B )
  7 simp-4r |- ( ( ( ( ( ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ P e. CC ) /\ C e. CC ) /\ D e. CC ) /\
      A =/= B ) /\ -. ( A = B \/ ( ( P - A ) / ( B - A ) ) e. RR ) ) /\ P =/= C ) /\ P =/= D ) /\ (
      ( C - P ) / ( B - A ) ) e. RR ) /\ ( ( D - P ) / ( B - A ) ) e. RR ) -> P =/= C )
  8 simpllr |- ( ( ( ( ( ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ P e. CC ) /\ C e. CC ) /\ D e. CC ) /\
      A =/= B ) /\ -. ( A = B \/ ( ( P - A ) / ( B - A ) ) e. RR ) ) /\ P =/= C ) /\ P =/= D ) /\ (
      ( C - P ) / ( B - A ) ) e. RR ) /\ ( ( D - P ) / ( B - A ) ) e. RR ) -> P =/= D )
  9 simplr |- ( ( ( ( ( ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ P e. CC ) /\ C e. CC ) /\ D e. CC ) /\
      A =/= B ) /\ -. ( A = B \/ ( ( P - A ) / ( B - A ) ) e. RR ) ) /\ P =/= C ) /\ P =/= D ) /\ (
      ( C - P ) / ( B - A ) ) e. RR ) /\ ( ( D - P ) / ( B - A ) ) e. RR ) -> ( ( C - P ) / ( B - A
      ) ) e. RR )
  10 simpr |- ( ( ( ( ( ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ P e. CC ) /\ C e. CC ) /\ D e. CC ) /\
      A =/= B ) /\ -. ( A = B \/ ( ( P - A ) / ( B - A ) ) e. RR ) ) /\ P =/= C ) /\ P =/= D ) /\ (
      ( C - P ) / ( B - A ) ) e. RR ) /\ ( ( D - P ) / ( B - A ) ) e. RR ) -> ( ( D - P ) / ( B - A
      ) ) e. RR )
