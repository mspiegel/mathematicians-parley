# SMSG's postulate 18, said of triangles: congruent triangles have the
# same area.
lemma gareacong
  |- ( ( ( ( ( ( ( ( ( P e. CC /\ Q e. CC ) /\ R e. CC ) /\ S e. CC ) /\ T e. CC ) /\ U e. CC ) /\
      ( ( ( -. P = Q /\ -. Q = R ) /\ -. P = R ) /\ -. ( ( R - P ) / ( Q - P ) ) e. RR ) ) /\ ( ( (
      -. S = T /\ -. T = U ) /\ -. S = U ) /\ -. ( ( U - S ) / ( T - S ) ) e. RR ) ) /\ ( ( ( ( ( (
      abs ` ( P - Q ) ) = ( abs ` ( S - T ) ) /\ ( abs ` ( Q - R ) ) = ( abs ` ( T - U ) ) ) /\ (
      abs ` ( R - P ) ) = ( abs ` ( U - S ) ) ) /\ ( abs ` ( ( P - Q ) ang ( R - Q ) ) ) = ( abs `
      ( ( S - T ) ang ( U - T ) ) ) ) /\ ( abs ` ( ( Q - R ) ang ( P - R ) ) ) = ( abs ` ( ( T - U
      ) ang ( S - U ) ) ) ) /\ ( abs ` ( ( R - P ) ang ( Q - P ) ) ) = ( abs ` ( ( U - S ) ang ( T
      - S ) ) ) ) ) -> ( ( ( 1 / 2 ) x. ( ( abs ` ( Q - R ) ) x. ( abs ` ( P - R ) ) ) ) x. ( abs `
      ( sin ` ( ( Q - R ) ang ( P - R ) ) ) ) ) = ( ( ( 1 / 2 ) x. ( ( abs ` ( T - U ) ) x. ( abs `
      ( S - U ) ) ) ) x. ( abs ` ( sin ` ( ( T - U ) ang ( S - U ) ) ) ) ) )
  1 simp-8l |- ( ( ( ( ( ( ( ( ( P e. CC /\ Q e. CC ) /\ R e. CC ) /\ S e. CC ) /\ T e. CC ) /\ U
      e. CC ) /\ ( ( ( -. P = Q /\ -. Q = R ) /\ -. P = R ) /\ -. ( ( R - P ) / ( Q - P ) ) e. RR )
      ) /\ ( ( ( -. S = T /\ -. T = U ) /\ -. S = U ) /\ -. ( ( U - S ) / ( T - S ) ) e. RR ) ) /\
      ( ( ( ( ( ( abs ` ( P - Q ) ) = ( abs ` ( S - T ) ) /\ ( abs ` ( Q - R ) ) = ( abs ` ( T - U
      ) ) ) /\ ( abs ` ( R - P ) ) = ( abs ` ( U - S ) ) ) /\ ( abs ` ( ( P - Q ) ang ( R - Q ) ) )
      = ( abs ` ( ( S - T ) ang ( U - T ) ) ) ) /\ ( abs ` ( ( Q - R ) ang ( P - R ) ) ) = ( abs `
      ( ( T - U ) ang ( S - U ) ) ) ) /\ ( abs ` ( ( R - P ) ang ( Q - P ) ) ) = ( abs ` ( ( U - S
      ) ang ( T - S ) ) ) ) ) -> P e. CC )
  2 simp-8r |- ( ( ( ( ( ( ( ( ( P e. CC /\ Q e. CC ) /\ R e. CC ) /\ S e. CC ) /\ T e. CC ) /\ U
      e. CC ) /\ ( ( ( -. P = Q /\ -. Q = R ) /\ -. P = R ) /\ -. ( ( R - P ) / ( Q - P ) ) e. RR )
      ) /\ ( ( ( -. S = T /\ -. T = U ) /\ -. S = U ) /\ -. ( ( U - S ) / ( T - S ) ) e. RR ) ) /\
      ( ( ( ( ( ( abs ` ( P - Q ) ) = ( abs ` ( S - T ) ) /\ ( abs ` ( Q - R ) ) = ( abs ` ( T - U
      ) ) ) /\ ( abs ` ( R - P ) ) = ( abs ` ( U - S ) ) ) /\ ( abs ` ( ( P - Q ) ang ( R - Q ) ) )
      = ( abs ` ( ( S - T ) ang ( U - T ) ) ) ) /\ ( abs ` ( ( Q - R ) ang ( P - R ) ) ) = ( abs `
      ( ( T - U ) ang ( S - U ) ) ) ) /\ ( abs ` ( ( R - P ) ang ( Q - P ) ) ) = ( abs ` ( ( U - S
      ) ang ( T - S ) ) ) ) ) -> Q e. CC )
  3 simp-7r |- ( ( ( ( ( ( ( ( ( P e. CC /\ Q e. CC ) /\ R e. CC ) /\ S e. CC ) /\ T e. CC ) /\ U
      e. CC ) /\ ( ( ( -. P = Q /\ -. Q = R ) /\ -. P = R ) /\ -. ( ( R - P ) / ( Q - P ) ) e. RR )
      ) /\ ( ( ( -. S = T /\ -. T = U ) /\ -. S = U ) /\ -. ( ( U - S ) / ( T - S ) ) e. RR ) ) /\
      ( ( ( ( ( ( abs ` ( P - Q ) ) = ( abs ` ( S - T ) ) /\ ( abs ` ( Q - R ) ) = ( abs ` ( T - U
      ) ) ) /\ ( abs ` ( R - P ) ) = ( abs ` ( U - S ) ) ) /\ ( abs ` ( ( P - Q ) ang ( R - Q ) ) )
      = ( abs ` ( ( S - T ) ang ( U - T ) ) ) ) /\ ( abs ` ( ( Q - R ) ang ( P - R ) ) ) = ( abs `
      ( ( T - U ) ang ( S - U ) ) ) ) /\ ( abs ` ( ( R - P ) ang ( Q - P ) ) ) = ( abs ` ( ( U - S
      ) ang ( T - S ) ) ) ) ) -> R e. CC )
