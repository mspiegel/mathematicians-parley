  8 intnan 4 |- -. ( B e. CC /\ 0 e. ( CC \ { 0 } ) )
  9 ndmovg |- ( ( dom / = ( CC X. ( CC \ { 0 } ) ) /\ -. ( B e. CC /\ 0 e. ( CC \ { 0 } ) ) ) -> (
      B / 0 ) = (/) )
