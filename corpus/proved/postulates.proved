  9 pm2.65da 7 8 |- ( ( ( ( A e. CC /\ B e. CC ) /\ P e. CC ) /\ -. ( A = B \/ ( ( P - A ) / ( B -
      A ) ) e. RR ) ) -> -. P = A )
