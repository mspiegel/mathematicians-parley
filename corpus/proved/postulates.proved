  hypothesis gofflinethrud.6 |- ( ph -> ( R = S \/ ( ( X - R ) / ( S - R ) ) e. RR ) )
  hypothesis gofflinethrud.7 |- ( ph -> X =/= R )
  |- ( ph -> -. ( R = P \/ ( ( X - R ) / ( P - R ) ) e. RR ) )
