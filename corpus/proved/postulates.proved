# SMSG's postulate 1: two distinct points lie on exactly one line. Said
# of line AB: any two distinct points of a line make that line.
lemma glineuniq
  |- ( ( ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ C e. CC ) /\ D e. CC ) /\ A =/= B ) /\ C =/= D ) /\ (
      C = D \/ ( ( A - C ) / ( D - C ) ) e. RR ) ) /\ ( C = D \/ ( ( B - C ) / ( D - C ) ) e. RR )
      ) -> { u e. CC | ( A = B \/ ( ( u - A ) / ( B - A ) ) e. RR ) } = { u e. CC | ( C = D \/ ( (
      u - C ) / ( D - C ) ) e. RR ) } )
  1 simp-7l |- ( ( ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ C e. CC ) /\ D e. CC ) /\ A =/= B ) /\ C =/=
      D ) /\ ( C = D \/ ( ( A - C ) / ( D - C ) ) e. RR ) ) /\ ( C = D \/ ( ( B - C ) / ( D - C ) )
      e. RR ) ) -> A e. CC )
  2 simp-7r |- ( ( ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ C e. CC ) /\ D e. CC ) /\ A =/= B ) /\ C =/=
      D ) /\ ( C = D \/ ( ( A - C ) / ( D - C ) ) e. RR ) ) /\ ( C = D \/ ( ( B - C ) / ( D - C ) )
      e. RR ) ) -> B e. CC )
  3 simp-6r |- ( ( ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ C e. CC ) /\ D e. CC ) /\ A =/= B ) /\ C =/=
      D ) /\ ( C = D \/ ( ( A - C ) / ( D - C ) ) e. RR ) ) /\ ( C = D \/ ( ( B - C ) / ( D - C ) )
      e. RR ) ) -> C e. CC )
  4 simp-5r |- ( ( ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ C e. CC ) /\ D e. CC ) /\ A =/= B ) /\ C =/=
      D ) /\ ( C = D \/ ( ( A - C ) / ( D - C ) ) e. RR ) ) /\ ( C = D \/ ( ( B - C ) / ( D - C ) )
      e. RR ) ) -> D e. CC )
  5 simp-4r |- ( ( ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ C e. CC ) /\ D e. CC ) /\ A =/= B ) /\ C =/=
      D ) /\ ( C = D \/ ( ( A - C ) / ( D - C ) ) e. RR ) ) /\ ( C = D \/ ( ( B - C ) / ( D - C ) )
      e. RR ) ) -> A =/= B )
  6 simpllr |- ( ( ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ C e. CC ) /\ D e. CC ) /\ A =/= B ) /\ C =/=
      D ) /\ ( C = D \/ ( ( A - C ) / ( D - C ) ) e. RR ) ) /\ ( C = D \/ ( ( B - C ) / ( D - C ) )
      e. RR ) ) -> C =/= D )
  7 simplr |- ( ( ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ C e. CC ) /\ D e. CC ) /\ A =/= B ) /\ C =/=
      D ) /\ ( C = D \/ ( ( A - C ) / ( D - C ) ) e. RR ) ) /\ ( C = D \/ ( ( B - C ) / ( D - C ) )
      e. RR ) ) -> ( C = D \/ ( ( A - C ) / ( D - C ) ) e. RR ) )
  8 simpr |- ( ( ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ C e. CC ) /\ D e. CC ) /\ A =/= B ) /\ C =/= D
      ) /\ ( C = D \/ ( ( A - C ) / ( D - C ) ) e. RR ) ) /\ ( C = D \/ ( ( B - C ) / ( D - C ) )
      e. RR ) ) -> ( C = D \/ ( ( B - C ) / ( D - C ) ) e. RR ) )
  9 glineud 1 2 3 4 5 6 7 8 |- ( ( ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ C e. CC ) /\ D e. CC ) /\ A
      =/= B ) /\ C =/= D ) /\ ( C = D \/ ( ( A - C ) / ( D - C ) ) e. RR ) ) /\ ( C = D \/ ( ( B -
      C ) / ( D - C ) ) e. RR ) ) -> { u e. CC | ( A = B \/ ( ( u - A ) / ( B - A ) ) e. RR ) } = {
      u e. CC | ( C = D \/ ( ( u - C ) / ( D - C ) ) e. RR ) } )

# SMSG's postulate 5, of the plane: there are three points not on one line.
# 0, 1 and i are three such, since i is not real.
lemma gthreepts
  |- E. x e. CC E. y e. CC E. z e. CC ( ( ( -. x = y /\ -. y = z ) /\ -. x = z ) /\ -. ( ( z - x )
      / ( y - x ) ) e. RR )
