# A point X between P and Q: its side of line AB moves from P's by a
# negative multiple of the move from P's to Q's, so X shares P's side.
lemma gplscvx
  hypothesis gplscvx.1 |- ( ph -> A e. CC )
  hypothesis gplscvx.2 |- ( ph -> B e. CC )
  hypothesis gplscvx.3 |- ( ph -> P e. CC )
  hypothesis gplscvx.4 |- ( ph -> Q e. CC )
  hypothesis gplscvx.5 |- ( ph -> X e. CC )
  hypothesis gplscvx.6 |- ( ph -> A =/= B )
  hypothesis gplscvx.7 |- ( ph -> P =/= X )
  hypothesis gplscvx.8 |- ( ph -> ( ( Q - X ) / ( P - X ) ) e. RR )
  hypothesis gplscvx.9 |- ( ph -> ( ( Q - X ) / ( P - X ) ) < 0 )
  hypothesis gplscvx.10 |- ( ph -> 0 < ( ( Im ` ( ( P - A ) / ( B - A ) ) ) x. ( Im ` ( ( Q - A ) /
      ( B - A ) ) ) ) )
  |- ( ph -> 0 < ( ( Im ` ( ( X - A ) / ( B - A ) ) ) x. ( Im ` ( ( P - A ) / ( B - A ) ) ) ) )
