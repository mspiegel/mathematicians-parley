  39 eqeltrrd 38 32 |- ( ( ph /\ ( R = P \/ ( ( X - R ) / ( P - R ) ) e. RR ) ) -> ( ( S - R ) / (
      P - R ) ) e. RR )
  40 adantr 4 |- ( ( ph /\ ( R = P \/ ( ( X - R ) / ( P - R ) ) e. RR ) ) -> -. ( ( S - R ) / ( P -
      R ) ) e. RR )
  41 pm2.65da 39 40 |- ( ph -> -. ( R = P \/ ( ( X - R ) / ( P - R ) ) e. RR ) )

# Two lines through R meet only at R: a point of line RS other than R is
# off line RP when S is.
lemma gofflinethru
  |- ( ( ( ( ( ( ( R e. CC /\ P e. CC ) /\ S e. CC ) /\ X e. CC ) /\ -. ( R = P \/ ( ( S - R ) / (
      P - R ) ) e. RR ) ) /\ ( R = S \/ ( ( X - R ) / ( S - R ) ) e. RR ) ) /\ X =/= R ) -> -. ( R
