# SMSG's postulate 9, second part: a point between two points on one
# side of a line is on that side.
lemma gplanesepcvx
  |- ( ( ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ P e. CC ) /\ Q e. CC ) /\ X e. CC ) /\ A =/= B ) /\ 0
      < ( ( Im ` ( ( P - A ) / ( B - A ) ) ) x. ( Im ` ( ( Q - A ) / ( B - A ) ) ) ) ) /\ ( P =/= X
      /\ ( ( Q - X ) / ( P - X ) ) e. RR /\ ( ( Q - X ) / ( P - X ) ) < 0 ) ) -> 0 < ( ( Im ` ( ( X
      - A ) / ( B - A ) ) ) x. ( Im ` ( ( P - A ) / ( B - A ) ) ) ) )
  1 simp-7l |- ( ( ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ P e. CC ) /\ Q e. CC ) /\ X e. CC ) /\ A =/=
      B ) /\ 0 < ( ( Im ` ( ( P - A ) / ( B - A ) ) ) x. ( Im ` ( ( Q - A ) / ( B - A ) ) ) ) ) /\
      ( P =/= X /\ ( ( Q - X ) / ( P - X ) ) e. RR /\ ( ( Q - X ) / ( P - X ) ) < 0 ) ) -> A e. CC )
  2 simp-7r |- ( ( ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ P e. CC ) /\ Q e. CC ) /\ X e. CC ) /\ A =/=
