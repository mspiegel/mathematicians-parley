      /\ -. P = R ) /\ -. ( ( R - P ) / ( Q - P ) ) e. RR ) ) -> -. ( Q = R \/ ( ( P - Q ) / ( R -
      Q ) ) e. RR ) )

# A side of a triangle produced past a vertex Q to S makes a triangle
# with the third vertex: S - Q is a negative multiple of R - Q.
lemma gtriextd
  hypothesis gtriextd.1 |- ( ph -> P e. CC )
  hypothesis gtriextd.2 |- ( ph -> Q e. CC )
  hypothesis gtriextd.3 |- ( ph -> R e. CC )
  hypothesis gtriextd.4 |- ( ph -> S e. CC )
  hypothesis gtriextd.5 |- ( ph -> ( ( ( -. P = Q /\ -. Q = R ) /\ -. P = R ) /\ -. ( ( R - P ) / (
      Q - P ) ) e. RR ) )
  hypothesis gtriextd.6 |- ( ph -> ( R =/= Q /\ ( ( S - Q ) / ( R - Q ) ) e. RR /\ ( ( S - Q ) / (
      R - Q ) ) < 0 ) )
