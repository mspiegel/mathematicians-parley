# Half the base QR times the height PH, H a point of line QR with PH at
# right angles to it: (P - H)/(Q - R) is P's place along QR less H's,
# whose real part is 0, so its size is the size of P's imaginary part.
lemma gareabhd
  hypothesis gareabhd.1 |- ( ph -> P e. CC )
  hypothesis gareabhd.2 |- ( ph -> Q e. CC )
  hypothesis gareabhd.3 |- ( ph -> R e. CC )
  hypothesis gareabhd.4 |- ( ph -> H e. CC )
  hypothesis gareabhd.5 |- ( ph -> P =/= R )
  hypothesis gareabhd.6 |- ( ph -> Q =/= R )
  hypothesis gareabhd.7 |- ( ph -> P =/= H )
  hypothesis gareabhd.8 |- ( ph -> ( ( H - R ) / ( Q - R ) ) e. RR )
  hypothesis gareabhd.9 |- ( ph -> ( Re ` ( ( R - Q ) / ( H - P ) ) ) = 0 )
  |- ( ph -> ( ( ( 1 / 2 ) x. ( ( abs ` ( Q - R ) ) x. ( abs ` ( P - R ) ) ) ) x. ( abs ` ( sin ` (
      ( Q - R ) ang ( P - R ) ) ) ) ) = ( ( ( 1 / 2 ) x. ( abs ` ( Q - R ) ) ) x. ( abs ` ( P - H )
      ) ) )
  1 gareaim gareabhd.1 gareabhd.2 gareabhd.3 gareabhd.5 gareabhd.6 |- ( ph -> ( ( ( 1 / 2 ) x. ( (
      abs ` ( Q - R ) ) x. ( abs ` ( P - R ) ) ) ) x. ( abs ` ( sin ` ( ( Q - R ) ang ( P - R ) ) )
      ) ) = ( ( ( 1 / 2 ) x. ( abs ` ( Q - R ) ) ) x. ( ( abs ` ( Q - R ) ) x. ( abs ` ( Im ` ( ( P
      - R ) / ( Q - R ) ) ) ) ) ) )
  2 subcld gareabhd.1 gareabhd.4 |- ( ph -> ( P - H ) e. CC )
  3 subcld gareabhd.2 gareabhd.3 |- ( ph -> ( Q - R ) e. CC )
  4 subcld gareabhd.1 gareabhd.3 |- ( ph -> ( P - R ) e. CC )
  5 subcld gareabhd.4 gareabhd.3 |- ( ph -> ( H - R ) e. CC )
