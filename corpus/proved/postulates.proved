  22 eqtrd 13 21 |- ( ph -> ( X - B ) = ( -u ( K / ( abs ` ( B - A ) ) ) x. ( A - B ) ) )
  23 oveq1d 22 |- ( ph -> ( ( X - B ) / ( A - B ) ) = ( ( -u ( K / ( abs ` ( B - A ) ) ) x. ( A - B
      ) ) / ( A - B ) ) )
  24 negcld 9 |- ( ph -> -u ( K / ( abs ` ( B - A ) ) ) e. CC )
  25 divcan4d 24 14 15 |- ( ph -> ( ( -u ( K / ( abs ` ( B - A ) ) ) x. ( A - B ) ) / ( A - B ) ) =
      -u ( K / ( abs ` ( B - A ) ) ) )
  26 eqtrd 23 25 |- ( ph -> ( ( X - B ) / ( A - B ) ) = -u ( K / ( abs ` ( B - A ) ) ) )
  27 renegcld 8 |- ( ph -> -u ( K / ( abs ` ( B - A ) ) ) e. RR )
  28 eqeltrd 26 27 |- ( ph -> ( ( X - B ) / ( A - B ) ) e. RR )
  29 divgt0d gextendd.3 5 gextendd.5 7 |- ( ph -> 0 < ( K / ( abs ` ( B - A ) ) ) )
  30 lt0neg2d 8 |- ( ph -> ( 0 < ( K / ( abs ` ( B - A ) ) ) <-> -u ( K / ( abs ` ( B - A ) ) ) < 0
      ) )
  31 mpbid 29 30 |- ( ph -> -u ( K / ( abs ` ( B - A ) ) ) < 0 )
  32 eqbrtrd 26 31 |- ( ph -> ( ( X - B ) / ( A - B ) ) < 0 )
  33 3jca gextendd.4 28 32 |- ( ph -> ( A =/= B /\ ( ( X - B ) / ( A - B ) ) e. RR /\ ( ( X - B ) /
