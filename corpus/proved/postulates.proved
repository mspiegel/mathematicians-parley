      ( ( ( f : L -1-1-onto-> RR /\ ( f ` A ) = 0 ) /\ 0 < ( f ` B ) ) /\ A. x e. L A. y e. L ( abs
      ` ( x - y ) ) = ( abs ` ( ( f ` x ) - ( f ` y ) ) ) ) )
  2 simplll |- ( ( ( ( f : L -1-1-onto-> RR /\ ( f ` A ) = 0 ) /\ 0 < ( f ` B ) ) /\ A. x e. L A. y
      e. L ( abs ` ( x - y ) ) = ( abs ` ( ( f ` x ) - ( f ` y ) ) ) ) -> f : L -1-1-onto-> RR )
