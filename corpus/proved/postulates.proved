# A point whose place q along the way from A to B is real and not below 0
# is A, B, between them or beyond B: the five cases of a point of line AB
# less the one where A is between P and B, which asks q < 0.
lemma grayfwd
  hypothesis grayfwd.1 |- ( ph -> P e. CC )
  hypothesis grayfwd.2 |- ( ph -> A e. CC )
  hypothesis grayfwd.3 |- ( ph -> B e. CC )
