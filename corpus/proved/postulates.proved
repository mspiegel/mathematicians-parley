# Two places along line AB differ by the difference of the points over
# the line's direction.
lemma gplsdiff
  hypothesis gplsdiff.1 |- ( ph -> U e. CC )
  hypothesis gplsdiff.2 |- ( ph -> V e. CC )
  hypothesis gplsdiff.3 |- ( ph -> A e. CC )
  hypothesis gplsdiff.4 |- ( ph -> B e. CC )
  hypothesis gplsdiff.5 |- ( ph -> A =/= B )
  |- ( ph -> ( ( ( U - A ) / ( B - A ) ) - ( ( V - A ) / ( B - A ) ) ) = ( ( U - V ) / ( B - A ) ) )
  1 subcld gplsdiff.1 gplsdiff.3 |- ( ph -> ( U - A ) e. CC )
  2 subcld gplsdiff.2 gplsdiff.3 |- ( ph -> ( V - A ) e. CC )
  3 subcld gplsdiff.4 gplsdiff.3 |- ( ph -> ( B - A ) e. CC )
  4 necomd gplsdiff.5 |- ( ph -> B =/= A )
  5 subne0d gplsdiff.4 gplsdiff.3 4 |- ( ph -> ( B - A ) =/= 0 )
  6 divsubdird 1 2 3 5 |- ( ph -> ( ( ( U - A ) - ( V - A ) ) / ( B - A ) ) = ( ( ( U - A ) / ( B -
      A ) ) - ( ( V - A ) / ( B - A ) ) ) )
  7 nnncan2d gplsdiff.1 gplsdiff.2 gplsdiff.3 |- ( ph -> ( ( U - A ) - ( V - A ) ) = ( U - V ) )
  8 oveq1d 7 |- ( ph -> ( ( ( U - A ) - ( V - A ) ) / ( B - A ) ) = ( ( U - V ) / ( B - A ) ) )
  9 eqtr3d 6 8 |- ( ph -> ( ( ( U - A ) / ( B - A ) ) - ( ( V - A ) / ( B - A ) ) ) = ( ( U - V ) /
      ( B - A ) ) )

# Three reals p, q, x with q - x = k (p - x) for a negative k: x lies
# between p and q, so x has the sign p and q share.
