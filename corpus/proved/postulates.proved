      < 0 ) ) \/ ( A =/= B /\ ( ( P - B ) / ( A - B ) ) e. RR /\ ( ( P - B ) / ( A - B ) ) < 0 ) )
      ) )

# Two reals of one sign as a third, each, are of one sign: the product of
# the two products is the first times the last times a square.
lemma gsgntr
  hypothesis gsgntr.1 |- ( ph -> X e. RR )
  hypothesis gsgntr.2 |- ( ph -> Y e. RR )
  hypothesis gsgntr.3 |- ( ph -> Z e. RR )
  hypothesis gsgntr.4 |- ( ph -> 0 < ( X x. Y ) )
  hypothesis gsgntr.5 |- ( ph -> 0 < ( Y x. Z ) )
  |- ( ph -> 0 < ( X x. Z ) )
  1 recnd gsgntr.1 |- ( ph -> X e. CC )
  2 recnd gsgntr.2 |- ( ph -> Y e. CC )
  3 recnd gsgntr.3 |- ( ph -> Z e. CC )
  4 mulcomd 2 3 |- ( ph -> ( Y x. Z ) = ( Z x. Y ) )
  5 breqtrd gsgntr.5 4 |- ( ph -> 0 < ( Z x. Y ) )
  6 remulcld gsgntr.1 gsgntr.2 |- ( ph -> ( X x. Y ) e. RR )
  7 remulcld gsgntr.3 gsgntr.2 |- ( ph -> ( Z x. Y ) e. RR )
  8 mulgt0d 6 7 gsgntr.4 5 |- ( ph -> 0 < ( ( X x. Y ) x. ( Z x. Y ) ) )
  9 mul4d 1 2 3 2 |- ( ph -> ( ( X x. Y ) x. ( Z x. Y ) ) = ( ( X x. Z ) x. ( Y x. Y ) ) )
  10 breqtrd 8 9 |- ( ph -> 0 < ( ( X x. Z ) x. ( Y x. Y ) ) )
  11 remulcld gsgntr.1 gsgntr.3 |- ( ph -> ( X x. Z ) e. RR )
  12 remulcld gsgntr.2 gsgntr.2 |- ( ph -> ( Y x. Y ) e. RR )
  13 msqge0d gsgntr.2 |- ( ph -> 0 <_ ( Y x. Y ) )
  14 jca 11 12 |- ( ph -> ( ( X x. Z ) e. RR /\ ( Y x. Y ) e. RR ) )
  15 jca 13 10 |- ( ph -> ( 0 <_ ( Y x. Y ) /\ 0 < ( ( X x. Z ) x. ( Y x. Y ) ) ) )
  16 jca 14 15 |- ( ph -> ( ( ( X x. Z ) e. RR /\ ( Y x. Y ) e. RR ) /\ ( 0 <_ ( Y x. Y ) /\ 0 < (
      ( X x. Z ) x. ( Y x. Y ) ) ) ) )
  17 prodgt02 |- ( ( ( ( X x. Z ) e. RR /\ ( Y x. Y ) e. RR ) /\ ( 0 <_ ( Y x. Y ) /\ 0 < ( ( X x.
      Z ) x. ( Y x. Y ) ) ) ) -> 0 < ( X x. Z ) )
  18 syl 16 17 |- ( ph -> 0 < ( X x. Z ) )

# The argument of a number off the real line has the sign of its imaginary
# part: it is in (0, pi) above the line and in (-pi, 0) below.
lemma gargsgn
  hypothesis gargsgn.1 |- ( ph -> Z e. CC )
  hypothesis gargsgn.2 |- ( ph -> ( Im ` Z ) =/= 0 )
  |- ( ph -> 0 < ( ( Im ` ( log ` Z ) ) x. ( Im ` Z ) ) )
  1 imcld gargsgn.1 |- ( ph -> ( Im ` Z ) e. RR )
  2 0red |- ( ph -> 0 e. RR )
  3 lttri2d 1 2 |- ( ph -> ( ( Im ` Z ) =/= 0 <-> ( ( Im ` Z ) < 0 \/ 0 < ( Im ` Z ) ) ) )
  4 mpbid gargsgn.2 3 |- ( ph -> ( ( Im ` Z ) < 0 \/ 0 < ( Im ` Z ) ) )
  5 adantr gargsgn.1 |- ( ( ph /\ ( Im ` Z ) < 0 ) -> Z e. CC )
  6 simpr |- ( ( ph /\ ( Im ` Z ) < 0 ) -> ( Im ` Z ) < 0 )
  7 argimlt0 |- ( ( Z e. CC /\ ( Im ` Z ) < 0 ) -> ( Im ` ( log ` Z ) ) e. ( -u _pi (,) 0 ) )
  8 syl2anc 5 6 7 |- ( ( ph /\ ( Im ` Z ) < 0 ) -> ( Im ` ( log ` Z ) ) e. ( -u _pi (,) 0 ) )
  9 eliooord |- ( ( Im ` ( log ` Z ) ) e. ( -u _pi (,) 0 ) -> ( -u _pi < ( Im ` ( log ` Z ) ) /\ (
      Im ` ( log ` Z ) ) < 0 ) )
  10 syl 8 9 |- ( ( ph /\ ( Im ` Z ) < 0 ) -> ( -u _pi < ( Im ` ( log ` Z ) ) /\ ( Im ` ( log ` Z )
      ) < 0 ) )
  11 simprd 10 |- ( ( ph /\ ( Im ` Z ) < 0 ) -> ( Im ` ( log ` Z ) ) < 0 )
  12 elioore |- ( ( Im ` ( log ` Z ) ) e. ( -u _pi (,) 0 ) -> ( Im ` ( log ` Z ) ) e. RR )
  13 syl 8 12 |- ( ( ph /\ ( Im ` Z ) < 0 ) -> ( Im ` ( log ` Z ) ) e. RR )
  14 adantr 1 |- ( ( ph /\ ( Im ` Z ) < 0 ) -> ( Im ` Z ) e. RR )
  15 jca 13 11 |- ( ( ph /\ ( Im ` Z ) < 0 ) -> ( ( Im ` ( log ` Z ) ) e. RR /\ ( Im ` ( log ` Z )
      ) < 0 ) )
  16 jca 14 6 |- ( ( ph /\ ( Im ` Z ) < 0 ) -> ( ( Im ` Z ) e. RR /\ ( Im ` Z ) < 0 ) )
  17 jca 15 16 |- ( ( ph /\ ( Im ` Z ) < 0 ) -> ( ( ( Im ` ( log ` Z ) ) e. RR /\ ( Im ` ( log ` Z
      ) ) < 0 ) /\ ( ( Im ` Z ) e. RR /\ ( Im ` Z ) < 0 ) ) )
  18 mullt0 |- ( ( ( ( Im ` ( log ` Z ) ) e. RR /\ ( Im ` ( log ` Z ) ) < 0 ) /\ ( ( Im ` Z ) e. RR
      /\ ( Im ` Z ) < 0 ) ) -> 0 < ( ( Im ` ( log ` Z ) ) x. ( Im ` Z ) ) )
  19 syl 17 18 |- ( ( ph /\ ( Im ` Z ) < 0 ) -> 0 < ( ( Im ` ( log ` Z ) ) x. ( Im ` Z ) ) )
  20 adantr gargsgn.1 |- ( ( ph /\ 0 < ( Im ` Z ) ) -> Z e. CC )
  21 simpr |- ( ( ph /\ 0 < ( Im ` Z ) ) -> 0 < ( Im ` Z ) )
  22 argimgt0 |- ( ( Z e. CC /\ 0 < ( Im ` Z ) ) -> ( Im ` ( log ` Z ) ) e. ( 0 (,) _pi ) )
  23 syl2anc 20 21 22 |- ( ( ph /\ 0 < ( Im ` Z ) ) -> ( Im ` ( log ` Z ) ) e. ( 0 (,) _pi ) )
  24 eliooord |- ( ( Im ` ( log ` Z ) ) e. ( 0 (,) _pi ) -> ( 0 < ( Im ` ( log ` Z ) ) /\ ( Im ` (
      log ` Z ) ) < _pi ) )
  25 syl 23 24 |- ( ( ph /\ 0 < ( Im ` Z ) ) -> ( 0 < ( Im ` ( log ` Z ) ) /\ ( Im ` ( log ` Z ) )
      < _pi ) )
  26 simpld 25 |- ( ( ph /\ 0 < ( Im ` Z ) ) -> 0 < ( Im ` ( log ` Z ) ) )
  27 elioore |- ( ( Im ` ( log ` Z ) ) e. ( 0 (,) _pi ) -> ( Im ` ( log ` Z ) ) e. RR )
  28 syl 23 27 |- ( ( ph /\ 0 < ( Im ` Z ) ) -> ( Im ` ( log ` Z ) ) e. RR )
  29 adantr 1 |- ( ( ph /\ 0 < ( Im ` Z ) ) -> ( Im ` Z ) e. RR )
  30 mulgt0d 28 29 26 21 |- ( ( ph /\ 0 < ( Im ` Z ) ) -> 0 < ( ( Im ` ( log ` Z ) ) x. ( Im ` Z )
      ) )
