  48 con1d 47 |- ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ C e. CC ) /\ D e. CC ) /\ A =/= B ) /\ C =/= D
      ) -> ( -. E. x e. CC ( ( A = B \/ ( ( x - A ) / ( B - A ) ) e. RR ) /\ ( C = D \/ ( ( x - C )
