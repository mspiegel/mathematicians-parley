# The postulates of plane geometry, for `proved.mm`.
#
# The library states plane geometry from the School Mathematics Study
# Group's postulates, the plane ones, with the area postulates said of
# triangles. A reader takes each as given; here each is proved over ℂ, so
# that nothing is assumed. With them come the line through two points as a
# set, which the postulates speak of.

$( The postulates of plane geometry, each proved over the complex plane,
   and the line through two points as a set of points. $)

$( A line is the set of points u the two points make collinear, so u is
   held apart from the points it is built from. $)
$d u A $.  $d u B $.  $d u P $.

$( The ruler's variables: f the ruler, w the point it is applied to, t a
   real number, x and y two points of the line. $)
$d f t u w x y $.
$d u X $.  $d u Y $.
$d w A $.  $d w B $.  $d w L $.  $d w P $.  $d w X $.  $d w Y $.
$d t A $.  $d t B $.  $d t L $.
$d x A $.  $d x B $.  $d x L $.  $d x F $.
$d y A $.  $d y B $.  $d y L $.  $d y F $.
$d f A $.  $d f B $.  $d f L $.  $d f F $.

$( Line uniqueness: u the point the two lines are compared at. $)
$d u C $.  $d u D $.  $d u ph $.

$( Three points: x, y and z the three. $)
$d x y z $.

$( Plane separation: x the point where segment PQ crosses line AB. $)
$d x P $.  $d x Q $.  $d x ph $.

$( Rays and the angle construction: u the point of the ray. $)
$d u E $.

$( Angle construction: x the constructed point. $)
$d x C $.  $d x K $.  $d x T $.  $d x Y $.

$( Parallel lines: x the point the two lines would share. $)
$d x D $.

# P is a member of line AB just where P is on line AB.
lemma glinel
  |- ( P e. CC -> ( P e. { u e. CC | ( A = B \/ ( ( u - A ) / ( B - A ) ) e. RR ) } <-> ( A = B \/ ( ( P - A ) / ( B - A ) ) e. RR ) ) )
  1 oveq1 |- ( u = P -> ( u - A ) = ( P - A ) )
  2 oveq1d 1 |- ( u = P -> ( ( u - A ) / ( B - A ) ) = ( ( P - A ) / ( B - A ) ) )
  3 eleq1d 2 |- ( u = P -> ( ( ( u - A ) / ( B - A ) ) e. RR <-> ( ( P - A ) / ( B - A ) ) e. RR ) )
  4 orbi2d 3 |- ( u = P -> ( ( A = B \/ ( ( u - A ) / ( B - A ) ) e. RR ) <-> ( A = B \/ ( ( P - A ) / ( B - A ) ) e. RR ) ) )
  5 elrab3 4 |- ( P e. CC -> ( P e. { u e. CC | ( A = B \/ ( ( u - A ) / ( B - A ) ) e. RR ) } <-> ( A = B \/ ( ( P - A ) / ( B - A ) ) e. RR ) ) )

# line AB and line BA are one set: each point the one makes collinear the
# other does, by turning the three points round.
lemma glineturn
  |- ( ( A e. CC /\ B e. CC ) -> { u e. CC | ( A = B \/ ( ( u - A ) / ( B - A ) ) e. RR ) } = { u e. CC | ( B = A \/ ( ( u - B ) / ( A - B ) ) e. RR ) } )
  1 simpll |- ( ( ( A e. CC /\ B e. CC ) /\ u e. CC ) -> A e. CC )
  2 simplr |- ( ( ( A e. CC /\ B e. CC ) /\ u e. CC ) -> B e. CC )
  3 simpr |- ( ( ( A e. CC /\ B e. CC ) /\ u e. CC ) -> u e. CC )
  4 3jca 1 2 3 |- ( ( ( A e. CC /\ B e. CC ) /\ u e. CC ) -> ( A e. CC /\ B e. CC /\ u e. CC ) )
  5 gcolrotate |- ( ( A e. CC /\ B e. CC /\ u e. CC ) -> ( ( A = B \/ ( ( u - A ) / ( B - A ) ) e. RR ) -> ( B = u \/ ( ( A - B ) / ( u - B ) ) e. RR ) ) )
  6 syl 4 5 |- ( ( ( A e. CC /\ B e. CC ) /\ u e. CC ) -> ( ( A = B \/ ( ( u - A ) / ( B - A ) ) e. RR ) -> ( B = u \/ ( ( A - B ) / ( u - B ) ) e. RR ) ) )
  7 3jca 2 3 1 |- ( ( ( A e. CC /\ B e. CC ) /\ u e. CC ) -> ( B e. CC /\ u e. CC /\ A e. CC ) )
  8 gcolswap |- ( ( B e. CC /\ u e. CC /\ A e. CC ) -> ( ( B = u \/ ( ( A - B ) / ( u - B ) ) e. RR ) -> ( B = A \/ ( ( u - B ) / ( A - B ) ) e. RR ) ) )
  9 syl 7 8 |- ( ( ( A e. CC /\ B e. CC ) /\ u e. CC ) -> ( ( B = u \/ ( ( A - B ) / ( u - B ) ) e. RR ) -> ( B = A \/ ( ( u - B ) / ( A - B ) ) e. RR ) ) )
  10 syld 6 9 |- ( ( ( A e. CC /\ B e. CC ) /\ u e. CC ) -> ( ( A = B \/ ( ( u - A ) / ( B - A ) ) e. RR ) -> ( B = A \/ ( ( u - B ) / ( A - B ) ) e. RR ) ) )
  11 3jca 2 1 3 |- ( ( ( A e. CC /\ B e. CC ) /\ u e. CC ) -> ( B e. CC /\ A e. CC /\ u e. CC ) )
  12 gcolrotate |- ( ( B e. CC /\ A e. CC /\ u e. CC ) -> ( ( B = A \/ ( ( u - B ) / ( A - B ) ) e. RR ) -> ( A = u \/ ( ( B - A ) / ( u - A ) ) e. RR ) ) )
  13 syl 11 12 |- ( ( ( A e. CC /\ B e. CC ) /\ u e. CC ) -> ( ( B = A \/ ( ( u - B ) / ( A - B ) ) e. RR ) -> ( A = u \/ ( ( B - A ) / ( u - A ) ) e. RR ) ) )
  14 3jca 1 3 2 |- ( ( ( A e. CC /\ B e. CC ) /\ u e. CC ) -> ( A e. CC /\ u e. CC /\ B e. CC ) )
  15 gcolswap |- ( ( A e. CC /\ u e. CC /\ B e. CC ) -> ( ( A = u \/ ( ( B - A ) / ( u - A ) ) e. RR ) -> ( A = B \/ ( ( u - A ) / ( B - A ) ) e. RR ) ) )
  16 syl 14 15 |- ( ( ( A e. CC /\ B e. CC ) /\ u e. CC ) -> ( ( A = u \/ ( ( B - A ) / ( u - A ) ) e. RR ) -> ( A = B \/ ( ( u - A ) / ( B - A ) ) e. RR ) ) )
  17 syld 13 16 |- ( ( ( A e. CC /\ B e. CC ) /\ u e. CC ) -> ( ( B = A \/ ( ( u - B ) / ( A - B ) ) e. RR ) -> ( A = B \/ ( ( u - A ) / ( B - A ) ) e. RR ) ) )
  18 impbid 10 17 |- ( ( ( A e. CC /\ B e. CC ) /\ u e. CC ) -> ( ( A = B \/ ( ( u - A ) / ( B - A ) ) e. RR ) <-> ( B = A \/ ( ( u - B ) / ( A - B ) ) e. RR ) ) )
  19 rabbidva 18 |- ( ( A e. CC /\ B e. CC ) -> { u e. CC | ( A = B \/ ( ( u - A ) / ( B - A ) ) e. RR ) } = { u e. CC | ( B = A \/ ( ( u - B ) / ( A - B ) ) e. RR ) } )

# The coordinate of a point of line AB: its quotient by B - A is real, since
# A and B are apart.
lemma grulerq
  hypothesis grulerq.1 |- L = { u e. CC | ( A = B \/ ( ( u - A ) / ( B - A ) ) e. RR ) }
  |- ( ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) /\ P e. L ) -> ( ( P - A ) / ( B - A ) ) e. RR )
  1 ssrab2 |- { u e. CC | ( A = B \/ ( ( u - A ) / ( B - A ) ) e. RR ) } C_ CC
  2 eqsstri grulerq.1 1 |- L C_ CC
  3 sseli 2 |- ( P e. L -> P e. CC )
  4 simpr |- ( ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) /\ P e. L ) -> P e. L )
  5 syl 4 3 |- ( ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) /\ P e. L ) -> P e. CC )
  6 eleq2i grulerq.1 |- ( P e. L <-> P e. { u e. CC | ( A = B \/ ( ( u - A ) / ( B - A ) ) e. RR )
      } )
  7 glinel |- ( P e. CC -> ( P e. { u e. CC | ( A = B \/ ( ( u - A ) / ( B - A ) ) e. RR ) } <-> (
      A = B \/ ( ( P - A ) / ( B - A ) ) e. RR ) ) )
  8 syl 5 7 |- ( ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) /\ P e. L ) -> ( P e. { u e. CC | ( A = B
      \/ ( ( u - A ) / ( B - A ) ) e. RR ) } <-> ( A = B \/ ( ( P - A ) / ( B - A ) ) e. RR ) ) )
  9 sylib 4 6 |- ( ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) /\ P e. L ) -> P e. { u e. CC | ( A = B
      \/ ( ( u - A ) / ( B - A ) ) e. RR ) } )
  10 mpbid 9 8 |- ( ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) /\ P e. L ) -> ( A = B \/ ( ( P - A ) /
      ( B - A ) ) e. RR ) )
  11 simplr |- ( ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) /\ P e. L ) -> A =/= B )
  12 neneq |- ( A =/= B -> -. A = B )
  13 syl 11 12 |- ( ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) /\ P e. L ) -> -. A = B )
  14 orel1 |- ( -. A = B -> ( ( A = B \/ ( ( P - A ) / ( B - A ) ) e. RR ) -> ( ( P - A ) / ( B - A
      ) ) e. RR ) )
  15 syl 13 14 |- ( ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) /\ P e. L ) -> ( ( A = B \/ ( ( P - A )
      / ( B - A ) ) e. RR ) -> ( ( P - A ) / ( B - A ) ) e. RR ) )
  16 mpd 10 15 |- ( ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) /\ P e. L ) -> ( ( P - A ) / ( B - A )
      ) e. RR )

# The ruler's value at a point of the line.
lemma grulerfv
  hypothesis grulerfv.1 |- F = ( w e. L |-> ( ( ( w - A ) / ( B - A ) ) x. ( abs ` ( B - A ) ) ) )
  |- ( ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) /\ P e. L ) -> ( F ` P ) = ( ( ( P - A ) / ( B - A )
      ) x. ( abs ` ( B - A ) ) ) )
  1 a1i grulerfv.1 |- ( ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) /\ P e. L ) -> F = ( w e. L |-> ( (
      ( w - A ) / ( B - A ) ) x. ( abs ` ( B - A ) ) ) ) )
  2 oveq1 |- ( w = P -> ( w - A ) = ( P - A ) )
  3 oveq1d 2 |- ( w = P -> ( ( w - A ) / ( B - A ) ) = ( ( P - A ) / ( B - A ) ) )
  4 oveq1d 3 |- ( w = P -> ( ( ( w - A ) / ( B - A ) ) x. ( abs ` ( B - A ) ) ) = ( ( ( P - A ) / (
      B - A ) ) x. ( abs ` ( B - A ) ) ) )
  5 adantl 4 |- ( ( ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) /\ P e. L ) /\ w = P ) -> ( ( ( w - A )
      / ( B - A ) ) x. ( abs ` ( B - A ) ) ) = ( ( ( P - A ) / ( B - A ) ) x. ( abs ` ( B - A ) ) )
      )
  6 simpr |- ( ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) /\ P e. L ) -> P e. L )
  7 ovex |- ( ( ( P - A ) / ( B - A ) ) x. ( abs ` ( B - A ) ) ) e. _V
  8 a1i 7 |- ( ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) /\ P e. L ) -> ( ( ( P - A ) / ( B - A ) )
      x. ( abs ` ( B - A ) ) ) e. _V )
  9 fvmptd 1 5 6 8 |- ( ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) /\ P e. L ) -> ( F ` P ) = ( ( ( P
      - A ) / ( B - A ) ) x. ( abs ` ( B - A ) ) ) )

# Two points of the line are as far apart as their coordinates: each is
# A plus its quotient times B - A.
lemma grulerdist
  hypothesis grulerdist.1 |- L = { u e. CC | ( A = B \/ ( ( u - A ) / ( B - A ) ) e. RR ) }
  hypothesis grulerdist.2 |- F = ( w e. L |-> ( ( ( w - A ) / ( B - A ) ) x. ( abs ` ( B - A ) ) ) )
  |- ( ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) /\ ( X e. L /\ Y e. L ) ) -> ( abs ` ( X - Y ) ) = (
      abs ` ( ( F ` X ) - ( F ` Y ) ) ) )
  1 simpl |- ( ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) /\ ( X e. L /\ Y e. L ) ) -> ( ( A e. CC /\
      B e. CC ) /\ A =/= B ) )
  2 simprl |- ( ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) /\ ( X e. L /\ Y e. L ) ) -> X e. L )
  3 simprr |- ( ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) /\ ( X e. L /\ Y e. L ) ) -> Y e. L )
  4 jca 1 2 |- ( ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) /\ ( X e. L /\ Y e. L ) ) -> ( ( ( A e. CC
      /\ B e. CC ) /\ A =/= B ) /\ X e. L ) )
  5 jca 1 3 |- ( ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) /\ ( X e. L /\ Y e. L ) ) -> ( ( ( A e. CC
      /\ B e. CC ) /\ A =/= B ) /\ Y e. L ) )
  6 grulerq grulerdist.1 |- ( ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) /\ X e. L ) -> ( ( X - A ) /
      ( B - A ) ) e. RR )
  7 syl 4 6 |- ( ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) /\ ( X e. L /\ Y e. L ) ) -> ( ( X - A ) /
      ( B - A ) ) e. RR )
  8 grulerq grulerdist.1 |- ( ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) /\ Y e. L ) -> ( ( Y - A ) /
      ( B - A ) ) e. RR )
  9 syl 5 8 |- ( ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) /\ ( X e. L /\ Y e. L ) ) -> ( ( Y - A ) /
      ( B - A ) ) e. RR )
  10 grulerfv grulerdist.2 |- ( ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) /\ X e. L ) -> ( F ` X ) =
      ( ( ( X - A ) / ( B - A ) ) x. ( abs ` ( B - A ) ) ) )
  11 syl 4 10 |- ( ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) /\ ( X e. L /\ Y e. L ) ) -> ( F ` X ) =
      ( ( ( X - A ) / ( B - A ) ) x. ( abs ` ( B - A ) ) ) )
  12 grulerfv grulerdist.2 |- ( ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) /\ Y e. L ) -> ( F ` Y ) =
      ( ( ( Y - A ) / ( B - A ) ) x. ( abs ` ( B - A ) ) ) )
  13 syl 5 12 |- ( ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) /\ ( X e. L /\ Y e. L ) ) -> ( F ` Y ) =
      ( ( ( Y - A ) / ( B - A ) ) x. ( abs ` ( B - A ) ) ) )
  14 oveq12d 11 13 |- ( ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) /\ ( X e. L /\ Y e. L ) ) -> ( ( F
      ` X ) - ( F ` Y ) ) = ( ( ( ( X - A ) / ( B - A ) ) x. ( abs ` ( B - A ) ) ) - ( ( ( Y - A )
      / ( B - A ) ) x. ( abs ` ( B - A ) ) ) ) )
  15 simplll |- ( ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) /\ ( X e. L /\ Y e. L ) ) -> A e. CC )
  16 simpllr |- ( ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) /\ ( X e. L /\ Y e. L ) ) -> B e. CC )
  17 simplr |- ( ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) /\ ( X e. L /\ Y e. L ) ) -> A =/= B )
  18 subcld 16 15 |- ( ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) /\ ( X e. L /\ Y e. L ) ) -> ( B - A
      ) e. CC )
  19 necomd 17 |- ( ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) /\ ( X e. L /\ Y e. L ) ) -> B =/= A )
  20 subne0d 16 15 19 |- ( ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) /\ ( X e. L /\ Y e. L ) ) -> ( B
      - A ) =/= 0 )
  21 abscld 18 |- ( ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) /\ ( X e. L /\ Y e. L ) ) -> ( abs ` (
      B - A ) ) e. RR )
  22 absrpcld 18 20 |- ( ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) /\ ( X e. L /\ Y e. L ) ) -> ( abs
      ` ( B - A ) ) e. RR+ )
  23 rpge0d 22 |- ( ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) /\ ( X e. L /\ Y e. L ) ) -> 0 <_ ( abs
      ` ( B - A ) ) )
  24 recnd 7 |- ( ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) /\ ( X e. L /\ Y e. L ) ) -> ( ( X - A )
      / ( B - A ) ) e. CC )
  25 recnd 9 |- ( ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) /\ ( X e. L /\ Y e. L ) ) -> ( ( Y - A )
      / ( B - A ) ) e. CC )
  26 recnd 21 |- ( ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) /\ ( X e. L /\ Y e. L ) ) -> ( abs ` ( B
      - A ) ) e. CC )
  27 subdird 24 25 26 |- ( ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) /\ ( X e. L /\ Y e. L ) ) -> ( (
      ( ( X - A ) / ( B - A ) ) - ( ( Y - A ) / ( B - A ) ) ) x. ( abs ` ( B - A ) ) ) = ( ( ( ( X
      - A ) / ( B - A ) ) x. ( abs ` ( B - A ) ) ) - ( ( ( Y - A ) / ( B - A ) ) x. ( abs ` ( B - A
      ) ) ) ) )
  28 eqtr4d 14 27 |- ( ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) /\ ( X e. L /\ Y e. L ) ) -> ( ( F `
      X ) - ( F ` Y ) ) = ( ( ( ( X - A ) / ( B - A ) ) - ( ( Y - A ) / ( B - A ) ) ) x. ( abs ` (
      B - A ) ) ) )
  29 fveq2d 28 |- ( ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) /\ ( X e. L /\ Y e. L ) ) -> ( abs ` (
      ( F ` X ) - ( F ` Y ) ) ) = ( abs ` ( ( ( ( X - A ) / ( B - A ) ) - ( ( Y - A ) / ( B - A ) )
      ) x. ( abs ` ( B - A ) ) ) ) )
  30 subcld 24 25 |- ( ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) /\ ( X e. L /\ Y e. L ) ) -> ( ( ( X
      - A ) / ( B - A ) ) - ( ( Y - A ) / ( B - A ) ) ) e. CC )
  31 absmuld 30 26 |- ( ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) /\ ( X e. L /\ Y e. L ) ) -> ( abs
      ` ( ( ( ( X - A ) / ( B - A ) ) - ( ( Y - A ) / ( B - A ) ) ) x. ( abs ` ( B - A ) ) ) ) = (
      ( abs ` ( ( ( X - A ) / ( B - A ) ) - ( ( Y - A ) / ( B - A ) ) ) ) x. ( abs ` ( abs ` ( B -
      A ) ) ) ) )
  32 absidd 21 23 |- ( ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) /\ ( X e. L /\ Y e. L ) ) -> ( abs `
      ( abs ` ( B - A ) ) ) = ( abs ` ( B - A ) ) )
  33 oveq2d 32 |- ( ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) /\ ( X e. L /\ Y e. L ) ) -> ( ( abs `
      ( ( ( X - A ) / ( B - A ) ) - ( ( Y - A ) / ( B - A ) ) ) ) x. ( abs ` ( abs ` ( B - A ) ) )
      ) = ( ( abs ` ( ( ( X - A ) / ( B - A ) ) - ( ( Y - A ) / ( B - A ) ) ) ) x. ( abs ` ( B - A
      ) ) ) )
  34 3eqtrd 29 31 33 |- ( ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) /\ ( X e. L /\ Y e. L ) ) -> (
      abs ` ( ( F ` X ) - ( F ` Y ) ) ) = ( ( abs ` ( ( ( X - A ) / ( B - A ) ) - ( ( Y - A ) / ( B
      - A ) ) ) ) x. ( abs ` ( B - A ) ) ) )
  35 ssrab2 |- { u e. CC | ( A = B \/ ( ( u - A ) / ( B - A ) ) e. RR ) } C_ CC
  36 eqsstri grulerdist.1 35 |- L C_ CC
  37 sseli 36 |- ( X e. L -> X e. CC )
  38 syl 2 37 |- ( ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) /\ ( X e. L /\ Y e. L ) ) -> X e. CC )
  39 sseli 36 |- ( Y e. L -> Y e. CC )
  40 syl 3 39 |- ( ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) /\ ( X e. L /\ Y e. L ) ) -> Y e. CC )
  41 subcld 38 15 |- ( ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) /\ ( X e. L /\ Y e. L ) ) -> ( X - A
      ) e. CC )
  42 divcan1d 41 18 20 |- ( ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) /\ ( X e. L /\ Y e. L ) ) -> (
      ( ( X - A ) / ( B - A ) ) x. ( B - A ) ) = ( X - A ) )
  43 subcld 40 15 |- ( ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) /\ ( X e. L /\ Y e. L ) ) -> ( Y - A
      ) e. CC )
  44 divcan1d 43 18 20 |- ( ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) /\ ( X e. L /\ Y e. L ) ) -> (
      ( ( Y - A ) / ( B - A ) ) x. ( B - A ) ) = ( Y - A ) )
  45 subdird 24 25 18 |- ( ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) /\ ( X e. L /\ Y e. L ) ) -> ( (
      ( ( X - A ) / ( B - A ) ) - ( ( Y - A ) / ( B - A ) ) ) x. ( B - A ) ) = ( ( ( ( X - A ) / (
      B - A ) ) x. ( B - A ) ) - ( ( ( Y - A ) / ( B - A ) ) x. ( B - A ) ) ) )
  46 oveq12d 42 44 |- ( ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) /\ ( X e. L /\ Y e. L ) ) -> ( ( (
      ( X - A ) / ( B - A ) ) x. ( B - A ) ) - ( ( ( Y - A ) / ( B - A ) ) x. ( B - A ) ) ) = ( ( X
      - A ) - ( Y - A ) ) )
  47 nnncan2d 38 40 15 |- ( ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) /\ ( X e. L /\ Y e. L ) ) -> (
      ( X - A ) - ( Y - A ) ) = ( X - Y ) )
  48 3eqtrd 45 46 47 |- ( ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) /\ ( X e. L /\ Y e. L ) ) -> ( (
      ( ( X - A ) / ( B - A ) ) - ( ( Y - A ) / ( B - A ) ) ) x. ( B - A ) ) = ( X - Y ) )
  49 fveq2d 48 |- ( ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) /\ ( X e. L /\ Y e. L ) ) -> ( abs ` (
      ( ( ( X - A ) / ( B - A ) ) - ( ( Y - A ) / ( B - A ) ) ) x. ( B - A ) ) ) = ( abs ` ( X - Y
      ) ) )
  50 absmuld 30 18 |- ( ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) /\ ( X e. L /\ Y e. L ) ) -> ( abs
      ` ( ( ( ( X - A ) / ( B - A ) ) - ( ( Y - A ) / ( B - A ) ) ) x. ( B - A ) ) ) = ( ( abs ` (
      ( ( X - A ) / ( B - A ) ) - ( ( Y - A ) / ( B - A ) ) ) ) x. ( abs ` ( B - A ) ) ) )
  51 eqtr3d 49 50 |- ( ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) /\ ( X e. L /\ Y e. L ) ) -> ( abs `
      ( X - Y ) ) = ( ( abs ` ( ( ( X - A ) / ( B - A ) ) - ( ( Y - A ) / ( B - A ) ) ) ) x. ( abs
      ` ( B - A ) ) ) )
  52 eqtr4d 51 34 |- ( ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) /\ ( X e. L /\ Y e. L ) ) -> ( abs `
      ( X - Y ) ) = ( abs ` ( ( F ` X ) - ( F ` Y ) ) ) )

