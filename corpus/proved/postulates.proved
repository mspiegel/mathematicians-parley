  7 ne0i |- ( (/) e. +oo -> +oo =/= (/) )
  8 ax-mp 6 7 |- +oo =/= (/)
  9 necomi 8 |- (/) =/= +oo
  10 neii 9 |- -. (/) = +oo
  11 0elpw |- (/) e. ~P +oo
  12 df-mnf |- -oo = ~P +oo
  13 eleqtrri 11 12 |- (/) e. -oo
  14 ne0i |- ( (/) e. -oo -> -oo =/= (/) )
  15 ax-mp 13 14 |- -oo =/= (/)
  16 necomi 15 |- (/) =/= -oo
  17 neii 16 |- -. (/) = -oo
  18 3pm3.2i 3 10 17 |- ( -. (/) e. RR /\ -. (/) = +oo /\ -. (/) = -oo )
  19 3ioran |- ( -. ( (/) e. RR \/ (/) = +oo \/ (/) = -oo ) <-> ( -. (/) e. RR /\ -. (/) = +oo /\
      -. (/) = -oo ) )
  20 mpbir 18 19 |- -. ( (/) e. RR \/ (/) = +oo \/ (/) = -oo )
  21 elxr |- ( (/) e. RR* <-> ( (/) e. RR \/ (/) = +oo \/ (/) = -oo ) )
  22 mtbir 20 21 |- -. (/) e. RR*

# A product of imaginary parts that is an extended real is a product of
# imaginary parts of complex numbers: outside CC, Im and x. give (/).
lemma gimrcl
  |- ( ( ( Im ` X ) x. ( Im ` Y ) ) e. RR* -> ( X e. CC /\ Y e. CC ) )
  1 ax-mulf |- x. : ( CC X. CC ) --> CC
  2 fdmi 1 |- dom x. = ( CC X. CC )
  3 ndmovg |- ( ( dom x. = ( CC X. CC ) /\ -. ( ( Im ` X ) e. CC /\ ( Im ` Y ) e. CC ) ) -> ( ( Im
      ` X ) x. ( Im ` Y ) ) = (/) )
