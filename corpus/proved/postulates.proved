# The argument of a quotient is the difference of the arguments, when that
# difference lies between -pi and pi.
lemma gargdiv
  hypothesis gargdiv.1 |- ( ph -> U e. CC )
  hypothesis gargdiv.2 |- ( ph -> U =/= 0 )
  hypothesis gargdiv.3 |- ( ph -> W e. CC )
  hypothesis gargdiv.4 |- ( ph -> W =/= 0 )
  hypothesis gargdiv.5 |- ( ph -> -u _pi < ( ( Im ` ( log ` W ) ) - ( Im ` ( log ` U ) ) ) )
  hypothesis gargdiv.6 |- ( ph -> ( ( Im ` ( log ` W ) ) - ( Im ` ( log ` U ) ) ) <_ _pi )
  |- ( ph -> ( Im ` ( log ` ( W / U ) ) ) = ( ( Im ` ( log ` W ) ) - ( Im ` ( log ` U ) ) ) )
  1 logcld gargdiv.1 gargdiv.2 |- ( ph -> ( log ` U ) e. CC )
  2 logcld gargdiv.3 gargdiv.4 |- ( ph -> ( log ` W ) e. CC )
  3 subcld 2 1 |- ( ph -> ( ( log ` W ) - ( log ` U ) ) e. CC )
  4 imsubd 2 1 |- ( ph -> ( Im ` ( ( log ` W ) - ( log ` U ) ) ) = ( ( Im ` ( log ` W ) ) - ( Im `
      ( log ` U ) ) ) )
  5 breqtrrd gargdiv.5 4 |- ( ph -> -u _pi < ( Im ` ( ( log ` W ) - ( log ` U ) ) ) )
  6 eqbrtrd 4 gargdiv.6 |- ( ph -> ( Im ` ( ( log ` W ) - ( log ` U ) ) ) <_ _pi )
  7 3jca 3 5 6 |- ( ph -> ( ( ( log ` W ) - ( log ` U ) ) e. CC /\ -u _pi < ( Im ` ( ( log ` W ) -
      ( log ` U ) ) ) /\ ( Im ` ( ( log ` W ) - ( log ` U ) ) ) <_ _pi ) )
  8 ellogrn |- ( ( ( log ` W ) - ( log ` U ) ) e. ran log <-> ( ( ( log ` W ) - ( log ` U ) ) e. CC
      /\ -u _pi < ( Im ` ( ( log ` W ) - ( log ` U ) ) ) /\ ( Im ` ( ( log ` W ) - ( log ` U ) ) )
      <_ _pi ) )
  9 sylibr 7 8 |- ( ph -> ( ( log ` W ) - ( log ` U ) ) e. ran log )
  10 logef |- ( ( ( log ` W ) - ( log ` U ) ) e. ran log -> ( log ` ( exp ` ( ( log ` W ) - ( log `
      U ) ) ) ) = ( ( log ` W ) - ( log ` U ) ) )
  11 syl 9 10 |- ( ph -> ( log ` ( exp ` ( ( log ` W ) - ( log ` U ) ) ) ) = ( ( log ` W ) - ( log
      ` U ) ) )
  12 efsubd 2 1 |- ( ph -> ( exp ` ( ( log ` W ) - ( log ` U ) ) ) = ( ( exp ` ( log ` W ) ) / (
      exp ` ( log ` U ) ) ) )
  13 eflog |- ( ( W e. CC /\ W =/= 0 ) -> ( exp ` ( log ` W ) ) = W )
  14 syl2anc gargdiv.3 gargdiv.4 13 |- ( ph -> ( exp ` ( log ` W ) ) = W )
  15 eflog |- ( ( U e. CC /\ U =/= 0 ) -> ( exp ` ( log ` U ) ) = U )
  16 syl2anc gargdiv.1 gargdiv.2 15 |- ( ph -> ( exp ` ( log ` U ) ) = U )
  17 oveq12d 14 16 |- ( ph -> ( ( exp ` ( log ` W ) ) / ( exp ` ( log ` U ) ) ) = ( W / U ) )
  18 eqtrd 12 17 |- ( ph -> ( exp ` ( ( log ` W ) - ( log ` U ) ) ) = ( W / U ) )
  19 fveq2d 18 |- ( ph -> ( log ` ( exp ` ( ( log ` W ) - ( log ` U ) ) ) ) = ( log ` ( W / U ) ) )
  20 eqtr3d 19 11 |- ( ph -> ( log ` ( W / U ) ) = ( ( log ` W ) - ( log ` U ) ) )
  21 fveq2d 20 |- ( ph -> ( Im ` ( log ` ( W / U ) ) ) = ( Im ` ( ( log ` W ) - ( log ` U ) ) ) )
  22 eqtrd 21 4 |- ( ph -> ( Im ` ( log ` ( W / U ) ) ) = ( ( Im ` ( log ` W ) ) - ( Im ` ( log ` U
      ) ) ) )

# Inverting a number off the real line moves it to the other side.
lemma grecim
  hypothesis grecim.1 |- ( ph -> X e. CC )
  hypothesis grecim.2 |- ( ph -> Z e. CC )
  hypothesis grecim.3 |- ( ph -> X =/= 0 )
  hypothesis grecim.4 |- ( ph -> Z =/= 0 )
  hypothesis grecim.5 |- ( ph -> ( Im ` ( Z / X ) ) =/= 0 )
  |- ( ph -> ( ( Im ` ( X / Z ) ) x. ( Im ` ( Z / X ) ) ) < 0 )
  1 divcld grecim.2 grecim.1 grecim.3 |- ( ph -> ( Z / X ) e. CC )
  2 divne0d grecim.2 grecim.1 grecim.4 grecim.3 |- ( ph -> ( Z / X ) =/= 0 )
  3 jca 1 2 |- ( ph -> ( ( Z / X ) e. CC /\ ( Z / X ) =/= 0 ) )
  4 jca 3 1 |- ( ph -> ( ( ( Z / X ) e. CC /\ ( Z / X ) =/= 0 ) /\ ( Z / X ) e. CC ) )
  5 grecsgn |- ( ( ( ( Z / X ) e. CC /\ ( Z / X ) =/= 0 ) /\ ( Z / X ) e. CC ) -> ( ( ( Im ` ( 1 /
      ( Z / X ) ) ) x. ( Im ` ( Z / X ) ) ) < 0 <-> 0 < ( ( Im ` ( Z / X ) ) x. ( Im ` ( Z / X ) )
      ) ) )
  6 syl 4 5 |- ( ph -> ( ( ( Im ` ( 1 / ( Z / X ) ) ) x. ( Im ` ( Z / X ) ) ) < 0 <-> 0 < ( ( Im `
      ( Z / X ) ) x. ( Im ` ( Z / X ) ) ) ) )
  7 imcld 1 |- ( ph -> ( Im ` ( Z / X ) ) e. RR )
  8 msqgt0d 7 grecim.5 |- ( ph -> 0 < ( ( Im ` ( Z / X ) ) x. ( Im ` ( Z / X ) ) ) )
  9 mpbird 8 6 |- ( ph -> ( ( Im ` ( 1 / ( Z / X ) ) ) x. ( Im ` ( Z / X ) ) ) < 0 )
  10 recdivd grecim.2 grecim.1 grecim.4 grecim.3 |- ( ph -> ( 1 / ( Z / X ) ) = ( X / Z ) )
  11 fveq2d 10 |- ( ph -> ( Im ` ( 1 / ( Z / X ) ) ) = ( Im ` ( X / Z ) ) )
  12 oveq1d 11 |- ( ph -> ( ( Im ` ( 1 / ( Z / X ) ) ) x. ( Im ` ( Z / X ) ) ) = ( ( Im ` ( X / Z )
      ) x. ( Im ` ( Z / X ) ) ) )
  13 eqbrtrrd 12 9 |- ( ph -> ( ( Im ` ( X / Z ) ) x. ( Im ` ( Z / X ) ) ) < 0 )

# A positive product with one negative factor has the other negative too.
lemma gsgnneg
  hypothesis gsgnneg.1 |- ( ph -> A e. RR )
  hypothesis gsgnneg.2 |- ( ph -> B e. RR )
  hypothesis gsgnneg.3 |- ( ph -> 0 < ( A x. B ) )
  hypothesis gsgnneg.4 |- ( ph -> B < 0 )
  |- ( ph -> A < 0 )
  1 renegcld gsgnneg.2 |- ( ph -> -u B e. RR )
  2 lt0neg1d gsgnneg.2 |- ( ph -> ( B < 0 <-> 0 < -u B ) )
  3 mpbid gsgnneg.4 2 |- ( ph -> 0 < -u B )
  4 recnd gsgnneg.1 |- ( ph -> A e. CC )
  5 recnd gsgnneg.2 |- ( ph -> B e. CC )
  6 mulneg2d 4 5 |- ( ph -> ( A x. -u B ) = -u ( A x. B ) )
  7 remulcld gsgnneg.1 gsgnneg.2 |- ( ph -> ( A x. B ) e. RR )
  8 lt0neg2d 7 |- ( ph -> ( 0 < ( A x. B ) <-> -u ( A x. B ) < 0 ) )
  9 mpbid gsgnneg.3 8 |- ( ph -> -u ( A x. B ) < 0 )
  10 eqbrtrd 6 9 |- ( ph -> ( A x. -u B ) < 0 )
  11 mul2lt0rgt0 gsgnneg.1 1 10 |- ( ( ph /\ 0 < -u B ) -> A < 0 )
  12 mpdan 3 11 |- ( ph -> A < 0 )

# Angle addition when all three quotients lie above the real line: the
# arguments are in (0, pi), so the middle one is exactly the difference.
lemma gangpos
  hypothesis gangpos.1 |- ( ph -> X e. CC )
  hypothesis gangpos.2 |- ( ph -> Y e. CC )
  hypothesis gangpos.3 |- ( ph -> Z e. CC )
  hypothesis gangpos.4 |- ( ph -> X =/= 0 )
  hypothesis gangpos.5 |- ( ph -> Y =/= 0 )
  hypothesis gangpos.6 |- ( ph -> Z =/= 0 )
  hypothesis gangpos.7 |- ( ph -> 0 < ( Im ` ( Y / X ) ) )
  hypothesis gangpos.8 |- ( ph -> 0 < ( Im ` ( Z / Y ) ) )
