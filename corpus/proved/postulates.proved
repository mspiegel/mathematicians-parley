# Two reals of one sign and one size are equal: X Y is |X| |Y| = |X| |X|,
# which is X X, and X is not 0.
lemma gabssgn
  hypothesis gabssgn.1 |- ( ph -> X e. RR )
  hypothesis gabssgn.2 |- ( ph -> Y e. RR )
  hypothesis gabssgn.3 |- ( ph -> 0 < ( X x. Y ) )
  hypothesis gabssgn.4 |- ( ph -> ( abs ` X ) = ( abs ` Y ) )
  |- ( ph -> X = Y )
  1 recnd gabssgn.1 |- ( ph -> X e. CC )
  2 recnd gabssgn.2 |- ( ph -> Y e. CC )
  3 remulcld gabssgn.1 gabssgn.2 |- ( ph -> ( X x. Y ) e. RR )
  4 0red |- ( ph -> 0 e. RR )
  5 ltled 4 3 gabssgn.3 |- ( ph -> 0 <_ ( X x. Y ) )
  6 absidd 3 5 |- ( ph -> ( abs ` ( X x. Y ) ) = ( X x. Y ) )
  7 absmuld 1 2 |- ( ph -> ( abs ` ( X x. Y ) ) = ( ( abs ` X ) x. ( abs ` Y ) ) )
  8 oveq2d gabssgn.4 |- ( ph -> ( ( abs ` X ) x. ( abs ` X ) ) = ( ( abs ` X ) x. ( abs ` Y ) ) )
  9 absmuld 1 1 |- ( ph -> ( abs ` ( X x. X ) ) = ( ( abs ` X ) x. ( abs ` X ) ) )
  10 remulcld gabssgn.1 gabssgn.1 |- ( ph -> ( X x. X ) e. RR )
  11 msqge0d gabssgn.1 |- ( ph -> 0 <_ ( X x. X ) )
  12 absidd 10 11 |- ( ph -> ( abs ` ( X x. X ) ) = ( X x. X ) )
  13 eqtr3d 6 7 |- ( ph -> ( X x. Y ) = ( ( abs ` X ) x. ( abs ` Y ) ) )
  14 eqtr4d 13 8 |- ( ph -> ( X x. Y ) = ( ( abs ` X ) x. ( abs ` X ) ) )
  15 eqtr3d 9 12 |- ( ph -> ( ( abs ` X ) x. ( abs ` X ) ) = ( X x. X ) )
  16 eqtrd 14 15 |- ( ph -> ( X x. Y ) = ( X x. X ) )
  17 gt0ne0d gabssgn.3 |- ( ph -> ( X x. Y ) =/= 0 )
  18 mulne0bad 1 2 17 |- ( ph -> X =/= 0 )
  19 mulcanad 2 1 1 18 16 |- ( ph -> Y = X )
  20 eqcomd 19 |- ( ph -> X = Y )

# On C's side of line AB the angle BAD fixes the argument of
# d = (D - A)/(B - A): the argument has the sign of Im d, which is C's sign,
# and its size is the angle. Two numbers of one argument have a positive
# real quotient, the exponential of the real difference of their logs, so
# (E - A)/(D - A) = e/d is a positive real and E is on ray AD.
lemma gangculem
  hypothesis gangculem.1 |- ( ph -> A e. CC )
  hypothesis gangculem.2 |- ( ph -> B e. CC )
  hypothesis gangculem.3 |- ( ph -> C e. CC )
