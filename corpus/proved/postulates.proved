# The empty set is not an extended real.
lemma gnelxr
  |- -. (/) e. RR*
  1 0ncn |- -. (/) e. CC
  2 recn |- ( (/) e. RR -> (/) e. CC )
  3 mto 1 2 |- -. (/) e. RR
  4 0elpw |- (/) e. ~P U. CC
  5 df-pnf |- +oo = ~P U. CC
