# Two distinct points have a midpoint.
lemma gmidex
  |- ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) -> E. x e. CC ( ( A =/= x /\ ( ( B - x ) / ( A - x ) )
      e. RR /\ ( ( B - x ) / ( A - x ) ) < 0 ) /\ ( abs ` ( A - x ) ) = ( abs ` ( x - B ) ) ) )
  1 simpll |- ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) -> A e. CC )
  2 simplr |- ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) -> B e. CC )
  3 simpr |- ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) -> A =/= B )
  4 adantr 1 |- ( ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) /\ x = ( ( A + B ) / 2 ) ) -> A e. CC )
  5 adantr 2 |- ( ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) /\ x = ( ( A + B ) / 2 ) ) -> B e. CC )
  6 adantr 3 |- ( ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) /\ x = ( ( A + B ) / 2 ) ) -> A =/= B )
  7 simpr |- ( ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) /\ x = ( ( A + B ) / 2 ) ) -> x = ( ( A + B
      ) / 2 ) )
  8 gmidexd 4 5 6 7 |- ( ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) /\ x = ( ( A + B ) / 2 ) ) -> ( (
      A =/= x /\ ( ( B - x ) / ( A - x ) ) e. RR /\ ( ( B - x ) / ( A - x ) ) < 0 ) /\ ( abs ` ( A
      - x ) ) = ( abs ` ( x - B ) ) ) )
  9 addcld 1 2 |- ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) -> ( A + B ) e. CC )
  10 halfcld 9 |- ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) -> ( ( A + B ) / 2 ) e. CC )
  11 rspcime 8 10 |- ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) -> E. x e. CC ( ( A =/= x /\ ( ( B - x
      ) / ( A - x ) ) e. RR /\ ( ( B - x ) / ( A - x ) ) < 0 ) /\ ( abs ` ( A - x ) ) = ( abs ` ( x
      - B ) ) ) )

# Segment AB produced past B by K: go on from B by K times the unit
# direction from A to B. Then X - B is -K/|B - A| times A - B.
lemma gextendd
  hypothesis gextendd.1 |- ( ph -> A e. CC )
  hypothesis gextendd.2 |- ( ph -> B e. CC )
  hypothesis gextendd.3 |- ( ph -> K e. RR )
  hypothesis gextendd.4 |- ( ph -> A =/= B )
  hypothesis gextendd.5 |- ( ph -> 0 < K )
  hypothesis gextendd.6 |- ( ph -> X = ( B + ( ( K / ( abs ` ( B - A ) ) ) x. ( B - A ) ) ) )
  |- ( ph -> ( ( A =/= B /\ ( ( X - B ) / ( A - B ) ) e. RR /\ ( ( X - B ) / ( A - B ) ) < 0 ) /\ (
      abs ` ( B - X ) ) = K ) )
  1 subcld gextendd.2 gextendd.1 |- ( ph -> ( B - A ) e. CC )
  2 necomd gextendd.4 |- ( ph -> B =/= A )
