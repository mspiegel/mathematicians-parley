lemma gangaddin
  |- ( ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ C e. CC ) /\ D e. CC ) /\ ( ( ( -. A = B /\ -. B = C )
      /\ -. A = C ) /\ -. ( ( C - A ) / ( B - A ) ) e. RR ) ) /\ 0 < ( ( Im ` ( ( D - A ) / ( B - A
      ) ) ) x. ( Im ` ( ( C - A ) / ( B - A ) ) ) ) ) /\ 0 < ( ( Im ` ( ( D - A ) / ( C - A ) ) )
      x. ( Im ` ( ( B - A ) / ( C - A ) ) ) ) ) -> ( ( abs ` ( ( B - A ) ang ( D - A ) ) ) + ( abs
      ` ( ( D - A ) ang ( C - A ) ) ) ) = ( abs ` ( ( B - A ) ang ( C - A ) ) ) )
