# E on line AB is A + T(B - A) with T real, so E - A over D - C is T times
# B - A over D - C, real; over C - D it is the negative of that.
lemma gparalongd
  hypothesis gparalongd.1 |- ( ph -> A e. CC )
  hypothesis gparalongd.2 |- ( ph -> B e. CC )
  hypothesis gparalongd.3 |- ( ph -> C e. CC )
  hypothesis gparalongd.4 |- ( ph -> D e. CC )
  hypothesis gparalongd.5 |- ( ph -> E e. CC )
  hypothesis gparalongd.6 |- ( ph -> ( ( B - A ) / ( D - C ) ) e. RR )
  hypothesis gparalongd.7 |- ( ph -> A =/= B )
  hypothesis gparalongd.8 |- ( ph -> ( A = B \/ ( ( E - A ) / ( B - A ) ) e. RR ) )
  |- ( ph -> ( ( E - A ) / ( C - D ) ) e. RR )
