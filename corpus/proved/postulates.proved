# Each of the four cases puts P at a real place q along the way from A to
# B with q not below 0: q is 0 at A and 1 at B; P between A and B makes
# (B - P)/(A - P) = (1 - q)/(-q), and B between A and P makes
# (P - B)/(A - B) = 1 - q, each of which is positive were q below 0.
lemma grayback
  hypothesis grayback.1 |- ( ph -> P e. CC )
  hypothesis grayback.2 |- ( ph -> A e. CC )
  hypothesis grayback.3 |- ( ph -> B e. CC )
  hypothesis grayback.4 |- ( ph -> A =/= B )
