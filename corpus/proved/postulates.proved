# A vertex of a triangle is not on the line of the other two.
lemma gtrinotd
  hypothesis gtrinotd.1 |- ( ph -> P e. CC )
  hypothesis gtrinotd.2 |- ( ph -> Q e. CC )
  hypothesis gtrinotd.3 |- ( ph -> R e. CC )
  hypothesis gtrinotd.4 |- ( ph -> ( ( ( -. P = Q /\ -. Q = R ) /\ -. P = R ) /\ -. ( ( R - P ) / (
      Q - P ) ) e. RR ) )
  |- ( ph -> -. ( Q = R \/ ( ( P - Q ) / ( R - Q ) ) e. RR ) )
  1 gtridef |- ( ( ( ( -. P = Q /\ -. Q = R ) /\ -. P = R ) /\ -. ( ( R - P ) / ( Q - P ) ) e. RR )
      <-> ( ( ( -. P = Q /\ -. Q = R ) /\ -. P = R ) /\ -. ( P = Q \/ ( ( R - P ) / ( Q - P ) ) e.
      RR ) ) )
  2 sylib gtrinotd.4 1 |- ( ph -> ( ( ( -. P = Q /\ -. Q = R ) /\ -. P = R ) /\ -. ( P = Q \/ ( ( R
      - P ) / ( Q - P ) ) e. RR ) ) )
  3 simprd 2 |- ( ph -> -. ( P = Q \/ ( ( R - P ) / ( Q - P ) ) e. RR ) )
  4 3jca gtrinotd.2 gtrinotd.3 gtrinotd.1 |- ( ph -> ( Q e. CC /\ R e. CC /\ P e. CC ) )
  5 gcolrotate |- ( ( Q e. CC /\ R e. CC /\ P e. CC ) -> ( ( Q = R \/ ( ( P - Q ) / ( R - Q ) ) e.
      RR ) -> ( R = P \/ ( ( Q - R ) / ( P - R ) ) e. RR ) ) )
  6 syl 4 5 |- ( ph -> ( ( Q = R \/ ( ( P - Q ) / ( R - Q ) ) e. RR ) -> ( R = P \/ ( ( Q - R ) / (
      P - R ) ) e. RR ) ) )
  7 3jca gtrinotd.3 gtrinotd.1 gtrinotd.2 |- ( ph -> ( R e. CC /\ P e. CC /\ Q e. CC ) )
  8 gcolrotate |- ( ( R e. CC /\ P e. CC /\ Q e. CC ) -> ( ( R = P \/ ( ( Q - R ) / ( P - R ) ) e.
      RR ) -> ( P = Q \/ ( ( R - P ) / ( Q - P ) ) e. RR ) ) )
  9 syl 7 8 |- ( ph -> ( ( R = P \/ ( ( Q - R ) / ( P - R ) ) e. RR ) -> ( P = Q \/ ( ( R - P ) / (
      Q - P ) ) e. RR ) ) )
  10 syld 6 9 |- ( ph -> ( ( Q = R \/ ( ( P - Q ) / ( R - Q ) ) e. RR ) -> ( P = Q \/ ( ( R - P ) /
      ( Q - P ) ) e. RR ) ) )
  11 mtod 3 10 |- ( ph -> -. ( Q = R \/ ( ( P - Q ) / ( R - Q ) ) e. RR ) )

lemma gtrinot
  |- ( ( ( ( P e. CC /\ Q e. CC ) /\ R e. CC ) /\ ( ( ( -. P = Q /\ -. Q = R ) /\ -. P = R ) /\ -.
      ( ( R - P ) / ( Q - P ) ) e. RR ) ) -> -. ( Q = R \/ ( ( P - Q ) / ( R - Q ) ) e. RR ) )
  1 simplll |- ( ( ( ( P e. CC /\ Q e. CC ) /\ R e. CC ) /\ ( ( ( -. P = Q /\ -. Q = R ) /\ -. P =
      R ) /\ -. ( ( R - P ) / ( Q - P ) ) e. RR ) ) -> P e. CC )
  2 simpllr |- ( ( ( ( P e. CC /\ Q e. CC ) /\ R e. CC ) /\ ( ( ( -. P = Q /\ -. Q = R ) /\ -. P =
      R ) /\ -. ( ( R - P ) / ( Q - P ) ) e. RR ) ) -> Q e. CC )
  3 simplr |- ( ( ( ( P e. CC /\ Q e. CC ) /\ R e. CC ) /\ ( ( ( -. P = Q /\ -. Q = R ) /\ -. P = R
