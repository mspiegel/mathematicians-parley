# Ruler placement over a line given by hypotheses: the ruler has A at 0
# and B at |AB|, and measures distance.
lemma grulerplh
  hypothesis grulerplh.1 |- L = { u e. CC | ( A = B \/ ( ( u - A ) / ( B - A ) ) e. RR ) }
  hypothesis grulerplh.2 |- F = ( w e. L |-> ( ( ( w - A ) / ( B - A ) ) x. ( abs ` ( B - A ) ) ) )
  |- ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) -> E. f e. ( RR ^m L ) ( ( ( f : L -1-1-onto-> RR /\ (
      f ` A ) = 0 ) /\ 0 < ( f ` B ) ) /\ A. x e. L A. y e. L ( abs ` ( x - y ) ) = ( abs ` ( ( f `
      x ) - ( f ` y ) ) ) ) )
