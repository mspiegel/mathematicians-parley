  18 jca 10 17 |- ( ( ( ( A e. CC /\ B e. CC ) /\ P e. CC ) /\ -. ( A = B \/ ( ( P - A ) / ( B - A
      ) ) e. RR ) ) -> ( P =/= A /\ P =/= B ) )

# A point on line AB and a point off it are two points.
lemma gonoffapart
  |- ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ X e. CC ) /\ Y e. CC ) /\ ( A = B \/ ( ( X - A ) / ( B - A
      ) ) e. RR ) ) /\ -. ( A = B \/ ( ( Y - A ) / ( B - A ) ) e. RR ) ) -> X =/= Y )
  1 simplr |- ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ X e. CC ) /\ Y e. CC ) /\ ( A = B \/ ( ( X - A )
      / ( B - A ) ) e. RR ) ) /\ -. ( A = B \/ ( ( Y - A ) / ( B - A ) ) e. RR ) ) -> ( A = B \/ (
      ( X - A ) / ( B - A ) ) e. RR ) )
  2 adantr 1 |- ( ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ X e. CC ) /\ Y e. CC ) /\ ( A = B \/ ( ( X -
      A ) / ( B - A ) ) e. RR ) ) /\ -. ( A = B \/ ( ( Y - A ) / ( B - A ) ) e. RR ) ) /\ X = Y )
      -> ( A = B \/ ( ( X - A ) / ( B - A ) ) e. RR ) )
  3 simpr |- ( ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ X e. CC ) /\ Y e. CC ) /\ ( A = B \/ ( ( X - A )
      / ( B - A ) ) e. RR ) ) /\ -. ( A = B \/ ( ( Y - A ) / ( B - A ) ) e. RR ) ) /\ X = Y ) -> X
      = Y )
  4 oveq1d 3 |- ( ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ X e. CC ) /\ Y e. CC ) /\ ( A = B \/ ( ( X -
      A ) / ( B - A ) ) e. RR ) ) /\ -. ( A = B \/ ( ( Y - A ) / ( B - A ) ) e. RR ) ) /\ X = Y )
      -> ( X - A ) = ( Y - A ) )
  5 oveq1d 4 |- ( ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ X e. CC ) /\ Y e. CC ) /\ ( A = B \/ ( ( X -
      A ) / ( B - A ) ) e. RR ) ) /\ -. ( A = B \/ ( ( Y - A ) / ( B - A ) ) e. RR ) ) /\ X = Y )
      -> ( ( X - A ) / ( B - A ) ) = ( ( Y - A ) / ( B - A ) ) )
  6 eleq1d 5 |- ( ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ X e. CC ) /\ Y e. CC ) /\ ( A = B \/ ( ( X -
      A ) / ( B - A ) ) e. RR ) ) /\ -. ( A = B \/ ( ( Y - A ) / ( B - A ) ) e. RR ) ) /\ X = Y )
      -> ( ( ( X - A ) / ( B - A ) ) e. RR <-> ( ( Y - A ) / ( B - A ) ) e. RR ) )
  7 orbi2d 6 |- ( ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ X e. CC ) /\ Y e. CC ) /\ ( A = B \/ ( ( X -
      A ) / ( B - A ) ) e. RR ) ) /\ -. ( A = B \/ ( ( Y - A ) / ( B - A ) ) e. RR ) ) /\ X = Y )
      -> ( ( A = B \/ ( ( X - A ) / ( B - A ) ) e. RR ) <-> ( A = B \/ ( ( Y - A ) / ( B - A ) ) e.
      RR ) ) )
  8 mpbid 2 7 |- ( ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ X e. CC ) /\ Y e. CC ) /\ ( A = B \/ ( ( X -
      A ) / ( B - A ) ) e. RR ) ) /\ -. ( A = B \/ ( ( Y - A ) / ( B - A ) ) e. RR ) ) /\ X = Y )
      -> ( A = B \/ ( ( Y - A ) / ( B - A ) ) e. RR ) )
  9 simpr |- ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ X e. CC ) /\ Y e. CC ) /\ ( A = B \/ ( ( X - A ) /
      ( B - A ) ) e. RR ) ) /\ -. ( A = B \/ ( ( Y - A ) / ( B - A ) ) e. RR ) ) -> -. ( A = B \/ (
      ( Y - A ) / ( B - A ) ) e. RR ) )
  10 adantr 9 |- ( ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ X e. CC ) /\ Y e. CC ) /\ ( A = B \/ ( ( X -
      A ) / ( B - A ) ) e. RR ) ) /\ -. ( A = B \/ ( ( Y - A ) / ( B - A ) ) e. RR ) ) /\ X = Y )
      -> -. ( A = B \/ ( ( Y - A ) / ( B - A ) ) e. RR ) )
  11 pm2.65da 8 10 |- ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ X e. CC ) /\ Y e. CC ) /\ ( A = B \/ ( (
      X - A ) / ( B - A ) ) e. RR ) ) /\ -. ( A = B \/ ( ( Y - A ) / ( B - A ) ) e. RR ) ) -> -. X
      = Y )
  12 neqned 11 |- ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ X e. CC ) /\ Y e. CC ) /\ ( A = B \/ ( ( X -
      A ) / ( B - A ) ) e. RR ) ) /\ -. ( A = B \/ ( ( Y - A ) / ( B - A ) ) e. RR ) ) -> X =/= Y )

# The empty set is not an extended real: it is not a complex number, and
# +oo and -oo are power sets, never empty.
lemma gemptynxr
  |- -. (/) e. RR*
  1 0ncn |- -. (/) e. CC
  2 recn |- ( (/) e. RR -> (/) e. CC )
  3 mto 1 2 |- -. (/) e. RR
  4 df-pnf |- +oo = ~P U. CC
  5 pwne0 |- ~P U. CC =/= (/)
  6 eqnetri 4 5 |- +oo =/= (/)
  7 necomi 6 |- (/) =/= +oo
  8 neii 7 |- -. (/) = +oo
  9 df-mnf |- -oo = ~P +oo
  10 pwne0 |- ~P +oo =/= (/)
  11 eqnetri 9 10 |- -oo =/= (/)
  12 necomi 11 |- (/) =/= -oo
  13 neii 12 |- -. (/) = -oo
  14 3pm3.2i 3 8 13 |- ( -. (/) e. RR /\ -. (/) = +oo /\ -. (/) = -oo )
  15 3ioran |- ( -. ( (/) e. RR \/ (/) = +oo \/ (/) = -oo ) <-> ( -. (/) e. RR /\ -. (/) = +oo /\
      -. (/) = -oo ) )
  16 mpbir 14 15 |- -. ( (/) e. RR \/ (/) = +oo \/ (/) = -oo )
  17 elxr |- ( (/) e. RR* <-> ( (/) e. RR \/ (/) = +oo \/ (/) = -oo ) )
  18 mtbir 16 17 |- -. (/) e. RR*

# Division by 0 is undefined, so the product of the imaginary parts of two
# quotients by 0 is the empty set.
lemma gimdivz
  |- ( ( Im ` ( A / 0 ) ) x. ( Im ` ( B / 0 ) ) ) = (/)
  1 df-div |- / = ( x e. CC , y e. ( CC \ { 0 } ) |-> ( iota_ z e. CC ( y x. z ) = x ) )
  2 riotaex |- ( iota_ z e. CC ( y x. z ) = x ) e. _V
