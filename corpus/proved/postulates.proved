      B - A ) / ( D - C ) ) e. RR ) /\ A =/= B ) /\ ( A = B \/ ( ( E - A ) / ( B - A ) ) e. RR ) )
      /\ E =/= A ) -> B e. CC )
  3 simp-7r |- ( ( ( ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ C e. CC ) /\ D e. CC ) /\ E e. CC ) /\ ( (
      B - A ) / ( D - C ) ) e. RR ) /\ A =/= B ) /\ ( A = B \/ ( ( E - A ) / ( B - A ) ) e. RR ) )
      /\ E =/= A ) -> C e. CC )
  4 simp-6r |- ( ( ( ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ C e. CC ) /\ D e. CC ) /\ E e. CC ) /\ ( (
      B - A ) / ( D - C ) ) e. RR ) /\ A =/= B ) /\ ( A = B \/ ( ( E - A ) / ( B - A ) ) e. RR ) )
      /\ E =/= A ) -> D e. CC )
  5 simp-5r |- ( ( ( ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ C e. CC ) /\ D e. CC ) /\ E e. CC ) /\ ( (
      B - A ) / ( D - C ) ) e. RR ) /\ A =/= B ) /\ ( A = B \/ ( ( E - A ) / ( B - A ) ) e. RR ) )
      /\ E =/= A ) -> E e. CC )
  6 simp-4r |- ( ( ( ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ C e. CC ) /\ D e. CC ) /\ E e. CC ) /\ ( (
      B - A ) / ( D - C ) ) e. RR ) /\ A =/= B ) /\ ( A = B \/ ( ( E - A ) / ( B - A ) ) e. RR ) )
      /\ E =/= A ) -> ( ( B - A ) / ( D - C ) ) e. RR )
  7 simpllr |- ( ( ( ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ C e. CC ) /\ D e. CC ) /\ E e. CC ) /\ ( (
      B - A ) / ( D - C ) ) e. RR ) /\ A =/= B ) /\ ( A = B \/ ( ( E - A ) / ( B - A ) ) e. RR ) )
      /\ E =/= A ) -> A =/= B )
  8 simplr |- ( ( ( ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ C e. CC ) /\ D e. CC ) /\ E e. CC ) /\ ( (
      B - A ) / ( D - C ) ) e. RR ) /\ A =/= B ) /\ ( A = B \/ ( ( E - A ) / ( B - A ) ) e. RR ) )
      /\ E =/= A ) -> ( A = B \/ ( ( E - A ) / ( B - A ) ) e. RR ) )
  9 gparalongd 1 2 3 4 5 6 7 8 |- ( ( ( ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ C e. CC ) /\ D e. CC )
      /\ E e. CC ) /\ ( ( B - A ) / ( D - C ) ) e. RR ) /\ A =/= B ) /\ ( A = B \/ ( ( E - A ) / (
      B - A ) ) e. RR ) ) /\ E =/= A ) -> ( ( E - A ) / ( C - D ) ) e. RR )

