  9 adantr gofflinethrud.1 |- ( ( ph /\ S = R ) -> R e. CC )
  10 adantr gofflinethrud.2 |- ( ( ph /\ S = R ) -> P e. CC )
  11 simpr |- ( ( ph /\ S = R ) -> S = R )
  12 gonfst 9 10 11 |- ( ( ph /\ S = R ) -> ( R = P \/ ( ( S - R ) / ( P - R ) ) e. RR ) )
  13 adantr gofflinethrud.5 |- ( ( ph /\ S = R ) -> -. ( R = P \/ ( ( S - R ) / ( P - R ) ) e. RR )
      )
  14 pm2.65da 12 13 |- ( ph -> -. S = R )
  15 neqned 14 |- ( ph -> S =/= R )
  16 necomd 15 |- ( ph -> R =/= S )
  17 neneqd 16 |- ( ph -> -. R = S )
  18 orel1 |- ( -. R = S -> ( ( R = S \/ ( ( X - R ) / ( S - R ) ) e. RR ) -> ( ( X - R ) / ( S - R
