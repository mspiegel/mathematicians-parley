# A point of line PQ on Q's side of line PR makes the same angle with ray
# PR as Q does.
lemma gangsameray
  |- ( ( ( ( ( ( R e. CC /\ P e. CC ) /\ Q e. CC ) /\ X e. CC ) /\ ( P = Q \/ ( ( X - P ) / ( Q - P
      ) ) e. RR ) ) /\ 0 < ( ( Im ` ( ( X - P ) / ( R - P ) ) ) x. ( Im ` ( ( Q - P ) / ( R - P ) )
      ) ) ) -> ( abs ` ( ( R - P ) ang ( X - P ) ) ) = ( abs ` ( ( R - P ) ang ( Q - P ) ) ) )
  1 simp-5l |- ( ( ( ( ( ( R e. CC /\ P e. CC ) /\ Q e. CC ) /\ X e. CC ) /\ ( P = Q \/ ( ( X - P )
      / ( Q - P ) ) e. RR ) ) /\ 0 < ( ( Im ` ( ( X - P ) / ( R - P ) ) ) x. ( Im ` ( ( Q - P ) / (
      R - P ) ) ) ) ) -> R e. CC )
  2 simp-5r |- ( ( ( ( ( ( R e. CC /\ P e. CC ) /\ Q e. CC ) /\ X e. CC ) /\ ( P = Q \/ ( ( X - P )
      / ( Q - P ) ) e. RR ) ) /\ 0 < ( ( Im ` ( ( X - P ) / ( R - P ) ) ) x. ( Im ` ( ( Q - P ) / (
      R - P ) ) ) ) ) -> P e. CC )
  3 simp-4r |- ( ( ( ( ( ( R e. CC /\ P e. CC ) /\ Q e. CC ) /\ X e. CC ) /\ ( P = Q \/ ( ( X - P )
      / ( Q - P ) ) e. RR ) ) /\ 0 < ( ( Im ` ( ( X - P ) / ( R - P ) ) ) x. ( Im ` ( ( Q - P ) / (
      R - P ) ) ) ) ) -> Q e. CC )
  4 simpllr |- ( ( ( ( ( ( R e. CC /\ P e. CC ) /\ Q e. CC ) /\ X e. CC ) /\ ( P = Q \/ ( ( X - P )
      / ( Q - P ) ) e. RR ) ) /\ 0 < ( ( Im ` ( ( X - P ) / ( R - P ) ) ) x. ( Im ` ( ( Q - P ) / (
      R - P ) ) ) ) ) -> X e. CC )
  5 simplr |- ( ( ( ( ( ( R e. CC /\ P e. CC ) /\ Q e. CC ) /\ X e. CC ) /\ ( P = Q \/ ( ( X - P )
      / ( Q - P ) ) e. RR ) ) /\ 0 < ( ( Im ` ( ( X - P ) / ( R - P ) ) ) x. ( Im ` ( ( Q - P ) / (
      R - P ) ) ) ) ) -> ( P = Q \/ ( ( X - P ) / ( Q - P ) ) e. RR ) )
  6 simpr |- ( ( ( ( ( ( R e. CC /\ P e. CC ) /\ Q e. CC ) /\ X e. CC ) /\ ( P = Q \/ ( ( X - P ) /
      ( Q - P ) ) e. RR ) ) /\ 0 < ( ( Im ` ( ( X - P ) / ( R - P ) ) ) x. ( Im ` ( ( Q - P ) / ( R
      - P ) ) ) ) ) -> 0 < ( ( Im ` ( ( X - P ) / ( R - P ) ) ) x. ( Im ` ( ( Q - P ) / ( R - P ) )
      ) ) )
  7 gangsamerayd 1 2 3 4 5 6 |- ( ( ( ( ( ( R e. CC /\ P e. CC ) /\ Q e. CC ) /\ X e. CC ) /\ ( P =
      Q \/ ( ( X - P ) / ( Q - P ) ) e. RR ) ) /\ 0 < ( ( Im ` ( ( X - P ) / ( R - P ) ) ) x. ( Im
      ` ( ( Q - P ) / ( R - P ) ) ) ) ) -> ( abs ` ( ( R - P ) ang ( X - P ) ) ) = ( abs ` ( ( R -
      P ) ang ( Q - P ) ) ) )

# A length K shorter than segment AB, laid off from A towards B: go on
# from A by K times the unit direction from A to B. With U = K/|B - A|,
# between 0 and 1, A - X is -U(B - A) and B - X is (1 - U)(B - A).
lemma gsegptd
  hypothesis gsegptd.1 |- ( ph -> A e. CC )
  hypothesis gsegptd.2 |- ( ph -> B e. CC )
  hypothesis gsegptd.3 |- ( ph -> K e. RR )
