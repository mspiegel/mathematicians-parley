# Lines AB and CD with real direction quotient that share a point X are
# one line: A and B are then points of line CD.
lemma gparsame
  hypothesis gparsame.1 |- ( ph -> A e. CC )
  hypothesis gparsame.2 |- ( ph -> B e. CC )
  hypothesis gparsame.3 |- ( ph -> C e. CC )
  hypothesis gparsame.4 |- ( ph -> D e. CC )
  hypothesis gparsame.5 |- ( ph -> X e. CC )
  hypothesis gparsame.6 |- ( ph -> A =/= B )
  hypothesis gparsame.7 |- ( ph -> C =/= D )
  hypothesis gparsame.8 |- ( ph -> ( ( B - A ) / ( D - C ) ) e. RR )
  hypothesis gparsame.9 |- ( ph -> ( ( X - A ) / ( B - A ) ) e. RR )
  hypothesis gparsame.10 |- ( ph -> ( ( X - C ) / ( D - C ) ) e. RR )
  |- ( ph -> { u e. CC | ( A = B \/ ( ( u - A ) / ( B - A ) ) e. RR ) } = { u e. CC | ( C = D \/ (
      ( u - C ) / ( D - C ) ) e. RR ) } )
  1 subcld gparsame.4 gparsame.3 |- ( ph -> ( D - C ) e. CC )
  2 necomd gparsame.7 |- ( ph -> D =/= C )
  3 subne0d gparsame.4 gparsame.3 2 |- ( ph -> ( D - C ) =/= 0 )
  4 subcld gparsame.2 gparsame.1 |- ( ph -> ( B - A ) e. CC )
  5 necomd gparsame.6 |- ( ph -> B =/= A )
  6 subne0d gparsame.2 gparsame.1 5 |- ( ph -> ( B - A ) =/= 0 )
  7 subcld gparsame.5 gparsame.1 |- ( ph -> ( X - A ) e. CC )
  8 remulcld gparsame.8 gparsame.9 |- ( ph -> ( ( ( B - A ) / ( D - C ) ) x. ( ( X - A ) / ( B - A
      ) ) ) e. RR )
  9 dmdcand 7 4 1 6 3 |- ( ph -> ( ( ( B - A ) / ( D - C ) ) x. ( ( X - A ) / ( B - A ) ) ) = ( ( X
      - A ) / ( D - C ) ) )
  10 eqeltrrd 9 8 |- ( ph -> ( ( X - A ) / ( D - C ) ) e. RR )
  11 subcld gparsame.5 gparsame.3 |- ( ph -> ( X - C ) e. CC )
  12 divsubdird 11 7 1 3 |- ( ph -> ( ( ( X - C ) - ( X - A ) ) / ( D - C ) ) = ( ( ( X - C ) / ( D
      - C ) ) - ( ( X - A ) / ( D - C ) ) ) )
  13 nnncan1d gparsame.5 gparsame.3 gparsame.1 |- ( ph -> ( ( X - C ) - ( X - A ) ) = ( A - C ) )
  14 oveq1d 13 |- ( ph -> ( ( ( X - C ) - ( X - A ) ) / ( D - C ) ) = ( ( A - C ) / ( D - C ) ) )
  15 eqtr3d 12 14 |- ( ph -> ( ( ( X - C ) / ( D - C ) ) - ( ( X - A ) / ( D - C ) ) ) = ( ( A - C
      ) / ( D - C ) ) )
  16 resubcld gparsame.10 10 |- ( ph -> ( ( ( X - C ) / ( D - C ) ) - ( ( X - A ) / ( D - C ) ) )
      e. RR )
  17 eqeltrrd 15 16 |- ( ph -> ( ( A - C ) / ( D - C ) ) e. RR )
  18 subcld gparsame.1 gparsame.3 |- ( ph -> ( A - C ) e. CC )
  19 divdird 18 4 1 3 |- ( ph -> ( ( ( A - C ) + ( B - A ) ) / ( D - C ) ) = ( ( ( A - C ) / ( D -
      C ) ) + ( ( B - A ) / ( D - C ) ) ) )
