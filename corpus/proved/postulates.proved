  2 subcld gparalongd.4 gparalongd.3 |- ( ph -> ( D - C ) e. CC )
  3 neneqd gparalongd.7 |- ( ph -> -. A = B )
  4 orel1 |- ( -. A = B -> ( ( A = B \/ ( ( E - A ) / ( B - A ) ) e. RR ) -> ( ( E - A ) / ( B - A
      ) ) e. RR ) )
  5 sylc 3 gparalongd.8 4 |- ( ph -> ( ( E - A ) / ( B - A ) ) e. RR )
  6 necomd gparalongd.7 |- ( ph -> B =/= A )
  7 glinemul gparalongd.5 gparalongd.1 gparalongd.2 2 1 6 |- ( ph -> ( ( E - A ) / ( D - C ) ) = (
      ( ( E - A ) / ( B - A ) ) x. ( ( B - A ) / ( D - C ) ) ) )
  8 remulcld 5 gparalongd.6 |- ( ph -> ( ( ( E - A ) / ( B - A ) ) x. ( ( B - A ) / ( D - C ) ) )
      e. RR )
  9 eqeltrd 7 8 |- ( ph -> ( ( E - A ) / ( D - C ) ) e. RR )
  10 subcld gparalongd.5 gparalongd.1 |- ( ph -> ( E - A ) e. CC )
  11 divneg2d 10 2 1 |- ( ph -> -u ( ( E - A ) / ( D - C ) ) = ( ( E - A ) / -u ( D - C ) ) )
  12 negsubdi2d gparalongd.4 gparalongd.3 |- ( ph -> -u ( D - C ) = ( C - D ) )
  13 oveq2d 12 |- ( ph -> ( ( E - A ) / -u ( D - C ) ) = ( ( E - A ) / ( C - D ) ) )
  14 eqtrd 11 13 |- ( ph -> -u ( ( E - A ) / ( D - C ) ) = ( ( E - A ) / ( C - D ) ) )
  15 renegcld 9 |- ( ph -> -u ( ( E - A ) / ( D - C ) ) e. RR )
  16 eqeltrrd 14 15 |- ( ph -> ( ( E - A ) / ( C - D ) ) e. RR )

# A line through A and a point E of a line AB parallel to line CD is
# parallel to line DC.
lemma gparalong
  |- ( ( ( ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ C e. CC ) /\ D e. CC ) /\ E e. CC ) /\ ( ( B - A ) /
      ( D - C ) ) e. RR ) /\ A =/= B ) /\ ( A = B \/ ( ( E - A ) / ( B - A ) ) e. RR ) ) /\ E =/= A
      ) -> ( ( E - A ) / ( C - D ) ) e. RR )
