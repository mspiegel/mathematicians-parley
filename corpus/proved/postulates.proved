lemma gsegbeyond
  |- ( ( ( ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ P e. CC ) /\ Q e. CC ) /\ X e. CC ) /\ A =/= B ) /\
      ( A = B \/ ( ( Q - A ) / ( B - A ) ) e. RR ) ) /\ -. ( A = B \/ ( ( X - A ) / ( B - A ) ) e.
      RR ) ) /\ ( P =/= X /\ ( ( Q - X ) / ( P - X ) ) e. RR /\ ( ( Q - X ) / ( P - X ) ) < 0 ) )
      -> 0 < ( ( Im ` ( ( P - A ) / ( B - A ) ) ) x. ( Im ` ( ( X - A ) / ( B - A ) ) ) ) )
  1 simp-8l |- ( ( ( ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ P e. CC ) /\ Q e. CC ) /\ X e. CC ) /\ A
      =/= B ) /\ ( A = B \/ ( ( Q - A ) / ( B - A ) ) e. RR ) ) /\ -. ( A = B \/ ( ( X - A ) / ( B
      - A ) ) e. RR ) ) /\ ( P =/= X /\ ( ( Q - X ) / ( P - X ) ) e. RR /\ ( ( Q - X ) / ( P - X )
      ) < 0 ) ) -> A e. CC )
  2 simp-8r |- ( ( ( ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ P e. CC ) /\ Q e. CC ) /\ X e. CC ) /\ A
      =/= B ) /\ ( A = B \/ ( ( Q - A ) / ( B - A ) ) e. RR ) ) /\ -. ( A = B \/ ( ( X - A ) / ( B
      - A ) ) e. RR ) ) /\ ( P =/= X /\ ( ( Q - X ) / ( P - X ) ) e. RR /\ ( ( Q - X ) / ( P - X )
      ) < 0 ) ) -> B e. CC )
  3 simp-7r |- ( ( ( ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ P e. CC ) /\ Q e. CC ) /\ X e. CC ) /\ A
      =/= B ) /\ ( A = B \/ ( ( Q - A ) / ( B - A ) ) e. RR ) ) /\ -. ( A = B \/ ( ( X - A ) / ( B
      - A ) ) e. RR ) ) /\ ( P =/= X /\ ( ( Q - X ) / ( P - X ) ) e. RR /\ ( ( Q - X ) / ( P - X )
      ) < 0 ) ) -> P e. CC )
  4 simp-6r |- ( ( ( ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ P e. CC ) /\ Q e. CC ) /\ X e. CC ) /\ A
      =/= B ) /\ ( A = B \/ ( ( Q - A ) / ( B - A ) ) e. RR ) ) /\ -. ( A = B \/ ( ( X - A ) / ( B
      - A ) ) e. RR ) ) /\ ( P =/= X /\ ( ( Q - X ) / ( P - X ) ) e. RR /\ ( ( Q - X ) / ( P - X )
      ) < 0 ) ) -> Q e. CC )
  5 simp-5r |- ( ( ( ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ P e. CC ) /\ Q e. CC ) /\ X e. CC ) /\ A
      =/= B ) /\ ( A = B \/ ( ( Q - A ) / ( B - A ) ) e. RR ) ) /\ -. ( A = B \/ ( ( X - A ) / ( B
      - A ) ) e. RR ) ) /\ ( P =/= X /\ ( ( Q - X ) / ( P - X ) ) e. RR /\ ( ( Q - X ) / ( P - X )
      ) < 0 ) ) -> X e. CC )
  6 simp-4r |- ( ( ( ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ P e. CC ) /\ Q e. CC ) /\ X e. CC ) /\ A
      =/= B ) /\ ( A = B \/ ( ( Q - A ) / ( B - A ) ) e. RR ) ) /\ -. ( A = B \/ ( ( X - A ) / ( B
      - A ) ) e. RR ) ) /\ ( P =/= X /\ ( ( Q - X ) / ( P - X ) ) e. RR /\ ( ( Q - X ) / ( P - X )
      ) < 0 ) ) -> A =/= B )
  7 simpllr |- ( ( ( ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ P e. CC ) /\ Q e. CC ) /\ X e. CC ) /\ A
      =/= B ) /\ ( A = B \/ ( ( Q - A ) / ( B - A ) ) e. RR ) ) /\ -. ( A = B \/ ( ( X - A ) / ( B
      - A ) ) e. RR ) ) /\ ( P =/= X /\ ( ( Q - X ) / ( P - X ) ) e. RR /\ ( ( Q - X ) / ( P - X )
      ) < 0 ) ) -> ( A = B \/ ( ( Q - A ) / ( B - A ) ) e. RR ) )
  8 simplr |- ( ( ( ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ P e. CC ) /\ Q e. CC ) /\ X e. CC ) /\ A
      =/= B ) /\ ( A = B \/ ( ( Q - A ) / ( B - A ) ) e. RR ) ) /\ -. ( A = B \/ ( ( X - A ) / ( B
      - A ) ) e. RR ) ) /\ ( P =/= X /\ ( ( Q - X ) / ( P - X ) ) e. RR /\ ( ( Q - X ) / ( P - X )
      ) < 0 ) ) -> -. ( A = B \/ ( ( X - A ) / ( B - A ) ) e. RR ) )
  9 simpr |- ( ( ( ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ P e. CC ) /\ Q e. CC ) /\ X e. CC ) /\ A =/=
      B ) /\ ( A = B \/ ( ( Q - A ) / ( B - A ) ) e. RR ) ) /\ -. ( A = B \/ ( ( X - A ) / ( B - A
      ) ) e. RR ) ) /\ ( P =/= X /\ ( ( Q - X ) / ( P - X ) ) e. RR /\ ( ( Q - X ) / ( P - X ) ) <
      0 ) ) -> ( P =/= X /\ ( ( Q - X ) / ( P - X ) ) e. RR /\ ( ( Q - X ) / ( P - X ) ) < 0 ) )
  10 gsegbeyd 1 2 3 4 5 6 7 8 9 |- ( ( ( ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ P e. CC ) /\ Q e. CC )
      /\ X e. CC ) /\ A =/= B ) /\ ( A = B \/ ( ( Q - A ) / ( B - A ) ) e. RR ) ) /\ -. ( A = B \/
      ( ( X - A ) / ( B - A ) ) e. RR ) ) /\ ( P =/= X /\ ( ( Q - X ) / ( P - X ) ) e. RR /\ ( ( Q
      - X ) / ( P - X ) ) < 0 ) ) -> 0 < ( ( Im ` ( ( P - A ) / ( B - A ) ) ) x. ( Im ` ( ( X - A )
      / ( B - A ) ) ) ) )


# A point P with P = A is on line AB: its place along the way from A to
# B is 0 when A and B differ.
lemma gonfst
  hypothesis gonfst.1 |- ( ph -> A e. CC )
  hypothesis gonfst.2 |- ( ph -> B e. CC )
  hypothesis gonfst.3 |- ( ph -> P = A )
  |- ( ph -> ( A = B \/ ( ( P - A ) / ( B - A ) ) e. RR ) )
  1 adantr gonfst.3 |- ( ( ph /\ -. A = B ) -> P = A )
  2 oveq1d 1 |- ( ( ph /\ -. A = B ) -> ( P - A ) = ( A - A ) )
  3 adantr gonfst.1 |- ( ( ph /\ -. A = B ) -> A e. CC )
  4 subidd 3 |- ( ( ph /\ -. A = B ) -> ( A - A ) = 0 )
  5 eqtrd 2 4 |- ( ( ph /\ -. A = B ) -> ( P - A ) = 0 )
  6 oveq1d 5 |- ( ( ph /\ -. A = B ) -> ( ( P - A ) / ( B - A ) ) = ( 0 / ( B - A ) ) )
  7 adantr gonfst.2 |- ( ( ph /\ -. A = B ) -> B e. CC )
  8 subcld 7 3 |- ( ( ph /\ -. A = B ) -> ( B - A ) e. CC )
  9 simpr |- ( ( ph /\ -. A = B ) -> -. A = B )
  10 neqned 9 |- ( ( ph /\ -. A = B ) -> A =/= B )
  11 necomd 10 |- ( ( ph /\ -. A = B ) -> B =/= A )
  12 subne0d 7 3 11 |- ( ( ph /\ -. A = B ) -> ( B - A ) =/= 0 )
  13 div0d 8 12 |- ( ( ph /\ -. A = B ) -> ( 0 / ( B - A ) ) = 0 )
  14 eqtrd 6 13 |- ( ( ph /\ -. A = B ) -> ( ( P - A ) / ( B - A ) ) = 0 )
  15 0red |- ( ( ph /\ -. A = B ) -> 0 e. RR )
  16 eqeltrd 14 15 |- ( ( ph /\ -. A = B ) -> ( ( P - A ) / ( B - A ) ) e. RR )
  17 ex 16 |- ( ph -> ( -. A = B -> ( ( P - A ) / ( B - A ) ) e. RR ) )
  18 orrd 17 |- ( ph -> ( A = B \/ ( ( P - A ) / ( B - A ) ) e. RR ) )

# A point P with P = B is on line AB: its place is 1 when A and B differ.
lemma gonsnd
  hypothesis gonsnd.1 |- ( ph -> A e. CC )
  hypothesis gonsnd.2 |- ( ph -> B e. CC )
  hypothesis gonsnd.3 |- ( ph -> P = B )
  |- ( ph -> ( A = B \/ ( ( P - A ) / ( B - A ) ) e. RR ) )
  1 adantr gonsnd.3 |- ( ( ph /\ -. A = B ) -> P = B )
  2 oveq1d 1 |- ( ( ph /\ -. A = B ) -> ( P - A ) = ( B - A ) )
  3 oveq1d 2 |- ( ( ph /\ -. A = B ) -> ( ( P - A ) / ( B - A ) ) = ( ( B - A ) / ( B - A ) ) )
  4 adantr gonsnd.1 |- ( ( ph /\ -. A = B ) -> A e. CC )
  5 adantr gonsnd.2 |- ( ( ph /\ -. A = B ) -> B e. CC )
  6 subcld 5 4 |- ( ( ph /\ -. A = B ) -> ( B - A ) e. CC )
  7 simpr |- ( ( ph /\ -. A = B ) -> -. A = B )
  8 neqned 7 |- ( ( ph /\ -. A = B ) -> A =/= B )
  9 necomd 8 |- ( ( ph /\ -. A = B ) -> B =/= A )
  10 subne0d 5 4 9 |- ( ( ph /\ -. A = B ) -> ( B - A ) =/= 0 )
  11 dividd 6 10 |- ( ( ph /\ -. A = B ) -> ( ( B - A ) / ( B - A ) ) = 1 )
  12 eqtrd 3 11 |- ( ( ph /\ -. A = B ) -> ( ( P - A ) / ( B - A ) ) = 1 )
  13 1red |- ( ( ph /\ -. A = B ) -> 1 e. RR )
  14 eqeltrd 12 13 |- ( ( ph /\ -. A = B ) -> ( ( P - A ) / ( B - A ) ) e. RR )
  15 ex 14 |- ( ph -> ( -. A = B -> ( ( P - A ) / ( B - A ) ) e. RR ) )
  16 orrd 15 |- ( ph -> ( A = B \/ ( ( P - A ) / ( B - A ) ) e. RR ) )

# A point off line AB is neither A nor B.
lemma goffapart
  |- ( ( ( ( A e. CC /\ B e. CC ) /\ P e. CC ) /\ -. ( A = B \/ ( ( P - A ) / ( B - A ) ) e. RR ) )
      -> ( P =/= A /\ P =/= B ) )
  1 simplll |- ( ( ( ( A e. CC /\ B e. CC ) /\ P e. CC ) /\ -. ( A = B \/ ( ( P - A ) / ( B - A ) )
      e. RR ) ) -> A e. CC )
  2 simpllr |- ( ( ( ( A e. CC /\ B e. CC ) /\ P e. CC ) /\ -. ( A = B \/ ( ( P - A ) / ( B - A ) )
      e. RR ) ) -> B e. CC )
  3 simpr |- ( ( ( ( A e. CC /\ B e. CC ) /\ P e. CC ) /\ -. ( A = B \/ ( ( P - A ) / ( B - A ) )
      e. RR ) ) -> -. ( A = B \/ ( ( P - A ) / ( B - A ) ) e. RR ) )
  4 adantr 1 |- ( ( ( ( ( A e. CC /\ B e. CC ) /\ P e. CC ) /\ -. ( A = B \/ ( ( P - A ) / ( B - A
      ) ) e. RR ) ) /\ P = A ) -> A e. CC )
  5 adantr 2 |- ( ( ( ( ( A e. CC /\ B e. CC ) /\ P e. CC ) /\ -. ( A = B \/ ( ( P - A ) / ( B - A
      ) ) e. RR ) ) /\ P = A ) -> B e. CC )
  6 simpr |- ( ( ( ( ( A e. CC /\ B e. CC ) /\ P e. CC ) /\ -. ( A = B \/ ( ( P - A ) / ( B - A ) )
      e. RR ) ) /\ P = A ) -> P = A )
  7 gonfst 4 5 6 |- ( ( ( ( ( A e. CC /\ B e. CC ) /\ P e. CC ) /\ -. ( A = B \/ ( ( P - A ) / ( B
      - A ) ) e. RR ) ) /\ P = A ) -> ( A = B \/ ( ( P - A ) / ( B - A ) ) e. RR ) )
  8 adantr 3 |- ( ( ( ( ( A e. CC /\ B e. CC ) /\ P e. CC ) /\ -. ( A = B \/ ( ( P - A ) / ( B - A
