# SMSG's postulate 4, ruler placement: a ruler on line AB with A at 0 and
# B on the positive side.
lemma grulerplace
  |- ( A e. CC -> ( B e. CC -> ( A =/= B -> E. f e. ( RR ^m { u e. CC | ( A = B \/ ( ( u - A ) / (
      B - A ) ) e. RR ) } ) ( ( ( f : { u e. CC | ( A = B \/ ( ( u - A ) / ( B - A ) ) e. RR ) }
      -1-1-onto-> RR /\ ( f ` A ) = 0 ) /\ 0 < ( f ` B ) ) /\ A. x e. { u e. CC | ( A = B \/ ( ( u
      - A ) / ( B - A ) ) e. RR ) } A. y e. { u e. CC | ( A = B \/ ( ( u - A ) / ( B - A ) ) e. RR
      ) } ( abs ` ( x - y ) ) = ( abs ` ( ( f ` x ) - ( f ` y ) ) ) ) ) ) )
  1 eqid |- { u e. CC | ( A = B \/ ( ( u - A ) / ( B - A ) ) e. RR ) } = { u e. CC | ( A = B \/ ( (
      u - A ) / ( B - A ) ) e. RR ) }
  2 eqid |- ( w e. { u e. CC | ( A = B \/ ( ( u - A ) / ( B - A ) ) e. RR ) } |-> ( ( ( w - A ) / (
      B - A ) ) x. ( abs ` ( B - A ) ) ) ) = ( w e. { u e. CC | ( A = B \/ ( ( u - A ) / ( B - A )
      ) e. RR ) } |-> ( ( ( w - A ) / ( B - A ) ) x. ( abs ` ( B - A ) ) ) )
  3 grulerplh 1 2 |- ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) -> E. f e. ( RR ^m { u e. CC | ( A = B
      \/ ( ( u - A ) / ( B - A ) ) e. RR ) } ) ( ( ( f : { u e. CC | ( A = B \/ ( ( u - A ) / ( B -
      A ) ) e. RR ) } -1-1-onto-> RR /\ ( f ` A ) = 0 ) /\ 0 < ( f ` B ) ) /\ A. x e. { u e. CC | (
      A = B \/ ( ( u - A ) / ( B - A ) ) e. RR ) } A. y e. { u e. CC | ( A = B \/ ( ( u - A ) / ( B
      - A ) ) e. RR ) } ( abs ` ( x - y ) ) = ( abs ` ( ( f ` x ) - ( f ` y ) ) ) ) )
  4 exp31 3 |- ( A e. CC -> ( B e. CC -> ( A =/= B -> E. f e. ( RR ^m { u e. CC | ( A = B \/ ( ( u
      - A ) / ( B - A ) ) e. RR ) } ) ( ( ( f : { u e. CC | ( A = B \/ ( ( u - A ) / ( B - A ) ) e.
      RR ) } -1-1-onto-> RR /\ ( f ` A ) = 0 ) /\ 0 < ( f ` B ) ) /\ A. x e. { u e. CC | ( A = B \/
      ( ( u - A ) / ( B - A ) ) e. RR ) } A. y e. { u e. CC | ( A = B \/ ( ( u - A ) / ( B - A ) )
      e. RR ) } ( abs ` ( x - y ) ) = ( abs ` ( ( f ` x ) - ( f ` y ) ) ) ) ) ) )

# SMSG's postulate 3, the ruler: the points of line AB are paired with the
# real numbers so that a distance is a difference of coordinates.
lemma gruler
  |- ( A e. CC -> ( B e. CC -> ( A =/= B -> E. f e. ( RR ^m { u e. CC | ( A = B \/ ( ( u - A ) / (
      B - A ) ) e. RR ) } ) ( f : { u e. CC | ( A = B \/ ( ( u - A ) / ( B - A ) ) e. RR ) }
      -1-1-onto-> RR /\ A. x e. { u e. CC | ( A = B \/ ( ( u - A ) / ( B - A ) ) e. RR ) } A. y e.
      { u e. CC | ( A = B \/ ( ( u - A ) / ( B - A ) ) e. RR ) } ( abs ` ( x - y ) ) = ( abs ` ( (
      f ` x ) - ( f ` y ) ) ) ) ) ) )
  1 eqid |- { u e. CC | ( A = B \/ ( ( u - A ) / ( B - A ) ) e. RR ) } = { u e. CC | ( A = B \/ ( (
      u - A ) / ( B - A ) ) e. RR ) }
  2 eqid |- ( w e. { u e. CC | ( A = B \/ ( ( u - A ) / ( B - A ) ) e. RR ) } |-> ( ( ( w - A ) / (
      B - A ) ) x. ( abs ` ( B - A ) ) ) ) = ( w e. { u e. CC | ( A = B \/ ( ( u - A ) / ( B - A )
      ) e. RR ) } |-> ( ( ( w - A ) / ( B - A ) ) x. ( abs ` ( B - A ) ) ) )
  3 grulerh 1 2 |- ( ( ( A e. CC /\ B e. CC ) /\ A =/= B ) -> E. f e. ( RR ^m { u e. CC | ( A = B
      \/ ( ( u - A ) / ( B - A ) ) e. RR ) } ) ( f : { u e. CC | ( A = B \/ ( ( u - A ) / ( B - A )
      ) e. RR ) } -1-1-onto-> RR /\ A. x e. { u e. CC | ( A = B \/ ( ( u - A ) / ( B - A ) ) e. RR
      ) } A. y e. { u e. CC | ( A = B \/ ( ( u - A ) / ( B - A ) ) e. RR ) } ( abs ` ( x - y ) ) =
      ( abs ` ( ( f ` x ) - ( f ` y ) ) ) ) )
  4 exp31 3 |- ( A e. CC -> ( B e. CC -> ( A =/= B -> E. f e. ( RR ^m { u e. CC | ( A = B \/ ( ( u
      - A ) / ( B - A ) ) e. RR ) } ) ( f : { u e. CC | ( A = B \/ ( ( u - A ) / ( B - A ) ) e. RR
      ) } -1-1-onto-> RR /\ A. x e. { u e. CC | ( A = B \/ ( ( u - A ) / ( B - A ) ) e. RR ) } A. y
      e. { u e. CC | ( A = B \/ ( ( u - A ) / ( B - A ) ) e. RR ) } ( abs ` ( x - y ) ) = ( abs ` (
      ( f ` x ) - ( f ` y ) ) ) ) ) ) )

# Between two distinct reals S and T, a number is real just where its
# place along the way from S to T is.
lemma grealaff
  hypothesis grealaff.1 |- ( ph -> Z e. CC )
  hypothesis grealaff.2 |- ( ph -> S e. RR )
  hypothesis grealaff.3 |- ( ph -> T e. RR )
  hypothesis grealaff.4 |- ( ph -> S =/= T )
  |- ( ph -> ( ( ( Z - S ) / ( T - S ) ) e. RR <-> Z e. RR ) )
  1 recnd grealaff.2 |- ( ph -> S e. CC )
  2 recnd grealaff.3 |- ( ph -> T e. CC )
  3 necomd grealaff.4 |- ( ph -> T =/= S )
  4 subne0d 2 1 3 |- ( ph -> ( T - S ) =/= 0 )
  5 subcld 2 1 |- ( ph -> ( T - S ) e. CC )
  6 resubcld grealaff.3 grealaff.2 |- ( ph -> ( T - S ) e. RR )
  7 simpr |- ( ( ph /\ Z e. RR ) -> Z e. RR )
  8 adantr grealaff.2 |- ( ( ph /\ Z e. RR ) -> S e. RR )
  9 resubcld 7 8 |- ( ( ph /\ Z e. RR ) -> ( Z - S ) e. RR )
  10 adantr 6 |- ( ( ph /\ Z e. RR ) -> ( T - S ) e. RR )
  11 adantr 4 |- ( ( ph /\ Z e. RR ) -> ( T - S ) =/= 0 )
  12 redivcld 9 10 11 |- ( ( ph /\ Z e. RR ) -> ( ( Z - S ) / ( T - S ) ) e. RR )
  13 ex 12 |- ( ph -> ( Z e. RR -> ( ( Z - S ) / ( T - S ) ) e. RR ) )
  14 simpr |- ( ( ph /\ ( ( Z - S ) / ( T - S ) ) e. RR ) -> ( ( Z - S ) / ( T - S ) ) e. RR )
  15 adantr 6 |- ( ( ph /\ ( ( Z - S ) / ( T - S ) ) e. RR ) -> ( T - S ) e. RR )
  16 remulcld 14 15 |- ( ( ph /\ ( ( Z - S ) / ( T - S ) ) e. RR ) -> ( ( ( Z - S ) / ( T - S ) )
      x. ( T - S ) ) e. RR )
  17 adantr grealaff.2 |- ( ( ph /\ ( ( Z - S ) / ( T - S ) ) e. RR ) -> S e. RR )
  18 readdcld 16 17 |- ( ( ph /\ ( ( Z - S ) / ( T - S ) ) e. RR ) -> ( ( ( ( Z - S ) / ( T - S ) )
      x. ( T - S ) ) + S ) e. RR )
  19 subcld grealaff.1 1 |- ( ph -> ( Z - S ) e. CC )
  20 divcan1d 19 5 4 |- ( ph -> ( ( ( Z - S ) / ( T - S ) ) x. ( T - S ) ) = ( Z - S ) )
  21 oveq1d 20 |- ( ph -> ( ( ( ( Z - S ) / ( T - S ) ) x. ( T - S ) ) + S ) = ( ( Z - S ) + S ) )
  22 npcand grealaff.1 1 |- ( ph -> ( ( Z - S ) + S ) = Z )
  23 eqtrd 21 22 |- ( ph -> ( ( ( ( Z - S ) / ( T - S ) ) x. ( T - S ) ) + S ) = Z )
  24 adantr 23 |- ( ( ph /\ ( ( Z - S ) / ( T - S ) ) e. RR ) -> ( ( ( ( Z - S ) / ( T - S ) ) x. (
      T - S ) ) + S ) = Z )
  25 eqeltrrd 24 18 |- ( ( ph /\ ( ( Z - S ) / ( T - S ) ) e. RR ) -> Z e. RR )
  26 ex 25 |- ( ph -> ( ( ( Z - S ) / ( T - S ) ) e. RR -> Z e. RR ) )
  27 impbid 26 13 |- ( ph -> ( ( ( Z - S ) / ( T - S ) ) e. RR <-> Z e. RR ) )

# A point's place along line AB, read from its place along line CD when A
# and B are points of CD: the two places differ by a real affine change.
lemma glinequot
  hypothesis glinequot.1 |- ( ph -> U e. CC )
  hypothesis glinequot.2 |- ( ph -> A e. CC )
  hypothesis glinequot.3 |- ( ph -> B e. CC )
  hypothesis glinequot.4 |- ( ph -> C e. CC )
  hypothesis glinequot.5 |- ( ph -> D e. CC )
  hypothesis glinequot.6 |- ( ph -> A =/= B )
  hypothesis glinequot.7 |- ( ph -> C =/= D )
  |- ( ph -> ( ( ( ( U - C ) / ( D - C ) ) - ( ( A - C ) / ( D - C ) ) ) / ( ( ( B - C ) / ( D - C
      ) ) - ( ( A - C ) / ( D - C ) ) ) ) = ( ( U - A ) / ( B - A ) ) )
  1 subcld glinequot.5 glinequot.4 |- ( ph -> ( D - C ) e. CC )
  2 necomd glinequot.7 |- ( ph -> D =/= C )
  3 subne0d glinequot.5 glinequot.4 2 |- ( ph -> ( D - C ) =/= 0 )
  4 subcld glinequot.1 glinequot.4 |- ( ph -> ( U - C ) e. CC )
  5 subcld glinequot.2 glinequot.4 |- ( ph -> ( A - C ) e. CC )
  6 subcld glinequot.3 glinequot.4 |- ( ph -> ( B - C ) e. CC )
  7 divsubdird 4 5 1 3 |- ( ph -> ( ( ( U - C ) - ( A - C ) ) / ( D - C ) ) = ( ( ( U - C ) / ( D -
      C ) ) - ( ( A - C ) / ( D - C ) ) ) )
  8 nnncan2d glinequot.1 glinequot.2 glinequot.4 |- ( ph -> ( ( U - C ) - ( A - C ) ) = ( U - A ) )
  9 oveq1d 8 |- ( ph -> ( ( ( U - C ) - ( A - C ) ) / ( D - C ) ) = ( ( U - A ) / ( D - C ) ) )
  10 eqtr3d 7 9 |- ( ph -> ( ( ( U - C ) / ( D - C ) ) - ( ( A - C ) / ( D - C ) ) ) = ( ( U - A )
      / ( D - C ) ) )
  11 divsubdird 6 5 1 3 |- ( ph -> ( ( ( B - C ) - ( A - C ) ) / ( D - C ) ) = ( ( ( B - C ) / ( D
      - C ) ) - ( ( A - C ) / ( D - C ) ) ) )
  12 nnncan2d glinequot.3 glinequot.2 glinequot.4 |- ( ph -> ( ( B - C ) - ( A - C ) ) = ( B - A ) )
  13 oveq1d 12 |- ( ph -> ( ( ( B - C ) - ( A - C ) ) / ( D - C ) ) = ( ( B - A ) / ( D - C ) ) )
  14 eqtr3d 11 13 |- ( ph -> ( ( ( B - C ) / ( D - C ) ) - ( ( A - C ) / ( D - C ) ) ) = ( ( B - A
      ) / ( D - C ) ) )
  15 oveq12d 10 14 |- ( ph -> ( ( ( ( U - C ) / ( D - C ) ) - ( ( A - C ) / ( D - C ) ) ) / ( ( ( B
      - C ) / ( D - C ) ) - ( ( A - C ) / ( D - C ) ) ) ) = ( ( ( U - A ) / ( D - C ) ) / ( ( B - A
      ) / ( D - C ) ) ) )
  16 subcld glinequot.1 glinequot.2 |- ( ph -> ( U - A ) e. CC )
  17 subcld glinequot.3 glinequot.2 |- ( ph -> ( B - A ) e. CC )
  18 necomd glinequot.6 |- ( ph -> B =/= A )
  19 subne0d glinequot.3 glinequot.2 18 |- ( ph -> ( B - A ) =/= 0 )
  20 divcan7d 16 17 1 19 3 |- ( ph -> ( ( ( U - A ) / ( D - C ) ) / ( ( B - A ) / ( D - C ) ) ) = (
      ( U - A ) / ( B - A ) ) )
  21 eqtrd 15 20 |- ( ph -> ( ( ( ( U - C ) / ( D - C ) ) - ( ( A - C ) / ( D - C ) ) ) / ( ( ( B -
      C ) / ( D - C ) ) - ( ( A - C ) / ( D - C ) ) ) ) = ( ( U - A ) / ( B - A ) ) )

# Two distinct points of line CD make line CD again.
lemma glineud
  hypothesis glineud.1 |- ( ph -> A e. CC )
  hypothesis glineud.2 |- ( ph -> B e. CC )
  hypothesis glineud.3 |- ( ph -> C e. CC )
  hypothesis glineud.4 |- ( ph -> D e. CC )
  hypothesis glineud.5 |- ( ph -> A =/= B )
  hypothesis glineud.6 |- ( ph -> C =/= D )
  hypothesis glineud.7 |- ( ph -> ( C = D \/ ( ( A - C ) / ( D - C ) ) e. RR ) )
  hypothesis glineud.8 |- ( ph -> ( C = D \/ ( ( B - C ) / ( D - C ) ) e. RR ) )
  |- ( ph -> { u e. CC | ( A = B \/ ( ( u - A ) / ( B - A ) ) e. RR ) } = { u e. CC | ( C = D \/ (
      ( u - C ) / ( D - C ) ) e. RR ) } )
