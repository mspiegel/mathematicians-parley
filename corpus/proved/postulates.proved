# X between P and Q, with Q on line AB and X off it: the sign of X is the
# sign of P, since Im of the place along AB scales by the real (Q-X)/(P-X).
lemma gsegbeyd
  hypothesis gsegbeyd.1 |- ( ph -> A e. CC )
  hypothesis gsegbeyd.2 |- ( ph -> B e. CC )
  hypothesis gsegbeyd.3 |- ( ph -> P e. CC )
