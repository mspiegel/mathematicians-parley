      R ) ) = ( ( ( X - R ) / ( S - R ) ) x. ( ( S - R ) / ( P - R ) ) ) )
  21 subcld gofflinethrud.4 gofflinethrud.1 |- ( ph -> ( X - R ) e. CC )
  22 subcld gofflinethrud.3 gofflinethrud.1 |- ( ph -> ( S - R ) e. CC )
  23 subne0d gofflinethrud.4 gofflinethrud.1 gofflinethrud.7 |- ( ph -> ( X - R ) =/= 0 )
  24 subne0d gofflinethrud.3 gofflinethrud.1 15 |- ( ph -> ( S - R ) =/= 0 )
  25 divne0d 21 22 23 24 |- ( ph -> ( ( X - R ) / ( S - R ) ) =/= 0 )
  26 simpr |- ( ( ph /\ ( R = P \/ ( ( X - R ) / ( P - R ) ) e. RR ) ) -> ( R = P \/ ( ( X - R ) /
      ( P - R ) ) e. RR ) )
  27 adantr 3 |- ( ( ph /\ ( R = P \/ ( ( X - R ) / ( P - R ) ) e. RR ) ) -> -. R = P )
  28 orel1 |- ( -. R = P -> ( ( R = P \/ ( ( X - R ) / ( P - R ) ) e. RR ) -> ( ( X - R ) / ( P - R
      ) ) e. RR ) )
  29 sylc 27 26 28 |- ( ( ph /\ ( R = P \/ ( ( X - R ) / ( P - R ) ) e. RR ) ) -> ( ( X - R ) / ( P
      - R ) ) e. RR )
  30 adantr 19 |- ( ( ph /\ ( R = P \/ ( ( X - R ) / ( P - R ) ) e. RR ) ) -> ( ( X - R ) / ( S - R
