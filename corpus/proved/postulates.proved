      ) ) ) -> E. x e. CC ( ( A =/= x /\ ( ( B - x ) / ( A - x ) ) e. RR /\ ( ( B - x ) / ( A - x )
      ) < 0 ) /\ ( abs ` ( A - x ) ) = K ) )

# Q off line RP makes P off line RQ: Q is not R, and P's place along RQ
# is the reciprocal of Q's place along RP, real only when that one is.
lemma goffswapd
  hypothesis goffswapd.1 |- ( ph -> R e. CC )
  hypothesis goffswapd.2 |- ( ph -> P e. CC )
  hypothesis goffswapd.3 |- ( ph -> Q e. CC )
  hypothesis goffswapd.4 |- ( ph -> -. ( R = P \/ ( ( Q - R ) / ( P - R ) ) e. RR ) )
  |- ( ph -> -. ( R = Q \/ ( ( P - R ) / ( Q - R ) ) e. RR ) )
  1 orc |- ( R = P -> ( R = P \/ ( ( Q - R ) / ( P - R ) ) e. RR ) )
  2 nsyl goffswapd.4 1 |- ( ph -> -. R = P )
  3 olc |- ( ( ( Q - R ) / ( P - R ) ) e. RR -> ( R = P \/ ( ( Q - R ) / ( P - R ) ) e. RR ) )
  4 nsyl goffswapd.4 3 |- ( ph -> -. ( ( Q - R ) / ( P - R ) ) e. RR )
