# A and B are on line AB.
lemma gonends
  |- ( ( A e. CC /\ B e. CC ) -> ( ( A = B \/ ( ( A - A ) / ( B - A ) ) e. RR ) /\ ( A = B \/ ( ( B
      - A ) / ( B - A ) ) e. RR ) ) )
