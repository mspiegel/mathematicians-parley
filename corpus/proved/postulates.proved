  5 orel1 |- ( -. C = D -> ( ( C = D \/ ( ( B - C ) / ( D - C ) ) e. RR ) -> ( ( B - C ) / ( D - C
      ) ) e. RR ) )
  6 sylc 2 glineud.8 5 |- ( ph -> ( ( B - C ) / ( D - C ) ) e. RR )
  7 subcld glineud.4 glineud.3 |- ( ph -> ( D - C ) e. CC )
  8 necomd glineud.6 |- ( ph -> D =/= C )
  9 subne0d glineud.4 glineud.3 8 |- ( ph -> ( D - C ) =/= 0 )
  10 subcld glineud.1 glineud.3 |- ( ph -> ( A - C ) e. CC )
  11 subcld glineud.2 glineud.3 |- ( ph -> ( B - C ) e. CC )
  12 subne0d glineud.1 glineud.2 glineud.5 |- ( ph -> ( A - B ) =/= 0 )
  13 nnncan2d glineud.1 glineud.2 glineud.3 |- ( ph -> ( ( A - C ) - ( B - C ) ) = ( A - B ) )
  14 divsubdird 10 11 7 9 |- ( ph -> ( ( ( A - C ) - ( B - C ) ) / ( D - C ) ) = ( ( ( A - C ) / (
      D - C ) ) - ( ( B - C ) / ( D - C ) ) ) )
  15 oveq1d 13 |- ( ph -> ( ( ( A - C ) - ( B - C ) ) / ( D - C ) ) = ( ( A - B ) / ( D - C ) ) )
  16 eqtr3d 14 15 |- ( ph -> ( ( ( A - C ) / ( D - C ) ) - ( ( B - C ) / ( D - C ) ) ) = ( ( A - B
      ) / ( D - C ) ) )
  17 subcld glineud.1 glineud.2 |- ( ph -> ( A - B ) e. CC )
  18 divne0d 17 7 12 9 |- ( ph -> ( ( A - B ) / ( D - C ) ) =/= 0 )
  19 eqnetrd 16 18 |- ( ph -> ( ( ( A - C ) / ( D - C ) ) - ( ( B - C ) / ( D - C ) ) ) =/= 0 )
  20 recnd 4 |- ( ph -> ( ( A - C ) / ( D - C ) ) e. CC )
  21 recnd 6 |- ( ph -> ( ( B - C ) / ( D - C ) ) e. CC )
  22 subne0ad 20 21 19 |- ( ph -> ( ( A - C ) / ( D - C ) ) =/= ( ( B - C ) / ( D - C ) ) )
  23 simpr |- ( ( ph /\ u e. CC ) -> u e. CC )
  24 adantr glineud.3 |- ( ( ph /\ u e. CC ) -> C e. CC )
  25 subcld 23 24 |- ( ( ph /\ u e. CC ) -> ( u - C ) e. CC )
  26 adantr 7 |- ( ( ph /\ u e. CC ) -> ( D - C ) e. CC )
