# A length shorter than a segment, laid off along it from one end, ends
# at a point between the segment's ends.
lemma gsegpt
  |- ( ( ( ( ( A e. CC /\ B e. CC ) /\ K e. RR ) /\ 0 < K ) /\ K < ( abs ` ( A - B ) ) ) -> E. x e.
      CC ( ( A =/= x /\ ( ( B - x ) / ( A - x ) ) e. RR /\ ( ( B - x ) / ( A - x ) ) < 0 ) /\ ( abs
      ` ( A - x ) ) = K ) )
  1 simp-4l |- ( ( ( ( ( A e. CC /\ B e. CC ) /\ K e. RR ) /\ 0 < K ) /\ K < ( abs ` ( A - B ) ) )
      -> A e. CC )
  2 simp-4r |- ( ( ( ( ( A e. CC /\ B e. CC ) /\ K e. RR ) /\ 0 < K ) /\ K < ( abs ` ( A - B ) ) )
      -> B e. CC )
  3 simpllr |- ( ( ( ( ( A e. CC /\ B e. CC ) /\ K e. RR ) /\ 0 < K ) /\ K < ( abs ` ( A - B ) ) )
      -> K e. RR )
  4 simplr |- ( ( ( ( ( A e. CC /\ B e. CC ) /\ K e. RR ) /\ 0 < K ) /\ K < ( abs ` ( A - B ) ) )
      -> 0 < K )
  5 simpr |- ( ( ( ( ( A e. CC /\ B e. CC ) /\ K e. RR ) /\ 0 < K ) /\ K < ( abs ` ( A - B ) ) ) ->
      K < ( abs ` ( A - B ) ) )
  6 adantr 1 |- ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ K e. RR ) /\ 0 < K ) /\ K < ( abs ` ( A - B ) )
      ) /\ x = ( A + ( ( K / ( abs ` ( B - A ) ) ) x. ( B - A ) ) ) ) -> A e. CC )
  7 adantr 2 |- ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ K e. RR ) /\ 0 < K ) /\ K < ( abs ` ( A - B ) )
      ) /\ x = ( A + ( ( K / ( abs ` ( B - A ) ) ) x. ( B - A ) ) ) ) -> B e. CC )
  8 adantr 3 |- ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ K e. RR ) /\ 0 < K ) /\ K < ( abs ` ( A - B ) )
      ) /\ x = ( A + ( ( K / ( abs ` ( B - A ) ) ) x. ( B - A ) ) ) ) -> K e. RR )
  9 adantr 4 |- ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ K e. RR ) /\ 0 < K ) /\ K < ( abs ` ( A - B ) )
      ) /\ x = ( A + ( ( K / ( abs ` ( B - A ) ) ) x. ( B - A ) ) ) ) -> 0 < K )
  10 adantr 5 |- ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ K e. RR ) /\ 0 < K ) /\ K < ( abs ` ( A - B )
      ) ) /\ x = ( A + ( ( K / ( abs ` ( B - A ) ) ) x. ( B - A ) ) ) ) -> K < ( abs ` ( A - B ) ) )
  11 simpr |- ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ K e. RR ) /\ 0 < K ) /\ K < ( abs ` ( A - B ) ) )
      /\ x = ( A + ( ( K / ( abs ` ( B - A ) ) ) x. ( B - A ) ) ) ) -> x = ( A + ( ( K / ( abs ` (
      B - A ) ) ) x. ( B - A ) ) ) )
  12 gsegptd 6 7 8 9 10 11 |- ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ K e. RR ) /\ 0 < K ) /\ K < ( abs
      ` ( A - B ) ) ) /\ x = ( A + ( ( K / ( abs ` ( B - A ) ) ) x. ( B - A ) ) ) ) -> ( ( A =/= x
      /\ ( ( B - x ) / ( A - x ) ) e. RR /\ ( ( B - x ) / ( A - x ) ) < 0 ) /\ ( abs ` ( A - x ) )
      = K ) )
  13 subcld 2 1 |- ( ( ( ( ( A e. CC /\ B e. CC ) /\ K e. RR ) /\ 0 < K ) /\ K < ( abs ` ( A - B )
      ) ) -> ( B - A ) e. CC )
  14 abscld 13 |- ( ( ( ( ( A e. CC /\ B e. CC ) /\ K e. RR ) /\ 0 < K ) /\ K < ( abs ` ( A - B ) )
      ) -> ( abs ` ( B - A ) ) e. RR )
  15 recnd 14 |- ( ( ( ( ( A e. CC /\ B e. CC ) /\ K e. RR ) /\ 0 < K ) /\ K < ( abs ` ( A - B ) )
      ) -> ( abs ` ( B - A ) ) e. CC )
  16 recnd 3 |- ( ( ( ( ( A e. CC /\ B e. CC ) /\ K e. RR ) /\ 0 < K ) /\ K < ( abs ` ( A - B ) ) )
      -> K e. CC )
