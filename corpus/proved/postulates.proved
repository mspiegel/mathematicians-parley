      /\ ( Q =/= D /\ ( ( R - D ) / ( Q - D ) ) e. RR /\ ( ( R - D ) / ( Q - D ) ) < 0 ) ) -> ( ( (
      1 / 2 ) x. ( ( abs ` ( Q - R ) ) x. ( abs ` ( P - R ) ) ) ) x. ( abs ` ( sin ` ( ( Q - R )
      ang ( P - R ) ) ) ) ) = ( ( ( ( 1 / 2 ) x. ( ( abs ` ( Q - D ) ) x. ( abs ` ( P - D ) ) ) )
      x. ( abs ` ( sin ` ( ( Q - D ) ang ( P - D ) ) ) ) ) + ( ( ( 1 / 2 ) x. ( ( abs ` ( D - R ) )
      x. ( abs ` ( P - R ) ) ) ) x. ( abs ` ( sin ` ( ( D - R ) ang ( P - R ) ) ) ) ) ) )

# The midpoint of AB is (A + B)/2: from it A and B lie the same way off,
# (A - B)/2, in opposite directions.
lemma gmidexd
  hypothesis gmidexd.1 |- ( ph -> A e. CC )
  hypothesis gmidexd.2 |- ( ph -> B e. CC )
  hypothesis gmidexd.3 |- ( ph -> A =/= B )
  hypothesis gmidexd.4 |- ( ph -> X = ( ( A + B ) / 2 ) )
  |- ( ph -> ( ( A =/= X /\ ( ( B - X ) / ( A - X ) ) e. RR /\ ( ( B - X ) / ( A - X ) ) < 0 ) /\ (
      abs ` ( A - X ) ) = ( abs ` ( X - B ) ) ) )
  1 addcld gmidexd.1 gmidexd.2 |- ( ph -> ( A + B ) e. CC )
  2 halfcld 1 |- ( ph -> ( ( A + B ) / 2 ) e. CC )
  3 eqeltrd gmidexd.4 2 |- ( ph -> X e. CC )
  4 subcld gmidexd.1 gmidexd.2 |- ( ph -> ( A - B ) e. CC )
  5 halfcld 4 |- ( ph -> ( ( A - B ) / 2 ) e. CC )
  6 halfaddsub |- ( ( A e. CC /\ B e. CC ) -> ( ( ( ( A + B ) / 2 ) + ( ( A - B ) / 2 ) ) = A /\ (
      ( ( A + B ) / 2 ) - ( ( A - B ) / 2 ) ) = B ) )
  7 syl2anc gmidexd.1 gmidexd.2 6 |- ( ph -> ( ( ( ( A + B ) / 2 ) + ( ( A - B ) / 2 ) ) = A /\ ( (
      ( A + B ) / 2 ) - ( ( A - B ) / 2 ) ) = B ) )
  8 simpld 7 |- ( ph -> ( ( ( A + B ) / 2 ) + ( ( A - B ) / 2 ) ) = A )
  9 simprd 7 |- ( ph -> ( ( ( A + B ) / 2 ) - ( ( A - B ) / 2 ) ) = B )
  10 oveq1d gmidexd.4 |- ( ph -> ( X + ( ( A - B ) / 2 ) ) = ( ( ( A + B ) / 2 ) + ( ( A - B ) / 2
      ) ) )
  11 eqtrd 10 8 |- ( ph -> ( X + ( ( A - B ) / 2 ) ) = A )
  12 oveq1d gmidexd.4 |- ( ph -> ( X - ( ( A - B ) / 2 ) ) = ( ( ( A + B ) / 2 ) - ( ( A - B ) / 2
      ) ) )
  13 eqtrd 12 9 |- ( ph -> ( X - ( ( A - B ) / 2 ) ) = B )
  14 subaddd gmidexd.1 3 5 |- ( ph -> ( ( A - X ) = ( ( A - B ) / 2 ) <-> ( X + ( ( A - B ) / 2 ) )
      = A ) )
  15 mpbird 11 14 |- ( ph -> ( A - X ) = ( ( A - B ) / 2 ) )
  16 subsub23d 3 gmidexd.2 5 |- ( ph -> ( ( X - B ) = ( ( A - B ) / 2 ) <-> ( X - ( ( A - B ) / 2 )
      ) = B ) )
  17 mpbird 13 16 |- ( ph -> ( X - B ) = ( ( A - B ) / 2 ) )
  18 eqtr4d 15 17 |- ( ph -> ( A - X ) = ( X - B ) )
  19 fveq2d 18 |- ( ph -> ( abs ` ( A - X ) ) = ( abs ` ( X - B ) ) )
  20 subne0d gmidexd.1 gmidexd.2 gmidexd.3 |- ( ph -> ( A - B ) =/= 0 )
  21 2cnd |- ( ph -> 2 e. CC )
  22 2ne0 |- 2 =/= 0
  23 a1i 22 |- ( ph -> 2 =/= 0 )
  24 divne0d 4 21 20 23 |- ( ph -> ( ( A - B ) / 2 ) =/= 0 )
  25 eqnetrd 15 24 |- ( ph -> ( A - X ) =/= 0 )
  26 subne0ad gmidexd.1 3 25 |- ( ph -> A =/= X )
  27 negsubdi2d 3 gmidexd.2 |- ( ph -> -u ( X - B ) = ( B - X ) )
  28 negeqd 17 |- ( ph -> -u ( X - B ) = -u ( ( A - B ) / 2 ) )
  29 eqtr3d 27 28 |- ( ph -> ( B - X ) = -u ( ( A - B ) / 2 ) )
  30 oveq12d 29 15 |- ( ph -> ( ( B - X ) / ( A - X ) ) = ( -u ( ( A - B ) / 2 ) / ( ( A - B ) / 2
      ) ) )
  31 divnegd 5 5 24 |- ( ph -> -u ( ( ( A - B ) / 2 ) / ( ( A - B ) / 2 ) ) = ( -u ( ( A - B ) / 2
      ) / ( ( A - B ) / 2 ) ) )
  32 dividd 5 24 |- ( ph -> ( ( ( A - B ) / 2 ) / ( ( A - B ) / 2 ) ) = 1 )
  33 negeqd 32 |- ( ph -> -u ( ( ( A - B ) / 2 ) / ( ( A - B ) / 2 ) ) = -u 1 )
  34 eqtr3d 31 33 |- ( ph -> ( -u ( ( A - B ) / 2 ) / ( ( A - B ) / 2 ) ) = -u 1 )
  35 eqtrd 30 34 |- ( ph -> ( ( B - X ) / ( A - X ) ) = -u 1 )
  36 neg1rr |- -u 1 e. RR
  37 a1i 36 |- ( ph -> -u 1 e. RR )
