  46 mtod 20 45 |- ( ph -> -. ( ( S - P ) / ( Q - P ) ) e. RR )
  47 jca 3 17 |- ( ph -> ( -. P = Q /\ -. Q = S ) )
  48 jca 47 27 |- ( ph -> ( ( -. P = Q /\ -. Q = S ) /\ -. P = S ) )
