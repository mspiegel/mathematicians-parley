  49 eqtrd 48 45 |- ( ph -> ( abs ` ( B - X ) ) = K )
  50 jca 33 49 |- ( ph -> ( ( A =/= B /\ ( ( X - B ) / ( A - B ) ) e. RR /\ ( ( X - B ) / ( A - B )
      ) < 0 ) /\ ( abs ` ( B - X ) ) = K ) )

# Euclid's second postulate, with the length the segment is produced by:
# past B, away from A, there is a point at any positive distance from B.
lemma gextend
  |- ( ( ( ( ( A e. CC /\ B e. CC ) /\ K e. RR ) /\ A =/= B ) /\ 0 < K ) -> E. x e. CC ( ( A =/= B
      /\ ( ( x - B ) / ( A - B ) ) e. RR /\ ( ( x - B ) / ( A - B ) ) < 0 ) /\ ( abs ` ( B - x ) )
      = K ) )
  1 simp-4l |- ( ( ( ( ( A e. CC /\ B e. CC ) /\ K e. RR ) /\ A =/= B ) /\ 0 < K ) -> A e. CC )
  2 simp-4r |- ( ( ( ( ( A e. CC /\ B e. CC ) /\ K e. RR ) /\ A =/= B ) /\ 0 < K ) -> B e. CC )
  3 simpllr |- ( ( ( ( ( A e. CC /\ B e. CC ) /\ K e. RR ) /\ A =/= B ) /\ 0 < K ) -> K e. RR )
  4 simplr |- ( ( ( ( ( A e. CC /\ B e. CC ) /\ K e. RR ) /\ A =/= B ) /\ 0 < K ) -> A =/= B )
  5 simpr |- ( ( ( ( ( A e. CC /\ B e. CC ) /\ K e. RR ) /\ A =/= B ) /\ 0 < K ) -> 0 < K )
  6 adantr 1 |- ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ K e. RR ) /\ A =/= B ) /\ 0 < K ) /\ x = ( B +
      ( ( K / ( abs ` ( B - A ) ) ) x. ( B - A ) ) ) ) -> A e. CC )
  7 adantr 2 |- ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ K e. RR ) /\ A =/= B ) /\ 0 < K ) /\ x = ( B +
      ( ( K / ( abs ` ( B - A ) ) ) x. ( B - A ) ) ) ) -> B e. CC )
  8 adantr 3 |- ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ K e. RR ) /\ A =/= B ) /\ 0 < K ) /\ x = ( B +
      ( ( K / ( abs ` ( B - A ) ) ) x. ( B - A ) ) ) ) -> K e. RR )
  9 adantr 4 |- ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ K e. RR ) /\ A =/= B ) /\ 0 < K ) /\ x = ( B +
      ( ( K / ( abs ` ( B - A ) ) ) x. ( B - A ) ) ) ) -> A =/= B )
  10 adantr 5 |- ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ K e. RR ) /\ A =/= B ) /\ 0 < K ) /\ x = ( B +
      ( ( K / ( abs ` ( B - A ) ) ) x. ( B - A ) ) ) ) -> 0 < K )
  11 simpr |- ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ K e. RR ) /\ A =/= B ) /\ 0 < K ) /\ x = ( B + (
      ( K / ( abs ` ( B - A ) ) ) x. ( B - A ) ) ) ) -> x = ( B + ( ( K / ( abs ` ( B - A ) ) ) x.
      ( B - A ) ) ) )
  12 gextendd 6 7 8 9 10 11 |- ( ( ( ( ( ( A e. CC /\ B e. CC ) /\ K e. RR ) /\ A =/= B ) /\ 0 < K
      ) /\ x = ( B + ( ( K / ( abs ` ( B - A ) ) ) x. ( B - A ) ) ) ) -> ( ( A =/= B /\ ( ( x - B )
      / ( A - B ) ) e. RR /\ ( ( x - B ) / ( A - B ) ) < 0 ) /\ ( abs ` ( B - x ) ) = K ) )
  13 subcld 2 1 |- ( ( ( ( ( A e. CC /\ B e. CC ) /\ K e. RR ) /\ A =/= B ) /\ 0 < K ) -> ( B - A )
      e. CC )
  14 abscld 13 |- ( ( ( ( ( A e. CC /\ B e. CC ) /\ K e. RR ) /\ A =/= B ) /\ 0 < K ) -> ( abs ` (
      B - A ) ) e. RR )
  15 recnd 14 |- ( ( ( ( ( A e. CC /\ B e. CC ) /\ K e. RR ) /\ A =/= B ) /\ 0 < K ) -> ( abs ` ( B
      - A ) ) e. CC )
  16 recnd 3 |- ( ( ( ( ( A e. CC /\ B e. CC ) /\ K e. RR ) /\ A =/= B ) /\ 0 < K ) -> K e. CC )
  17 necomd 4 |- ( ( ( ( ( A e. CC /\ B e. CC ) /\ K e. RR ) /\ A =/= B ) /\ 0 < K ) -> B =/= A )
  18 subne0d 2 1 17 |- ( ( ( ( ( A e. CC /\ B e. CC ) /\ K e. RR ) /\ A =/= B ) /\ 0 < K ) -> ( B -
      A ) =/= 0 )
  19 absne0d 13 18 |- ( ( ( ( ( A e. CC /\ B e. CC ) /\ K e. RR ) /\ A =/= B ) /\ 0 < K ) -> ( abs
      ` ( B - A ) ) =/= 0 )
  20 divcld 16 15 19 |- ( ( ( ( ( A e. CC /\ B e. CC ) /\ K e. RR ) /\ A =/= B ) /\ 0 < K ) -> ( K
      / ( abs ` ( B - A ) ) ) e. CC )
  21 mulcld 20 13 |- ( ( ( ( ( A e. CC /\ B e. CC ) /\ K e. RR ) /\ A =/= B ) /\ 0 < K ) -> ( ( K /
      ( abs ` ( B - A ) ) ) x. ( B - A ) ) e. CC )
  22 addcld 2 21 |- ( ( ( ( ( A e. CC /\ B e. CC ) /\ K e. RR ) /\ A =/= B ) /\ 0 < K ) -> ( B + (
      ( K / ( abs ` ( B - A ) ) ) x. ( B - A ) ) ) e. CC )
  23 rspcime 12 22 |- ( ( ( ( ( A e. CC /\ B e. CC ) /\ K e. RR ) /\ A =/= B ) /\ 0 < K ) -> E. x
      e. CC ( ( A =/= B /\ ( ( x - B ) / ( A - B ) ) e. RR /\ ( ( x - B ) / ( A - B ) ) < 0 ) /\ (
      abs ` ( B - x ) ) = K ) )

# A point off line QR makes a triangle with Q and R. P = R would put P on
# the line, at place 1; P = Q, or R on line PQ, would too, read in the
# other order by `gcolrotate`.
lemma gtrioff
  |- ( ( ( ( ( P e. CC /\ Q e. CC ) /\ R e. CC ) /\ Q =/= R ) /\ -. ( Q = R \/ ( ( P - Q ) / ( R -
      Q ) ) e. RR ) ) -> ( ( ( -. P = Q /\ -. Q = R ) /\ -. P = R ) /\ -. ( ( R - P ) / ( Q - P ) )
      e. RR ) )
  1 simp-4l |- ( ( ( ( ( P e. CC /\ Q e. CC ) /\ R e. CC ) /\ Q =/= R ) /\ -. ( Q = R \/ ( ( P - Q
      ) / ( R - Q ) ) e. RR ) ) -> P e. CC )
  2 simp-4r |- ( ( ( ( ( P e. CC /\ Q e. CC ) /\ R e. CC ) /\ Q =/= R ) /\ -. ( Q = R \/ ( ( P - Q
      ) / ( R - Q ) ) e. RR ) ) -> Q e. CC )
  3 simpllr |- ( ( ( ( ( P e. CC /\ Q e. CC ) /\ R e. CC ) /\ Q =/= R ) /\ -. ( Q = R \/ ( ( P - Q
      ) / ( R - Q ) ) e. RR ) ) -> R e. CC )
  4 simplr |- ( ( ( ( ( P e. CC /\ Q e. CC ) /\ R e. CC ) /\ Q =/= R ) /\ -. ( Q = R \/ ( ( P - Q )
      / ( R - Q ) ) e. RR ) ) -> Q =/= R )
  5 simpr |- ( ( ( ( ( P e. CC /\ Q e. CC ) /\ R e. CC ) /\ Q =/= R ) /\ -. ( Q = R \/ ( ( P - Q )
      / ( R - Q ) ) e. RR ) ) -> -. ( Q = R \/ ( ( P - Q ) / ( R - Q ) ) e. RR ) )
  6 gcolrotate |- ( ( P e. CC /\ Q e. CC /\ R e. CC ) -> ( ( P = Q \/ ( ( R - P ) / ( Q - P ) ) e.
      RR ) -> ( Q = R \/ ( ( P - Q ) / ( R - Q ) ) e. RR ) ) )
  7 3jca 1 2 3 |- ( ( ( ( ( P e. CC /\ Q e. CC ) /\ R e. CC ) /\ Q =/= R ) /\ -. ( Q = R \/ ( ( P -
      Q ) / ( R - Q ) ) e. RR ) ) -> ( P e. CC /\ Q e. CC /\ R e. CC ) )
  8 syl 7 6 |- ( ( ( ( ( P e. CC /\ Q e. CC ) /\ R e. CC ) /\ Q =/= R ) /\ -. ( Q = R \/ ( ( P - Q
      ) / ( R - Q ) ) e. RR ) ) -> ( ( P = Q \/ ( ( R - P ) / ( Q - P ) ) e. RR ) -> ( Q = R \/ ( (
      P - Q ) / ( R - Q ) ) e. RR ) ) )
  9 mtod 5 8 |- ( ( ( ( ( P e. CC /\ Q e. CC ) /\ R e. CC ) /\ Q =/= R ) /\ -. ( Q = R \/ ( ( P - Q
      ) / ( R - Q ) ) e. RR ) ) -> -. ( P = Q \/ ( ( R - P ) / ( Q - P ) ) e. RR ) )
  10 ioran |- ( -. ( P = Q \/ ( ( R - P ) / ( Q - P ) ) e. RR ) <-> ( -. P = Q /\ -. ( ( R - P ) /
      ( Q - P ) ) e. RR ) )
  11 sylib 9 10 |- ( ( ( ( ( P e. CC /\ Q e. CC ) /\ R e. CC ) /\ Q =/= R ) /\ -. ( Q = R \/ ( ( P
      - Q ) / ( R - Q ) ) e. RR ) ) -> ( -. P = Q /\ -. ( ( R - P ) / ( Q - P ) ) e. RR ) )
  12 simpld 11 |- ( ( ( ( ( P e. CC /\ Q e. CC ) /\ R e. CC ) /\ Q =/= R ) /\ -. ( Q = R \/ ( ( P -
      Q ) / ( R - Q ) ) e. RR ) ) -> -. P = Q )
  13 simprd 11 |- ( ( ( ( ( P e. CC /\ Q e. CC ) /\ R e. CC ) /\ Q =/= R ) /\ -. ( Q = R \/ ( ( P -
      Q ) / ( R - Q ) ) e. RR ) ) -> -. ( ( R - P ) / ( Q - P ) ) e. RR )
  14 neneqd 4 |- ( ( ( ( ( P e. CC /\ Q e. CC ) /\ R e. CC ) /\ Q =/= R ) /\ -. ( Q = R \/ ( ( P -
      Q ) / ( R - Q ) ) e. RR ) ) -> -. Q = R )
  15 simpr |- ( ( ( ( ( ( P e. CC /\ Q e. CC ) /\ R e. CC ) /\ Q =/= R ) /\ -. ( Q = R \/ ( ( P - Q
      ) / ( R - Q ) ) e. RR ) ) /\ P = R ) -> P = R )
  16 oveq1d 15 |- ( ( ( ( ( ( P e. CC /\ Q e. CC ) /\ R e. CC ) /\ Q =/= R ) /\ -. ( Q = R \/ ( ( P
      - Q ) / ( R - Q ) ) e. RR ) ) /\ P = R ) -> ( P - Q ) = ( R - Q ) )
  17 oveq1d 16 |- ( ( ( ( ( ( P e. CC /\ Q e. CC ) /\ R e. CC ) /\ Q =/= R ) /\ -. ( Q = R \/ ( ( P
      - Q ) / ( R - Q ) ) e. RR ) ) /\ P = R ) -> ( ( P - Q ) / ( R - Q ) ) = ( ( R - Q ) / ( R - Q
      ) ) )
  18 subcld 3 2 |- ( ( ( ( ( P e. CC /\ Q e. CC ) /\ R e. CC ) /\ Q =/= R ) /\ -. ( Q = R \/ ( ( P
      - Q ) / ( R - Q ) ) e. RR ) ) -> ( R - Q ) e. CC )
  19 necomd 4 |- ( ( ( ( ( P e. CC /\ Q e. CC ) /\ R e. CC ) /\ Q =/= R ) /\ -. ( Q = R \/ ( ( P -
      Q ) / ( R - Q ) ) e. RR ) ) -> R =/= Q )
  20 subne0d 3 2 19 |- ( ( ( ( ( P e. CC /\ Q e. CC ) /\ R e. CC ) /\ Q =/= R ) /\ -. ( Q = R \/ (
      ( P - Q ) / ( R - Q ) ) e. RR ) ) -> ( R - Q ) =/= 0 )
  21 dividd 18 20 |- ( ( ( ( ( P e. CC /\ Q e. CC ) /\ R e. CC ) /\ Q =/= R ) /\ -. ( Q = R \/ ( (
      P - Q ) / ( R - Q ) ) e. RR ) ) -> ( ( R - Q ) / ( R - Q ) ) = 1 )
  22 adantr 21 |- ( ( ( ( ( ( P e. CC /\ Q e. CC ) /\ R e. CC ) /\ Q =/= R ) /\ -. ( Q = R \/ ( ( P
      - Q ) / ( R - Q ) ) e. RR ) ) /\ P = R ) -> ( ( R - Q ) / ( R - Q ) ) = 1 )
  23 eqtrd 17 22 |- ( ( ( ( ( ( P e. CC /\ Q e. CC ) /\ R e. CC ) /\ Q =/= R ) /\ -. ( Q = R \/ ( (
      P - Q ) / ( R - Q ) ) e. RR ) ) /\ P = R ) -> ( ( P - Q ) / ( R - Q ) ) = 1 )
  24 1red |- ( ( ( ( ( ( P e. CC /\ Q e. CC ) /\ R e. CC ) /\ Q =/= R ) /\ -. ( Q = R \/ ( ( P - Q
      ) / ( R - Q ) ) e. RR ) ) /\ P = R ) -> 1 e. RR )
  25 eqeltrd 23 24 |- ( ( ( ( ( ( P e. CC /\ Q e. CC ) /\ R e. CC ) /\ Q =/= R ) /\ -. ( Q = R \/ (
      ( P - Q ) / ( R - Q ) ) e. RR ) ) /\ P = R ) -> ( ( P - Q ) / ( R - Q ) ) e. RR )
  26 olcd 25 |- ( ( ( ( ( ( P e. CC /\ Q e. CC ) /\ R e. CC ) /\ Q =/= R ) /\ -. ( Q = R \/ ( ( P -
      Q ) / ( R - Q ) ) e. RR ) ) /\ P = R ) -> ( Q = R \/ ( ( P - Q ) / ( R - Q ) ) e. RR ) )
  27 mtand 5 26 |- ( ( ( ( ( P e. CC /\ Q e. CC ) /\ R e. CC ) /\ Q =/= R ) /\ -. ( Q = R \/ ( ( P
      - Q ) / ( R - Q ) ) e. RR ) ) -> -. P = R )
  28 jca 12 14 |- ( ( ( ( ( P e. CC /\ Q e. CC ) /\ R e. CC ) /\ Q =/= R ) /\ -. ( Q = R \/ ( ( P -
      Q ) / ( R - Q ) ) e. RR ) ) -> ( -. P = Q /\ -. Q = R ) )
  29 jca 28 27 |- ( ( ( ( ( P e. CC /\ Q e. CC ) /\ R e. CC ) /\ Q =/= R ) /\ -. ( Q = R \/ ( ( P -
      Q ) / ( R - Q ) ) e. RR ) ) -> ( ( -. P = Q /\ -. Q = R ) /\ -. P = R ) )
  30 jca 29 13 |- ( ( ( ( ( P e. CC /\ Q e. CC ) /\ R e. CC ) /\ Q =/= R ) /\ -. ( Q = R \/ ( ( P -
      Q ) / ( R - Q ) ) e. RR ) ) -> ( ( ( -. P = Q /\ -. Q = R ) /\ -. P = R ) /\ -. ( ( R - P ) /
      ( Q - P ) ) e. RR ) )

# The empty set is no extended real: neither a real (it is no complex
# number) nor either infinity (each contains the empty set).
lemma g0nxr
  |- -. (/) e. RR*
  1 0elpw |- (/) e. ~P U. CC
  2 df-pnf |- +oo = ~P U. CC
  3 eleqtrri 1 2 |- (/) e. +oo
  4 n0i |- ( (/) e. +oo -> -. +oo = (/) )
  5 ax-mp 3 4 |- -. +oo = (/)
  6 eqcom |- ( (/) = +oo <-> +oo = (/) )
  7 mtbir 5 6 |- -. (/) = +oo
  8 0elpw |- (/) e. ~P +oo
  9 df-mnf |- -oo = ~P +oo
  10 eleqtrri 8 9 |- (/) e. -oo
  11 n0i |- ( (/) e. -oo -> -. -oo = (/) )
  12 ax-mp 10 11 |- -. -oo = (/)
  13 eqcom |- ( (/) = -oo <-> -oo = (/) )
  14 mtbir 12 13 |- -. (/) = -oo
  15 0ncn |- -. (/) e. CC
  16 recn |- ( (/) e. RR -> (/) e. CC )
  17 mto 15 16 |- -. (/) e. RR
  18 3pm3.2i 17 7 14 |- ( -. (/) e. RR /\ -. (/) = +oo /\ -. (/) = -oo )
  19 3ioran |- ( -. ( (/) e. RR \/ (/) = +oo \/ (/) = -oo ) <-> ( -. (/) e. RR /\ -. (/) = +oo /\
      -. (/) = -oo ) )
  20 mpbir 18 19 |- -. ( (/) e. RR \/ (/) = +oo \/ (/) = -oo )
  21 elxr |- ( (/) e. RR* <-> ( (/) e. RR \/ (/) = +oo \/ (/) = -oo ) )
  22 mtbir 20 21 |- -. (/) e. RR*

# A product of two imaginary parts that is an extended real is a product
# of two reals: off CC, Im gives the empty set, and so does the product.
lemma gimxr
  hypothesis gimxr.1 |- ( ph -> ( ( Im ` X ) x. ( Im ` Y ) ) e. RR* )
  |- ( ph -> ( ( Im ` X ) e. RR /\ ( Im ` Y ) e. RR ) )
  1 imf |- Im : CC --> RR
  2 fdmi 1 |- dom Im = CC
  3 eleq2i 2 |- ( X e. dom Im <-> X e. CC )
  4 notbii 3 |- ( -. X e. dom Im <-> -. X e. CC )
  5 ndmfv |- ( -. X e. dom Im -> ( Im ` X ) = (/) )
  6 sylbir 4 5 |- ( -. X e. CC -> ( Im ` X ) = (/) )
  7 0ncn |- -. (/) e. CC
  8 eleq1 |- ( ( Im ` X ) = (/) -> ( ( Im ` X ) e. CC <-> (/) e. CC ) )
  9 mtbiri 7 8 |- ( ( Im ` X ) = (/) -> -. ( Im ` X ) e. CC )
  10 syl 6 9 |- ( -. X e. CC -> -. ( Im ` X ) e. CC )
  11 intnanrd 10 |- ( -. X e. CC -> -. ( ( Im ` X ) e. CC /\ ( Im ` Y ) e. CC ) )
  12 ax-mulf |- x. : ( CC X. CC ) --> CC
  13 fdmi 12 |- dom x. = ( CC X. CC )
  14 ndmov 13 |- ( -. ( ( Im ` X ) e. CC /\ ( Im ` Y ) e. CC ) -> ( ( Im ` X ) x. ( Im ` Y ) ) =
      (/) )
  15 syl 11 14 |- ( -. X e. CC -> ( ( Im ` X ) x. ( Im ` Y ) ) = (/) )
  16 g0nxr |- -. (/) e. RR*
  17 eleq1 |- ( ( ( Im ` X ) x. ( Im ` Y ) ) = (/) -> ( ( ( Im ` X ) x. ( Im ` Y ) ) e. RR* <-> (/)
      e. RR* ) )
  18 mtbiri 16 17 |- ( ( ( Im ` X ) x. ( Im ` Y ) ) = (/) -> -. ( ( Im ` X ) x. ( Im ` Y ) ) e. RR*
      )
  19 syl 15 18 |- ( -. X e. CC -> -. ( ( Im ` X ) x. ( Im ` Y ) ) e. RR* )
  20 con4i 19 |- ( ( ( Im ` X ) x. ( Im ` Y ) ) e. RR* -> X e. CC )
  21 syl gimxr.1 20 |- ( ph -> X e. CC )
  22 imcld 21 |- ( ph -> ( Im ` X ) e. RR )
  23 eleq2i 2 |- ( Y e. dom Im <-> Y e. CC )
  24 notbii 23 |- ( -. Y e. dom Im <-> -. Y e. CC )
  25 ndmfv |- ( -. Y e. dom Im -> ( Im ` Y ) = (/) )
  26 sylbir 24 25 |- ( -. Y e. CC -> ( Im ` Y ) = (/) )
  27 eleq1 |- ( ( Im ` Y ) = (/) -> ( ( Im ` Y ) e. CC <-> (/) e. CC ) )
  28 mtbiri 7 27 |- ( ( Im ` Y ) = (/) -> -. ( Im ` Y ) e. CC )
  29 syl 26 28 |- ( -. Y e. CC -> -. ( Im ` Y ) e. CC )
  30 intnand 29 |- ( -. Y e. CC -> -. ( ( Im ` X ) e. CC /\ ( Im ` Y ) e. CC ) )
  31 syl 30 14 |- ( -. Y e. CC -> ( ( Im ` X ) x. ( Im ` Y ) ) = (/) )
  32 syl 31 18 |- ( -. Y e. CC -> -. ( ( Im ` X ) x. ( Im ` Y ) ) e. RR* )
  33 con4i 32 |- ( ( ( Im ` X ) x. ( Im ` Y ) ) e. RR* -> Y e. CC )
  34 syl gimxr.1 33 |- ( ph -> Y e. CC )
  35 imcld 34 |- ( ph -> ( Im ` Y ) e. RR )
  36 jca 22 35 |- ( ph -> ( ( Im ` X ) e. RR /\ ( Im ` Y ) e. RR ) )

# Regrouping the product of A B and B C as A C times B squared.
lemma grmid
  hypothesis grmid.1 |- ( ph -> A e. CC )
  hypothesis grmid.2 |- ( ph -> B e. CC )
  hypothesis grmid.3 |- ( ph -> C e. CC )
  |- ( ph -> ( ( A x. B ) x. ( B x. C ) ) = ( ( A x. C ) x. ( B x. B ) ) )
  1 mulcomd grmid.2 grmid.3 |- ( ph -> ( B x. C ) = ( C x. B ) )
  2 oveq2d 1 |- ( ph -> ( ( A x. B ) x. ( B x. C ) ) = ( ( A x. B ) x. ( C x. B ) ) )
  3 mul4d grmid.1 grmid.2 grmid.3 grmid.2 |- ( ph -> ( ( A x. B ) x. ( C x. B ) ) = ( ( A x. C ) x.
      ( B x. B ) ) )
  4 eqtrd 2 3 |- ( ph -> ( ( A x. B ) x. ( B x. C ) ) = ( ( A x. C ) x. ( B x. B ) ) )

# A factor of a nonzero product of reals has a positive square.
lemma grsq
  hypothesis grsq.1 |- ( ph -> A e. RR )
  hypothesis grsq.2 |- ( ph -> B e. RR )
  hypothesis grsq.3 |- ( ph -> ( A x. B ) =/= 0 )
  |- ( ph -> 0 < ( B x. B ) )
  1 recnd grsq.1 |- ( ph -> A e. CC )
  2 recnd grsq.2 |- ( ph -> B e. CC )
  3 mulne0bbd 1 2 grsq.3 |- ( ph -> B =/= 0 )
  4 msqgt0d grsq.2 3 |- ( ph -> 0 < ( B x. B ) )

# The side of a point is real-linear along a line through X: when
# Q - X is K times P - X with K real, the sides change by the same K.
lemma gimlin
  hypothesis gimlin.1 |- ( ph -> A e. CC )
  hypothesis gimlin.2 |- ( ph -> B e. CC )
  hypothesis gimlin.3 |- ( ph -> P e. CC )
  hypothesis gimlin.4 |- ( ph -> Q e. CC )
  hypothesis gimlin.5 |- ( ph -> X e. CC )
  hypothesis gimlin.6 |- ( ph -> A =/= B )
  hypothesis gimlin.7 |- ( ph -> K e. RR )
  hypothesis gimlin.8 |- ( ph -> ( Q - X ) = ( K x. ( P - X ) ) )
  |- ( ph -> ( ( Im ` ( ( Q - A ) / ( B - A ) ) ) - ( Im ` ( ( X - A ) / ( B - A ) ) ) ) = ( K x. (
      ( Im ` ( ( P - A ) / ( B - A ) ) ) - ( Im ` ( ( X - A ) / ( B - A ) ) ) ) ) )
  1 subcld gimlin.2 gimlin.1 |- ( ph -> ( B - A ) e. CC )
  2 necomd gimlin.6 |- ( ph -> B =/= A )
  3 subne0d gimlin.2 gimlin.1 2 |- ( ph -> ( B - A ) =/= 0 )
  4 subcld gimlin.4 gimlin.1 |- ( ph -> ( Q - A ) e. CC )
  5 subcld gimlin.5 gimlin.1 |- ( ph -> ( X - A ) e. CC )
  6 subcld gimlin.3 gimlin.1 |- ( ph -> ( P - A ) e. CC )
  7 divsubdird 4 5 1 3 |- ( ph -> ( ( ( Q - A ) - ( X - A ) ) / ( B - A ) ) = ( ( ( Q - A ) / ( B -
      A ) ) - ( ( X - A ) / ( B - A ) ) ) )
  8 nnncan2d gimlin.4 gimlin.5 gimlin.1 |- ( ph -> ( ( Q - A ) - ( X - A ) ) = ( Q - X ) )
  9 oveq1d 8 |- ( ph -> ( ( ( Q - A ) - ( X - A ) ) / ( B - A ) ) = ( ( Q - X ) / ( B - A ) ) )
  10 eqtr3d 7 9 |- ( ph -> ( ( ( Q - A ) / ( B - A ) ) - ( ( X - A ) / ( B - A ) ) ) = ( ( Q - X )
      / ( B - A ) ) )
  11 oveq1d gimlin.8 |- ( ph -> ( ( Q - X ) / ( B - A ) ) = ( ( K x. ( P - X ) ) / ( B - A ) ) )
  12 recnd gimlin.7 |- ( ph -> K e. CC )
  13 subcld gimlin.3 gimlin.5 |- ( ph -> ( P - X ) e. CC )
  14 divassd 12 13 1 3 |- ( ph -> ( ( K x. ( P - X ) ) / ( B - A ) ) = ( K x. ( ( P - X ) / ( B - A
      ) ) ) )
  15 divsubdird 6 5 1 3 |- ( ph -> ( ( ( P - A ) - ( X - A ) ) / ( B - A ) ) = ( ( ( P - A ) / ( B
      - A ) ) - ( ( X - A ) / ( B - A ) ) ) )
  16 nnncan2d gimlin.3 gimlin.5 gimlin.1 |- ( ph -> ( ( P - A ) - ( X - A ) ) = ( P - X ) )
  17 oveq1d 16 |- ( ph -> ( ( ( P - A ) - ( X - A ) ) / ( B - A ) ) = ( ( P - X ) / ( B - A ) ) )
  18 eqtr3d 15 17 |- ( ph -> ( ( ( P - A ) / ( B - A ) ) - ( ( X - A ) / ( B - A ) ) ) = ( ( P - X
      ) / ( B - A ) ) )
  19 oveq2d 18 |- ( ph -> ( K x. ( ( ( P - A ) / ( B - A ) ) - ( ( X - A ) / ( B - A ) ) ) ) = ( K
      x. ( ( P - X ) / ( B - A ) ) ) )
  20 eqtrd 10 11 |- ( ph -> ( ( ( Q - A ) / ( B - A ) ) - ( ( X - A ) / ( B - A ) ) ) = ( ( K x. (
      P - X ) ) / ( B - A ) ) )
  21 eqtrd 20 14 |- ( ph -> ( ( ( Q - A ) / ( B - A ) ) - ( ( X - A ) / ( B - A ) ) ) = ( K x. ( (
      P - X ) / ( B - A ) ) ) )
  22 eqtr4d 21 19 |- ( ph -> ( ( ( Q - A ) / ( B - A ) ) - ( ( X - A ) / ( B - A ) ) ) = ( K x. ( (
      ( P - A ) / ( B - A ) ) - ( ( X - A ) / ( B - A ) ) ) ) )
  23 fveq2d 22 |- ( ph -> ( Im ` ( ( ( Q - A ) / ( B - A ) ) - ( ( X - A ) / ( B - A ) ) ) ) = ( Im
      ` ( K x. ( ( ( P - A ) / ( B - A ) ) - ( ( X - A ) / ( B - A ) ) ) ) ) )
  24 divcld 4 1 3 |- ( ph -> ( ( Q - A ) / ( B - A ) ) e. CC )
  25 divcld 5 1 3 |- ( ph -> ( ( X - A ) / ( B - A ) ) e. CC )
  26 divcld 6 1 3 |- ( ph -> ( ( P - A ) / ( B - A ) ) e. CC )
  27 imsubd 24 25 |- ( ph -> ( Im ` ( ( ( Q - A ) / ( B - A ) ) - ( ( X - A ) / ( B - A ) ) ) ) = (
      ( Im ` ( ( Q - A ) / ( B - A ) ) ) - ( Im ` ( ( X - A ) / ( B - A ) ) ) ) )
  28 subcld 26 25 |- ( ph -> ( ( ( P - A ) / ( B - A ) ) - ( ( X - A ) / ( B - A ) ) ) e. CC )
  29 immul2d gimlin.7 28 |- ( ph -> ( Im ` ( K x. ( ( ( P - A ) / ( B - A ) ) - ( ( X - A ) / ( B -
      A ) ) ) ) ) = ( K x. ( Im ` ( ( ( P - A ) / ( B - A ) ) - ( ( X - A ) / ( B - A ) ) ) ) ) )
  30 imsubd 26 25 |- ( ph -> ( Im ` ( ( ( P - A ) / ( B - A ) ) - ( ( X - A ) / ( B - A ) ) ) ) = (
      ( Im ` ( ( P - A ) / ( B - A ) ) ) - ( Im ` ( ( X - A ) / ( B - A ) ) ) ) )
  31 oveq2d 30 |- ( ph -> ( K x. ( Im ` ( ( ( P - A ) / ( B - A ) ) - ( ( X - A ) / ( B - A ) ) ) )
      ) = ( K x. ( ( Im ` ( ( P - A ) / ( B - A ) ) ) - ( Im ` ( ( X - A ) / ( B - A ) ) ) ) ) )
  32 eqtrd 29 31 |- ( ph -> ( Im ` ( K x. ( ( ( P - A ) / ( B - A ) ) - ( ( X - A ) / ( B - A ) ) )
      ) ) = ( K x. ( ( Im ` ( ( P - A ) / ( B - A ) ) ) - ( Im ` ( ( X - A ) / ( B - A ) ) ) ) ) )
  33 3eqtr3d 23 27 32 |- ( ph -> ( ( Im ` ( ( Q - A ) / ( B - A ) ) ) - ( Im ` ( ( X - A ) / ( B -
      A ) ) ) ) = ( K x. ( ( Im ` ( ( P - A ) / ( B - A ) ) ) - ( Im ` ( ( X - A ) / ( B - A ) ) )
      ) ) )

# A point on line AB, with A and B distinct, has a real place along it.
lemma gonre
  hypothesis gonre.1 |- ( ph -> A =/= B )
  hypothesis gonre.2 |- ( ph -> ( A = B \/ W e. RR ) )
  |- ( ph -> W e. RR )
  1 neneqd gonre.1 |- ( ph -> -. A = B )
  2 orel1 |- ( -. A = B -> ( ( A = B \/ W e. RR ) -> W e. RR ) )
  3 sylc 1 gonre.2 2 |- ( ph -> W e. RR )

# A point off line AB has a side that is not 0.
lemma goffim
  hypothesis goffim.1 |- ( ph -> W e. CC )
  hypothesis goffim.2 |- ( ph -> -. ( A = B \/ W e. RR ) )
  |- ( ph -> ( Im ` W ) =/= 0 )
  1 olc |- ( W e. RR -> ( A = B \/ W e. RR ) )
  2 nsyl goffim.2 1 |- ( ph -> -. W e. RR )
  3 reim0b |- ( W e. CC -> ( W e. RR <-> ( Im ` W ) = 0 ) )
  4 syl goffim.1 3 |- ( ph -> ( W e. RR <-> ( Im ` W ) = 0 ) )
  5 mtbid 2 4 |- ( ph -> -. ( Im ` W ) = 0 )
  6 neqned 5 |- ( ph -> ( Im ` W ) =/= 0 )

# With 0 - A = C ( B - A ) and C negative, ( C - 1 ) A = C B, so A has
# the sign of B.
lemma gsegsgn
  hypothesis gsegsgn.1 |- ( ph -> A e. RR )
  hypothesis gsegsgn.2 |- ( ph -> B e. RR )
  hypothesis gsegsgn.3 |- ( ph -> C e. RR )
  hypothesis gsegsgn.4 |- ( ph -> C < 0 )
  hypothesis gsegsgn.5 |- ( ph -> B =/= 0 )
  hypothesis gsegsgn.6 |- ( ph -> ( 0 - A ) = ( C x. ( B - A ) ) )
  |- ( ph -> 0 < ( A x. B ) )
  1 recnd gsegsgn.1 |- ( ph -> A e. CC )
  2 recnd gsegsgn.2 |- ( ph -> B e. CC )
  3 recnd gsegsgn.3 |- ( ph -> C e. CC )
  4 subdid 3 2 1 |- ( ph -> ( C x. ( B - A ) ) = ( ( C x. B ) - ( C x. A ) ) )
  5 eqtrd gsegsgn.6 4 |- ( ph -> ( 0 - A ) = ( ( C x. B ) - ( C x. A ) ) )
  6 df-neg |- -u A = ( 0 - A )
  7 a1i 6 |- ( ph -> -u A = ( 0 - A ) )
  8 eqtrd 7 5 |- ( ph -> -u A = ( ( C x. B ) - ( C x. A ) ) )
  9 eqcomd 8 |- ( ph -> ( ( C x. B ) - ( C x. A ) ) = -u A )
  10 mulcld 3 2 |- ( ph -> ( C x. B ) e. CC )
  11 mulcld 3 1 |- ( ph -> ( C x. A ) e. CC )
  12 negcld 1 |- ( ph -> -u A e. CC )
  13 subaddd 10 11 12 |- ( ph -> ( ( ( C x. B ) - ( C x. A ) ) = -u A <-> ( ( C x. A ) + -u A ) = (
      C x. B ) ) )
  14 mpbid 9 13 |- ( ph -> ( ( C x. A ) + -u A ) = ( C x. B ) )
  15 negsubd 11 1 |- ( ph -> ( ( C x. A ) + -u A ) = ( ( C x. A ) - A ) )
  16 1cnd |- ( ph -> 1 e. CC )
  17 subdird 3 16 1 |- ( ph -> ( ( C - 1 ) x. A ) = ( ( C x. A ) - ( 1 x. A ) ) )
  18 mullidd 1 |- ( ph -> ( 1 x. A ) = A )
  19 oveq2d 18 |- ( ph -> ( ( C x. A ) - ( 1 x. A ) ) = ( ( C x. A ) - A ) )
  20 eqtrd 17 19 |- ( ph -> ( ( C - 1 ) x. A ) = ( ( C x. A ) - A ) )
  21 eqtr3d 15 14 |- ( ph -> ( ( C x. A ) - A ) = ( C x. B ) )
  22 eqtrd 20 21 |- ( ph -> ( ( C - 1 ) x. A ) = ( C x. B ) )
  23 subcld 3 16 |- ( ph -> ( C - 1 ) e. CC )
  24 mulassd 23 1 2 |- ( ph -> ( ( ( C - 1 ) x. A ) x. B ) = ( ( C - 1 ) x. ( A x. B ) ) )
  25 oveq1d 22 |- ( ph -> ( ( ( C - 1 ) x. A ) x. B ) = ( ( C x. B ) x. B ) )
  26 mulassd 3 2 2 |- ( ph -> ( ( C x. B ) x. B ) = ( C x. ( B x. B ) ) )
  27 3eqtr3d 25 24 26 |- ( ph -> ( ( C - 1 ) x. ( A x. B ) ) = ( C x. ( B x. B ) ) )
  28 msqgt0d gsegsgn.2 gsegsgn.5 |- ( ph -> 0 < ( B x. B ) )
  29 remulcld gsegsgn.2 gsegsgn.2 |- ( ph -> ( B x. B ) e. RR )
  30 mulltgt0d gsegsgn.3 29 gsegsgn.4 28 |- ( ph -> ( C x. ( B x. B ) ) < 0 )
  31 eqbrtrd 27 30 |- ( ph -> ( ( C - 1 ) x. ( A x. B ) ) < 0 )
  32 1red |- ( ph -> 1 e. RR )
  33 resubcld gsegsgn.3 32 |- ( ph -> ( C - 1 ) e. RR )
  34 0red |- ( ph -> 0 e. RR )
  35 0lt1 |- 0 < 1
  36 a1i 35 |- ( ph -> 0 < 1 )
  37 lttrd gsegsgn.3 34 32 gsegsgn.4 36 |- ( ph -> C < 1 )
  38 sublt0d gsegsgn.3 32 |- ( ph -> ( ( C - 1 ) < 0 <-> C < 1 ) )
  39 mpbird 37 38 |- ( ph -> ( C - 1 ) < 0 )
  40 remulcld gsegsgn.1 gsegsgn.2 |- ( ph -> ( A x. B ) e. RR )
  41 mullt0b1d 33 40 39 |- ( ph -> ( 0 < ( A x. B ) <-> ( ( C - 1 ) x. ( A x. B ) ) < 0 ) )
  42 mpbird 31 41 |- ( ph -> 0 < ( A x. B ) )

# A point's place along line CD, read from its place along line AB when C
# and D are points of AB (glinequot of the line-uniqueness draft).
lemma gsidequot
  hypothesis gsidequot.1 |- ( ph -> U e. CC )
  hypothesis gsidequot.2 |- ( ph -> A e. CC )
  hypothesis gsidequot.3 |- ( ph -> B e. CC )
  hypothesis gsidequot.4 |- ( ph -> C e. CC )
  hypothesis gsidequot.5 |- ( ph -> D e. CC )
  hypothesis gsidequot.6 |- ( ph -> A =/= B )
