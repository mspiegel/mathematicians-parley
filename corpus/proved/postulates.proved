  28 syl 9 27 |- ( ( ( Im ` X ) x. ( Im ` Y ) ) e. RR* -> ( X e. CC /\ Y e. CC ) )

# A quotient that is a complex number has a divisor that is not 0.
lemma gdivrcl
  |- ( ( X / Y ) e. CC -> Y =/= 0 )
  1 df-div |- / = ( x e. CC , y e. ( CC \ { 0 } ) |-> ( iota_ z e. CC ( y x. z ) = x ) )
  2 riotaex |- ( iota_ z e. CC ( y x. z ) = x ) e. _V
  3 dmmpo 1 2 |- dom / = ( CC X. ( CC \ { 0 } ) )
  4 ndmovg |- ( ( dom / = ( CC X. ( CC \ { 0 } ) ) /\ -. ( X e. CC /\ Y e. ( CC \ { 0 } ) ) ) -> (
      X / Y ) = (/) )
  5 mpan 3 4 |- ( -. ( X e. CC /\ Y e. ( CC \ { 0 } ) ) -> ( X / Y ) = (/) )
  6 eleq1 |- ( ( X / Y ) = (/) -> ( ( X / Y ) e. CC <-> (/) e. CC ) )
  7 syl 5 6 |- ( -. ( X e. CC /\ Y e. ( CC \ { 0 } ) ) -> ( ( X / Y ) e. CC <-> (/) e. CC ) )
  8 0ncn |- -. (/) e. CC
  9 mtbiri 8 7 |- ( -. ( X e. CC /\ Y e. ( CC \ { 0 } ) ) -> -. ( X / Y ) e. CC )
  10 con4i 9 |- ( ( X / Y ) e. CC -> ( X e. CC /\ Y e. ( CC \ { 0 } ) ) )
  11 simprd 10 |- ( ( X / Y ) e. CC -> Y e. ( CC \ { 0 } ) )
  12 eldifsn |- ( Y e. ( CC \ { 0 } ) <-> ( Y e. CC /\ Y =/= 0 ) )
  13 sylib 11 12 |- ( ( X / Y ) e. CC -> ( Y e. CC /\ Y =/= 0 ) )
  14 simprd 13 |- ( ( X / Y ) e. CC -> Y =/= 0 )

# P and Q with a nonzero product of signs: line AB is a line and neither
# point is on it.
lemma gsoffd
  hypothesis gsoffd.1 |- ( ph -> A e. CC )
  hypothesis gsoffd.2 |- ( ph -> B e. CC )
  hypothesis gsoffd.3 |- ( ph -> P e. CC )
  hypothesis gsoffd.4 |- ( ph -> Q e. CC )
