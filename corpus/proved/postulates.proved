  34 addcld gextendd.2 10 |- ( ph -> ( B + ( ( K / ( abs ` ( B - A ) ) ) x. ( B - A ) ) ) e. CC )
  35 eqeltrd gextendd.6 34 |- ( ph -> X e. CC )
  36 abssubd gextendd.2 35 |- ( ph -> ( abs ` ( B - X ) ) = ( abs ` ( X - B ) ) )
  37 fveq2d 13 |- ( ph -> ( abs ` ( X - B ) ) = ( abs ` ( ( K / ( abs ` ( B - A ) ) ) x. ( B - A )
      ) ) )
  38 absmuld 9 1 |- ( ph -> ( abs ` ( ( K / ( abs ` ( B - A ) ) ) x. ( B - A ) ) ) = ( ( abs ` ( K
