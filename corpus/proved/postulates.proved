      ) e. RR ) )

lemma gtriext
  |- ( ( ( ( ( ( P e. CC /\ Q e. CC ) /\ R e. CC ) /\ S e. CC ) /\ ( ( ( -. P = Q /\ -. Q = R ) /\
      -. P = R ) /\ -. ( ( R - P ) / ( Q - P ) ) e. RR ) ) /\ ( R =/= Q /\ ( ( S - Q ) / ( R - Q )
      ) e. RR /\ ( ( S - Q ) / ( R - Q ) ) < 0 ) ) -> ( ( ( -. P = Q /\ -. Q = S ) /\ -. P = S ) /\
      -. ( ( S - P ) / ( Q - P ) ) e. RR ) )
  1 simp-5l |- ( ( ( ( ( ( P e. CC /\ Q e. CC ) /\ R e. CC ) /\ S e. CC ) /\ ( ( ( -. P = Q /\ -. Q
      = R ) /\ -. P = R ) /\ -. ( ( R - P ) / ( Q - P ) ) e. RR ) ) /\ ( R =/= Q /\ ( ( S - Q ) / (
      R - Q ) ) e. RR /\ ( ( S - Q ) / ( R - Q ) ) < 0 ) ) -> P e. CC )
  2 simp-5r |- ( ( ( ( ( ( P e. CC /\ Q e. CC ) /\ R e. CC ) /\ S e. CC ) /\ ( ( ( -. P = Q /\ -. Q
      = R ) /\ -. P = R ) /\ -. ( ( R - P ) / ( Q - P ) ) e. RR ) ) /\ ( R =/= Q /\ ( ( S - Q ) / (
      R - Q ) ) e. RR /\ ( ( S - Q ) / ( R - Q ) ) < 0 ) ) -> Q e. CC )
  3 simp-4r |- ( ( ( ( ( ( P e. CC /\ Q e. CC ) /\ R e. CC ) /\ S e. CC ) /\ ( ( ( -. P = Q /\ -. Q
      = R ) /\ -. P = R ) /\ -. ( ( R - P ) / ( Q - P ) ) e. RR ) ) /\ ( R =/= Q /\ ( ( S - Q ) / (
      R - Q ) ) e. RR /\ ( ( S - Q ) / ( R - Q ) ) < 0 ) ) -> R e. CC )
  4 simpllr |- ( ( ( ( ( ( P e. CC /\ Q e. CC ) /\ R e. CC ) /\ S e. CC ) /\ ( ( ( -. P = Q /\ -. Q
      = R ) /\ -. P = R ) /\ -. ( ( R - P ) / ( Q - P ) ) e. RR ) ) /\ ( R =/= Q /\ ( ( S - Q ) / (
      R - Q ) ) e. RR /\ ( ( S - Q ) / ( R - Q ) ) < 0 ) ) -> S e. CC )
  5 simplr |- ( ( ( ( ( ( P e. CC /\ Q e. CC ) /\ R e. CC ) /\ S e. CC ) /\ ( ( ( -. P = Q /\ -. Q
      = R ) /\ -. P = R ) /\ -. ( ( R - P ) / ( Q - P ) ) e. RR ) ) /\ ( R =/= Q /\ ( ( S - Q ) / (
      R - Q ) ) e. RR /\ ( ( S - Q ) / ( R - Q ) ) < 0 ) ) -> ( ( ( -. P = Q /\ -. Q = R ) /\ -. P
      = R ) /\ -. ( ( R - P ) / ( Q - P ) ) e. RR ) )
  6 simpr |- ( ( ( ( ( ( P e. CC /\ Q e. CC ) /\ R e. CC ) /\ S e. CC ) /\ ( ( ( -. P = Q /\ -. Q =
      R ) /\ -. P = R ) /\ -. ( ( R - P ) / ( Q - P ) ) e. RR ) ) /\ ( R =/= Q /\ ( ( S - Q ) / ( R
      - Q ) ) e. RR /\ ( ( S - Q ) / ( R - Q ) ) < 0 ) ) -> ( R =/= Q /\ ( ( S - Q ) / ( R - Q ) )
      e. RR /\ ( ( S - Q ) / ( R - Q ) ) < 0 ) )
  7 gtriextd 1 2 3 4 5 6 |- ( ( ( ( ( ( P e. CC /\ Q e. CC ) /\ R e. CC ) /\ S e. CC ) /\ ( ( ( -.
      P = Q /\ -. Q = R ) /\ -. P = R ) /\ -. ( ( R - P ) / ( Q - P ) ) e. RR ) ) /\ ( R =/= Q /\ (
      ( S - Q ) / ( R - Q ) ) e. RR /\ ( ( S - Q ) / ( R - Q ) ) < 0 ) ) -> ( ( ( -. P = Q /\ -. Q
      = S ) /\ -. P = S ) /\ -. ( ( S - P ) / ( Q - P ) ) e. RR ) )

# Reals U and V with -V = K (U - V) for a negative K have a positive
# product: -K UV = (1 - K) V V.
lemma gbeysgn
  hypothesis gbeysgn.1 |- ( ph -> U e. RR )
  hypothesis gbeysgn.2 |- ( ph -> V e. RR )
  hypothesis gbeysgn.3 |- ( ph -> K e. RR )
  hypothesis gbeysgn.4 |- ( ph -> K < 0 )
  hypothesis gbeysgn.5 |- ( ph -> V =/= 0 )
  hypothesis gbeysgn.6 |- ( ph -> ( 0 - V ) = ( K x. ( U - V ) ) )
  |- ( ph -> 0 < ( U x. V ) )
  1 recnd gbeysgn.1 |- ( ph -> U e. CC )
  2 recnd gbeysgn.2 |- ( ph -> V e. CC )
  3 recnd gbeysgn.3 |- ( ph -> K e. CC )
  4 df-neg |- -u V = ( 0 - V )
  5 a1i 4 |- ( ph -> -u V = ( 0 - V ) )
  6 eqtrd 5 gbeysgn.6 |- ( ph -> -u V = ( K x. ( U - V ) ) )
  7 subdid 3 1 2 |- ( ph -> ( K x. ( U - V ) ) = ( ( K x. U ) - ( K x. V ) ) )
  8 eqtrd 6 7 |- ( ph -> -u V = ( ( K x. U ) - ( K x. V ) ) )
  9 eqcomd 8 |- ( ph -> ( ( K x. U ) - ( K x. V ) ) = -u V )
  10 mulcld 3 1 |- ( ph -> ( K x. U ) e. CC )
  11 mulcld 3 2 |- ( ph -> ( K x. V ) e. CC )
  12 negcld 2 |- ( ph -> -u V e. CC )
  13 subaddd 10 11 12 |- ( ph -> ( ( ( K x. U ) - ( K x. V ) ) = -u V <-> ( ( K x. V ) + -u V ) = (
      K x. U ) ) )
  14 mpbid 9 13 |- ( ph -> ( ( K x. V ) + -u V ) = ( K x. U ) )
  15 negsubd 11 2 |- ( ph -> ( ( K x. V ) + -u V ) = ( ( K x. V ) - V ) )
  16 eqtr3d 15 14 |- ( ph -> ( ( K x. V ) - V ) = ( K x. U ) )
  17 negeqd 16 |- ( ph -> -u ( ( K x. V ) - V ) = -u ( K x. U ) )
  18 negsubdi2d 11 2 |- ( ph -> -u ( ( K x. V ) - V ) = ( V - ( K x. V ) ) )
  19 eqtr3d 18 17 |- ( ph -> ( V - ( K x. V ) ) = -u ( K x. U ) )
  20 mulneg1d 3 1 |- ( ph -> ( -u K x. U ) = -u ( K x. U ) )
  21 eqtr4d 20 19 |- ( ph -> ( -u K x. U ) = ( V - ( K x. V ) ) )
  22 1cnd |- ( ph -> 1 e. CC )
  23 subdird 22 3 2 |- ( ph -> ( ( 1 - K ) x. V ) = ( ( 1 x. V ) - ( K x. V ) ) )
  24 mullidd 2 |- ( ph -> ( 1 x. V ) = V )
  25 oveq1d 24 |- ( ph -> ( ( 1 x. V ) - ( K x. V ) ) = ( V - ( K x. V ) ) )
  26 eqtrd 23 25 |- ( ph -> ( ( 1 - K ) x. V ) = ( V - ( K x. V ) ) )
  27 eqtr4d 21 26 |- ( ph -> ( -u K x. U ) = ( ( 1 - K ) x. V ) )
  28 oveq1d 27 |- ( ph -> ( ( -u K x. U ) x. V ) = ( ( ( 1 - K ) x. V ) x. V ) )
  29 negcld 3 |- ( ph -> -u K e. CC )
  30 mulassd 29 1 2 |- ( ph -> ( ( -u K x. U ) x. V ) = ( -u K x. ( U x. V ) ) )
  31 subcld 22 3 |- ( ph -> ( 1 - K ) e. CC )
  32 mulassd 31 2 2 |- ( ph -> ( ( ( 1 - K ) x. V ) x. V ) = ( ( 1 - K ) x. ( V x. V ) ) )
  33 3eqtr3d 28 30 32 |- ( ph -> ( -u K x. ( U x. V ) ) = ( ( 1 - K ) x. ( V x. V ) ) )
  34 0red |- ( ph -> 0 e. RR )
