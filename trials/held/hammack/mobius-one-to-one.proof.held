import definition         stdlib/functions/one-to-one
import mundane theorem    stdlib/sets/remove-member

theorem mobius-one-to-one
  note        Equal values (5s + 1)/(s − 2) = (5t + 1)/(t − 2) cross-multiply
              to 5st − 10s + t − 2 = 5st − 10t + s − 2, which says 11s = 11t.
  let f : ℝ ∖ {2} → ℝ                                                 (H1)
  assume for all x ∈ ℝ ∖ {2}, f(x) = (5x + 1)/(x − 2)                (H2)
  then f : ℝ ∖ {2} → ℝ is one-to-one

1.  For all s, t ∈ ℝ ∖ {2}, if f(s) = f(t) then s = t.
    proof
    let s ∈ ℝ ∖ {2}                                                   (K1)
    let t ∈ ℝ ∖ {2}                                                   (K2)
    assume f(s) = f(t)                                                (A1)

    1.1.  s ∈ ℝ. s ≠ 2.
          mun:remove-member u := s, Y := ℝ, a := 2, from K1

    1.2.  t ∈ ℝ. t ≠ 2.
          mun:remove-member u := t, Y := ℝ, a := 2, from K2

    1.3.  f(s) = (5s + 1)/(s − 2)
          instantiate x := s in H2, from K1

    1.4.  f(t) = (5t + 1)/(t − 2)
          instantiate x := t in H2, from K2

    1.5.  (5s + 1)/(s − 2) = (5t + 1)/(t − 2)
          calculation
            (5s + 1)/(s − 2) = f(s)                1.3
                             = f(t)                A1
                             = (5t + 1)/(t − 2)    1.4

    1.6.  s = t
          algebra, from 1.1, 1.2, 1.5
          requires s − 2 ≠ 0: inequalities, from 1.1
          requires t − 2 ≠ 0: inequalities, from 1.2

2.  f : ℝ ∖ {2} → ℝ is one-to-one
    def:one-to-one, from H1, 1
