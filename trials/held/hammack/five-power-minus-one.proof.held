import mundane theorem    stdlib/divisibility/divides-multiple
import mundane theorem    stdlib/divisibility/divides-sum
import mundane theorem    stdlib/numbers/exponent-step
import mundane theorem    stdlib/numbers/int-closure
import mundane theorem    stdlib/numbers/power-integer
import mundane theorem    stdlib/numbers/power-real

theorem five-power-minus-one
  note        By induction on n: 5^(2n + 2) − 1 is 25·(5^(2n) − 1) + 24, and
              3 divides both parts.
  let n ∈ ℕ₀                                                          (H1)
  then 3 divides 5^(2n) − 1

1.  For all k ∈ ℕ₀, 3 divides 5^(2k) − 1.
    induction on k starting at 0

    base
    1.1.  3 divides 5^(2·0) − 1
          arithmetic

    step
    let k ∈ ℕ₀                                                        (K)
    assume step 1 is true for k, the induction hypothesis             (IH)

    1.2.  2(k + 1) = (2k + 1) + 1
          algebra

    1.3.  5^(2(k + 1)) = 5^((2k + 1) + 1)
          substitute 2(k + 1) = (2k + 1) + 1 (line 1.2)

    1.4.  5^((2k + 1) + 1) = 5^(2k + 1)·5
          mun:exponent-step m := 2k + 1

    1.5.  5^(2k + 1) = 5^(2k)·5
          mun:exponent-step m := 2k

    1.6.  5^(2k + 1)·5 = 5^(2k)·5·5
          substitute 5^(2k + 1) = 5^(2k)·5 (line 1.5)

    1.7.  5^(2(k + 1)) = 5^(2k)·5·5
          calculation
            5^(2(k + 1)) = 5^((2k + 1) + 1)     1.3
                         = 5^(2k + 1)·5         1.4
                         = 5^(2k)·5·5           1.6

    1.8.  5^(2(k + 1)) − 1 = 5^(2k)·5·5 − 1
          substitute 5^(2(k + 1)) = 5^(2k)·5·5 (line 1.7)

    1.9.  5^(2k)·5·5 − 1 = (5^(2k) − 1)·25 + 24
          algebra
          requires 5^(2k) ∈ ℝ: mun:power-real a := 5, m := 2k

    1.10. 5^(2(k + 1)) − 1 = (5^(2k) − 1)·25 + 24
          calculation
            5^(2(k + 1)) − 1 = 5^(2k)·5·5 − 1          1.8
                             = (5^(2k) − 1)·25 + 24    1.9

    1.11. 3 divides (5^(2k) − 1)·25
          mun:divides-multiple e := 3, a := 5^(2k) − 1, x := 25, from IH
          requires 5^(2k) ∈ ℤ: mun:power-integer a := 5, m := 2k
          requires 5^(2k) − 1 ∈ ℤ: mun:int-closure

    1.12. 3 divides 24
          arithmetic

    1.13. 3 divides (5^(2k) − 1)·25 + 24
          mun:divides-sum d := 3, a := (5^(2k) − 1)·25, b := 24, from 1.11, 1.12
          requires 5^(2k) ∈ ℤ: mun:power-integer a := 5, m := 2k
          requires (5^(2k) − 1)·25 ∈ ℤ: mun:int-closure

    1.14. 3 divides 5^(2(k + 1)) − 1
          substitute 5^(2(k + 1)) − 1 = (5^(2k) − 1)·25 + 24 (line 1.10) into line 1.13

2.  3 divides 5^(2n) − 1
    instantiate k := n in line 1
