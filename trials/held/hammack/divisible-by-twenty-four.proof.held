import mundane theorem    stdlib/divisibility/divides-multiple
import mundane theorem    stdlib/divisibility/divides-self
import mundane theorem    stdlib/divisibility/divides-sum
import mundane theorem    stdlib/numbers/exponent-step
import mundane theorem    stdlib/numbers/int-closure
import mundane theorem    stdlib/numbers/power-integer
import mundane theorem    stdlib/numbers/power-real

theorem divisible-by-twenty-four
  note        By induction on n: 5^(2(m + 1)) − 1 is 25·(5^(2m) − 1) + 24, and
              24 divides both parts.
  let n ∈ ℕ₀                                                          (H1)
  then 24 divides 5^(2n) − 1

1.  For all m ∈ ℕ₀, 24 divides 5^(2m) − 1.
    induction on m starting at 0

    base
    1.1.  24 divides 5^(2·0) − 1
          arithmetic

    step
    let m ∈ ℕ₀                                                        (K)
    assume step 1 is true for m, the induction hypothesis             (IH)

    1.2.  2(m + 1) = (2m + 1) + 1
          algebra

    1.3.  5^((2m + 1) + 1) = 5^(2m + 1)·5
          mun:exponent-step a := 5, m := 2m + 1

    1.4.  5^(2m + 1) = 5^(2m)·5
          mun:exponent-step a := 5, m := 2m

    1.5.  5^(2(m + 1)) = 5^((2m + 1) + 1)
          substitute 2(m + 1) = (2m + 1) + 1 (line 1.2)

    1.6.  5^(2m + 1)·5 = 5^(2m)·5·5
          substitute 5^(2m + 1) = 5^(2m)·5 (line 1.4)

    1.7.  5^(2m)·5·5 = 25·5^(2m)
          algebra
          requires 5^(2m) ∈ ℝ: mun:power-real a := 5, m := 2m

    1.8.  5^(2(m + 1)) = 25·5^(2m)
          calculation
            5^(2(m + 1)) = 5^((2m + 1) + 1)     1.5
                         = 5^(2m + 1)·5         1.3
                         = 5^(2m)·5·5           1.6
                         = 25·5^(2m)            1.7

    1.9.  24 divides (5^(2m) − 1)·25
          mun:divides-multiple e := 24, a := 5^(2m) − 1, x := 25, from IH
          requires 5^(2m) ∈ ℤ: mun:power-integer a := 5, m := 2m
          requires 5^(2m) − 1 ∈ ℤ: mun:int-closure a := 5^(2m)

    1.10. 24 divides 24
          mun:divides-self n := 24

    1.11. 24 divides (5^(2m) − 1)·25 + 24
          mun:divides-sum d := 24, a := (5^(2m) − 1)·25, b := 24, from 1.9, 1.10
          requires 5^(2m) ∈ ℤ: mun:power-integer a := 5, m := 2m
          requires (5^(2m) − 1)·25 ∈ ℤ: mun:int-closure a := 5^(2m) − 1, b := 25

    1.12. 25·5^(2m) − 1 = (5^(2m) − 1)·25 + 24
          algebra
          requires 5^(2m) ∈ ℝ: mun:power-real a := 5, m := 2m

    1.13. 5^(2(m + 1)) − 1 = 25·5^(2m) − 1
          substitute 5^(2(m + 1)) = 25·5^(2m) (line 1.8)

    1.14. 5^(2(m + 1)) − 1 = (5^(2m) − 1)·25 + 24
          calculation
            5^(2(m + 1)) − 1 = 25·5^(2m) − 1                 1.13
                             = (5^(2m) − 1)·25 + 24          1.12

    1.15. 24 divides 5^(2(m + 1)) − 1
          substitute 5^(2(m + 1)) − 1 = (5^(2m) − 1)·25 + 24 (line 1.14) into line 1.11

2.  24 divides 5^(2n) − 1
    instantiate m := n in line 1
