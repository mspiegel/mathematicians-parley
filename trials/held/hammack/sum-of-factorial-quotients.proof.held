import mundane definition stdlib/counting/factorial
import mundane theorem    stdlib/counting/factorial-nat
import mundane theorem    stdlib/counting/factorial-nonzero
import mundane theorem    stdlib/functions/function-into
import mundane theorem    stdlib/numbers/multiply-cancel
import mundane theorem    stdlib/sums/range-nat
import mundane theorem    stdlib/sums/sum-extended
import mundane theorem    stdlib/sums/sum-single
import mundane theorem    stdlib/sums/sum-termwise

theorem product-nonzero
  note        If x·y were 0, then x·y = 0·y, and y ≠ 0 lets y cancel, leaving
              x = 0.
  let x ∈ ℝ                                                           (H1)
  let y ∈ ℝ                                                           (H2)
  assume x ≠ 0                                                        (H3)
  assume y ≠ 0                                                        (H4)
  then x·y ≠ 0

1.  x·y ≠ 0
    contradiction
    suppose x·y = 0                                                   (S)

    1.1.  0·y = 0
          algebra

    1.2.  x·y = 0·y
          calculation
            x·y = 0       S
                = 0·y     1.1

    1.3.  x = 0
          mun:multiply-cancel a := x, b := 0, c := y, from H4, 1.2, contradicting H3

theorem first-term-sum
  note        A sum of one term is that term.
  let t : ℕ → ℝ                                                       (H1)
  then Σ(j = 1 to 1) t(j) = t(1)

1.  Σ(j = 1 to 1) t(j) = t(1)
    mun:sum-single a := 1

theorem next-term-sum
  note        The sum to k + 1 is the sum to k and the term k + 1.
  let k ∈ ℕ                                                           (H1)
  let t : ℕ → ℝ                                                       (H2)
  then Σ(j = 1 to k + 1) t(j) = Σ(j = 1 to k) t(j) + t(k + 1)

1.  Σ(j = 1 to k + 1) t(j) = Σ(j = 1 to k) t(j) + t(k + 1)
    mun:sum-extended a := 1, n := k
    requires k ≥ 1: from H1

theorem quotient-terms-sum
  note        Where the terms t(k) are k/(k + 1)!, the sums of the two agree
              term by term.
  let n ∈ ℕ                                                           (H1)
  let t : ℕ → ℝ                                                       (H2)
  assume for all k ∈ ℕ, t(k) = k/(k + 1)!                            (H3)
  then Σ(k = 1 to n) t(k) = Σ(k = 1 to n) k/(k + 1)!

1.  For all k ∈ {1, …, n}, k/(k + 1)! ∈ ℝ.
    proof
    let k ∈ {1, …, n}                                                 (J)

    1.1.  k ∈ ℕ
          mun:range-nat, from J

    1.2.  (k + 1)! ≠ 0
          mun:factorial-nonzero n := k + 1, from 1.1

    1.3.  (k + 1)! ∈ ℕ
          mun:factorial-nat n := k + 1, from 1.1

    1.4.  k/(k + 1)! ∈ ℝ
          membership, from 1.1, 1.2, 1.3

2.  Σ(k = 1 to n) t(k) = Σ(k = 1 to n) k/(k + 1)!
    mun:sum-termwise a := 1, b := n, from H3

theorem sum-of-factorial-quotients
  note        By induction on n: adding (k + 1)/(k + 2)! to 1 − 1/(k + 1)!
              gives 1 − 1/(k + 2)!, since (k + 2)! is (k + 1)!·(k + 2).
  let n ∈ ℕ                                                           (H1)
  then Σ(k = 1 to n) k/(k + 1)! = 1 − 1/(n + 1)!

let t(j) = j/(j + 1)!, for j ∈ ℕ                                      (D1)
       reads the j-th term

let S(m) = Σ(j = 1 to m) t(j), for m ∈ ℕ                              (D2)
       reads the sum of the first m terms

1.  For all j ∈ ℕ, j/(j + 1)! ∈ ℝ.
    proof
    let j ∈ ℕ                                                         (J)

    1.1.  (j + 1)! ≠ 0
          mun:factorial-nonzero n := j + 1

    1.2.  (j + 1)! ∈ ℕ
          mun:factorial-nat n := j + 1

    1.3.  j/(j + 1)! ∈ ℝ
          membership, from 1.1, 1.2

2.  For all j ∈ ℕ, t(j) = j/(j + 1)!.
    D1

3.  For all j ∈ ℕ, t(j) ∈ ℝ.
    proof
    let j ∈ ℕ                                                         (J2)

    3.1.  t(j) = j/(j + 1)!
          instantiate j := j in line 2

    3.2.  j/(j + 1)! ∈ ℝ
          instantiate j := j in line 1

    3.3.  t(j) ∈ ℝ
          substitute t(j) = j/(j + 1)! (line 3.1) into line 3.2

4.  t : ℕ → ℝ
    mun:function-into, from 3
    requires t is a function on ℕ: from D1

5.  For all k ∈ ℕ, S(k) = 1 − 1/(k + 1)!.
    induction on k starting at 1

    base
    5.1.  Σ(j = 1 to 1) t(j) = t(1)
          thm:first-term-sum
          requires t : ℕ → ℝ: from 4

    5.2.  t(1) = 1/(1 + 1)!
          instantiate j := 1 in line 2

    5.3.  1! = 1
          mun:factorial

    5.4.  (1 + 1)! = 1!·(1 + 1)
          mun:factorial n := 1

    5.5.  1!·(1 + 1) = 1·(1 + 1)
          substitute 1! = 1 (line 5.3)

    5.6.  (1 + 1)! = 2
          calculation
            (1 + 1)! = 1!·(1 + 1)     5.4
                     = 1·(1 + 1)      5.5
                     = 2              arithmetic

    5.7.  1/(1 + 1)! = 1/2
          substitute (1 + 1)! = 2 (line 5.6)

    5.8.  1 − 1/(1 + 1)! = 1 − 1/2
          substitute (1 + 1)! = 2 (line 5.6)

    5.9.  S(1) = 1 − 1/(1 + 1)!
          calculation
            S(1) = Σ(j = 1 to 1) t(j)     D2
                 = t(1)                   5.1
                 = 1/(1 + 1)!             5.2
                 = 1/2                    5.7
                 = 1 − 1/2                arithmetic
                 = 1 − 1/(1 + 1)!         5.8

    step
    let k ∈ ℕ                                                         (K)
    assume step 5 is true for k, the induction hypothesis             (IH)

    5.10. Σ(j = 1 to k + 1) t(j) = Σ(j = 1 to k) t(j) + t(k + 1)
          thm:next-term-sum
          requires t : ℕ → ℝ: from 4

    5.11. S(k + 1) = S(k) + t(k + 1)
          calculation
            S(k + 1) = Σ(j = 1 to k + 1) t(j)                D2
                     = Σ(j = 1 to k) t(j) + t(k + 1)         5.10
                     = S(k) + t(k + 1)                       D2

    5.12. t(k + 1) = (k + 1)/((k + 1) + 1)!
          instantiate j := k + 1 in line 2

    5.13. S(k) + t(k + 1) = 1 − 1/(k + 1)! + t(k + 1)
          substitute S(k) = 1 − 1/(k + 1)! (IH)

    5.14. 1 − 1/(k + 1)! + t(k + 1) = 1 − 1/(k + 1)! + (k + 1)/((k + 1) + 1)!
          substitute t(k + 1) = (k + 1)/((k + 1) + 1)! (line 5.12)

    5.15. ((k + 1) + 1)! = (k + 1)!·((k + 1) + 1)
          mun:factorial n := k + 1

    5.16. 1 − 1/(k + 1)! + (k + 1)/((k + 1) + 1)! = 1 − 1/(k + 1)! + (k + 1)/((k + 1)!·((k + 1) + 1))
          substitute ((k + 1) + 1)! = (k + 1)!·((k + 1) + 1) (line 5.15)

    5.17. (k + 1)! ∈ ℕ
          mun:factorial-nat n := k + 1

    5.18. 1 − 1/(k + 1)! + (k + 1)/((k + 1)!·((k + 1) + 1)) = 1 − 1/((k + 1)!·((k + 1) + 1))
          algebra
          requires (k + 1)! ∈ ℝ: from 5.17
          requires (k + 1)! ≠ 0: mun:factorial-nonzero n := k + 1
          requires (k + 1) + 1 ≠ 0: inequalities, from K
          requires (k + 1)!·((k + 1) + 1) ≠ 0: thm:product-nonzero x := (k + 1)!, y := (k + 1) + 1

    5.19. 1 − 1/((k + 1)!·((k + 1) + 1)) = 1 − 1/((k + 1) + 1)!
          substitute ((k + 1) + 1)! = (k + 1)!·((k + 1) + 1) (line 5.15)

    5.20. S(k + 1) = 1 − 1/((k + 1) + 1)!
          calculation
            S(k + 1) = S(k) + t(k + 1)                                              5.11
                     = 1 − 1/(k + 1)! + t(k + 1)                                    5.13
                     = 1 − 1/(k + 1)! + (k + 1)/((k + 1) + 1)!                      5.14
                     = 1 − 1/(k + 1)! + (k + 1)/((k + 1)!·((k + 1) + 1))            5.16
                     = 1 − 1/((k + 1)!·((k + 1) + 1))                               5.18
                     = 1 − 1/((k + 1) + 1)!                                         5.19

6.  S(n) = 1 − 1/(n + 1)!
    instantiate k := n in line 5

7.  For all k ∈ ℕ, k/(k + 1)! = k/(k + 1)!.
    proof
    let k ∈ ℕ                                                         (J3)

    7.1.  (k + 1)! ∈ ℕ
          mun:factorial-nat n := k + 1

    7.2.  k/(k + 1)! = k/(k + 1)!
          algebra
          requires (k + 1)! ∈ ℝ: from 7.1
          requires (k + 1)! ≠ 0: mun:factorial-nonzero n := k + 1

8.  Σ(k = 1 to n) t(k) = Σ(k = 1 to n) k/(k + 1)!
    thm:quotient-terms-sum t := t, from D1, 7
    requires t : ℕ → ℝ: from 4

9.  S(n) = Σ(k = 1 to n) t(k)
    D2

10. Σ(k = 1 to n) k/(k + 1)! = 1 − 1/(n + 1)!
    calculation
      Σ(k = 1 to n) k/(k + 1)! = Σ(k = 1 to n) t(k)     8
                               = S(n)                   9
                               = 1 − 1/(n + 1)!         6
