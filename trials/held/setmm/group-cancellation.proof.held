import axiom              stdlib/groups/group-associative
import axiom              stdlib/groups/group-closed
import axiom              stdlib/groups/group-identity
import axiom              stdlib/groups/group-identity-closed
import axiom              stdlib/groups/group-inverse
import axiom              stdlib/groups/group-inverse-closed
import definition         stdlib/groups/coset
import mundane theorem    stdlib/groups/subgroup-closed
import mundane theorem    stdlib/groups/subgroup-inverse

theorem the-left-inverse
  note        The inverse also works from the left: t = a⁻¹·a satisfies
              t·t = t, and the only element with that property is e.
  let G be a group with operation · and identity e                    (H1)
  let a ∈ G                                                           (H2)
  then a⁻¹·a = e

1.  e ∈ G
    axi:group-identity-closed

2.  a⁻¹ ∈ G
    axi:group-inverse-closed, from H2

3.  a⁻¹·a ∈ G
    axi:group-closed a := a⁻¹, b := a, from H2, 2

4.  (a⁻¹·a)⁻¹ ∈ G
    axi:group-inverse-closed a := a⁻¹·a, from 3

5.  (a⁻¹·a)·(a⁻¹·a) = a⁻¹·(a·(a⁻¹·a))
    axi:group-associative a := a⁻¹, b := a, c := a⁻¹·a, from H2, 2, 3

6.  a·(a⁻¹·a) = (a·a⁻¹)·a
    axi:group-associative b := a⁻¹, c := a, from H2, 2

7.  a·a⁻¹ = e
    axi:group-inverse, from H2

8.  a·(a⁻¹·a) = e·a
    substitute a·a⁻¹ = e (line 7) into line 6

9.  a⁻¹·(e·a) = (a⁻¹·e)·a
    axi:group-associative a := a⁻¹, b := e, c := a, from H2, 1, 2

10. a⁻¹·e = a⁻¹
    axi:group-identity a := a⁻¹, from 2

11. a⁻¹·(e·a) = a⁻¹·a
    substitute a⁻¹·e = a⁻¹ (line 10) into line 9

12. (a⁻¹·a)·(a⁻¹·a) = a⁻¹·(e·a)
    substitute a·(a⁻¹·a) = e·a (line 8) into line 5

13. (a⁻¹·a)·(a⁻¹·a) = a⁻¹·a
    calculation
    (a⁻¹·a)·(a⁻¹·a) = a⁻¹·(e·a)     12
                    = a⁻¹·a         11

14. (a⁻¹·a)·(a⁻¹·a)⁻¹ = e
    axi:group-inverse a := a⁻¹·a, from 3

15. ((a⁻¹·a)·(a⁻¹·a))·(a⁻¹·a)⁻¹ = (a⁻¹·a)·((a⁻¹·a)·(a⁻¹·a)⁻¹)
    axi:group-associative a := a⁻¹·a, b := a⁻¹·a, c := (a⁻¹·a)⁻¹, from 3, 4

16. (a⁻¹·a)·(a⁻¹·a)⁻¹ = (a⁻¹·a)·((a⁻¹·a)·(a⁻¹·a)⁻¹)
    substitute (a⁻¹·a)·(a⁻¹·a) = a⁻¹·a (line 13) into line 15

17. e = (a⁻¹·a)·e
    substitute (a⁻¹·a)·(a⁻¹·a)⁻¹ = e (line 14) into line 16

18. (a⁻¹·a)·e = a⁻¹·a
    axi:group-identity a := a⁻¹·a, from 3

19. e = a⁻¹·a
    substitute (a⁻¹·a)·e = a⁻¹·a (line 18) into line 17

20. a⁻¹·a = e
    calculation
    a⁻¹·a = (a⁻¹·a)·e     18
          = e             17

theorem the-left-identity
  note        e also works from the left: e·a is (a·a⁻¹)·a, which is
              a·(a⁻¹·a) = a·e = a.
  let G be a group with operation · and identity e                    (H1)
  let a ∈ G                                                           (H2)
  then e·a = a

1.  a⁻¹ ∈ G
    axi:group-inverse-closed, from H2

2.  a·a⁻¹ = e
    axi:group-inverse, from H2

3.  (a·a⁻¹)·a = a·(a⁻¹·a)
    axi:group-associative b := a⁻¹, c := a, from H2, 1

4.  a⁻¹·a = e
    thm:the-left-inverse, from H2

5.  (a·a⁻¹)·a = a·e
    substitute a⁻¹·a = e (line 4) into line 3

6.  e·a = a·e
    substitute a·a⁻¹ = e (line 2) into line 5

7.  a·e = a
    axi:group-identity, from H2

8.  e·a = a
    calculation
    e·a = a·e     6
        = a       7

theorem left-cancellation
  note        Multiplying by g⁻¹ on the left undoes multiplying by g.
  let G be a group with operation · and identity e                    (H1)
  let a ∈ G                                                           (H2)
  let b ∈ G                                                           (H3)
  let g ∈ G                                                           (H4)
  then g·a = g·b ↔ a = b

1.  g·a = g·b ↔ a = b
    both directions

    direction
    assume g·a = g·b                                                  (D1)

    1.1.  g⁻¹ ∈ G
          axi:group-inverse-closed a := g, from H4

    1.2.  g⁻¹·g = e
          thm:the-left-inverse a := g, from H4

    1.3.  (g⁻¹·g)·a = g⁻¹·(g·a)
          axi:group-associative a := g⁻¹, b := g, c := a, from H2, H4, 1.1

    1.4.  (g⁻¹·g)·b = g⁻¹·(g·b)
          axi:group-associative a := g⁻¹, b := g, c := b, from H3, H4, 1.1

    1.5.  e·a = a
          thm:the-left-identity, from H2

    1.6.  e·b = b
          thm:the-left-identity a := b, from H3

    1.7.  e·a = g⁻¹·(g·a)
          substitute g⁻¹·g = e (line 1.2) into line 1.3

    1.8.  e·a = g⁻¹·(g·b)
          substitute g·a = g·b (D1) into line 1.7

    1.9.  e·b = g⁻¹·(g·b)
          substitute g⁻¹·g = e (line 1.2) into line 1.4

    1.10. a = b
          calculation
          a = e·a               1.5
            = g⁻¹·(g·b)         1.8
            = e·b               1.9
            = b                 1.6

    direction
    assume a = b                                                      (D2)

    1.11. g·a = g·b
          substitute a = b (D2)

theorem right-cancellation
  note        Multiplying by g⁻¹ on the right undoes multiplying by g.
  let G be a group with operation · and identity e                    (H1)
  let a ∈ G                                                           (H2)
  let b ∈ G                                                           (H3)
  let g ∈ G                                                           (H4)
  then a·g = b·g ↔ a = b

1.  a·g = b·g ↔ a = b
    both directions

    direction
    assume a·g = b·g                                                  (D1)

    1.1.  g⁻¹ ∈ G
          axi:group-inverse-closed a := g, from H4

    1.2.  g·g⁻¹ = e
          axi:group-inverse a := g, from H4

    1.3.  (a·g)·g⁻¹ = a·(g·g⁻¹)
          axi:group-associative b := g, c := g⁻¹, from H2, H4, 1.1

    1.4.  (a·g)·g⁻¹ = a·e
          substitute g·g⁻¹ = e (line 1.2) into line 1.3

    1.5.  (b·g)·g⁻¹ = a·e
          substitute a·g = b·g (D1) into line 1.4

    1.6.  (b·g)·g⁻¹ = b·(g·g⁻¹)
          axi:group-associative a := b, b := g, c := g⁻¹, from H3, H4, 1.1

    1.7.  (b·g)·g⁻¹ = b·e
          substitute g·g⁻¹ = e (line 1.2) into line 1.6

    1.8.  a·e = a
          axi:group-identity, from H2

    1.9.  b·e = b
          axi:group-identity a := b, from H3

    1.10. a = b
          calculation
          a = a·e               1.8
            = (b·g)·g⁻¹         1.5
            = b·e               1.7
            = b                 1.9

    direction
    assume a = b                                                      (D2)

    1.11. a·g = b·g
          substitute a = b (D2)

theorem inverse-reverses-products
  note        Undoing a·b undoes b first. b⁻¹·a⁻¹ does that: b·(b⁻¹·a⁻¹)
              is a⁻¹, so (a·b)·(b⁻¹·a⁻¹) is a·a⁻¹ = e, as (a·b)·(a·b)⁻¹ is,
              and cancelling a·b leaves the two inverses equal. The group's
              operation is not taken to commute.
  let G be a group with operation · and identity e                    (H1)
  let a ∈ G                                                           (H2)
  let b ∈ G                                                           (H3)
  then (a·b)⁻¹ = b⁻¹·a⁻¹

1.  a·b ∈ G
    axi:group-closed, from H2, H3

2.  a⁻¹ ∈ G
    axi:group-inverse-closed, from H2

3.  b⁻¹ ∈ G
    axi:group-inverse-closed a := b, from H3

4.  b⁻¹·a⁻¹ ∈ G
    axi:group-closed a := b⁻¹, b := a⁻¹, from 2, 3

5.  (a·b)⁻¹ ∈ G
    axi:group-inverse-closed a := a·b, from 1

6.  (b·b⁻¹)·a⁻¹ = b·(b⁻¹·a⁻¹)
    axi:group-associative a := b, b := b⁻¹, c := a⁻¹, from H3, 2, 3

7.  b·b⁻¹ = e
    axi:group-inverse a := b, from H3

8.  e·a⁻¹ = b·(b⁻¹·a⁻¹)
    substitute b·b⁻¹ = e (line 7) into line 6

9.  e·a⁻¹ = a⁻¹
    thm:the-left-identity a := a⁻¹, from 2

10. b·(b⁻¹·a⁻¹) = a⁻¹
    calculation
    b·(b⁻¹·a⁻¹) = e·a⁻¹     8
                = a⁻¹       9

11. (a·b)·(b⁻¹·a⁻¹) = a·(b·(b⁻¹·a⁻¹))
    axi:group-associative c := b⁻¹·a⁻¹, from H2, H3, 4

12. (a·b)·(b⁻¹·a⁻¹) = a·a⁻¹
    substitute b·(b⁻¹·a⁻¹) = a⁻¹ (line 10) into line 11

13. a·a⁻¹ = e
    axi:group-inverse, from H2

14. (a·b)·(a·b)⁻¹ = e
    axi:group-inverse a := a·b, from 1

15. (a·b)·(a·b)⁻¹ = (a·b)·(b⁻¹·a⁻¹)
    calculation
    (a·b)·(a·b)⁻¹ = e                  14
                  = a·a⁻¹              13
                  = (a·b)·(b⁻¹·a⁻¹)    12

16. (a·b)⁻¹ = b⁻¹·a⁻¹
    thm:left-cancellation a := (a·b)⁻¹, b := b⁻¹·a⁻¹, g := a·b, from 1, 4, 5, 15

theorem quotient-times-divisor
  note        Dividing by b and multiplying by b again changes nothing:
              (a·b⁻¹)·b = a·(b⁻¹·b) = a·e = a.
  let G be a group with operation · and identity e                    (H1)
  let a ∈ G                                                           (H2)
  let b ∈ G                                                           (H3)
  then (a·b⁻¹)·b = a

1.  b⁻¹ ∈ G
    axi:group-inverse-closed a := b, from H3

2.  (a·b⁻¹)·b = a·(b⁻¹·b)
    axi:group-associative b := b⁻¹, c := b, from H2, H3, 1

3.  b⁻¹·b = e
    thm:the-left-inverse a := b, from H3

4.  (a·b⁻¹)·b = a·e
    substitute b⁻¹·b = e (line 3) into line 2

5.  a·e = a
    axi:group-identity, from H2

6.  (a·b⁻¹)·b = a
    calculation
    (a·b⁻¹)·b = a·e     4
              = a       5

theorem quotient-is-identity
  note        a·b⁻¹ is e exactly when a = b: if it is e, then a is
              (a·b⁻¹)·b = e·b = b; and b·b⁻¹ is e.
  let G be a group with operation · and identity e                    (H1)
  let a ∈ G                                                           (H2)
  let b ∈ G                                                           (H3)
  then a·b⁻¹ = e ↔ a = b

1.  a·b⁻¹ = e ↔ a = b
    both directions

    direction
    assume a·b⁻¹ = e                                                  (D1)

    1.1.  (a·b⁻¹)·b = a
          thm:quotient-times-divisor, from H2, H3

    1.2.  e·b = a
          substitute a·b⁻¹ = e (D1) into line 1.1

    1.3.  e·b = b
          thm:the-left-identity a := b, from H3

    1.4.  a = b
          calculation
          a = e·b     1.2
            = b       1.3

    direction
    assume a = b                                                      (D2)

    1.5.  a·b⁻¹ = b·b⁻¹
          substitute a = b (D2)

    1.6.  b·b⁻¹ = e
          axi:group-inverse a := b, from H3

    1.7.  a·b⁻¹ = e
          calculation
          a·b⁻¹ = b·b⁻¹     1.5
                = e         1.6

theorem quotient-and-product
  note        a·b⁻¹ is c exactly when c·b is a: multiplying a·b⁻¹ by b gives
              a back, and multiplying c·b by b⁻¹ gives c back.
  let G be a group with operation · and identity e                    (H1)
  let a ∈ G                                                           (H2)
  let b ∈ G                                                           (H3)
  let c ∈ G                                                           (H4)
  then a·b⁻¹ = c ↔ c·b = a

1.  a·b⁻¹ = c ↔ c·b = a
    both directions

    direction
    assume a·b⁻¹ = c                                                  (D1)

    1.1.  (a·b⁻¹)·b = a
          thm:quotient-times-divisor, from H2, H3

    1.2.  c·b = a
          substitute a·b⁻¹ = c (D1) into line 1.1

    direction
    assume c·b = a                                                    (D2)

    1.3.  b⁻¹ ∈ G
          axi:group-inverse-closed a := b, from H3

    1.4.  a·b⁻¹ = (c·b)·b⁻¹
          substitute c·b = a (D2)

    1.5.  (c·b)·b⁻¹ = c·(b·b⁻¹)
          axi:group-associative a := c, c := b⁻¹, from H3, H4, 1.3

    1.6.  b·b⁻¹ = e
          axi:group-inverse a := b, from H3

    1.7.  (c·b)·b⁻¹ = c·e
          substitute b·b⁻¹ = e (line 1.6) into line 1.5

    1.8.  c·e = c
          axi:group-identity a := c, from H4

    1.9.  a·b⁻¹ = c
          calculation
          a·b⁻¹ = (c·b)·b⁻¹     1.4
                = c·e           1.7
                = c             1.8

theorem subgroup-quotient
  note        A subgroup holds a·b⁻¹ for any two of its members: it holds
              b⁻¹, and then the product.
  let G be a group with operation · and identity e                    (H1)
  assume H is a subgroup of G                                         (H2)
  let a ∈ H                                                           (H3)
  let b ∈ H                                                           (H4)
  then a·b⁻¹ ∈ H

1.  b⁻¹ ∈ H
    mun:subgroup-inverse a := b, from H2, H4

2.  a·b⁻¹ ∈ H
    mun:subgroup-closed b := b⁻¹, from H2, H3, 1

theorem element-of-its-coset
  note        g·h is g combined with a member of H, which is what gH holds.
  let G be a group with operation · and identity e                    (H1)
  assume H is a subgroup of G                                         (H2)
  let g ∈ G                                                           (H3)
  let h ∈ H                                                           (H4)
  then g·h ∈ gH

1.  There is k ∈ H with g·h = g·k.
    exhibit, from H4

2.  g·h ∈ gH
    def:coset u := g·h, from H2, H3, 1
