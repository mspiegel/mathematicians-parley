import definition         stdlib/calculus/tends-to
import mundane theorem    stdlib/numbers/abs-difference-lt
import mundane theorem    stdlib/numbers/le-antisymmetric
import mundane theorem    stdlib/numbers/nat-closure

theorem limit-at-most
  note        Far enough along, x(n) is within r/2 of A and within r/2 of B,
              so A is under B + r for every r > 0. Were A above B, taking
              r = (A − B)/2 would put A under the midpoint of A and B.
  ε, r range over ℝ
  n ranges over ℕ
  let x : ℕ → ℝ                                                       (H1)
  let A ∈ ℝ                                                           (H2)
  let B ∈ ℝ                                                           (H3)
  assume x(n) → A as n → ∞                                            (H4)
  assume x(n) → B as n → ∞                                            (H5)
  then A ≤ B

1.  For all r > 0, A < B + r.
    proof
    let r ∈ ℝ                                                         (K1)
    assume r > 0                                                      (A1)

    1.1.  r/2 > 0
          inequalities, from A1

    1.2.  For all ε > 0, there exists N ∈ ℕ such that |x(n) − A| < ε for all n ≥ N.
          def:tends-to L := A, from H4

    1.3.  There exists N ∈ ℕ such that |x(n) − A| < r/2 for all n ≥ N.
          instantiate ε := r/2 in line 1.2, from 1.1

    1.4.  N₁ ∈ ℕ. |x(n) − A| < r/2 for all n ≥ N₁.
          obtain N₁ from line 1.3

    1.5.  For all ε > 0, there exists N ∈ ℕ such that |x(n) − B| < ε for all n ≥ N.
          def:tends-to L := B, from H5

    1.6.  There exists N ∈ ℕ such that |x(n) − B| < r/2 for all n ≥ N.
          instantiate ε := r/2 in line 1.5, from 1.1

    1.7.  N₂ ∈ ℕ. |x(n) − B| < r/2 for all n ≥ N₂.
          obtain N₂ from line 1.6

    1.8.  N₁ + N₂ ∈ ℕ
          mun:nat-closure

    1.9.  N₁ + N₂ ≥ N₁. N₁ + N₂ ≥ N₂.
          inequalities, from 1.4, 1.7

    1.10. |x(N₁ + N₂) − A| < r/2
          instantiate n := N₁ + N₂ in line 1.4, from 1.9

    1.11. |x(N₁ + N₂) − B| < r/2
          instantiate n := N₁ + N₂ in line 1.7, from 1.9

    1.12. A − r/2 < x(N₁ + N₂) and x(N₁ + N₂) < A + r/2
          mun:abs-difference-lt x := x(N₁ + N₂), c := A, δ := r/2, from 1.10
          requires x(N₁ + N₂) ∈ ℝ: from H1, 1.8

    1.13. B − r/2 < x(N₁ + N₂) and x(N₁ + N₂) < B + r/2
          mun:abs-difference-lt x := x(N₁ + N₂), c := B, δ := r/2, from 1.11
          requires x(N₁ + N₂) ∈ ℝ: from H1, 1.8

    1.14. A < B + r
          inequalities, from 1.12, 1.13
          requires x(N₁ + N₂) ∈ ℝ: from H1, 1.8

2.  A ≤ B
    contradiction
    suppose not (A ≤ B)                                               (S)

    2.1.  A − B > 0
          inequalities, from S

    2.2.  (A − B)/2 > 0
          inequalities, from 2.1

    2.3.  A < B + (A − B)/2
          instantiate r := (A − B)/2 in line 1, from 2.2

    2.4.  not (A < B + (A − B)/2)
          inequalities, from 2.1, contradicting 2.3

theorem limit-unique
  note        A is at most B and B is at most A, by limit-at-most each way
              round.
  let x : ℕ → ℝ                                                       (H1)
  let A ∈ ℝ                                                           (H2)
  let B ∈ ℝ                                                           (H3)
  assume x(n) → A as n → ∞                                            (H4)
  assume x(n) → B as n → ∞                                            (H5)
  then A = B

1.  A ≤ B
    thm:limit-at-most, from H4, H5

2.  B ≤ A
    thm:limit-at-most A := B, B := A, from H4, H5

3.  A = B
    mun:le-antisymmetric, from 1, 2
