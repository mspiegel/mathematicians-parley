import theorem            proofs/setmm/size-of-difference/size-of-difference
import mundane theorem    stdlib/counting/card-pair-distinct
import mundane theorem    stdlib/sets/pair-subset

theorem size-without-a-pair
  metamath    hashdifpr
  note        Two different elements B and C make a part of A with 2 elements,
              and taking a part away takes its size away.
  let A be a set                                                      (H1)
  let B ∈ A                                                           (H2)
  let C ∈ A                                                           (H3)
  assume A is finite                                                  (H4)
  assume B ≠ C                                                        (H5)
  then |A ∖ {B, C}| = |A| − 2

1.  {B, C} ⊆ A
    mun:pair-subset a := B, b := C, X := A, from H2, H3

2.  |A ∖ {B, C}| = |A| − |{B, C}|
    thm:size-of-difference B := {B, C}, from H4, 1

3.  |{B, C}| = 2
    mun:card-pair-distinct u := B, w := C, from H5

4.  |A ∖ {B, C}| = |A| − 2
    substitute |{B, C}| = 2 (line 3) into line 2
