import definition         stdlib/functions/image
import mundane theorem    stdlib/functions/value-in-image
import mundane theorem    stdlib/sets/in-subset
import definition         stdlib/sets/subset
import mundane theorem    stdlib/sets/subset-self

theorem image-of-part
  note        A point F sends a point of X to is a point F sends a point of A to, since X lies inside A.
  let A be a set                                                      (H1)
  let B be a set                                                      (H2)
  let F : A → B                                                       (H3)
  let X ⊆ A                                                           (H4)
  then F[X] ⊆ F[A]

1.  For all u ∈ F[X], u ∈ F[A].
    proof
    let u ∈ F[X]                                                      (K1)

    1.1.  s ∈ X. u = F(s).
          obtain s: def:image Y := X, from H4, K1

    1.2.  s ∈ A
          mun:in-subset, from H4, 1.1

    1.3.  F(s) ∈ F[A]
          mun:value-in-image Y := A, from 1.2
          requires A ⊆ A: mun:subset-self

    1.4.  u ∈ F[A]
          substitute u = F(s) (line 1.1) into line 1.3

2.  F[X] ⊆ F[A]
    def:subset, from 1
