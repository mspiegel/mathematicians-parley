import mundane definition stdlib/sets/difference
import mundane axiom      stdlib/reasoning/excluded-middle
import mundane theorem    stdlib/numbers/nat-closure
import mundane theorem    stdlib/numbers/pos-int-nat
import mundane definition stdlib/numbers/rational

theorem irrational-times-rational
  note        If A·B were a fraction r/s and B the fraction p/q with p not 0,
              then A would be rq/(sp), a fraction, and A would be rational.
              The denominator sp is a natural number when p is above 0, and
              otherwise A is (−rq)/(s(−p)).
  let A be an element                                                 (H1)
  let B ∈ ℝ                                                           (H2)
  assume A ∈ ℝ ∖ ℚ                                                    (H3)
  assume B ∈ ℚ                                                        (H4)
  assume B ≠ 0                                                        (H5)
  then A·B ∈ ℝ ∖ ℚ

1.  A ∈ ℝ. A ∉ ℚ.
    mun:difference Y := ℝ, Z := ℚ, from H3

2.  p ∈ ℤ. q ∈ ℕ. B = p/q.
    obtain p, q: mun:rational x := B, from H4

3.  p ≠ 0
    contradiction
    suppose p = 0                                                     (S1)

    3.1.  B = 0/q
          substitute p = 0 (S1) into line 2

    3.2.  0/q = 0
          algebra, from 2

    3.3.  B = 0
          calculation
            B = 0/q      3.1
              = 0        3.2

    3.4.  B = 0
          join 3.3, contradicting H5

4.  A·B ∉ ℚ
    contradiction
    suppose A·B ∈ ℚ                                                   (S2)

    4.1.  r ∈ ℤ. s ∈ ℕ. A·B = r/s.
          obtain r, s: mun:rational x := A·B, from S2

    4.2.  A·(p/q) = r/s
          substitute B = p/q (line 2) into line 4.1

    4.3.  p > 0 or not p > 0
          mun:excluded-middle P := p > 0

    4.4.  A ∈ ℚ
          cases, from 4.3

          case
          assume p > 0                                                (C1)

          4.4.1.  p ∈ ℕ
                  mun:pos-int-nat m := p, from C1

          4.4.2.  s·p ∈ ℕ
                  mun:nat-closure a := s, b := p, from 4.4.1

          4.4.3.  A = (r·q)/(s·p)
                  algebra, from 1, 2, 4.1, 4.2
                  requires s·p ≠ 0: inequalities, from 4.4.2

          4.4.4.  There are a ∈ ℤ and b ∈ ℕ with A = a/b.
                  exhibit, from 4.4.2, 4.4.3

          4.4.5.  A ∈ ℚ
                  mun:rational x := A, from 4.4.4

          case
          assume not p > 0                                            (C2)

          4.4.6.  −p > 0
                  inequalities, from C2, 3

          4.4.7.  −p ∈ ℕ
                  mun:pos-int-nat m := −p, from 4.4.6

          4.4.8.  s·(−p) ∈ ℕ
                  mun:nat-closure a := s, b := −p, from 4.4.7

          4.4.9.  A = (−(r·q))/(s·(−p))
                  algebra, from 1, 2, 4.1, 4.2
                  requires s·(−p) ≠ 0: inequalities, from 4.4.8

          4.4.10. There are a ∈ ℤ and b ∈ ℕ with A = a/b.
                  exhibit, from 4.4.8, 4.4.9

          4.4.11. A ∈ ℚ
                  mun:rational x := A, from 4.4.10

    4.5.  A ∈ ℚ
          join 4.4, contradicting 1

5.  A·B ∈ ℝ
    membership, from 1

6.  A·B ∈ ℝ ∖ ℚ
    mun:difference Y := ℝ, Z := ℚ, from 4, 5
