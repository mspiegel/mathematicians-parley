import mundane theorem stdlib/numbers/divide-le
import mundane theorem stdlib/numbers/floor-above
import mundane theorem stdlib/numbers/floor-between
import mundane theorem stdlib/numbers/multiply-le
import mundane theorem stdlib/reasoning/iff-from-right

theorem floor-quotient-zero
  note        The floor of A/B is 0 exactly when A/B is in [0, 1). A/B is never
              negative, and it is below 1 exactly when A is below B: if A/B
              were 1 or more, multiplying by B would put B at most A, and if
              A were at least B, dividing by B would put 1 at most A/B.
  let A ∈ ℕ₀                                                          (H1)
  let B ∈ ℕ                                                           (H2)
  then A < B ↔ ⌊A/B⌋ = 0

1.  B ≠ 0
    inequalities, from H2

2.  A/B ∈ ℝ
    membership, from 1

3.  0/B = 0
    algebra, from 1

4.  0/B ≤ A/B
    mun:divide-le x := 0, y := A, c := B
    requires 0 ≤ A: inequalities, from H1
    requires B > 0: inequalities, from H2

5.  0 ≤ A/B
    calculation
      0 = 0/B     3
        ≤ A/B     4

6.  ⌊A/B⌋ = 0 ↔ 0 ≤ A/B and A/B < 0 + 1
    mun:floor-between x := A/B, k := 0, from 2

7.  A < B ↔ ⌊A/B⌋ = 0
    both directions

    direction
    assume A < B                                                      (D1)

    7.1.  B·(A/B) = A
          algebra, from 1

    7.2.  A/B < 1
          contradiction
          suppose not A/B < 1                                         (S1)

          7.2.1.  1 ≤ A/B
                  inequalities, from S1, 1

          7.2.2.  B·1 ≤ B·(A/B)
                  mun:multiply-le x := 1, y := A/B, c := B, from 7.2.1
                  requires B > 0: inequalities, from H2

          7.2.3.  B ≤ A
                  inequalities, from 1, 7.1, 7.2.2

          7.2.4.  not B ≤ A
                  inequalities, from D1, contradicting 7.2.3

    7.3.  A/B < 0 + 1
          inequalities, from 1, 7.2

    7.4.  0 ≤ A/B and A/B < 0 + 1
          join 5, 7.3

    7.5.  ⌊A/B⌋ = 0
          mun:iff-from-right P := ⌊A/B⌋ = 0, Q := 0 ≤ A/B and A/B < 0 + 1, from 6, 7.4

    direction
    assume ⌊A/B⌋ = 0                                                  (D2)

    7.6.  A/B < ⌊A/B⌋ + 1
          mun:floor-above x := A/B, from 2

    7.7.  A/B < 0 + 1
          substitute ⌊A/B⌋ = 0 (D2) into line 7.6

    7.8.  A < B
          contradiction
          suppose not A < B                                           (S2)

          7.8.1.  B ≤ A
                  inequalities, from S2

          7.8.2.  B/B ≤ A/B
                  mun:divide-le x := B, y := A, c := B, from 7.8.1
                  requires B > 0: inequalities, from H2

          7.8.3.  B/B = 1
                  algebra, from 1

          7.8.4.  1 ≤ A/B
                  inequalities, from 1, 7.8.2, 7.8.3

          7.8.5.  A/B < 1
                  inequalities, from 1, 7.7

          7.8.6.  not 1 ≤ A/B
                  inequalities, from 1, 7.8.5, contradicting 7.8.4
