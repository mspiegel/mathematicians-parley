import mundane definition stdlib/sets/difference
import mundane definition stdlib/numbers/rational
import mundane theorem    stdlib/numbers/real-closure

theorem irrational-plus-rational
  note        If A + B were a fraction r/s and B the fraction p/q, then A,
              which is (A + B) − B, would be the fraction (rq − ps)/(sq),
              and A would be rational.
  let A be an element                                                 (H1)
  let B ∈ ℝ                                                           (H2)
  assume A ∈ ℝ ∖ ℚ                                                    (H3)
  assume B ∈ ℚ                                                        (H4)
  then A + B ∈ ℝ ∖ ℚ

1.  A ∈ ℝ. A ∉ ℚ.
    mun:difference Y := ℝ, Z := ℚ, from H3

2.  p ∈ ℤ. q ∈ ℕ. B = p/q.
    obtain p, q: mun:rational x := B, from H4

3.  A + B ∉ ℚ
    contradiction
    suppose A + B ∈ ℚ                                                 (S)

    3.1.  r ∈ ℤ. s ∈ ℕ. A + B = r/s.
          obtain r, s: mun:rational x := A + B, from S

    3.2.  A = r/s − B
          algebra, from 1, 3.1

    3.3.  A = r/s − p/q
          substitute B = p/q (line 2) into line 3.2

    3.4.  r/s − p/q = (r·q − p·s)/(s·q)
          algebra, from 2, 3.1

    3.5.  A = (r·q − p·s)/(s·q)
          calculation
            A = r/s − p/q                 3.3
              = (r·q − p·s)/(s·q)         3.4

    3.6.  There are a ∈ ℤ and b ∈ ℕ with A = a/b.
          exhibit, from 3.5

    3.7.  A ∈ ℚ
          mun:rational x := A, from 3.6, contradicting 1

4.  A + B ∈ ℝ
    mun:real-closure x := A, y := B, from 1

5.  A + B ∈ ℝ ∖ ℚ
    mun:difference Y := ℝ, Z := ℚ, from 3, 4
