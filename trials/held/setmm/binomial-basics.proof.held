import mundane axiom      stdlib/reasoning/excluded-middle
import mundane definition stdlib/counting/factorial
import mundane theorem    stdlib/counting/factorial-nat
import mundane theorem    stdlib/counting/factorial-zero
import definition         stdlib/counting/C
import theorem            stdlib/counting/pascal
import mundane theorem    stdlib/counting/binomial-outside
import mundane theorem    stdlib/counting/binomial-zero-index
import mundane theorem    stdlib/numbers/nat0-as-int
import mundane theorem    stdlib/numbers/nat0-nonzero
import mundane theorem    stdlib/sums/range-bounds
import mundane definition stdlib/sums/range-between

theorem factorial-nat0
  note        0! is 1. For any other N, N is a natural number, and so is N!.
  let N ∈ ℕ₀                                                          (H1)
  then N! ∈ ℕ₀

1.  N = 0 or not N = 0
    mun:excluded-middle P := N = 0

2.  N! ∈ ℕ₀
    cases, from 1

    case
    assume N = 0                                                      (C1)

    2.1.  0! = 1
          mun:factorial-zero

    2.2.  N! = 0!
          substitute N = 0 (C1)

    2.3.  N! = 1
          calculation
            N! = 0!       2.2
               = 1        2.1

    2.4.  1 ∈ ℕ₀
          arithmetic

    2.5.  N! ∈ ℕ₀
          substitute N! = 1 (line 2.3) into line 2.4

    case
    assume not N = 0                                                  (C2)

    2.6.  N ∈ ℕ
          mun:nat0-nonzero m := N, from C2

    2.7.  N! ∈ ℕ
          mun:factorial-nat n := N, from 2.6

    2.8.  N! ∈ ℕ₀
          membership, from 2.7

theorem factorial-successor
  note        (n + 1)! is n!·(n + 1) for n = 0 as well: 1! is 1, and so is
              0!·1.
  let n ∈ ℕ₀                                                          (H1)
  then (n + 1)! = n!·(n + 1)

1.  n = 0 or not n = 0
    mun:excluded-middle P := n = 0

2.  (n + 1)! = n!·(n + 1)
    cases, from 1

    case
    assume n = 0                                                      (C1)

    2.1.  0! = 1
          mun:factorial-zero

    2.2.  1! = 1
          mun:factorial

    2.3.  (n + 1)! = (0 + 1)!
          substitute n = 0 (C1)

    2.4.  0 + 1 = 1
          arithmetic

    2.5.  (0 + 1)! = 1!
          substitute 0 + 1 = 1 (line 2.4)

    2.6.  (n + 1)! = 1·(0 + 1)
          calculation
            (n + 1)! = (0 + 1)!     2.3
                     = 1!           2.5
                     = 1            2.2
                     = 1·(0 + 1)    arithmetic

    2.7.  n!·(n + 1) = 0!·(0 + 1)
          substitute n = 0 (C1)

    2.8.  0!·(0 + 1) = 1·(0 + 1)
          substitute 0! = 1 (line 2.1)

    2.9.  n!·(n + 1) = 1·(0 + 1)
          calculation
            n!·(n + 1) = 0!·(0 + 1)     2.7
                       = 1·(0 + 1)      2.8

    2.10. (n + 1)! = n!·(n + 1)
          calculation
            (n + 1)! = 1·(0 + 1)        2.6
                     = n!·(n + 1)       2.9

    case
    assume not n = 0                                                  (C2)

    2.11. n ∈ ℕ
          mun:nat0-nonzero m := n, from C2

    2.12. (n + 1)! = n!·(n + 1)
          mun:factorial, from 2.11

theorem factorial-nonzero
  note        0! is 1. For any other N, N is a natural number, so N! is
              one too, and a natural number is at least 1.
  let N ∈ ℕ₀                                                          (H1)
  then N! ≠ 0

1.  N = 0 or not N = 0
    mun:excluded-middle P := N = 0

2.  N! ≠ 0
    cases, from 1

    case
    assume N = 0                                                      (C1)

    2.1.  0! = 1
          mun:factorial-zero

    2.2.  N! = 0!
          substitute N = 0 (C1)

    2.3.  N! = 1
          calculation
            N! = 0!       2.2
               = 1        2.1

    2.4.  1 ≠ 0
          arithmetic

    2.5.  N! ≠ 0
          substitute N! = 1 (line 2.3) into line 2.4

    case
    assume not N = 0                                                  (C2)

    2.6.  N ∈ ℕ
          mun:nat0-nonzero m := N, from C2

    2.7.  N! ∈ ℕ
          mun:factorial-nat n := N, from 2.6

    2.8.  N! ≠ 0
          inequalities, from 2.7

theorem choose-all
  note        C(N, N) is N!/((N − N)!·N!), which is N!/(0!·N!), and that is
              1 because N! is not 0.
  let N ∈ ℕ₀                                                          (H1)
  then C(N, N) = 1

1.  N! ≠ 0
    thm:factorial-nonzero

2.  N! ∈ ℕ₀
    thm:factorial-nat0

3.  C(N, N) = N!/((N − N)!·N!)
    def:C n := N, k := N
    requires 0 ≤ N: inequalities, from H1
    requires N ≤ N: inequalities
    requires N ∈ {0, …, N}: mun:range-between k := N, a := 0, b := N

4.  N − N = 0
    algebra

5.  C(N, N) = N!/(0!·N!)
    substitute N − N = 0 (line 4) into line 3

6.  0! = 1
    mun:factorial-zero

7.  C(N, N) = N!/(1·N!)
    substitute 0! = 1 (line 6) into line 5

8.  N!/(1·N!) = 1
    algebra, from 1
    requires N! ∈ ℝ: from 2

9.  C(N, N) = 1
    calculation
      C(N, N) = N!/(1·N!)     7
              = 1             8

theorem choose-one
  note        Row 0 has no entry at 1, so C(0, 1) = 0. Pascal's rule gives
              C(n + 1, 1) = C(n, 1) + C(n, 0), which is n + 1.
  let N ∈ ℕ₀                                                          (H1)
  then C(N, 1) = N

1.  For all n ∈ ℕ₀, C(n, 1) = n.
    induction on n starting at 0

    base
    1.1.  1 ∉ {0, …, 0}
          contradiction
          suppose 1 ∈ {0, …, 0}                                       (S)

          1.1.1.  1 ≤ 0
                  mun:range-bounds a := 0, b := 0, k := 1, from S

          1.1.2.  not (1 ≤ 0)
                  arithmetic, contradicting 1.1.1

    1.2.  C(0, 1) = 0
          mun:binomial-outside n := 0, k := 1, from 1.1

    step
    let n ∈ ℕ₀                                                        (K)
    assume step 1 is true for n, the induction hypothesis             (IH)

    1.3.  C(n, 1) + C(n, 1 − 1) = C(n + 1, 1)
          thm:pascal k := 1

    1.4.  1 − 1 = 0
          arithmetic

    1.5.  C(n, 0) = 1
          mun:binomial-zero-index

    1.6.  C(n, 1) + C(n, 0) = C(n + 1, 1)
          substitute 1 − 1 = 0 (line 1.4) into line 1.3

    1.7.  C(n, 1) + 1 = C(n + 1, 1)
          substitute C(n, 0) = 1 (line 1.5) into line 1.6

    1.8.  n + 1 = C(n + 1, 1)
          substitute C(n, 1) = n (IH) into line 1.7

    1.9.  C(n + 1, 1) = n + 1
          calculation
            C(n + 1, 1) = n + 1     1.8

2.  C(N, 1) = N
    instantiate n := N in line 1

theorem choose-next-row
  note        C(N + 1, N) is (N + 1)!/(1!·N!), and (N + 1)! is N!·(N + 1),
              so the factors N! cancel and N + 1 is left.
  let N ∈ ℕ₀                                                          (H1)
  then C(N + 1, N) = N + 1

1.  N! ≠ 0
    thm:factorial-nonzero

2.  N! ∈ ℕ₀
    thm:factorial-nat0

3.  C(N + 1, N) = (N + 1)!/((N + 1 − N)!·N!)
    def:C n := N + 1, k := N
    requires 0 ≤ N: inequalities, from H1
    requires N ≤ N + 1: inequalities
    requires N ∈ {0, …, N + 1}: mun:range-between k := N, a := 0, b := N + 1

4.  N + 1 − N = 1
    algebra

5.  C(N + 1, N) = (N + 1)!/(1!·N!)
    substitute N + 1 − N = 1 (line 4) into line 3

6.  1! = 1
    mun:factorial

7.  C(N + 1, N) = (N + 1)!/(1·N!)
    substitute 1! = 1 (line 6) into line 5

8.  (N + 1)! = N!·(N + 1)
    thm:factorial-successor n := N

9.  C(N + 1, N) = N!·(N + 1)/(1·N!)
    substitute (N + 1)! = N!·(N + 1) (line 8) into line 7

10. N!·(N + 1)/(1·N!) = N + 1
    algebra, from 1
    requires N! ∈ ℝ: from 2

11. C(N + 1, N) = N + 1
    calculation
      C(N + 1, N) = N!·(N + 1)/(1·N!)     9
                  = N + 1                 10

theorem choose-two
  note        Row 0 has no entry at 2. Pascal's rule gives
              C(n + 1, 2) = C(n, 2) + C(n, 1), which is n(n − 1)/2 + n, and
              that is (n + 1)n/2.
  let N ∈ ℕ₀                                                          (H1)
  then C(N, 2) = N·(N − 1)/2

1.  For all n ∈ ℕ₀, C(n, 2) = n·(n − 1)/2.
    induction on n starting at 0

    base
    1.1.  2 ∉ {0, …, 0}
          contradiction
          suppose 2 ∈ {0, …, 0}                                       (S)

          1.1.1.  2 ≤ 0
                  mun:range-bounds a := 0, b := 0, k := 2, from S

          1.1.2.  not (2 ≤ 0)
                  arithmetic, contradicting 1.1.1

    1.2.  C(0, 2) = 0
          mun:binomial-outside n := 0, k := 2, from 1.1

    1.3.  C(0, 2) = 0·(0 − 1)/2
          calculation
            C(0, 2) = 0               1.2
                    = 0·(0 − 1)/2     arithmetic

    step
    let n ∈ ℕ₀                                                        (K)
    assume step 1 is true for n, the induction hypothesis             (IH)

    1.4.  C(n, 2) + C(n, 2 − 1) = C(n + 1, 2)
          thm:pascal k := 2

    1.5.  2 − 1 = 1
          arithmetic

    1.6.  C(n, 2) + C(n, 1) = C(n + 1, 2)
          substitute 2 − 1 = 1 (line 1.5) into line 1.4

    1.7.  C(n, 1) = n
          thm:choose-one N := n

    1.8.  C(n, 2) + n = C(n + 1, 2)
          substitute C(n, 1) = n (line 1.7) into line 1.6

    1.9.  n·(n − 1)/2 + n = C(n + 1, 2)
          substitute C(n, 2) = n·(n − 1)/2 (IH) into line 1.8

    1.10. n·(n − 1)/2 + n = (n + 1)·(n + 1 − 1)/2
          algebra

    1.11. C(n + 1, 2) = (n + 1)·(n + 1 − 1)/2
          calculation
            C(n + 1, 2) = n·(n − 1)/2 + n         1.9
                        = (n + 1)·(n + 1 − 1)/2   1.10

2.  C(N, 2) = N·(N − 1)/2
    instantiate n := N in line 1

theorem choose-complement
  note        Choosing K of N is choosing the N − K left out. Inside 0 … N
              both sides are N! over the product of K! and (N − K)!, in
              either order; outside, K and N − K are both outside, and both
              sides are 0.
  let N ∈ ℕ₀                                                          (H1)
  let K ∈ ℤ                                                           (H2)
  then C(N, K) = C(N, N − K)

1.  K ∈ {0, …, N} or not K ∈ {0, …, N}
    mun:excluded-middle P := K ∈ {0, …, N}

2.  C(N, K) = C(N, N − K)
    cases, from 1

    case
    assume K ∈ {0, …, N}                                              (C1)

    2.1.  0 ≤ K. K ≤ N.
          mun:range-bounds a := 0, b := N, k := K, from C1

    2.2.  0 ≤ N − K. N − K ≤ N.
          inequalities, from 2.1

    2.3.  N − K ∈ {0, …, N}
          mun:range-between k := N − K, a := 0, b := N, from 2.2

    2.4.  N! ∈ ℕ₀
          thm:factorial-nat0

    2.5.  K ∈ ℕ₀
          mun:nat0-as-int n := K, from 2.1

    2.6.  K! ∈ ℕ₀
          thm:factorial-nat0 N := K, from 2.5

    2.7.  N − K ∈ ℕ₀
          mun:nat0-as-int n := N − K, from 2.2

    2.8.  (N − K)! ∈ ℕ₀
          thm:factorial-nat0 N := N − K, from 2.7

    2.9.  C(N, K) = N!/((N − K)!·K!)
          def:C n := N, k := K, from C1

    2.10. C(N, N − K) = N!/((N − (N − K))!·(N − K)!)
          def:C n := N, k := N − K, from 2.3

    2.11. N − (N − K) = K
          algebra

    2.12. C(N, N − K) = N!/(K!·(N − K)!)
          substitute N − (N − K) = K (line 2.11) into line 2.10

    2.13. N!/(K!·(N − K)!) = N!/((N − K)!·K!)
          algebra
          requires N! ∈ ℝ: from 2.4
          requires K! ∈ ℝ: from 2.6
          requires (N − K)! ∈ ℝ: from 2.8
          requires K! ≠ 0: thm:factorial-nonzero N := K, from 2.5
          requires (N − K)! ≠ 0: thm:factorial-nonzero N := N − K, from 2.7

    2.14. C(N, K) = C(N, N − K)
          calculation
            C(N, K) = N!/((N − K)!·K!)       2.9
                    = N!/(K!·(N − K)!)       2.13
                    = C(N, N − K)            2.12

    case
    assume not K ∈ {0, …, N}                                          (C2)

    2.15. not N − K ∈ {0, …, N}
          contradiction
          suppose N − K ∈ {0, …, N}                                   (S)

          2.15.1.  0 ≤ N − K. N − K ≤ N.
                   mun:range-bounds a := 0, b := N, k := N − K, from S

          2.15.2.  0 ≤ K. K ≤ N.
                   inequalities, from 2.15.1

          2.15.3.  K ∈ {0, …, N}
                   mun:range-between k := K, a := 0, b := N, from 2.15.2, contradicting C2

    2.16. C(N, K) = 0
          mun:binomial-outside n := N, k := K, from C2

    2.17. C(N, N − K) = 0
          mun:binomial-outside n := N, k := N − K, from 2.15

    2.18. C(N, K) = C(N, N − K)
          calculation
            C(N, K) = 0               2.16
                    = C(N, N − K)     2.17
