import theorem            proofs/setmm/divisor-of-prime/divisor-of-prime
import theorem            proofs/setmm/prime-divides-product/prime-divides-product
import mundane theorem    stdlib/divisibility/divides-one
import mundane definition stdlib/divisibility/prime
import mundane theorem    stdlib/numbers/exponent-step
import mundane theorem    stdlib/numbers/exponent-zero
import mundane theorem    stdlib/numbers/power-integer
import mundane theorem    stdlib/reasoning/iff-from-left
import mundane theorem    stdlib/reasoning/modus-ponens

theorem prime-divides-power
  note        By induction on the exponent. Q^0 is 1, which no prime
              divides. A prime dividing Q^k·Q divides Q^k, where the
              hypothesis applies, or divides Q, and a prime that divides a
              prime is that prime.
  let P ∈ ℕ                                                           (H1)
  assume P is prime                                                   (H2)
  let Q ∈ ℕ                                                           (H3)
  assume Q is prime                                                   (H4)
  let N ∈ ℕ₀                                                          (H5)
  assume P divides Q^N                                                (H6)
  then P = Q

1.  P > 1
    mun:prime p := P, from H2

2.  For all k ∈ ℕ₀, if P divides Q^k then P = Q.
    induction on k starting at 0

    base
    2.1.  If P divides Q^0 then P = Q.
          proof
          assume P divides Q^0                                        (B)

          2.1.1.  Q^0 = 1
                  mun:exponent-zero a := Q

          2.1.2.  P divides 1
                  substitute Q^0 = 1 (line 2.1.1) into B

          2.1.3.  P = 1
                  mun:divides-one d := P, from 2.1.2

          2.1.4.  P ≠ 1
                  inequalities, from 1, contradicting 2.1.3

    step
    let k ∈ ℕ₀                                                        (K)
    assume step 2 is true for k, the induction hypothesis             (IH)

    2.2.  If P divides Q^(k + 1) then P = Q.
          proof
          assume P divides Q^(k + 1)                                  (A)

          2.2.1.  Q^(k + 1) = Q^k·Q
                  mun:exponent-step a := Q, m := k

          2.2.2.  P divides Q^k·Q
                  substitute Q^(k + 1) = Q^k·Q (line 2.2.1) into A

          2.2.3.  P divides Q^k·Q ↔ P divides Q^k or P divides Q
                  thm:prime-divides-product M := Q^k, N := Q, from H2
                  requires Q^k ∈ ℤ: mun:power-integer a := Q, m := k

          2.2.4.  P divides Q^k or P divides Q
                  mun:iff-from-left, from 2.2.2, 2.2.3

          2.2.5.  P = Q
                  cases, from 2.2.4

                  case
                  assume P divides Q^k                                (C1)

                  2.2.5.1.  P = Q
                            mun:modus-ponens, from C1, IH

                  case
                  assume P divides Q                                  (C2)

                  2.2.5.2.  P divides Q ↔ P = Q or P = 1
                            thm:divisor-of-prime P := Q, M := P, from H4

                  2.2.5.3.  P = Q or P = 1
                            mun:iff-from-left, from C2, 2.2.5.2

                  2.2.5.4.  P = Q
                            cases, from 2.2.5.3

                            case
                            assume P = Q, which is the claim          (C3)

                            case
                            assume P = 1                              (C4)

                            2.2.5.4.1.  P ≠ 1
                                        inequalities, from 1, contradicting C4

3.  If P divides Q^N then P = Q.
    instantiate k := N in line 2

4.  P = Q
    mun:modus-ponens, from H6, 3
