import definition         stdlib/calculus/tends-to
import mundane theorem    stdlib/numbers/abs-real
import mundane theorem    stdlib/numbers/abs-zero
import mundane theorem    stdlib/numbers/real-closure

theorem constant-sequence-limit
  note        Every term is c, so every term is at distance 0 from c, which
              is less than any ε > 0.
  ε ranges over ℝ
  n ranges over ℕ
  let c ∈ ℝ                                                           (H1)
  let x : ℕ → ℝ                                                       (H2)
  assume for all n ∈ ℕ, x(n) = c                                     (H3)
  then x(n) → c as n → ∞

1.  |0| = 0
    mun:abs-zero

2.  For all ε > 0, there exists N ∈ ℕ such that |x(n) − c| < ε for all n ≥ N.
    proof
    let ε ∈ ℝ                                                         (K1)
    assume ε > 0                                                      (A1)

    2.1.  For all n ≥ 1, |x(n) − c| < ε.
          proof
          let n ∈ ℕ                                                   (K2)
          assume n ≥ 1                                                (A2)

          2.1.1.  x(n) = c
                  instantiate n := n in H3

          2.1.2.  x(n) − c = 0
                  algebra, from 2.1.1
                  requires x(n) ∈ ℝ: from H2, K2

          2.1.3.  |x(n) − c| = |0|
                  substitute x(n) − c = 0 (line 2.1.2)

          2.1.4.  |x(n) − c| = 0
                  calculation
                    |x(n) − c| = |0|    2.1.3
                               = 0      1

          2.1.5.  |x(n) − c| < ε
                  inequalities, from A1, 2.1.4
                  requires x(n) ∈ ℝ: from H2, K2
                  requires x(n) − c ∈ ℝ: mun:real-closure
                  requires |x(n) − c| ∈ ℝ: mun:abs-real x := x(n) − c

    2.2.  There exists N ∈ ℕ such that |x(n) − c| < ε for all n ≥ N.
          exhibit, from 2.1

3.  x(n) → c as n → ∞
    def:tends-to L := c, from 2
