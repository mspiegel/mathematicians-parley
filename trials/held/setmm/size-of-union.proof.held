import mundane theorem    stdlib/counting/card-disjoint-union
import mundane theorem    stdlib/counting/card-nat0
import mundane theorem    stdlib/counting/card-subset
import mundane theorem    stdlib/counting/finite-part
import axiom              stdlib/reasoning/excluded-middle
import mundane theorem    stdlib/numbers/nat0-real
import mundane theorem    stdlib/sets/difference-subset
import definition         stdlib/sets/difference
import mundane theorem    stdlib/sets/disjoint-difference
import mundane theorem    stdlib/sets/in-union-left
import mundane theorem    stdlib/sets/in-union-right
import definition         stdlib/sets/subset
import mundane theorem    stdlib/sets/subset-antisymmetric
import definition         stdlib/sets/union

theorem union-split
  note        Everything in A ∪ B is in A, or is in B and not in A, so
              A ∪ B is A together with what B has beyond A.
  let A be a set                                                      (H1)
  let B be a set                                                      (H2)
  then A ∪ (B ∖ A) = A ∪ B

1.  For all t ∈ A ∪ (B ∖ A), t ∈ A ∪ B.
    proof
    let t ∈ A ∪ (B ∖ A)                                               (K1)

    1.1.  t ∈ A or t ∈ B ∖ A
          def:union u := t, Y := A, Z := B ∖ A, from K1

    1.2.  t ∈ A ∪ B
          cases, from 1.1

          case
          assume t ∈ A                                                (C1)

          1.2.1.  t ∈ A ∪ B
                  mun:in-union-left u := t, Y := A, Z := B, from C1

          case
          assume t ∈ B ∖ A                                            (C2)

          1.2.2.  t ∈ B and t ∉ A
                  def:difference u := t, Y := B, Z := A, from C2

          1.2.3.  t ∈ A ∪ B
                  mun:in-union-right u := t, Y := A, Z := B, from 1.2.2

2.  A ∪ (B ∖ A) ⊆ A ∪ B
    def:subset X := A ∪ (B ∖ A), Y := A ∪ B, from 1

3.  For all t ∈ A ∪ B, t ∈ A ∪ (B ∖ A).
    proof
    let t ∈ A ∪ B                                                     (K2)

    3.1.  t ∈ A or t ∈ B
          def:union u := t, Y := A, Z := B, from K2

    3.2.  t ∈ A ∪ (B ∖ A)
          cases, from 3.1

          case
          assume t ∈ A                                                (C3)

          3.2.1.  t ∈ A ∪ (B ∖ A)
                  mun:in-union-left u := t, Y := A, Z := B ∖ A, from C3

          case
          assume t ∈ B                                                (C4)

          3.2.2.  t ∈ A or not (t ∈ A)
                  axi:excluded-middle P := t ∈ A

          3.2.3.  t ∈ A ∪ (B ∖ A)
                  cases, from 3.2.2

                  case
                  assume t ∈ A                                        (C5)

                  3.2.3.1.  t ∈ A ∪ (B ∖ A)
                            mun:in-union-left u := t, Y := A, Z := B ∖ A, from C5

                  case
                  assume not (t ∈ A)                                  (C6)

                  3.2.3.2.  t ∈ B ∖ A
                            def:difference u := t, Y := B, Z := A, from C4, C6

                  3.2.3.3.  t ∈ A ∪ (B ∖ A)
                            mun:in-union-right u := t, Y := A, Z := B ∖ A, from 3.2.3.2

4.  A ∪ B ⊆ A ∪ (B ∖ A)
    def:subset X := A ∪ B, Y := A ∪ (B ∖ A), from 3

5.  A ∪ (B ∖ A) = A ∪ B
    mun:subset-antisymmetric X := A ∪ (B ∖ A), Y := A ∪ B, from 2, 4


theorem size-of-union
  metamath    hashun2
  note        A ∪ B is A together with the part of B outside A, two sets with
              nothing in common, so its size is |A| plus the size of that part,
              which is at most |B|.
  let A be a set                                                      (H1)
  let B be a set                                                      (H2)
  assume A is finite                                                  (H3)
  assume B is finite                                                  (H4)
  then |A ∪ B| ≤ |A| + |B|

1.  B ∖ A ⊆ B
    mun:difference-subset X := B, Y := A

2.  B ∖ A is finite
    mun:finite-part X := B, Y := B ∖ A, from H4, 1

3.  |B ∖ A| ≤ |B|
    mun:card-subset A := B ∖ A, from 1

4.  A ∩ (B ∖ A) = ∅
    mun:disjoint-difference Y := A, Z := B

5.  A ∪ (B ∖ A) = A ∪ B
    thm:union-split

6.  |A| ∈ ℕ₀
    mun:card-nat0 X := A, from H3

7.  |B ∖ A| ∈ ℕ₀
    mun:card-nat0 X := B ∖ A, from 2

8.  |B| ∈ ℕ₀
    mun:card-nat0 X := B, from H4

9.  |A| = |A|
    algebra
    requires |A| ∈ ℝ: mun:nat0-real m := |A|, from 6

10. |B ∖ A| = |B ∖ A|
    algebra
    requires |B ∖ A| ∈ ℝ: mun:nat0-real m := |B ∖ A|, from 7

11. |A ∪ (B ∖ A)| = |A| + |B ∖ A|
    mun:card-disjoint-union X := A, Y := B ∖ A, m := |A|, n := |B ∖ A|, from 4, 6, 7, 9, 10

12. |A ∪ B| = |A| + |B ∖ A|
    substitute A ∪ (B ∖ A) = A ∪ B (line 5) into line 11

13. |A| + |B ∖ A| ≤ |A| + |B|
    inequalities, from 3
    requires |A| ∈ ℝ: mun:nat0-real m := |A|, from 6
    requires |B ∖ A| ∈ ℝ: mun:nat0-real m := |B ∖ A|, from 7
    requires |B| ∈ ℝ: mun:nat0-real m := |B|, from 8

14. |A ∪ B| ≤ |A| + |B|
    calculation
      |A ∪ B| = |A| + |B ∖ A|     12
              ≤ |A| + |B|         13
