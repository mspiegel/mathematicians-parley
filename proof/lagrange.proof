theorem lagrange
  metamath    lagsubg, which says it of the index set.mm builds from the
              relation of being in one coset, where this counts the cosets
  note        The cosets of H split G into parts, each with as many elements
              as H. So |G| is |H| times the number of cosets.
  let G be a finite group with operation · and identity e             (H1)
  assume H is a subgroup of G                                         (H2)
  then |H| divides |G|

define K := {X ⊆ G : there is a ∈ G with X = aH}                    (D1)
       reads the cosets of H: the parts of G of the form gH

1.  H ⊆ G
    thm:stdlib/groups/subgroup-within, from H2

2.  H is finite
    thm:stdlib/counting/finite-part, from H1, 1

3.  |H| ∈ ℕ₀
    thm:stdlib/counting/card-nat0, from 2

4.  For every g ∈ G, gH ⊆ G.
    fix
    let g ∈ G                                                         (K1)

    4.1.  For every u ∈ gH, u ∈ G.
          fix
          let u ∈ gH                                                  (K2)

          4.1.1.  There is h ∈ H with u = g·h.
                  def:stdlib/groups/coset, from K1, K2
                  requires H ⊆ G: from 1

          4.1.2.  h ∈ H. u = g·h.
                  obtain h from line 4.1.1

          4.1.3.  h ∈ G
                  thm:stdlib/sets/in-subset, from 1, 4.1.2

          4.1.4.  g·h ∈ G
                  thm:stdlib/groups/group-closed a := g, b := h, from K1, 4.1.3

          4.1.5.  u ∈ G
                  substitute u = g·h (line 4.1.2) into line 4.1.4

    4.2.  gH ⊆ G
          def:stdlib/sets/subset, from 4.1

5.  For every g ∈ G, g ∈ gH.
    fix
    let g ∈ G                                                         (K3)

    5.1.  e ∈ H
          thm:stdlib/groups/subgroup-identity, from H2

    5.2.  g·e = g
          thm:stdlib/groups/group-identity a := g, from K3

    5.3.  g ∈ gH
          def:stdlib/groups/coset u := g, from K3, 5.1, 5.2
          requires H ⊆ G: from 1

6.  For every a ∈ G, for every x ∈ aH, xH ⊆ aH.
    fix
    let a ∈ G                                                         (K4)
    let x ∈ aH                                                        (K5)

    6.1.  There is h ∈ H with x = a·h.
          def:stdlib/groups/coset, from K4, K5
          requires H ⊆ G: from 1

    6.2.  h ∈ H. x = a·h.
          obtain h from line 6.1

    6.3.  aH ⊆ G
          instantiate g := a in line 4, from K4

    6.4.  x ∈ G
          thm:stdlib/sets/in-subset, from 6.3, K5

    6.5.  h ∈ G
          thm:stdlib/sets/in-subset, from 1, 6.2

    6.6.  For every u ∈ xH, u ∈ aH.
          fix
          let u ∈ xH                                                  (K6)

          6.6.1.  There is c ∈ H with u = x·c.
                  def:stdlib/groups/coset, from 6.4, K6
                  requires H ⊆ G: from 1

          6.6.2.  c ∈ H. u = x·c.
                  obtain c from line 6.6.1

          6.6.3.  c ∈ G
                  thm:stdlib/sets/in-subset, from 1, 6.6.2

          6.6.4.  h·c ∈ H
                  thm:stdlib/groups/subgroup-closed a := h, b := c, from H2, 6.2, 6.6.2

          6.6.5.  (a·h)·c = a·(h·c)
                  thm:stdlib/groups/group-associative a := a, b := h, c := c, from K4, 6.5, 6.6.3

          6.6.6.  x·c = (a·h)·c
                  substitute x = a·h (line 6.2)

          6.6.7.  u = a·(h·c)
                  calculation
                    u = x·c              6.6.2
                      = (a·h)·c          6.6.6
                      = a·(h·c)          6.6.5

          6.6.8.  u ∈ aH
                  def:stdlib/groups/coset u := u, g := a, from K4, 6.6.4, 6.6.7
                  requires H ⊆ G: from 1

    6.7.  xH ⊆ aH
          def:stdlib/sets/subset, from 6.6

7.  For every a ∈ G, for every x ∈ aH, a ∈ xH.
    fix
    let a ∈ G                                                         (K7)
    let x ∈ aH                                                        (K8)

    7.1.  There is h ∈ H with x = a·h.
          def:stdlib/groups/coset, from K7, K8
          requires H ⊆ G: from 1

    7.2.  h ∈ H. x = a·h.
          obtain h from line 7.1

    7.3.  h ∈ G
          thm:stdlib/sets/in-subset, from 1, 7.2

    7.4.  h⁻¹ ∈ H
          thm:stdlib/groups/subgroup-inverse a := h, from H2, 7.2

    7.5.  h⁻¹ ∈ G
          thm:stdlib/groups/group-inverse-closed a := h, from 7.3

    7.6.  (a·h)·h⁻¹ = a·(h·h⁻¹)
          thm:stdlib/groups/group-associative a := a, b := h, c := h⁻¹, from K7, 7.3, 7.5

    7.7.  h·h⁻¹ = e
          thm:stdlib/groups/group-inverse a := h, from 7.3

    7.8.  a·(h·h⁻¹) = a·e
          substitute h·h⁻¹ = e (line 7.7)

    7.9.  a·e = a
          thm:stdlib/groups/group-identity a := a, from K7

    7.10. x·h⁻¹ = (a·h)·h⁻¹
          substitute x = a·h (line 7.2)

    7.11. a = x·h⁻¹
          calculation
            a = a·e                  7.9
              = a·(h·h⁻¹)            7.8
              = (a·h)·h⁻¹            7.6
              = x·h⁻¹                7.10

    7.12. aH ⊆ G
          instantiate g := a in line 4, from K7

    7.13. x ∈ G
          thm:stdlib/sets/in-subset, from 7.12, K8

    7.14. a ∈ xH
          def:stdlib/groups/coset u := a, g := x, from 7.13, 7.4, 7.11
          requires H ⊆ G: from 1

8.  For every b ∈ G, for every y ∈ bH, yH = bH.
    fix
    let b ∈ G                                                         (K9)
    let y ∈ bH                                                        (K10)

    8.1.  yH ⊆ bH
          instantiate a := b, x := y in line 6, from K9, K10

    8.2.  bH ⊆ G
          instantiate g := b in line 4, from K9

    8.3.  y ∈ G
          thm:stdlib/sets/in-subset, from 8.2, K10

    8.4.  b ∈ yH
          instantiate a := b, x := y in line 7, from K9, K10

    8.5.  bH ⊆ yH
          instantiate a := y, x := b in line 6, from 8.3, 8.4

    8.6.  yH = bH
          thm:stdlib/sets/subset-antisymmetric, from 8.1, 8.5

9.  For every g ∈ G, |gH| = |H|.
    fix
    let g ∈ G                                                         (K11)

    define t(c) := g·c, for c ∈ H                                     (D2)
           reads g times c

    9.1.  For every h ∈ H, t(h) ∈ gH.
          fix
          let h ∈ H                                                   (K12)

          9.1.1.  t(h) = g·h
                  D2, from K12

          9.1.2.  t(h) ∈ gH
                  def:stdlib/groups/coset u := t(h), from K11, K12, 9.1.1
                  requires H ⊆ G: from 1

    9.2.  t : H → gH
          thm:stdlib/functions/function-into, from 9.1

    9.3.  For every s ∈ H, for every r ∈ H, if t(s) = t(r) then s = r.
          fix
          let s ∈ H                                                   (K13)
          let r ∈ H                                                   (K14)
          assume t(s) = t(r)                                          (A1)

          9.3.1.  t(s) = g·s
                  D2, from K13

          9.3.2.  t(r) = g·r
                  D2, from K14

          9.3.3.  g·s = g·r
                  calculation
                    g·s = t(s)           9.3.1
                        = t(r)           A1
                        = g·r            9.3.2

          9.3.4.  s ∈ G
                  thm:stdlib/sets/in-subset, from 1, K13

          9.3.5.  r ∈ G
                  thm:stdlib/sets/in-subset, from 1, K14

          9.3.6.  s = r
                  thm:stdlib/groups/group-cancel a := s, b := r, g := g, from 9.3.4, 9.3.5, K11, 9.3.3

    9.4.  t : H → gH is one-to-one
          def:stdlib/functions/one-to-one, from 9.2, 9.3

    9.5.  For every u ∈ gH, there is h ∈ H with u = t(h).
          fix
          let u ∈ gH                                                  (K15)

          9.5.1.  There is h ∈ H with u = g·h.
                  def:stdlib/groups/coset, from K11, K15
                  requires H ⊆ G: from 1

          9.5.2.  h ∈ H. u = g·h.
                  obtain h from line 9.5.1

          9.5.3.  t(h) = g·h
                  D2, from 9.5.2

          9.5.4.  u = t(h)
                  calculation
                    u = g·h              9.5.2
                      = t(h)             9.5.3

          9.5.5.  There is h ∈ H with u = t(h).
                  exhibit, from 9.5.2, 9.5.4

    9.6.  There is a bijection from H to gH.
          thm:stdlib/functions/onto-bijection, from 9.4, 9.5

    9.7.  |H| = |gH|
          thm:stdlib/counting/card-equal X := H, Y := gH, from 2, 9.6

10. For every Y ∈ K, Y ⊆ G.
    fix
    let Y ∈ K                                                         (K16)

    10.1. Y ⊆ G
          def:stdlib/sets/part-builder, from K16

11. ⋃(Y ∈ K) Y ⊆ G
    thm:stdlib/sets/union-within, from 10

12. For every g ∈ G, g ∈ ⋃(Y ∈ K) Y.
    fix
    let g ∈ G                                                         (K17)

    12.1. gH ⊆ G
          instantiate g := g in line 4, from K17

    12.2. There is a ∈ G with gH = aH.
          exhibit, from K17

    12.3. gH ∈ K
          def:stdlib/sets/part-builder u := gH, from 12.1, 12.2

    12.4. g ∈ gH
          instantiate g := g in line 5, from K17

    12.5. There is Y ∈ K with g ∈ Y.
          exhibit, from 12.3, 12.4

    12.6. g ∈ ⋃(Y ∈ K) Y
          def:stdlib/sets/indexed-union u := g, from 12.5

13. G ⊆ ⋃(Y ∈ K) Y
    def:stdlib/sets/subset, from 12

14. ⋃(Y ∈ K) Y = G
    thm:stdlib/sets/subset-antisymmetric, from 11, 13

15. For every Y ∈ K, for every Z ∈ K, for every x ∈ Y ∩ Z, Y = Z.
    fix
    let Y ∈ K                                                         (K18)
    let Z ∈ K                                                         (K19)
    let x ∈ Y ∩ Z                                                     (K20)

    15.1. There is a ∈ G with Y = aH.
          def:stdlib/sets/part-builder, from K18

    15.2. a ∈ G. Y = aH.
          obtain a from line 15.1

    15.3. There is b ∈ G with Z = bH.
          def:stdlib/sets/part-builder, from K19

    15.4. b ∈ G. Z = bH.
          obtain b from line 15.3

    15.5. x ∈ Y. x ∈ Z.
          thm:stdlib/sets/intersection-member, from K20

    15.6. x ∈ aH
          substitute Y = aH (line 15.2) into line 15.5

    15.7. x ∈ bH
          substitute Z = bH (line 15.4) into line 15.5

    15.8. xH = aH
          instantiate b := a, y := x in line 8, from 15.2, 15.6

    15.9. xH = bH
          instantiate b := b, y := x in line 8, from 15.4, 15.7

    15.10. Y = Z
           calculation
             Y = aH                  15.2
               = xH                  15.8
               = bH                  15.9
               = Z                   15.4

16. For every Y ∈ K, |Y| = |H|.
    fix
    let Y ∈ K                                                         (K21)

    16.1. There is a ∈ G with Y = aH.
          def:stdlib/sets/part-builder, from K21

    16.2. a ∈ G. Y = aH.
          obtain a from line 16.1

    16.3. |H| = |aH|
          instantiate g := a in line 9, from 16.2

    16.4. |Y| = |aH|
          substitute Y = aH (line 16.2)

    16.5. |Y| = |H|
          calculation
            |Y| = |aH|               16.4
                = |H|                16.3

17. |G| = |K| · |H|
    thm:stdlib/counting/partition-count A := G, m := |H|, from H1, 14, 15, 16, 3

18. K is finite
    thm:stdlib/counting/parts-finite A := G, from H1, 10

19. |K| ∈ ℕ₀
    thm:stdlib/counting/card-nat0, from 18

20. |G| ∈ ℕ₀
    thm:stdlib/counting/card-nat0, from H1

21. |G| = |H|·|K|
    algebra, from 17
    requires |G| ∈ ℝ: from 20
    requires |K| ∈ ℝ: from 19
    requires |H| ∈ ℝ: from 3

22. |H| divides |G|
    def:stdlib/divisibility/divides d := |H|, n := |G|, from 19, 21
    requires |H| ∈ ℤ: from 3
    requires |G| ∈ ℤ: from 20
