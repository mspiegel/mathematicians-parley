theorem cantor
  let A be a set                                                      (H1)
  let f : A → 𝒫A                                                      (H2)
  then there is B ∈ 𝒫A with for every x ∈ A, not f(x) = B

define B := {x ∈ A : x ∉ f(x)}                                        (D1)
       reads the members of A that their own image leaves out

1.  B ⊆ A
    thm:set-builder-subset, from D1

2.  B ∈ 𝒫A
    def:powerset S := B, from H1, 1

3.  For every x ∈ A, not f(x) = B.
    fix
    let x ∈ A                                                         (K)

    3.1.  not f(x) = B
          contradiction
          suppose not not f(x) = B                                    (S)

          3.1.1.  f(x) = B
                  thm:double-negation P := f(x) = B, from S

          3.1.2.  x ∈ B or x ∉ B
                  thm:excluded-middle P := x ∈ B

          3.1.3.  x ∈ B. x ∉ B.
                  cases, from 3.1.2

                  case
                  assume x ∈ B                                        (C1)

                  3.1.3.1.  x ∉ f(x)
                            def:set-builder, from C1

                  3.1.3.2.  x ∉ B
                            substitute f(x) = B (line 3.1.1) into line 3.1.3.1

                  3.1.3.3.  x ∈ B. x ∉ B.
                            join C1, 3.1.3.2

                  case
                  assume x ∉ B                                        (C2)

                  3.1.3.4.  x ∉ f(x)
                            substitute f(x) = B (line 3.1.1) into C2

                  3.1.3.5.  x ∈ B
                            def:set-builder, from K, 3.1.3.4

                  3.1.3.6.  x ∈ B. x ∉ B.
                            join 3.1.3.5, C2

4.  There is B ∈ 𝒫A with for every x ∈ A, not f(x) = B.
    exhibit, from 2, 3
