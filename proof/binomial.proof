theorem binomial-step
  note        The induction step's algebra, stated apart from the induction.
              Inside the step the hypothesis is in scope and names the sum's
              index, and set.mm's lemma for rewriting a sum term by term
              forbids its index in the scope; here nothing in scope names it.
  let x ∈ ℝ                                                           (H1)
  let y ∈ ℝ                                                           (H2)
  let m ∈ ℕ₀                                                          (H3)
  then (Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k)·(x + y) = Σ(k = 0 to m + 1) C(m + 1, k)·x^((m + 1) − k)·y^k

1.  m + 1 ∈ ℕ₀
    thm:stdlib/numbers/nat0-closure, from H3

2.  Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k ∈ ℝ
    thm:stdlib/sums/sum-real a := 0, b := m
    requires 0 ∈ ℤ: arithmetic
    requires m ∈ ℤ: from H3
    requires m ∈ ℕ₀: from H3
    requires x ∈ ℝ: from H1
    requires y ∈ ℝ: from H2

3.  (Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k)·(x + y) = x·(Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k) + y·(Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k)
    algebra
    requires Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k ∈ ℝ: from 2
    requires x ∈ ℝ: from H1
    requires y ∈ ℝ: from H2

4.  x·(Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k) = Σ(k = 0 to m) x·(C(m, k)·x^(m − k)·y^k)
    thm:stdlib/sums/sum-scaled a := 0, b := m, c := x
    requires 0 ∈ ℤ: arithmetic
    requires m ∈ ℤ: from H3
    requires m ∈ ℕ₀: from H3
    requires x ∈ ℝ: from H1
    requires y ∈ ℝ: from H2

5.  For every k ∈ {0, …, m}, x·(C(m, k)·x^(m − k)·y^k) = C(m, k)·x^((m + 1) − k)·y^k.
    fix
    note each of x and y times the sum gains a zero term, so both run from 0 to m + 1
    let k ∈ {0, …, m}                                                 (J)

    5.1.  k ∈ ℤ
          thm:stdlib/sums/range-integer a := 0, b := m, from J
          requires 0 ∈ ℤ: arithmetic
          requires m ∈ ℤ: from H3

    5.2.  k ∈ ℕ₀
          thm:stdlib/sums/range-nat0 n := m, from J
          requires m ∈ ℤ: from H3

    5.3.  m − k ∈ ℕ₀
          thm:stdlib/sums/range-difference a := 0, n := m, from J
          requires 0 ∈ ℤ: arithmetic
          requires m ∈ ℤ: from H3

    5.4.  x^((m − k) + 1) = x^(m − k)·x
          thm:stdlib/numbers/exponent-step a := x, m := m − k, from H1, 5.3

    5.5.  (m − k) + 1 = (m + 1) − k
          algebra
          requires m ∈ ℝ: from H3
          requires k ∈ ℝ: from 5.1

    5.6.  x^((m − k) + 1) = x^((m + 1) − k)
          substitute (m − k) + 1 = (m + 1) − k (line 5.5)

    5.7.  x^(m − k)·x = x^((m + 1) − k)
          calculation
            x^(m − k)·x = x^((m − k) + 1)       5.4, right to left
                        = x^((m + 1) − k)       5.6

    5.8.  x·(C(m, k)·x^(m − k)·y^k) = C(m, k)·(x^(m − k)·x)·y^k
          algebra
          requires x ∈ ℝ: from H1
          requires C(m, k) ∈ ℕ₀: thm:stdlib/counting/binomial-nat0, from H3, 5.1
          requires x^(m − k) ∈ ℝ: thm:stdlib/numbers/power-real, from H1, 5.3
          requires y^k ∈ ℝ: thm:stdlib/numbers/power-real, from H2, 5.2

    5.9.  C(m, k)·(x^(m − k)·x)·y^k = C(m, k)·x^((m + 1) − k)·y^k
          substitute x^(m − k)·x = x^((m + 1) − k) (line 5.7)

    5.10. x·(C(m, k)·x^(m − k)·y^k) = C(m, k)·x^((m + 1) − k)·y^k
          calculation
            x·(C(m, k)·x^(m − k)·y^k) = C(m, k)·(x^(m − k)·x)·y^k      5.8
                                      = C(m, k)·x^((m + 1) − k)·y^k    5.9

6.  Σ(k = 0 to m) x·(C(m, k)·x^(m − k)·y^k) = Σ(k = 0 to m) C(m, k)·x^((m + 1) − k)·y^k
    thm:stdlib/sums/sum-termwise a := 0, b := m, from 5
    requires 0 ∈ ℤ: arithmetic
    requires m ∈ ℤ: from H3

7.  m < m + 1
    inequalities
    requires m ∈ ℝ: from H3

8.  C(m, m + 1) = 0
    thm:stdlib/counting/binomial-above n := m, k := m + 1, from H3, 1, 7

9.  (m + 1) − (m + 1) = 0
    algebra
    requires m ∈ ℝ: from H3

10. C(m, m + 1)·x^((m + 1) − (m + 1))·y^(m + 1) = C(m, m + 1)·x^0·y^(m + 1)
    substitute (m + 1) − (m + 1) = 0 (line 9)

11. y^(m + 1) ∈ ℝ
    thm:stdlib/numbers/power-real a := y, m := m + 1, from H2, 1

12. C(m, m + 1)·x^0·y^(m + 1) = 0·x^0·y^(m + 1)
    substitute C(m, m + 1) = 0 (line 8)

13. 0·x^0·y^(m + 1) = 0
    algebra
    requires x ∈ ℝ: from H1
    requires y^(m + 1) ∈ ℝ: from 11

14. C(m, m + 1)·x^((m + 1) − (m + 1))·y^(m + 1) = 0
    calculation
      C(m, m + 1)·x^((m + 1) − (m + 1))·y^(m + 1) = C(m, m + 1)·x^0·y^(m + 1)    10
                                                  = 0·x^0·y^(m + 1)               12
                                                  = 0                             13

15. Σ(k = 0 to m + 1) C(m, k)·x^((m + 1) − k)·y^k = Σ(k = 0 to m) C(m, k)·x^((m + 1) − k)·y^k + C(m, m + 1)·x^((m + 1) − (m + 1))·y^(m + 1)
    thm:stdlib/sums/sum-last n := m, from H3
    requires x ∈ ℝ: from H1
    requires y ∈ ℝ: from H2

16. Σ(k = 0 to m + 1) C(m, k)·x^((m + 1) − k)·y^k = Σ(k = 0 to m) C(m, k)·x^((m + 1) − k)·y^k + 0
    substitute C(m, m + 1)·x^((m + 1) − (m + 1))·y^(m + 1) = 0 (line 14) into line 15

17. x·(Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k) = Σ(k = 0 to m) C(m, k)·x^((m + 1) − k)·y^k
    calculation
      x·(Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k) = Σ(k = 0 to m) x·(C(m, k)·x^(m − k)·y^k)      4
                                              = Σ(k = 0 to m) C(m, k)·x^((m + 1) − k)·y^k    6

18. Σ(k = 0 to m + 1) C(m, k)·x^((m + 1) − k)·y^k = x·(Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k) + 0
    substitute x·(Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k) = Σ(k = 0 to m) C(m, k)·x^((m + 1) − k)·y^k (line 17) into line 16, right to left

19. x·(Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k) + 0 = x·(Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k)
    algebra
    requires x ∈ ℝ: from H1
    requires Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k ∈ ℝ: from 2

20. x·(Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k) = Σ(k = 0 to m + 1) C(m, k)·x^((m + 1) − k)·y^k
    calculation
      x·(Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k) = x·(Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k) + 0    19, right to left
                                              = Σ(k = 0 to m + 1) C(m, k)·x^((m + 1) − k)·y^k    18, right to left

21. y·(Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k) = Σ(k = 0 to m) y·(C(m, k)·x^(m − k)·y^k)
    thm:stdlib/sums/sum-scaled a := 0, b := m, c := y
    requires 0 ∈ ℤ: arithmetic
    requires m ∈ ℤ: from H3
    requires m ∈ ℕ₀: from H3
    requires x ∈ ℝ: from H1
    requires y ∈ ℝ: from H2

22. For every k ∈ {0, …, m}, y·(C(m, k)·x^(m − k)·y^k) = C(m, k)·x^(m − k)·y^(k + 1).
    fix
    let k ∈ {0, …, m}                                                 (J)

    22.1.  k ∈ ℤ
           thm:stdlib/sums/range-integer a := 0, b := m, from J
           requires 0 ∈ ℤ: arithmetic
           requires m ∈ ℤ: from H3

    22.2.  k ∈ ℕ₀
           thm:stdlib/sums/range-nat0 n := m, from J
           requires m ∈ ℤ: from H3

    22.3.  m − k ∈ ℕ₀
           thm:stdlib/sums/range-difference a := 0, n := m, from J
           requires 0 ∈ ℤ: arithmetic
           requires m ∈ ℤ: from H3

    22.4.  y^(k + 1) = y^k·y
           thm:stdlib/numbers/exponent-step a := y, m := k, from H2, 22.2

    22.5.  y·(C(m, k)·x^(m − k)·y^k) = C(m, k)·x^(m − k)·(y^k·y)
           algebra
           requires y ∈ ℝ: from H2
           requires C(m, k) ∈ ℕ₀: thm:stdlib/counting/binomial-nat0, from H3, 22.1
           requires x^(m − k) ∈ ℝ: thm:stdlib/numbers/power-real, from H1, 22.3
           requires y^k ∈ ℝ: thm:stdlib/numbers/power-real, from H2, 22.2

    22.6.  C(m, k)·x^(m − k)·(y^k·y) = C(m, k)·x^(m − k)·y^(k + 1)
           substitute y^(k + 1) = y^k·y (line 22.4), right to left

    22.7.  y·(C(m, k)·x^(m − k)·y^k) = C(m, k)·x^(m − k)·y^(k + 1)
           calculation
             y·(C(m, k)·x^(m − k)·y^k) = C(m, k)·x^(m − k)·(y^k·y)      22.5
                                       = C(m, k)·x^(m − k)·y^(k + 1)    22.6

23. Σ(k = 0 to m) y·(C(m, k)·x^(m − k)·y^k) = Σ(k = 0 to m) C(m, k)·x^(m − k)·y^(k + 1)
    thm:stdlib/sums/sum-termwise a := 0, b := m, from 22
    requires 0 ∈ ℤ: arithmetic
    requires m ∈ ℤ: from H3

24. Σ(k = 0 to m) C(m, k)·x^(m − k)·y^(k + 1) = Σ(k = 0 + 1 to m + 1) C(m, k − 1)·x^(m − (k − 1))·y^((k − 1) + 1)
    thm:stdlib/sums/sum-shift a := 0, b := m, c := 1
    requires 0 ∈ ℤ: arithmetic
    requires m ∈ ℤ: from H3
    requires 1 ∈ ℤ: arithmetic
    requires m ∈ ℕ₀: from H3
    requires x ∈ ℝ: from H1
    requires y ∈ ℝ: from H2

25. Σ(k = 0 + 1 to m + 1) C(m, k − 1)·x^(m − (k − 1))·y^((k − 1) + 1) = Σ(k = 1 to m + 1) C(m, k − 1)·x^(m − (k − 1))·y^((k − 1) + 1)
    substitute 0 + 1 = 1 (arithmetic)

26. For every k ∈ {1, …, m + 1}, C(m, k − 1)·x^(m − (k − 1))·y^((k − 1) + 1) = C(m, k − 1)·x^((m + 1) − k)·y^k.
    fix
    let k ∈ {1, …, m + 1}                                             (J)

    26.1.  k ∈ ℤ
           thm:stdlib/sums/range-integer a := 1, b := m + 1, from J
           requires 1 ∈ ℤ: arithmetic
           requires m + 1 ∈ ℤ: from 1

    26.2.  m − (k − 1) = (m + 1) − k
           algebra
           requires m ∈ ℝ: from H3
           requires k ∈ ℝ: from 26.1

    26.3.  (k − 1) + 1 = k
           algebra
           requires k ∈ ℝ: from 26.1

    26.4.  C(m, k − 1)·x^(m − (k − 1))·y^((k − 1) + 1) = C(m, k − 1)·x^((m + 1) − k)·y^((k − 1) + 1)
           substitute m − (k − 1) = (m + 1) − k (line 26.2)

    26.5.  C(m, k − 1)·x^((m + 1) − k)·y^((k − 1) + 1) = C(m, k − 1)·x^((m + 1) − k)·y^k
           substitute (k − 1) + 1 = k (line 26.3)

    26.6.  C(m, k − 1)·x^(m − (k − 1))·y^((k − 1) + 1) = C(m, k − 1)·x^((m + 1) − k)·y^k
           calculation
             C(m, k − 1)·x^(m − (k − 1))·y^((k − 1) + 1) = C(m, k − 1)·x^((m + 1) − k)·y^((k − 1) + 1)    26.4
                                                         = C(m, k − 1)·x^((m + 1) − k)·y^k                26.5

27. Σ(k = 1 to m + 1) C(m, k − 1)·x^(m − (k − 1))·y^((k − 1) + 1) = Σ(k = 1 to m + 1) C(m, k − 1)·x^((m + 1) − k)·y^k
    thm:stdlib/sums/sum-termwise a := 1, b := m + 1, from 26
    requires 1 ∈ ℤ: arithmetic
    requires m + 1 ∈ ℤ: from 1

28. C(m, −1) = 0
    thm:stdlib/counting/binomial-below n := m, from H3

29. C(m, 0 − 1) = C(m, −1)
    substitute 0 − 1 = −1 (arithmetic)

30. C(m, 0 − 1) = 0
    calculation
      C(m, 0 − 1) = C(m, −1)    29
                  = 0           28

31. (m + 1) − 0 = m + 1
    algebra
    requires m ∈ ℝ: from H3

32. C(m, 0 − 1)·x^((m + 1) − 0)·y^0 = C(m, 0 − 1)·x^(m + 1)·y^0
    substitute (m + 1) − 0 = m + 1 (line 31)

33. x^(m + 1) ∈ ℝ
    thm:stdlib/numbers/power-real a := x, m := m + 1, from H1, 1

34. C(m, 0 − 1)·x^(m + 1)·y^0 = 0·x^(m + 1)·y^0
    substitute C(m, 0 − 1) = 0 (line 30)

35. 0·x^(m + 1)·y^0 = 0
    algebra
    requires x^(m + 1) ∈ ℝ: from 33
    requires y ∈ ℝ: from H2

36. C(m, 0 − 1)·x^((m + 1) − 0)·y^0 = 0
    calculation
      C(m, 0 − 1)·x^((m + 1) − 0)·y^0 = C(m, 0 − 1)·x^(m + 1)·y^0    32
                                      = 0·x^(m + 1)·y^0              34
                                      = 0                            35

37. Σ(k = 0 to m + 1) C(m, k − 1)·x^((m + 1) − k)·y^k = C(m, 0 − 1)·x^((m + 1) − 0)·y^0 + Σ(k = 0 + 1 to m + 1) C(m, k − 1)·x^((m + 1) − k)·y^k
    thm:stdlib/sums/sum-first n := m + 1, from 1
    requires m ∈ ℕ₀: from H3
    requires x ∈ ℝ: from H1
    requires y ∈ ℝ: from H2

38. Σ(k = 0 to m + 1) C(m, k − 1)·x^((m + 1) − k)·y^k = 0 + Σ(k = 0 + 1 to m + 1) C(m, k − 1)·x^((m + 1) − k)·y^k
    substitute C(m, 0 − 1)·x^((m + 1) − 0)·y^0 = 0 (line 36) into line 37

39. Σ(k = 0 to m + 1) C(m, k − 1)·x^((m + 1) − k)·y^k = 0 + Σ(k = 1 to m + 1) C(m, k − 1)·x^((m + 1) − k)·y^k
    substitute 0 + 1 = 1 (arithmetic) into line 38

40. Σ(k = 1 to m + 1) C(m, k − 1)·x^((m + 1) − k)·y^k ∈ ℝ
    thm:stdlib/sums/sum-real a := 1, b := m + 1
    requires 1 ∈ ℤ: arithmetic
    requires m + 1 ∈ ℤ: from 1
    requires m ∈ ℕ₀: from H3
    requires x ∈ ℝ: from H1
    requires y ∈ ℝ: from H2

41. 0 + Σ(k = 1 to m + 1) C(m, k − 1)·x^((m + 1) − k)·y^k = Σ(k = 1 to m + 1) C(m, k − 1)·x^((m + 1) − k)·y^k
    algebra
    requires Σ(k = 1 to m + 1) C(m, k − 1)·x^((m + 1) − k)·y^k ∈ ℝ: from 40

42. y·(Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k) = Σ(k = 0 to m + 1) C(m, k − 1)·x^((m + 1) − k)·y^k
    calculation
      y·(Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k) = Σ(k = 0 to m) y·(C(m, k)·x^(m − k)·y^k)                          21
                                              = Σ(k = 0 to m) C(m, k)·x^(m − k)·y^(k + 1)                          23
                                              = Σ(k = 0 + 1 to m + 1) C(m, k − 1)·x^(m − (k − 1))·y^((k − 1) + 1)  24
                                              = Σ(k = 1 to m + 1) C(m, k − 1)·x^(m − (k − 1))·y^((k − 1) + 1)      25
                                              = Σ(k = 1 to m + 1) C(m, k − 1)·x^((m + 1) − k)·y^k                  27
                                              = 0 + Σ(k = 1 to m + 1) C(m, k − 1)·x^((m + 1) − k)·y^k              41, right to left
                                              = Σ(k = 0 to m + 1) C(m, k − 1)·x^((m + 1) − k)·y^k                  39, right to left

43. Σ(k = 0 to m + 1) (C(m, k)·x^((m + 1) − k)·y^k + C(m, k − 1)·x^((m + 1) − k)·y^k) = Σ(k = 0 to m + 1) C(m, k)·x^((m + 1) − k)·y^k + Σ(k = 0 to m + 1) C(m, k − 1)·x^((m + 1) − k)·y^k
    thm:stdlib/sums/sum-add a := 0, b := m + 1
    requires 0 ∈ ℤ: arithmetic
    requires m + 1 ∈ ℤ: from 1
    requires m ∈ ℕ₀: from H3
    requires x ∈ ℝ: from H1
    requires y ∈ ℝ: from H2

44. For every k ∈ {0, …, m + 1}, C(m, k)·x^((m + 1) − k)·y^k + C(m, k − 1)·x^((m + 1) − k)·y^k = C(m + 1, k)·x^((m + 1) − k)·y^k.
    fix
    note then the two sums add term by term, and Pascal's rule joins the coefficients
    let k ∈ {0, …, m + 1}                                             (J)

    44.1.  k ∈ ℤ
           thm:stdlib/sums/range-integer a := 0, b := m + 1, from J
           requires 0 ∈ ℤ: arithmetic
           requires m + 1 ∈ ℤ: from 1

    44.2.  k ∈ ℕ₀
           thm:stdlib/sums/range-nat0 n := m + 1, from J
           requires m + 1 ∈ ℤ: from 1

    44.3.  (m + 1) − k ∈ ℕ₀
           thm:stdlib/sums/range-difference a := 0, n := m + 1, from J
           requires 0 ∈ ℤ: arithmetic
           requires m + 1 ∈ ℤ: from 1

    44.4.  k − 1 ∈ ℤ
           thm:stdlib/numbers/int-closure a := k, b := 1, from 44.1
           requires 1 ∈ ℤ: arithmetic

    44.5.  C(m, k) + C(m, k − 1) = C(m + 1, k)
           thm:stdlib/counting/pascal n := m, k := k, from H3, 44.1

    44.6.  C(m, k)·x^((m + 1) − k)·y^k + C(m, k − 1)·x^((m + 1) − k)·y^k = (C(m, k) + C(m, k − 1))·x^((m + 1) − k)·y^k
           algebra
           requires C(m, k) ∈ ℕ₀: thm:stdlib/counting/binomial-nat0, from H3, 44.1
           requires C(m, k − 1) ∈ ℕ₀: thm:stdlib/counting/binomial-nat0 k := k − 1, from H3, 44.4
           requires x^((m + 1) − k) ∈ ℝ: thm:stdlib/numbers/power-real, from H1, 44.3
           requires y^k ∈ ℝ: thm:stdlib/numbers/power-real, from H2, 44.2

    44.7.  (C(m, k) + C(m, k − 1))·x^((m + 1) − k)·y^k = C(m + 1, k)·x^((m + 1) − k)·y^k
           substitute C(m, k) + C(m, k − 1) = C(m + 1, k) (line 44.5)

    44.8.  C(m, k)·x^((m + 1) − k)·y^k + C(m, k − 1)·x^((m + 1) − k)·y^k = C(m + 1, k)·x^((m + 1) − k)·y^k
           calculation
             C(m, k)·x^((m + 1) − k)·y^k + C(m, k − 1)·x^((m + 1) − k)·y^k = (C(m, k) + C(m, k − 1))·x^((m + 1) − k)·y^k    44.6
                                                                           = C(m + 1, k)·x^((m + 1) − k)·y^k                  44.7

45. Σ(k = 0 to m + 1) (C(m, k)·x^((m + 1) − k)·y^k + C(m, k − 1)·x^((m + 1) − k)·y^k) = Σ(k = 0 to m + 1) C(m + 1, k)·x^((m + 1) − k)·y^k
    thm:stdlib/sums/sum-termwise a := 0, b := m + 1, from 44
    requires 0 ∈ ℤ: arithmetic
    requires m + 1 ∈ ℤ: from 1

46. x·(Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k) + y·(Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k) = Σ(k = 0 to m + 1) C(m, k)·x^((m + 1) − k)·y^k + y·(Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k)
    substitute x·(Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k) = Σ(k = 0 to m + 1) C(m, k)·x^((m + 1) − k)·y^k (line 20)

47. Σ(k = 0 to m + 1) C(m, k)·x^((m + 1) − k)·y^k + y·(Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k) = Σ(k = 0 to m + 1) C(m, k)·x^((m + 1) − k)·y^k + Σ(k = 0 to m + 1) C(m, k − 1)·x^((m + 1) − k)·y^k
    substitute y·(Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k) = Σ(k = 0 to m + 1) C(m, k − 1)·x^((m + 1) − k)·y^k (line 42)

48. (Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k)·(x + y) = Σ(k = 0 to m + 1) C(m + 1, k)·x^((m + 1) − k)·y^k
    calculation
      (Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k)·(x + y) = x·(Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k) + y·(Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k)                     3
                                                    = Σ(k = 0 to m + 1) C(m, k)·x^((m + 1) − k)·y^k + y·(Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k)               46
                                                    = Σ(k = 0 to m + 1) C(m, k)·x^((m + 1) − k)·y^k + Σ(k = 0 to m + 1) C(m, k − 1)·x^((m + 1) − k)·y^k     47
                                                    = Σ(k = 0 to m + 1) (C(m, k)·x^((m + 1) − k)·y^k + C(m, k − 1)·x^((m + 1) − k)·y^k)                     43, right to left
                                                    = Σ(k = 0 to m + 1) C(m + 1, k)·x^((m + 1) − k)·y^k                                                     45


theorem binomial
  metamath    binom
  let x ∈ ℝ                                                           (H1)
  let y ∈ ℝ                                                           (H2)
  let n ∈ ℕ₀                                                          (H3)
  then (x + y)^n = Σ(k = 0 to n) C(n, k)·x^(n − k)·y^k

1.  (x + y)^n = Σ(k = 0 to n) C(n, k)·x^(n − k)·y^k
    induction on n starting at 0, from H3

    base
    1.1.  Σ(k = 0 to 0) C(0, k)·x^(0 − k)·y^k = C(0, 0)·x^(0 − 0)·y^0
          thm:stdlib/sums/sum-single a := 0
          requires 0 ∈ ℤ: arithmetic
          requires x ∈ ℝ: from H1
          requires y ∈ ℝ: from H2

    1.2.  C(0, 0) = 1
          thm:stdlib/counting/binomial-zero-index n := 0
          requires 0 ∈ ℕ₀: arithmetic

    1.3.  C(0, 0)·x^(0 − 0)·y^0 = 1·x^(0 − 0)·y^0
          substitute C(0, 0) = 1 (line 1.2)

    1.4.  1·x^(0 − 0)·y^0 = 1·x^0·y^0
          substitute 0 − 0 = 0 (arithmetic)

    1.5.  1·x^0·y^0 = 1
          algebra
          requires x ∈ ℝ: from H1
          requires y ∈ ℝ: from H2

    1.6.  (x + y)^0 = 1
          algebra
          requires x ∈ ℝ: from H1
          requires y ∈ ℝ: from H2

    1.7.  (x + y)^0 = Σ(k = 0 to 0) C(0, k)·x^(0 − k)·y^k
          calculation
            (x + y)^0 = 1                                        1.6
                      = 1·x^0·y^0                                1.5, right to left
                      = 1·x^(0 − 0)·y^0                          1.4, right to left
                      = C(0, 0)·x^(0 − 0)·y^0                    1.3, right to left
                      = Σ(k = 0 to 0) C(0, k)·x^(0 − k)·y^k      1.1, right to left

    step
    1.8.  For every m ∈ ℕ₀, if (x + y)^m = Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k
          then (x + y)^(m + 1) = Σ(k = 0 to m + 1) C(m + 1, k)·x^((m + 1) − k)·y^k.
          fix
          let m ∈ ℕ₀                                                  (K)
          assume (x + y)^m = Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k      (IH)

          1.8.1.  x + y ∈ ℝ
                  thm:stdlib/numbers/real-closure, from H1, H2

          1.8.2.  (x + y)^(m + 1) = (x + y)^m·(x + y)
                  thm:stdlib/numbers/exponent-step a := x + y, from 1.8.1, K

          1.8.3.  (x + y)^m·(x + y) = (Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k)·(x + y)
                  substitute (x + y)^m = Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k (IH)

          1.8.4.  (Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k)·(x + y) = Σ(k = 0 to m + 1) C(m + 1, k)·x^((m + 1) − k)·y^k
                  thm:binomial-step m := m, from H1, H2, K

          1.8.5.  (x + y)^(m + 1) = Σ(k = 0 to m + 1) C(m + 1, k)·x^((m + 1) − k)·y^k
                  calculation
                    (x + y)^(m + 1) = (x + y)^m·(x + y)                                          1.8.2
                                    = (Σ(k = 0 to m) C(m, k)·x^(m − k)·y^k)·(x + y)              1.8.3
                                    = Σ(k = 0 to m + 1) C(m + 1, k)·x^((m + 1) − k)·y^k          1.8.4
