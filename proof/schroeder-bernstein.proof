theorem fixed-part
  metamath    sbthlem3, which says it of the union set.mm builds, where this
              says there is such a part
  let A be a set                                                      (H1)
  let B be a set                                                      (H2)
  let f : A → B                                                       (H3)
  let g : B → A                                                       (H4)
  then there is C ∈ 𝒫A with {g(y) : y ∈ B ∖ {f(x) : x ∈ C}} = A ∖ C

define M(X) := {g(y) : y ∈ B ∖ {f(x) : x ∈ X}}, for X ∈ 𝒫A          (D1)
       reads what g reaches from the part of B that f misses on X
define D := {X ∈ 𝒫A : M(X) ⊆ A ∖ X}                                 (D2)
       reads the parts of A that M keeps out of
define C := ⋃(X ∈ D) X                                               (D3)
       reads everything in some such part

1.  For every X ∈ 𝒫A, M(X) ⊆ A.
    fix
    let X ∈ 𝒫A                                                        (K1)

    1.1.  For every y ∈ B ∖ {f(x) : x ∈ X}, g(y) ∈ A.
          fix
          let y ∈ B ∖ {f(x) : x ∈ X}                                  (K2)

          1.1.1.  y ∈ B
                  thm:stdlib/sets/difference-member, from K2

          1.1.2.  g(y) ∈ A
                  thm:stdlib/functions/function-value f := g, x := y, from 1.1.1

    1.2.  M(X) ⊆ A
          thm:stdlib/functions/image-within, from 1.1
          requires X ∈ 𝒫A: from K1

2.  For every X ∈ 𝒫A, for every Y ∈ 𝒫A, if X ⊆ Y then M(Y) ⊆ M(X).
    fix
    let X ∈ 𝒫A                                                        (K3)
    let Y ∈ 𝒫A                                                        (K4)
    assume X ⊆ Y                                                      (A1)

    2.1.  {f(x) : x ∈ X} ⊆ {f(x) : x ∈ Y}
          thm:stdlib/functions/image-monotone, from A1

    2.2.  B ∖ {f(x) : x ∈ Y} ⊆ B ∖ {f(x) : x ∈ X}
          thm:stdlib/sets/difference-reverses, from 2.1

    2.3.  M(Y) ⊆ M(X)
          thm:stdlib/functions/image-monotone, from 2.2
          requires X ∈ 𝒫A: from K3
          requires Y ∈ 𝒫A: from K4

3.  For every X ∈ D, X ⊆ A.
    fix
    let X ∈ D                                                         (K5)

    3.1.  X ∈ 𝒫A
          def:stdlib/sets/set-builder, from K5

    3.2.  X ⊆ A
          def:stdlib/sets/powerset S := X, from 3.1

4.  C ⊆ A
    thm:stdlib/sets/union-within, from 3

5.  C ∈ 𝒫A
    def:stdlib/sets/powerset S := C, from 4

6.  M(C) ⊆ A
    instantiate X := C in line 1, from 5

7.  For every X ∈ D, M(C) ⊆ A ∖ X.
    fix
    let X ∈ D                                                         (K6)

    7.1.  X ∈ 𝒫A
          def:stdlib/sets/set-builder, from K6

    7.2.  M(X) ⊆ A ∖ X
          def:stdlib/sets/set-builder, from K6
          requires X ∈ 𝒫A: from 7.1

    7.3.  X ⊆ C
          thm:stdlib/sets/union-contains-member Y := X, from K6

    7.4.  M(C) ⊆ M(X)
          instantiate X := X, Y := C in line 2, from 7.1, 5, 7.3

    7.5.  M(C) ⊆ A ∖ X
          thm:stdlib/sets/subset-transitive, from 7.4, 7.2

8.  For every a ∈ M(C), a ∈ A ∖ C.
    fix
    let a ∈ M(C)                                                      (K7)

    8.1.  a ∈ A
          thm:stdlib/sets/in-subset, from 6, K7

    8.2.  a ∉ C
          contradiction
          suppose a ∈ C                                               (S1)

          8.2.1.  There is X ∈ D with a ∈ X.
                  def:stdlib/sets/indexed-union u := a, from S1

          8.2.2.  X ∈ D. a ∈ X.
                  obtain X from line 8.2.1

          8.2.3.  M(C) ⊆ A ∖ X
                  instantiate X := X in line 7, from 8.2.2

          8.2.4.  a ∈ A ∖ X
                  thm:stdlib/sets/in-subset, from 8.2.3, K7

          8.2.5.  a ∉ X
                  thm:stdlib/sets/difference-member, from 8.2.4

          8.2.6.  a ∈ X. a ∉ X.
                  join 8.2.2, 8.2.5

    8.3.  a ∈ A ∖ C
          thm:stdlib/sets/difference-member, from 8.1, 8.2

9.  M(C) ⊆ A ∖ C
    def:stdlib/sets/subset, from 8

10. C ⊆ A ∖ M(C)
    thm:stdlib/sets/complement-swap, from 4, 6, 9

11. A ∖ M(C) ∈ 𝒫A
    def:stdlib/sets/powerset S := A ∖ M(C)
    requires A ∖ M(C) ⊆ A: thm:stdlib/sets/difference-subset

12. M(A ∖ M(C)) ⊆ M(C)
    instantiate X := C, Y := A ∖ M(C) in line 2, from 5, 11, 10

13. A ∖ (A ∖ M(C)) = M(C)
    thm:stdlib/sets/difference-twice, from 6

14. M(C) ⊆ A ∖ (A ∖ M(C))
    thm:stdlib/sets/equal-subset, from 13

15. M(A ∖ M(C)) ⊆ A ∖ (A ∖ M(C))
    thm:stdlib/sets/subset-transitive, from 12, 14

16. A ∖ M(C) ∈ D
    def:stdlib/sets/set-builder u := A ∖ M(C), from 11, 15
    requires C ∈ 𝒫A: from 5

17. A ∖ M(C) ⊆ C
    thm:stdlib/sets/union-contains-member Y := A ∖ M(C), from 16
    requires C ∈ 𝒫A: from 5

18. A ∖ C ⊆ M(C)
    thm:stdlib/sets/complement-swap-outside, from 17

19. M(C) = A ∖ C
    thm:stdlib/sets/subset-antisymmetric, from 9, 18

20. There is C ∈ 𝒫A with {g(y) : y ∈ B ∖ {f(x) : x ∈ C}} = A ∖ C.
    exhibit, from 5, 19


theorem schroeder-bernstein
  metamath    sbth, which says it of one set dominating another, where this
              says it of the one-to-one functions that dominating names
  let A be a set                                                      (H1)
  let B be a set                                                      (H2)
  let f : A → B                                                       (H3)
  let g : B → A                                                       (H4)
  assume f : A → B is one-to-one                                      (H5)
  assume g : B → A is one-to-one                                      (H6)
  then there is a bijection from A to B

1.  For every s ∈ A, for every t ∈ A, if f(s) = f(t) then s = t.
    def:stdlib/functions/one-to-one, from H5

2.  C ∈ 𝒫A. {g(y) : y ∈ B ∖ {f(x) : x ∈ C}} = A ∖ C.
    obtain C: thm:proof/schroeder-bernstein/fixed-part

    define R := {f(x) : x ∈ C}                                        (D1)
           reads what f reaches from C
    define h(x) := f(x)      if x ∈ C
                   g⁻¹(x)    otherwise,  for x ∈ A                    (D2)
           reads f on C, and the way back along g on the rest of A

3.  C ⊆ A
    def:stdlib/sets/powerset S := C, from 2

4.  For every t ∈ A ∖ C, h(t) ∈ B ∖ R and g(h(t)) = t.
    fix
    let t ∈ A ∖ C                                                     (K1)

    4.1.  t ∈ A. t ∉ C.
          thm:stdlib/sets/difference-member, from K1

    4.2.  A ∖ C ⊆ {g(y) : y ∈ B ∖ R}
          thm:stdlib/sets/equal-subset, from 2

    4.3.  t ∈ {g(y) : y ∈ B ∖ R}
          thm:stdlib/sets/in-subset, from 4.2, K1

    4.4.  There is y ∈ B ∖ R with t = g(y).
          def:stdlib/functions/set-image u := t, from 4.3

    4.5.  y ∈ B ∖ R. t = g(y).
          obtain y from line 4.4

    4.6.  y ∈ B
          thm:stdlib/sets/difference-member, from 4.5

    4.7.  h(t) = g⁻¹(t)
          D2, from 4.1

    4.8.  g⁻¹(g(y)) = y
          thm:stdlib/functions/inverse-value, from H6, 4.6

    4.9.  g⁻¹(t) = g⁻¹(g(y))
          substitute t = g(y) (line 4.5)

    4.10. h(t) = y
          calculation
            h(t) = g⁻¹(t)            4.7
                 = g⁻¹(g(y))         4.9
                 = y                 4.8

    4.11. h(t) ∈ B ∖ R
          substitute h(t) = y (line 4.10) into line 4.5

    4.12. g(h(t)) = g(y)
          substitute h(t) = y (line 4.10)

    4.13. g(h(t)) = t
          calculation
            g(h(t)) = g(y)           4.12
                    = t              4.5

    4.14. h(t) ∈ B ∖ R. g(h(t)) = t.
          join 4.11, 4.13

5.  For every u ∈ C, for every v ∈ A ∖ C, not h(u) = h(v).
    fix
    let u ∈ C                                                         (K2)
    let v ∈ A ∖ C                                                     (K3)

    5.1.  not h(u) = h(v)
          contradiction
          suppose h(u) = h(v)                                         (S1)

          5.1.1.  u ∈ A
                  thm:stdlib/sets/in-subset, from 3, K2

          5.1.2.  h(u) = f(u)
                  D2, from K2
                  requires u ∈ A: from 5.1.1

          5.1.3.  f(u) ∈ R
                  thm:stdlib/functions/value-in-image, from K2

          5.1.4.  h(v) = f(u)
                  calculation
                    h(v) = h(u)      S1
                         = f(u)      5.1.2

          5.1.5.  h(v) ∈ R
                  substitute h(v) = f(u) (line 5.1.4) into line 5.1.3

          5.1.6.  h(v) ∈ B ∖ R. g(h(v)) = v.
                  instantiate t := v in line 4, from K3

          5.1.7.  h(v) ∉ R
                  thm:stdlib/sets/difference-member, from 5.1.6

          5.1.8.  h(v) ∈ R. h(v) ∉ R.
                  join 5.1.5, 5.1.7

6.  For every s ∈ A, h(s) ∈ B.
    fix
    let s ∈ A                                                         (K4)

    6.1.  s ∈ C or s ∉ C
          thm:stdlib/reasoning/excluded-middle P := s ∈ C

    6.2.  h(s) ∈ B
          cases, from 6.1

          case
          assume s ∈ C                                                (C1)

          6.2.1.  h(s) = f(s)
                  D2, from C1
                  requires s ∈ A: from K4

          6.2.2.  f(s) ∈ B
                  thm:stdlib/functions/function-value f := f, x := s, from K4

          6.2.3.  h(s) ∈ B
                  substitute h(s) = f(s) (line 6.2.1) into line 6.2.2

          case
          assume s ∉ C                                                (C2)

          6.2.4.  s ∈ A ∖ C
                  thm:stdlib/sets/difference-member, from K4, C2

          6.2.5.  h(s) ∈ B ∖ R. g(h(s)) = s.
                  instantiate t := s in line 4, from 6.2.4

          6.2.6.  h(s) ∈ B
                  thm:stdlib/sets/difference-member, from 6.2.5

7.  h : A → B
    thm:stdlib/functions/function-into, from 6

8.  For every s ∈ A, for every t ∈ A, if h(s) = h(t) then s = t.
    fix
    let s ∈ A                                                         (K5)
    let t ∈ A                                                         (K6)
    assume h(s) = h(t)                                                (A1)

    8.1.  s ∈ C or s ∉ C
          thm:stdlib/reasoning/excluded-middle P := s ∈ C

    8.2.  t ∈ C or t ∉ C
          thm:stdlib/reasoning/excluded-middle P := t ∈ C

    8.3.  s = t
          cases, from 8.1

          case
          assume s ∈ C                                                (C3)

          8.3.1.  s = t
                  cases, from 8.2

                  case
                  assume t ∈ C                                        (C4)

                  8.3.1.1.  h(s) = f(s)
                            D2, from C3
                            requires s ∈ A: from K5

                  8.3.1.2.  h(t) = f(t)
                            D2, from C4
                            requires t ∈ A: from K6

                  8.3.1.3.  f(s) = f(t)
                            calculation
                              f(s) = h(s)      8.3.1.1
                                   = h(t)      A1
                                   = f(t)      8.3.1.2

                  8.3.1.4.  s = t
                            instantiate s := s, t := t in line 1, from K5, K6, 8.3.1.3

                  case
                  assume t ∉ C                                        (C5)

                  8.3.1.5.  t ∈ A ∖ C
                            thm:stdlib/sets/difference-member, from K6, C5

                  8.3.1.6.  not h(s) = h(t)
                            instantiate u := s, v := t in line 5, from C3, 8.3.1.5

                  8.3.1.7.  s = t
                            thm:stdlib/reasoning/from-contradiction P := h(s) = h(t), Q := s = t, from A1, 8.3.1.6

          case
          assume s ∉ C                                                (C6)

          8.3.2.  s ∈ A ∖ C
                  thm:stdlib/sets/difference-member, from K5, C6

          8.3.3.  h(s) ∈ B ∖ R. g(h(s)) = s.
                  instantiate t := s in line 4, from 8.3.2

          8.3.4.  s = t
                  cases, from 8.2

                  case
                  assume t ∈ C                                        (C7)

                  8.3.4.1.  not h(t) = h(s)
                            instantiate u := t, v := s in line 5, from C7, 8.3.2

                  8.3.4.2.  s = t
                            thm:stdlib/reasoning/from-contradiction P := h(t) = h(s), Q := s = t, from A1, 8.3.4.1

                  case
                  assume t ∉ C                                        (C8)

                  8.3.4.3.  t ∈ A ∖ C
                            thm:stdlib/sets/difference-member, from K6, C8

                  8.3.4.4.  h(t) ∈ B ∖ R. g(h(t)) = t.
                            instantiate t := t in line 4, from 8.3.4.3

                  8.3.4.5.  g(h(s)) = g(h(t))
                            substitute h(s) = h(t) (A1)

                  8.3.4.6.  s = t
                            calculation
                              s = g(h(s))      8.3.3
                                = g(h(t))      8.3.4.5
                                = t            8.3.4.4

9.  For every b ∈ B, there is s ∈ A with b = h(s).
    fix
    let b ∈ B                                                         (K7)

    9.1.  b ∈ R or b ∉ R
          thm:stdlib/reasoning/excluded-middle P := b ∈ R

    9.2.  There is s ∈ A with b = h(s).
          cases, from 9.1

          case
          assume b ∈ R                                                (C9)

          9.2.1.  There is x ∈ C with b = f(x).
                  def:stdlib/functions/set-image u := b, from C9

          9.2.2.  x ∈ C. b = f(x).
                  obtain x from line 9.2.1

          9.2.3.  x ∈ A
                  thm:stdlib/sets/in-subset, from 3, 9.2.2

          9.2.4.  h(x) = f(x)
                  D2, from 9.2.2
                  requires x ∈ A: from 9.2.3

          9.2.5.  b = h(x)
                  calculation
                    b = f(x)         9.2.2
                      = h(x)         9.2.4

          9.2.6.  There is s ∈ A with b = h(s).
                  exhibit, from 9.2.3, 9.2.5

          case
          assume b ∉ R                                                (C10)

          9.2.7.  b ∈ B ∖ R
                  thm:stdlib/sets/difference-member, from K7, C10

          9.2.8.  g(b) ∈ {g(y) : y ∈ B ∖ R}
                  thm:stdlib/functions/value-in-image, from 9.2.7

          9.2.9.  {g(y) : y ∈ B ∖ R} ⊆ A ∖ C
                  thm:stdlib/sets/equal-subset, from 2

          9.2.10. g(b) ∈ A ∖ C
                  thm:stdlib/sets/in-subset, from 9.2.9, 9.2.8

          9.2.11. g(b) ∈ A. g(b) ∉ C.
                  thm:stdlib/sets/difference-member, from 9.2.10

          9.2.12. h(g(b)) = g⁻¹(g(b))
                  D2, from 9.2.11

          9.2.13. g⁻¹(g(b)) = b
                  thm:stdlib/functions/inverse-value, from H6, K7

          9.2.14. b = h(g(b))
                  calculation
                    b = g⁻¹(g(b))    9.2.13
                      = h(g(b))      9.2.12

          9.2.15. There is s ∈ A with b = h(s).
                  exhibit, from 9.2.11, 9.2.14

10. h : A → B is one-to-one
    def:stdlib/functions/one-to-one, from 7, 8

11. There is a bijection from A to B.
    thm:stdlib/functions/onto-bijection, from 10, 9
