theorem odd-square
  metamath    zesq covers it
  let n ∈ ℤ                                                           (H1)
  assume n is odd                                                     (H2)
  then n² is odd

1.  k ∈ ℤ. n = 2k + 1.
    obtain k: def:stdlib/divisibility/odd n := n, from H1, H2

2.  n² = (2k + 1)²
    substitute n = 2k + 1 (line 1)

3.  (2k + 1)² = 4k² + 4k + 1
    algebra
    requires k ∈ ℝ: from 1

4.  4k² + 4k + 1 = 2(2k² + 2k) + 1
    algebra
    requires k ∈ ℝ: from 1

5.  n² = 2(2k² + 2k) + 1
    calculation
      n² = (2k + 1)²           2
         = 4k² + 4k + 1        3
         = 2(2k² + 2k) + 1     4

6.  n² is odd
    def:stdlib/divisibility/odd n := n², from 5
    requires n² ∈ ℤ: thm:stdlib/numbers/int-closure, from H1
    requires 2 ∈ ℤ: arithmetic
    requires 2k² + 2k ∈ ℤ: thm:stdlib/numbers/int-closure, from 1


theorem even-square
  metamath    zesq
  let n ∈ ℤ                                                           (H1)
  assume n² is even                                                   (H2)
  then n is even

1.  n is not odd
    contradiction
    suppose n is odd                                                  (S)

    1.1.  n² is odd
          thm:odd-square n := n, from H1, S

    1.2.  n² is not odd
          thm:stdlib/divisibility/not-both n := n², from H2
          requires n² ∈ ℤ: thm:stdlib/numbers/int-closure, from H1

    1.3.  n² is odd. n² is not odd.
          join 1.1, 1.2

2.  n is even or n is odd
    thm:stdlib/divisibility/even-or-odd n := n, from H1

3.  n is even
    thm:stdlib/reasoning/disjunctive-syllogism P := n is even, Q := n is odd, from 2, 1


theorem lowest-terms
  note        Hammack chapter 6 takes a fraction in lowest terms as given.
              set.mm has it as elq2, which says lowest terms with a gcd where
              a reader says it with divisors, and that step is the proof.
  let x ∈ ℚ                                                           (H1)
  then there are p ∈ ℤ and q ∈ ℤ with q > 0, x = p/q,
       and there is no d ∈ ℤ with d > 1, d divides p, and d divides q

1.  p ∈ ℤ. q ∈ ℕ. x = p/q. gcd(p, q) = 1.
    obtain p, q: thm:stdlib/numbers/rational-coprime x := x, from H1

2.  q > 0
    inequalities, from 1
    requires q ∈ ℝ: from 1

3.  There is no d ∈ ℤ with d > 1, d divides p, and d divides q.
    contradiction
    suppose there is d ∈ ℤ with d > 1, d divides p, and d divides q   (S)

    3.1.  d ∈ ℤ. d > 1. d divides p. d divides q.
          obtain d from S

    3.2.  d divides gcd(p, q)
          thm:stdlib/divisibility/divides-gcd d := d, a := p, b := q, from 3.1, 1, 3.1, 3.1

    3.3.  d divides 1
          substitute gcd(p, q) = 1 (line 1) into line 3.2

    3.4.  0 < d
          inequalities, from 3.1
          requires d ∈ ℝ: from 3.1

    3.5.  d ∈ ℕ
          thm:stdlib/numbers/pos-int-nat m := d, from 3.1, 3.4

    3.6.  d = 1
          thm:stdlib/divisibility/divides-one d := d, from 3.5, 3.3

    3.7.  d ≠ 1
          inequalities, from 3.1
          requires d ∈ ℝ: from 3.1

    3.8.  d = 1. d ≠ 1.
          join 3.6, 3.7

4.  There are p ∈ ℤ and q ∈ ℤ with q > 0, x = p/q,
    and there is no d ∈ ℤ with d > 1, d divides p, and d divides q.
    exhibit, from 1, 2, 3


theorem sqrt2-irrational
  metamath    sqrt2irr
  note        No pilot table carried a row for it. Added by the merge. set.mm
              proves it by descent with strong induction, so the elaborated
              kernel proof will differ.
  then √2 is irrational

1.  (√2)² = 2
    def:stdlib/numbers/sqrt x := 2
    requires 2 ∈ ℝ: arithmetic
    requires 2 ≥ 0: arithmetic

2.  √2 ∈ ℝ
    def:stdlib/numbers/sqrt x := 2
    requires 2 ∈ ℝ: arithmetic
    requires 2 ≥ 0: arithmetic

3.  √2 ∉ ℚ
    contradiction
    suppose √2 ∈ ℚ                                                    (S)

    3.1.  p ∈ ℤ. q ∈ ℤ. q > 0. √2 = p/q.
          There is no d ∈ ℤ with d > 1, d divides p, and d divides q.
          obtain p, q: thm:lowest-terms x := √2, from S

    3.2.  (p/q)² = 2
          substitute √2 = p/q (line 3.1) into line 1

    3.3.  p² = 2q²
          algebra, from 3.2
          requires q ≠ 0: inequalities, from 3.1
          requires p ∈ ℝ: from 3.1
          requires q ∈ ℝ: from 3.1

    3.4.  p² is even
          def:stdlib/divisibility/even n := p², from 3.3
          requires p² ∈ ℤ: thm:stdlib/numbers/int-closure, from 3.1
          requires q² ∈ ℤ: thm:stdlib/numbers/int-closure, from 3.1

    3.5.  p is even
          thm:even-square n := p, from 3.1, 3.4

    3.6.  There is k ∈ ℤ with p = 2k.
          def:stdlib/divisibility/even n := p, from 3.1, 3.5

    3.7.  r ∈ ℤ. p = 2r.
          obtain r from line 3.6

    3.8.  p² = (2r)²
          substitute p = 2r (line 3.7)

    3.9.  (2r)² = 4r²
          algebra
          requires r ∈ ℝ: from 3.7

    3.10. 2q² = 4r²
          calculation
            2q² = p²        3.3
                = (2r)²     3.8
                = 4r²       3.9

    3.11. q² = 2r²
          algebra, from 3.10
          requires 2 ≠ 0: arithmetic
          requires q ∈ ℝ: from 3.1
          requires r ∈ ℝ: from 3.7

    3.12. q² is even
          def:stdlib/divisibility/even n := q², from 3.11
          requires q² ∈ ℤ: thm:stdlib/numbers/int-closure, from 3.1
          requires r² ∈ ℤ: thm:stdlib/numbers/int-closure, from 3.7

    3.13. q is even
          thm:even-square n := q, from 3.1, 3.12

    3.14. There is k ∈ ℤ with q = 2k.
          def:stdlib/divisibility/even n := q, from 3.1, 3.13

    3.15. s ∈ ℤ. q = 2s.
          obtain s from line 3.14

    3.16. 2 divides p
          def:stdlib/divisibility/divides d := 2, n := p, from 3.1, 3.7
          requires 2 ∈ ℤ: arithmetic

    3.17. 2 divides q
          def:stdlib/divisibility/divides d := 2, n := q, from 3.1, 3.15
          requires 2 ∈ ℤ: arithmetic

    3.18. There is d ∈ ℤ with d > 1, d divides p, and d divides q.
          exhibit, from 3.16, 3.17
          requires 2 ∈ ℤ: arithmetic
          requires 2 > 1: arithmetic

    3.19. There is d ∈ ℤ with d > 1, d divides p, and d divides q.
          There is no d ∈ ℤ with d > 1, d divides p, and d divides q.
          join 3.18, 3.1

4.  √2 is irrational
    def:stdlib/numbers/irrational x := √2, from 3, 2
