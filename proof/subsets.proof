theorem subsets-count
  let n ∈ ℕ₀                                                          (H1)
  let A be a set                                                      (H2)
  assume |A| = n                                                      (H3)
  then |𝒫A| = 2^n

1.  For every set X, if |X| = n then |𝒫X| = 2^n.
    induction on n starting at 0, from H1

    base
    1.1.  For every set X, if |X| = 0 then |𝒫X| = 2^0.
          fix
          let X be a set                                              (K1)
          assume |X| = 0                                              (C1)

          1.1.1.  X = ∅
                  thm:card-zero, from K1, C1

          1.1.2.  𝒫X = 𝒫∅
                  substitute X = ∅ (line 1.1.1)

          1.1.3.  𝒫∅ = {∅}
                  thm:powerset-empty

          1.1.4.  |{∅}| = 1
                  thm:card-singleton x := ∅

          1.1.5.  1 = 2^0
                  arithmetic

          1.1.6.  𝒫X = {∅}
                  calculation
                    𝒫X = 𝒫∅        1.1.2
                       = {∅}       1.1.3

          1.1.7.  |𝒫X| = 1
                  substitute 𝒫X = {∅} (line 1.1.6) into line 1.1.4

          1.1.8.  |𝒫X| = 2^0
                  calculation
                    |𝒫X| = 1        1.1.7
                         = 2^0      1.1.5

    step
    1.2.  For every k ∈ ℕ₀, if (for every set X, if |X| = k then |𝒫X| = 2^k)
          then (for every set X, if |X| = k + 1 then |𝒫X| = 2^(k + 1)).
          fix
          let k ∈ ℕ₀                                                  (K2)
          assume for every set X, if |X| = k then |𝒫X| = 2^k          (IH)

          1.2.1.  For every set X, if |X| = k + 1 then |𝒫X| = 2^(k + 1).
                  fix
                  note remove an element a and split the subsets of X by whether they contain it
                  let X be a set                                      (K3)
                  assume |X| = k + 1                                  (C2)

                  1.2.1.1.  a ∈ X
                            obtain a: thm:card-nonempty, from K3, C2

                  1.2.1.2.  |X ∖ {a}| = k
                            thm:card-remove, from K3, 1.2.1.1, C2

                  define U := 𝒫(X ∖ {a})                                 (D1)
                         reads the subsets of X that do not contain a
                  define T := {S ∪ {a} : S ∈ U}                          (D2)
                         reads the subsets of X that do contain a

                  1.2.1.3.  |U| = 2^k
                            instantiate X := X ∖ {a} in IH, from 1.2.1.2
                            requires X ∖ {a} is a set: thm:difference-set, from K3

                  1.2.1.4.  There is a bijection from U to T.
                            thm:add-element-bijection, from D2
                            requires a ∉ X ∖ {a}: thm:not-in-difference,
                              from K3

                  1.2.1.5.  |T| = 2^k
                            thm:card-bijection, from 1.2.1.3, 1.2.1.4

                  1.2.1.6.  U ∩ T = ∅
                            thm:powerset-split-disjoint, from 1.2.1.1

                  1.2.1.7.  𝒫X = U ∪ T
                            thm:powerset-split, from K3, 1.2.1.1

                  1.2.1.8.  |U ∪ T| = 2^k + 2^k
                            thm:card-disjoint-union, from 1.2.1.3, 1.2.1.5, 1.2.1.6

                  1.2.1.9.  |𝒫X| = 2^k + 2^k
                            substitute 𝒫X = U ∪ T (line 1.2.1.7) into line 1.2.1.8

                  1.2.1.10. 2^k + 2^k = 2^k·2
                            algebra
                            requires 2 ∈ ℝ: arithmetic
                            requires 2^k ∈ ℝ: thm:power-real a := 2, m := k, from K2

                  1.2.1.11. 2^(k + 1) = 2^k·2
                            thm:exponent-step a := 2, m := k, from K2
                            requires 2 ∈ ℝ: arithmetic

                  1.2.1.12. |𝒫X| = 2^(k + 1)
                            calculation
                              |𝒫X| = 2^k + 2^k      1.2.1.9
                                   = 2^k·2          1.2.1.10
                                   = 2^(k + 1)      1.2.1.11, right to left

2.  |𝒫A| = 2^n
    instantiate X := A in line 1, from H2, H3
