theorem add-element-bijection
  note        The pilot's row was itself incomplete, reading "Let X be a set, a
              with not a ∈ X... the map S ↦ S ∪ {a} is a bijection". The
              statement in the proof is the merge's reading of it.
  let X be a set                                                      (H1)
  let a ∉ X                                                           (H2)
  then there is a bijection from 𝒫X to {S ∪ {a} : S ∈ 𝒫X}

1.  For every S ∈ 𝒫X, for every T ∈ 𝒫X, if S ∪ {a} = T ∪ {a} then S = T.
    fix
    note adding a can be undone by taking it away, so nothing is sent twice
    let S ∈ 𝒫X                                                        (K1)
    let T ∈ 𝒫X                                                        (K2)
    assume S ∪ {a} = T ∪ {a}                                          (K3)

    1.1.  S ⊆ X
          def:stdlib/sets/powerset S := S, from K1

    1.2.  T ⊆ X
          def:stdlib/sets/powerset S := T, from K2

    1.3.  a ∉ S
          thm:stdlib/sets/not-in-subset Y := S, Z := X, from 1.1, H2

    1.4.  a ∉ T
          thm:stdlib/sets/not-in-subset Y := T, Z := X, from 1.2, H2

    1.5.  (S ∪ {a}) ∖ {a} = S ∖ {a}
          thm:stdlib/sets/difference-of-union

    1.6.  (T ∪ {a}) ∖ {a} = T ∖ {a}
          thm:stdlib/sets/difference-of-union

    1.7.  S ∖ {a} = S
          thm:stdlib/sets/difference-absent, from 1.3

    1.8.  T ∖ {a} = T
          thm:stdlib/sets/difference-absent, from 1.4

    1.9.  (T ∪ {a}) ∖ {a} = S ∖ {a}
          substitute S ∪ {a} = T ∪ {a} (K3) into line 1.5

    1.10. S = T
          calculation
            S = S ∖ {a}            1.7, right to left
              = (T ∪ {a}) ∖ {a}    1.9, right to left
              = T ∖ {a}            1.6
              = T                  1.8

2.  There is a bijection from 𝒫X to {S ∪ {a} : S ∈ 𝒫X}.
    thm:stdlib/functions/image-of-injection Y := 𝒫X, from 1


theorem powerset-split-disjoint
  note        The pilot's row read only "the two parts above are disjoint". The
              statement in the proof is the merge's reading of it.
  let X be a set                                                      (H1)
  let a ∈ X                                                           (H2)
  then 𝒫(X ∖ {a}) ∩ {S ∪ {a} : S ∈ 𝒫(X ∖ {a})} = ∅

1.  a ∉ X ∖ {a}
    thm:stdlib/sets/not-in-difference

2.  For every S ∈ 𝒫(X ∖ {a}), S ∪ {a} ∉ 𝒫(X ∖ {a}).
    fix
    let S ∈ 𝒫(X ∖ {a})                                                (K1)

    2.1.  a ∈ S ∪ {a}
          thm:stdlib/sets/in-union-singleton

    2.2.  S ∪ {a} ∉ 𝒫(X ∖ {a})
          contradiction
          suppose not S ∪ {a} ∉ 𝒫(X ∖ {a})                            (S1)

          2.2.1.  S ∪ {a} ∈ 𝒫(X ∖ {a})
                  thm:stdlib/reasoning/double-negation P := S ∪ {a} ∈ 𝒫(X ∖ {a}), from S1

          2.2.2.  S ∪ {a} ⊆ X ∖ {a}
                  def:stdlib/sets/powerset S := S ∪ {a}, from 2.2.1

          2.2.3.  a ∉ S ∪ {a}
                  thm:stdlib/sets/subset-of-difference, from 2.2.2

          2.2.4.  a ∈ S ∪ {a}. a ∉ S ∪ {a}.
                  join 2.1, 2.2.3

3.  For every V ∈ {S ∪ {a} : S ∈ 𝒫(X ∖ {a})}, V ∉ 𝒫(X ∖ {a}).
    thm:stdlib/functions/added-elements-are-new Y := 𝒫(X ∖ {a}), from 2

4.  𝒫(X ∖ {a}) ∩ {S ∪ {a} : S ∈ 𝒫(X ∖ {a})} = ∅
    thm:stdlib/sets/disjoint-empty, from 3


theorem powerset-split
  let X be a set                                                      (H1)
  let a ∈ X                                                           (H2)
  then 𝒫X = 𝒫(X ∖ {a}) ∪ {S ∪ {a} : S ∈ 𝒫(X ∖ {a})}

1.  For every V ∈ 𝒫X, V ∈ 𝒫(X ∖ {a}) ∪ {S ∪ {a} : S ∈ 𝒫(X ∖ {a})}.
    fix
    let V ∈ 𝒫X                                                        (K1)

    1.1.  V ⊆ X
          def:stdlib/sets/powerset S := V, from K1

    1.2.  a ∈ V or not a ∈ V
          thm:stdlib/reasoning/excluded-middle P := a ∈ V

    1.3.  V ∈ 𝒫(X ∖ {a}) ∪ {S ∪ {a} : S ∈ 𝒫(X ∖ {a})}
          cases, from 1.2

          case
          note V is a subset without a, with a put back
          assume a ∈ V                                                (C1)

          1.3.1.  V ∖ {a} ⊆ X ∖ {a}
                  thm:stdlib/sets/difference-shrinks, from 1.1

          1.3.2.  V ∖ {a} ∈ 𝒫(X ∖ {a})
                  def:stdlib/sets/powerset S := V ∖ {a}, from 1.3.1

          1.3.3.  (V ∖ {a}) ∪ {a} ∈ {S ∪ {a} : S ∈ 𝒫(X ∖ {a})}
                  thm:stdlib/functions/added-element-in-image Y := 𝒫(X ∖ {a}), s := V ∖ {a},
                    from 1.3.2

          1.3.4.  (V ∖ {a}) ∪ {a} = V
                  thm:stdlib/sets/remove-and-restore, from C1

          1.3.5.  V ∈ {S ∪ {a} : S ∈ 𝒫(X ∖ {a})}
                  substitute (V ∖ {a}) ∪ {a} = V (line 1.3.4) into line 1.3.3

          1.3.6.  V ∈ 𝒫(X ∖ {a}) ∪ {S ∪ {a} : S ∈ 𝒫(X ∖ {a})}
                  thm:stdlib/sets/in-union-right, from 1.3.5

          case
          note V leaves a out, so it is a subset of X ∖ {a}
          assume not a ∈ V                                            (C2)

          1.3.7.  V ⊆ X ∖ {a}
                  thm:stdlib/sets/subset-into-difference, from 1.1, C2

          1.3.8.  V ∈ 𝒫(X ∖ {a})
                  def:stdlib/sets/powerset S := V, from 1.3.7

          1.3.9.  V ∈ 𝒫(X ∖ {a}) ∪ {S ∪ {a} : S ∈ 𝒫(X ∖ {a})}
                  thm:stdlib/sets/in-union-left, from 1.3.8

2.  𝒫X ⊆ 𝒫(X ∖ {a}) ∪ {S ∪ {a} : S ∈ 𝒫(X ∖ {a})}
    def:stdlib/sets/subset, from 1

3.  X ∖ {a} ⊆ X
    thm:stdlib/sets/difference-subset

4.  𝒫(X ∖ {a}) ⊆ 𝒫X
    thm:stdlib/sets/powerset-monotone, from 3

5.  For every S ∈ 𝒫(X ∖ {a}), S ∪ {a} ∈ 𝒫X.
    fix
    let S ∈ 𝒫(X ∖ {a})                                                (K2)

    5.1.  S ⊆ X ∖ {a}
          def:stdlib/sets/powerset S := S, from K2

    5.2.  S ⊆ X
          thm:stdlib/sets/subset-transitive, from 5.1, 3

    5.3.  {a} ⊆ X
          thm:stdlib/sets/singleton-subset, from H2

    5.4.  S ∪ {a} ⊆ X
          thm:stdlib/sets/union-subset, from 5.2, 5.3

    5.5.  S ∪ {a} ∈ 𝒫X
          def:stdlib/sets/powerset S := S ∪ {a}, from 5.4

6.  {S ∪ {a} : S ∈ 𝒫(X ∖ {a})} ⊆ 𝒫X
    thm:stdlib/functions/added-elements-stay-inside Y := 𝒫(X ∖ {a}), Z := 𝒫X, from 5

7.  𝒫(X ∖ {a}) ∪ {S ∪ {a} : S ∈ 𝒫(X ∖ {a})} ⊆ 𝒫X
    thm:stdlib/sets/union-subset, from 4, 6

8.  𝒫X = 𝒫(X ∖ {a}) ∪ {S ∪ {a} : S ∈ 𝒫(X ∖ {a})}
    thm:stdlib/sets/subset-antisymmetric, from 2, 7


theorem subsets-count
  metamath    hashpw
  let n ∈ ℕ₀                                                          (H1)
  let A be a set                                                      (H2)
  assume |A| = n                                                      (H3)
  then |𝒫A| = 2^n

1.  For every set X, if |X| = n then |𝒫X| = 2^n.
    induction on n starting at 0, from H1

    base
    1.1.  For every set X, if |X| = 0 then |𝒫X| = 2^0.
          fix
          let X be a set                                              (K1)
          assume |X| = 0                                              (C1)

          1.1.1.  X = ∅
                  thm:stdlib/counting/card-zero, from C1

          1.1.2.  𝒫X = 𝒫∅
                  substitute X = ∅ (line 1.1.1)

          1.1.3.  𝒫∅ = {∅}
                  thm:stdlib/sets/powerset-empty

          1.1.4.  |{∅}| = 1
                  thm:stdlib/counting/card-singleton x := ∅

          1.1.5.  𝒫X = {∅}
                  calculation
                    𝒫X = 𝒫∅        1.1.2
                       = {∅}       1.1.3

          1.1.6.  |𝒫X| = 1
                  substitute 𝒫X = {∅} (line 1.1.5) into line 1.1.4

          1.1.7.  |𝒫X| = 2^0
                  calculation
                    |𝒫X| = 1        1.1.6
                         = 2^0      arithmetic

    step
    1.2.  For every k ∈ ℕ₀, if (for every set X, if |X| = k then |𝒫X| = 2^k)
          then (for every set X, if |X| = k + 1 then |𝒫X| = 2^(k + 1)).
          fix
          let k ∈ ℕ₀                                                  (K2)
          assume for every set X, if |X| = k then |𝒫X| = 2^k          (IH)

          1.2.1.  For every set X, if |X| = k + 1 then |𝒫X| = 2^(k + 1).
                  fix
                  note remove an element a and split the subsets of X by whether they contain it
                  let X be a set                                      (K3)
                  assume |X| = k + 1                                  (C2)

                  1.2.1.1.  a ∈ X
                            obtain a: thm:stdlib/counting/card-nonempty, from K2, C2

                  1.2.1.2.  |X ∖ {a}| = k
                            thm:stdlib/counting/card-remove, from 1.2.1.1, K2, C2

                  define U := 𝒫(X ∖ {a})                                 (D1)
                         reads the subsets of X that do not contain a
                  define T := {S ∪ {a} : S ∈ U}                          (D2)
                         reads the subsets of X that do contain a

                  1.2.1.3.  |U| = 2^k
                            instantiate X := X ∖ {a} in IH, from 1.2.1.2

                  1.2.1.4.  There is a bijection from U to T.
                            thm:add-element-bijection X := X ∖ {a}, from D2
                            requires a ∉ X ∖ {a}: thm:stdlib/sets/not-in-difference,
                              from K3

                  1.2.1.5.  |T| = 2^k
                            thm:stdlib/counting/card-bijection X := U, Y := T, m := 2^k,
                              from 1.2.1.3, 1.2.1.4
                            requires 2 ∈ ℕ₀: arithmetic
                            requires 2^k ∈ ℕ₀: thm:stdlib/numbers/power-nat0 a := 2, m := k, from K2

                  1.2.1.6.  U ∩ T = ∅
                            thm:powerset-split-disjoint, from 1.2.1.1

                  1.2.1.7.  𝒫X = U ∪ T
                            thm:powerset-split, from 1.2.1.1

                  1.2.1.8.  |U ∪ T| = 2^k + 2^k
                            thm:stdlib/counting/card-disjoint-union X := U, Y := T, m := 2^k,
                              n := 2^k, from 1.2.1.3, 1.2.1.5, 1.2.1.6
                            requires 2 ∈ ℕ₀: arithmetic
                            requires 2^k ∈ ℕ₀: thm:stdlib/numbers/power-nat0 a := 2, m := k, from K2

                  1.2.1.9.  |𝒫X| = 2^k + 2^k
                            substitute 𝒫X = U ∪ T (line 1.2.1.7) into line 1.2.1.8

                  1.2.1.10. 2^k + 2^k = 2^k·2
                            algebra
                            requires 2 ∈ ℝ: arithmetic
                            requires 2^k ∈ ℝ: thm:stdlib/numbers/power-real a := 2, m := k, from K2

                  1.2.1.11. 2^(k + 1) = 2^k·2
                            thm:stdlib/numbers/exponent-step a := 2, m := k, from K2
                            requires 2 ∈ ℝ: arithmetic

                  1.2.1.12. |𝒫X| = 2^(k + 1)
                            calculation
                              |𝒫X| = 2^k + 2^k      1.2.1.9
                                   = 2^k·2          1.2.1.10
                                   = 2^(k + 1)      1.2.1.11, right to left

2.  |𝒫A| = 2^n
    instantiate X := A in line 1, from H2, H3
