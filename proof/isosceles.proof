theorem isosceles
  metamath    isosctr
  let A be a point                                                    (H1)
  let B be a point                                                    (H2)
  let C be a point                                                    (H3)
  assume A, B, C form a triangle                                      (H4)
  assume |CA| = |CB|                                                  (H5)
  then ∠CAB = ∠CBA

1.  |AC| = |CA|
    thm:stdlib/geometry/distance-symmetric P := A, Q := C

2.  |CB| = |BC|
    thm:stdlib/geometry/distance-symmetric P := C, Q := B

3.  |AC| = |BC|
    calculation
      |AC| = |CA|       1
           = |CB|       H5
           = |BC|       2

4.  ∠ACB = ∠BCA
    thm:stdlib/geometry/angle-symmetric P := A, Q := C, R := B
    requires A ≠ C: def:stdlib/geometry/triangle, from H4
    requires B ≠ C: def:stdlib/geometry/triangle, from H4

5.  |CB| = |CA|
    calculation
      |CB| = |CA|       H5

6.  A, C, B form a triangle
    thm:stdlib/geometry/triangle-swap P := A, Q := B, R := C, from H4

7.  B, C, A form a triangle
    thm:stdlib/geometry/triangle-rotate P := A, Q := B, R := C, from H4

8.  triangle ACB ≅ triangle BCA
    thm:stdlib/geometry/side-angle-side P := A, Q := C, R := B, P′ := B, Q′ := C, R′ := A,
      from 6, 7, 3, 4, 5

9.  ∠BAC = ∠ABC
    def:stdlib/geometry/congruent, from 8

10. ∠CAB = ∠BAC
    thm:stdlib/geometry/angle-symmetric P := C, Q := A, R := B
    requires C ≠ A: def:stdlib/geometry/triangle, from 7
    requires B ≠ A: def:stdlib/geometry/triangle, from 7

11. ∠ABC = ∠CBA
    thm:stdlib/geometry/angle-symmetric P := A, Q := B, R := C
    requires A ≠ B: def:stdlib/geometry/triangle, from 6
    requires C ≠ B: def:stdlib/geometry/triangle, from 6

12. ∠CAB = ∠CBA
    calculation
      ∠CAB = ∠BAC       10
           = ∠ABC       9
           = ∠CBA       11
