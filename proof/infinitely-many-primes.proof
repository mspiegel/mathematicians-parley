theorem prime-above
  let n ∈ ℕ                                                           (H1)
  then there is p ∈ ℕ with p is prime and p > n

1.  n! ∈ ℕ
    thm:factorial-nat n := n, from H1

2.  n! + 1 ∈ ℕ
    thm:nat-closure a := n!, b := 1, from 1
    requires 1 ∈ ℕ: arithmetic

3.  n! ≥ 1
    thm:nat-ge-1 m := n!, from 1

4.  n! + 1 > 1
    inequalities, from 3
    requires n! ∈ ℝ: thm:nat-real, from 1

5.  p ∈ ℕ. p is prime. p divides n! + 1.
    obtain p: thm:prime-factor m := n! + 1, from 2, 4

6.  p > 1
    def:prime p := p, from 5

7.  p > n
    contradiction
    suppose not p > n                                                 (S)

    7.1.  p ≤ n
          inequalities, from S
          requires p ∈ ℝ: thm:nat-real, from 5
          requires n ∈ ℝ: thm:nat-real, from H1

    7.2.  p divides n!
          thm:factorial-divisible n := n, m := p, from H1, 5, 7.1

    7.3.  p divides (n! + 1) − n!
          thm:divides-difference d := p, a := n! + 1, b := n!, from 5, 7.2
          requires p ∈ ℤ: thm:nat-int, from 5
          requires n! + 1 ∈ ℤ: thm:nat-int, from 2
          requires n! ∈ ℤ: thm:nat-int, from 1

    7.4.  (n! + 1) − n! = 1
          algebra
          requires n! ∈ ℝ: thm:nat-real, from 1

    7.5.  p divides 1
          substitute (n! + 1) − n! = 1 (line 7.4) into line 7.3

    7.6.  p = 1
          thm:divides-one d := p, from 5, 7.5

    7.7.  not p = 1
          inequalities, from 6
          requires p ∈ ℝ: thm:nat-real, from 5

    7.8.  p = 1. not p = 1.
          join 7.6, 7.7

8.  There is p ∈ ℕ with p is prime and p > n.
    exhibit, from 5, 7
