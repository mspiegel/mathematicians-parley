import proof/triangle-inequality

theorem intermediate-value
  metamath    ivth, the general form
  let a ∈ ℝ                                                           (H1)
  let b ∈ ℝ                                                           (H2)
  assume a < b                                                        (H3)
  let f : [a, b] → ℝ                                                  (H4)
  assume f is continuous on [a, b]                                    (H5)
  assume f(a) < 0                                                     (H6)
  assume 0 < f(b)                                                     (H7)
  then there is c ∈ [a, b] with f(c) = 0

define S := {x ∈ [a, b] : f(x) < 0}                                   (D1)
       reads the points of the interval where f is still below zero

1.  a ∈ [a, b]
    def:stdlib/calculus/interval x := a, from H1, H2
    requires a ≤ a: inequalities, from H1
    requires a ≤ b: inequalities, from H1, H2, H3

2.  a ∈ S
    def:stdlib/sets/set-builder u := a, from 1, H6

3.  S ⊆ [a, b]
    thm:stdlib/sets/set-builder-subset, from D1

4.  [a, b] ⊆ ℝ
    thm:stdlib/calculus/interval-real, from H1, H2

5.  S ⊆ ℝ
    thm:stdlib/sets/subset-transitive X := S, Y := [a, b], Z := ℝ, from 3, 4

6.  For every s ∈ S, s ≤ b.
    fix
    let s ∈ S                                                         (K1)

    6.1.  s ∈ [a, b]
          def:stdlib/sets/set-builder, from K1

    6.2.  s ≤ b
          def:stdlib/calculus/interval, from H1, H2, 6.1

7.  b is an upper bound of S
    def:stdlib/calculus/upper-bound, from 6

8.  c ∈ ℝ. c is a least upper bound of S.
    obtain c: thm:stdlib/calculus/completeness S := S, from 5, 2, 7
    requires b ∈ ℝ: from H2

9.  c is an upper bound of S.
    For every u ∈ ℝ, if u is an upper bound of S then c ≤ u.
    def:stdlib/calculus/least-upper-bound, from 8

10. For every s ∈ S, s ≤ c.
    def:stdlib/calculus/upper-bound, from 9

11. a ≤ c
    instantiate s := a in line 10, from 2

12. c ≤ b
    instantiate u := b in line 9, from H2, 7

13. c ∈ [a, b]
    def:stdlib/calculus/interval x := c, from H1, H2, 8, 11, 12

14. f(c) ∈ ℝ
    thm:stdlib/functions/function-value, from 13

15. f(c) < 0 or f(c) = 0 or 0 < f(c)
    thm:stdlib/numbers/trichotomy x := f(c), from 14

16. For every c′ ∈ [a, b], for every ε ∈ ℝ with ε > 0,
    there is δ ∈ ℝ with δ > 0 and
    for every x ∈ [a, b], if |x − c′| < δ then |f(x) − f(c′)| < ε.
    def:stdlib/calculus/continuous-on, from H5

17. f(c) = 0
    cases, from 15

    case
    assume f(c) < 0                                                   (C1)

    17.1.  not c = b
           contradiction
           suppose not not c = b                                      (S1)

           17.1.1.  c = b
                    thm:stdlib/reasoning/double-negation P := c = b, from S1

           17.1.2.  f(b) < 0
                    substitute c = b (line 17.1.1) into C1

           17.1.3.  b ∈ [a, b]
                    def:stdlib/calculus/interval x := b, from H1, H2
                    requires a ≤ b: inequalities, from H1, H2, H3
                    requires b ≤ b: inequalities, from H2

           17.1.4.  f(b) ∈ ℝ
                    thm:stdlib/functions/function-value, from 17.1.3

           17.1.5.  not f(b) < 0
                    inequalities, from H7
                    requires f(b) ∈ ℝ: from 17.1.4

           17.1.6.  f(b) < 0. not f(b) < 0.
                    join 17.1.2, 17.1.5

    17.2.  c < b
           inequalities, from 12, 17.1
           requires c ∈ ℝ: from 8
           requires b ∈ ℝ: from H2

    17.3.  −f(c) > 0
           inequalities, from C1
           requires f(c) ∈ ℝ: from 14

    17.4.  There is δ ∈ ℝ with δ > 0 and
           for every x ∈ [a, b], if |x − c| < δ then |f(x) − f(c)| < −f(c).
           instantiate c′ := c, ε := −f(c) in line 16, from 13, 14, 17.3

    17.5.  δ ∈ ℝ. δ > 0.
           For every x ∈ [a, b], if |x − c| < δ then |f(x) − f(c)| < −f(c).
           obtain δ from line 17.4

    define x₁ := min(b, c + δ/2)                                       (D2)
           reads a point right of c, within δ of it, and not past b

    17.6.  δ/2 > 0
           thm:stdlib/numbers/half-positive x := δ, from 17.5

    17.7.  c + δ/2 ∈ ℝ
           thm:stdlib/numbers/real-closure x := c, y := δ/2, from 8
           requires δ/2 ∈ ℝ: thm:stdlib/numbers/half-real x := δ, from 17.5

    17.8.  c < c + δ/2
           inequalities, from 17.6
           requires c ∈ ℝ: from 8
           requires δ ∈ ℝ: from 17.5
           requires δ/2 ∈ ℝ: thm:stdlib/numbers/half-real x := δ, from 17.5

    17.9.  x₁ ∈ ℝ
           thm:stdlib/numbers/min-real x := b, y := c + δ/2, from H2, 17.7

    17.10. c < x₁
           thm:stdlib/numbers/lt-min z := c, x := b, y := c + δ/2, from 8, H2, 17.7, 17.2, 17.8

    17.11. x₁ ≤ b. x₁ ≤ c + δ/2.
           thm:stdlib/numbers/min-le x := b, y := c + δ/2, from H2, 17.7

    17.12. x₁ − c < δ
           inequalities, from 17.11, 17.6
           requires x₁ ∈ ℝ: from 17.9
           requires c ∈ ℝ: from 8
           requires δ/2 ∈ ℝ: thm:stdlib/numbers/half-real x := δ, from 17.5
           requires δ ∈ ℝ: from 17.5

    17.13. a ≤ x₁
           inequalities, from 11, 17.10
           requires a ∈ ℝ: from H1
           requires c ∈ ℝ: from 8
           requires x₁ ∈ ℝ: from 17.9

    17.14. x₁ ∈ [a, b]
           def:stdlib/calculus/interval x := x₁, from H1, H2, 17.9, 17.13, 17.11

    17.15. c − δ < x₁
           inequalities, from 17.10, 17.5
           requires c ∈ ℝ: from 8
           requires x₁ ∈ ℝ: from 17.9
           requires δ ∈ ℝ: from 17.5

    17.16. x₁ < c + δ
           inequalities, from 17.12
           requires c ∈ ℝ: from 8
           requires x₁ ∈ ℝ: from 17.9
           requires δ ∈ ℝ: from 17.5

    17.17. |x₁ − c| < δ
           thm:stdlib/numbers/abs-difference-lt x := x₁, c := c, δ := δ, from 17.9, 8, 17.5, 17.15, 17.16

    17.18. |f(x₁) − f(c)| < −f(c)
           instantiate x := x₁ in line 17.5, from 17.14, 17.17

    17.19. f(x₁) ∈ ℝ
           thm:stdlib/functions/function-value, from 17.14

    17.20. f(x₁) − f(c) ∈ ℝ
           thm:stdlib/numbers/real-closure, from 17.19, 14

    17.21. f(x₁) − f(c) ≤ |f(x₁) − f(c)|
           thm:proof/triangle-inequality/abs-bounds x := f(x₁) − f(c), from 17.20

    17.22. f(x₁) < 0
           inequalities, from 17.21, 17.18
           requires f(x₁) ∈ ℝ: from 17.19
           requires f(c) ∈ ℝ: from 14
           requires |f(x₁) − f(c)| ∈ ℝ: thm:stdlib/numbers/abs-real x := f(x₁) − f(c), from 17.20

    17.23. x₁ ∈ S
           def:stdlib/sets/set-builder u := x₁, from 17.14, 17.22

    17.24. x₁ ≤ c
           instantiate s := x₁ in line 10, from 17.23

    17.25. not x₁ ≤ c
           inequalities, from 17.10
           requires c ∈ ℝ: from 8
           requires x₁ ∈ ℝ: from 17.9

    17.26. x₁ ≤ c. not x₁ ≤ c.
           join 17.24, 17.25

    17.27. f(c) = 0
           thm:stdlib/reasoning/from-contradiction P := x₁ ≤ c, Q := f(c) = 0, from 17.26

    case
    assume f(c) = 0                                                   (C2)

    17.28. f(c) = 0
           join C2

    case
    assume 0 < f(c)                                                   (C3)

    17.29. There is δ ∈ ℝ with δ > 0 and
           for every x ∈ [a, b], if |x − c| < δ then |f(x) − f(c)| < f(c).
           instantiate c′ := c, ε := f(c) in line 16, from 13, 14, C3

    17.30. δ ∈ ℝ. δ > 0.
           For every x ∈ [a, b], if |x − c| < δ then |f(x) − f(c)| < f(c).
           obtain δ from line 17.29

    17.31. For every s ∈ S, s ≤ c − δ.
           fix
           let s ∈ S                                                  (K2)

           17.31.1.  s ∈ [a, b]
                     def:stdlib/sets/set-builder, from K2

           17.31.2.  f(s) < 0
                     def:stdlib/sets/set-builder, from K2

           17.31.3.  s ∈ ℝ
                     def:stdlib/calculus/interval, from H1, H2, 17.31.1

           17.31.4.  s ≤ c
                     instantiate s := s in line 10, from K2

           17.31.5.  s ≤ c − δ
                     contradiction
                     suppose not s ≤ c − δ                            (S2)

                     17.31.5.1.  c − δ < s
                                 inequalities, from S2
                                 requires c ∈ ℝ: from 8
                                 requires s ∈ ℝ: from 17.31.3
                                 requires δ ∈ ℝ: from 17.30

                     17.31.5.2.  s < c + δ
                                 inequalities, from 17.31.4, 17.30
                                 requires c ∈ ℝ: from 8
                                 requires s ∈ ℝ: from 17.31.3
                                 requires δ ∈ ℝ: from 17.30

                     17.31.5.3.  |s − c| < δ
                                 thm:stdlib/numbers/abs-difference-lt x := s, c := c, δ := δ,
                                   from 17.31.3, 8, 17.30, 17.31.5.1, 17.31.5.2

                     17.31.5.4.  |f(s) − f(c)| < f(c)
                                 instantiate x := s in line 17.30, from 17.31.1, 17.31.5.3

                     17.31.5.5.  f(s) ∈ ℝ
                                 thm:stdlib/functions/function-value, from 17.31.1

                     17.31.5.6.  f(s) − f(c) ∈ ℝ
                                 thm:stdlib/numbers/real-closure, from 17.31.5.5, 14

                     17.31.5.7.  −(f(s) − f(c)) ≤ |f(s) − f(c)|
                                 thm:proof/triangle-inequality/abs-bounds x := f(s) − f(c), from 17.31.5.6

                     17.31.5.8.  0 < f(s)
                                 inequalities, from 17.31.5.7, 17.31.5.4
                                 requires f(s) ∈ ℝ: from 17.31.5.5
                                 requires f(c) ∈ ℝ: from 14
                                 requires |f(s) − f(c)| ∈ ℝ: thm:stdlib/numbers/abs-real x := f(s) − f(c),
                                   from 17.31.5.6

                     17.31.5.9.  not f(s) < 0
                                 inequalities, from 17.31.5.8
                                 requires f(s) ∈ ℝ: from 17.31.5.5

                     17.31.5.10. f(s) < 0. not f(s) < 0.
                                 join 17.31.2, 17.31.5.9

    17.32. c − δ is an upper bound of S
           def:stdlib/calculus/upper-bound, from 17.31

    17.33. c ≤ c − δ
           instantiate u := c − δ in line 9, from 17.32
           requires c − δ ∈ ℝ: thm:stdlib/numbers/real-closure, from 8, 17.30

    17.34. not c ≤ c − δ
           inequalities, from 17.30
           requires c ∈ ℝ: from 8
           requires δ ∈ ℝ: from 17.30

    17.35. c ≤ c − δ. not c ≤ c − δ.
           join 17.33, 17.34

    17.36. f(c) = 0
           thm:stdlib/reasoning/from-contradiction P := c ≤ c − δ, Q := f(c) = 0, from 17.35

18. There is c ∈ [a, b] with f(c) = 0.
    exhibit, from 13, 17
