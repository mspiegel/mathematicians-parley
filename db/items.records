# Definitions and theorems
#
# One record per item. A record begins at column 0 with its kind and name; a
# proof cites it as def:<name> or thm:<name>, and the prefix must match the
# kind. Format is described in DATABASE.md.
#
# An item's statement is written in the theorem form of SYNTAX.md: let and
# assume lines with labels, then a `then` line. An item proved in this corpus
# carries no statement here, only `proved-in`, so that the statement has one
# home and cannot drift.
#
# Every item carries exactly one of:
#   proved-in   a proof file in this corpus proves it
#   metamath    a set.mm label or labels supply it
#   open        neither; it is cited but unproved and unbridged
#
# Other fields: first-used, note.


# ---------------------------------------------------------------- logic

theorem excluded-middle
  then        P or not P
  metamath    exmid
  target      exmid
  first-used  cantor
  note        The first citation to substitute a formula for a variable rather
              than a term. A school reader has never been told that "P or not P"
              is a law, which is why it is cited and not folded into a method.

theorem from-contradiction
  assume P                                                            (H1)
  assume not P                                                        (H2)
  then        Q
  metamath    pm2.21
  first-used  intermediate-value
  note        Closes an impossible case of a `cases` block so that every case
              ends in the block's common claim.

theorem double-negation
  assume not not P                                                    (H1)
  then        P
  metamath    notnotr
  target      notnotr
  first-used  cantor
  note        The step intuitionistic logic refuses, so citing it is the text
              saying which logic it is in. It appears because the contradiction
              rule demands the literal negation of the claim, and a claim that
              is itself a negation therefore produces a doubled one.

theorem disjunctive-syllogism
  assume P or Q                                                       (H1)
  assume not Q                                                        (H2)
  then        P
  metamath    orel2
  target      orel2
  first-used  sqrt2-irrational
  note        The √2 pilot asked whether a school reader can check this on
              paper, and called it the acceptance test. Citing it puts the
              question where a reader can see it rather than inside a method.


# ----------------------------------------------------------------- sets

definition subset
  then        X ⊆ Y ↔ for every t ∈ X, t ∈ Y
  metamath    df-ss, ssel
  target      dfss3
  first-used  bezout

definition set-builder
  let X be a set                                                      (H1)
  let P be a property of the elements of X                            (H2)
  then        u ∈ {t ∈ X : P(t)} ↔ u ∈ X and P(u)
  metamath    rabid, elrab
  target      rabid, elrab
  first-used  bezout
  note        P(t) says the property holds of t. The line above says what P is
              a property of and never mentions t, because the braces are what
              introduce t: it does not exist until they open. See the
              `holds-of` notation for why this is not a function applied to an
              argument.

              The element is u and the braces bind t, as def:set-image writes
              them. Both were t until the conclusion check went in, and a
              statement that uses one letter for a free name and for the name
              the braces bind cannot be matched against a use of it: the free
              one binds to the element and the bound one then has to be the
              element too.

definition set-image
  let Y be a set                                                      (H1)
  let Z be a set                                                      (H2)
  let E : Y → Z                                                       (H3)
  then        u ∈ {E(s) : s ∈ Y} ↔ there is s ∈ Y with u = E(s)
  metamath    cmpt with elrnmpt, or crab with a witness
  first-used  subsets
  note        Named in SYNTAX.md beside def:set-builder. No pilot table carried
              a row for it; the statement here is SYNTAX.md's sentence. Added by
              the merge.

theorem set-builder-subset
  let X be a set                                                      (H1)
  let P be a property of the elements of X                            (H2)
  then        {t ∈ X : P(t)} ⊆ X
  metamath    ssrab2
  target      ssrab2
  first-used  bezout

theorem subset-transitive
  assume X ⊆ Y                                                        (H1)
  assume Y ⊆ Z                                                        (H2)
  then        X ⊆ Z
  metamath    sstr
  first-used  intermediate-value

definition powerset
  let A be a set                                                      (H1)
  then        S ∈ 𝒫A ↔ S ⊆ A
  metamath    elpw, elpwg
  target      elpwg
  first-used  cantor

theorem powerset-empty
  then        𝒫∅ = {∅}
  metamath    pw0
  target      pw0
  first-used  subsets

theorem difference-set
  let X be a set                                                      (H1)
  then        X ∖ {a} is a set
  metamath    difexg
  target      difexg
  first-used  subsets

theorem subset-of-difference
  assume Y ⊆ X ∖ {a}                                                  (H1)
  then        a ∉ Y
  metamath    ssdifsn
  target      ssdifsn
  first-used  subsets
  note        The half of `ssdifsn` the corpus wants. Being inside X ∖ {a}
              says two things at once, and this is the second of them.

theorem difference-of-union
  then        (Y ∪ {a}) ∖ {a} = Y ∖ {a}
  metamath    difun2
  target      difun2
  first-used  subsets

theorem difference-absent
  assume a ∉ Y                                                        (H1)
  then        Y ∖ {a} = Y
  metamath    difsn
  target      difsn
  first-used  subsets

theorem not-in-subset
  assume Y ⊆ Z                                                        (H1)
  assume a ∉ Z                                                        (H2)
  then        a ∉ Y
  metamath    ssneld
  target      ssneld
  first-used  subsets

theorem in-union-singleton
  then        a ∈ Y ∪ {a}
  metamath    elun2, over the singleton snidg puts a in
  target      elun2
  first-used  subsets

theorem disjoint-empty
  assume for every s ∈ Z, s ∉ Y                                       (H1)
  then        Y ∩ Z = ∅
  metamath    disjr
  target      disjr
  first-used  subsets
  note        Two sets are disjoint when nothing in one is in the other, which
              is what a reader proves. set.mm says it twice, over the first set
              in `disj` and over the second in `disjr`, and the second is the
              one the subsets proof has: what it can run over is the part it
              built, not the part it split off.

theorem added-elements-are-new
  let Y be a set                                                      (H1)
  assume for every s ∈ Y, s ∪ {a} ∉ Y                                 (H2)
  then        for every u ∈ {s ∪ {a} : s ∈ Y}, u ∉ Y
  metamath    ralrnmpt
  target      ralrnmpt
  note        Running over the sets with a added is running over the sets and
              adding a, which `ralrnmpt` says of the range of any map written
              on the spot and of any property of its members. Both are
              narrowed here to the one map the corpus writes and the one
              property it asks, because the language can name neither — the
              same gap `notation bijection` records.

theorem not-in-difference
  let X be a set                                                      (H1)
  then        a ∉ X ∖ {a}
  metamath    neldifsn
  target      neldifsn
  first-used  subsets
  note        Added because thm:add-element-bijection assumes the element it
              adds is not already there, and the subsets proof adds it back to
              X ∖ {a} without ever saying so.


# ------------------------------------------------ numbers and arithmetic

definition rational
  then        x ∈ ℚ ↔ there are p ∈ ℤ and q ∈ ℤ with q ≠ 0 and x = p/q
  metamath    elq
  first-used  sqrt2-irrational

definition irrational
  then        x is irrational ↔ x ∈ ℝ and x ∉ ℚ
  metamath    ℝ ∖ ℚ, as in sqrt2irr0
  target      eldif
  first-used  sqrt2-irrational
  note        Names a word for an existing set.mm construct rather than
              introducing a symbol. See DATABASE.md on what def: means.

definition sqrt
  let x ∈ ℝ                                                           (H1)
  assume x ≥ 0                                                        (H2)
  then        √x ∈ ℝ. √x ≥ 0. (√x)² = x.
  metamath    df-sqrt, resqrtcl, sqrtge0, resqrtth
  target      resqrtcl, sqrtge0, resqrtth
  first-used  sqrt2-irrational

definition even
  let n ∈ ℤ                                                           (H1)
  then        n is even ↔ there is k ∈ ℤ with n = 2k
  metamath    df-dvds, whose right side is the same existential
  target      divides, equation reversed
  first-used  sqrt2-irrational
  note        set.mm writes 2 ∥ n and has no primitive for "even". This names the
              word. See DATABASE.md on what def: means.

              The field said `dvds`, which is not a label. df-dvds defines ∥ as
              the pairs with an n ∈ ℤ making n·x = y, so the unfolding is the
              same existential this statement writes. Found by checking every
              label the database names against set.mm.

definition odd
  let n ∈ ℤ                                                           (H1)
  then        n is odd ↔ there is k ∈ ℤ with n = 2k + 1
  metamath    not 2 ∥ n
  target      odd2np1, equation reversed
  first-used  sqrt2-irrational

theorem int-closure
  let a ∈ ℤ                                                           (H1)
  then        a² ∈ ℤ
  let b ∈ ℤ                                                           (H2)
  then        a + b ∈ ℤ. a − b ∈ ℤ. a·b ∈ ℤ.
  metamath    zsqcl, zaddcl, zsubcl, zmulcl
  target      zsqcl, zaddcl, zsubcl, zmulcl
  first-used  sqrt2-irrational
  note        The square stands in a group of its own because it needs one
              integer and the rest need two. A proof asking only that n² is an
              integer cites this item from one line, and a `then` group with
              one `let` above it is how the database says so. See DATABASE.md
              on groups.

theorem nat-closure
  let a ∈ ℕ                                                           (H1)
  let b ∈ ℕ                                                           (H2)
  then        a + b ∈ ℕ. a·b ∈ ℕ.
  metamath    nnaddcl, nnmulcl
  target      nnaddcl, nnmulcl
  first-used  infinitely-many-primes

theorem real-closure
  let x ∈ ℝ                                                           (H1)
  let y ∈ ℝ                                                           (H2)
  then        x + y ∈ ℝ. x − y ∈ ℝ.
  metamath    readdcl, resubcl
  target      readdcl, resubcl
  first-used  triangle-inequality
  note        The triangle inequality pilot stated addition only; the
              intermediate value pilot stated both. Merged to both, which is the
              shape of int-closure and nat-closure. Neither proof changes.

theorem nat0-closure
  let k ∈ ℕ₀                                                          (H1)
  then        k + 1 ∈ ℕ₀
  metamath    peano2nn0
  target      peano2nn0
  first-used  geometric-series

theorem nat-int
  let m ∈ ℕ                                                           (H1)
  then        m ∈ ℤ
  metamath    nnz
  target      nnz
  first-used  infinitely-many-primes

theorem int-real
  let m ∈ ℤ                                                           (H1)
  then        m ∈ ℝ
  metamath    zre
  target      zre
  first-used  bezout
  note        `algebra` and `inequalities` work over a field, so a step
              reasoning about integers carries its atoms into ℝ first.

theorem nat-real
  let m ∈ ℕ                                                           (H1)
  then        m ∈ ℝ
  metamath    nnre
  target      nnre
  first-used  infinitely-many-primes
  note        Direct rather than through nat-int and int-real. The chain would
              be two citations, and a requires line carries one, so every
              natural atom would need a numbered step of its own. set.mm has
              the direct lemma, so the expansion is direct too.

theorem nat0-real
  let m ∈ ℕ₀                                                          (H1)
  then        m ∈ ℝ
  metamath    nn0re
  first-used  subsets
  note        Direct, for the same reason as nat-real.

theorem nat-ge-1
  let m ∈ ℕ                                                           (H1)
  then        m ≥ 1
  metamath    nnge1
  target      nnge1
  first-used  infinitely-many-primes

theorem pos-int-nat
  let m ∈ ℤ                                                           (H1)
  assume 0 < m                                                        (H2)
  then        m ∈ ℕ
  metamath    elnnz
  target      elnnz
  first-used  bezout

theorem even-or-odd
  let n ∈ ℤ                                                           (H1)
  then        n is even or n is odd
  metamath    exmid
  target      exmid
  first-used  sqrt2-irrational
  note        def:odd makes "n is odd" the negation of "n is even", so this
              statement is excluded middle, ( ph or not ph ), and the
              expansion never uses H1. zeo says the same thing for an encoding
              where "odd" means n - 1 is even, which is not the one def:odd
              chose.

theorem not-both
  let n ∈ ℤ                                                           (H1)
  assume n is even                                                    (H2)
  then        n is not odd
  metamath    notnot
  target      notnot
  first-used  sqrt2-irrational
  note        def:odd makes "n is odd" the negation of H2, so this statement is
              double negation introduction, ( ph -> not not ph ), and the
              expansion never uses H1.

theorem exponent-step
  let a ∈ ℝ                                                           (H1)
  let m ∈ ℕ₀                                                          (H2)
  then        a^(m + 1) = a^m·a
  metamath    expp1
  target      expp1
  first-used  geometric-series

theorem power-real
  let a ∈ ℝ                                                           (H1)
  let m ∈ ℕ₀                                                          (H2)
  then        a^m ∈ ℝ
  metamath    reexpcl
  target      reexpcl
  first-used  geometric-series
  note        A power whose exponent is not a numeral is an atom to `algebra`,
              so it has to be known real in its own right rather than through
              its base.

theorem exponent-one
  let a ∈ ℝ                                                           (H1)
  then        a^1 = a
  metamath    exp1
  target      exp1
  first-used  geometric-series
  note        The base case of the geometric series needs a^(0 + 1) = a. The
              arithmetic is 0 + 1 = 1; that a^1 is a is this exponent law, and
              exponent laws are theorems rather than closure methods.

theorem trichotomy
  let x ∈ ℝ                                                           (H1)
  then        x < 0 or x = 0 or 0 < x
  metamath    lttri4, 0re
  first-used  intermediate-value

theorem nonneg-or-neg
  let x ∈ ℝ                                                           (H1)
  then        x ≥ 0 or x < 0
  metamath    0re, lelttric
  target      lelttric
  first-used  triangle-inequality

theorem rational-coprime
  let x ∈ ℚ                                                           (H1)
  then        there are p ∈ ℤ and q ∈ ℕ with x = p/q and gcd(p, q) = 1
  metamath    elq2
  target      elq2 with Q := x
  first-used  sqrt2-irrational
  note        set.mm's second reading of being rational, beside elq, which is
              def:rational. An implication and not a biconditional: it says a
              rational can be written one way, not what one is.

theorem divides-gcd
  let d ∈ ℤ                                                           (H1)
  let a ∈ ℤ                                                           (H2)
  let b ∈ ℤ                                                           (H3)
  assume d divides a                                                  (H4)
  assume d divides b                                                  (H5)
  then        d divides gcd(a, b)
  metamath    dvdsgcd
  target      dvdsgcd
  first-used  sqrt2-irrational

theorem lowest-terms
  proved-in   proof/sqrt2-irrational.proof
  note        Hammack chapter 6 takes a fraction in lowest terms as given.
              set.mm has it as elq2, which says lowest terms with a gcd where
              a reader says it with divisors, and that step is the proof.

theorem division-algorithm
  let n ∈ ℕ                                                           (H1)
  let d ∈ ℕ                                                           (H2)
  then        there are q ∈ ℤ and r ∈ ℤ with n = q·d + r, 0 ≤ r, and r < d
  metamath    divalg
  target      divalg with N := n, D := d
  first-used  bezout
  note        divalg says exactly one remainder, quantified the other way
              round, bounded by the absolute value, and saying its three
              things in a different order. The elaborator takes its
              existential apart and puts this one back, which is what makes
              the last two of those stop being differences. Nothing fixes
              divalg's own variables, because its conclusion is never
              matched against this claim, so `with` says which is which.

theorem well-ordering
  assume S ⊆ ℕ                                                        (H1)
  assume there is s ∈ S                                               (H2)
  then        there is d ∈ S with for every s ∈ S, d ≤ s
  metamath    nnwo
  target      nnwo
  first-used  bezout
  note        Whether S also needs "let S be a set" is open; see DATABASE.md.

definition S
  then        S(1) = 1
  let n ∈ ℕ                                                           (H1)
  then        S(n + 1) = S(n) + (n + 1)
  metamath    fsum1, fsump1
  target      fsum1, fsump1
  first-used  sum-formula
  note        Local to the sum-formula pilot. Two `then` groups: the base
              sentence has no hypothesis and the step sentence has H1. See
              DATABASE.md on recursive definitions.

definition G
  let a ∈ ℝ                                                           (H1)
  then        G(0) = 1
  let n ∈ ℕ₀                                                          (H2)
  then        G(n + 1) = G(n) + a^(n + 1)
  metamath    Σ over 0...n with fsum1 and fsump1
  target      fsum1, fsump1
  first-used  geometric-series
  note        Local to the geometric-series pilot. Two `then` groups, as def:S.
              The same two lemmas as def:S, reached differently. fsum1 says a
              one-term sum is its summand read at the limit, which for def:S
              is 1 outright and here is a^0; the elaborator proves it at that
              value and exp0 carries it to the 1 this definition writes,
              in the theorem's scope where a is known to be real. Naming 1
              to fsum1 instead cannot work: that hypothesis has no
              antecedent, so nothing about a is available inside it.


# ------------------------------------------------ divisibility and primes

definition divides
  let d ∈ ℤ                                                           (H1)
  let n ∈ ℤ                                                           (H2)
  then        d divides n ↔ there is k ∈ ℤ with n = d·k
  metamath    df-dvds, as divides states it
  target      divides, equation reversed
  first-used  sqrt2-irrational
  note        Defined once on ℤ. A proof about ℕ discharges membership of ℤ as a
              dull fact. This is the principle recorded by the primes pilot: a
              relation is defined once, on the widest set where it makes sense.

definition prime
  let p ∈ ℕ                                                           (H1)
  then        p is prime ↔ p > 1 and for every d ∈ ℕ, if d divides p then
              d = 1 or d = p
  metamath    isprm2, whose first conjunct is membership of ℤ≥2
  target      isprm2
  first-used  infinitely-many-primes
  note        isprm2 writes p > 1 as p ∈ ℤ≥2, which is not the formula this
              line writes, so unfolding the definition does not land on the
              words of the right side. What carries one to the other is
              eluz2gt1, declared with the rest of what an elaborator may
              lean on. `target` still names the unfolding and nothing else.

definition factorial
  then        1! = 1
  let n ∈ ℕ                                                           (H1)
  then        (n + 1)! = n!·(n + 1)
  metamath    fac1, facp1
  first-used  infinitely-many-primes
  note        Two `then` groups, as def:S.

definition gcd
  let a ∈ ℕ                                                           (H1)
  let b ∈ ℕ                                                           (H2)
  then        gcd(a, b) ∈ ℕ. gcd(a, b) divides a. gcd(a, b) divides b.
              For every e ∈ ℕ, if e divides a and e divides b then
              e ≤ gcd(a, b).
  metamath    gcdnncl, gcddvds, dvdslegcd
  target      gcdnncl, gcddvds, dvdslegcd
  note        Four sentences from three lemmas. gcdcl puts a gcd in ℕ₀ and
              this statement puts it in ℕ, which gcdnncl gives because both
              arguments are natural numbers; gcddvds says in one conjunction
              what the second and third sentences say separately; and
              dvdslegcd is the fourth said of one divisor where this says it
              of every e ∈ ℕ.
  first-used  bezout

theorem prime-factor
  let m ∈ ℕ                                                           (H1)
  assume m > 1                                                        (H2)
  then        there is p ∈ ℕ with p is prime and p divides m
  metamath    exprmfct, which quantifies over Prime rather than over ℕ
  target      exprmfct
  first-used  infinitely-many-primes
  note        No target, so an elaborator states this and lists it. exprmfct
              says E. p e. Prime p || N, putting primality in the domain; this
              quantifies over ℕ and says it in the body, which is how a reader
              meets the claim. The two are equivalent and the bridge is a proof
              rather than a field of this file.

theorem factorial-nat
  let n ∈ ℕ                                                           (H1)
  then        n! ∈ ℕ
  metamath    faccl, which states it on ℕ0
  target      faccl
  first-used  infinitely-many-primes

theorem factorial-divisible
  let n ∈ ℕ                                                           (H1)
  let m ∈ ℕ                                                           (H2)
  assume m ≤ n                                                        (H3)
  then        m divides n!
  metamath    dvdsfac, which asks m ≤ n as membership of ℤ≥m
  target      dvdsfac
  first-used  infinitely-many-primes

theorem divides-difference
  let d ∈ ℤ                                                           (H1)
  let a ∈ ℤ                                                           (H2)
  let b ∈ ℤ                                                           (H3)
  assume d divides a                                                  (H4)
  assume d divides b                                                  (H5)
  then        d divides a − b
  metamath    dvds2sub
  target      dvds2sub
  first-used  infinitely-many-primes

theorem divides-one
  let d ∈ ℕ                                                           (H1)
  assume d divides 1                                                  (H2)
  then        d = 1
  metamath    dvds1, read left to right
  target      dvds1
  first-used  infinitely-many-primes

theorem divides-combination
  let e ∈ ℤ                                                           (H1)
  let a ∈ ℤ                                                           (H2)
  let b ∈ ℤ                                                           (H3)
  let x ∈ ℤ                                                           (H4)
  let y ∈ ℤ                                                           (H5)
  assume e divides a                                                  (H6)
  assume e divides b                                                  (H7)
  then        e divides a·x + b·y
  metamath    dvds2ln
  target      dvds2ln with K := e, I := x, M := a, J := y, N := b
  first-used  bezout

theorem divides-le
  let e ∈ ℕ                                                           (H1)
  let m ∈ ℕ                                                           (H2)
  assume e divides m                                                  (H3)
  then        e ≤ m
  metamath    dvdsle
  target      dvdsle
  first-used  bezout


# ------------------------------------------- order and absolute value

definition abs
  let x ∈ ℝ                                                           (H1)
  then        if x ≥ 0 then |x| = x. if x < 0 then |x| = −x.
  metamath    absid, absnid
  target      absid, absnid
  first-used  triangle-inequality
  note        set.mm defines abs on ℂ by df-abs as √(x·x̄); absid and absnid are
              the real case. So this elaborates to a pair of theorems, not to a
              definition. It is still called def:abs because that is what it is
              to Reader A.

theorem abs-real
  let x ∈ ℝ                                                           (H1)
  then        |x| ∈ ℝ
  metamath    recn, abscl
  target      abscl
  first-used  triangle-inequality
  note        No proof cites it yet. `inequalities` treats |x| as an atom it
              knows nothing about, so an absolute value has to be known real
              like any other term. Eight steps of the triangle inequality and
              intermediate value proofs will need it. set.mm defines abs on ℂ
              by df-abs, so the real case goes through recn. See METHODS.md.

theorem abs-difference-lt
  let x ∈ ℝ                                                           (H1)
  let c ∈ ℝ                                                           (H2)
  let δ ∈ ℝ                                                           (H3)
  then        |x − c| < δ ↔ c − δ < x and x < c + δ
  metamath    absdiflt, abslt
  first-used  intermediate-value


# ----------------------------------------------- functions and counting

definition function
  open        The Cantor pilot's row reads "f : A → B ↔ for every x ∈ A,
              f(x) ∈ B, and ..." and is truncated. No pilot cites it. The
              statement has to be written before the item exists.
  first-used  cantor
  note        set.mm's df-f is the target. The Cantor proof needs f only for the
              elaborator, since no step cites it; see that pilot's findings.

theorem function-value
  let f : D → ℝ                                                       (H1)
  let x ∈ D                                                           (H2)
  then        f(x) ∈ ℝ
  metamath    ffvelcdm
  first-used  intermediate-value
  note        The intermediate value pilot called this def:function, colliding
              with the Cantor pilot's definition of the same name. Renamed by the
              merge; that proof's three citations are renamed with it.

definition card
  let A be a set                                                      (H1)
  let n ∈ ℕ₀                                                          (H2)
  then        |A| = n ↔ there is a bijection from {i ∈ ℕ : i ≤ n} to A
  metamath    hashen, hashfz1
  first-used  subsets

theorem card-zero
  let X be a set                                                      (H1)
  assume |X| = 0                                                      (H2)
  then        X = ∅
  metamath    hasheq0
  target      hasheq0
  first-used  subsets

theorem card-singleton
  let x be a set                                                      (H1)
  then        |{x}| = 1
  metamath    hashsng
  target      hashsng
  first-used  subsets
  note        A singleton has one element only when there is an element for it
              to have: `{ x }` for a proper class x is empty, and `hashsng`
              asks for the set because of it.

theorem card-nonempty
  let X be a set                                                      (H1)
  assume |X| = k + 1                                                  (H2)
  then        there is a ∈ X
  metamath    hashnncl, n0
  first-used  subsets
  note        No `target` yet, and the same bridge `thm:card-remove` wants:
              `hashnncl` asks that the size be a natural number where the
              hypothesis says what the size is.

theorem card-remove
  let X be a set                                                      (H1)
  let a ∈ X                                                           (H2)
  assume |X| = k + 1                                                  (H3)
  then        |X ∖ {a}| = k
  metamath    hashdifsn
  first-used  subsets
  note        No `target` yet. `hashdifsn` says the size drops by one and the
              item says what it drops to, so the bridge between them is
              `( k + 1 ) - 1 = k` read through the hypothesis that says what
              the size was. An elaborator that rewrote by an equation a step
              cited would have it; none does.

theorem card-bijection
  let X be a set                                                      (H1)
  let Y be a set                                                      (H2)
  assume |X| = m                                                      (H3)
  assume there is a bijection from X to Y                             (H4)
  then        |Y| = m
  metamath    hashen
  target      hashen with A := X, B := Y
  first-used  subsets

theorem card-disjoint-union
  let X be a set                                                      (H1)
  let Y be a set                                                      (H2)
  assume |X| = m                                                      (H3)
  assume |Y| = n                                                      (H4)
  assume X ∩ Y = ∅                                                    (H5)
  then        |X ∪ Y| = m + n
  metamath    hashun
  target      hashun with A := X, B := Y
  first-used  subsets

theorem image-of-injection
  let Y be a set                                                      (H1)
  assume for every S ∈ Y, for every T ∈ Y, if S ∪ {a} = T ∪ {a}
         then S = T                                                   (H2)
  then        there is a bijection from Y to {S ∪ {a} : S ∈ Y}
  metamath    f1oeng, over the map f1mpt and f1f1orn show is one-to-one
  target      f1oeng with F := the map sending S ∈ Y to S ∪ {a}
  first-used  subsets
  note        A map that sends no two things to the same place pairs its
              domain off against what comes out of it. Narrowed to the one
              map the corpus builds, as `thm:added-elements-are-new` is: the
              readable layer states the property and the `target` names the
              map, because a reader says "if S ∪ {a} = T ∪ {a} then S = T"
              and does not name a function to say it.

theorem add-element-bijection
  proved-in   proof/subsets.proof
  first-used  subsets
  note        The pilot's row was itself incomplete, reading "Let X be a set, a
              with not a ∈ X... the map S ↦ S ∪ {a} is a bijection". The
              statement in the proof is the merge's reading of it.

theorem powerset-split-disjoint
  proved-in   proof/subsets.proof
  first-used  subsets
  note        The pilot's row read only "the two parts above are disjoint". The
              statement in the proof is the merge's reading of it.

theorem powerset-split
  let X be a set                                                      (H1)
  let a ∈ X                                                           (H2)
  then        𝒫X = 𝒫(X ∖ {a}) ∪ {S ∪ {a} : S ∈ 𝒫(X ∖ {a})}
  open        no set.mm label found; pwdif and pwsn are nearby
  first-used  subsets


# -------------------------------------------------------------- analysis

definition interval
  let a ∈ ℝ                                                           (H1)
  let b ∈ ℝ                                                           (H2)
  then        x ∈ [a, b] ↔ x ∈ ℝ and a ≤ x and x ≤ b
  metamath    elicc2
  first-used  intermediate-value

theorem interval-real
  let a ∈ ℝ                                                           (H1)
  let b ∈ ℝ                                                           (H2)
  then        [a, b] ⊆ ℝ
  metamath    iccssre
  first-used  intermediate-value

definition continuous-on
  let f : D → ℝ                                                       (H1)
  then        f is continuous on D ↔ for every c ∈ D, for every ε ∈ ℝ with
              ε > 0, there is δ ∈ ℝ with δ > 0 and for every x ∈ D, if
              |x − c| < δ then |f(x) − f(c)| < ε
  metamath    cncfi, elcncf2
  first-used  intermediate-value
  note        set.mm's continuity is topological; its unfolding to ε and δ is
              elsewhere.

definition upper-bound
  then        u is an upper bound of S ↔ for every s ∈ S, s ≤ u
  metamath    ub as in df-sup
  first-used  intermediate-value

definition least-upper-bound
  then        c is a least upper bound of S ↔ c is an upper bound of S, and for
              every u ∈ ℝ, if u is an upper bound of S then c ≤ u
  metamath    df-sup, suprub, suprleub
  first-used  intermediate-value

theorem completeness
  assume S ⊆ ℝ                                                        (H1)
  assume there is s ∈ S                                               (H2)
  assume there is u ∈ ℝ with u is an upper bound of S                 (H3)
  then        there is c ∈ ℝ with c is a least upper bound of S
  metamath    sup2, ax-pre-sup
  first-used  intermediate-value
  note        In set.mm this is an axiom of the real numbers. Whether its proof
              is ever in the corpus is a question about the foundation.

theorem point-right
  let c ∈ ℝ                                                           (H1)
  let b ∈ ℝ                                                           (H2)
  let δ ∈ ℝ                                                           (H3)
  assume c < b                                                        (H4)
  assume δ > 0                                                        (H5)
  then        there is x ∈ ℝ with c < x, x ≤ b, and x − c < δ
  open        no set.mm label; take the smaller of b and c + δ/2, then the
              midpoint
  first-used  intermediate-value
  note        Exists only because the language has no min notation and its case
              split. Textbooks write "take x = min(b, c + δ/2)".


# -------------------------------------------------------------- geometry

definition point
  open        The pilot's row reads "Let A be a point. (The plane is a set of
              points with distance and angle defined on it.)", which is a gloss
              and not a statement. What it becomes waits on def:angle: a point
              is a complex number if the angle is, and a member of a TarskiG
              base set if the angle is a congruence. ELABORATION.md.
  metamath    A ∈ ℂ
  first-used  isosceles

definition angle
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  assume P ≠ Q                                                        (H4)
  assume R ≠ Q                                                        (H5)
  then        ∠PQR ∈ ℝ. ∠PQR ≥ 0.
  symbol      ang
  defines     vx vy cc cc0 csn cdif cc cc0 csn cdif
              vy cv vx cv cdiv co clog cfv cim cfv cmpo
  metamath    set.mm writes this function inline in every theorem about it and
              never names it, so the corpus declares the constant
  first-used  isosceles
  note        The angle the corpus writes is unsigned: ∠PQR is the absolute
              value of ang applied to the two differences, which lands in
              0 to π and makes thm:angle-symmetric true. ang itself is
              signed, in −π to π, as set.mm has it. GEOMETRY.md weighs the
              seven candidate geometries and takes this one.

              This is the only definition in the corpus that introduces a
              symbol; every other names a word for something set.mm already
              has. See GOALS.md decision 12.

definition collinear
  open        Incidence is a primitive of the geometry, and the readable layer
              cannot state what it is. In the plane it says (R − P)/(Q − P) is
              real, and subtraction takes numbers while P, Q and R are points:
              the sorts that stop |CA| reading as a product stop this too. The
              notation carries a target, so a claim of collinearity elaborates;
              what has no readable statement is the equivalence.
  first-used  isosceles
  note        Named by the merge because def:triangle needs a word for what a
              triangle's vertices are not.

definition triangle
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  then        P, Q, R form a triangle ↔ P ≠ Q and Q ≠ R and P ≠ R and
              not (P, Q, R are collinear)
  open        set.mm has no single notion. The three inequalities are stated
              here and the rest is def:collinear, which is open.
  first-used  isosceles
  note        That the three are points is the three let lines, not a clause of
              the statement; the pilot's row wrote it as prose and the sorts
              carry it.

definition congruent
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  let P′ be a point                                                   (H4)
  let Q′ be a point                                                   (H5)
  let R′ be a point                                                   (H6)
  then        triangle PQR ≅ triangle P′Q′R′ ↔ |PQ| = |P′Q′|, |QR| = |Q′R′|,
              |RP| = |R′P′|, ∠PQR = ∠P′Q′R′, ∠QRP = ∠Q′R′P′, and
              ∠RPQ = ∠R′P′Q′
  open        six equations; no set.mm item
  first-used  isosceles

theorem distance-symmetric
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  then        |PQ| = |QP|
  metamath    abssub
  target      abssub
  first-used  isosceles

theorem angle-symmetric
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  assume P ≠ Q                                                        (H4)
  assume R ≠ Q                                                        (H5)
  then        ∠PQR = ∠RQP
  metamath    gangsym3, which this corpus proves in elaboration/geometry.mm.
              The angle it writes is unsigned, which is what makes this true:
              ang itself is signed, and the two directions differ in sign. Off
              the branch cut that is arginv; on the cut nothing is negated and
              lognegb gives both directions as π. So the proof is in two cases
              and the absolute values agree either way.
  target      gangsym3
  first-used  isosceles

theorem triangle-swap
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  assume P, Q, R form a triangle                                      (H4)
  then        P, R, Q form a triangle
  metamath    gtriswap, which this corpus proves in elaboration/geometry.mm:
              set.mm states nothing about a triangle, having no notion of one
  target      gtriswap
  first-used  isosceles

theorem triangle-rotate
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  assume P, Q, R form a triangle                                      (H4)
  then        Q, R, P form a triangle
  metamath    gtrirotate, which this corpus proves in elaboration/geometry.mm.
              A swap inverts the quotient that says the three are collinear; a
              rotation takes it to 1 − (R − Q)/(P − Q), so this one rests on an
              identity of the field rather than on one fact about reciprocals
  target      gtrirotate
  first-used  isosceles
  note        These two replace a thm:triangle-permute whose conclusion, "any
              ordering of P, Q, R forms a triangle", was not a formula. A swap
              and a rotation generate all six orderings, and they are the two
              the isosceles proof cites: one for A, C, B and one for B, C, A.
              Stating one theorem per ordering was the alternative and is five
              items for two uses.

theorem side-angle-side
  let P be a point                                                    (H1)
  let Q be a point                                                    (H2)
  let R be a point                                                    (H3)
  let P′ be a point                                                   (H4)
  let Q′ be a point                                                   (H5)
  let R′ be a point                                                   (H6)
  assume P, Q, R form a triangle                                      (H7)
  assume P′, Q′, R′ form a triangle                                   (H8)
  assume |PQ| = |P′Q′|                                                (H9)
  assume ∠PQR = ∠P′Q′R′                                               (H10)
  assume |QR| = |Q′R′|                                                (H11)
  then        triangle PQR ≅ triangle P′Q′R′
  metamath    gsas, which this corpus proves in elaboration/geometry.mm. An
              axiom in Euclid and in Hilbert, because a synthetic geometry has
              no coordinates to compute with and congruence has to be
              stipulated; over ℂ it is a theorem. The proof is the law of
              cosines at each of the three vertices, six applications in all,
              which are three cyclic rotations of glawcos in each triangle.
              The third side comes first, since equal sides and equal cosines
              make equal squares and a length is not negative; with all three
              sides equal the other two angles follow the other way round.
  target      gsas
  first-used  isosceles
  note        The isosceles proof instantiates A, B, C, A′, B′, C′, which are not
              this statement's variable names. One of the two must change; the
              merge changed neither. See DATABASE.md.


